pub struct LogPublishingOptionsStatus {
  /// The log publishing options configured for the domain.
  pub options: Map[Str, LogPublishingOption]? = None
  /// The status of the log publishing options for the domain.
  pub status: OptionStatus? = None
}

/// The type of log file. Can be one of the following: INDEX_SLOW_LOGS -
/// Index slow logs contain insert requests that took more time than the
/// configured index query log threshold to execute. SEARCH_SLOW_LOGS -
/// Search slow logs contain search queries that took more time than the
/// configured search query log threshold to execute. ES_APPLICATION_LOGS -
/// OpenSearch application logs contain information about errors and
/// warnings raised during the operation of the service and can be useful
/// for troubleshooting. AUDIT_LOGS - Audit logs contain records of user
/// requests for access to the domain.
pub enum LogType: Str {
  IndexSlowLogs = "INDEX_SLOW_LOGS"
  SearchSlowLogs = "SEARCH_SLOW_LOGS"
  EsApplicationLogs = "ES_APPLICATION_LOGS"
  AuditLogs = "AUDIT_LOGS"
  Unknown(value: Str)
}

pub enum MaintenanceStatus: Str {
  Pending = "PENDING"
  InProgress = "IN_PROGRESS"
  Completed = "COMPLETED"
  Failed = "FAILED"
  TimedOut = "TIMED_OUT"
  Unknown(value: Str)
}

pub enum MaintenanceType: Str {
  RebootNode = "REBOOT_NODE"
  RestartSearchProcess = "RESTART_SEARCH_PROCESS"
  RestartDashboard = "RESTART_DASHBOARD"
  Unknown(value: Str)
}

pub enum MasterNodeStatus: Str {
  Available = "Available"
  UnAvailable = "UnAvailable"
  Unknown(value: Str)
}

/// Credentials for the master user for a domain.
pub struct MasterUserOptions {
  /// Amazon Resource Name (ARN) for the master user. Only specify if
  /// InternalUserDatabaseEnabled is false .
  pub master_user_arn: Str? = None
  /// User name for the master user. Only specify if
  /// InternalUserDatabaseEnabled is true .
  pub master_user_name: Str? = None
  /// Password for the master user. Only specify if
  /// InternalUserDatabaseEnabled is true .
  pub master_user_password: Str? = None
}

/// Contains error details for a migration that failed or completed with
/// errors.
pub struct MigrationError {
  /// The error code identifying the type of failure.
  pub code: Str? = None
  /// A human-readable description of the error.
  pub message: Str? = None
}

/// The configuration options for a saved objects migration job.
pub struct MigrationOptions {
  /// The data source from which to export saved objects.
  pub source: MigrationSource? = None
  /// The target workspace configuration for importing saved objects. You can
  /// specify an existing workspace or request creation of a new workspace.
  pub workspace: MigrationWorkspace? = None
  /// Options to filter the scope of saved objects to export from the source.
  pub export_options: ExportOptions? = None
  /// The strategy for resolving conflicts when saved objects already exist in
  /// the target workspace. Valid values are CREATE_NEW_COPIES , which creates
  /// new objects with unique IDs, and overwrite , which replaces existing
  /// objects.
  pub conflict_resolution: Str? = None
}

/// The source configuration for a migration, specifying the data source
/// from which to export saved objects.
pub struct MigrationSource {
  /// The Amazon Resource Name (ARN) of the data source to migrate saved
  /// objects from.
  pub datasource_arn: Str? = None
}

/// A summary of a migration job, including its status and progress.
pub struct MigrationSummary {
  /// The unique identifier of the migration job.
  pub migration_id: Str? = None
  /// The current status of the migration job.
  pub status: Str? = None
  /// The unique identifier of the OpenSearch application associated with the
  /// migration.
  pub application_id: Str? = None
  /// The source configuration for the migration.
  pub source: MigrationSource? = None
  /// The number of saved objects exported from the source data source.
  pub exported_count: Int? = None
  /// The number of saved objects successfully imported into the target
  /// workspace.
  pub imported_count: Int? = None
  /// Error details if the migration failed or completed with errors.
  pub error: MigrationError? = None
  /// The date and time when the migration job was created.
  pub created_at: Time? = None
  /// The date and time when the migration job was last updated.
  pub updated_at: Time? = None
}

/// The target workspace configuration for a migration. You can specify an
/// existing workspace by ID or request creation of a new workspace.
pub struct MigrationWorkspace {
  /// The unique identifier of an existing workspace to use as the migration
  /// target. Specify either this parameter or createWorkspace .
  pub workspace_id: Str? = None
  /// Specifies whether to create a new workspace as the migration target. If
  /// true , you must also specify name .
  pub create_workspace: Bool? = None
  /// The name of the new workspace to create. Required when createWorkspace
  /// is true .
  pub name: Str? = None
  /// The type of the new workspace to create.
  pub type_value: Str? = None
}

/// Information about the domain properties that are currently being
/// modified.
pub struct ModifyingProperties {
  /// The name of the property that is currently being modified.
  pub name: Str? = None
  /// The current value of the domain property that is being modified.
  pub active_value: Str? = None
  /// The value that the property that is currently being modified will
  /// eventually have.
  pub pending_value: Str? = None
  /// The type of value that is currently being modified. Properties can have
  /// two types: PLAIN_TEXT : Contain direct values such as "1", "True", or
  /// "c5.large.search". STRINGIFIED_JSON : Contain content in JSON format,
  /// such as {"Enabled":"True"}".
  pub value_type: PropertyValueType? = None
}

