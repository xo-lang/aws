  /// A message describing why the Cleanup step could not delete the output
  /// resources associated with the upstream step.
  pub error_message: Str? = None
}

/// The type of error that prevented the Cleanup step from deleting output
/// resources. Valid values are: ClientError indicates that the failure was
/// caused by the request. InternalFailure indicates that the failure was
/// caused by an internal error.
pub enum CleanupFailureErrorCode: Str {
  ClientError = "ClientError"
  InternalFailure = "InternalFailure"
  Unknown(value: Str)
}

