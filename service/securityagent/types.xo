  pub title: Str? = None
  /// The assets included in the pentest.
  pub assets: Assets? = None
  /// The list of risk types excluded from the pentest.
  pub exclude_risk_types: List[RiskType]? = None
  /// The IAM service role used for the pentest.
  pub service_role: Str? = None
  /// The CloudWatch Logs configuration for the pentest.
  pub log_config: CloudWatchLog? = None
  /// The VPC configuration for the pentest.
  pub vpc_config: VpcConfig? = None
  /// The network traffic configuration for the pentest.
  pub network_traffic_config: NetworkTrafficConfig? = None
  /// The code remediation strategy for the pentest.
  pub code_remediation_strategy: CodeRemediationStrategy? = None
  /// Strategy for cleaning up resources after pentest job completion.
  pub clean_up_strategy: CleanUpStrategy? = None
  /// A list of managed skills to disable for this pentest. Valid values
  /// include FINDING_PERSONALIZATION and LOGIN_OPTIMIZATION.
  pub disable_managed_skills: List[SkillType]? = None
  /// The maximum number of billable task hours allowed for jobs started from
