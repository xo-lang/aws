pub enum VocabularyState: Str {
  CreationInProgress = "CREATION_IN_PROGRESS"
  Active = "ACTIVE"
  CreationFailed = "CREATION_FAILED"
  DeleteInProgress = "DELETE_IN_PROGRESS"
