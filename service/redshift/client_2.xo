fn query_put_network_interface_list(var f: query.Form, prefix: Str, v: List[NetworkInterface], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.NetworkInterface.${i + 1}" }
    query_put_network_interface(f, k, x)
  }
}

