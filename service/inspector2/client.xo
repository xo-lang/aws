fn json_of_filter(v: Filter) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("arn", json.Value.Str(x)))
  }
  if let Some(x) = v.owner_id {
    fs.push(("ownerId", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.criteria {
    fs.push(("criteria", json_of_filter_criteria(x)))
  }
  if let Some(x) = v.action {
    fs.push(("action", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("updatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.reason {
    fs.push(("reason", json.Value.Str(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tag_map(x)))
  }
  json.Value.Object(fs)
}

fn from_json_filter(v: json.Value) -> Filter ! Str {
  var out = Filter{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "arn" => out.arn = jsonv.read_str(fv)?
      "ownerId" => out.owner_id = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "criteria" => out.criteria = from_json_filter_criteria(fv)?
      "action" => out.action = jsonv.read_str(fv)?
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "updatedAt" => out.updated_at = jsonv.read_time(fv, "epoch-seconds")?
      "description" => out.description = jsonv.read_str(fv)?
      "reason" => out.reason = jsonv.read_str(fv)?
      "tags" => out.tags = from_json_tag_map(fv)?
      _ => {}
    }
  }
  Ok(out)
}

