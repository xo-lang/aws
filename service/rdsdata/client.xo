      "resourceArn" => out.resource_arn = jsonv.read_str(fv)?
      "secretArn" => out.secret_arn = jsonv.read_str(fv)?
      "sql" => out.sql = jsonv.read_str(fv)?
      "database" => out.database = jsonv.read_str(fv)?
      "schema" => out.schema = jsonv.read_str(fv)?
      "parameters" => out.parameters = from_json_sql_parameters_list(fv)?
      "transactionId" => out.transaction_id = jsonv.read_str(fv)?
      "includeResultMetadata" => out.include_result_metadata = jsonv.read_bool(fv)?
      "continueAfterTimeout" => out.continue_after_timeout = jsonv.read_bool(fv)?
      "resultSetOptions" => out.result_set_options = from_json_result_set_options(fv)?
      "formatRecordsAs" => out.format_records_as = RecordsFormatType.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_execute_statement_response(v: ExecuteStatementResponse) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.records {
    fs.push(("records", json_of_sql_records(x)))
  }
  if let Some(x) = v.column_metadata {
    fs.push(("columnMetadata", json_of_metadata(x)))
  }
  if let Some(x) = v.number_of_records_updated {
    fs.push(("numberOfRecordsUpdated", json.Value.Int(x)))
  }
  if let Some(x) = v.generated_fields {
    fs.push(("generatedFields", json_of_field_list(x)))
  }
  if let Some(x) = v.formatted_records {
    fs.push(("formattedRecords", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_execute_statement_response(v: json.Value) -> ExecuteStatementResponse ! Str {
  var out = ExecuteStatementResponse{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "records" => out.records = from_json_sql_records(fv)?
      "columnMetadata" => out.column_metadata = from_json_metadata(fv)?
      "numberOfRecordsUpdated" => out.number_of_records_updated = jsonv.read_int(fv)?
      "generatedFields" => out.generated_fields = from_json_field_list(fv)?
      "formattedRecords" => out.formatted_records = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_field(v: Field) -> json.Value {
  match v {
    IsNull(x) => json.Value.Object([("isNull", json.Value.Bool(x))])
    BooleanValue(x) => json.Value.Object([("booleanValue", json.Value.Bool(x))])
    LongValue(x) => json.Value.Object([("longValue", json.Value.Int(x))])
    DoubleValue(x) => json.Value.Object([("doubleValue", jsonv.float(x))])
    StringValue(x) => json.Value.Object([("stringValue", json.Value.Str(x))])
    BlobValue(x) => json.Value.Object([("blobValue", jsonv.blob(x))])
    ArrayValue(x) => json.Value.Object([("arrayValue", json_of_array_value(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_field(v: json.Value) -> Field ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "isNull" => Ok(Field.IsNull(jsonv.read_bool(fv)?))
      "booleanValue" => Ok(Field.BooleanValue(jsonv.read_bool(fv)?))
      "longValue" => Ok(Field.LongValue(jsonv.read_int(fv)?))
      "doubleValue" => Ok(Field.DoubleValue(jsonv.read_float(fv)?))
      "stringValue" => Ok(Field.StringValue(jsonv.read_str(fv)?))
      "blobValue" => Ok(Field.BlobValue(jsonv.read_blob(fv)?))
      "arrayValue" => Ok(Field.ArrayValue(from_json_array_value(fv)?))
      _ => Ok(Field.Unknown(k))
    }
  }
  Err("Field: no member set")
}

fn json_of_field_list(v: List[Field]) -> json.Value {
  json.Value.List(v.map(fn(x: Field) -> json.Value { json_of_field(x) }))
}

fn from_json_field_list(v: json.Value) -> List[Field] ! Str {
  var out: List[Field] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_field(fv)?)
  }
  Ok(out)
}

