pub fn wait_until_workspace_deleted(c: Client, input: DescribeWorkspaceRequest, max_wait: Duration, min_delay: Duration = 2s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeWorkspaceErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_workspace(input) {
      Ok(out) => {
        let o = jmes_of_describe_workspace_response(out)
        if state == "" && waiter.path_matches(o, "workspace.status.statusCode", "stringEquals", "DELETING") {
          state = "retry"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_workspace(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("WorkspaceDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
