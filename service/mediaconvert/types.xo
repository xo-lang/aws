/// 428M, BT.709 * P3D65 (SDR): Display P3, sRGB, BT.709 * P3D65 (HDR):
/// Display P3, PQ, BT.709
pub enum ColorSpace: Str {
  Follow = "FOLLOW"
  Rec601 = "REC_601"
  Rec709 = "REC_709"
  Hdr10 = "HDR10"
  Hlg2020 = "HLG_2020"
  P3Dci = "P3DCI"
  P3D65Sdr = "P3D65_SDR"
  P3D65Hdr = "P3D65_HDR"
