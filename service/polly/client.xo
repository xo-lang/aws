/// Synthesizes UTF-8 input, plain text or SSML, to a stream of bytes. SSML
/// input must be valid, well-formed SSML. Some alphabets might not be
/// available with all the voices (for example, Cyrillic might not be read
/// at all by English voices) unless phoneme mapping is used. For more
/// information, see How it Works .
pub fn (c: Client) synthesize_speech(input: SynthesizeSpeechInput) -> SynthesizeSpeechOutput ! SynthesizeSpeechErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_synthesize_speech(c.params, input)) ?? e => return Err(SynthesizeSpeechErr.InvalidInput(e))
  var req = serialize_synthesize_speech(ep, input, "") ?? e => return Err(SynthesizeSpeechErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(SynthesizeSpeechErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_synthesize_speech_error(resp))
  }
  deserialize_synthesize_speech(resp) ?? e => Err(SynthesizeSpeechErr.Deserialize(e))
}

