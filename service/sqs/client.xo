    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_untag_queue_error(resp: http.Response) -> UntagQueueErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "InvalidAddress" => match read_error_invalid_address(resp, body) {
      Ok(x) => return UntagQueueErr.InvalidAddress(x)
      Err(msg) => return UntagQueueErr.Deserialize(msg)
    }
    "InvalidSecurity" => match read_error_invalid_security(resp, body) {
      Ok(x) => return UntagQueueErr.InvalidSecurity(x)
      Err(msg) => return UntagQueueErr.Deserialize(msg)
    }
    "QueueDoesNotExist" => match read_error_queue_does_not_exist(resp, body) {
      Ok(x) => return UntagQueueErr.QueueDoesNotExist(x)
      Err(msg) => return UntagQueueErr.Deserialize(msg)
    }
    "RequestThrottled" => match read_error_request_throttled(resp, body) {
      Ok(x) => return UntagQueueErr.RequestThrottled(x)
      Err(msg) => return UntagQueueErr.Deserialize(msg)
    }
    "UnsupportedOperation" => match read_error_unsupported_operation(resp, body) {
      Ok(x) => return UntagQueueErr.UnsupportedOperation(x)
      Err(msg) => return UntagQueueErr.Deserialize(msg)
    }
    _ => {}
  }
  UntagQueueErr.Api(restjson.api_error(resp, body))
}

/// Remove cost allocation tags from the specified Amazon SQS queue. For an
/// overview, see Tagging Your Amazon SQS Queues in the Amazon SQS Developer
/// Guide . Cross-account permissions don't apply to this action. For more
/// information, see Grant cross-account permissions to a role and a
/// username in the Amazon SQS Developer Guide .
pub fn (c: Client) untag_queue(input: UntagQueueRequest) -> () ! UntagQueueErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_untag_queue(c.params, input)) ?? e => return Err(UntagQueueErr.InvalidInput(e))
  var req = serialize_untag_queue(ep, input, "") ?? e => return Err(UntagQueueErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UntagQueueErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_untag_queue_error(resp))
  }
  deserialize_untag_queue(resp) ?? e => Err(UntagQueueErr.Deserialize(e))
}
