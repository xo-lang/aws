/// Telemetry-based rule: what to query, how to evaluate the result, what
/// condition makes it fire, and what to do on missing data.
pub struct TelemetryRule {
  /// The query expression to evaluate.
  pub query: AlertRuleQuery? = None
  /// The condition that determines when the alert fires.
  pub condition: AlertCondition? = None
  /// The evaluation cadence and durations.
  pub evaluation: AlertEvaluation? = None
  /// How the alert behaves when a query produces no data.
  pub no_data: NoData? = None
}

/// The type of telemetry data.
pub enum TelemetryType: Str {
  Logs = "LOGS"
  Traces = "TRACES"
  Unknown(value: Str)
}

/// How a threshold is applied to query results.
pub enum ThresholdMode: Str {
  CountOfResults = "COUNT_OF_RESULTS"
  FieldValue = "FIELD_VALUE"
  Unknown(value: Str)
}

