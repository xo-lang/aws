    xmlv.elem(w, "LastAccessedRegion", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_tracked_action_last_accessed(e: xml.Element) -> TrackedActionLastAccessed ! Str {
  var out = TrackedActionLastAccessed{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ActionName" => out.action_name = c.text()
      "LastAccessedEntity" => out.last_accessed_entity = c.text()
      "LastAccessedTime" => out.last_accessed_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "LastAccessedRegion" => out.last_accessed_region = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_tracked_actions_last_accessed(var w: xmlv.Writer, v: List[TrackedActionLastAccessed], name: Str, ns: List[(Str, Str)]) {
