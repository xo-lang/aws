fn from_json_edge(v: json.Value) -> Edge ! Str {
  var out = Edge{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ReferenceId" => out.reference_id = jsonv.read_int(fv)?
      "StartTime" => out.start_time = jsonv.read_time(fv, "epoch-seconds")?
      "EndTime" => out.end_time = jsonv.read_time(fv, "epoch-seconds")?
      "SummaryStatistics" => out.summary_statistics = from_json_edge_statistics(fv)?
      "ResponseTimeHistogram" => out.response_time_histogram = from_json_histogram(fv)?
      "Aliases" => out.aliases = from_json_alias_list(fv)?
      "EdgeType" => out.edge_type = jsonv.read_str(fv)?
      "ReceivedEventAgeHistogram" => out.received_event_age_histogram = from_json_histogram(fv)?
      _ => {}
    }
  }
  Ok(out)
}

