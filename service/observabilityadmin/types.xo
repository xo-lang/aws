  /// service assumes this role to propagate tags to destination log groups.
  /// You must have iam:PassRole permission on this role.
  pub destination_role_arn: Str? = None
  /// The strategy for resolving conflicts when a tag key exists on both the
  /// source and destination log groups. If not specified, defaults to
  /// UPDATE_SYNC . ADD_ONLY – Only adds new tags from the source without
  /// modifying existing destination tags. UPDATE_SYNC – Adds new tags and
  /// updates existing tags from the source. Does not remove destination tags
  /// that are absent from the source. IN_SYNC – Keeps destination tags
  /// fully synchronized with source tags, including removing destination tags
  /// that do not exist on the source.
  pub tag_conflict_resolution_strategy: TagConflictResolutionStrategy? = None
}

/// The reason tag propagation is unhealthy for a centralization rule.
/// RoleNotAssumable – The service cannot assume the destination role due
/// to a trust policy or external ID misconfiguration. RoleLacksPermissions
/// – The role was assumed successfully but the tag API call was denied by
/// the role's permissions policy.
pub enum TagPropagationFailureReason: Str {
  RoleNotAssumable = "RoleNotAssumable"
  RoleLacksPermissions = "RoleLacksPermissions"
  Unknown(value: Str)
}

/// The health status of tag propagation for a centralization rule. This
/// status is independent of the overall RuleHealth for log delivery.
pub enum TagPropagationStatus: Str {
  Healthy = "Healthy"
  Unhealthy = "Unhealthy"
  Unknown(value: Str)
}

