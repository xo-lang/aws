    xml_write_value_string_list(w, x, "postureComplianceStatusSet", [])
  }
  if let Some(x) = v.authorization_policy_last_evaluated_time {
    xmlv.elem(w, "authorizationPolicyLastEvaluatedTime", x, [])
  }
  xmlv.end(w, name)
