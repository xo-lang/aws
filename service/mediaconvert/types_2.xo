  /// "-no-premium" for this setting, then the file name the service generates
  /// for this top-level manifest is film-name-no-premium.ismv.
  pub manifest_name_modifier: Str? = None
  /// Specify the outputs that you want this additional top-level manifest to
  /// reference.
  pub selected_outputs: List[Str]? = None
}

/// COMBINE_DUPLICATE_STREAMS combines identical audio encoding settings
/// across a Microsoft Smooth output group into a single audio stream.
