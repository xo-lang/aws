fn json_of_endpoint_list(v: List[Endpoint]) -> json.Value {
  json.Value.List(v.map(fn(x: Endpoint) -> json.Value { json_of_endpoint(x) }))
}

fn from_json_endpoint_list(v: json.Value) -> List[Endpoint] ! Str {
  var out: List[Endpoint] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_endpoint(fv)?)
  }
  Ok(out)
}

