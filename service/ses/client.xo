fn xml_write_send_data_point(var w: xmlv.Writer, v: SendDataPoint, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.timestamp {
    xmlv.elem(w, "Timestamp", rest.date_time(x), [])
  }
  if let Some(x) = v.delivery_attempts {
    xmlv.elem(w, "DeliveryAttempts", "${x}", [])
  }
  if let Some(x) = v.bounces {
    xmlv.elem(w, "Bounces", "${x}", [])
  }
  if let Some(x) = v.complaints {
    xmlv.elem(w, "Complaints", "${x}", [])
  }
  if let Some(x) = v.rejects {
    xmlv.elem(w, "Rejects", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_send_data_point(e: xml.Element) -> SendDataPoint ! Str {
  var out = SendDataPoint{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Timestamp" => out.timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DeliveryAttempts" => out.delivery_attempts = xmlv.read_int(c.text())?
      "Bounces" => out.bounces = xmlv.read_int(c.text())?
      "Complaints" => out.complaints = xmlv.read_int(c.text())?
      "Rejects" => out.rejects = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

