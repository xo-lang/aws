  /// The Amazon Resource Name (ARN) of the Secrets Manager secret storing the
  /// pre-shared key(s) for the VPN connection.
  pub pre_shared_key_arn: Str? = None
  /// The ID of the VPN connection.
  pub vpn_connection_id: Str? = None
  /// The current state of the VPN connection.
  pub state: VpnState? = None
  /// The configuration information for the VPN connection's customer gateway
  /// (in the native XML format). This element is always present in the
  /// CreateVpnConnection response; however, it's present in the
  /// DescribeVpnConnections response only if the VPN connection is in the
  /// pending or available state.
  pub customer_gateway_configuration: Str? = None
  /// The type of VPN connection.
  pub type_value: GatewayType? = None
  /// The ID of the customer gateway at your end of the VPN connection.
  pub customer_gateway_id: Str? = None
  /// The ID of the virtual private gateway at the Amazon Web Services side of
  /// the VPN connection.
  pub vpn_gateway_id: Str? = None
}

