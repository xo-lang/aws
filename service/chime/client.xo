    }
    "ThrottledClientException" => match read_error_throttled_client_exception(resp, body) {
      Ok(x) => return UpdateAccountErr.ThrottledClientException(x)
      Err(msg) => return UpdateAccountErr.Deserialize(msg)
    }
    "UnauthorizedClientException" => match read_error_unauthorized_client_exception(resp, body) {
      Ok(x) => return UpdateAccountErr.UnauthorizedClientException(x)
      Err(msg) => return UpdateAccountErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateAccountErr.Api(restjson.api_error(resp, body))
}