  /// The protocol for the load balancer listener is HTTPS . No other protocol
  /// is supported.
  pub protocol: GatewayAlbProtocol? = None
  /// The maximum number of Application Load Balancers that the gateway
  /// manages. The default is 10.
  pub max_alb_count: Int? = None
  /// The desync mitigation mode for the load balancers that the gateway
  /// manages, which determines how the load balancers handle requests that
  /// might pose a security risk. The default is defensive .
  pub http_desync: GatewayAlbDesyncMitigationMode? = None
  /// The rules that route test traffic for progressive deployments. During a
  /// progressive deployment, requests whose headers match these rules are
  /// routed to the new service revision so that it can be validated before
  /// production traffic shifts to it.
  pub test_traffic_rules: GatewayAlbTestTrafficRules? = None
}

