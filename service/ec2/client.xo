fn xml_write_volume(var w: xmlv.Writer, v: Volume, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.availability_zone_id {
    xmlv.elem(w, "availabilityZoneId", x, [])
  }
  if let Some(x) = v.outpost_arn {
    xmlv.elem(w, "outpostArn", x, [])
  }
  if let Some(x) = v.source_volume_id {
    xmlv.elem(w, "sourceVolumeId", x, [])
  }
  if let Some(x) = v.iops {
    xmlv.elem(w, "iops", "${x}", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.volume_type {
    xmlv.elem(w, "volumeType", x.value(), [])
  }
  if let Some(x) = v.fast_restored {
    xmlv.elem(w, "fastRestored", "${x}", [])
  }
  if let Some(x) = v.multi_attach_enabled {
    xmlv.elem(w, "multiAttachEnabled", "${x}", [])
  }
  if let Some(x) = v.throughput {
    xmlv.elem(w, "throughput", "${x}", [])
  }
  if let Some(x) = v.sse_type {
    xmlv.elem(w, "sseType", x.value(), [])
  }
  if let Some(x) = v.operator {
