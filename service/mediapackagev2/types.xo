  /// The name that describes the origin endpoint. The name is the primary
  /// identifier for the origin endpoint, and and must be unique for your
  /// account in the AWS Region and channel.
  pub origin_endpoint_name: Str? = None
  /// The type of container attached to this origin endpoint. A container type
  /// is a file format that encapsulates one or more media streams, such as
  /// audio and video, into a single file.
  pub container_type: ContainerType? = None
  /// The segment configuration, including the segment name, duration, and
  /// other configuration values.
  pub segment: Segment? = None
  /// Any descriptive information that you want to add to the origin endpoint
  /// for future identification purposes.
  pub description: Str? = None
  /// The size of the window (in seconds) to create a window of the live
  /// stream that's available for on-demand viewing. Viewers can start-over or
  /// catch-up on content that falls within the window. The maximum startover
  /// window is 1,209,600 seconds (14 days).
  pub startover_window_seconds: Int? = None
  /// An HTTP live streaming (HLS) manifest configuration.
  pub hls_manifests: List[CreateHlsManifestConfiguration]? = None
  /// A low-latency HLS manifest configuration.
  pub low_latency_hls_manifests: List[CreateLowLatencyHlsManifestConfiguration]? = None
  /// A DASH manifest configuration.
  pub dash_manifests: List[CreateDashManifestConfiguration]? = None
  /// A list of Microsoft Smooth Streaming (MSS) manifest configurations to
  /// update for the origin endpoint. This replaces the existing MSS manifest
  /// configurations.
  pub mss_manifests: List[CreateMssManifestConfiguration]? = None
  /// The failover settings for the endpoint.
  pub force_endpoint_error_configuration: ForceEndpointErrorConfiguration? = None
  /// The separator character to use in generated URIs for this origin
  /// endpoint. This setting applies to all manifest types on the endpoint. If
  /// you don't specify a value in the update request, the current value is
  /// preserved.
  pub uri_separator: UriSeparator? = None
  /// The output mode for stream names in egress manifests. If you provide a
  /// value, it must match the current value. You can't change the stream name
  /// output mode after you create the endpoint.
  pub stream_name_output_mode: StreamNameOutputMode? = None
  /// The expected current Entity Tag (ETag) for the resource. If the
  /// specified ETag does not match the resource's current entity tag, the
  /// update request will be rejected.
  pub e_tag: Str? = None
}

