  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UpdateRecordErr) display() -> Str {
  match e {
    AccessForbidden(x) => "AccessForbidden: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    InternalFailure(x) => "InternalFailure: ${x:?}"
    ResourceNotFound(x) => "ResourceNotFound: ${x:?}"
    ServiceUnavailable(x) => "ServiceUnavailable: ${x:?}"
    ValidationError(x) => "ValidationError: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_record_error(resp: http.Response) -> UpdateRecordErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessForbidden" => match read_error_access_forbidden(resp, body) {
      Ok(x) => return UpdateRecordErr.AccessForbidden(x)
      Err(msg) => return UpdateRecordErr.Deserialize(msg)
    }
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UpdateRecordErr.ConflictException(x)
      Err(msg) => return UpdateRecordErr.Deserialize(msg)
    }
    "InternalFailure" => match read_error_internal_failure(resp, body) {
      Ok(x) => return UpdateRecordErr.InternalFailure(x)
      Err(msg) => return UpdateRecordErr.Deserialize(msg)
    }
    "ResourceNotFound" => match read_error_resource_not_found(resp, body) {
      Ok(x) => return UpdateRecordErr.ResourceNotFound(x)
      Err(msg) => return UpdateRecordErr.Deserialize(msg)
    }
    "ServiceUnavailable" => match read_error_service_unavailable(resp, body) {
      Ok(x) => return UpdateRecordErr.ServiceUnavailable(x)
      Err(msg) => return UpdateRecordErr.Deserialize(msg)
    }
    "ValidationError" => match read_error_validation_error(resp, body) {
      Ok(x) => return UpdateRecordErr.ValidationError(x)
      Err(msg) => return UpdateRecordErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateRecordErr.Api(restjson.api_error(resp, body))
}

/// Updates one or more feature values for an existing record in the
/// specified feature group. Features that you do not include in the request
/// remain unchanged. You can update up to 100 features per call. This
/// operation is available only for feature groups that use the Standard_V2
/// or InMemory online store type. The record must already exist. If the
/// record does not exist or has been soft-deleted, the operation returns a
/// ResourceNotFound error. To create a record, use PutRecord . If you
/// provide an EventTime that is older than the record's current EventTime ,
/// the service rejects the update with a ConflictException . If the
/// EventTime is equal to or newer than the current value, the service
/// applies the update. If you omit EventTime , the service keeps the
/// record's existing EventTime and applies the update. If you specify a
/// TtlDuration , you must also provide an EventTime in the request.
/// Otherwise, the operation returns a ValidationError .
pub fn (c: Client) update_record(input: UpdateRecordRequest) -> () ! UpdateRecordErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_record(c.params, input)) ?? e => return Err(UpdateRecordErr.InvalidInput(e))
  var req = serialize_update_record(ep, input, "") ?? e => return Err(UpdateRecordErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateRecordErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_record_error(resp))
  }
  deserialize_update_record(resp) ?? e => Err(UpdateRecordErr.Deserialize(e))
}
