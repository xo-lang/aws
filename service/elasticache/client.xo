fn query_put_replication_group_already_under_migration_fault(var f: query.Form, prefix: Str, v: ReplicationGroupAlreadyUnderMigrationFault) {
  if let Some(x) = v.message {
    query.add(f, query.key(prefix, "message"), x)
  }
}