  }
  if let Some(x) = v.in_reply_to {
    fs.push(("inReplyTo", json.Value.Str(x)))
  }
  if let Some(x) = v.creation_date {
    fs.push(("creationDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_modified_date {
    fs.push(("lastModifiedDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.author_arn {
    fs.push(("authorArn", json.Value.Str(x)))
  }
  if let Some(x) = v.deleted {
    fs.push(("deleted", json.Value.Bool(x)))
  }
  if let Some(x) = v.client_request_token {
    fs.push(("clientRequestToken", json.Value.Str(x)))
  }
  if let Some(x) = v.caller_reactions {
    fs.push(("callerReactions", json_of_caller_reactions(x)))
  }
  if let Some(x) = v.reaction_counts {
    fs.push(("reactionCounts", json_of_reaction_counts_map(x)))
  }
  json.Value.Object(fs)
}

