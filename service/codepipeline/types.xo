/// A response to a PollForThirdPartyJobs request returned by CodePipeline
/// when there is a job to be worked on by a partner action.
pub struct ThirdPartyJob {
  /// The clientToken portion of the clientId and clientToken pair used to
  /// verify that the calling entity is allowed access to the job and its
  /// details.
  pub client_id: Str? = None
  /// The identifier used to identify the job in CodePipeline.
  pub job_id: Str? = None
}

/// Represents information about the job data for a partner action.
pub struct ThirdPartyJobData {
  /// Represents information about an action type.
  pub action_type_id: ActionTypeId? = None
  /// Represents information about an action configuration.
  pub action_configuration: ActionConfiguration? = None
  /// Represents information about a pipeline to a job worker. Does not
  /// include pipelineArn and pipelineExecutionId for ThirdParty jobs.
  pub pipeline_context: PipelineContext? = None
  /// The name of the artifact that is worked on by the action, if any. This
  /// name might be system-generated, such as "MyApp", or it might be defined
  /// by the user when the action is created. The input artifact name must
  /// match the name of an output artifact generated by an action in an
  /// earlier action or stage of the pipeline.
  pub input_artifacts: List[Artifact]? = None
  /// The name of the artifact that is the result of the action, if any. This
  /// name might be system-generated, such as "MyBuiltApp", or it might be
  /// defined by the user when the action is created.
  pub output_artifacts: List[Artifact]? = None
  /// Represents an Amazon Web Services session credentials object. These
  /// credentials are temporary credentials that are issued by Amazon Web
  /// Services Secure Token Service (STS). They can be used to access input
  /// and output artifacts in the S3 bucket used to store artifact for the
  /// pipeline in CodePipeline.
  pub artifact_credentials: AWSSessionCredentials? = None
  /// A system-generated token, such as a CodeDeploy deployment ID, that a job
  /// requires to continue the job asynchronously.
  pub continuation_token: Str? = None
  /// The encryption key used to encrypt and decrypt data in the artifact
  /// store for the pipeline, such as an Amazon Web Services Key Management
  /// Service (Amazon Web Services KMS) key. This is optional and might not be
  /// present.
  pub encryption_key: EncryptionKey? = None
}

/// The details of a job sent in response to a GetThirdPartyJobDetails
/// request.
pub struct ThirdPartyJobDetails {
  /// The identifier used to identify the job details in CodePipeline.
  pub id: Str? = None
  /// The data to be returned by the third party job worker.
  pub data: ThirdPartyJobData? = None
  /// A system-generated random number that CodePipeline uses to ensure that
  /// the job is being worked on by only one job worker. Use this number in an
  /// AcknowledgeThirdPartyJob request.
  pub nonce: Str? = None
}

/// The tags limit for a resource has been exceeded.
pub struct TooManyTagsException {
  pub message: Str? = None
}

/// Represents information about the state of transitions between one stage
/// and another stage.
pub struct TransitionState {
  /// Whether the transition between stages is enabled (true) or disabled
  /// (false).
  pub enabled: Bool? = None
  /// The ID of the user who last changed the transition state.
  pub last_changed_by: Str? = None
  /// The timestamp when the transition state was last changed.
  pub last_changed_at: Time? = None
  /// The user-specified reason why the transition between two stages of a
  /// pipeline was disabled.
  pub disabled_reason: Str? = None
}

pub enum TriggerType: Str {
  CreatePipeline = "CreatePipeline"
  StartPipelineExecution = "StartPipelineExecution"
  PollForSourceChanges = "PollForSourceChanges"
  Webhook = "Webhook"
  CloudWatchEvent = "CloudWatchEvent"
  PutActionRevision = "PutActionRevision"
  WebhookV2 = "WebhookV2"
  ManualRollback = "ManualRollback"
  AutomatedRollback = "AutomatedRollback"
  Unknown(value: Str)
}

/// Unable to roll back the stage. The cause might be if the pipeline
/// version has changed since the target pipeline execution was deployed,
/// the stage is currently running, or an incorrect target pipeline
/// execution ID was provided.
pub struct UnableToRollbackStageException {
  pub message: Str? = None
}

pub struct UntagResourceInput {
  /// The Amazon Resource Name (ARN) of the resource to remove tags from.
  pub resource_arn: Str? = None
  /// The list of keys for the tags to be removed from the resource.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceOutput {
}

pub struct UpdateActionTypeInput {
  /// The action type definition for the action type to be updated.
  pub action_type: ActionTypeDeclaration? = None
}

/// Represents the input of an UpdatePipeline action.
pub struct UpdatePipelineInput {
  /// The name of the pipeline to be updated.
  pub pipeline: PipelineDeclaration? = None
}

/// Represents the output of an UpdatePipeline action.
pub struct UpdatePipelineOutput {
  /// The structure of the updated pipeline.
  pub pipeline: PipelineDeclaration? = None
}

/// The validation was specified in an invalid format.
pub struct ValidationException {
  /// The message provided to the user in the event of an exception.
  pub message: Str? = None
}

/// The authentication applied to incoming webhook trigger requests.
pub struct WebhookAuthConfiguration {
  /// The property used to configure acceptance of webhooks in an IP address
  /// range. For IP, only the AllowedIPRange property must be set. This
  /// property must be set to a valid CIDR range.
  pub allowed_ip_range: Str? = None
  /// The property used to configure GitHub authentication. For GITHUB_HMAC,
  /// only the SecretToken property must be set. When creating CodePipeline
  /// webhooks, do not use your own credentials or reuse the same secret token
  /// across multiple webhooks. For optimal security, generate a unique secret
  /// token for each webhook you create. The secret token is an arbitrary
  /// string that you provide, which GitHub uses to compute and sign the
  /// webhook payloads sent to CodePipeline, for protecting the integrity and
  /// authenticity of the webhook payloads. Using your own credentials or
  /// reusing the same token across multiple webhooks can lead to security
  /// vulnerabilities. If a secret token was provided, it will be redacted in
  /// the response.
  pub secret_token: Str? = None
}

pub enum WebhookAuthenticationType: Str {
  GithubHmac = "GITHUB_HMAC"
  Ip = "IP"
  Unauthenticated = "UNAUTHENTICATED"
  Unknown(value: Str)
}

/// Represents information about a webhook and its definition.
pub struct WebhookDefinition {
  /// The name of the webhook.
  pub name: Str? = None
  /// The name of the pipeline you want to connect to the webhook.
  pub target_pipeline: Str? = None
  /// The name of the action in a pipeline you want to connect to the webhook.
  /// The action must be from the source (first) stage of the pipeline.
  pub target_action: Str? = None
  /// A list of rules applied to the body/payload sent in the POST request to
  /// a webhook URL. All defined rules must pass for the request to be
  /// accepted and the pipeline started.
  pub filters: List[WebhookFilterRule]? = None
  /// Supported options are GITHUB_HMAC, IP, and UNAUTHENTICATED. When
  /// creating CodePipeline webhooks, do not use your own credentials or reuse
  /// the same secret token across multiple webhooks. For optimal security,
  /// generate a unique secret token for each webhook you create. The secret
  /// token is an arbitrary string that you provide, which GitHub uses to
  /// compute and sign the webhook payloads sent to CodePipeline, for
  /// protecting the integrity and authenticity of the webhook payloads. Using
  /// your own credentials or reusing the same token across multiple webhooks
  /// can lead to security vulnerabilities. If a secret token was provided, it
  /// will be redacted in the response. For information about the
  /// authentication scheme implemented by GITHUB_HMAC, see Securing your
  /// webhooks on the GitHub Developer website. IP rejects webhooks trigger
  /// requests unless they originate from an IP address in the IP range
  /// whitelisted in the authentication configuration. UNAUTHENTICATED accepts
  /// all webhook trigger requests regardless of origin.
  pub authentication: WebhookAuthenticationType? = None
  /// Properties that configure the authentication applied to incoming webhook
  /// trigger requests. The required properties depend on the authentication
  /// type. For GITHUB_HMAC, only the SecretToken property must be set. For
  /// IP, only the AllowedIPRange property must be set to a valid CIDR range.
  /// For UNAUTHENTICATED, no properties can be set.
  pub authentication_configuration: WebhookAuthConfiguration? = None
}

/// The event criteria that specify when a webhook notification is sent to
/// your URL.
pub struct WebhookFilterRule {
  /// A JsonPath expression that is applied to the body/payload of the
  /// webhook. The value selected by the JsonPath expression must match the
  /// value specified in the MatchEquals field. Otherwise, the request is
  /// ignored. For more information, see Java JsonPath implementation in
  /// GitHub.
  pub json_path: Str? = None
  /// The value selected by the JsonPath expression must match what is
  /// supplied in the MatchEquals field. Otherwise, the request is ignored.
  /// Properties from the target action configuration can be included as
  /// placeholders in this value by surrounding the action configuration key
  /// with curly brackets. For example, if the value supplied here is
  /// "refs/heads/{Branch}" and the target action has an action configuration
  /// property called "Branch" with a value of "main", the MatchEquals value
  /// is evaluated as "refs/heads/main". For a list of action configuration
  /// properties for built-in action types, see Pipeline Structure Reference
  /// Action Requirements .
  pub match_equals: Str? = None
}

/// The specified webhook was entered in an invalid format or cannot be
/// found.
pub struct WebhookNotFoundException {
}
