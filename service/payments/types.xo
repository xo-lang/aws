/// The request isn't valid. Check reason and fieldList for the cause,
/// correct the request, and try again.
pub struct ValidationException {
  pub message: Str? = None
  /// The reason that validation failed. The following values are valid:
  /// CANNOT_PARSE – The request body couldn't be parsed, or a value isn't
  /// of the expected type. FIELD_VALIDATION_FAILED – One or more members
