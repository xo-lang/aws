fn xml_write_get_access_grant_result(var w: xmlv.Writer, v: GetAccessGrantResult, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.created_at {
    xmlv.elem(w, "CreatedAt", rest.date_time(x), [])
  }
  if let Some(x) = v.access_grant_id {
    xmlv.elem(w, "AccessGrantId", x, [])
  }
  if let Some(x) = v.access_grant_arn {
    xmlv.elem(w, "AccessGrantArn", x, [])
  }
  if let Some(x) = v.grantee {
    xml_write_grantee(w, x, "Grantee", [])
  }
  if let Some(x) = v.permission {
    xmlv.elem(w, "Permission", x.value(), [])
  }
  if let Some(x) = v.access_grants_location_id {
    xmlv.elem(w, "AccessGrantsLocationId", x, [])
  }
  if let Some(x) = v.access_grants_location_configuration {
    xml_write_access_grants_location_configuration(w, x, "AccessGrantsLocationConfiguration", [])
  }
  if let Some(x) = v.grant_scope {
    xmlv.elem(w, "GrantScope", x, [])
  }
  if let Some(x) = v.application_arn {
    xmlv.elem(w, "ApplicationArn", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_get_access_grant_result(e: xml.Element) -> GetAccessGrantResult ! Str {
  var out = GetAccessGrantResult{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "CreatedAt" => out.created_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "AccessGrantId" => out.access_grant_id = c.text()
      "AccessGrantArn" => out.access_grant_arn = c.text()
      "Grantee" => out.grantee = xml_read_grantee(c)?
      "Permission" => out.permission = Permission.from(c.text())
      "AccessGrantsLocationId" => out.access_grants_location_id = c.text()
      "AccessGrantsLocationConfiguration" => out.access_grants_location_configuration = xml_read_access_grants_location_configuration(c)?
      "GrantScope" => out.grant_scope = c.text()
      "ApplicationArn" => out.application_arn = c.text()
      _ => {}
    }
  }
  Ok(out)
}

