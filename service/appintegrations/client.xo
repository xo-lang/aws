/// The HTTP request of CreateApplication.
pub fn serialize_create_application(ep: rest.Endpoint, input: CreateApplicationRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = input.namespace {
    fs.push(("Namespace", json.Value.Str(x)))
  }
  if let Some(x) = input.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = input.application_source_config {
    fs.push(("ApplicationSourceConfig", json_of_application_source_config(x)))
  }
  if let Some(x) = input.subscriptions {
    fs.push(("Subscriptions", json_of_subscription_list(x)))
  }
  if let Some(x) = input.publications {
    fs.push(("Publications", json_of_publication_list(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("ClientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("ClientToken", json.Value.Str(idempotency_token)))
  }
  if let Some(x) = input.tags {
    fs.push(("Tags", json_of_tag_map(x)))
  }
  if let Some(x) = input.permissions {
    fs.push(("Permissions", json_of_permission_list(x)))
  }
  if let Some(x) = input.is_service {
    fs.push(("IsService", json.Value.Bool(x)))
  }
  if let Some(x) = input.initialization_timeout {
    fs.push(("InitializationTimeout", json.Value.Int(x)))
  }
