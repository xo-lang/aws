fn xml_read_role_template_version(e: xml.Element) -> RoleTemplateVersion ! Str {
  var out = RoleTemplateVersion{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TemplateArn" => out.template_arn = c.text()
      "TemplateName" => out.template_name = c.text()
      "TemplateVersionId" => out.template_version_id = c.text()
      "Description" => out.description = c.text()
      "MajorVersion" => out.major_version = xmlv.read_int(c.text())?
      "DefaultMinorVersion" => out.default_minor_version = xmlv.read_int(c.text())?
      "ManagedByType" => out.managed_by_type = ManagedByTypeType.from(c.text())
      "ManagedByValue" => out.managed_by_value = c.text()
      "Enabled" => out.enabled = xmlv.read_bool(c.text())?
      "MinorVersion" => out.minor_version = xmlv.read_int(c.text())?
      "RoleNamePattern" => out.role_name_pattern = c.text()
      "RolePathPattern" => out.role_path_pattern = c.text()
      "RoleDescriptionPattern" => out.role_description_pattern = c.text()
      "AssumeRolePolicyDocumentTemplate" => out.assume_role_policy_document_template = c.text()
      "InlinePolicyTemplates" => out.inline_policy_templates = xml_read_inline_policy_template_list_type(c)?
      "ManagedPolicyArns" => out.managed_policy_arns = xml_read_managed_policy_arn_list_type(c)?
