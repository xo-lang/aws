  pub sub_object_version_ids: List[Int]? = None
  /// Statistics captured for each sub-object referenced by the materialized
  /// view as of its most recent refresh, such as the source type, Glue
  /// version ID, and the partition, file, and byte counts. Each entry
  /// describes one sub-object, identified by its source type.
  pub sub_objects_statistics: List[SubObjectStatistics]? = None
  /// A list of representations.
  pub representations: List[ViewRepresentation]? = None
  /// A map of key-value pairs containing Spark Declarative Pipelines (SDP)
  /// information for the materialized view.
  pub spark_pipeline_info: Map[Str, Str]? = None
}

/// A structure containing details for creating or updating an Glue view.
pub struct ViewDefinitionInput {
  /// You can set this flag as true to instruct the engine not to push
  /// user-provided operations into the logical plan of the view during query
  /// planning. However, setting this flag does not guarantee that the engine
  /// will comply. Refer to the engine's documentation to understand the
  /// guarantees provided, if any.
  pub is_protected: Bool? = None
  /// Specifies whether the materialized view is managed by Glue.
  pub is_managed: Bool? = None
  /// The definer of a view in SQL.
  pub definer: Str? = None
  /// A list of structures that contains the dialect of the view, and the
  /// query that defines the view.
  pub representations: List[ViewRepresentationInput]? = None
  /// The ID value that identifies this view's version. For materialized
  /// views, the version ID is the Apache Iceberg table's snapshot ID.
  pub view_version_id: Int? = None
  /// The version ID of the Apache Iceberg table.
  pub view_version_token: Str? = None
  /// Auto refresh interval in seconds for the materialized view. If not
  /// specified, the view will not automatically refresh.
  pub refresh_seconds: Int? = None
  /// The type of the materialized view's last refresh. Valid values: Full ,
  /// Incremental .
  pub last_refresh_type: LastRefreshType? = None
  /// A list of base table ARNs that make up the view.
  pub sub_objects: List[Str]? = None
  /// List of the Apache Iceberg table versions referenced by the materialized
  /// view.
  pub sub_object_version_ids: List[Int]? = None
  /// Statistics for each sub-object referenced by the materialized view, such
  /// as the source type, Glue version ID, and the partition, file, and byte
  /// counts. Each entry describes one sub-object, identified by its source
  /// type.
  pub sub_objects_statistics: List[SubObjectStatistics]? = None
  /// A map of key-value pairs containing Spark Declarative Pipelines (SDP)
  /// information for the materialized view.
  pub spark_pipeline_info: Map[Str, Str]? = None
}

pub enum ViewDialect: Str {
  Redshift = "REDSHIFT"
  Athena = "ATHENA"
  Spark = "SPARK"
  Unknown(value: Str)
}

/// A structure that contains the dialect of the view, and the query that
/// defines the view.
pub struct ViewRepresentation {
  /// The dialect of the query engine.
  pub dialect: ViewDialect? = None
  /// The version of the dialect of the query engine. For example, 3.0.0.
  pub dialect_version: Str? = None
  /// The SELECT query provided by the customer during CREATE VIEW DDL . This
  /// SQL is not used during a query on a view ( ViewExpandedText is used
  /// instead). ViewOriginalText is used for cases like SHOW CREATE VIEW where
  /// users want to see the original DDL command that created the view.
  pub view_original_text: Str? = None
  /// The expanded SQL for the view. This SQL is used by engines while
  /// processing a query on a view. Engines may perform operations during view
  /// creation to transform ViewOriginalText to ViewExpandedText . For
  /// example: Fully qualified identifiers: SELECT * from table1 - SELECT *
  /// from db1.table1
  pub view_expanded_text: Str? = None
  /// The name of the connection to be used to validate the specific
  /// representation of the view.
  pub validation_connection: Str? = None
  /// Dialects marked as stale are no longer valid and must be updated before
  /// they can be queried in their respective query engines.
  pub is_stale: Bool? = None
}

/// A structure containing details of a representation to update or create a
/// Lake Formation view.
pub struct ViewRepresentationInput {
  /// A parameter that specifies the engine type of a specific representation.
  pub dialect: ViewDialect? = None
  /// A parameter that specifies the version of the engine of a specific
  /// representation.
  pub dialect_version: Str? = None
  /// A string that represents the original SQL query that describes the view.
  pub view_original_text: Str? = None
  /// The name of the connection to be used to validate the specific
  /// representation of the view.
  pub validation_connection: Str? = None
  /// A string that represents the SQL query that describes the view with
  /// expanded resource ARNs
  pub view_expanded_text: Str? = None
}

pub enum ViewUpdateAction: Str {
  Add = "ADD"
  Replace = "REPLACE"
  AddOrReplace = "ADD_OR_REPLACE"
  Drop = "DROP"
  Unknown(value: Str)
}

/// A structure that contains information for an analytical engine to
/// validate a view, prior to persisting the view metadata. Used in the case
/// of direct UpdateTable or CreateTable API calls.
pub struct ViewValidation {
  /// The dialect of the query engine.
  pub dialect: ViewDialect? = None
  /// The version of the dialect of the query engine. For example, 3.0.0.
  pub dialect_version: Str? = None
  /// The SELECT query that defines the view, as provided by the customer.
  pub view_validation_text: Str? = None
  /// The time of the last update.
  pub update_time: Time? = None
  /// The state of the validation.
  pub state: ResourceState? = None
  /// An error associated with the validation.
  pub error: ErrorDetail? = None
}

pub enum WorkerType: Str {
  Standard = "Standard"
  G1X = "G.1X"
  G2X = "G.2X"
  G4X = "G.4X"
  G8X = "G.8X"
  G025X = "G.025X"
  Z2X = "Z.2X"
  G12X = "G.12X"
  G16X = "G.16X"
  R1X = "R.1X"
  R2X = "R.2X"
  R4X = "R.4X"
  R8X = "R.8X"
  Unknown(value: Str)
}

/// A workflow is a collection of multiple dependent Glue jobs and crawlers
/// that are run to complete a complex ETL task. A workflow manages the
/// execution and monitoring of all its jobs and crawlers.
pub struct Workflow {
  /// The name of the workflow.
  pub name: Str? = None
  /// A description of the workflow.
  pub description: Str? = None
  /// A collection of properties to be used as part of each execution of the
  /// workflow. The run properties are made available to each job in the
  /// workflow. A job can modify the properties for the next jobs in the flow.
  pub default_run_properties: Map[Str, Str]? = None
  /// The date and time when the workflow was created.
  pub created_on: Time? = None
  /// The date and time when the workflow was last modified.
  pub last_modified_on: Time? = None
  /// The information about the last execution of the workflow.
  pub last_run: WorkflowRun? = None
  /// The graph representing all the Glue components that belong to the
  /// workflow as nodes and directed connections between them as edges.
  pub graph: WorkflowGraph? = None
  /// You can use this parameter to prevent unwanted multiple updates to data,
  /// to control costs, or in some cases, to prevent exceeding the maximum
  /// number of concurrent runs of any of the component jobs. If you leave
  /// this parameter blank, there is no limit to the number of concurrent
  /// workflow runs.
  pub max_concurrent_runs: Int? = None
  /// This structure indicates the details of the blueprint that this
  /// particular workflow is created from.
  pub blueprint_details: BlueprintDetails? = None
}

/// A workflow graph represents the complete workflow containing all the
/// Glue components present in the workflow and all the directed connections
/// between them.
pub struct WorkflowGraph {
  /// A list of the the Glue components belong to the workflow represented as
  /// nodes.
  pub nodes: List[Node]? = None
  /// A list of all the directed connections between the nodes belonging to
  /// the workflow.
  pub edges: List[Edge]? = None
}

/// A workflow run is an execution of a workflow providing all the runtime
/// information.
pub struct WorkflowRun {
  /// Name of the workflow that was run.
  pub name: Str? = None
  /// The ID of this workflow run.
  pub workflow_run_id: Str? = None
  /// The ID of the previous workflow run.
  pub previous_run_id: Str? = None
  /// The workflow run properties which were set during the run.
  pub workflow_run_properties: Map[Str, Str]? = None
  /// The date and time when the workflow run was started.
  pub started_on: Time? = None
  /// The date and time when the workflow run completed.
  pub completed_on: Time? = None
  /// The status of the workflow run.
  pub status: WorkflowRunStatus? = None
  /// This error message describes any error that may have occurred in
  /// starting the workflow run. Currently the only error message is
  /// "Concurrent runs exceeded for workflow: foo ."
  pub error_message: Str? = None
  /// The statistics of the run.
  pub statistics: WorkflowRunStatistics? = None
  /// The graph representing all the Glue components that belong to the
  /// workflow as nodes and directed connections between them as edges.
  pub graph: WorkflowGraph? = None
  /// The batch condition that started the workflow run.
  pub starting_event_batch_condition: StartingEventBatchCondition? = None
}

/// Workflow run statistics provides statistics about the workflow run.
pub struct WorkflowRunStatistics {
  /// Total number of Actions in the workflow run.
  pub total_actions: Int? = None
  /// Total number of Actions that timed out.
  pub timeout_actions: Int? = None
  /// Total number of Actions that have failed.
  pub failed_actions: Int? = None
  /// Total number of Actions that have stopped.
  pub stopped_actions: Int? = None
  /// Total number of Actions that have succeeded.
  pub succeeded_actions: Int? = None
  /// Total number Actions in running state.
  pub running_actions: Int? = None
  /// Indicates the count of job runs in the ERROR state in the workflow run.
  pub errored_actions: Int? = None
  /// Indicates the count of job runs in WAITING state in the workflow run.
  pub waiting_actions: Int? = None
}

pub enum WorkflowRunStatus: Str {
  Running = "RUNNING"
  Completed = "COMPLETED"
  Stopping = "STOPPING"
  Stopped = "STOPPED"
  Error = "ERROR"
  Unknown(value: Str)
}

/// A classifier for XML content.
pub struct XMLClassifier {
  /// The name of the classifier.
  pub name: Str? = None
  /// An identifier of the data format that the classifier matches.
  pub classification: Str? = None
  /// The time that this classifier was registered.
  pub creation_time: Time? = None
  /// The time that this classifier was last updated.
  pub last_updated: Time? = None
  /// The version of this classifier.
  pub version: Int? = None
  /// The XML tag designating the element that contains each record in an XML
  /// document being parsed. This can't identify a self-closing element
  /// (closed by / ). An empty row element that contains only attributes can
  /// be parsed as long as it ends with a closing tag (for example, is okay,
  /// but is not).
  pub row_tag: Str? = None
}
