  }
  if let Some(x) = v.document_enrichment_configuration {
    fs.push(("documentEnrichmentConfiguration", json_of_document_enrichment_configuration(x)))
  }
  if let Some(x) = v.media_extraction_configuration {
    fs.push(("mediaExtractionConfiguration", json_of_media_extraction_configuration(x)))
  }
  json.Value.Object(fs)
}

fn from_json_document(v: json.Value) -> Document ! Str {
  var out = Document{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "id" => out.id = jsonv.read_str(fv)?
      "attributes" => out.attributes = from_json_document_attributes(fv)?
      "content" => out.content = from_json_document_content(fv)?
      "contentType" => out.content_type = ContentType.from(jsonv.read_str(fv)?)
      "title" => out.title = jsonv.read_str(fv)?
      "accessConfiguration" => out.access_configuration = from_json_access_configuration(fv)?
      "documentEnrichmentConfiguration" => out.document_enrichment_configuration = from_json_document_enrichment_configuration(fv)?
      "mediaExtractionConfiguration" => out.media_extraction_configuration = from_json_media_extraction_configuration(fv)?
