/// Represents a security finding discovered during a pentest job. A finding
/// contains details about a vulnerability, including its risk level,
/// confidence, and remediation status.
pub struct Finding {
  /// The unique identifier of the finding.
  pub finding_id: Str? = None
  /// The unique identifier of the agent space associated with the finding.
  pub agent_space_id: Str? = None
  /// The unique identifier of the pentest associated with the finding.
  pub pentest_id: Str? = None
  /// The unique identifier of the pentest job that produced the finding.
  pub pentest_job_id: Str? = None
  /// The unique identifier of the code review associated with the finding.
  pub code_review_id: Str? = None
  /// The unique identifier of the code review job that produced the finding.
  pub code_review_job_id: Str? = None
  /// The unique identifier of the task that produced the finding.
  pub task_id: Str? = None
  /// The name of the finding.
  pub name: Str? = None
  /// A description of the finding.
  pub description: Str? = None
  /// The current status of the finding. Valid values include ACTIVE,
  /// RESOLVED, ACCEPTED, and FALSE_POSITIVE.
  pub status: FindingStatus? = None
  /// The type of security risk identified by the finding.
  pub risk_type: Str? = None
  /// The risk level of the finding. Valid values include UNKNOWN,
  /// INFORMATIONAL, LOW, MEDIUM, HIGH, and CRITICAL.
  pub risk_level: RiskLevel? = None
  /// The numerical risk score of the finding.
  pub risk_score: Str? = None
  /// The reasoning behind the finding, explaining why it was identified as a
  /// vulnerability.
  pub reasoning: Str? = None
  /// The confidence level of the finding. Valid values include
  /// FALSE_POSITIVE, UNCONFIRMED, LOW, MEDIUM, and HIGH.
  pub confidence: ConfidenceLevel? = None
  /// The simulated validation status of the finding. Valid values are
  /// NOT_VALIDATED, VALIDATING, CONFIRMED, NOT_REPRODUCED, and
  /// VALIDATION_FAILED.
  pub validation_status: ValidationStatus? = None
  /// The attack script used to reproduce the finding.
  pub attack_script: Str? = None
  /// The suggested fix for the finding, describing the changes recommended to
  /// remediate the vulnerability, with example code or configuration.
  pub remediation_code: Str? = None
  /// The code remediation task associated with the finding, if code
  /// remediation was initiated.
  pub code_remediation_task: CodeRemediationTask? = None
  /// The identifier of the entity that last updated the finding.
  pub last_updated_by: Str? = None
  /// A customer-provided note on the finding.
  pub customer_note: Str? = None
  /// The file locations involved in the vulnerability, as reported by the
  /// code scanner.
  pub code_locations: List[CodeLocation]? = None
  /// The verification script metadata for reproducing the finding, including
  /// download URL, instructions, and required environment variables.
  pub verification_script: VerificationScript? = None
  /// The rationale provided by the alignment agent explaining how the finding
  /// was adjusted based on customer preferences.
  pub alignment_rationale: Str? = None
  /// The list of pentest job identifiers for revalidation jobs that retested
  /// this finding.
  pub revalidation_job_ids: List[Str]? = None
  /// The identifier of the original finding that this revalidation finding
  /// was produced from.
  pub original_finding_id: Str? = None
  /// The issue in a third-party issue tracker that this finding has been
  /// exported to.
  pub linked_issue: LinkedIssue? = None
  /// The date and time the finding was created, in UTC format.
  pub created_at: Time? = None
  /// The date and time the finding was last updated, in UTC format.
  pub updated_at: Time? = None
}

/// Finding status.
pub enum FindingStatus: Str {
  Active = "ACTIVE"
  Resolved = "RESOLVED"
  Accepted = "ACCEPTED"
  FalsePositive = "FALSE_POSITIVE"
  Unknown(value: Str)
}

