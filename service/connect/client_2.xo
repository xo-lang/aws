  }
  if let Some(x) = v.metadata {
    fs.push(("Metadata", json_of_evaluation_metadata(x)))
  }
  if let Some(x) = v.answers {
    fs.push(("Answers", json_of_evaluation_answers_output_map(x)))
  }
  if let Some(x) = v.notes {
    fs.push(("Notes", json_of_evaluation_notes_map(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.scores {
    fs.push(("Scores", json_of_evaluation_scores_map(x)))
  }
  if let Some(x) = v.created_time {
    fs.push(("CreatedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_modified_time {
    fs.push(("LastModifiedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.evaluation_type {
    fs.push(("EvaluationType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_map(x)))
  }
  json.Value.Object(fs)
}

