fn xml_write_list_parts_output(var w: xmlv.Writer, v: ListPartsOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.abort_date {
    xmlv.elem(w, "AbortDate", rest.date_time(x), [])
  }
  if let Some(x) = v.abort_rule_id {
    xmlv.elem(w, "AbortRuleId", x, [])
  }
  if let Some(x) = v.bucket {
    xmlv.elem(w, "Bucket", x, [])
  }
  if let Some(x) = v.key {
    xmlv.elem(w, "Key", x, [])
  }
  if let Some(x) = v.upload_id {
    xmlv.elem(w, "UploadId", x, [])
  }
  if let Some(x) = v.part_number_marker {
    xmlv.elem(w, "PartNumberMarker", x, [])
  }
  if let Some(x) = v.next_part_number_marker {
    xmlv.elem(w, "NextPartNumberMarker", x, [])
  }
  if let Some(x) = v.max_parts {
    xmlv.elem(w, "MaxParts", "${x}", [])
  }
  if let Some(x) = v.is_truncated {
    xmlv.elem(w, "IsTruncated", "${x}", [])
  }
  if let Some(x) = v.parts {
    for item in x {
      xml_write_part(w, item, "Part", [])
    }
  }
  if let Some(x) = v.initiator {
    xml_write_initiator(w, x, "Initiator", [])
  }
  if let Some(x) = v.owner {
    xml_write_owner(w, x, "Owner", [])
  }
  if let Some(x) = v.storage_class {
    xmlv.elem(w, "StorageClass", x.value(), [])
  }
  if let Some(x) = v.request_charged {
    xmlv.elem(w, "RequestCharged", x.value(), [])
  }
  if let Some(x) = v.checksum_algorithm {
    xmlv.elem(w, "ChecksumAlgorithm", x.value(), [])
  }
  if let Some(x) = v.checksum_type {
    xmlv.elem(w, "ChecksumType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_list_parts_output(e: xml.Element) -> ListPartsOutput ! Str {
  var out = ListPartsOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "AbortDate" => out.abort_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "AbortRuleId" => out.abort_rule_id = c.text()
      "Bucket" => out.bucket = c.text()
      "Key" => out.key = c.text()
      "UploadId" => out.upload_id = c.text()
      "PartNumberMarker" => out.part_number_marker = c.text()
      "NextPartNumberMarker" => out.next_part_number_marker = c.text()
      "MaxParts" => out.max_parts = xmlv.read_int(c.text())?
      "IsTruncated" => out.is_truncated = xmlv.read_bool(c.text())?
      "Part" => {
        var items = out.parts ?? []
        items.push(xml_read_part(c)?)
        out.parts = items
      }
      "Initiator" => out.initiator = xml_read_initiator(c)?
      "Owner" => out.owner = xml_read_owner(c)?
      "StorageClass" => out.storage_class = StorageClass.from(c.text())
      "RequestCharged" => out.request_charged = RequestCharged.from(c.text())
      "ChecksumAlgorithm" => out.checksum_algorithm = ChecksumAlgorithm.from(c.text())
      "ChecksumType" => out.checksum_type = ChecksumType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

