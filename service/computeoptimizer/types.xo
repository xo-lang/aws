/// A summary of a recommendation.
pub struct RecommendationSummary {
  /// An array of objects that describe a recommendation summary.
  pub summaries: List[Summary]? = None
  /// Describes the findings summary of the idle resources.
  pub idle_summaries: List[IdleSummary]? = None
  /// The resource type that the recommendation summary applies to.
  pub recommendation_resource_type: RecommendationSourceType? = None
  /// The Amazon Web Services account ID of the recommendation summary.
  pub account_id: Str? = None
  /// An object that describes the savings opportunity for a given resource
  /// type. Savings opportunity includes the estimated monthly savings amount
  /// and percentage.
  pub savings_opportunity: SavingsOpportunity? = None
  pub idle_savings_opportunity: SavingsOpportunity? = None
  pub aggregated_savings_opportunity: SavingsOpportunity? = None
  /// An object that describes the performance risk ratings for a given
  /// resource type.
  pub current_performance_risk_ratings: CurrentPerformanceRiskRatings? = None
  /// An array of objects that describes the estimated monthly saving amounts
  /// for the instances running on the specified inferredWorkloadTypes . The
  /// array contains the top five savings opportunites for the instances that
  /// run inferred workload types.
  pub inferred_workload_savings: List[InferredWorkloadSaving]? = None
}

/// Describes a projected utilization metric of a recommendation option. The
/// Cpu and Memory metrics are the only projected utilization metrics
/// returned when you run the GetEC2RecommendationProjectedMetrics action.
/// Additionally, the Memory metric is returned only for resources that have
/// the unified CloudWatch agent installed on them. For more information,
/// see Enabling Memory Utilization with the CloudWatch Agent .
pub struct RecommendedOptionProjectedMetric {
  /// The recommended instance type.
  pub recommended_instance_type: Str? = None
  /// The rank of the recommendation option projected metric. The top
  /// recommendation option is ranked as 1 . The projected metric rank
  /// correlates to the recommendation option rank. For example, the projected
  /// metric ranked as 1 is related to the recommendation option that is also
  /// ranked as 1 in the same response.
  pub rank: Int? = None
  /// An array of objects that describe a projected utilization metric.
  pub projected_metrics: List[ProjectedMetric]? = None
}

