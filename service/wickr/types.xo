  pub enable_guest_federation: Bool? = None
  /// Enables message preview text in push notifications, allowing users to
  /// see message content before opening the app.
  pub enable_notification_preview: Bool? = None
  /// Allow users to avoid censorship when they are geo-blocked or have
  /// network limitations.
  pub enable_open_access_option: Bool? = None
  /// Enables restricted global federation, limiting external communication to
  /// only specified permitted networks.
  pub enable_restricted_global_federation: Bool? = None
  /// Enables file sharing capabilities, allowing users to send and receive
