/// Creates a new accessor for use with Amazon Managed Blockchain service
/// that supports token based access. The accessor contains information
/// required for token based access.
pub fn (c: Client) create_accessor(input: CreateAccessorInput) -> CreateAccessorOutput ! CreateAccessorErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_create_accessor(c.params, input)) ?? e => return Err(CreateAccessorErr.InvalidInput(e))
  var req = serialize_create_accessor(ep, input, rest.uuid(c.rand)) ?? e => return Err(CreateAccessorErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(CreateAccessorErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_create_accessor_error(resp))
  }
  deserialize_create_accessor(resp) ?? e => Err(CreateAccessorErr.Deserialize(e))
}

