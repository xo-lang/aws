// Secrets Manager (awsJson1_1) against LocalStack (decision 0005, emulator tests): run by
// scripts/integration-localstack.sh, with invented credentials. The client
// gets a Net that reaches only the loopback host.

use github.com/xo-lang/aws/credentials
use github.com/xo-lang/aws/service/secretsmanager

test "secrets manager round trip against LocalStack" uses net, env, clock {
  let endpoint = os.env.get("XO_AWS_TEST_ENDPOINT") ?? "http://127.0.0.1:14566"
  let id = os.env.get("XO_AWS_TEST_KEY_ID") ?? "AKIDTEST0000000000"
  let secret = os.env.get("XO_AWS_TEST_SECRET") ?? ""
  let c = secretsmanager.new(os.net.only(["127.0.0.1", "localhost"]), os.clock, os.rand, secretsmanager.Options{
    endpoint: endpoint,
    credentials: credentials.static_provider(id, secret),
  })?
  let name = "xo-lang-aws-it"
  let made = c.create_secret(secretsmanager.CreateSecretRequest{name: name, secret_string: "first"})?
  expect(made.name) == Some(name)
  let v1 = c.get_secret_value(secretsmanager.GetSecretValueRequest{secret_id: name})?
  expect(v1.secret_string) == Some("first")
  c.put_secret_value(secretsmanager.PutSecretValueRequest{secret_id: name, secret_string: "second"})?
  let v2 = c.get_secret_value(secretsmanager.GetSecretValueRequest{secret_id: name})?
  expect(v2.secret_string) == Some("second")
  expect(v2.version_id != v1.version_id) == true
  c.delete_secret(secretsmanager.DeleteSecretRequest{secret_id: name, force_delete_without_recovery: true})?
  match c.get_secret_value(secretsmanager.GetSecretValueRequest{secret_id: "xo-lang-aws-no-such-secret"}) {
    Err(secretsmanager.GetSecretValueErr.ResourceNotFoundException(_)) => {}
    other => expect("${other:?}") == "ResourceNotFoundException"
  }
}
