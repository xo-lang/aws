/// Describes an internet gateway.
pub struct InternetGateway {
  /// Any VPCs attached to the internet gateway.
  pub attachments: List[InternetGatewayAttachment]? = None
  /// The ID of the internet gateway.
  pub internet_gateway_id: Str? = None
  /// The ID of the Amazon Web Services account that owns the internet
  /// gateway.
  pub owner_id: Str? = None
  /// Any tags assigned to the internet gateway.
  pub tags: List[Tag]? = None
}

/// Describes the attachment of a VPC to an internet gateway or an
/// egress-only internet gateway.
pub struct InternetGatewayAttachment {
  /// The current state of the attachment. For an internet gateway, the state
  /// is available when attached to a VPC; otherwise, this value is not
  /// returned.
  pub state: AttachmentStatus? = None
  /// The ID of the VPC.
  pub vpc_id: Str? = None
}

pub enum InternetGatewayBlockMode: Str {
  Off = "off"
  BlockBidirectional = "block-bidirectional"
  BlockIngress = "block-ingress"
  Unknown(value: Str)
}

pub enum InternetGatewayExclusionMode: Str {
  AllowBidirectional = "allow-bidirectional"
  AllowEgress = "allow-egress"
  Unknown(value: Str)
}

/// Represents the allocation of capacity from a source reservation to an
/// interruptible reservation, tracking current and target instance counts
/// for allocation management.
pub struct InterruptibleCapacityAllocation {
  /// The current number of instances allocated to the interruptible
  /// reservation.
  pub instance_count: Int? = None
  /// After your modify request, the requested number of instances allocated
  /// to interruptible reservation.
  pub target_instance_count: Int? = None
  /// The current status of the allocation (updating during reclamation,
  /// active when complete).
  pub status: InterruptibleCapacityReservationAllocationStatus? = None
  /// The ID of the interruptible Capacity Reservation created from the
  /// allocation.
  pub interruptible_capacity_reservation_id: Str? = None
  /// The type of interruption policy applied to the interruptible
  /// reservation.
