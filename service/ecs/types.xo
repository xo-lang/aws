  /// stage. ROLLBACK - Rolls back the deployment to the previous service
  /// revision. Default: ROLLBACK
  pub action: DeploymentLifecycleHookAction? = None
}

pub enum DeploymentRolloutState: Str {
  Completed = "COMPLETED"
  Failed = "FAILED"
  InProgress = "IN_PROGRESS"
  Unknown(value: Str)
}

pub enum DeploymentStrategy: Str {
