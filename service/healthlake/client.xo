  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "S3Uri" => Ok(InputDataConfig.S3Uri(jsonv.read_str(fv)?))
      _ => Ok(InputDataConfig.Unknown(k))
    }
  }
  Err("InputDataConfig: no member set")
}

