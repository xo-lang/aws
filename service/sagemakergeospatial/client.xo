fn json_of_property(v: Property) -> json.Value {
  match v {
    EoCloudCover(x) => json.Value.Object([("EoCloudCover", json_of_eo_cloud_cover_input(x))])
    ViewOffNadir(x) => json.Value.Object([("ViewOffNadir", json_of_view_off_nadir_input(x))])
    ViewSunAzimuth(x) => json.Value.Object([("ViewSunAzimuth", json_of_view_sun_azimuth_input(x))])
    ViewSunElevation(x) => json.Value.Object([("ViewSunElevation", json_of_view_sun_elevation_input(x))])
    Platform(x) => json.Value.Object([("Platform", json_of_platform_input(x))])
    LandsatCloudCoverLand(x) => json.Value.Object([("LandsatCloudCoverLand", json_of_landsat_cloud_cover_land_input(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_property(v: json.Value) -> Property ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "EoCloudCover" => Ok(Property.EoCloudCover(from_json_eo_cloud_cover_input(fv)?))
      "ViewOffNadir" => Ok(Property.ViewOffNadir(from_json_view_off_nadir_input(fv)?))
      "ViewSunAzimuth" => Ok(Property.ViewSunAzimuth(from_json_view_sun_azimuth_input(fv)?))
      "ViewSunElevation" => Ok(Property.ViewSunElevation(from_json_view_sun_elevation_input(fv)?))
      "Platform" => Ok(Property.Platform(from_json_platform_input(fv)?))
      "LandsatCloudCoverLand" => Ok(Property.LandsatCloudCoverLand(from_json_landsat_cloud_cover_land_input(fv)?))
      _ => Ok(Property.Unknown(k))
    }
  }
  Err("Property: no member set")
}

