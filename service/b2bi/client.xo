/// Instantiates a capability based on the specified parameters. A trading
/// capability contains the information required to transform incoming EDI
/// documents into JSON or XML outputs.
pub fn (c: Client) create_capability(input: CreateCapabilityRequest) -> CreateCapabilityResponse ! CreateCapabilityErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_create_capability(c.params, input)) ?? e => return Err(CreateCapabilityErr.InvalidInput(e))
  var req = serialize_create_capability(ep, input, rest.uuid(c.rand)) ?? e => return Err(CreateCapabilityErr.InvalidInput(e))
  for h in extra {
