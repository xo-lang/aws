  /// The type of translation name. Valid values are Abbreviation , AreaCode ,
  /// BaseName , Exonym , Shortened , and Synonym .
  pub type_value: TranslationNameType? = None
  /// If true , indicates this is the primary name variant for the given
  /// language.
  pub primary: Bool? = None
  /// If true , indicates this name is a transliterated version rather than a
  /// native script translation.
  pub transliterated: Bool? = None
}

pub enum TranslationNameType: Str {
  Abbreviation = "Abbreviation"
  AreaCode = "AreaCode"
  BaseName = "BaseName"
  Exonym = "Exonym"
  Shortened = "Shortened"
  Synonym = "Synonym"
  Unknown(value: Str)
}

pub enum TypePlacement: Str {
  BeforeBaseName = "BeforeBaseName"
  AfterBaseName = "AfterBaseName"
  Unknown(value: Str)
}

/// The USPS zip code.
pub struct UspsZip {
  /// The ZIP Classification Code, or in other words what type of postal code
  /// is it.
  pub zip_classification_code: ZipClassificationCode? = None
}

/// The USPS zip+4 code.
pub struct UspsZipPlus4 {
  /// The USPS ZIP+4 Record Type Code.
  pub record_type_code: RecordTypeCode? = None
}

