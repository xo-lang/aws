// EC2 instance metadata credentials (decision 0003), as aws-sdk-go-v2's
// credentials/ec2rolecreds over feature/ec2/imds: an IMDSv2 session
// token (PUT /latest/api/token), the instance's role
// (/latest/meta-data/iam/security-credentials/), then that role's
// credentials. IMDSv1 (no token) is off unless `allow_v1` is set.

use std/http
use std/json
use github.com/xo-lang/aws
use github.com/xo-lang/aws/protocol/jsonv

pub const IPV4_ENDPOINT: Str = "http://169.254.169.254"
pub const IPV6_ENDPOINT: Str = "http://[fd00:ec2::254]"
const TOKEN_PATH: Str = "/latest/api/token"
const ROLE_PATH: Str = "/latest/meta-data/iam/security-credentials/"
const TTL_HEADER: Str = "X-Aws-Ec2-Metadata-Token-Ttl-Seconds"
const TOKEN_HEADER: Str = "X-Aws-Ec2-Metadata-Token"

pub struct Options {
  /// The endpoint, without a path ("" for the mode's default).
  pub endpoint: Str = ""
  /// "IPv4" (the default) or "IPv6".
  pub mode: Str = "IPv4"
  /// The session token's lifetime (6 hours, the most IMDS gives).
  pub token_ttl: Duration = 6h
  /// Each request's time limit (aws-sdk-go-v2 gives the operation 5s).
  pub timeout: Duration = 2s
  /// Attempts for a 5xx or a timeout of an answering endpoint.
  pub max_attempts: Int = 3
  /// Fall back to IMDSv1 when the token request is refused (403, 404,
  /// 405). Off: an instance that requires IMDSv2 is the safe default.
  pub allow_v1: Bool = false
}

/// The base URL for `opts`: the endpoint given, else the mode's.
pub fn endpoint_of(opts: Options) -> Str {
  if opts.endpoint != "" {
    return opts.endpoint.trim_end_chars("/")
  }
  if opts.mode.to_lower() == "ipv6" { IPV6_ENDPOINT } else { IPV4_ENDPOINT }
}

/// The provider: wrap it in `credentials.cache`. Not `Provider`: a
/// program whose own `Provider` is boxed into an interface would
/// collide with it (docs/reports/xo-issues.md 15).
pub struct Ec2RoleProvider {
  http: http.Client
  clock: Clock
  rand: Rand
  opts: Options
  /// The session token and when it expires (unix millis).
  token: Mutex[(Str, Int)?]
  /// The last credentials, kept when a refresh fails (aws-sdk-go-v2's
  /// HandleFailToRefresh).
  last: Mutex[aws.Credentials?]
}

pub fn provider(net: Net, clock: Clock, rand: Rand, opts: Options = Options{}) -> Ec2RoleProvider {
  Ec2RoleProvider{
    http: http.client(net, opts.timeout),
    clock: clock,
    rand: rand,
    opts: opts,
    token: Mutex.new(None),
    last: Mutex.new(None),
  }
}

/// Why a request to the metadata service failed.
enum Fail {
  /// The endpoint did not answer: not on EC2 (the chain moves on).
  Unreachable(msg: Str)
  /// It answered with this status.
  Status(code: Int, body: Str)
  /// Anything else.
  Other(msg: Str)
}

fn (f: Fail) text() -> Str {
  match f {
    Unreachable(m) => m
    Status(c, b) => "HTTP ${c}${if b == "" { "" } else { ": ${b}" }}"
    Other(m) => m
  }
}

pub fn (p: Ec2RoleProvider) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  match p.fetch() {
    Ok(c) => {
      p.last.reset(Some(c))
      Ok(c)
    }
    Err(Fail.Unreachable(m)) => Err(aws.CredentialsErr.NotFound("EC2 instance metadata: ${m}"))
    Err(f) => {
      // keep the last credentials a while rather than fail the caller
      // while the metadata service is down
      let prev = p.last.with_read(fn(l: aws.Credentials?) -> aws.Credentials? { l })
      if let Some(c) = prev {
        let now = p.clock.now()
        if !aws.expires_within(c, now, 5m) {
          return Ok(c)
        }
        let extra = 5 * 60 * 1000 + Int(p.rand.float() * 10.0 * 60.0 * 1000.0)
        let kept = c with {expires: Some(Time.from_unix_millis(now.unix_millis() + extra))}
        p.last.reset(Some(kept))
        return Ok(kept)
      }
      if f is Fail.Status(404, _) {
        return Err(aws.CredentialsErr.NotFound("EC2 instance metadata: no role is attached to this instance"))
      }
      Err(aws.CredentialsErr.Fetch("EC2 instance metadata: ${f.text()}"))
    }
  }
}

fn (p: Ec2RoleProvider) fetch() -> aws.Credentials ! Fail uses (net.dial, clock, rand) {
  let roles = p.get(ROLE_PATH)?
  let role = roles.lines().map(fn(l: Str) -> Str { l.trim() }).filter(fn(l: Str) -> Bool { l != "" })
  if role.is_empty() {
    return Err(Fail.Status(code: 404, body: ""))
  }
  let text = p.get("${ROLE_PATH}${role[0]}")?
  let doc = jsonv.parse_body(text.bytes()).ok() ?? return Err(Fail.Other("the role's credentials are not JSON"))
  let field = fn(k: Str) -> Str {
    match doc.get(k) {
      Some(json.Value.Str(s)) => s
      _ => ""
    }
  }
  if field("Code").to_lower() != "success" {
    return Err(Fail.Other("role ${role[0]}: ${field("Code")} ${field("Message")}"))
  }
  let expires = Time.parse_rfc3339(field("Expiration")) ?? return Err(Fail.Other("role ${role[0]}: no Expiration"))
  if field("AccessKeyId") == "" {
    return Err(Fail.Other("role ${role[0]}: no AccessKeyId"))
  }
  // at most an hour, as aws-sdk-go-v2 (the instance rotates them)
  let hour = p.clock.now().unix_millis() + 3600 * 1000
  let until = if expires.unix_millis() > hour { Time.from_unix_millis(hour) } else { expires }
  Ok(aws.Credentials{
    access_key_id: field("AccessKeyId"),
    secret_access_key: Secret.new(field("SecretAccessKey")),
    session_token: Secret.new(field("Token")),
    expires: until,
    source: "EC2RoleProvider",
    features: ["0"],
  })
}

/// GET `path` with the session token, fetching one first; a 401 drops
/// the token and tries once more.
fn (p: Ec2RoleProvider) get(path: Str) -> Str ! Fail uses (net.dial, clock, rand) {
  var tries = 0
  while true {
    tries += 1
    let tok = p.session()?
    var req = http.new_request("GET", "${endpoint_of(p.opts)}${path}")
    if let Some(t) = tok {
      req = req.with_header(TOKEN_HEADER, t)
    }
    let resp = p.send(req)?
    if resp.status == 200 {
      return Ok(resp.body.to_str() ?? "")
    }
    if resp.status == 401 && tries < 2 {
      p.token.reset(None)
      continue
    }
    return Err(Fail.Status(code: resp.status, body: (resp.body.to_str() ?? "").trim()))
  }
  Err(Fail.Other("unreachable"))
}

/// The session token (None under the IMDSv1 fallback).
fn (p: Ec2RoleProvider) session() -> Str? ! Fail uses (net.dial, clock, rand) {
  let now = p.clock.now().unix_millis()
  let held = p.token.with_read(fn(t: (Str, Int)?) -> (Str, Int)? { t })
  if let Some((t, until)) = held {
    if now < until {
      return Ok(Some(t))
    }
  }
  let ttl = p.opts.token_ttl.millis() / 1000
  let req = http.new_request("PUT", "${endpoint_of(p.opts)}${TOKEN_PATH}").with_header(TTL_HEADER, "${ttl}")
  let resp = p.send(req)?
  if resp.status == 200 {
    let t = (resp.body.to_str() ?? "").trim()
    let secs = Int.parse(resp.header_values(TTL_HEADER).first() ?? "") ?? ttl
    // renew a minute early
    p.token.reset(Some((t, now + (secs - 60).max(0) * 1000)))
    return Ok(Some(t))
  }
  if [403, 404, 405].contains(resp.status) && p.opts.allow_v1 {
    return Ok(None)
  }
  Err(Fail.Status(code: resp.status, body: "the IMDSv2 token request was refused${if [403, 404, 405].contains(resp.status) { " (IMDSv1 fallback is off: Options.allow_v1)" } else { "" }}"))
}

/// One request, retried on 5xx and on a timeout of an endpoint that has
/// answered before; a connection failure is Unreachable at once, so a
/// chain off EC2 does not wait.
fn (p: Ec2RoleProvider) send(req: http.Request) -> http.Response ! Fail uses (net.dial, clock, rand) {
  var attempt = 0
  while true {
    attempt += 1
    match p.http.send(req) {
      Ok(resp) => {
        if resp.status >= 500 && attempt < p.opts.max_attempts {
          p.clock.sleep(Duration.from_millis(100 * attempt))
          continue
        }
        return Ok(resp)
      }
      Err(http.ClientErr.Connect(m)) => return Err(Fail.Unreachable(m))
      Err(http.ClientErr.Timeout) => return Err(Fail.Unreachable("no answer within ${p.opts.timeout}"))
      Err(e) => return Err(Fail.Other(e.display()))
    }
  }
  Err(Fail.Other("unreachable"))
}
