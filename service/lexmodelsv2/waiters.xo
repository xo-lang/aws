/// Wait until a bot is available
///
/// Calls DescribeBot until the BotAvailable acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (10s) to `max_delay` (120s).
pub fn wait_until_bot_available(c: Client, input: DescribeBotRequest, max_wait: Duration, min_delay: Duration = 10s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeBotErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_bot(input) {
      Ok(out) => {
        let o = jmes_of_describe_bot_response(out)
        if state == "" && waiter.path_matches(o, "botStatus", "stringEquals", "Available") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "botStatus", "stringEquals", "Deleting") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "botStatus", "stringEquals", "Failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "botStatus", "stringEquals", "Inactive") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("BotAvailable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

