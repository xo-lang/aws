  }
  if let Some(x) = v.identify_multiple_languages {
    fs.push(("IdentifyMultipleLanguages", json.Value.Bool(x)))
  }
  if let Some(x) = v.language_options {
    fs.push(("LanguageOptions", jmes_of_language_options(x)))
  }
  if let Some(x) = v.identified_language_score {
    fs.push(("IdentifiedLanguageScore", jsonv.float(Float(x))))
  }
  if let Some(x) = v.language_codes {
    fs.push(("LanguageCodes", jmes_of_language_code_list(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", jmes_of_tag_list(x)))
  }
  if let Some(x) = v.subtitles {
    fs.push(("Subtitles", jmes_of_subtitles_output(x)))
  }
  if let Some(x) = v.language_id_settings {
    fs.push(("LanguageIdSettings", jmes_of_language_id_settings_map(x)))
  }
  if let Some(x) = v.toxicity_detection {
    fs.push(("ToxicityDetection", jmes_of_toxicity_detection(x)))
  }
  json.Value.Object(fs)
}

