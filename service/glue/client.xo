      "LastUpdatedTime" => out.last_updated_time = jsonv.read_time(fv, "epoch-seconds")?
      "LastUpdatedBy" => out.last_updated_by = jsonv.read_str(fv)?
      "Status" => out.status = ConnectionStatus.from(jsonv.read_str(fv)?)
