/// A StartCallAnalyticsStreamTranscription stream: `send` writes input events (signed in a chain),
/// `close_send` ends them, and `close` ends the whole stream.
pub struct StartCallAnalyticsStreamTranscriptionStream {
  pub output: StartCallAnalyticsStreamTranscriptionResponse
  writer: http.PipeWriter
  signer: sigv4.StreamSigner
  clock: Clock
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
  sent_end: Bool = false
}

/// Sends input event `e`.
pub fn (var s: StartCallAnalyticsStreamTranscriptionStream) send(e: AudioStream) -> () ! IoErr uses clock {
  let m = eventstream.encode(event_message_audio_stream(e))
  s.writer.write(eventstream.signed(s.signer, m, s.clock.now()))
}

/// Ends the input events: sends the signed empty message and closes
/// the request body.
pub fn (var s: StartCallAnalyticsStreamTranscriptionStream) close_send() -> () ! IoErr uses clock {
  if s.sent_end {
    return Ok(())
  }
  s.sent_end = true
  let r = s.writer.write(eventstream.signed(s.signer, b"", s.clock.now()))
  s.writer.close()
  r
}

/// The next event, None at the end of the stream.
pub fn (var s: StartCallAnalyticsStreamTranscriptionStream) next() -> CallAnalyticsTranscriptResultStream? ! CallAnalyticsTranscriptResultStreamErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(CallAnalyticsTranscriptResultStreamErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              continue
            }
            return match event_call_analytics_transcript_result_stream(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(CallAnalyticsTranscriptResultStreamErr.Read(msg))
            }
          }
          "exception" => return Err(exception_call_analytics_transcript_result_stream(m))
          _ => return Err(CallAnalyticsTranscriptResultStreamErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(CallAnalyticsTranscriptResultStreamErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(CallAnalyticsTranscriptResultStreamErr.Read(e.display()))
          }
        }
      }
    }
  }
  Ok(None)
}

/// Ends the stream in both directions.
pub fn (var s: StartCallAnalyticsStreamTranscriptionStream) close() uses clock {
  match s.close_send() {
    Ok(_) => {}
    // closing anyway: a failed end message changes nothing here
    Err(_) => {}
  }
  if !s.done {
    s.done = true
    s.body.close()
  }
}

fn event_message_audio_stream(v: AudioStream) -> eventstream.Message {
  match v {
    AudioEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("AudioEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/octet-stream")})
      eventstream.Message{headers: hs, payload: x.audio_chunk ?? b""}
    }
    ConfigurationEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("ConfigurationEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.channel_definitions {
        fs.push(("ChannelDefinitions", json_of_channel_definitions(y)))
      }
      if let Some(y) = x.post_call_analytics_settings {
        fs.push(("PostCallAnalyticsSettings", json_of_post_call_analytics_settings(y)))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    Unknown(_) => eventstream.Message{}
  }
}

/// Why reading a CallAnalyticsTranscriptResultStream stream stopped.
pub enum CallAnalyticsTranscriptResultStreamErr {
  BadRequestException(e: BadRequestException)
  LimitExceededException(e: LimitExceededException)
  InternalFailureException(e: InternalFailureException)
  ConflictException(e: ConflictException)
  ServiceUnavailableException(e: ServiceUnavailableException)
  /// An error message, or an exception the model does not list.
  Api(e: aws.ApiError)
  /// The body could not be read or is not event stream messages.
  Read(msg: Str)
}

pub fn (e: CallAnalyticsTranscriptResultStreamErr) display() -> Str {
  match e {
    BadRequestException(x) => "BadRequestException: ${x:?}"
    LimitExceededException(x) => "LimitExceededException: ${x:?}"
    InternalFailureException(x) => "InternalFailureException: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    ServiceUnavailableException(x) => "ServiceUnavailableException: ${x:?}"
    Api(x) => x.display()
    Read(msg) => "event stream: ${msg}"
  }
}

fn event_call_analytics_transcript_result_stream(t: Str, m: eventstream.Message) -> CallAnalyticsTranscriptResultStream ! Str {
  match t {
    "UtteranceEvent" => Ok(CallAnalyticsTranscriptResultStream.UtteranceEvent(event_read_utterance_event(m)?))
    "CategoryEvent" => Ok(CallAnalyticsTranscriptResultStream.CategoryEvent(event_read_category_event(m)?))
    _ => Ok(CallAnalyticsTranscriptResultStream.Unknown(t))
  }
}

fn exception_call_analytics_transcript_result_stream(m: eventstream.Message) -> CallAnalyticsTranscriptResultStreamErr {
  let t = m.header_str(":exception-type")
  match t {
    "BadRequestException" => match exception_read_bad_request_exception(m.payload) {
      Ok(x) => CallAnalyticsTranscriptResultStreamErr.BadRequestException(x)
      Err(msg) => CallAnalyticsTranscriptResultStreamErr.Read(msg)
    }
    "LimitExceededException" => match exception_read_limit_exceeded_exception(m.payload) {
      Ok(x) => CallAnalyticsTranscriptResultStreamErr.LimitExceededException(x)
      Err(msg) => CallAnalyticsTranscriptResultStreamErr.Read(msg)
    }
