// Package fileio sends a file as a streamed request body (decision 0011):
// a module of its own so the root reaches no files. A program that
// uploads files requires it (`xo get github.com/xo-lang/aws/fileio`) and
// accepts `fs.read` for it alone.

use github.com/xo-lang/aws
use std/http
use std/task

/// The file at `path`, read on a task started on `tasks` (a group that
/// outlives the call, such as `os.tasks`) each time an attempt sends it,
/// since the transport has no file effect: each attempt asks the task
/// for a fresh copy through a pipe. The length is the file's size now.
/// The operation that sends it ends the task when it returns, so an
/// upload is used once.
pub fn upload_file(tasks: task.Group, fs: Fs, path: Str, piece: Int = 65536) -> aws.Upload ! FsErr uses fs.read {
  let info = fs.stat(path)? ?? return Err(FsErr.NotFound(path))
  let requests = Chan[http.PipeWriter].new()
  tasks.spawn_background(fn() { serve_file(fs, path, piece, requests) })
  Ok(aws.upload_opener(
    fn() -> http.BodyReader ! Str {
      let (w, r) = http.pipe()
      requests.send(w)
      Ok(r)
    },
    length: Some(info.size),
    done: fn() { requests.close() },
  ))
}

fn serve_file(fs: Fs, path: Str, piece: Int, requests: Chan[http.PipeWriter]) uses fs.read {
  while let Some(w) = requests.recv() {
    match copy_file(fs, path, piece, w) {
      Ok(_) => w.close()
      Err(e) => w.close_with_error(IoErr.Io("reading ${path}: ${e}"))
    }
  }
}

fn copy_file(fs: Fs, path: Str, piece: Int, w: http.PipeWriter) -> () ! Str uses fs.read {
  let f = fs.open(path) ?? e => return Err(e.display())
  while let Some(b) = f.read(piece) ?? e => {
    f.close().ignore_err("closing a file read to upload")
    return Err(e.display())
  } {
    // the client stopped reading (the attempt ended): stop too
    w.write(b) ?? e => {
      f.close().ignore_err("closing a file read to upload")
      return Err(e.display())
    }
  }
  f.close().ignore_err("closing a file read to upload")
  Ok(())
}
