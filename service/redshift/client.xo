      "S3Tables" => out.s3_tables = xml_read_log_type_list(c)?
      "S3TableNamespace" => out.s3_table_namespace = c.text()
      "S3TableGranularity" => out.s3_table_granularity = c.text()
      "EnabledAll" => out.enabled_all = xmlv.read_bool(c.text())?
      "LastIngestionTimes" => out.last_ingestion_times = xml_read_s3_table_last_ingestion_time_map(c)?
