  let out = p.client.list_fleet_deployments(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}

