      "vpnEcmpSupport" => out.vpn_ecmp_support = VpnEcmpSupportValue.from(c.text())
      "dnsSupport" => out.dns_support = DnsSupportValue.from(c.text())
      "securityGroupReferencingSupport" => out.security_group_referencing_support = SecurityGroupReferencingSupportValue.from(c.text())
      "multicastSupport" => out.multicast_support = MulticastSupportValue.from(c.text())
      "encryptionSupport" => out.encryption_support = xml_read_encryption_support(c)?
      _ => {}
    }
  }
  Ok(out)
}

