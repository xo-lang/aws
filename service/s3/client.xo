  if let Some(x) = v.sse_customer_key_md5 {
    xmlv.elem(w, "SSECustomerKeyMD5", x, [])
  }
  if let Some(x) = v.expression {
    xmlv.elem(w, "Expression", x, [])
  }
  if let Some(x) = v.expression_type {
    xmlv.elem(w, "ExpressionType", x.value(), [])
  }
  if let Some(x) = v.request_progress {
    xml_write_request_progress(w, x, "RequestProgress", [])
  }
  if let Some(x) = v.input_serialization {
