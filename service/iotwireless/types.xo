/// Global navigation satellite system (GNSS) object used for positioning.
pub struct Gnss {
  /// Payload that contains the GNSS scan result, or NAV message, in
  /// hexadecimal notation.
  pub payload: Str? = None
  /// Optional parameter that gives an estimate of the time when the GNSS scan
  /// information is taken, in seconds GPS time (GPST). If capture time is not
  /// specified, the local server time is used.
  pub capture_time: Float? = None
  /// Optional value that gives the capture time estimate accuracy, in
  /// seconds. If capture time accuracy is not specified, default value of 300
  /// is used.
  pub capture_time_accuracy: Float? = None
  /// Optional assistance position information, specified using latitude and
  /// longitude values in degrees. The coordinates are inside the WGS84
  /// reference frame.
  pub assist_position: List[Float]? = None
  /// Optional assistance altitude, which is the altitude of the device at
  /// capture time, specified in meters above the WGS84 reference ellipsoid.
  pub assist_altitude: Float? = None
  /// Optional parameter that forces 2D solve, which modifies the positioning
  /// algorithm to a 2D solution problem. When this parameter is specified,
  /// the assistance altitude should have an accuracy of at least 10 meters.
  pub use2_d_solver: Bool? = None
}

/// A single GNSS scan capture containing the scan payload and optional
/// capture time.
pub struct GnssCapture {
  /// Payload that contains the GNSS scan result, or NAV message, in
  /// hexadecimal notation.
  pub payload: Str? = None
  /// Optional parameter that gives an estimate of the time when the GNSS scan
  /// information is taken, in seconds GPS time (GPST). If capture time is not
  /// specified, the local server time is used.
  pub capture_time: Float? = None
}

/// Global navigation satellite system (GNSS) multi-frame object used for
/// positioning. Contains multiple GNSS scan captures that are combined by
/// the solver.
pub struct GnssMultiFrame {
  /// List of GNSS scan captures. Each capture contains a payload from a
  /// single GNSS scan. The number of captures must be 2, 4, 8, 16, or 32.
  pub captures: List[GnssCapture]? = None
  /// Optional value that gives the capture time estimate accuracy, in
  /// seconds. If capture time accuracy is not specified, default value of 300
  /// is used.
  pub capture_time_accuracy: Float? = None
  /// Optional assistance position information, specified using latitude and
  /// longitude values in degrees. The coordinates are inside the WGS84
  /// reference frame.
  pub assist_position: List[Float]? = None
  /// Optional assistance altitude, which is the altitude of the device at
  /// capture time, specified in meters above the WGS84 reference ellipsoid.
  /// This parameter is required when Use2DSolver is enabled.
  pub assist_altitude: Float? = None
  /// Optional parameter that forces 2D solve, which modifies the positioning
  /// algorithm to a 2D solution problem. When this parameter is specified,
  /// the assistance altitude should have an accuracy of at least 10 meters.
  pub use2_d_solver: Bool? = None
}

