      "clientCertificates" => out.client_certificates = from_json_client_certificate_list(fv)?
      "codeRemediationStrategy" => out.code_remediation_strategy = CodeRemediationStrategy.from(jsonv.read_str(fv)?)
      "cleanUpStrategy" => out.clean_up_strategy = CleanUpStrategy.from(jsonv.read_str(fv)?)
