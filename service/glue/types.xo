  pub exclusions: List[Str]? = None
  /// Specify a value of RAWTYPES or COMMENTS to enable additional metadata in
  /// table responses. RAWTYPES provides the native-level datatype. COMMENTS
  /// provides comments associated with a column or table in the database. If
  /// you do not need additional metadata, keep the field empty.
  pub enable_additional_metadata: List[JdbcMetadataEntry]? = None
}

/// Specifies a job definition.
pub struct Job {
  /// The name you assign to this job definition.
  pub name: Str? = None
  /// A mode that describes how a job was created. Valid values are: SCRIPT -
  /// The job was created using the Glue Studio script editor. VISUAL - The
  /// job was created using the Glue Studio visual editor. NOTEBOOK - The job
  /// was created using an interactive sessions notebook. When the JobMode
  /// field is missing or null, SCRIPT is assigned as the default value.
  pub job_mode: JobMode? = None
  /// Specifies whether job run queuing is enabled for the job runs for this
  /// job. A value of true means job run queuing is enabled for the job runs.
  /// If false or not populated, the job runs will not be considered for
  /// queueing. If this field does not match the value set in the job run,
  /// then the value from the job run field will be used.
  pub job_run_queuing_enabled: Bool? = None
  /// A description of the job.
  pub description: Str? = None
  /// This field is reserved for future use.
  pub log_uri: Str? = None
  /// The name or Amazon Resource Name (ARN) of the IAM role associated with
  /// this job.
  pub role: Str? = None
  /// The time and date that this job definition was created.
  pub created_on: Time? = None
  /// The last point in time when this job definition was modified.
  pub last_modified_on: Time? = None
  /// An ExecutionProperty specifying the maximum number of concurrent runs
  /// allowed for this job.
  pub execution_property: ExecutionProperty? = None
  /// The JobCommand that runs this job.
  pub command: JobCommand? = None
  /// The default arguments for every run of this job, specified as name-value
  /// pairs. You can specify arguments here that your own job-execution script
  /// consumes, as well as arguments that Glue itself consumes. Job arguments
  /// may be logged. Do not pass plaintext secrets as arguments. Retrieve
  /// secrets from a Glue Connection, Secrets Manager or other secret
  /// management mechanism if you intend to keep them within the Job. For
  /// information about how to specify and consume your own Job arguments, see
  /// the Calling Glue APIs in Python topic in the developer guide. For
  /// information about the arguments you can provide to this field when
  /// configuring Spark jobs, see the Special Parameters Used by Glue topic in
  /// the developer guide. For information about the arguments you can provide
  /// to this field when configuring Ray jobs, see Using job parameters in Ray
  /// jobs in the developer guide.
  pub default_arguments: Map[Str, Str]? = None
  /// Arguments for this job that are not overridden when providing job
  /// arguments in a job run, specified as name-value pairs.
  pub non_overridable_arguments: Map[Str, Str]? = None
  /// The connections used for this job.
  pub connections: ConnectionsList? = None
  /// The maximum number of times to retry this job after a JobRun fails.
  pub max_retries: Int? = None
  /// This field is deprecated. Use MaxCapacity instead. The number of Glue
  /// data processing units (DPUs) allocated to runs of this job. You can
  /// allocate a minimum of 2 DPUs; the default is 10. A DPU is a relative
  /// measure of processing power that consists of 4 vCPUs of compute capacity
  /// and 16 GB of memory. For more information, see the Glue pricing page .
  pub allocated_capacity: Int? = None
  /// The job timeout in minutes. This is the maximum time that a job run can
  /// consume resources before it is terminated and enters TIMEOUT status.
  /// Jobs must have timeout values less than 7 days or 10080 minutes.
  /// Otherwise, the jobs will throw an exception. When the value is left
  /// blank, the timeout is defaulted to 2,880 minutes for Glue version 4.0
  /// and earlier, or 480 minutes for Glue version 5.0 and later. Any existing
  /// Glue jobs that had a timeout value greater than 7 days will be defaulted
  /// to 7 days. For instance if you have specified a timeout of 20 days for a
  /// batch job, it will be stopped on the 7th day. For streaming jobs, if you
  /// have set up a maintenance window, it will be restarted during the
  /// maintenance window after 7 days.
  pub timeout: Int? = None
  /// For Glue version 1.0 or earlier jobs, using the standard worker type,
  /// the number of Glue data processing units (DPUs) that can be allocated
  /// when this job runs. A DPU is a relative measure of processing power that
  /// consists of 4 vCPUs of compute capacity and 16 GB of memory. For more
  /// information, see the Glue pricing page . For Glue version 2.0 or later
  /// jobs, you cannot specify a Maximum capacity . Instead, you should
  /// specify a Worker type and the Number of workers . Do not set MaxCapacity
  /// if using WorkerType and NumberOfWorkers . The value that can be
  /// allocated for MaxCapacity depends on whether you are running a Python
  /// shell job, an Apache Spark ETL job, or an Apache Spark streaming ETL
  /// job: When you specify a Python shell job ( JobCommand.Name
  /// ="pythonshell"), you can allocate either 0.0625 or 1 DPU. The default is
  /// 0.0625 DPU. When you specify an Apache Spark ETL job ( JobCommand.Name
  /// ="glueetl") or Apache Spark streaming ETL job ( JobCommand.Name
  /// ="gluestreaming"), you can allocate from 2 to 100 DPUs. The default is
  /// 10 DPUs. This job type cannot have a fractional DPU allocation.
  pub max_capacity: Float? = None
  /// The type of predefined worker that is allocated when a job runs. Glue
  /// provides multiple worker types to accommodate different workload
  /// requirements: G Worker Types (General-purpose compute workers): G.1X: 1
  /// DPU (4 vCPUs, 16 GB memory, 94GB disk) G.2X: 2 DPU (8 vCPUs, 32 GB
  /// memory, 138GB disk) G.4X: 4 DPU (16 vCPUs, 64 GB memory, 256GB disk)
  /// G.8X: 8 DPU (32 vCPUs, 128 GB memory, 512GB disk) G.12X: 12 DPU (48
  /// vCPUs, 192 GB memory, 768GB disk) G.16X: 16 DPU (64 vCPUs, 256 GB
  /// memory, 1024GB disk) R Worker Types (Memory-optimized workers): R.1X: 1
  /// M-DPU (4 vCPUs, 32 GB memory, 94GB disk) R.2X: 2 M-DPU (8 vCPUs, 64 GB
  /// memory, 138GB disk) R.4X: 4 M-DPU (16 vCPUs, 128 GB memory, 256GB disk)
  /// R.8X: 8 M-DPU (32 vCPUs, 256 GB memory, 512GB disk) The G.12X , G.16X ,
  /// and R.1X through R.8X worker types are available only for Glue version
  /// 4.0 or later Spark ETL jobs in select Amazon Web Services Regions. For
  /// the supported Regions, see Configuring job properties for Spark jobs in
  /// the developer guide.
  pub worker_type: WorkerType? = None
  /// The number of workers of a defined workerType that are allocated when a
  /// job runs.
  pub number_of_workers: Int? = None
  /// The name of the SecurityConfiguration structure to be used with this
  /// job.
  pub security_configuration: Str? = None
  /// Specifies configuration properties of a job notification.
  pub notification_property: NotificationProperty? = None
  /// In Spark jobs, GlueVersion determines the versions of Apache Spark and
  /// Python that Glue available in a job. The Python version indicates the
  /// version supported for jobs of type Spark. Ray jobs should set
  /// GlueVersion to 4.0 or greater. However, the versions of Ray, Python and
  /// additional libraries available in your Ray job are determined by the
  /// Runtime parameter of the Job command. For more information about the
  /// available Glue versions and corresponding Spark and Python versions, see
  /// Glue version in the developer guide. Jobs that are created without
  /// specifying a Glue version default to Glue 5.1.
  pub glue_version: Str? = None
  /// The representation of a directed acyclic graph on which both the Glue
  /// Studio visual component and Glue Studio code generation is based.
  pub code_gen_configuration_nodes: Map[Str, CodeGenConfigurationNode]? = None
  /// Indicates whether the job is run with a standard or flexible execution
  /// class. The standard execution class is ideal for time-sensitive
  /// workloads that require fast job startup and dedicated resources. The
  /// flexible execution class is appropriate for time-insensitive jobs whose
  /// start and completion times may vary. Only jobs with Glue version 3.0 and
  /// above and command type glueetl will be allowed to set ExecutionClass to
  /// FLEX . The flexible execution class is available for Spark jobs.
  pub execution_class: ExecutionClass? = None
  /// The details for a source control configuration for a job, allowing
  /// synchronization of job artifacts to or from a remote repository.
  pub source_control_details: SourceControlDetails? = None
  /// This field specifies a day of the week and hour for a maintenance window
  /// for streaming jobs. Glue periodically performs maintenance activities.
  /// During these maintenance windows, Glue will need to restart your
  /// streaming jobs. Glue will restart the job within 3 hours of the
  /// specified maintenance window. For instance, if you set up the
  /// maintenance window for Monday at 10:00AM GMT, your jobs will be
  /// restarted between 10:00AM GMT to 1:00PM GMT.
  pub maintenance_window: Str? = None
  /// The name of an Glue usage profile associated with the job.
  pub profile_name: Str? = None
}

/// Defines a point that a job can resume processing.
pub struct JobBookmarkEntry {
  /// The name of the job in question.
  pub job_name: Str? = None
  /// The version of the job.
  pub version: Int? = None
  /// The run ID number.
  pub run: Int? = None
  /// The attempt ID number.
  pub attempt: Int? = None
  /// The unique run identifier associated with the previous job run.
  pub previous_run_id: Str? = None
  /// The run ID number.
  pub run_id: Str? = None
  /// The bookmark itself.
  pub job_bookmark: Str? = None
}

/// Specifies how job bookmark data should be encrypted.
pub struct JobBookmarksEncryption {
  /// The encryption mode to use for job bookmarks data.
  pub job_bookmarks_encryption_mode: JobBookmarksEncryptionMode? = None
  /// The Amazon Resource Name (ARN) of the KMS key to be used to encrypt the
  /// data.
  pub kms_key_arn: Str? = None
}

pub enum JobBookmarksEncryptionMode: Str {
  Disabled = "DISABLED"
  Csekms = "CSE-KMS"
  Unknown(value: Str)
}

/// Specifies code that runs when a job is run.
pub struct JobCommand {
  /// The name of the job command. For an Apache Spark ETL job, this must be
  /// glueetl . For a Python shell job, it must be pythonshell . For an Apache
  /// Spark streaming ETL job, this must be gluestreaming . For a Ray job,
  /// this must be glueray .
  pub name: Str? = None
  /// Specifies the Amazon Simple Storage Service (Amazon S3) path to a script
  /// that runs a job.
  pub script_location: Str? = None
  /// The Python version being used to run a Python shell job. Allowed values
  /// are 2 or 3.
  pub python_version: Str? = None
  /// In Ray jobs, Runtime is used to specify the versions of Ray, Python and
  /// additional libraries available in your environment. This field is not
  /// used in other job types. For supported runtime environment values, see
  /// Supported Ray runtime environments in the Glue Developer Guide.
  pub runtime: Str? = None
}

pub enum JobMode: Str {
  Script = "SCRIPT"
  Visual = "VISUAL"
  Notebook = "NOTEBOOK"
  Unknown(value: Str)
}

/// The details of a Job node present in the workflow.
pub struct JobNodeDetails {
  /// The information for the job runs represented by the job node.
  pub job_runs: List[JobRun]? = None
}

/// Contains information about a job run.
pub struct JobRun {
  /// The ID of this job run.
  pub id: Str? = None
  /// The number of the attempt to run this job.
  pub attempt: Int? = None
  /// The ID of the previous run of this job. For example, the JobRunId
  /// specified in the StartJobRun action.
  pub previous_run_id: Str? = None
  /// The name of the trigger that started this job run.
  pub trigger_name: Str? = None
  /// The name of the job definition being used in this run.
  pub job_name: Str? = None
  /// A mode that describes how a job was created. Valid values are: SCRIPT -
  /// The job was created using the Glue Studio script editor. VISUAL - The
  /// job was created using the Glue Studio visual editor. NOTEBOOK - The job
  /// was created using an interactive sessions notebook. When the JobMode
  /// field is missing or null, SCRIPT is assigned as the default value.
  pub job_mode: JobMode? = None
  /// Specifies whether job run queuing is enabled for the job run. A value of
  /// true means job run queuing is enabled for the job run. If false or not
  /// populated, the job run will not be considered for queueing.
  pub job_run_queuing_enabled: Bool? = None
  /// The date and time at which this job run was started.
  pub started_on: Time? = None
  /// The last time that this job run was modified.
  pub last_modified_on: Time? = None
  /// The date and time that this job run completed.
  pub completed_on: Time? = None
  /// The current state of the job run. For more information about the
  /// statuses of jobs that have terminated abnormally, see Glue Job Run
  /// Statuses .
  pub job_run_state: JobRunState? = None
  /// The job arguments associated with this run. For this job run, they
  /// replace the default arguments set in the job definition itself. You can
  /// specify arguments here that your own job-execution script consumes, as
  /// well as arguments that Glue itself consumes. Job arguments may be
  /// logged. Do not pass plaintext secrets as arguments. Retrieve secrets
  /// from a Glue Connection, Secrets Manager or other secret management
  /// mechanism if you intend to keep them within the Job. For information
  /// about how to specify and consume your own Job arguments, see the Calling
  /// Glue APIs in Python topic in the developer guide. For information about
  /// the arguments you can provide to this field when configuring Spark jobs,
  /// see the Special Parameters Used by Glue topic in the developer guide.
  /// For information about the arguments you can provide to this field when
  /// configuring Ray jobs, see Using job parameters in Ray jobs in the
  /// developer guide.
  pub arguments: Map[Str, Str]? = None
  /// An error message associated with this job run.
  pub error_message: Str? = None
  /// A list of predecessors to this job run.
  pub predecessor_runs: List[Predecessor]? = None
  /// This field is deprecated. Use MaxCapacity instead. The number of Glue
  /// data processing units (DPUs) allocated to this JobRun. From 2 to 100
  /// DPUs can be allocated; the default is 10. A DPU is a relative measure of
  /// processing power that consists of 4 vCPUs of compute capacity and 16 GB
  /// of memory. For more information, see the Glue pricing page .
  pub allocated_capacity: Int? = None
  /// The amount of time (in seconds) that the job run consumed resources.
  pub execution_time: Int? = None
  /// The JobRun timeout in minutes. This is the maximum time that a job run
  /// can consume resources before it is terminated and enters TIMEOUT status.
  /// This value overrides the timeout value set in the parent job. Jobs must
  /// have timeout values less than 7 days or 10080 minutes. Otherwise, the
  /// jobs will throw an exception. When the value is left blank, the timeout
  /// is defaulted to 2,880 minutes for Glue version 4.0 and earlier, or 480
  /// minutes for Glue version 5.0 and later. Any existing Glue jobs that had
  /// a timeout value greater than 7 days will be defaulted to 7 days. For
  /// instance if you have specified a timeout of 20 days for a batch job, it
  /// will be stopped on the 7th day. For streaming jobs, if you have set up a
  /// maintenance window, it will be restarted during the maintenance window
  /// after 7 days.
  pub timeout: Int? = None
  /// For Glue version 1.0 or earlier jobs, using the standard worker type,
  /// the number of Glue data processing units (DPUs) that can be allocated
  /// when this job runs. A DPU is a relative measure of processing power that
  /// consists of 4 vCPUs of compute capacity and 16 GB of memory. For more
  /// information, see the Glue pricing page . For Glue version 2.0+ jobs, you
  /// cannot specify a Maximum capacity . Instead, you should specify a Worker
  /// type and the Number of workers . Do not set MaxCapacity if using
  /// WorkerType and NumberOfWorkers . The value that can be allocated for
  /// MaxCapacity depends on whether you are running a Python shell job, an
  /// Apache Spark ETL job, or an Apache Spark streaming ETL job: When you
  /// specify a Python shell job ( JobCommand.Name ="pythonshell"), you can
  /// allocate either 0.0625 or 1 DPU. The default is 0.0625 DPU. When you
  /// specify an Apache Spark ETL job ( JobCommand.Name ="glueetl") or Apache
  /// Spark streaming ETL job ( JobCommand.Name ="gluestreaming"), you can
  /// allocate from 2 to 100 DPUs. The default is 10 DPUs. This job type
  /// cannot have a fractional DPU allocation.
  pub max_capacity: Float? = None
  /// The type of predefined worker that is allocated when a job runs. Accepts
  /// a value of G.025X, G.1X, G.2X, G.4X, G.8X, G.12X, G.16X, R.1X, R.2X,
  /// R.4X, or R.8X for Spark jobs. Accepts the value Z.2X for Ray jobs. For
  /// the G.025X worker type, each worker maps to 0.25 DPU (2 vCPUs, 4 GB of
  /// memory) with 84GB disk, and provides 1 executor per worker. We recommend
  /// this worker type for low volume streaming jobs. This worker type is only
  /// available for Glue version 3.0 or later streaming jobs. For the G.1X
  /// worker type, each worker maps to 1 DPU (4 vCPUs, 16 GB of memory) with
  /// 94GB disk, and provides 1 executor per worker. We recommend this worker
  /// type for workloads such as data transforms, joins, and queries, to
  /// offers a scalable and cost effective way to run most jobs. For the G.2X
  /// worker type, each worker maps to 2 DPU (8 vCPUs, 32 GB of memory) with
  /// 138GB disk, and provides 1 executor per worker. We recommend this worker
  /// type for workloads such as data transforms, joins, and queries, to
  /// offers a scalable and cost effective way to run most jobs. For the G.4X
  /// worker type, each worker maps to 4 DPU (16 vCPUs, 64 GB of memory) with
  /// 256GB disk, and provides 1 executor per worker. We recommend this worker
  /// type for jobs whose workloads contain your most demanding transforms,
  /// aggregations, joins, and queries. This worker type is available only for
  /// Glue version 3.0 or later Spark ETL jobs in select Amazon Web Services
  /// Regions. For the supported Regions, see Configuring job properties for
  /// Spark jobs in the developer guide. For the G.8X worker type, each worker
  /// maps to 8 DPU (32 vCPUs, 128 GB of memory) with 512GB disk, and provides
  /// 1 executor per worker. We recommend this worker type for jobs whose
  /// workloads contain your most demanding transforms, aggregations, joins,
  /// and queries. This worker type is available only for Glue version 3.0 or
  /// later Spark ETL jobs in select Amazon Web Services Regions. For the
  /// supported Regions, see Configuring job properties for Spark jobs in the
  /// developer guide. For the G.12X worker type, each worker maps to 12 DPU
  /// (48 vCPUs, 192 GB of memory) with 768GB disk, and provides 1 executor
  /// per worker. We recommend this worker type for jobs with very large
  /// workloads. This worker type is available only for Glue version 4.0 or
  /// later Spark ETL jobs in select Amazon Web Services Regions. For the
  /// supported Regions, see Configuring job properties for Spark jobs in the
  /// developer guide. For the G.16X worker type, each worker maps to 16 DPU
  /// (64 vCPUs, 256 GB of memory) with 1024GB disk, and provides 1 executor
  /// per worker. We recommend this worker type for jobs with very large
  /// workloads. This worker type is available only for Glue version 4.0 or
  /// later Spark ETL jobs in select Amazon Web Services Regions. For the
  /// supported Regions, see Configuring job properties for Spark jobs in the
  /// developer guide. For the R.1X worker type, each worker maps to 1 M-DPU
  /// (4 vCPUs, 32 GB of memory) with 94GB disk, and provides 1 executor per
  /// worker. We recommend this worker type for memory-intensive workloads.
  /// This worker type is available only for Glue version 4.0 or later Spark
  /// ETL jobs in select Amazon Web Services Regions. For the supported
  /// Regions, see Configuring job properties for Spark jobs in the developer
  /// guide. For the R.2X worker type, each worker maps to 2 M-DPU (8 vCPUs,
  /// 64 GB of memory) with 138GB disk, and provides 1 executor per worker. We
  /// recommend this worker type for memory-intensive workloads. This worker
  /// type is available only for Glue version 4.0 or later Spark ETL jobs in
  /// select Amazon Web Services Regions. For the supported Regions, see
  /// Configuring job properties for Spark jobs in the developer guide. For
  /// the R.4X worker type, each worker maps to 4 M-DPU (16 vCPUs, 128 GB of
  /// memory) with 256GB disk, and provides 1 executor per worker. We
  /// recommend this worker type for memory-intensive workloads. This worker
  /// type is available only for Glue version 4.0 or later Spark ETL jobs in
  /// select Amazon Web Services Regions. For the supported Regions, see
  /// Configuring job properties for Spark jobs in the developer guide. For
  /// the R.8X worker type, each worker maps to 8 M-DPU (32 vCPUs, 256 GB of
  /// memory) with 512GB disk, and provides 1 executor per worker. We
  /// recommend this worker type for memory-intensive workloads. This worker
  /// type is available only for Glue version 4.0 or later Spark ETL jobs in
  /// select Amazon Web Services Regions. For the supported Regions, see
  /// Configuring job properties for Spark jobs in the developer guide. For
  /// the Z.2X worker type, each worker maps to 2 M-DPU (8vCPUs, 64 GB of
  /// memory) with 128 GB disk, and provides up to 8 Ray workers based on the
  /// autoscaler.
  pub worker_type: WorkerType? = None
  /// The number of workers of a defined workerType that are allocated when a
  /// job runs.
  pub number_of_workers: Int? = None
  /// The name of the SecurityConfiguration structure to be used with this job
  /// run.
  pub security_configuration: Str? = None
  /// The name of the log group for secure logging that can be server-side
  /// encrypted in Amazon CloudWatch using KMS. This name can be
  /// /aws-glue/jobs/ , in which case the default encryption is NONE . If you
  /// add a role name and SecurityConfiguration name (in other words,
  /// /aws-glue/jobs-yourRoleName-yourSecurityConfigurationName/ ), then that
  /// security configuration is used to encrypt the log group.
  pub log_group_name: Str? = None
  /// Specifies configuration properties of a job run notification.
  pub notification_property: NotificationProperty? = None
  /// In Spark jobs, GlueVersion determines the versions of Apache Spark and
  /// Python that Glue available in a job. The Python version indicates the
  /// version supported for jobs of type Spark. Ray jobs should set
  /// GlueVersion to 4.0 or greater. However, the versions of Ray, Python and
  /// additional libraries available in your Ray job are determined by the
  /// Runtime parameter of the Job command. For more information about the
  /// available Glue versions and corresponding Spark and Python versions, see
  /// Glue version in the developer guide. Jobs that are created without
  /// specifying a Glue version default to Glue 5.1.
  pub glue_version: Str? = None
  /// This field can be set for either job runs with execution class FLEX or
  /// when Auto Scaling is enabled, and represents the total time each
  /// executor ran during the lifecycle of a job run in seconds, multiplied by
  /// a DPU factor (1 for G.1X , 2 for G.2X , or 0.25 for G.025X workers).
  /// This value may be different than the executionEngineRuntime *
  /// MaxCapacity as in the case of Auto Scaling jobs, as the number of
  /// executors running at a given time may be less than the MaxCapacity .
  /// Therefore, it is possible that the value of DPUSeconds is less than
  /// executionEngineRuntime * MaxCapacity .
  pub dpu_seconds: Float? = None
  /// Indicates whether the job is run with a standard or flexible execution
  /// class. The standard execution-class is ideal for time-sensitive
  /// workloads that require fast job startup and dedicated resources. The
  /// flexible execution class is appropriate for time-insensitive jobs whose
  /// start and completion times may vary. Only jobs with Glue version 3.0 and
  /// above and command type glueetl will be allowed to set ExecutionClass to
  /// FLEX . The flexible execution class is available for Spark jobs.
  pub execution_class: ExecutionClass? = None
  /// This field specifies a day of the week and hour for a maintenance window
  /// for streaming jobs. Glue periodically performs maintenance activities.
  /// During these maintenance windows, Glue will need to restart your
  /// streaming jobs. Glue will restart the job within 3 hours of the
  /// specified maintenance window. For instance, if you set up the
  /// maintenance window for Monday at 10:00AM GMT, your jobs will be
  /// restarted between 10:00AM GMT to 1:00PM GMT.
  pub maintenance_window: Str? = None
  /// The name of an Glue usage profile associated with the job run.
  pub profile_name: Str? = None
  /// This field holds details that pertain to the state of a job run. The
  /// field is nullable. For example, when a job run is in a WAITING state as
  /// a result of job run queuing, the field has the reason why the job run is
  /// in that state.
  pub state_detail: Str? = None
  /// This inline session policy to the StartJobRun API allows you to
  /// dynamically restrict the permissions of the specified execution role for
  /// the scope of the job, without requiring the creation of additional IAM
  /// roles.
  pub execution_role_session_policy: Str? = None
}

pub enum JobRunState: Str {
  Starting = "STARTING"
  Running = "RUNNING"
  Stopping = "STOPPING"
  Stopped = "STOPPED"
  Succeeded = "SUCCEEDED"
  Failed = "FAILED"
  Timeout = "TIMEOUT"
  Error = "ERROR"
  Waiting = "WAITING"
  Expired = "EXPIRED"
  Unknown(value: Str)
}

/// Specifies information used to update an existing job definition. The
/// previous job definition is completely overwritten by this information.
pub struct JobUpdate {
  /// A mode that describes how a job was created. Valid values are: SCRIPT -
  /// The job was created using the Glue Studio script editor. VISUAL - The
  /// job was created using the Glue Studio visual editor. NOTEBOOK - The job
  /// was created using an interactive sessions notebook. When the JobMode
  /// field is missing or null, SCRIPT is assigned as the default value.
  pub job_mode: JobMode? = None
  /// Specifies whether job run queuing is enabled for the job runs for this
  /// job. A value of true means job run queuing is enabled for the job runs.
  /// If false or not populated, the job runs will not be considered for
  /// queueing. If this field does not match the value set in the job run,
  /// then the value from the job run field will be used.
  pub job_run_queuing_enabled: Bool? = None
  /// Description of the job being defined.
  pub description: Str? = None
  /// This field is reserved for future use.
  pub log_uri: Str? = None
  /// The name or Amazon Resource Name (ARN) of the IAM role associated with
  /// this job (required).
  pub role: Str? = None
  /// An ExecutionProperty specifying the maximum number of concurrent runs
  /// allowed for this job.
  pub execution_property: ExecutionProperty? = None
  /// The JobCommand that runs this job (required).
  pub command: JobCommand? = None
  /// The default arguments for every run of this job, specified as name-value
  /// pairs. You can specify arguments here that your own job-execution script
  /// consumes, as well as arguments that Glue itself consumes. Job arguments
  /// may be logged. Do not pass plaintext secrets as arguments. Retrieve
  /// secrets from a Glue Connection, Secrets Manager or other secret
  /// management mechanism if you intend to keep them within the Job. For
  /// information about how to specify and consume your own Job arguments, see
  /// the Calling Glue APIs in Python topic in the developer guide. For
  /// information about the arguments you can provide to this field when
  /// configuring Spark jobs, see the Special Parameters Used by Glue topic in
  /// the developer guide. For information about the arguments you can provide
  /// to this field when configuring Ray jobs, see Using job parameters in Ray
  /// jobs in the developer guide.
  pub default_arguments: Map[Str, Str]? = None
  /// Arguments for this job that are not overridden when providing job
  /// arguments in a job run, specified as name-value pairs.
  pub non_overridable_arguments: Map[Str, Str]? = None
  /// The connections used for this job.
  pub connections: ConnectionsList? = None
  /// The maximum number of times to retry this job if it fails.
  pub max_retries: Int? = None
  /// This field is deprecated. Use MaxCapacity instead. The number of Glue
  /// data processing units (DPUs) to allocate to this job. You can allocate a
  /// minimum of 2 DPUs; the default is 10. A DPU is a relative measure of
  /// processing power that consists of 4 vCPUs of compute capacity and 16 GB
  /// of memory. For more information, see the Glue pricing page .
  pub allocated_capacity: Int? = None
  /// The job timeout in minutes. This is the maximum time that a job run can
  /// consume resources before it is terminated and enters TIMEOUT status.
  /// Jobs must have timeout values less than 7 days or 10080 minutes.
  /// Otherwise, the jobs will throw an exception. When the value is left
  /// blank, the timeout is defaulted to 2,880 minutes for Glue version 4.0
  /// and earlier, or 480 minutes for Glue version 5.0 and later. Any existing
  /// Glue jobs that had a timeout value greater than 7 days will be defaulted
  /// to 7 days. For instance if you have specified a timeout of 20 days for a
  /// batch job, it will be stopped on the 7th day. For streaming jobs, if you
  /// have set up a maintenance window, it will be restarted during the
  /// maintenance window after 7 days.
  pub timeout: Int? = None
  /// For Glue version 1.0 or earlier jobs, using the standard worker type,
  /// the number of Glue data processing units (DPUs) that can be allocated
  /// when this job runs. A DPU is a relative measure of processing power that
  /// consists of 4 vCPUs of compute capacity and 16 GB of memory. For more
  /// information, see the Glue pricing page . For Glue version 2.0+ jobs, you
  /// cannot specify a Maximum capacity . Instead, you should specify a Worker
  /// type and the Number of workers . Do not set MaxCapacity if using
  /// WorkerType and NumberOfWorkers . The value that can be allocated for
  /// MaxCapacity depends on whether you are running a Python shell job, an
  /// Apache Spark ETL job, or an Apache Spark streaming ETL job: When you
  /// specify a Python shell job ( JobCommand.Name ="pythonshell"), you can
  /// allocate either 0.0625 or 1 DPU. The default is 0.0625 DPU. When you
  /// specify an Apache Spark ETL job ( JobCommand.Name ="glueetl") or Apache
  /// Spark streaming ETL job ( JobCommand.Name ="gluestreaming"), you can
  /// allocate from 2 to 100 DPUs. The default is 10 DPUs. This job type
  /// cannot have a fractional DPU allocation.
  pub max_capacity: Float? = None
  /// The type of predefined worker that is allocated when a job runs. Accepts
  /// a value of G.025X, G.1X, G.2X, G.4X, G.8X, G.12X, G.16X, R.1X, R.2X,
  /// R.4X, or R.8X for Spark jobs. Accepts the value Z.2X for Ray jobs. For
  /// more information, see Defining job properties for Spark jobs The G.12X ,
  /// G.16X , and R.1X through R.8X worker types are available only for Glue
  /// version 4.0 or later Spark ETL jobs in select Amazon Web Services
  /// Regions. For the supported Regions, see Configuring job properties for
  /// Spark jobs in the developer guide.
  pub worker_type: WorkerType? = None
  /// The number of workers of a defined workerType that are allocated when a
  /// job runs.
  pub number_of_workers: Int? = None
  /// The name of the SecurityConfiguration structure to be used with this
  /// job.
  pub security_configuration: Str? = None
  /// Specifies the configuration properties of a job notification.
  pub notification_property: NotificationProperty? = None
  /// In Spark jobs, GlueVersion determines the versions of Apache Spark and
  /// Python that Glue available in a job. The Python version indicates the
  /// version supported for jobs of type Spark. Ray jobs should set
  /// GlueVersion to 4.0 or greater. However, the versions of Ray, Python and
  /// additional libraries available in your Ray job are determined by the
  /// Runtime parameter of the Job command. For more information about the
  /// available Glue versions and corresponding Spark and Python versions, see
  /// Glue version in the developer guide. If not provided in the update
  /// request, the Glue version retains the value from the existing job
  /// definition.
  pub glue_version: Str? = None
  /// The representation of a directed acyclic graph on which both the Glue
  /// Studio visual component and Glue Studio code generation is based.
  pub code_gen_configuration_nodes: Map[Str, CodeGenConfigurationNode]? = None
  /// Indicates whether the job is run with a standard or flexible execution
  /// class. The standard execution-class is ideal for time-sensitive
  /// workloads that require fast job startup and dedicated resources. The
  /// flexible execution class is appropriate for time-insensitive jobs whose
  /// start and completion times may vary. Only jobs with Glue version 3.0 and
  /// above and command type glueetl will be allowed to set ExecutionClass to
  /// FLEX . The flexible execution class is available for Spark jobs.
  pub execution_class: ExecutionClass? = None
  /// The details for a source control configuration for a job, allowing
  /// synchronization of job artifacts to or from a remote repository.
  pub source_control_details: SourceControlDetails? = None
  /// This field specifies a day of the week and hour for a maintenance window
  /// for streaming jobs. Glue periodically performs maintenance activities.
  /// During these maintenance windows, Glue will need to restart your
  /// streaming jobs. Glue will restart the job within 3 hours of the
  /// specified maintenance window. For instance, if you set up the
  /// maintenance window for Monday at 10:00AM GMT, your jobs will be
  /// restarted between 10:00AM GMT to 1:00PM GMT.
  pub maintenance_window: Str? = None
}

/// Specifies a transform that joins two datasets into one dataset using a
/// comparison phrase on the specified data property keys. You can use
/// inner, outer, left, right, left semi, and left anti joins.
pub struct Join {
  /// The name of the transform node.
  pub name: Str? = None
  /// The data inputs identified by their node names.
  pub inputs: List[Str]? = None
  /// Specifies the type of join to be performed on the datasets.
  pub join_type: JoinType? = None
  /// A list of the two columns to be joined.
  pub columns: List[JoinColumn]? = None
}

/// Specifies a column to be joined.
pub struct JoinColumn {
  /// The column to be joined.
  pub from_value: Str? = None
  /// The key of the column to be joined.
  pub keys: List[List[Str]]? = None
}

pub enum JoinType: Str {
  Equijoin = "equijoin"
  Left = "left"
  Right = "right"
  Outer = "outer"
  LeftSemi = "leftsemi"
  LeftAnti = "leftanti"
  Unknown(value: Str)
}

/// A classifier for JSON content.
pub struct JsonClassifier {
  /// The name of the classifier.
  pub name: Str? = None
  /// The time that this classifier was registered.
  pub creation_time: Time? = None
  /// The time that this classifier was last updated.
  pub last_updated: Time? = None
  /// The version of this classifier.
  pub version: Int? = None
  /// A JsonPath string defining the JSON data for the classifier to classify.
  /// Glue supports a subset of JsonPath, as described in Writing JsonPath
  /// Custom Classifiers .
  pub json_path: Str? = None
}

/// The KMS key specified is not accessible.
pub struct KMSKeyNotAccessibleFault {
  /// A message describing the problem.
  pub message: Str? = None
}

/// Additional options for streaming.
pub struct KafkaStreamingSourceOptions {
  /// A list of bootstrap server URLs, for example, as
  /// b-1.vpc-test-2.o4q88o.c6.kafka.us-east-1.amazonaws.com:9094 . This
  /// option must be specified in the API call or defined in the table
  /// metadata in the Data Catalog.
  pub bootstrap_servers: Str? = None
  /// The protocol used to communicate with brokers. The possible values are
  /// "SSL" or "PLAINTEXT" .
  pub security_protocol: Str? = None
  /// The name of the connection.
  pub connection_name: Str? = None
  /// The topic name as specified in Apache Kafka. You must specify at least
  /// one of "topicName" , "assign" or "subscribePattern" .
  pub topic_name: Str? = None
  /// The specific TopicPartitions to consume. You must specify at least one
  /// of "topicName" , "assign" or "subscribePattern" .
  pub assign: Str? = None
  /// A Java regex string that identifies the topic list to subscribe to. You
  /// must specify at least one of "topicName" , "assign" or
  /// "subscribePattern" .
  pub subscribe_pattern: Str? = None
  /// An optional classification.
  pub classification: Str? = None
  /// Specifies the delimiter character.
  pub delimiter: Str? = None
  /// The starting position in the Kafka topic to read data from. The possible
  /// values are "earliest" or "latest" . The default value is "latest" .
  pub starting_offsets: Str? = None
  /// The end point when a batch query is ended. Possible values are either
  /// "latest" or a JSON string that specifies an ending offset for each
  /// TopicPartition .
  pub ending_offsets: Str? = None
  /// The timeout in milliseconds to poll data from Kafka in Spark job
  /// executors. The default value is 512 .
  pub poll_timeout_ms: Int? = None
  /// The number of times to retry before failing to fetch Kafka offsets. The
  /// default value is 3 .
  pub num_retries: Int? = None
  /// The time in milliseconds to wait before retrying to fetch Kafka offsets.
  /// The default value is 10 .
  pub retry_interval_ms: Int? = None
  /// The rate limit on the maximum number of offsets that are processed per
  /// trigger interval. The specified total number of offsets is
  /// proportionally split across topicPartitions of different volumes. The
  /// default value is null, which means that the consumer reads all offsets
  /// until the known latest offset.
  pub max_offsets_per_trigger: Int? = None
  /// The desired minimum number of partitions to read from Kafka. The default
  /// value is null, which means that the number of spark partitions is equal
  /// to the number of Kafka partitions.
  pub min_partitions: Int? = None
  /// Whether to include the Kafka headers. When the option is set to "true",
  /// the data output will contain an additional column named
  /// "glue_streaming_kafka_headers" with type Array[Struct(key: String,
  /// value: String)] . The default value is "false". This option is available
  /// in Glue version 3.0 or later only.
  pub include_headers: Bool? = None
  /// When this option is set to 'true', the data output will contain an
  /// additional column named "__src_timestamp" that indicates the time when
  /// the corresponding record received by the topic. The default value is
  /// 'false'. This option is supported in Glue version 4.0 or later.
  pub add_record_timestamp: Str? = None
  /// When this option is set to 'true', for each batch, it will emit the
  /// metrics for the duration between the oldest record received by the topic
  /// and the time it arrives in Glue to CloudWatch. The metric's name is
  /// "glue.driver.streaming.maxConsumerLagInMs". The default value is
  /// 'false'. This option is supported in Glue version 4.0 or later.
  pub emit_consumer_lag_metrics: Str? = None
  /// The timestamp of the record in the Kafka topic to start reading data
  /// from. The possible values are a timestamp string in UTC format of the
  /// pattern yyyy-mm-ddTHH:MM:SSZ (where Z represents a UTC timezone offset
  /// with a +/-. For example: "2023-04-04T08:00:00+08:00"). Only one of
  /// StartingTimestamp or StartingOffsets must be set.
  pub starting_timestamp: Time? = None
}

/// A partition key pair consisting of a name and a type.
pub struct KeySchemaElement {
  /// The name of a partition key.
  pub name: Str? = None
  /// The type of a partition key.
  pub type_value: Str? = None
}