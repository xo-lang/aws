  /// The Amazon Resource Name (ARN) of the resource.
  pub resource_arn: Str? = None
  /// Adds/updates or removes credentials for applications registered with AWS
  /// Systems Manager for SAP.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

pub struct UpdateApplicationSettingsInput {
  /// The ID of the application.
  pub application_id: Str? = None
  /// The credentials to be added or updated.
  pub credentials_to_add_or_update: List[ApplicationCredential]? = None
  /// The credentials to be removed.
  pub credentials_to_remove: List[ApplicationCredential]? = None
  /// Installation of AWS Backint Agent for SAP HANA.
  pub backint: BackintConfig? = None
  /// The Amazon Resource Name of the SAP HANA database that replaces the
  /// current SAP HANA connection with the SAP_ABAP application.
  pub database_arn: Str? = None
}

pub struct UpdateApplicationSettingsOutput {
  /// The update message.
  pub message: Str? = None
  /// The IDs of the operations.
  pub operation_ids: List[Str]? = None
}

