      "recommendationId" => out.recommendation_id = jsonv.read_str(fv)?
      "taskId" => out.task_id = jsonv.read_str(fv)?
      "goalId" => out.goal_id = jsonv.read_str(fv)?
      "title" => out.title = jsonv.read_str(fv)?
      "content" => out.content = from_json_recommendation_content(fv)?
      "status" => out.status = RecommendationStatus.from(jsonv.read_str(fv)?)
      "priority" => out.priority = RecommendationPriority.from(jsonv.read_str(fv)?)
      "goalVersion" => out.goal_version = jsonv.read_int(fv)?
      "additionalContext" => out.additional_context = jsonv.read_str(fv)?
      "rankPosition" => out.rank_position = jsonv.read_int(fv)?
      "rankedAt" => out.ranked_at = jsonv.read_time(fv, "date-time")?
      "createdAt" => out.created_at = jsonv.read_time(fv, "date-time")?
      "updatedAt" => out.updated_at = jsonv.read_time(fv, "date-time")?
      "version" => out.version = jsonv.read_int(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_recommendation_content(v: RecommendationContent) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.summary {
    fs.push(("summary", json.Value.Str(x)))
  }
  if let Some(x) = v.spec {
    fs.push(("spec", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_recommendation_content(v: json.Value) -> RecommendationContent ! Str {
  var out = RecommendationContent{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "summary" => out.summary = jsonv.read_str(fv)?
      "spec" => out.spec = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_recommendation_list(v: List[Recommendation]) -> json.Value {
  json.Value.List(v.map(fn(x: Recommendation) -> json.Value { json_of_recommendation(x) }))
}

fn from_json_recommendation_list(v: json.Value) -> List[Recommendation] ! Str {
  var out: List[Recommendation] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_recommendation(fv)?)
  }
  Ok(out)
}

fn json_of_recurrence(v: Recurrence) -> json.Value {
  match v {
    Daily(x) => json.Value.Object([("daily", json_of_daily_recurrence(x))])
    Weekly(x) => json.Value.Object([("weekly", json_of_weekly_recurrence(x))])
    Monthly(x) => json.Value.Object([("monthly", json_of_monthly_recurrence(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_recurrence(v: json.Value) -> Recurrence ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "daily" => Ok(Recurrence.Daily(from_json_daily_recurrence(fv)?))
      "weekly" => Ok(Recurrence.Weekly(from_json_weekly_recurrence(fv)?))
      "monthly" => Ok(Recurrence.Monthly(from_json_monthly_recurrence(fv)?))
      _ => Ok(Recurrence.Unknown(k))
    }
  }
  Err("Recurrence: no member set")
}

