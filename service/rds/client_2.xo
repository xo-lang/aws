  }
}

fn query_put_account_quota(var f: query.Form, prefix: Str, v: AccountQuota) {
  if let Some(x) = v.account_quota_name {
    query.add(f, query.key(prefix, "AccountQuotaName"), x)
  }
  if let Some(x) = v.used {
    query.add(f, query.key(prefix, "Used"), "${x}")
  }
  if let Some(x) = v.max {
    query.add(f, query.key(prefix, "Max"), "${x}")
  }
}

fn query_put_account_quota_list(var f: query.Form, prefix: Str, v: List[AccountQuota], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.AccountQuota.${i + 1}" }
    query_put_account_quota(f, k, x)
  }
}

