    match c.describe_step(input) {
      Ok(out) => {
        let o = jmes_of_describe_step_output(out)
        if state == "" && waiter.path_matches(o, "Step.Status.State", "stringEquals", "COMPLETED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Step.Status.State", "stringEquals", "FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "Step.Status.State", "stringEquals", "CANCELLED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("StepComplete: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
