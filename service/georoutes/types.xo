  /// Steering direction for the step.
  pub steering_direction: RouteSteeringDirection? = None
  /// Angle of the turn.
  pub turn_angle: Float? = None
  /// Intensity of the turn.
  pub turn_intensity: RouteTurnIntensity? = None
}

/// Specifies strict exclusion options for the route calculation. This
/// setting mandates that the router will avoid any routes that include the
/// specified options, rather than merely attempting to minimize them.
pub struct RouteExclusionOptions {
  /// List of countries to be avoided defined by two-letter or three-letter
  /// country codes.
  pub countries: List[Str]? = None
}

/// Details related to the exit step.
pub struct RouteExitStepDetails {
  /// Name of the intersection, if applicable to the step.
  pub intersection: List[LocalizedString]? = None
  /// Exit to be taken.
  pub relative_exit: Int? = None
  /// Steering direction for the step.
  pub steering_direction: RouteSteeringDirection? = None
  /// Angle of the turn.
  pub turn_angle: Float? = None
  /// Intensity of the turn.
  pub turn_intensity: RouteTurnIntensity? = None
}

/// Steps of a leg that must be performed after the travel portion of the
/// leg.
pub struct RouteFerryAfterTravelStep {
  /// Duration of the step. Unit : seconds
  pub duration: Int? = None
  /// Brief description of the step in the requested language. Only available
  /// when the TravelStepType is Default.
  pub instruction: Str? = None
  /// Type of the step.
  pub type_value: RouteFerryAfterTravelStepType? = None
}

pub enum RouteFerryAfterTravelStepType: Str {
  Deboard = "Deboard"
  Unknown(value: Str)
}

/// Details corresponding to the arrival for the leg.
pub struct RouteFerryArrival {
  /// Place details corresponding to the arrival.
  pub place: RouteFerryPlace? = None
  /// The arrival time.
  pub time: Str? = None
}

/// Steps of a leg that must be performed before the travel portion of the
/// leg.
pub struct RouteFerryBeforeTravelStep {
  /// Duration of the step. Unit : seconds
  pub duration: Int? = None
  /// Brief description of the step in the requested language. Only available
  /// when the TravelStepType is Default.
  pub instruction: Str? = None
  /// Type of the step.
  pub type_value: RouteFerryBeforeTravelStepType? = None
}

pub enum RouteFerryBeforeTravelStepType: Str {
  Board = "Board"
  Unknown(value: Str)
}

/// Details corresponding to the departure for the leg.
pub struct RouteFerryDeparture {
  /// Place details corresponding to the departure.
  pub place: RouteFerryPlace? = None
  /// The departure time.
  pub time: Str? = None
}

/// FerryLegDetails is populated when the Leg type is Ferry, and provides
/// additional information that is specific to ferry travel.
pub struct RouteFerryLegDetails {
  /// Steps of a leg that must be performed after the travel portion of the
  /// leg.
  pub after_travel_steps: List[RouteFerryAfterTravelStep]? = None
  /// Details corresponding to the arrival for the leg.
  pub arrival: RouteFerryArrival? = None
  /// Steps of a leg that must be performed before the travel portion of the
  /// leg.
  pub before_travel_steps: List[RouteFerryBeforeTravelStep]? = None
  /// Details corresponding to the departure for the leg.
  pub departure: RouteFerryDeparture? = None
  /// Notices are additional information returned that indicate issues that
  /// occurred during route calculation.
  pub notices: List[RouteFerryNotice]? = None
  /// Waypoints that were passed through during the leg. This includes the
  /// waypoints that were configured with the PassThrough option.
  pub pass_through_waypoints: List[RoutePassThroughWaypoint]? = None
  /// Route name of the ferry line.
  pub route_name: Str? = None
  /// Spans that were computed for the requested SpanAdditionalFeatures.
  pub spans: List[RouteFerrySpan]? = None
  /// Summarized details of the leg.
  pub summary: RouteFerrySummary? = None
  /// Steps of a leg that must be performed before the travel portion of the
  /// leg.
  pub travel_steps: List[RouteFerryTravelStep]? = None
}

/// Notices are additional information returned that indicate issues that
/// occurred during route calculation.
pub struct RouteFerryNotice {
  /// Code corresponding to the issue.
  pub code: RouteFerryNoticeCode? = None
  /// Impact corresponding to the issue. While Low impact notices can be
  /// safely ignored, High impact notices must be evaluated further to
  /// determine the impact.
  pub impact: RouteNoticeImpact? = None
}

pub enum RouteFerryNoticeCode: Str {
  AccuratePolylineUnavailable = "AccuratePolylineUnavailable"
  NoSchedule = "NoSchedule"
  Other = "Other"
  ViolatedAvoidFerry = "ViolatedAvoidFerry"
  ViolatedAvoidRailFerry = "ViolatedAvoidRailFerry"
  SeasonalClosure = "SeasonalClosure"
  PotentialViolatedVehicleRestrictionUsage = "PotentialViolatedVehicleRestrictionUsage"
  ViolatedAvoidAreas = "ViolatedAvoidAreas"
  ViolatedVehicleRestriction = "ViolatedVehicleRestriction"
  Unknown(value: Str)
}

/// Summary including duration and distance for the entire leg.
pub struct RouteFerryOverviewSummary {
  /// Distance of the entire leg. Unit : meters
  pub distance: Int? = None
  /// Duration of the entire leg. Unit : seconds
  pub duration: Int? = None
}

/// Position provided in the request.
pub struct RouteFerryPlace {
  /// The name of the place.
  pub name: Str? = None
  /// Position provided in the request.
  pub original_position: List[Float]? = None
  /// Position in World Geodetic System (WGS 84) format: [longitude,
  /// latitude].
  pub position: List[Float]? = None
  /// Index of the waypoint in the request.
  pub waypoint_index: Int? = None
}

/// Span computed for the requested SpanAdditionalFeatures.
pub struct RouteFerrySpan {
  /// 3 letter Country code corresponding to the Span.
  pub country: Str? = None
  /// Distance of the computed span. This feature doesn't split a span, but is
  /// always computed on a span split by other properties. Unit : meters
  pub distance: Int? = None
  /// Duration of the computed span. This feature doesn't split a span, but is
  /// always computed on a span split by other properties. Unit : seconds
  pub duration: Int? = None
  /// Offset in the leg geometry corresponding to the start of this span.
  pub geometry_offset: Int? = None
  /// Names of the ferry span in available languages.
  pub names: List[LocalizedString]? = None
  /// 2-3 letter Region code corresponding to the Span. This is either a
  /// province or a state.
  pub region: Str? = None
}

/// Summarized details for the leg including travel steps only. The Distance
/// for the travel only portion of the journey is the same as the Distance
/// within the Overview summary.
pub struct RouteFerrySummary {
  /// Summarized details for the leg including before travel, travel and after
  /// travel steps.
  pub overview: RouteFerryOverviewSummary? = None
  /// Summarized details for the leg including travel steps only. The Distance
  /// for the travel only portion of the journey is in meters
  pub travel_only: RouteFerryTravelOnlySummary? = None
}

/// Summarized details for the leg including travel steps only. The Distance
/// for the travel only portion of the journey is the same as the Distance
/// within the Overview summary.
pub struct RouteFerryTravelOnlySummary {
  /// Total duration in free flowing traffic, which is the best case or
  /// shortest duration possible to cover the leg. Unit : seconds
  pub duration: Int? = None
}

/// Steps of a leg that must be performed during the travel portion of the
/// leg.
pub struct RouteFerryTravelStep {
  /// Distance of the step.
  pub distance: Int? = None
  /// Duration of the step. Unit : seconds
  pub duration: Int? = None
  /// Offset in the leg geometry corresponding to the start of this step.
  pub geometry_offset: Int? = None
  /// Brief description of the step in the requested language. Only available
  /// when the TravelStepType is Default.
  pub instruction: Str? = None
  /// Type of the step.
  pub type_value: RouteFerryTravelStepType? = None
}

pub enum RouteFerryTravelStepType: Str {
  Depart = "Depart"
  Continue = "Continue"
  Arrive = "Arrive"
  Unknown(value: Str)
}

pub enum RouteHazardousCargoType: Str {
  Combustible = "Combustible"
  Corrosive = "Corrosive"
  Explosive = "Explosive"
  Flammable = "Flammable"
  Gas = "Gas"
  HarmfulToWater = "HarmfulToWater"
  Organic = "Organic"
  Other = "Other"
  Poison = "Poison"
  PoisonousInhalation = "PoisonousInhalation"
  Radioactive = "Radioactive"
  Unknown(value: Str)
}

pub enum RouteIntermodalEnabledLegs: Str {
  FirstLeg = "FirstLeg"
  LastLeg = "LastLeg"
  EntireRoute = "EntireRoute"
  None = "None"
  Unknown(value: Str)
}

/// Options related to intermodal routing. Not supported in ap-southeast-1
/// and ap-southeast-5 regions for GrabMaps customers.
