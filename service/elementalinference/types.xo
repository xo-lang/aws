}

pub struct UpdateFunctionRequest {
  /// The ID of the function.
  pub id: Str? = None
  /// A new name for the function. You can't change the name while the
  /// function is referenced by a feed.
  pub name: Str? = None
  /// A new target for the function. You can't change the target while the
  /// function is referenced by a feed.
  pub target_value: FunctionTarget? = None
  /// A new request expression for the function. Elemental Inference derives
  /// contextTypes again from the new expression. While a feed references the
  /// function, the new expression must reference the same media context as
  /// the current one.
  pub request_expression: Str? = None
  /// A new response expression for the function. To remove the response
  /// expression, specify an empty string. A function with a Bedrock target
  /// and eventBridgeDelivery set to ENABLED must keep a response expression.
  pub response_expression: Str? = None
  /// A new description for the function.
  pub description: Str? = None
  /// Specifies whether Elemental Inference also sends this function's marked
  /// results to Amazon EventBridge, as described for CreateFunction. If you
  /// omit this parameter, the current value is kept. While a feed references
  /// the function, you can change this value to DISABLED, but not to ENABLED.
  pub event_bridge_delivery: EventBridgeDeliveryMode? = None
}

pub struct UpdateFunctionResponse {
  /// The name of the function.
  pub name: Str? = None
  /// The destination for the request that the function builds.
  pub target_value: FunctionTarget? = None
  /// The JSONata expression that builds the request. Elemental Inference
  /// evaluates it against the media object of the feed, which holds the media
  /// and metadata that the function asked for.
  pub request_expression: Str? = None
  /// The JSONata expression that selects what to store. Elemental Inference
  /// evaluates it against the result as its root: the model response for a
  /// Bedrock target, or the output of the request expression for a
  /// passthrough target. If a function has no response expression, Elemental
  /// Inference stores the entire result.
  pub response_expression: Str? = None
  /// The description of the function.
  pub description: Str? = None
  /// Indicates whether Elemental Inference also sends this function's results
  /// to Amazon EventBridge. With ENABLED, each result that is a JSON object
  /// with a top-level eventBridge field set to true is also sent as a
  /// Function Metadata Generated event to the default event bus in your
  /// account.
  pub event_bridge_delivery: EventBridgeDeliveryMode? = None
  /// The ARN of the function.
  pub arn: Str? = None
  /// The ID of the function.
  pub id: Str? = None
  /// The status of the function.
  pub status: FunctionStatus? = None
  /// The IDs of the feeds that have a function output, enabled or disabled,
  /// that references this function. While this list isn't empty, the function
  /// can't be deleted, and its name and target can't be changed.
  pub references: List[Str]? = None
  /// The kinds of media context that this function uses. Elemental Inference
  /// derives this field from the media paths that the request expression
  /// references; you can't set it. An empty list means that the expression
  /// references no media, so Elemental Inference supplies none at run time.
  pub context_types: List[ContextType]? = None
  /// The tags associated with the function.
  pub tags: Map[Str, Str]? = None
}

/// Contains configuration information about one output in a feed. It is
/// used in the UpdateFeed action.
pub struct UpdateOutput {
  /// The name of the output.
  pub name: Str? = None
  /// A typed property for an output in a feed. It identifies the action for
  /// Elemental Inference to perform. It also provides a repository for the
  /// results of that action. For example, CroppingConfig output will contain
  /// the metadata for the crop feature.
  pub output_config: OutputConfig? = None
  /// The status of the output.
  pub status: OutputStatus? = None
  /// A description of the output.
  pub description: Str? = None
  /// Elemental Inference originally sets this parameter to True if this
  /// output was created by AssociateFeed or to False if this output was
  /// created by CreateFeed or UpdateFeed. You must not change this value.
  /// Therefore, use GetFeed to determine the current value. Then in the
  /// UpdateFeed request, if the current value is True, include this parameter
  /// with a value of True. If it's False, omit the parameter.
  pub from_association: Bool? = None
}

/// Enables or disables an output at the action's scheduled time. This is a
/// type of ScheduleActionOperation.
pub struct UpdateOutputStatus {
  /// The name of the output that you want to enable or disable. The output
  /// must exist in the feed when you create the action.
  pub output_name: Str? = None
  /// Specifies whether the output is enabled or disabled after the action
  /// runs.
  pub status: OutputStatus? = None
}

pub struct UpdateQuestionSetRequest {
  /// The ID of the question set to update.
  pub id: Str? = None
  /// An array of questions that Elemental Inference answers with yes or no,
  /// to replace all the yesNo questions in DRAFT. You can specify up to 50
  /// yesNo questions. If not specified, the yesNo questions are not changed.
