  if let Some(x) = v.phase1_integrity_algorithm {
    xmlv.elem(w, "phase1IntegrityAlgorithm", x, [])
  }
  if let Some(x) = v.phase2_integrity_algorithm {
    xmlv.elem(w, "phase2IntegrityAlgorithm", x, [])
  }
  if let Some(x) = v.phase1_dh_group {
    xmlv.elem(w, "phase1DHGroup", "${x}", [])
  }
  if let Some(x) = v.phase2_dh_group {
    xmlv.elem(w, "phase2DHGroup", "${x}", [])
  }
  if let Some(x) = v.ike_version {
    xmlv.elem(w, "ikeVersion", x, [])
  }
  if let Some(x) = v.provisioning_status {
    xmlv.elem(w, "provisioningStatus", x.value(), [])
  }
  if let Some(x) = v.provisioning_status_reason {
    xmlv.elem(w, "provisioningStatusReason", x, [])
  }
  xmlv.end(w, name)
