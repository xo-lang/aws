pub fn (c: Client) update_space(input: UpdateSpaceInput) -> () ! UpdateSpaceErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_space(c.params, input)) ?? e => return Err(UpdateSpaceErr.InvalidInput(e))
  var req = serialize_update_space(ep, input, "") ?? e => return Err(UpdateSpaceErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateSpaceErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_space_error(resp))
  }
  deserialize_update_space(resp) ?? e => Err(UpdateSpaceErr.Deserialize(e))
}
