fn xml_read_upload_part_copy_request(e: xml.Element) -> UploadPartCopyRequest ! Str {
  var out = UploadPartCopyRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Bucket" => out.bucket = c.text()
      "CopySource" => out.copy_source = c.text()
      "CopySourceIfMatch" => out.copy_source_if_match = c.text()
      "CopySourceIfModifiedSince" => out.copy_source_if_modified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "CopySourceIfNoneMatch" => out.copy_source_if_none_match = c.text()
      "CopySourceIfUnmodifiedSince" => out.copy_source_if_unmodified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "CopySourceRange" => out.copy_source_range = c.text()
      "Key" => out.key = c.text()
      "PartNumber" => out.part_number = xmlv.read_int(c.text())?
      "UploadId" => out.upload_id = c.text()
      "SSECustomerAlgorithm" => out.sse_customer_algorithm = c.text()
      "SSECustomerKey" => out.sse_customer_key = c.text()
      "SSECustomerKeyMD5" => out.sse_customer_key_md5 = c.text()
      "CopySourceSSECustomerAlgorithm" => out.copy_source_sse_customer_algorithm = c.text()
      "CopySourceSSECustomerKey" => out.copy_source_sse_customer_key = c.text()
      "CopySourceSSECustomerKeyMD5" => out.copy_source_sse_customer_key_md5 = c.text()
      "RequestPayer" => out.request_payer = RequestPayer.from(c.text())
      "ExpectedBucketOwner" => out.expected_bucket_owner = c.text()
      "ExpectedSourceBucketOwner" => out.expected_source_bucket_owner = c.text()
      _ => {}
    }
  }
  Ok(out)
}

