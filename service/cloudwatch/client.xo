fn query_put_composite_alarm(var f: query.Form, prefix: Str, v: CompositeAlarm) {
  if let Some(x) = v.actions_enabled {
    query.add(f, query.key(prefix, "ActionsEnabled"), "${x}")
  }
  if let Some(x) = v.alarm_actions {
    query_put_resource_list(f, query.key(prefix, "AlarmActions"), x, false)
  }
  if let Some(x) = v.alarm_arn {
    query.add(f, query.key(prefix, "AlarmArn"), x)
  }
  if let Some(x) = v.alarm_configuration_updated_timestamp {
    query.add(f, query.key(prefix, "AlarmConfigurationUpdatedTimestamp"), rest.date_time(x))
  }
  if let Some(x) = v.alarm_description {
    query.add(f, query.key(prefix, "AlarmDescription"), x)
  }
  if let Some(x) = v.alarm_name {
    query.add(f, query.key(prefix, "AlarmName"), x)
  }
  if let Some(x) = v.alarm_rule {
    query.add(f, query.key(prefix, "AlarmRule"), x)
  }
  if let Some(x) = v.insufficient_data_actions {
    query_put_resource_list(f, query.key(prefix, "InsufficientDataActions"), x, false)
  }
  if let Some(x) = v.ok_actions {
    query_put_resource_list(f, query.key(prefix, "OKActions"), x, false)
  }
  if let Some(x) = v.state_reason {
    query.add(f, query.key(prefix, "StateReason"), x)
  }
  if let Some(x) = v.state_reason_data {
    query.add(f, query.key(prefix, "StateReasonData"), x)
  }
  if let Some(x) = v.state_updated_timestamp {
    query.add(f, query.key(prefix, "StateUpdatedTimestamp"), rest.date_time(x))
  }
  if let Some(x) = v.state_value {
    query.add(f, query.key(prefix, "StateValue"), x.value())
  }
  if let Some(x) = v.state_transitioned_timestamp {
    query.add(f, query.key(prefix, "StateTransitionedTimestamp"), rest.date_time(x))
  }
  if let Some(x) = v.actions_suppressed_by {
    query.add(f, query.key(prefix, "ActionsSuppressedBy"), x.value())
  }
  if let Some(x) = v.actions_suppressed_reason {
    query.add(f, query.key(prefix, "ActionsSuppressedReason"), x)
  }
  if let Some(x) = v.actions_suppressor {
    query.add(f, query.key(prefix, "ActionsSuppressor"), x)
  }
  if let Some(x) = v.actions_suppressor_wait_period {
    query.add(f, query.key(prefix, "ActionsSuppressorWaitPeriod"), "${x}")
  }
  if let Some(x) = v.actions_suppressor_extension_period {
    query.add(f, query.key(prefix, "ActionsSuppressorExtensionPeriod"), "${x}")
  }
  if let Some(x) = v.action_configuration {
    query_put_action_configuration(f, query.key(prefix, "ActionConfiguration"), x)
  }
}

