}

pub enum UnsuccessfulFaceDeletionReason: Str {
  AssociatedToAnExistingUser = "ASSOCIATED_TO_AN_EXISTING_USER"
  FaceNotFound = "FACE_NOT_FOUND"
  Unknown(value: Str)
}

/// Contains metadata like FaceId, UserID, and Reasons, for a face that was
