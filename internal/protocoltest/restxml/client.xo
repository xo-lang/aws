fn xml_write_timestamp_format_headers_io(var w: xmlv.Writer, v: TimestampFormatHeadersIO, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.member_epoch_seconds {
    xmlv.elem(w, "memberEpochSeconds", rest.epoch_seconds(x), [])
  }
  if let Some(x) = v.member_http_date {
    xmlv.elem(w, "memberHttpDate", rest.http_date(x), [])
  }
  if let Some(x) = v.member_date_time {
    xmlv.elem(w, "memberDateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.default_format {
    xmlv.elem(w, "defaultFormat", rest.date_time(x), [])
  }
  if let Some(x) = v.target_epoch_seconds {
    xmlv.elem(w, "targetEpochSeconds", rest.epoch_seconds(x), [])
  }
  if let Some(x) = v.target_http_date {
    xmlv.elem(w, "targetHttpDate", rest.http_date(x), [])
  }
  if let Some(x) = v.target_date_time {
    xmlv.elem(w, "targetDateTime", rest.date_time(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_timestamp_format_headers_io(e: xml.Element) -> TimestampFormatHeadersIO ! Str {
  var out = TimestampFormatHeadersIO{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "memberEpochSeconds" => out.member_epoch_seconds = (rest.parse_epoch_seconds(c.text().trim()) ?? return Err("bad timestamp"))
      "memberHttpDate" => out.member_http_date = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      "memberDateTime" => out.member_date_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "defaultFormat" => out.default_format = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "targetEpochSeconds" => out.target_epoch_seconds = (rest.parse_epoch_seconds(c.text().trim()) ?? return Err("bad timestamp"))
      "targetHttpDate" => out.target_http_date = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      "targetDateTime" => out.target_date_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_union_payload(var w: xmlv.Writer, v: UnionPayload, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    Greeting(x) => {
      xmlv.elem(w, "greeting", x, [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_union_payload(e: xml.Element) -> UnionPayload ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "greeting" => Ok(UnionPayload.Greeting(c.text()))
      _ => Ok(UnionPayload.Unknown(c.name.local))
    }
  }
  Err("UnionPayload: no member set")
}

