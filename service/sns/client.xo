fn xml_write_phone_number_information(var w: xmlv.Writer, v: PhoneNumberInformation, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.created_at {
    xmlv.elem(w, "CreatedAt", rest.date_time(x), [])
  }
  if let Some(x) = v.phone_number {
    xmlv.elem(w, "PhoneNumber", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.iso2_country_code {
    xmlv.elem(w, "Iso2CountryCode", x, [])
  }
  if let Some(x) = v.route_type {
    xmlv.elem(w, "RouteType", x.value(), [])
  }
  if let Some(x) = v.number_capabilities {
    xml_write_number_capability_list(w, x, "NumberCapabilities", [])
  }
  xmlv.end(w, name)
}

fn xml_read_phone_number_information(e: xml.Element) -> PhoneNumberInformation ! Str {
  var out = PhoneNumberInformation{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "CreatedAt" => out.created_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PhoneNumber" => out.phone_number = c.text()
      "Status" => out.status = c.text()
      "Iso2CountryCode" => out.iso2_country_code = c.text()
      "RouteType" => out.route_type = RouteType.from(c.text())
      "NumberCapabilities" => out.number_capabilities = xml_read_number_capability_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

