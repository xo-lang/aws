fn json_of_evaluation(v: Evaluation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.compliance_resource_type {
    fs.push(("ComplianceResourceType", json.Value.Str(x)))
  }
  if let Some(x) = v.compliance_resource_id {
    fs.push(("ComplianceResourceId", json.Value.Str(x)))
  }
  if let Some(x) = v.compliance_type {
    fs.push(("ComplianceType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.annotation {
    fs.push(("Annotation", json.Value.Str(x)))
  }
  if let Some(x) = v.ordering_timestamp {
    fs.push(("OrderingTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

