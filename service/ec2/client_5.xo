fn xml_write_launch_template_version(var w: xmlv.Writer, v: LaunchTemplateVersion, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.launch_template_id {
    xmlv.elem(w, "launchTemplateId", x, [])
  }
  if let Some(x) = v.launch_template_name {
    xmlv.elem(w, "launchTemplateName", x, [])
  }
  if let Some(x) = v.version_number {
    xmlv.elem(w, "versionNumber", "${x}", [])
  }
  if let Some(x) = v.version_description {
    xmlv.elem(w, "versionDescription", x, [])
  }
  if let Some(x) = v.create_time {
    xmlv.elem(w, "createTime", rest.date_time(x), [])
  }
  if let Some(x) = v.created_by {
    xmlv.elem(w, "createdBy", x, [])
  }
  if let Some(x) = v.default_version {
    xmlv.elem(w, "defaultVersion", "${x}", [])
  }
  if let Some(x) = v.launch_template_data {
    xml_write_response_launch_template_data(w, x, "launchTemplateData", [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_response(w, x, "operator", [])
  }
  xmlv.end(w, name)
}

