pub fn serialize_accept_administrator_invitation(ep: rest.Endpoint, input: AcceptAdministratorInvitationRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_detector_id = match input.detector_id {
    Some(v) => v
    None => return Err("input member DetectorId is required")
  }
  if label_detector_id == "" {
    return Err("input member DetectorId must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.administrator_id {
    fs.push(("administratorId", json.Value.Str(x)))
