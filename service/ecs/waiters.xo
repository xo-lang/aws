}

/// Calls DescribeServices until the ServicesStable acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (15s) to `max_delay` (600s).
pub fn wait_until_services_stable(c: Client, input: DescribeServicesRequest, max_wait: Duration, min_delay: Duration = 15s, max_delay: Duration = 600s) -> () ! waiter.WaitErr[DescribeServicesErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_services(input) {
      Ok(out) => {
        let o = jmes_of_describe_services_response(out)
        if state == "" && waiter.path_matches(o, "failures[].reason", "anyStringEquals", "MISSING") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "services[].status", "anyStringEquals", "DRAINING") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "services[].status", "anyStringEquals", "INACTIVE") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "length(services[?!(length(deployments) == `1` && runningCount == desiredCount)]) == `0`", "booleanEquals", "true") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ServicesStable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeTasks until the TasksRunning acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
