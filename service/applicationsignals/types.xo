  /// This parameter is used only when a request-based SLO tracks the Latency
  /// metric. Specify the threshold value that the observed Latency metric
  /// values are to be compared to. This is not required if
  /// CreateRecommendedSlo is set to true .
  pub metric_threshold: Float? = None
  /// The arithmetic operation to use when comparing the specified metric to
  /// the threshold. This is not required if CreateRecommendedSlo is set to
  /// true .
  pub comparison_operator: ServiceLevelIndicatorComparisonOperator? = None
}

/// This structure contains the information about the metric that is used
