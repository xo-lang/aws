      "recurrence" => out.recurrence = xml_read_scheduled_instance_recurrence(c)?
      "slotDurationInHours" => out.slot_duration_in_hours = xmlv.read_int(c.text())?
      "totalScheduledInstanceHours" => out.total_scheduled_instance_hours = xmlv.read_int(c.text())?
      _ => {}
