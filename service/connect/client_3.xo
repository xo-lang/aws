      "Tags" => out.tags = from_json_tag_map(fv)?
      "NumberOfAssociatedQueues" => out.number_of_associated_queues = jsonv.read_int(fv)?
      "NumberOfAssociatedManualAssignmentQueues" => out.number_of_associated_manual_assignment_queues = jsonv.read_int(fv)?
      "NumberOfAssociatedUsers" => out.number_of_associated_users = jsonv.read_int(fv)?
      "AgentAvailabilityTimer" => out.agent_availability_timer = AgentAvailabilityTimer.from(jsonv.read_str(fv)?)
      "LastModifiedTime" => out.last_modified_time = jsonv.read_time(fv, "epoch-seconds")?
      "LastModifiedRegion" => out.last_modified_region = jsonv.read_str(fv)?
      "IsDefault" => out.is_default = jsonv.read_bool(fv)?
      "AssociatedQueueIds" => out.associated_queue_ids = from_json_associated_queue_id_list(fv)?
      "AssociatedManualAssignmentQueueIds" => out.associated_manual_assignment_queue_ids = from_json_associated_queue_id_list(fv)?
