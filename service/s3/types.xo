  /// create the required resources. Make sure that you have
  /// s3tables:CreateTableBucket , s3tables:CreateNamespace ,
  /// s3tables:CreateTable , s3tables:GetTable , s3tables:PutTablePolicy ,
  /// kms:DescribeKey , and s3tables:PutTableEncryption permissions.
