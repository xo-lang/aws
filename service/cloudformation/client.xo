fn xml_write_get_template_summary_output(var w: xmlv.Writer, v: GetTemplateSummaryOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.parameters {
    xml_write_parameter_declarations(w, x, "Parameters", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.capabilities {
    xml_write_capabilities(w, x, "Capabilities", [])
  }
  if let Some(x) = v.capabilities_reason {
    xmlv.elem(w, "CapabilitiesReason", x, [])
  }
  if let Some(x) = v.resource_types {
    xml_write_resource_types(w, x, "ResourceTypes", [])
  }
  if let Some(x) = v.version {
    xmlv.elem(w, "Version", x, [])
  }
  if let Some(x) = v.metadata {
    xmlv.elem(w, "Metadata", x, [])
  }
  if let Some(x) = v.declared_transforms {
    xml_write_transforms_list(w, x, "DeclaredTransforms", [])
  }
  if let Some(x) = v.resource_identifier_summaries {
    xml_write_resource_identifier_summaries(w, x, "ResourceIdentifierSummaries", [])
  }
  if let Some(x) = v.warnings {
