fn json_of_windows_file_system_configuration(v: WindowsFileSystemConfiguration) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.active_directory_id {
    fs.push(("ActiveDirectoryId", json.Value.Str(x)))
  }
  if let Some(x) = v.self_managed_active_directory_configuration {
    fs.push(("SelfManagedActiveDirectoryConfiguration", json_of_self_managed_active_directory_attributes(x)))
  }
  if let Some(x) = v.deployment_type {
    fs.push(("DeploymentType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.remote_administration_endpoint {
    fs.push(("RemoteAdministrationEndpoint", json.Value.Str(x)))
  }
  if let Some(x) = v.preferred_subnet_id {
    fs.push(("PreferredSubnetId", json.Value.Str(x)))
  }
  if let Some(x) = v.preferred_file_server_ip {
    fs.push(("PreferredFileServerIp", json.Value.Str(x)))
  }
  if let Some(x) = v.throughput_capacity {
    fs.push(("ThroughputCapacity", json.Value.Int(x)))
  }
  if let Some(x) = v.maintenance_operations_in_progress {
    fs.push(("MaintenanceOperationsInProgress", json_of_file_system_maintenance_operations(x)))
  }
  if let Some(x) = v.weekly_maintenance_start_time {
    fs.push(("WeeklyMaintenanceStartTime", json.Value.Str(x)))
  }
  if let Some(x) = v.daily_automatic_backup_start_time {
    fs.push(("DailyAutomaticBackupStartTime", json.Value.Str(x)))
  }
  if let Some(x) = v.automatic_backup_retention_days {
    fs.push(("AutomaticBackupRetentionDays", json.Value.Int(x)))
  }
  if let Some(x) = v.copy_tags_to_backups {
    fs.push(("CopyTagsToBackups", json.Value.Bool(x)))
  }
  if let Some(x) = v.aliases {
    fs.push(("Aliases", json_of_aliases(x)))
  }
  if let Some(x) = v.audit_log_configuration {
    fs.push(("AuditLogConfiguration", json_of_windows_audit_log_configuration(x)))
  }
  if let Some(x) = v.disk_iops_configuration {
    fs.push(("DiskIopsConfiguration", json_of_disk_iops_configuration(x)))
  }
  if let Some(x) = v.preferred_file_server_ipv6 {
    fs.push(("PreferredFileServerIpv6", json.Value.Str(x)))
  }
  if let Some(x) = v.fsrm_configuration {
    fs.push(("FsrmConfiguration", json_of_windows_fsrm_configuration(x)))
  }
  json.Value.Object(fs)
