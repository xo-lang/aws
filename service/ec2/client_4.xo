      "hibernationOptions" => out.hibernation_options = xml_read_hibernation_options(c)?
      "licenseSet" => out.licenses = xml_read_license_list(c)?
      "metadataOptions" => out.metadata_options = xml_read_instance_metadata_options_response(c)?
