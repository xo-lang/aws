fn xml_write_modify_db_cluster_message(var w: xmlv.Writer, v: ModifyDBClusterMessage, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.db_cluster_identifier {
    xmlv.elem(w, "DBClusterIdentifier", x, [])
  }
  if let Some(x) = v.new_db_cluster_identifier {
    xmlv.elem(w, "NewDBClusterIdentifier", x, [])
  }
  if let Some(x) = v.apply_immediately {
    xmlv.elem(w, "ApplyImmediately", "${x}", [])
  }
  if let Some(x) = v.backup_retention_period {
    xmlv.elem(w, "BackupRetentionPeriod", "${x}", [])
  }
  if let Some(x) = v.db_cluster_parameter_group_name {
    xmlv.elem(w, "DBClusterParameterGroupName", x, [])
  }
  if let Some(x) = v.vpc_security_group_ids {
    xml_write_vpc_security_group_id_list(w, x, "VpcSecurityGroupIds", [])
  }
  if let Some(x) = v.port {
    xmlv.elem(w, "Port", "${x}", [])
  }
  if let Some(x) = v.master_user_password {
    xmlv.elem(w, "MasterUserPassword", x, [])
  }
  if let Some(x) = v.option_group_name {
    xmlv.elem(w, "OptionGroupName", x, [])
  }
  if let Some(x) = v.preferred_backup_window {
    xmlv.elem(w, "PreferredBackupWindow", x, [])
  }
  if let Some(x) = v.preferred_maintenance_window {
    xmlv.elem(w, "PreferredMaintenanceWindow", x, [])
  }
  if let Some(x) = v.enable_iam_database_authentication {
    xmlv.elem(w, "EnableIAMDatabaseAuthentication", "${x}", [])
  }
  if let Some(x) = v.cloudwatch_logs_export_configuration {
    xml_write_cloudwatch_logs_export_configuration(w, x, "CloudwatchLogsExportConfiguration", [])
  }
  if let Some(x) = v.engine_version {
    xmlv.elem(w, "EngineVersion", x, [])
  }
  if let Some(x) = v.allow_major_version_upgrade {
    xmlv.elem(w, "AllowMajorVersionUpgrade", "${x}", [])
  }
  if let Some(x) = v.db_instance_parameter_group_name {
    xmlv.elem(w, "DBInstanceParameterGroupName", x, [])
  }
  if let Some(x) = v.deletion_protection {
    xmlv.elem(w, "DeletionProtection", "${x}", [])
  }
  if let Some(x) = v.copy_tags_to_snapshot {
    xmlv.elem(w, "CopyTagsToSnapshot", "${x}", [])
  }
  if let Some(x) = v.serverless_v2_scaling_configuration {
    xml_write_serverless_v2_scaling_configuration(w, x, "ServerlessV2ScalingConfiguration", [])
  }
  if let Some(x) = v.storage_type {
    xmlv.elem(w, "StorageType", x, [])
  }
  if let Some(x) = v.network_type {
    xmlv.elem(w, "NetworkType", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_modify_db_cluster_message(e: xml.Element) -> ModifyDBClusterMessage ! Str {
  var out = ModifyDBClusterMessage{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DBClusterIdentifier" => out.db_cluster_identifier = c.text()
      "NewDBClusterIdentifier" => out.new_db_cluster_identifier = c.text()
      "ApplyImmediately" => out.apply_immediately = xmlv.read_bool(c.text())?
      "BackupRetentionPeriod" => out.backup_retention_period = xmlv.read_int(c.text())?
      "DBClusterParameterGroupName" => out.db_cluster_parameter_group_name = c.text()
      "VpcSecurityGroupIds" => out.vpc_security_group_ids = xml_read_vpc_security_group_id_list(c)?
      "Port" => out.port = xmlv.read_int(c.text())?
      "MasterUserPassword" => out.master_user_password = c.text()
      "OptionGroupName" => out.option_group_name = c.text()
      "PreferredBackupWindow" => out.preferred_backup_window = c.text()
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "EnableIAMDatabaseAuthentication" => out.enable_iam_database_authentication = xmlv.read_bool(c.text())?
      "CloudwatchLogsExportConfiguration" => out.cloudwatch_logs_export_configuration = xml_read_cloudwatch_logs_export_configuration(c)?
      "EngineVersion" => out.engine_version = c.text()
      "AllowMajorVersionUpgrade" => out.allow_major_version_upgrade = xmlv.read_bool(c.text())?
      "DBInstanceParameterGroupName" => out.db_instance_parameter_group_name = c.text()
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "CopyTagsToSnapshot" => out.copy_tags_to_snapshot = xmlv.read_bool(c.text())?
      "ServerlessV2ScalingConfiguration" => out.serverless_v2_scaling_configuration = xml_read_serverless_v2_scaling_configuration(c)?
      "StorageType" => out.storage_type = c.text()
      "NetworkType" => out.network_type = c.text()
      _ => {}
    }
  }
  Ok(out)
}

