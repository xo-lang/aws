  var out = WebsiteConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ErrorDocument" => out.error_document = xml_read_error_document(c)?
      "IndexDocument" => out.index_document = xml_read_index_document(c)?
      "RedirectAllRequestsTo" => out.redirect_all_requests_to = xml_read_redirect_all_requests_to(c)?
      "RoutingRules" => out.routing_rules = xml_read_routing_rules(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_write_get_object_response_request(var w: xmlv.Writer, v: WriteGetObjectResponseRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.request_route {
    xmlv.elem(w, "RequestRoute", x, [])
  }
  if let Some(x) = v.request_token {
    xmlv.elem(w, "RequestToken", x, [])
  }
  if let Some(x) = v.body {
    xmlv.elem(w, "Body", x.to_base64(), [])
  }
  if let Some(x) = v.status_code {
    xmlv.elem(w, "StatusCode", "${x}", [])
  }
  if let Some(x) = v.error_code {
    xmlv.elem(w, "ErrorCode", x, [])
  }
  if let Some(x) = v.error_message {
    xmlv.elem(w, "ErrorMessage", x, [])
  }
  if let Some(x) = v.accept_ranges {
    xmlv.elem(w, "AcceptRanges", x, [])
  }
  if let Some(x) = v.cache_control {
    xmlv.elem(w, "CacheControl", x, [])
  }
  if let Some(x) = v.content_disposition {
    xmlv.elem(w, "ContentDisposition", x, [])
  }
  if let Some(x) = v.content_encoding {
    xmlv.elem(w, "ContentEncoding", x, [])
  }
  if let Some(x) = v.content_language {
    xmlv.elem(w, "ContentLanguage", x, [])
  }
  if let Some(x) = v.content_length {
    xmlv.elem(w, "ContentLength", "${x}", [])
  }
  if let Some(x) = v.content_range {
    xmlv.elem(w, "ContentRange", x, [])
  }
  if let Some(x) = v.content_type {
    xmlv.elem(w, "ContentType", x, [])
  }
  if let Some(x) = v.checksum_crc32 {
    xmlv.elem(w, "ChecksumCRC32", x, [])
  }
  if let Some(x) = v.checksum_crc32_c {
    xmlv.elem(w, "ChecksumCRC32C", x, [])
  }
  if let Some(x) = v.checksum_crc64_nvme {
    xmlv.elem(w, "ChecksumCRC64NVME", x, [])
  }
  if let Some(x) = v.checksum_sha1 {
    xmlv.elem(w, "ChecksumSHA1", x, [])
  }
  if let Some(x) = v.checksum_sha256 {
    xmlv.elem(w, "ChecksumSHA256", x, [])
  }
  if let Some(x) = v.checksum_sha512 {
    xmlv.elem(w, "ChecksumSHA512", x, [])
  }
  if let Some(x) = v.checksum_md5 {
    xmlv.elem(w, "ChecksumMD5", x, [])
  }
  if let Some(x) = v.checksum_xxhash64 {
    xmlv.elem(w, "ChecksumXXHASH64", x, [])
  }
  if let Some(x) = v.checksum_xxhash3 {
    xmlv.elem(w, "ChecksumXXHASH3", x, [])
  }
  if let Some(x) = v.checksum_xxhash128 {
    xmlv.elem(w, "ChecksumXXHASH128", x, [])
  }
  if let Some(x) = v.delete_marker {
    xmlv.elem(w, "DeleteMarker", "${x}", [])
  }
  if let Some(x) = v.e_tag {
    xmlv.elem(w, "ETag", x, [])
  }
  if let Some(x) = v.expires {
    xmlv.elem(w, "Expires", x, [])
  }
  if let Some(x) = v.expiration {
    xmlv.elem(w, "Expiration", x, [])
  }
  if let Some(x) = v.last_modified {
    xmlv.elem(w, "LastModified", rest.date_time(x), [])
  }
  if let Some(x) = v.missing_meta {
    xmlv.elem(w, "MissingMeta", "${x}", [])
  }
  if let Some(x) = v.metadata {
    xml_write_metadata(w, x, "Metadata", [])
  }
  if let Some(x) = v.object_lock_mode {
    xmlv.elem(w, "ObjectLockMode", x.value(), [])
  }
  if let Some(x) = v.object_lock_legal_hold_status {
    xmlv.elem(w, "ObjectLockLegalHoldStatus", x.value(), [])
  }
  if let Some(x) = v.object_lock_retain_until_date {
    xmlv.elem(w, "ObjectLockRetainUntilDate", rest.date_time(x), [])
  }
  if let Some(x) = v.parts_count {
    xmlv.elem(w, "PartsCount", "${x}", [])
  }
  if let Some(x) = v.replication_status {
    xmlv.elem(w, "ReplicationStatus", x.value(), [])
  }
  if let Some(x) = v.request_charged {
    xmlv.elem(w, "RequestCharged", x.value(), [])
  }
  if let Some(x) = v.restore {
    xmlv.elem(w, "Restore", x, [])
  }
  if let Some(x) = v.server_side_encryption {
    xmlv.elem(w, "ServerSideEncryption", x.value(), [])
  }
  if let Some(x) = v.sse_customer_algorithm {
    xmlv.elem(w, "SSECustomerAlgorithm", x, [])
  }
  if let Some(x) = v.sse_kms_key_id {
    xmlv.elem(w, "SSEKMSKeyId", x, [])
  }
  if let Some(x) = v.sse_customer_key_md5 {
    xmlv.elem(w, "SSECustomerKeyMD5", x, [])
  }
  if let Some(x) = v.storage_class {
    xmlv.elem(w, "StorageClass", x.value(), [])
  }
  if let Some(x) = v.tag_count {
    xmlv.elem(w, "TagCount", "${x}", [])
  }
  if let Some(x) = v.version_id {
    xmlv.elem(w, "VersionId", x, [])
  }
  if let Some(x) = v.bucket_key_enabled {
    xmlv.elem(w, "BucketKeyEnabled", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_write_get_object_response_request(e: xml.Element) -> WriteGetObjectResponseRequest ! Str {
  var out = WriteGetObjectResponseRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "RequestRoute" => out.request_route = c.text()
      "RequestToken" => out.request_token = c.text()
      "Body" => out.body = xmlv.read_blob(c.text())?
      "StatusCode" => out.status_code = xmlv.read_int(c.text())?
      "ErrorCode" => out.error_code = c.text()
      "ErrorMessage" => out.error_message = c.text()
      "AcceptRanges" => out.accept_ranges = c.text()
      "CacheControl" => out.cache_control = c.text()
      "ContentDisposition" => out.content_disposition = c.text()
      "ContentEncoding" => out.content_encoding = c.text()
      "ContentLanguage" => out.content_language = c.text()
      "ContentLength" => out.content_length = xmlv.read_int(c.text())?
      "ContentRange" => out.content_range = c.text()
      "ContentType" => out.content_type = c.text()
      "ChecksumCRC32" => out.checksum_crc32 = c.text()
      "ChecksumCRC32C" => out.checksum_crc32_c = c.text()
      "ChecksumCRC64NVME" => out.checksum_crc64_nvme = c.text()
      "ChecksumSHA1" => out.checksum_sha1 = c.text()
      "ChecksumSHA256" => out.checksum_sha256 = c.text()
      "ChecksumSHA512" => out.checksum_sha512 = c.text()
      "ChecksumMD5" => out.checksum_md5 = c.text()
      "ChecksumXXHASH64" => out.checksum_xxhash64 = c.text()
      "ChecksumXXHASH3" => out.checksum_xxhash3 = c.text()
      "ChecksumXXHASH128" => out.checksum_xxhash128 = c.text()
      "DeleteMarker" => out.delete_marker = xmlv.read_bool(c.text())?
      "ETag" => out.e_tag = c.text()
      "Expires" => out.expires = c.text()
      "Expiration" => out.expiration = c.text()
      "LastModified" => out.last_modified = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MissingMeta" => out.missing_meta = xmlv.read_int(c.text())?
      "Metadata" => out.metadata = xml_read_metadata(c)?
      "ObjectLockMode" => out.object_lock_mode = ObjectLockMode.from(c.text())
      "ObjectLockLegalHoldStatus" => out.object_lock_legal_hold_status = ObjectLockLegalHoldStatus.from(c.text())
      "ObjectLockRetainUntilDate" => out.object_lock_retain_until_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PartsCount" => out.parts_count = xmlv.read_int(c.text())?
      "ReplicationStatus" => out.replication_status = ReplicationStatus.from(c.text())
      "RequestCharged" => out.request_charged = RequestCharged.from(c.text())
      "Restore" => out.restore = c.text()
      "ServerSideEncryption" => out.server_side_encryption = ServerSideEncryption.from(c.text())
      "SSECustomerAlgorithm" => out.sse_customer_algorithm = c.text()
      "SSEKMSKeyId" => out.sse_kms_key_id = c.text()
      "SSECustomerKeyMD5" => out.sse_customer_key_md5 = c.text()
      "StorageClass" => out.storage_class = StorageClass.from(c.text())
      "TagCount" => out.tag_count = xmlv.read_int(c.text())?
      "VersionId" => out.version_id = c.text()
      "BucketKeyEnabled" => out.bucket_key_enabled = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

