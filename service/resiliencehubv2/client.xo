fn json_of_service_event_metadata(v: ServiceEventMetadata) -> json.Value {
  match v {
    ServiceCreated(x) => json.Value.Object([("serviceCreated", json_of_service_created_metadata(x))])
    ServiceDeleted(x) => json.Value.Object([("serviceDeleted", json_of_service_deleted_metadata(x))])
    ServiceSystemAssociated(x) => json.Value.Object([("serviceSystemAssociated", json_of_service_system_associated_metadata(x))])
    ServiceSystemDisassociated(x) => json.Value.Object([("serviceSystemDisassociated", json_of_service_system_disassociated_metadata(x))])
    ServiceResourcesAssociated(x) => json.Value.Object([("serviceResourcesAssociated", json_of_service_resources_associated_metadata(x))])
    ServiceResourcesDisassociated(x) => json.Value.Object([("serviceResourcesDisassociated", json_of_service_resources_disassociated_metadata(x))])
    ServiceWorkflowUpdated(x) => json.Value.Object([("serviceWorkflowUpdated", json_of_service_workflow_updated_metadata(x))])
    ServiceInputSourcesUpdated(x) => json.Value.Object([("serviceInputSourcesUpdated", json_of_service_input_sources_updated_metadata(x))])
    ServicePolicyAssociated(x) => json.Value.Object([("servicePolicyAssociated", json_of_service_policy_associated_metadata(x))])
    ServicePolicyDisassociated(x) => json.Value.Object([("servicePolicyDisassociated", json_of_service_policy_disassociated_metadata(x))])
    ServiceFunctionCreated(x) => json.Value.Object([("serviceFunctionCreated", json_of_service_function_created_metadata(x))])
    ServiceFunctionUpdated(x) => json.Value.Object([("serviceFunctionUpdated", json_of_service_function_updated_metadata(x))])
    ServiceFunctionDeleted(x) => json.Value.Object([("serviceFunctionDeleted", json_of_service_function_deleted_metadata(x))])
    ServiceFunctionResourcesAdded(x) => json.Value.Object([("serviceFunctionResourcesAdded", json_of_service_function_resources_added_metadata(x))])
    ServiceFunctionResourcesRemoved(x) => json.Value.Object([("serviceFunctionResourcesRemoved", json_of_service_function_resources_removed_metadata(x))])
    ServiceAchievabilityUpdated(x) => json.Value.Object([("serviceAchievabilityUpdated", json_of_service_achievability_updated_metadata(x))])
    AssertionCreated(x) => json.Value.Object([("assertionCreated", json_of_assertion_created_metadata(x))])
    AssertionUpdated(x) => json.Value.Object([("assertionUpdated", json_of_assertion_updated_metadata(x))])
    AssertionDeleted(x) => json.Value.Object([("assertionDeleted", json_of_assertion_deleted_metadata(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_service_event_metadata(v: json.Value) -> ServiceEventMetadata ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "serviceCreated" => Ok(ServiceEventMetadata.ServiceCreated(from_json_service_created_metadata(fv)?))
      "serviceDeleted" => Ok(ServiceEventMetadata.ServiceDeleted(from_json_service_deleted_metadata(fv)?))
      "serviceSystemAssociated" => Ok(ServiceEventMetadata.ServiceSystemAssociated(from_json_service_system_associated_metadata(fv)?))
      "serviceSystemDisassociated" => Ok(ServiceEventMetadata.ServiceSystemDisassociated(from_json_service_system_disassociated_metadata(fv)?))
      "serviceResourcesAssociated" => Ok(ServiceEventMetadata.ServiceResourcesAssociated(from_json_service_resources_associated_metadata(fv)?))
      "serviceResourcesDisassociated" => Ok(ServiceEventMetadata.ServiceResourcesDisassociated(from_json_service_resources_disassociated_metadata(fv)?))
      "serviceWorkflowUpdated" => Ok(ServiceEventMetadata.ServiceWorkflowUpdated(from_json_service_workflow_updated_metadata(fv)?))
      "serviceInputSourcesUpdated" => Ok(ServiceEventMetadata.ServiceInputSourcesUpdated(from_json_service_input_sources_updated_metadata(fv)?))
      "servicePolicyAssociated" => Ok(ServiceEventMetadata.ServicePolicyAssociated(from_json_service_policy_associated_metadata(fv)?))
      "servicePolicyDisassociated" => Ok(ServiceEventMetadata.ServicePolicyDisassociated(from_json_service_policy_disassociated_metadata(fv)?))
      "serviceFunctionCreated" => Ok(ServiceEventMetadata.ServiceFunctionCreated(from_json_service_function_created_metadata(fv)?))
      "serviceFunctionUpdated" => Ok(ServiceEventMetadata.ServiceFunctionUpdated(from_json_service_function_updated_metadata(fv)?))
      "serviceFunctionDeleted" => Ok(ServiceEventMetadata.ServiceFunctionDeleted(from_json_service_function_deleted_metadata(fv)?))
      "serviceFunctionResourcesAdded" => Ok(ServiceEventMetadata.ServiceFunctionResourcesAdded(from_json_service_function_resources_added_metadata(fv)?))
      "serviceFunctionResourcesRemoved" => Ok(ServiceEventMetadata.ServiceFunctionResourcesRemoved(from_json_service_function_resources_removed_metadata(fv)?))
      "serviceAchievabilityUpdated" => Ok(ServiceEventMetadata.ServiceAchievabilityUpdated(from_json_service_achievability_updated_metadata(fv)?))
      "assertionCreated" => Ok(ServiceEventMetadata.AssertionCreated(from_json_assertion_created_metadata(fv)?))
      "assertionUpdated" => Ok(ServiceEventMetadata.AssertionUpdated(from_json_assertion_updated_metadata(fv)?))
      "assertionDeleted" => Ok(ServiceEventMetadata.AssertionDeleted(from_json_assertion_deleted_metadata(fv)?))
      _ => Ok(ServiceEventMetadata.Unknown(k))
    }
  }
  Err("ServiceEventMetadata: no member set")
}

