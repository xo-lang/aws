/// Gets the trust store.
pub fn (c: Client) get_trust_store(input: GetTrustStoreRequest) -> GetTrustStoreResponse ! GetTrustStoreErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_get_trust_store(c.params, input)) ?? e => return Err(GetTrustStoreErr.InvalidInput(e))
  var req = serialize_get_trust_store(ep, input, "") ?? e => return Err(GetTrustStoreErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(GetTrustStoreErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_get_trust_store_error(resp))
  }
  deserialize_get_trust_store(resp) ?? e => Err(GetTrustStoreErr.Deserialize(e))
}

