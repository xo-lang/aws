fn xml_read_db_cluster(e: xml.Element) -> DBCluster ! Str {
  var out = DBCluster{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "AllocatedStorage" => out.allocated_storage = xmlv.read_int(c.text())?
      "AvailabilityZones" => out.availability_zones = xml_read_availability_zones(c)?
      "BackupRetentionPeriod" => out.backup_retention_period = xmlv.read_int(c.text())?
      "CharacterSetName" => out.character_set_name = c.text()
      "DatabaseName" => out.database_name = c.text()
      "DBClusterIdentifier" => out.db_cluster_identifier = c.text()
      "DBClusterParameterGroup" => out.db_cluster_parameter_group = c.text()
      "DBSubnetGroup" => out.db_subnet_group = c.text()
      "Status" => out.status = c.text()
      "PercentProgress" => out.percent_progress = c.text()
      "EarliestRestorableTime" => out.earliest_restorable_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Endpoint" => out.endpoint = c.text()
      "ReaderEndpoint" => out.reader_endpoint = c.text()
      "MultiAZ" => out.multi_az = xmlv.read_bool(c.text())?
      "Engine" => out.engine = c.text()
      "EngineVersion" => out.engine_version = c.text()
      "LatestRestorableTime" => out.latest_restorable_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Port" => out.port = xmlv.read_int(c.text())?
      "MasterUsername" => out.master_username = c.text()
      "DBClusterOptionGroupMemberships" => out.db_cluster_option_group_memberships = xml_read_db_cluster_option_group_memberships(c)?
      "PreferredBackupWindow" => out.preferred_backup_window = c.text()
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "ReplicationSourceIdentifier" => out.replication_source_identifier = c.text()
      "ReadReplicaIdentifiers" => out.read_replica_identifiers = xml_read_read_replica_identifier_list(c)?
      "DBClusterMembers" => out.db_cluster_members = xml_read_db_cluster_member_list(c)?
      "VpcSecurityGroups" => out.vpc_security_groups = xml_read_vpc_security_group_membership_list(c)?
      "HostedZoneId" => out.hosted_zone_id = c.text()
      "StorageEncrypted" => out.storage_encrypted = xmlv.read_bool(c.text())?
      "KmsKeyId" => out.kms_key_id = c.text()
      "DbClusterResourceId" => out.db_cluster_resource_id = c.text()
      "DBClusterArn" => out.db_cluster_arn = c.text()
      "AssociatedRoles" => out.associated_roles = xml_read_db_cluster_roles(c)?
      "IAMDatabaseAuthenticationEnabled" => out.iam_database_authentication_enabled = xmlv.read_bool(c.text())?
      "CloneGroupId" => out.clone_group_id = c.text()
      "ClusterCreateTime" => out.cluster_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "CopyTagsToSnapshot" => out.copy_tags_to_snapshot = xmlv.read_bool(c.text())?
      "EnabledCloudwatchLogsExports" => out.enabled_cloudwatch_logs_exports = xml_read_log_type_list(c)?
      "PendingModifiedValues" => out.pending_modified_values = xml_read_cluster_pending_modified_values(c)?
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "CrossAccountClone" => out.cross_account_clone = xmlv.read_bool(c.text())?
      "AutomaticRestartTime" => out.automatic_restart_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ServerlessV2ScalingConfiguration" => out.serverless_v2_scaling_configuration = xml_read_serverless_v2_scaling_configuration_info(c)?
      "GlobalClusterIdentifier" => out.global_cluster_identifier = c.text()
      "IOOptimizedNextAllowedModificationTime" => out.io_optimized_next_allowed_modification_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "StorageType" => out.storage_type = c.text()
      "NetworkType" => out.network_type = c.text()
      _ => {}
    }
  }
  Ok(out)
}

