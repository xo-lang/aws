// credential_process credentials (decision 0003), as aws-sdk-go-v2's
// credentials/processcreds: a profile's command runs through the shell
// (`sh -c`, or `cmd.exe /C` on Windows) and prints JSON with Version 1,
// AccessKeyId, SecretAccessKey and, optionally, SessionToken, Expiration
// and AccountId.
//
// A provider's `retrieve` cannot run a program (it has no `proc`
// effect), so the command runs on a background task started by
// `config.run_credential_processes(cfg, os.tasks, os.proc, os.clock)`:
// once at once, and again 5 minutes before the credentials expire.
// `retrieve` waits for the first run and returns its credentials, or
// says how to start the task when it has not been started. The type
// lives in the root, which runs no programs (decision 0011); the
// credentials module runs the command (`credentials.run_process`).

use std/json

struct ProcessState {
  creds: Credentials? = None
  err: Str = ""
}

/// A profile's credential_process; copies share their state.
pub struct CredentialProcess {
  pub profile: Str
  pub command: Str
  /// Run through `cmd.exe /C` instead of `sh -c`.
  pub windows: Bool = false
  pub timeout: Duration = 1m
  state: Mutex[ProcessState]
  started: Atomic[Bool]
  /// Closed when the first run has finished.
  ready: Chan[()]
}

pub fn credential_process(profile: Str, command: Str, windows: Bool = false) -> CredentialProcess {
  CredentialProcess{
    profile: profile,
    command: command,
    windows: windows,
    state: Mutex.new(ProcessState{}),
    started: Atomic.new(false),
    ready: Chan[()].new(),
  }
}

pub fn (c: CredentialProcess) retrieve() -> Credentials ! CredentialsErr uses (net.dial, clock, rand) {
  if !c.started.get() {
    return Err(CredentialsErr.Fetch("profile ${c.profile} uses credential_process, which runs on a task: call config.run_credential_processes(cfg, os.tasks, os.proc, os.clock) after config.load_default_config"))
  }
  // the first run's result; a closed channel returns at once
  let _ = c.ready.recv()
  let s = c.state.with_read(fn(s: ProcessState) -> ProcessState { s })
  match s.creds {
    Some(cr) => Ok(cr)
    None => Err(CredentialsErr.Fetch("profile ${c.profile} credential_process: ${s.err}"))
  }
}

/// Marks the command's task started; false when it already was.
pub fn (c: CredentialProcess) start() -> Bool {
  !c.started.swap(true)
}

/// Keeps `creds` from a run of the command.
pub fn (c: CredentialProcess) succeeded(creds: Credentials) {
  c.state.reset(ProcessState{creds: Some(creds)})
}

/// Records a failed run; the last good credentials are kept.
pub fn (c: CredentialProcess) failed(msg: Str) -> () ! Str {
  c.state.with(fn(var s: ProcessState) { s.err = msg })
  Err(msg)
}

/// Lets `retrieve` return: the first run has finished.
pub fn (c: CredentialProcess) first_run_done() {
  c.ready.close()
}

/// When the kept credentials expire, if there are any and they do.
pub fn (c: CredentialProcess) expires() -> Time? {
  c.state.with_read(fn(s: ProcessState) -> Time? { s.creds.and_then(fn(cr: Credentials) -> Time? { cr.expires }) })
}

/// The command's JSON as credentials (aws-sdk-go-v2's checks).
pub fn parse_process_output(stdout: Bytes) -> Credentials ! Str {
  let text = stdout.to_str() ?? return Err("the output is not UTF-8")
  let doc = json.parse_value(text) ?? e => return Err("the output is not JSON: ${e.display()}")
  let field = fn(k: Str) -> Str {
    match doc.get(k) {
      Some(json.Value.Str(s)) => s
      _ => ""
    }
  }
  let version = match doc.get("Version") {
    Some(json.Value.Int(n)) => n
    Some(json.Value.Num(f)) => Int(f)
    _ => 0
  }
  if version != 1 {
    return Err("Version must be 1, the output has ${version}")
  }
  if field("AccessKeyId") == "" {
    return Err("the output has no AccessKeyId")
  }
  if field("SecretAccessKey") == "" {
    return Err("the output has no SecretAccessKey")
  }
  let expires = if field("Expiration") == "" { None } else {
    Some(Time.parse_rfc3339(field("Expiration")) ?? return Err("Expiration ${field("Expiration")} is not RFC 3339"))
  }
  Ok(Credentials{
    access_key_id: field("AccessKeyId"),
    secret_access_key: Secret.new(field("SecretAccessKey")),
    session_token: if field("SessionToken") == "" { None } else { Some(Secret.new(field("SessionToken"))) },
    expires: expires,
    source: "ProcessProvider",
    features: ["w"],
    account_id: if field("AccountId") == "" { None } else { Some(field("AccountId")) },
  })
}
