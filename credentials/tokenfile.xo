// Reading and watching an `aws.TokenFile` (decision 0011: the root keeps
// the type, this module reaches the file).

use github.com/xo-lang/aws

/// Reads `path` now (surrounding white space dropped).
pub fn load_token_file(fs: Fs, path: Str) -> aws.TokenFile ! Str uses fs.read {
  Ok(aws.token_file(path, read_token(fs, path)?))
}

/// The token file at `path`, empty when it cannot be read now (an SSO
/// cache before `aws sso login`); the watch reads it again later.
pub fn token_file_or_empty(fs: Fs, path: Str) -> aws.TokenFile uses fs.read {
  load_token_file(fs, path) ?? _ => aws.token_file(path, Secret.new(""))
}

/// Writes the token to the file when `set` changed it, keeping the
/// file's permission bits (`write_atomic`).
pub fn flush(t: aws.TokenFile, fs: Fs) -> () ! Str uses fs {
  if t.path == "" || !t.take_dirty() {
    return Ok(())
  }
  write_atomic(fs, t.path, t.get().reveal().bytes()) ?? e => {
    t.mark_dirty()
    return Err("${t.path}: ${e.display()}")
  }
  Ok(())
}

/// Reads the file again; on an error the last token is kept and the
/// error returned.
pub fn reload(t: aws.TokenFile, fs: Fs) -> () ! Str uses fs.read {
  t.loaded(read_token(fs, t.path)?)
  Ok(())
}

/// Every `every` until cancelled: writes the file if `set` changed the
/// token, else reads it again. Run it as a background task:
/// `os.tasks.spawn_background(fn() { credentials.watch(t, os.fs,
/// os.clock) })`. A failed read keeps the last token (the file is being
/// replaced, or is briefly missing) and is tried again next time.
pub fn watch(t: aws.TokenFile, fs: Fs, clock: Clock, every: Duration = 5m) uses (fs, clock) {
  if t.path == "" {
    return
  }
  while true {
    clock.sleep(every)
    if t.is_dirty() {
      let _ = flush(t, fs).ignore_err("still dirty; the next pass writes it again")
    } else {
      let _ = reload(t, fs).ignore_err("the last token is kept; the next pass reads the file again")
    }
  }
}

fn read_token(fs: Fs, path: Str) -> Secret[Str] ! Str uses fs.read {
  match fs.read_text(path) {
    Ok(s) => {
      let t = s.trim()
      if t == "" {
        return Err("${path} is empty")
      }
      Ok(Secret.new(t))
    }
    Err(e) => Err("${path}: ${e.display()}")
  }
}
