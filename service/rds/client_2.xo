      "Domain" => out.domain = c.text()
      "DomainIAMRoleName" => out.domain_iam_role_name = c.text()
      "DBClusterInstanceClass" => out.db_cluster_instance_class = c.text()
      "StorageType" => out.storage_type = c.text()
