  }
  if let Some(x) = v.rendering_rules {
    fs.push(("RenderingRules", json_of_sheet_element_rendering_rule_list(x)))
  }
  if let Some(x) = v.border_style {
    fs.push(("BorderStyle", json_of_free_form_layout_element_border_style(x)))
  }
  if let Some(x) = v.selected_border_style {
    fs.push(("SelectedBorderStyle", json_of_free_form_layout_element_border_style(x)))
  }
  if let Some(x) = v.background_style {
    fs.push(("BackgroundStyle", json_of_free_form_layout_element_background_style(x)))
  }
  if let Some(x) = v.loading_animation {
    fs.push(("LoadingAnimation", json_of_loading_animation(x)))
  }
  if let Some(x) = v.border_radius {
    fs.push(("BorderRadius", json.Value.Str(x)))
  }
  if let Some(x) = v.padding {
    fs.push(("Padding", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_free_form_layout_element(v: json.Value) -> FreeFormLayoutElement ! Str {
  var out = FreeFormLayoutElement{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ElementId" => out.element_id = jsonv.read_str(fv)?
      "ElementType" => out.element_type = LayoutElementType.from(jsonv.read_str(fv)?)
      "XAxisLocation" => out.x_axis_location = jsonv.read_str(fv)?
      "YAxisLocation" => out.y_axis_location = jsonv.read_str(fv)?
      "Width" => out.width = jsonv.read_str(fv)?
      "Height" => out.height = jsonv.read_str(fv)?
      "Visibility" => out.visibility = Visibility.from(jsonv.read_str(fv)?)
