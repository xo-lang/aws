fn query_put_get_group_response(var f: query.Form, prefix: Str, v: GetGroupResponse) {
  if let Some(x) = v.group {
    query_put_group(f, query.key(prefix, "Group"), x)
  }
  if let Some(x) = v.users {
    query_put_user_list_type(f, query.key(prefix, "Users"), x, false)
