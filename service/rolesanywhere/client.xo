  }
  if let Some(x) = input.session_policy {
    fs.push(("sessionPolicy", json.Value.Str(x)))
  }
  if let Some(x) = input.role_arns {
    fs.push(("roleArns", json_of_role_arn_list(x)))
  }
  if let Some(x) = input.managed_policy_arns {
    fs.push(("managedPolicyArns", json_of_managed_policy_list(x)))
  }
  if let Some(x) = input.duration_seconds {
    fs.push(("durationSeconds", json.Value.Int(x)))
  }
  if let Some(x) = input.enabled {
    fs.push(("enabled", json.Value.Bool(x)))
  }
  if let Some(x) = input.tags {
    fs.push(("tags", json_of_tag_list(x)))
  }
  if let Some(x) = input.accept_role_session_name {
    fs.push(("acceptRoleSessionName", json.Value.Bool(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/profiles"),
    query: rest.query(qs),
    headers: headers,
    body: body,
