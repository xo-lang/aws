fn xml_read_db_cluster(e: xml.Element) -> DBCluster ! Str {
  var out = DBCluster{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "AllocatedStorage" => out.allocated_storage = xmlv.read_int(c.text())?
      "AvailabilityZones" => out.availability_zones = xml_read_availability_zones(c)?
      "BackupRetentionPeriod" => out.backup_retention_period = xmlv.read_int(c.text())?
      "CharacterSetName" => out.character_set_name = c.text()
      "DatabaseName" => out.database_name = c.text()
      "DBClusterIdentifier" => out.db_cluster_identifier = c.text()
      "DBClusterParameterGroup" => out.db_cluster_parameter_group = c.text()
      "DBSubnetGroup" => out.db_subnet_group = c.text()
      "Status" => out.status = c.text()
      "PercentProgress" => out.percent_progress = c.text()
      "EarliestRestorableTime" => out.earliest_restorable_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Endpoint" => out.endpoint = c.text()
      "ReaderEndpoint" => out.reader_endpoint = c.text()
      "CustomEndpoints" => out.custom_endpoints = xml_read_string_list(c)?
      "MultiAZ" => out.multi_az = xmlv.read_bool(c.text())?
      "Engine" => out.engine = c.text()
      "EngineVersion" => out.engine_version = c.text()
      "LatestRestorableTime" => out.latest_restorable_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Port" => out.port = xmlv.read_int(c.text())?
      "MasterUsername" => out.master_username = c.text()
      "DBClusterOptionGroupMemberships" => out.db_cluster_option_group_memberships = xml_read_db_cluster_option_group_memberships(c)?
      "PreferredBackupWindow" => out.preferred_backup_window = c.text()
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "UpgradeRolloutOrder" => out.upgrade_rollout_order = UpgradeRolloutOrder.from(c.text())
      "ReplicationSourceIdentifier" => out.replication_source_identifier = c.text()
      "ReadReplicaIdentifiers" => out.read_replica_identifiers = xml_read_read_replica_identifier_list(c)?
      "StatusInfos" => out.status_infos = xml_read_db_cluster_status_info_list(c)?
      "DBClusterMembers" => out.db_cluster_members = xml_read_db_cluster_member_list(c)?
      "VpcSecurityGroups" => out.vpc_security_groups = xml_read_vpc_security_group_membership_list(c)?
      "HostedZoneId" => out.hosted_zone_id = c.text()
      "StorageEncrypted" => out.storage_encrypted = xmlv.read_bool(c.text())?
      "StorageEncryptionType" => out.storage_encryption_type = StorageEncryptionType.from(c.text())
      "KmsKeyId" => out.kms_key_id = c.text()
      "DbClusterResourceId" => out.db_cluster_resource_id = c.text()
      "DBClusterArn" => out.db_cluster_arn = c.text()
      "AssociatedRoles" => out.associated_roles = xml_read_db_cluster_roles(c)?
      "IAMDatabaseAuthenticationEnabled" => out.iam_database_authentication_enabled = xmlv.read_bool(c.text())?
      "CloneGroupId" => out.clone_group_id = c.text()
      "ClusterCreateTime" => out.cluster_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EarliestBacktrackTime" => out.earliest_backtrack_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "BacktrackWindow" => out.backtrack_window = xmlv.read_int(c.text())?
      "BacktrackConsumedChangeRecords" => out.backtrack_consumed_change_records = xmlv.read_int(c.text())?
      "EnabledCloudwatchLogsExports" => out.enabled_cloudwatch_logs_exports = xml_read_log_type_list(c)?
      "Capacity" => out.capacity = xmlv.read_int(c.text())?
      "PendingModifiedValues" => out.pending_modified_values = xml_read_cluster_pending_modified_values(c)?
      "EngineMode" => out.engine_mode = c.text()
      "ScalingConfigurationInfo" => out.scaling_configuration_info = xml_read_scaling_configuration_info(c)?
      "RdsCustomClusterConfiguration" => out.rds_custom_cluster_configuration = xml_read_rds_custom_cluster_configuration(c)?
      "DBClusterInstanceClass" => out.db_cluster_instance_class = c.text()
      "StorageType" => out.storage_type = c.text()
      "Iops" => out.iops = xmlv.read_int(c.text())?
      "StorageThroughput" => out.storage_throughput = xmlv.read_int(c.text())?
      "IOOptimizedNextAllowedModificationTime" => out.io_optimized_next_allowed_modification_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PubliclyAccessible" => out.publicly_accessible = xmlv.read_bool(c.text())?
      "AutoMinorVersionUpgrade" => out.auto_minor_version_upgrade = xmlv.read_bool(c.text())?
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "HttpEndpointEnabled" => out.http_endpoint_enabled = xmlv.read_bool(c.text())?
      "ActivityStreamMode" => out.activity_stream_mode = ActivityStreamMode.from(c.text())
      "ActivityStreamStatus" => out.activity_stream_status = ActivityStreamStatus.from(c.text())
      "ActivityStreamKmsKeyId" => out.activity_stream_kms_key_id = c.text()
      "ActivityStreamKinesisStreamName" => out.activity_stream_kinesis_stream_name = c.text()
      "CopyTagsToSnapshot" => out.copy_tags_to_snapshot = xmlv.read_bool(c.text())?
      "CrossAccountClone" => out.cross_account_clone = xmlv.read_bool(c.text())?
      "DomainMemberships" => out.domain_memberships = xml_read_domain_membership_list(c)?
      "TagList" => out.tag_list = xml_read_tag_list(c)?
      "GlobalClusterIdentifier" => out.global_cluster_identifier = c.text()
      "GlobalWriteForwardingStatus" => out.global_write_forwarding_status = WriteForwardingStatus.from(c.text())
      "GlobalWriteForwardingRequested" => out.global_write_forwarding_requested = xmlv.read_bool(c.text())?
      "NetworkType" => out.network_type = c.text()
      "AutomaticRestartTime" => out.automatic_restart_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ServerlessV2ScalingConfiguration" => out.serverless_v2_scaling_configuration = xml_read_serverless_v2_scaling_configuration_info(c)?
      "ServerlessV2PlatformVersion" => out.serverless_v2_platform_version = c.text()
      "MonitoringInterval" => out.monitoring_interval = xmlv.read_int(c.text())?
      "MonitoringRoleArn" => out.monitoring_role_arn = c.text()
      "DatabaseInsightsMode" => out.database_insights_mode = DatabaseInsightsMode.from(c.text())
      "PerformanceInsightsEnabled" => out.performance_insights_enabled = xmlv.read_bool(c.text())?
      "PerformanceInsightsKMSKeyId" => out.performance_insights_kms_key_id = c.text()
      "PerformanceInsightsRetentionPeriod" => out.performance_insights_retention_period = xmlv.read_int(c.text())?
      "DBSystemId" => out.db_system_id = c.text()
      "MasterUserSecret" => out.master_user_secret = xml_read_master_user_secret(c)?
      "LocalWriteForwardingStatus" => out.local_write_forwarding_status = LocalWriteForwardingStatus.from(c.text())
      "AwsBackupRecoveryPointArn" => out.aws_backup_recovery_point_arn = c.text()
      "LimitlessDatabase" => out.limitless_database = xml_read_limitless_database(c)?
      "ClusterScalabilityType" => out.cluster_scalability_type = ClusterScalabilityType.from(c.text())
      "CertificateDetails" => out.certificate_details = xml_read_certificate_details(c)?
      "EngineLifecycleSupport" => out.engine_lifecycle_support = c.text()
      "VPCNetworkingEnabled" => out.vpc_networking_enabled = xmlv.read_bool(c.text())?
      "InternetAccessGatewayEnabled" => out.internet_access_gateway_enabled = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_db_cluster_already_exists_fault(var w: xmlv.Writer, v: DBClusterAlreadyExistsFault, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.message {
    xmlv.elem(w, "message", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_db_cluster_already_exists_fault(e: xml.Element) -> DBClusterAlreadyExistsFault ! Str {
  var out = DBClusterAlreadyExistsFault{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "message" => out.message = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_db_cluster_associated_role(var w: xmlv.Writer, v: DBClusterAssociatedRole, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.role_arn {
    xmlv.elem(w, "RoleArn", x, [])
  }
