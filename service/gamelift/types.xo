/// Set of rules for processing a deployment for a container fleet update.
pub struct DeploymentConfiguration {
  /// Determines how fleet deployment activity affects active game sessions on
  /// the fleet. With protection, a deployment honors game session protection,
  /// and delays actions that would interrupt a protected active game session
  /// until the game session ends. Without protection, deployment activity can
  /// shut down all running tasks, including active game sessions, regardless
  /// of game session protection.
  pub protection_strategy: DeploymentProtectionStrategy? = None
  /// Sets a minimum level of healthy tasks to maintain during deployment
  /// activity.
  pub minimum_healthy_percentage: Int? = None
  /// Determines what actions to take if a deployment fails. If the fleet is
  /// multi-location, this strategy applies across all fleet locations. With a
  /// rollback strategy, updated fleet instances are rolled back to the last
  /// successful deployment. Alternatively, you can maintain a few impaired
  /// containers for the purpose of debugging, while all other tasks return to
  /// the last successful deployment.
  pub impairment_strategy: DeploymentImpairmentStrategy? = None
}

/// Information about the most recent deployment for the container fleet.
pub struct DeploymentDetails {
  /// A unique identifier for a fleet deployment.
  pub latest_deployment_id: Str? = None
}

pub enum DeploymentImpairmentStrategy: Str {
  Maintain = "MAINTAIN"
  Rollback = "ROLLBACK"
  Unknown(value: Str)
}

pub enum DeploymentProtectionStrategy: Str {
  WithProtection = "WITH_PROTECTION"
  IgnoreProtection = "IGNORE_PROTECTION"
  Unknown(value: Str)
}

pub enum DeploymentStatus: Str {
  InProgress = "IN_PROGRESS"
  Impaired = "IMPAIRED"
  Complete = "COMPLETE"
  RollbackInProgress = "ROLLBACK_IN_PROGRESS"
  RollbackComplete = "ROLLBACK_COMPLETE"
  Cancelled = "CANCELLED"
  Pending = "PENDING"
  Unknown(value: Str)
}

