      "PerformanceInsightsRetentionPeriod" => out.performance_insights_retention_period = xmlv.read_int(c.text())?
      "EnableCloudwatchLogsExports" => out.enable_cloudwatch_logs_exports = xml_read_log_type_list(c)?
      "ProcessorFeatures" => out.processor_features = xml_read_processor_feature_list(c)?
      "UseDefaultProcessorFeatures" => out.use_default_processor_features = xmlv.read_bool(c.text())?
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "MaxAllocatedStorage" => out.max_allocated_storage = xmlv.read_int(c.text())?
      "NetworkType" => out.network_type = c.text()
