fn json_of_content_block(v: ContentBlock) -> json.Value {
  match v {
    Text(x) => json.Value.Object([("text", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_content_block(v: json.Value) -> ContentBlock ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "text" => Ok(ContentBlock.Text(jsonv.read_str(fv)?))
      _ => Ok(ContentBlock.Unknown(k))
    }
  }
  Err("ContentBlock: no member set")
}

