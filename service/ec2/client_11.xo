  }
  if let Some(x) = v.instance_count {
    query.add(f, query.key(prefix, "InstanceCount"), "${x}")
  }
  if let Some(x) = v.instance_type {
    query.add(f, query.key(prefix, "InstanceType"), x)
  }
  if let Some(x) = v.network_platform {
    query.add(f, query.key(prefix, "NetworkPlatform"), x)
  }
  if let Some(x) = v.next_slot_start_time {
    query.add(f, query.key(prefix, "NextSlotStartTime"), rest.date_time(x))
  }
  if let Some(x) = v.platform {
    query.add(f, query.key(prefix, "Platform"), x)
  }
  if let Some(x) = v.previous_slot_end_time {
    query.add(f, query.key(prefix, "PreviousSlotEndTime"), rest.date_time(x))
  }
  if let Some(x) = v.recurrence {
    query_put_scheduled_instance_recurrence(f, query.key(prefix, "Recurrence"), x)
  }
  if let Some(x) = v.scheduled_instance_id {
    query.add(f, query.key(prefix, "ScheduledInstanceId"), x)
  }
  if let Some(x) = v.slot_duration_in_hours {
    query.add(f, query.key(prefix, "SlotDurationInHours"), "${x}")
  }
  if let Some(x) = v.term_end_date {
    query.add(f, query.key(prefix, "TermEndDate"), rest.date_time(x))
  }
  if let Some(x) = v.term_start_date {
    query.add(f, query.key(prefix, "TermStartDate"), rest.date_time(x))
  }
  if let Some(x) = v.total_scheduled_instance_hours {
    query.add(f, query.key(prefix, "TotalScheduledInstanceHours"), "${x}")
  }
}

