fn json_of_expression(v: Expression) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.and {
    fs.push(("and", json_of_expression_list(x)))
  }
  if let Some(x) = v.or {
    fs.push(("or", json_of_expression_list(x)))
  }
  if let Some(x) = v.not {
    fs.push(("not", json_of_expression(x)))
  }
  if let Some(x) = v.cost_categories {
    fs.push(("costCategories", json_of_expression_filter(x)))
  }
  if let Some(x) = v.dimensions {
    fs.push(("dimensions", json_of_expression_filter(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_expression_filter(x)))
  }
  json.Value.Object(fs)
}

fn from_json_expression(v: json.Value) -> Expression ! Str {
  var out = Expression{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "and" => out.and = from_json_expression_list(fv)?
      "or" => out.or = from_json_expression_list(fv)?
      "not" => out.not = from_json_expression(fv)?
      "costCategories" => out.cost_categories = from_json_expression_filter(fv)?
      "dimensions" => out.dimensions = from_json_expression_filter(fv)?
      "tags" => out.tags = from_json_expression_filter(fv)?
      _ => {}
    }
  }
  Ok(out)
}

