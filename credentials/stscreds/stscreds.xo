// A small hand-written STS client (GetCallerIdentity, AssumeRole) and
// the assume role credentials provider (decision 0003). The core uses it
// instead of the generated STS module, so it never imports a service.

use std/http
use std/xml
use github.com/xo-lang/aws
use github.com/xo-lang/aws/protocol/query
use github.com/xo-lang/aws/retry
use github.com/xo-lang/aws/transport

const VERSION: Str = "2011-06-15"

/// Where STS is: its regional endpoint, or a base endpoint (emulators).
pub struct Endpoint {
  pub scheme: Str = "https"
  pub host: Str
  pub port: Int? = None
}

/// The regional endpoint `sts.<region>.amazonaws.com` (the SDKs' default
/// since 2022), or the parts of a base endpoint URL such as
/// `http://localhost:4566`.
pub fn endpoint(region: Str, base: Str? = None) -> Endpoint {
  match base {
    Some(u) => {
      let (scheme, rest) = u.cut("://") ?? ("https", u)
      let hostport = (rest.cut("/") ?? (rest, "")).0
      match hostport.cut(":") {
        Some((h, p)) => Endpoint{scheme: scheme, host: h, port: Int.parse(p)}
        None => Endpoint{scheme: scheme, host: hostport}
      }
    }
    None => Endpoint{host: "sts.${region}.amazonaws.com"}
  }
}

pub struct Client {
  pub transport: transport.Client
  pub region: Str
  pub endpoint: Endpoint
}

pub enum StsErr {
  Send(e: transport.SendErr)
  Read(e: query.ReadErr)
  Missing(field: Str)
}

pub fn (e: StsErr) display() -> Str {
  match e {
    Send(se) => se.display()
    Read(re) => re.display()
    Missing(f) => "STS response has no ${f}"
  }
}

fn call(c: Client, f: query.Form, action: Str) -> xml.Element ! StsErr uses (net.dial, clock, rand) {
  let req = transport.Request{
    method: "POST",
    scheme: c.endpoint.scheme,
    host: c.endpoint.host,
    port: c.endpoint.port,
    path: "/",
    headers: [("Content-Type", query.CONTENT_TYPE)],
    body: query.encode(f).bytes(),
  }
  let resp = match transport.send(c.transport, req, transport.Signing{service: "sts", region: c.region}, classify) {
    Ok(r) => r
    Err(e) => return Err(StsErr.Send(e))
  }
  match query.read_result(resp, action) {
    Ok(r) => Ok(r)
    Err(e) => Err(StsErr.Read(e))
  }
}

pub struct CallerIdentity {
  pub account: Str
  pub arn: Str
  pub user_id: Str
}

pub fn get_caller_identity(c: Client) -> CallerIdentity ! StsErr uses (net.dial, clock, rand) {
  let r = call(c, query.form("GetCallerIdentity", VERSION), "GetCallerIdentity")?
  Ok(CallerIdentity{account: query.child_text(r, "Account"), arn: query.child_text(r, "Arn"), user_id: query.child_text(r, "UserId")})
}

pub struct AssumeRoleInput {
  pub role_arn: Str
  pub role_session_name: Str
  pub duration_seconds: Int? = None
  pub external_id: Str? = None
  pub policy: Str? = None
}

/// AssumeRole's temporary credentials.
pub fn assume_role(c: Client, input: AssumeRoleInput) -> aws.Credentials ! StsErr uses (net.dial, clock, rand) {
  var f = query.form("AssumeRole", VERSION)
  query.add(f, "RoleArn", input.role_arn)
  query.add(f, "RoleSessionName", input.role_session_name)
  if let Some(d) = input.duration_seconds {
    query.add(f, "DurationSeconds", "${d}")
  }
  if let Some(x) = input.external_id {
    query.add(f, "ExternalId", x)
  }
  if let Some(p) = input.policy {
    query.add(f, "Policy", p)
  }
  let r = call(c, f, "AssumeRole")?
  let creds = r.child("Credentials") ?? return Err(StsErr.Missing("Credentials"))
  let exp_text = query.child_text(creds, "Expiration")
  let expires = Time.parse_rfc3339(exp_text) ?? return Err(StsErr.Missing("Credentials.Expiration"))
  let id = query.child_text(creds, "AccessKeyId")
  if id == "" {
    return Err(StsErr.Missing("Credentials.AccessKeyId"))
  }
  Ok(aws.Credentials{
    access_key_id: id,
    secret_access_key: Secret.new(query.child_text(creds, "SecretAccessKey")),
    session_token: Secret.new(query.child_text(creds, "SessionToken")),
    expires: expires,
    source: "AssumeRoleProvider",
  })
}

/// Credentials from assuming `role_arn` with the source credentials the
/// client's transport signs with. Wrap it in `credentials.cache`.
pub struct AssumeRoleProvider {
  pub client: Client
  pub input: AssumeRoleInput
}

fn (p: AssumeRoleProvider) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  var input = p.input
  if input.role_session_name == "" {
    // aws-sdk-go-v2 names a session after the time when none is set
    input.role_session_name = "xo-lang-aws-${p.client.transport.clock.now().unix_millis()}"
  }
  match assume_role(p.client, input) {
    Ok(c) => Ok(c)
    Err(e) => Err(aws.CredentialsErr.Fetch("assume role ${p.input.role_arn}: ${e.display()}"))
  }
}

// A local function, not `query.classify` passed directly: native builds
// cannot yet use another module's function as a value
// (docs/reports/xo-issues.md entry 3).
fn classify(resp: http.Response) -> retry.Failure {
  query.classify(resp)
}
