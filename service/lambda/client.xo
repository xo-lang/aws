      "State" => out.state = State.from(jsonv.read_str(fv)?)
      "StateReason" => out.state_reason = jsonv.read_str(fv)?
      "StateReasonCode" => out.state_reason_code = StateReasonCode.from(jsonv.read_str(fv)?)
