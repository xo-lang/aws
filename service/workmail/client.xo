fn json_of_user_id_list(v: List[Str]) -> json.Value {
  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

fn from_json_user_id_list(v: json.Value) -> List[Str] ! Str {
  var out: List[Str] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(jsonv.read_str(fv)?)
  }
  Ok(out)
}

fn json_of_users(v: List[User]) -> json.Value {
  json.Value.List(v.map(fn(x: User) -> json.Value { json_of_user(x) }))
}

fn from_json_users(v: json.Value) -> List[User] ! Str {
  var out: List[User] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_user(fv)?)
  }
  Ok(out)
}

fn read_error_directory_in_use_exception(resp: http.Response, body: json.Value) -> DirectoryInUseException ! Str {
  let _ = (resp, body)
  var out = DirectoryInUseException{}
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Message" => out.message = jsonv.read_str(fv)?
      _ => {}
    }
  }
