// The provider chain and the caching wrapper (decision 0003).

use github.com/xo-lang/aws

/// Credentials read once when the provider was made (the environment,
/// a profile's static keys): retrieve answers that result.
pub struct FixedResult {
  pub result: Result[aws.Credentials, aws.CredentialsErr]
}

fn (p: FixedResult) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  p.result
}

/// The environment's keys as a provider (read now).
pub fn env_provider(env: Env) -> FixedResult uses env {
  FixedResult{result: from_env(env)}
}

/// Tries each provider in order: NotFound moves on, any other error
/// stops the chain (a profile that is wrong must not fall through to
/// instance credentials, as in aws-sdk-go-v2).
pub struct Chain {
  pub providers: List[aws.CredentialsProvider]
}

fn (c: Chain) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  var missing: List[Str] = []
  for p in c.providers {
    match p.retrieve() {
      Ok(creds) => return Ok(creds)
      Err(aws.CredentialsErr.NotFound(msg)) => missing.push(msg)
      Err(e) => return Err(e)
    }
  }
  Err(aws.CredentialsErr.NotFound("no provider in the chain had credentials: ${missing.join("; ")}"))
}

/// Keeps the last credentials until they are within `window` of
/// expiring, then fetches again. One task fetches while the others wait
/// for its result (aws-sdk-go-v2's CredentialsCache).
pub struct Cache {
  pub inner: aws.CredentialsProvider
  pub clock: Clock
  pub window: Duration = 5m
  state: Mutex[aws.Credentials?]
}

pub fn cache(inner: aws.CredentialsProvider, clock: Clock, window: Duration = 5m) -> Cache {
  Cache{inner: inner, clock: clock, window: window, state: Mutex.new(None)}
}

fn (c: Cache) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  c.state.with(fn(var cur: aws.Credentials?) -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
    if let Some(have) = cur {
      if !aws.expires_within(have, c.clock.now(), c.window) {
        return Ok(have)
      }
    }
    let fresh = c.inner.retrieve()?
    cur = Some(fresh)
    Ok(fresh)
  })
}

/// Forgets the cached credentials, so the next retrieve fetches.
pub fn invalidate(c: Cache) {
  c.state.reset(None)
}
