/// The configuration for in-session inline redaction.
pub struct InlineRedactionConfiguration {
  /// The inline redaction patterns to be enabled for the inline redaction
  /// configuration.
  pub inline_redaction_patterns: List[InlineRedactionPattern]? = None
  /// The global enforced URL configuration for the inline redaction
  /// configuration. This is applied to patterns that do not have a
  /// pattern-level enforced URL list.
  pub global_enforced_urls: List[Str]? = None
  /// The global exempt URL configuration for the inline redaction
  /// configuration. This is applied to patterns that do not have a
  /// pattern-level exempt URL list.
  pub global_exempt_urls: List[Str]? = None
  /// The global confidence level for the inline redaction configuration. This
  /// indicates the certainty of data type matches in the redaction process.
  /// Confidence level 3 means high confidence, and requires a formatted text
  /// pattern match in order for content to be redacted. Confidence level 2
  /// means medium confidence, and redaction considers both formatted and
  /// unformatted text, and adds keyword associate to the logic. Confidence
  /// level 1 means low confidence, and redaction is enforced for both
  /// formatted pattern + unformatted pattern without keyword. This is applied
  /// to patterns that do not have a pattern-level confidence level. Defaults
  /// to confidence level 2.
  pub global_confidence_level: Int? = None
}

/// The set of patterns that determine the data types redacted in session.
pub struct InlineRedactionPattern {
  /// The built-in pattern from the list of preconfigured patterns. Either a
  /// customPattern or builtInPatternId is required.
  pub built_in_pattern_id: Str? = None
  /// &gt;The configuration for a custom pattern. Either a customPattern or
  /// builtInPatternId is required.
  pub custom_pattern: CustomPattern? = None
  /// The redaction placeholder that will replace the redacted text in session
  /// for the inline redaction pattern.
  pub redaction_place_holder: RedactionPlaceHolder? = None
  /// The enforced URL configuration for the inline redaction pattern. This
  /// will override the global enforced URL configuration.
  pub enforced_urls: List[Str]? = None
  /// The exempt URL configuration for the inline redaction pattern. This will
  /// override the global exempt URL configuration for the inline redaction
  /// pattern.
  pub exempt_urls: List[Str]? = None
  /// The confidence level for inline redaction pattern. This indicates the
  /// certainty of data type matches in the redaction process. Confidence
  /// level 3 means high confidence, and requires a formatted text pattern
  /// match in order for content to be redacted. Confidence level 2 means
  /// medium confidence, and redaction considers both formatted and
  /// unformatted text, and adds keyword associate to the logic. Confidence
  /// level 1 means low confidence, and redaction is enforced for both
  /// formatted pattern + unformatted pattern without keyword. This overrides
  /// the global confidence level.
  pub confidence_level: Int? = None
}

