  }
  if let Some(x) = v.foo_enum3 {
    xmlv.elem(w, "fooEnum3", x.value(), [])
  }
  if let Some(x) = v.foo_enum_list {
    xml_write_foo_enum_list(w, x, "fooEnumList", [])
  }
  if let Some(x) = v.foo_enum_set {
    xml_write_foo_enum_set(w, x, "fooEnumSet", [])
  }
  if let Some(x) = v.foo_enum_map {
    xml_write_foo_enum_map(w, x, "fooEnumMap", [])
