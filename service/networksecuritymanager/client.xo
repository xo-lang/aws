  UpdateTemplateErr.Api(restjson.api_error(resp, body))
}

/// Updates the specified template. To prevent conflicting concurrent
/// updates, provide the current updateToken . Use isPublished to publish
/// the update or keep the template as a draft.
pub fn (c: Client) update_template(input: UpdateTemplateInput) -> UpdateTemplateOutput ! UpdateTemplateErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_template(c.params, input)) ?? e => return Err(UpdateTemplateErr.InvalidInput(e))
  var req = serialize_update_template(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateTemplateErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateTemplateErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_template_error(resp))
  }
  deserialize_update_template(resp) ?? e => Err(UpdateTemplateErr.Deserialize(e))
}
