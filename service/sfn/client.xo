/// The HTTP request of CreateActivity.
pub fn serialize_create_activity(ep: rest.Endpoint, input: CreateActivityInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = input.tags {
    fs.push(("tags", json_of_tag_list(x)))
  }
  if let Some(x) = input.encryption_configuration {
    fs.push(("encryptionConfiguration", json_of_encryption_configuration(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.0"))
  headers.push(("X-Amz-Target", "AWSStepFunctions.CreateActivity"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_create_activity(resp: http.Response) -> CreateActivityOutput ! Str {
  var out = CreateActivityOutput{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "activityArn" => out.activity_arn = jsonv.read_str(fv)?
      "creationDate" => out.creation_date = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
}

/// The errors of CreateActivity.
pub enum CreateActivityErr {
  ActivityAlreadyExists(e: ActivityAlreadyExists)
  ActivityLimitExceeded(e: ActivityLimitExceeded)
  InvalidEncryptionConfiguration(e: InvalidEncryptionConfiguration)
  InvalidName(e: InvalidName)
  KmsAccessDeniedException(e: KmsAccessDeniedException)
  KmsThrottlingException(e: KmsThrottlingException)
  TooManyTags(e: TooManyTags)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: CreateActivityErr) display() -> Str {
  match e {
    ActivityAlreadyExists(x) => "ActivityAlreadyExists: ${x:?}"
    ActivityLimitExceeded(x) => "ActivityLimitExceeded: ${x:?}"
    InvalidEncryptionConfiguration(x) => "InvalidEncryptionConfiguration: ${x:?}"
    InvalidName(x) => "InvalidName: ${x:?}"
    KmsAccessDeniedException(x) => "KmsAccessDeniedException: ${x:?}"
    KmsThrottlingException(x) => "KmsThrottlingException: ${x:?}"
    TooManyTags(x) => "TooManyTags: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_create_activity_error(resp: http.Response) -> CreateActivityErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "ActivityAlreadyExists" => match read_error_activity_already_exists(resp, body) {
      Ok(x) => return CreateActivityErr.ActivityAlreadyExists(x)
      Err(msg) => return CreateActivityErr.Deserialize(msg)
    }
    "ActivityLimitExceeded" => match read_error_activity_limit_exceeded(resp, body) {
      Ok(x) => return CreateActivityErr.ActivityLimitExceeded(x)
      Err(msg) => return CreateActivityErr.Deserialize(msg)
    }
    "InvalidEncryptionConfiguration" => match read_error_invalid_encryption_configuration(resp, body) {
      Ok(x) => return CreateActivityErr.InvalidEncryptionConfiguration(x)
