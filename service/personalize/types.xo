/// An object that provides information about a specific version of a
/// Solution in a Custom dataset group.
pub struct SolutionVersion {
  /// The name of the solution version.
  pub name: Str? = None
  /// The ARN of the solution version.
  pub solution_version_arn: Str? = None
  /// The ARN of the solution.
  pub solution_arn: Str? = None
  /// Whether to perform hyperparameter optimization (HPO) on the chosen
  /// recipe. The default is false .
  pub perform_hpo: Bool? = None
  /// When true, Amazon Personalize searches for the most optimal recipe
  /// according to the solution configuration. When false (the default),
  /// Amazon Personalize uses recipeArn .
  pub perform_auto_ml: Bool? = None
  /// Whether the solution version should perform an incremental update. When
  /// set to true, the training will process only the data that has changed
  /// since the latest training, similar to when trainingMode is set to
  /// UPDATE. This can only be used with solution versions that use the
  /// User-Personalization recipe.
  pub perform_incremental_update: Bool? = None
  /// The ARN of the recipe used in the solution.
  pub recipe_arn: Str? = None
  /// The event type (for example, 'click' or 'like') that is used for
  /// training the model.
  pub event_type: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset group providing the
  /// training data.
  pub dataset_group_arn: Str? = None
  /// Describes the configuration properties for the solution.
  pub solution_config: SolutionConfig? = None
  /// The time used to train the model. You are billed for the time it takes
  /// to train a model. This field is visible only after Amazon Personalize
  /// successfully trains a model.
  pub training_hours: Float? = None
  /// The scope of training to be performed when creating the solution
  /// version. A FULL training considers all of the data in your dataset
  /// group. An UPDATE processes only the data that has changed since the
  /// latest training. Only solution versions created with the
  /// User-Personalization recipe can use UPDATE .
  pub training_mode: TrainingMode? = None
  /// If hyperparameter optimization was performed, contains the
  /// hyperparameter values of the best performing model.
  pub tuned_hpo_params: TunedHPOParams? = None
  /// The status of the solution version. A solution version can be in one of
  /// the following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE CREATE
  /// FAILED CREATE STOPPING CREATE STOPPED
  pub status: Str? = None
  /// If training a solution version fails, the reason for the failure.
  pub failure_reason: Str? = None
  /// The date and time (in Unix time) that this version of the solution was
  /// created.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) that the solution was last updated.
  pub last_updated_date_time: Time? = None
  /// Whether the solution version was created automatically or manually.
  pub training_type: TrainingType? = None
}

