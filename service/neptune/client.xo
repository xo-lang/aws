    xmlv.elem(w, "AutoMinorVersionUpgrade", "${x}", [])
  }
  if let Some(x) = v.read_replica_source_db_instance_identifier {
    xmlv.elem(w, "ReadReplicaSourceDBInstanceIdentifier", x, [])
  }
  if let Some(x) = v.read_replica_db_instance_identifiers {
    xml_write_read_replica_db_instance_identifier_list(w, x, "ReadReplicaDBInstanceIdentifiers", [])
  }
