fn xml_write_reserved_db_instance(var w: xmlv.Writer, v: ReservedDBInstance, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.reserved_db_instance_id {
    xmlv.elem(w, "ReservedDBInstanceId", x, [])
  }
  if let Some(x) = v.reserved_db_instances_offering_id {
    xmlv.elem(w, "ReservedDBInstancesOfferingId", x, [])
  }
  if let Some(x) = v.db_instance_class {
    xmlv.elem(w, "DBInstanceClass", x, [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "StartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.duration {
    xmlv.elem(w, "Duration", "${x}", [])
  }
  if let Some(x) = v.fixed_price {
    xmlv.elem(w, "FixedPrice", rest.encode_float(x), [])
  }
  if let Some(x) = v.usage_price {
    xmlv.elem(w, "UsagePrice", rest.encode_float(x), [])
  }
  if let Some(x) = v.currency_code {
    xmlv.elem(w, "CurrencyCode", x, [])
  }
  if let Some(x) = v.db_instance_count {
    xmlv.elem(w, "DBInstanceCount", "${x}", [])
  }
  if let Some(x) = v.product_description {
    xmlv.elem(w, "ProductDescription", x, [])
  }
  if let Some(x) = v.offering_type {
    xmlv.elem(w, "OfferingType", x, [])
  }
  if let Some(x) = v.multi_az {
    xmlv.elem(w, "MultiAZ", "${x}", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "State", x, [])
  }
  if let Some(x) = v.recurring_charges {
    xml_write_recurring_charge_list(w, x, "RecurringCharges", [])
  }
  if let Some(x) = v.reserved_db_instance_arn {
    xmlv.elem(w, "ReservedDBInstanceArn", x, [])
  }
  if let Some(x) = v.lease_id {
    xmlv.elem(w, "LeaseId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_reserved_db_instance(e: xml.Element) -> ReservedDBInstance ! Str {
  var out = ReservedDBInstance{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ReservedDBInstanceId" => out.reserved_db_instance_id = c.text()
      "ReservedDBInstancesOfferingId" => out.reserved_db_instances_offering_id = c.text()
      "DBInstanceClass" => out.db_instance_class = c.text()
      "StartTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Duration" => out.duration = xmlv.read_int(c.text())?
      "FixedPrice" => out.fixed_price = xmlv.read_float(c.text())?
      "UsagePrice" => out.usage_price = xmlv.read_float(c.text())?
      "CurrencyCode" => out.currency_code = c.text()
      "DBInstanceCount" => out.db_instance_count = xmlv.read_int(c.text())?
      "ProductDescription" => out.product_description = c.text()
      "OfferingType" => out.offering_type = c.text()
      "MultiAZ" => out.multi_az = xmlv.read_bool(c.text())?
      "State" => out.state = c.text()
      "RecurringCharges" => out.recurring_charges = xml_read_recurring_charge_list(c)?
      "ReservedDBInstanceArn" => out.reserved_db_instance_arn = c.text()
      "LeaseId" => out.lease_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

