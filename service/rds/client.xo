fn xml_write_db_snapshot(var w: xmlv.Writer, v: DBSnapshot, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.db_snapshot_identifier {
    xmlv.elem(w, "DBSnapshotIdentifier", x, [])
  }
  if let Some(x) = v.db_instance_identifier {
    xmlv.elem(w, "DBInstanceIdentifier", x, [])
  }
  if let Some(x) = v.snapshot_create_time {
    xmlv.elem(w, "SnapshotCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.allocated_storage {
    xmlv.elem(w, "AllocatedStorage", "${x}", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.port {
    xmlv.elem(w, "Port", "${x}", [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "AvailabilityZone", x, [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "VpcId", x, [])
  }
  if let Some(x) = v.instance_create_time {
    xmlv.elem(w, "InstanceCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.master_username {
    xmlv.elem(w, "MasterUsername", x, [])
  }
  if let Some(x) = v.engine_version {
    xmlv.elem(w, "EngineVersion", x, [])
  }
  if let Some(x) = v.license_model {
    xmlv.elem(w, "LicenseModel", x, [])
  }
  if let Some(x) = v.snapshot_type {
    xmlv.elem(w, "SnapshotType", x, [])
  }
  if let Some(x) = v.iops {
    xmlv.elem(w, "Iops", "${x}", [])
  }
  if let Some(x) = v.storage_throughput {
    xmlv.elem(w, "StorageThroughput", "${x}", [])
  }
  if let Some(x) = v.option_group_name {
    xmlv.elem(w, "OptionGroupName", x, [])
  }
  if let Some(x) = v.percent_progress {
    xmlv.elem(w, "PercentProgress", "${x}", [])
  }
  if let Some(x) = v.source_region {
    xmlv.elem(w, "SourceRegion", x, [])
  }
  if let Some(x) = v.source_db_snapshot_identifier {
    xmlv.elem(w, "SourceDBSnapshotIdentifier", x, [])
  }
  if let Some(x) = v.storage_type {
    xmlv.elem(w, "StorageType", x, [])
  }
  if let Some(x) = v.tde_credential_arn {
    xmlv.elem(w, "TdeCredentialArn", x, [])
  }
  if let Some(x) = v.encrypted {
    xmlv.elem(w, "Encrypted", "${x}", [])
  }
  if let Some(x) = v.storage_encryption_type {
    xmlv.elem(w, "StorageEncryptionType", x.value(), [])
  }
  if let Some(x) = v.backup_retention_period {
    xmlv.elem(w, "BackupRetentionPeriod", "${x}", [])
  }
  if let Some(x) = v.preferred_backup_window {
    xmlv.elem(w, "PreferredBackupWindow", x, [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KmsKeyId", x, [])
  }
  if let Some(x) = v.db_snapshot_arn {
    xmlv.elem(w, "DBSnapshotArn", x, [])
  }
  if let Some(x) = v.timezone {
    xmlv.elem(w, "Timezone", x, [])
  }
  if let Some(x) = v.iam_database_authentication_enabled {
    xmlv.elem(w, "IAMDatabaseAuthenticationEnabled", "${x}", [])
  }
  if let Some(x) = v.processor_features {
    xml_write_processor_feature_list(w, x, "ProcessorFeatures", [])
  }
  if let Some(x) = v.dbi_resource_id {
    xmlv.elem(w, "DbiResourceId", x, [])
  }
  if let Some(x) = v.tag_list {
    xml_write_tag_list(w, x, "TagList", [])
  }
  if let Some(x) = v.snapshot_target {
    xmlv.elem(w, "SnapshotTarget", x, [])
  }
  if let Some(x) = v.original_snapshot_create_time {
    xmlv.elem(w, "OriginalSnapshotCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.snapshot_database_time {
    xmlv.elem(w, "SnapshotDatabaseTime", rest.date_time(x), [])
  }
  if let Some(x) = v.db_system_id {
    xmlv.elem(w, "DBSystemId", x, [])
  }
  if let Some(x) = v.multi_tenant {
    xmlv.elem(w, "MultiTenant", "${x}", [])
  }
  if let Some(x) = v.dedicated_log_volume {
    xmlv.elem(w, "DedicatedLogVolume", "${x}", [])
  }
  if let Some(x) = v.additional_storage_volumes {
    xml_write_additional_storage_volumes_list(w, x, "AdditionalStorageVolumes", [])
  }
  if let Some(x) = v.snapshot_availability_zone {
    xmlv.elem(w, "SnapshotAvailabilityZone", x, [])
  }
  if let Some(x) = v.full_snapshot_size_in_bytes {
    xmlv.elem(w, "FullSnapshotSizeInBytes", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_db_snapshot(e: xml.Element) -> DBSnapshot ! Str {
  var out = DBSnapshot{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DBSnapshotIdentifier" => out.db_snapshot_identifier = c.text()
      "DBInstanceIdentifier" => out.db_instance_identifier = c.text()
      "SnapshotCreateTime" => out.snapshot_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Engine" => out.engine = c.text()
      "AllocatedStorage" => out.allocated_storage = xmlv.read_int(c.text())?
      "Status" => out.status = c.text()
      "Port" => out.port = xmlv.read_int(c.text())?
      "AvailabilityZone" => out.availability_zone = c.text()
      "VpcId" => out.vpc_id = c.text()
      "InstanceCreateTime" => out.instance_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MasterUsername" => out.master_username = c.text()
      "EngineVersion" => out.engine_version = c.text()
      "LicenseModel" => out.license_model = c.text()
      "SnapshotType" => out.snapshot_type = c.text()
      "Iops" => out.iops = xmlv.read_int(c.text())?
      "StorageThroughput" => out.storage_throughput = xmlv.read_int(c.text())?
      "OptionGroupName" => out.option_group_name = c.text()
      "PercentProgress" => out.percent_progress = xmlv.read_int(c.text())?
      "SourceRegion" => out.source_region = c.text()
      "SourceDBSnapshotIdentifier" => out.source_db_snapshot_identifier = c.text()
      "StorageType" => out.storage_type = c.text()
      "TdeCredentialArn" => out.tde_credential_arn = c.text()
      "Encrypted" => out.encrypted = xmlv.read_bool(c.text())?
      "StorageEncryptionType" => out.storage_encryption_type = StorageEncryptionType.from(c.text())
      "BackupRetentionPeriod" => out.backup_retention_period = xmlv.read_int(c.text())?
      "PreferredBackupWindow" => out.preferred_backup_window = c.text()
      "KmsKeyId" => out.kms_key_id = c.text()
      "DBSnapshotArn" => out.db_snapshot_arn = c.text()
      "Timezone" => out.timezone = c.text()
      "IAMDatabaseAuthenticationEnabled" => out.iam_database_authentication_enabled = xmlv.read_bool(c.text())?
      "ProcessorFeatures" => out.processor_features = xml_read_processor_feature_list(c)?
      "DbiResourceId" => out.dbi_resource_id = c.text()
      "TagList" => out.tag_list = xml_read_tag_list(c)?
      "SnapshotTarget" => out.snapshot_target = c.text()
      "OriginalSnapshotCreateTime" => out.original_snapshot_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SnapshotDatabaseTime" => out.snapshot_database_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DBSystemId" => out.db_system_id = c.text()
      "MultiTenant" => out.multi_tenant = xmlv.read_bool(c.text())?
      "DedicatedLogVolume" => out.dedicated_log_volume = xmlv.read_bool(c.text())?
      "AdditionalStorageVolumes" => out.additional_storage_volumes = xml_read_additional_storage_volumes_list(c)?
      "SnapshotAvailabilityZone" => out.snapshot_availability_zone = c.text()
      "FullSnapshotSizeInBytes" => out.full_snapshot_size_in_bytes = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

