  var out = NestedXmlMapsRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "nestedMap" => out.nested_map = xml_read_nested_map(c)?
      "flatNestedMap" => {
        var entries = out.flat_nested_map ?? {}
        let k = xmlv.child_text(c, "key") ?? ""
        if let Some(vc) = c.child("value") {
          entries.put(k, xml_read_foo_enum_map(vc)?)
        }
        out.flat_nested_map = entries
      }
      _ => {}
    }
  }
  Ok(out)
}

