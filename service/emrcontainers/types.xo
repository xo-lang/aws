  /// The updated virtual cluster.
  pub virtual_cluster: VirtualCluster? = None
}

/// There are invalid parameters in the client request.
pub struct ValidationException {
  pub message: Str? = None
}

/// This entity describes a virtual cluster. A virtual cluster is a
/// Kubernetes namespace that Amazon EMR is registered with. Amazon EMR uses
/// virtual clusters to run jobs and host endpoints. Multiple virtual
/// clusters can be backed by the same physical cluster. However, each
/// virtual cluster maps to one namespace on an Amazon EKS cluster. Virtual
/// clusters do not create any active resources that contribute to your bill
/// or that require lifecycle management outside the service.
pub struct VirtualCluster {
  /// The ID of the virtual cluster.
  pub id: Str? = None
  /// The name of the virtual cluster.
  pub name: Str? = None
  /// The ARN of the virtual cluster.
  pub arn: Str? = None
  /// The state of the virtual cluster.
  pub state: VirtualClusterState? = None
  /// The container provider of the virtual cluster.
  pub container_provider: ContainerProvider? = None
  /// The date and time when the virtual cluster is created.
  pub created_at: Time? = None
  /// The assigned tags of the virtual cluster.
  pub tags: Map[Str, Str]? = None
  /// The ID of the security configuration.
  pub security_configuration_id: Str? = None
  /// Specifies whether the virtual cluster has session support enabled.
  pub session_enabled: Bool? = None
  /// The scheduler configuration (concurrency and queue limits) applied to
  /// the virtual cluster. The service does not return this field when no
  /// scheduler limits are configured.
  pub scheduler_configuration: SchedulerConfiguration? = None
  /// The current in-queue and concurrent job-run counts for the virtual
  /// cluster.
  pub scheduler_status: SchedulerStatus? = None
}

pub enum VirtualClusterState: Str {
  Running = "RUNNING"
  Terminating = "TERMINATING"
  Terminated = "TERMINATED"
  Arrested = "ARRESTED"
  Unknown(value: Str)
}
