/// The next event, None at the end of the stream.
pub fn (var s: InvokeAgentRuntimeCommandEvents) next() -> InvokeAgentRuntimeCommandStreamOutput? ! InvokeAgentRuntimeCommandStreamOutputErr uses net.dial {
