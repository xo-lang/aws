fn xml_read_domain_name_list(e: xml.Element) -> List[Str] ! Str {
  var out: List[Str] = []
  for c in xmlv.elements(e) {
    out.push(c.text())
  }
  Ok(out)
}

fn xml_write_domain_name_map(var w: xmlv.Writer, v: Map[Str, Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", item, [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_domain_name_map(e: xml.Element) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, vc.text())
    }
  }
  Ok(out)
}

fn xml_write_domain_status(var w: xmlv.Writer, v: DomainStatus, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.domain_id {
    xmlv.elem(w, "DomainId", x, [])
  }
  if let Some(x) = v.domain_name {
    xmlv.elem(w, "DomainName", x, [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "ARN", x, [])
  }
  if let Some(x) = v.created {
    xmlv.elem(w, "Created", "${x}", [])
  }
  if let Some(x) = v.deleted {
    xmlv.elem(w, "Deleted", "${x}", [])
  }
  if let Some(x) = v.doc_service {
    xml_write_service_endpoint(w, x, "DocService", [])
  }
  if let Some(x) = v.search_service {
    xml_write_service_endpoint(w, x, "SearchService", [])
  }
  if let Some(x) = v.requires_index_documents {
    xmlv.elem(w, "RequiresIndexDocuments", "${x}", [])
  }
  if let Some(x) = v.processing {
    xmlv.elem(w, "Processing", "${x}", [])
  }
  if let Some(x) = v.search_instance_type {
    xmlv.elem(w, "SearchInstanceType", x, [])
  }
  if let Some(x) = v.search_partition_count {
    xmlv.elem(w, "SearchPartitionCount", "${x}", [])
  }
  if let Some(x) = v.search_instance_count {
    xmlv.elem(w, "SearchInstanceCount", "${x}", [])
  }
  if let Some(x) = v.limits {
    xml_write_limits(w, x, "Limits", [])
  }
  xmlv.end(w, name)
}

fn xml_read_domain_status(e: xml.Element) -> DomainStatus ! Str {
  var out = DomainStatus{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DomainId" => out.domain_id = c.text()
      "DomainName" => out.domain_name = c.text()
      "ARN" => out.arn = c.text()
      "Created" => out.created = xmlv.read_bool(c.text())?
      "Deleted" => out.deleted = xmlv.read_bool(c.text())?
      "DocService" => out.doc_service = xml_read_service_endpoint(c)?
      "SearchService" => out.search_service = xml_read_service_endpoint(c)?
      "RequiresIndexDocuments" => out.requires_index_documents = xmlv.read_bool(c.text())?
      "Processing" => out.processing = xmlv.read_bool(c.text())?
      "SearchInstanceType" => out.search_instance_type = c.text()
      "SearchPartitionCount" => out.search_partition_count = xmlv.read_int(c.text())?
      "SearchInstanceCount" => out.search_instance_count = xmlv.read_int(c.text())?
      "Limits" => out.limits = xml_read_limits(c)?
      _ => {}
    }
  }
  Ok(out)
}

