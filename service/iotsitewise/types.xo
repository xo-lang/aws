  /// The window (time interval) over which IoT SiteWise computes the metric's
  /// aggregation expression. IoT SiteWise computes one data point per window
  /// .
  pub window: MetricWindow? = None
  /// The processing configuration for the given metric property. You can
  /// configure metrics to be computed at the edge or in the Amazon Web
  /// Services Cloud. By default, metrics are forwarded to the cloud.
  pub processing_config: MetricProcessingConfig? = None
}

