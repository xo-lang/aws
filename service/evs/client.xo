  }
  if let Some(x) = v.environment_status {
    fs.push(("environmentStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.checks {
    fs.push(("checks", json_of_checks_list(x)))
  }
  if let Some(x) = v.connectivity_info {
