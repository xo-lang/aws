fn json_of_knowledge_source(v: KnowledgeSource) -> json.Value {
  match v {
    AssistantAssociationIds(x) => json.Value.Object([("assistantAssociationIds", json_of_assistant_association_id_list(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_knowledge_source(v: json.Value) -> KnowledgeSource ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "assistantAssociationIds" => Ok(KnowledgeSource.AssistantAssociationIds(from_json_assistant_association_id_list(fv)?))
      _ => Ok(KnowledgeSource.Unknown(k))
    }
  }
  Err("KnowledgeSource: no member set")
}

