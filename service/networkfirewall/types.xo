  /// of a firewall policy after you create it.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the firewall policy.
  pub arn: Str? = None
}

/// The high-level properties of a firewall policy. This, along with the
/// FirewallPolicy , define the policy. You can retrieve all objects for a
/// firewall policy by calling DescribeFirewallPolicy .
pub struct FirewallPolicyResponse {
  /// The descriptive name of the firewall policy. You can't change the name
  /// of a firewall policy after you create it.
  pub firewall_policy_name: Str? = None
  /// The Amazon Resource Name (ARN) of the firewall policy. If this response
  /// is for a create request that had DryRun set to TRUE , then this ARN is a
  /// placeholder that isn't attached to a valid resource.
  pub firewall_policy_arn: Str? = None
  /// The unique identifier for the firewall policy.
  pub firewall_policy_id: Str? = None
  /// A description of the firewall policy.
  pub description: Str? = None
  /// The current status of the firewall policy. You can retrieve this for a
  /// firewall policy by calling DescribeFirewallPolicy and providing the
  /// firewall policy's name or ARN.
  pub firewall_policy_status: ResourceStatus? = None
  /// Additional detail about the firewall policy's current status, when
  /// applicable. For example, while an Amazon Route 53 Resolver DNS Firewall
  /// rule group change is in progress, the status is UPDATING and this
  /// message is "A DNS Firewall rule group change is in progress."
  pub status_message: Str? = None
  /// The key:value pairs to associate with the resource.
  pub tags: List[Tag]? = None
  /// The number of capacity units currently consumed by the policy's
  /// stateless rules.
  pub consumed_stateless_rule_capacity: Int? = None
  /// The number of capacity units currently consumed by the policy's stateful
  /// rules.
  pub consumed_stateful_rule_capacity: Int? = None
  /// The total number of domain name specifications across all domain list
  /// rule groups in the firewall policy that use the
  /// stateful-domain-rulegroup resource type.
  pub consumed_stateful_domain_capacity: Int? = None
  /// The number of firewalls that are associated with this firewall policy.
  pub number_of_associations: Int? = None
  /// A complex type that contains the Amazon Web Services KMS encryption
  /// configuration settings for your firewall policy.
  pub encryption_configuration: EncryptionConfiguration? = None
  /// Any configuration errors that apply to the firewall policy. Network
  /// Firewall detects these errors asynchronously, after you create or update
  /// the policy, so an error can appear after the request that caused it has
  /// already succeeded. Each entry describes the problem and how to resolve
  /// it, and Network Firewall clears it automatically after you resolve the
  /// problem.
  pub errors: List[FirewallPolicyError]? = None
  /// The last time that the firewall policy was changed.
  pub last_modified_time: Time? = None
}

/// The object that defines a Next Generation policy. This, along with the
/// FirewallPolicyV2Response , define the policy. A Next Generation policy
/// defines how the firewall engine and IPS engine inspect and control your
/// VPC network traffic. You define the policy as a firewall section and an
/// IPS section, each a collection of rule groups, along with policy-wide
/// settings such as the policy mode and default actions. For more
/// information, see Next Generation policies in the Network Firewall
/// Developer Guide .
pub struct FirewallPolicyV2 {
  /// The firewall section of the policy—the rule groups that the firewall
  /// engine evaluates. Each entry references an existing firewall engine rule
  /// group or embeds a rule group directly in the policy, and each entry has
  /// a unique priority that sets its evaluation order within the section.
  pub firewall_rule_group_entries: List[FirewallRuleGroupEntry]? = None
  /// The IPS section of the policy—the rule groups that the IPS engine
  /// evaluates. Each entry references an existing IPS engine rule group or
  /// embeds a rule group directly in the policy. IPS section entries don't
  /// use a priority.
  pub ips_rule_group_entries: List[IpsRuleGroupEntry]? = None
  /// Indicates whether the policy's engines enforce their verdicts or only
  /// report them. In ENFORCE mode, the firewall engine and IPS engine apply
  /// their verdicts to traffic. In MONITOR mode, the engines evaluate traffic
  /// and generate logs and metrics, but don't block traffic, so you can
  /// observe how a policy would behave before you enforce it. For more
  /// information, see Next Generation policies in the Network Firewall
  /// Developer Guide .
  pub policy_mode: PolicyMode? = None
  /// The action that the firewall engine takes on traffic that doesn't match
  /// any firewall engine rule at a hook. The firewall engine is drop by
  /// default. You can set the default action to one of the following: DROP -
  /// Block the traffic. ACCEPT - Allow the traffic. REJECT - Block the
  /// traffic and send a TCP reset packet back to the client. ALERT - Allow
  /// the traffic and generate an alert log for the traffic that reaches the
  /// default action at every hook. This is distinct from setting the policy
  /// mode to MONITOR . For more information, see Next Generation policies in
  /// the Network Firewall Developer Guide .
  pub firewall_default_action: PolicyDefaultAction? = None
  /// Additional options governing how the engines handle stateful traffic,
  /// such as the stream exception policy and flow timeouts.
  pub stateful_engine_options: StatefulEngineOptionsV2? = None
  /// The Amazon Resource Name (ARN) of the TLS inspection configuration to
  /// use to decrypt traffic for inspection. Next Generation policies support
  /// session holding only. For more information, see Inspecting SSL/TLS
  /// traffic with TLS inspection configurations in the Network Firewall
  /// Developer Guide .
  pub tls_inspection_configuration_arn: Str? = None
  /// Contains variables that you can use to override default Suricata
  /// settings in your Next Generation policy.
  pub policy_variables: PolicyVariables? = None
  /// The settings that enable resolved IP validation for the Next Generation
  /// policy. Resolved IP validation verifies that a connection's destination
  /// IP address is one that the Amazon Route 53 Resolver returned in a DNS
  /// response for a domain. A VPC that's associated with the Route 53
  /// Resolver DNS Firewall rule group that you specify must send the
  /// response. This checks how the destination IP address was obtained,
  /// instead of relying only on the domain that the client asserts in its TLS
  /// Server Name Indication (SNI) or HTTP Host header. For more information,
  /// see Route53ResolvedIPValidation .
  pub route53_resolved_ip_validation: Route53ResolvedIPValidation? = None
}

