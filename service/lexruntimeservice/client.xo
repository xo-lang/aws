pub fn deserialize_put_session(resp: http.Response) -> PutSessionResponse ! Str {
  var out = PutSessionResponse{}
  if let Some(hv) = resp.header("Content-Type") {
    out.content_type = hv
  }
  if let Some(hv) = resp.header("x-amz-lex-intent-name") {
    out.intent_name = hv
  }
  if let Some(hv) = resp.header("x-amz-lex-slots") {
    out.slots = (Bytes.from_base64(hv) ?? return Err("bad base64 header")).to_str() ?? ""
  }
  if let Some(hv) = resp.header("x-amz-lex-session-attributes") {
    out.session_attributes = (Bytes.from_base64(hv) ?? return Err("bad base64 header")).to_str() ?? ""
  }
  if let Some(hv) = resp.header("x-amz-lex-message") {
    out.message = hv
  }
  if let Some(hv) = resp.header("x-amz-lex-encoded-message") {
    out.encoded_message = hv
  }
  if let Some(hv) = resp.header("x-amz-lex-message-format") {
    out.message_format = MessageFormatType.from(hv)
  }
  if let Some(hv) = resp.header("x-amz-lex-dialog-state") {
    out.dialog_state = DialogState.from(hv)
  }
  if let Some(hv) = resp.header("x-amz-lex-slot-to-elicit") {
    out.slot_to_elicit = hv
  }
  if let Some(hv) = resp.header("x-amz-lex-session-id") {
    out.session_id = hv
  }
  if let Some(hv) = resp.header("x-amz-lex-active-contexts") {
    out.active_contexts = (Bytes.from_base64(hv) ?? return Err("bad base64 header")).to_str() ?? ""
  }
  if !resp.body.is_empty() {
    out.audio_stream = resp.body
  }
  Ok(out)
}

