fn json_of_endpoint_configuration_request(v: EndpointConfigurationRequest) -> json.Value {
  match v {
    None(x) => json.Value.Object([("none", json_of_none_shape(x))])
    AcmManaged(x) => json.Value.Object([("acmManaged", json_of_acm_managed(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_endpoint_configuration_request(v: json.Value) -> EndpointConfigurationRequest ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "none" => Ok(EndpointConfigurationRequest.None(from_json_none_shape(fv)?))
      "acmManaged" => Ok(EndpointConfigurationRequest.AcmManaged(from_json_acm_managed(fv)?))
      _ => Ok(EndpointConfigurationRequest.Unknown(k))
    }
  }
  Err("EndpointConfigurationRequest: no member set")
}

