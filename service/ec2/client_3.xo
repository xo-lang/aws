fn xml_write_elastic_gpus(var w: xmlv.Writer, v: ElasticGpus, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.elastic_gpu_id {
    xmlv.elem(w, "elasticGpuId", x, [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.elastic_gpu_type {
    xmlv.elem(w, "elasticGpuType", x, [])
  }
  if let Some(x) = v.elastic_gpu_health {
    xml_write_elastic_gpu_health(w, x, "elasticGpuHealth", [])
  }
  if let Some(x) = v.elastic_gpu_state {
    xmlv.elem(w, "elasticGpuState", x.value(), [])
  }
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_elastic_gpus(e: xml.Element) -> ElasticGpus ! Str {
  var out = ElasticGpus{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "elasticGpuId" => out.elastic_gpu_id = c.text()
      "availabilityZone" => out.availability_zone = c.text()
      "elasticGpuType" => out.elastic_gpu_type = c.text()
      "elasticGpuHealth" => out.elastic_gpu_health = xml_read_elastic_gpu_health(c)?
      "elasticGpuState" => out.elastic_gpu_state = ElasticGpuState.from(c.text())
      "instanceId" => out.instance_id = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

