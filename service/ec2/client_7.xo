fn xml_write_vpc_peering_connection(var w: xmlv.Writer, v: VpcPeeringConnection, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.accepter_vpc_info {
    xml_write_vpc_peering_connection_vpc_info(w, x, "accepterVpcInfo", [])
  }
  if let Some(x) = v.expiration_time {
    xmlv.elem(w, "expirationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.requester_vpc_info {
    xml_write_vpc_peering_connection_vpc_info(w, x, "requesterVpcInfo", [])
  }
  if let Some(x) = v.status {
    xml_write_vpc_peering_connection_state_reason(w, x, "status", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.vpc_peering_connection_id {
    xmlv.elem(w, "vpcPeeringConnectionId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpc_peering_connection(e: xml.Element) -> VpcPeeringConnection ! Str {
  var out = VpcPeeringConnection{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "accepterVpcInfo" => out.accepter_vpc_info = xml_read_vpc_peering_connection_vpc_info(c)?
      "expirationTime" => out.expiration_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "requesterVpcInfo" => out.requester_vpc_info = xml_read_vpc_peering_connection_vpc_info(c)?
      "status" => out.status = xml_read_vpc_peering_connection_state_reason(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "vpcPeeringConnectionId" => out.vpc_peering_connection_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

