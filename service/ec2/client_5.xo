fn xml_read_launch_template(e: xml.Element) -> LaunchTemplate ! Str {
  var out = LaunchTemplate{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "launchTemplateId" => out.launch_template_id = c.text()
      "launchTemplateName" => out.launch_template_name = c.text()
