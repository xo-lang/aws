/// Wait until a variant store is deleted.
///
/// Calls GetVariantStore until the VariantStoreDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (600s).
pub fn wait_until_variant_store_deleted(c: Client, input: GetVariantStoreRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 600s) -> () ! waiter.WaitErr[GetVariantStoreErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_variant_store(input) {
      Ok(out) => {
        let o = jmes_of_get_variant_store_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "DELETED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "DELETING") {
          state = "retry"
        }
      }
      Err(e) => {
        let names = waiter_error_names_get_variant_store(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("VariantStoreDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

