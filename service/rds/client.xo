fn xml_write_db_instance_automated_backup(var w: xmlv.Writer, v: DBInstanceAutomatedBackup, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.db_instance_arn {
    xmlv.elem(w, "DBInstanceArn", x, [])
