// ECS and EKS container credentials (decision 0003), as aws-sdk-go-v2's
// credentials/endpointcreds: a GET of the container's credentials URL
// with the authorization token, if any, in `Authorization`.
//
// `config.load_default_config` makes one when the environment names the
// URL: AWS_CONTAINER_CREDENTIALS_RELATIVE_URI (under the ECS agent's
// address) or AWS_CONTAINER_CREDENTIALS_FULL_URI (EKS Pod Identity and
// others), with AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE or
// AWS_CONTAINER_AUTHORIZATION_TOKEN.
//
// The token file is a `aws.TokenFile`: read when loaded, and
// again every few minutes when its `watch` runs on `os.tasks` (aws-sdk-go-v2
// reads it at every fetch; a provider's `retrieve` has no file effect).

use std/http
use std/json
use github.com/xo-lang/aws
use github.com/xo-lang/aws/protocol/jsonv

/// The ECS agent's address, which a relative URI is under.
pub const ECS_ENDPOINT: Str = "http://169.254.170.2"

pub struct Options {
  /// The full credentials URL.
  pub uri: Str
  /// The `Authorization` header's value (an empty token for none).
  pub token: aws.TokenFile = aws.fixed_token("")
  pub timeout: Duration = 5s
  /// Attempts for a 5xx, a 429 or a failed connection.
  pub max_attempts: Int = 3
}

/// The URL of a relative URI from AWS_CONTAINER_CREDENTIALS_RELATIVE_URI.
pub fn relative_uri(path: Str) -> Str {
  "${ECS_ENDPOINT}${path}"
}

/// Whether a full URI may be used: any https URL, and http only to a
/// loopback address or the ECS and EKS agents' addresses (169.254.170.2,
/// 169.254.170.23, fd00:ec2::23), as aws-sdk-go-v2. A host name other
/// than `localhost` is refused over http, since it is not resolved here.
pub fn allowed_uri(uri: Str) -> () ! Str {
  let u = http.parse_url(uri) ?? e => return Err("${uri} is not a URL: ${e.display()}")
  if u.host == "" {
    return Err("${uri} has no host")
  }
  if u.scheme == "https" {
    return Ok(())
  }
  if u.scheme != "http" {
    return Err("${uri}: want http or https")
  }
  let h = u.host.trim_prefix("[").trim_suffix("]").to_lower()
  if h == "localhost" || h.starts_with("127.") || h == "::1" || h == "169.254.170.2" || h == "169.254.170.23" || h == "fd00:ec2::23" {
    return Ok(())
  }
  Err("${uri}: over http only loopback and the ECS and EKS agents' addresses are allowed")
}

/// The provider: wrap it in `credentials.cache`. Not `Provider`, so it
/// and an app's own `Provider` do not collide (docs/reports/xo-issues.md 15).
pub struct EndpointProvider {
  http: http.Client
  clock: Clock
  opts: Options
}

pub fn provider(net: Net, clock: Clock, opts: Options) -> EndpointProvider {
  EndpointProvider{http: http.client(net, opts.timeout), clock: clock, opts: opts}
}

pub fn (p: EndpointProvider) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  let fail = fn(msg: Str) -> aws.CredentialsErr { aws.CredentialsErr.Fetch("container credentials: ${msg}") }
  var req = http.new_request("GET", p.opts.uri).with_header("Accept", "application/json")
  let token = p.opts.token.get().reveal()
  if token != "" {
    req = req.with_header("Authorization", token)
  }
  var attempt = 0
  var got: http.Response? = None
  while got.is_none() {
    attempt += 1
    match p.http.send(req) {
      Ok(r) => {
        if (r.status >= 500 || r.status == 429) && attempt < p.opts.max_attempts {
          p.clock.sleep(Duration.from_millis(200 * attempt))
        } else {
          got = Some(r)
        }
      }
      Err(e) => {
        if attempt >= p.opts.max_attempts {
          return Err(fail(e.display()))
        }
        p.clock.sleep(Duration.from_millis(200 * attempt))
      }
    }
  }
  let resp = got ?? return Err(fail("no response"))
  let doc = jsonv.parse_body(resp.body).ok()
  let field = fn(k: Str) -> Str {
    match doc.and_then(fn(d: json.Value) -> json.Value? { d.get(k) }) {
      Some(json.Value.Str(s)) => s
      _ => ""
    }
  }
  if resp.status < 200 || resp.status >= 300 {
    let msg = if field("message") != "" { "${field("code")} ${field("message")}".trim() } else { (resp.body.to_str() ?? "").trim() }
    return Err(fail("HTTP ${resp.status}${if msg == "" { "" } else { ": ${msg}" }}"))
  }
  if doc.is_none() {
    return Err(fail("the response is not JSON"))
  }
  if field("AccessKeyId") == "" {
    return Err(fail("the response has no AccessKeyId"))
  }
  let expires = if field("Expiration") == "" { None } else {
    Some(Time.parse_rfc3339(field("Expiration")) ?? return Err(fail("Expiration ${field("Expiration")} is not RFC 3339")))
  }
  Ok(aws.Credentials{
    access_key_id: field("AccessKeyId"),
    secret_access_key: Secret.new(field("SecretAccessKey")),
    session_token: if field("Token") == "" { None } else { Some(Secret.new(field("Token"))) },
    expires: expires,
    source: "CredentialsEndpointProvider",
    account_id: if field("AccountId") == "" { None } else { Some(field("AccountId")) },
  })
}
