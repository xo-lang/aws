  match started.opened {
    Done(resp) => {
      w.close()
      Err(deserialize_chat_error(resp))
    }
    Stream(head, body) => {
      match deserialize_chat(http.Response{status: head.status, headers: head.headers, body: b""}) {
        Ok(o) => Ok(ChatStream{output: o, writer: w, signer: started.signer, clock: c.transport.clock, body: body})
        Err(msg) => {
          body.close()
          w.close()
          Err(ChatErr.Deserialize(msg))
        }
      }
    }
  }
}

