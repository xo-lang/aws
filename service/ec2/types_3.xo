/// Describes a secondary interface attached to an instance.
pub struct InstanceSecondaryInterface {
  /// The attachment information for the secondary interface.
  pub attachment: InstanceSecondaryInterfaceAttachment? = None
  /// The MAC address of the secondary interface.
  pub mac_address: Str? = None
  /// The ID of the secondary interface.
  pub secondary_interface_id: Str? = None
  /// The Amazon Web Services account ID of the owner of the secondary
  /// interface.
  pub owner_id: Str? = None
  /// The private IPv4 addresses associated with the secondary interface.
  pub private_ip_addresses: List[InstanceSecondaryInterfacePrivateIpAddress]? = None
  /// Indicates whether source/destination checking is enabled.
  pub source_dest_check: Bool? = None
  /// The status of the secondary interface.
  pub status: SecondaryInterfaceStatus? = None
  /// The ID of the secondary subnet.
  pub secondary_subnet_id: Str? = None
  /// The ID of the secondary network.
  pub secondary_network_id: Str? = None
  /// The type of secondary interface.
  pub interface_type: SecondaryInterfaceType? = None
}

/// Describes the attachment of a secondary interface to an instance.
pub struct InstanceSecondaryInterfaceAttachment {
  /// The timestamp when the attachment was created.
  pub attach_time: Time? = None
  /// The ID of the attachment.
  pub attachment_id: Str? = None
  /// Indicates whether the secondary interface is deleted when the instance
  /// is terminated. The only supported value for this field is true .
  pub delete_on_termination: Bool? = None
  /// The device index of the secondary interface.
  pub device_index: Int? = None
  /// The attachment state.
  pub status: AttachmentStatus? = None
  /// The index of the network card.
  pub network_card_index: Int? = None
}

/// Describes a private IPv4 address for a secondary interface.
pub struct InstanceSecondaryInterfacePrivateIpAddress {
  /// The private IPv4 address.
  pub private_ip_address: Str? = None
}

/// Describes a private IPv4 address for a secondary interface request.
pub struct InstanceSecondaryInterfacePrivateIpAddressRequest {
  /// The private IPv4 address.
  pub private_ip_address: Str? = None
}

/// Describes a secondary interface specification for launching an instance.
