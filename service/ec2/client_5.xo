fn xml_write_ipam(var w: xmlv.Writer, v: Ipam, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.ipam_id {
    xmlv.elem(w, "ipamId", x, [])
  }
  if let Some(x) = v.ipam_arn {
    xmlv.elem(w, "ipamArn", x, [])
  }
  if let Some(x) = v.ipam_region {
    xmlv.elem(w, "ipamRegion", x, [])
  }
  if let Some(x) = v.public_default_scope_id {
    xmlv.elem(w, "publicDefaultScopeId", x, [])
  }
  if let Some(x) = v.private_default_scope_id {
    xmlv.elem(w, "privateDefaultScopeId", x, [])
  }
  if let Some(x) = v.scope_count {
    xmlv.elem(w, "scopeCount", "${x}", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "description", x, [])
  }
  if let Some(x) = v.operating_regions {
    xml_write_ipam_operating_region_set(w, x, "operatingRegionSet", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.default_resource_discovery_id {
    xmlv.elem(w, "defaultResourceDiscoveryId", x, [])
  }
  if let Some(x) = v.default_resource_discovery_association_id {
    xmlv.elem(w, "defaultResourceDiscoveryAssociationId", x, [])
  }
  if let Some(x) = v.resource_discovery_association_count {
    xmlv.elem(w, "resourceDiscoveryAssociationCount", "${x}", [])
  }
  if let Some(x) = v.state_message {
    xmlv.elem(w, "stateMessage", x, [])
  }
  if let Some(x) = v.tier {
    xmlv.elem(w, "tier", x.value(), [])
  }
  if let Some(x) = v.enable_private_gua {
    xmlv.elem(w, "enablePrivateGua", "${x}", [])
  }
  if let Some(x) = v.metered_account {
    xmlv.elem(w, "meteredAccount", x.value(), [])
  }
  xmlv.end(w, name)
