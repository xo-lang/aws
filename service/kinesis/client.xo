      "ConsumerStatus" => out.consumer_status = ConsumerStatus.from(jsonv.read_str(fv)?)
      "ConsumerCreationTimestamp" => out.consumer_creation_timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "StreamARN" => out.stream_arn = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_consumer_list(v: List[Consumer]) -> json.Value {
  json.Value.List(v.map(fn(x: Consumer) -> json.Value { json_of_consumer(x) }))
}

fn from_json_consumer_list(v: json.Value) -> List[Consumer] ! Str {
  var out: List[Consumer] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_consumer(fv)?)
  }
  Ok(out)
}

