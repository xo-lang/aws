    xml_write_snapshot_task_detail(w, x, "snapshotTaskDetail", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_import_snapshot_task(e: xml.Element) -> ImportSnapshotTask ! Str {
