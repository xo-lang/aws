pub struct UpdateTemplateRequest {
  /// The unique identifier of the Cases domain.
  pub domain_id: Str? = None
  /// A unique identifier for the template.
  pub template_id: Str? = None
  /// The name of the template. It must be unique per domain.
  pub name: Str? = None
  /// A brief description of the template.
  pub description: Str? = None
  /// Configuration of layouts associated to the template.
  pub layout_configuration: LayoutConfiguration? = None
  /// A list of fields that must contain a value for a case to be successfully
  /// created with this template. To require a Customer Profile when creating
  /// cases, include customer_id in this list. If customer_id is omitted, the
  /// Customer Profile field is optional and can be added, changed, or removed
  /// after case creation.
  pub required_fields: List[RequiredField]? = None
  /// The status of the template.
  pub status: Str? = None
  /// A list of case rules (also known as case field conditions ) on a
  /// template.
  pub rules: List[TemplateRule]? = None
  /// Defines tag propagation configuration for resources created within a
  /// domain. Tags specified here will be automatically applied to resources
  /// being created for the specified resource type.
  pub tag_propagation_configurations: List[TagPropagationConfiguration]? = None
}

pub struct UpdateTemplateResponse {
}

