  var out = PendingMaintenanceAction{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Action" => out.action = c.text()
      "AutoAppliedAfterDate" => out.auto_applied_after_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ForcedApplyDate" => out.forced_apply_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "OptInStatus" => out.opt_in_status = c.text()
      "CurrentApplyDate" => out.current_apply_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Description" => out.description = c.text()
      _ => {}
    }
  }
  Ok(out)
}

