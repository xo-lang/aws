/// An item of the periodontal chart that needs the clinician's
/// confirmation.
pub struct PeriodontalReview {
  /// The reason for review. The following values are valid: SITE_NOT_CHARTED
  /// : One or more sites have no reading. VALUE_NOT_CHARTED : A dictated
  /// value or charting instruction was not charted, for example because the
  /// value was out of range or not valid at its position.
  /// READING_COUNT_MISMATCH : The number of dictated values did not match the
  /// number of open sites. The values were charted as dictated. LINE_UNCLEAR
  /// : A line of dictation could not be interpreted and was not charted.
  /// TOOTH_UNCLEAR : A line of dictation did not identify the tooth and was
  /// not charted. MISSING_TOOTH_CONFLICT : The dictation conflicts with a
  /// tooth marked as missing. MEASUREMENT_NOT_CHARTED : The dictation
  /// included a measurement that the chart does not record, such as plaque,
  /// calculus, or the mucogingival junction. SESSION_ISSUE : The exam setup
  /// could not be used and all teeth were assumed to be present, or the
  /// earlier chart could not be restored and charting restarted.
  pub reason: PeriodontalReviewReason? = None
  /// The tooth that the item refers to.
  pub tooth_number: Int? = None
  /// The probing sites of that tooth that the item refers to.
  pub sites: List[PeriodontalSiteName]? = None
}

pub enum PeriodontalReviewReason: Str {
  SiteNotCharted = "SITE_NOT_CHARTED"
  ValueNotCharted = "VALUE_NOT_CHARTED"
  ReadingCountMismatch = "READING_COUNT_MISMATCH"
  LineUnclear = "LINE_UNCLEAR"
  ToothUnclear = "TOOTH_UNCLEAR"
  MissingToothConflict = "MISSING_TOOTH_CONFLICT"
  MeasurementNotCharted = "MEASUREMENT_NOT_CHARTED"
  SessionIssue = "SESSION_ISSUE"
  Unknown(value: Str)
}

/// The measurements at one probing site of a tooth.
pub struct PeriodontalSite {
  /// The probing site. The following values are valid: DB : Distobuccal. B :
  /// Buccal. MB : Mesiobuccal. DL : Distolingual. L : Lingual. ML :
  /// Mesiolingual.
  pub site: PeriodontalSiteName? = None
  /// The probing depth, in millimeters. The value ranges from 0 to 15.
  pub probing_depth: Int? = None
  /// The gingival recession, in millimeters. The value ranges from -5 to 15.
  /// For example, -1 represents "plus one."
  pub recession: Int? = None
  /// Specifies whether the site bled during probing.
  pub bleeding: Bool? = None
  /// Specifies whether suppuration was present at the site.
  pub suppuration: Bool? = None
}

pub enum PeriodontalSiteName: Str {
  Distobuccal = "DB"
  Buccal = "B"
  Mesiobuccal = "MB"
  Distolingual = "DL"
  Lingual = "L"
  Mesiolingual = "ML"
  Unknown(value: Str)
}

/// The chart for one tooth.
pub struct PeriodontalTooth {
  /// The tooth number in the Universal Numbering System. The value ranges
  /// from 1 to 32.
  pub tooth_number: Int? = None
  /// Specifies whether the tooth is missing.
  pub missing: Bool? = None
  /// The tooth mobility grade. The value ranges from 0 to 3.
  pub mobility: Int? = None
  /// The furcation involvement class. The value ranges from 0 to 3.
  pub furcation: Int? = None
  /// The probing sites that have a recorded measurement, in the order MB , B
  /// , DB , ML , L , DL .
  pub sites: List[PeriodontalSite]? = None
}

