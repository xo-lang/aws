fn json_of_cloud_vm_cluster_list(v: List[CloudVmClusterSummary]) -> json.Value {
  json.Value.List(v.map(fn(x: CloudVmClusterSummary) -> json.Value { json_of_cloud_vm_cluster_summary(x) }))
}

fn from_json_cloud_vm_cluster_list(v: json.Value) -> List[CloudVmClusterSummary] ! Str {
  var out: List[CloudVmClusterSummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_cloud_vm_cluster_summary(fv)?)
  }
  Ok(out)
}

