pub struct SecureNamespaceInfo {
  /// The ID of the Amazon EKS cluster where Amazon EMR on EKS jobs run.
  pub cluster_id: Str? = None
  /// The namespace of the Amazon EKS cluster where the system jobs run.
  pub namespace: Str? = None
}

/// Inputs related to the security configuration. Security configurations in
/// Amazon EMR on EKS are templates for different security setups. You can
/// use security configurations to configure the Lake Formation integration
/// setup. You can also create a security configuration to re-use a security
/// setup each time you create a virtual cluster.
pub struct SecurityConfiguration {
  /// The ID of the security configuration.
  pub id: Str? = None
  /// The name of the security configuration.
  pub name: Str? = None
  /// The ARN (Amazon Resource Name) of the security configuration.
  pub arn: Str? = None
  /// The date and time that the job run was created.
  pub created_at: Time? = None
  /// The user who created the job run.
  pub created_by: Str? = None
  /// Security configuration inputs for the request.
  pub security_configuration_data: SecurityConfigurationData? = None
  /// The tags to assign to the security configuration.
  pub tags: Map[Str, Str]? = None
}

/// Configurations related to the security configuration for the request.
pub struct SecurityConfigurationData {
  /// Authorization-related configuration input for the security
  /// configuration.
  pub authorization_configuration: AuthorizationConfiguration? = None
  /// Authentication-related configuration input for the security
  /// configuration.
  pub authentication_configuration: AuthenticationConfiguration? = None
}

