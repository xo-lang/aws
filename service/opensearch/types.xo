pub struct CompareDomainConfigurationRequest {
  /// The Amazon Resource Name (ARN) of the domain to compare from.
  pub source_domain_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the domain to compare against.
  pub target_domain_arn: Str? = None
  /// The metadata categories to compare. At least one is required, and only
  /// the categories you name are read and returned. aliases alerting_monitors
  /// cluster_settings component_templates ingest_pipelines ism_policies —
  /// index state management policies security_action_groups
  /// security_internal_users security_role_mappings security_roles templates
  /// — index templates The set of categories grows over time, so this list
  /// is not fixed. A category the service does not recognise is rejected with
  /// the supported categories named in the error message.
  pub categories: List[Str]? = None
}

