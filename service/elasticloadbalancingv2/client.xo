fn xml_write_listener(var w: xmlv.Writer, v: Listener, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.listener_arn {
    xmlv.elem(w, "ListenerArn", x, [])
  }
  if let Some(x) = v.load_balancer_arn {
    xmlv.elem(w, "LoadBalancerArn", x, [])
  }
  if let Some(x) = v.port {
    xmlv.elem(w, "Port", "${x}", [])
  }
  if let Some(x) = v.protocol {
    xmlv.elem(w, "Protocol", x.value(), [])
  }
  if let Some(x) = v.certificates {
    xml_write_certificate_list(w, x, "Certificates", [])
  }
  if let Some(x) = v.ssl_policy {
    xmlv.elem(w, "SslPolicy", x, [])
  }
  if let Some(x) = v.default_actions {
    xml_write_actions(w, x, "DefaultActions", [])
  }
  if let Some(x) = v.alpn_policy {
    xml_write_alpn_policy_name(w, x, "AlpnPolicy", [])
  }
  if let Some(x) = v.mutual_authentication {
    xml_write_mutual_authentication_attributes(w, x, "MutualAuthentication", [])
  }
  xmlv.end(w, name)
}

fn xml_read_listener(e: xml.Element) -> Listener ! Str {
  var out = Listener{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ListenerArn" => out.listener_arn = c.text()
      "LoadBalancerArn" => out.load_balancer_arn = c.text()
      "Port" => out.port = xmlv.read_int(c.text())?
      "Protocol" => out.protocol = ProtocolEnum.from(c.text())
      "Certificates" => out.certificates = xml_read_certificate_list(c)?
      "SslPolicy" => out.ssl_policy = c.text()
      "DefaultActions" => out.default_actions = xml_read_actions(c)?
      "AlpnPolicy" => out.alpn_policy = xml_read_alpn_policy_name(c)?
      "MutualAuthentication" => out.mutual_authentication = xml_read_mutual_authentication_attributes(c)?
      _ => {}
    }
  }
  Ok(out)
}

