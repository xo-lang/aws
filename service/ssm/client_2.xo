      "Classification" => out.classification = jsonv.read_str(fv)?
      "MsrcSeverity" => out.msrc_severity = jsonv.read_str(fv)?
      "KbNumber" => out.kb_number = jsonv.read_str(fv)?
      "MsrcNumber" => out.msrc_number = jsonv.read_str(fv)?
      "Language" => out.language = jsonv.read_str(fv)?
      "AdvisoryIds" => out.advisory_ids = from_json_patch_advisory_id_list(fv)?
      "BugzillaIds" => out.bugzilla_ids = from_json_patch_bugzilla_id_list(fv)?
      "CVEIds" => out.cve_ids = from_json_patch_cve_id_list(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "Epoch" => out.epoch = jsonv.read_int(fv)?
      "Version" => out.version = jsonv.read_str(fv)?
      "Release" => out.release = jsonv.read_str(fv)?
      "Arch" => out.arch = jsonv.read_str(fv)?
      "Severity" => out.severity = jsonv.read_str(fv)?
      "Repository" => out.repository = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
