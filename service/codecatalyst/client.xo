/// The HTTP request of CreateAccessToken.
pub fn serialize_create_access_token(ep: rest.Endpoint, input: CreateAccessTokenRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = input.expires_time {
    fs.push(("expiresTime", jsonv.time(x, "date-time")))
