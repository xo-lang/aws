  /// custom knowledge articles, but not both.
  pub knowledge_article_configuration: SalesforceKnowledgeArticleConfiguration? = None
  /// Configuration information for Salesforce chatter feeds.
  pub chatter_feed_configuration: SalesforceChatterFeedConfiguration? = None
  /// Indicates whether Amazon Kendra should index attachments to Salesforce
  /// objects.
