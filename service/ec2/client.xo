      "allocationId" => out.allocation_id = c.text()
      "transferAccountId" => out.transfer_account_id = c.text()
      "transferOfferExpirationTimestamp" => out.transfer_offer_expiration_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "transferOfferAcceptedTimestamp" => out.transfer_offer_accepted_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "addressTransferStatus" => out.address_transfer_status = AddressTransferStatus.from(c.text())
