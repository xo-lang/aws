fn xml_write_recommendation(var w: xmlv.Writer, v: Recommendation, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.id {
    xmlv.elem(w, "Id", x, [])
  }
  if let Some(x) = v.cluster_identifier {
    xmlv.elem(w, "ClusterIdentifier", x, [])
  }
  if let Some(x) = v.namespace_arn {
    xmlv.elem(w, "NamespaceArn", x, [])
  }
  if let Some(x) = v.created_at {
    xmlv.elem(w, "CreatedAt", rest.date_time(x), [])
  }
  if let Some(x) = v.recommendation_type {
    xmlv.elem(w, "RecommendationType", x, [])
  }
  if let Some(x) = v.title {
    xmlv.elem(w, "Title", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.observation {
    xmlv.elem(w, "Observation", x, [])
  }
  if let Some(x) = v.impact_ranking {
    xmlv.elem(w, "ImpactRanking", x.value(), [])
  }
  if let Some(x) = v.recommendation_text {
    xmlv.elem(w, "RecommendationText", x, [])
  }
  if let Some(x) = v.recommended_actions {
    xml_write_recommended_action_list(w, x, "RecommendedActions", [])
  }
  if let Some(x) = v.reference_links {
    xml_write_reference_link_list(w, x, "ReferenceLinks", [])
  }
  xmlv.end(w, name)
}

fn xml_read_recommendation(e: xml.Element) -> Recommendation ! Str {
  var out = Recommendation{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Id" => out.id = c.text()
      "ClusterIdentifier" => out.cluster_identifier = c.text()
      "NamespaceArn" => out.namespace_arn = c.text()
      "CreatedAt" => out.created_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "RecommendationType" => out.recommendation_type = c.text()
      "Title" => out.title = c.text()
      "Description" => out.description = c.text()
      "Observation" => out.observation = c.text()
      "ImpactRanking" => out.impact_ranking = ImpactRankingType.from(c.text())
      "RecommendationText" => out.recommendation_text = c.text()
      "RecommendedActions" => out.recommended_actions = xml_read_recommended_action_list(c)?
      "ReferenceLinks" => out.reference_links = xml_read_reference_link_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_recommendation_list(var w: xmlv.Writer, v: List[Recommendation], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_recommendation(w, item, "Recommendation", [])
  }
  xmlv.end(w, name)
}

