fn query_put_put_scheduled_update_group_action_type(var f: query.Form, prefix: Str, v: PutScheduledUpdateGroupActionType) {
  if let Some(x) = v.auto_scaling_group_name {
    query.add(f, query.key(prefix, "AutoScalingGroupName"), x)
  }
  if let Some(x) = v.scheduled_action_name {
    query.add(f, query.key(prefix, "ScheduledActionName"), x)
  }
  if let Some(x) = v.time {
    query.add(f, query.key(prefix, "Time"), rest.date_time(x))
  }
  if let Some(x) = v.start_time {
    query.add(f, query.key(prefix, "StartTime"), rest.date_time(x))
  }
  if let Some(x) = v.end_time {
    query.add(f, query.key(prefix, "EndTime"), rest.date_time(x))
