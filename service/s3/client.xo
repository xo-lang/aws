  var out = QueueConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Id" => out.id = c.text()
      "Queue" => out.queue_arn = c.text()
      "Event" => {
        var items = out.events ?? []
        items.push(Event.from(c.text()))
        out.events = items
      }
      "Filter" => out.filter = xml_read_notification_configuration_filter(c)?
      _ => {}
    }
  }
  Ok(out)
}

