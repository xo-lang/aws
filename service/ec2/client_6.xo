fn xml_write_nat_gateway(var w: xmlv.Writer, v: NatGateway, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.create_time {
    xmlv.elem(w, "createTime", rest.date_time(x), [])
  }
  if let Some(x) = v.delete_time {
    xmlv.elem(w, "deleteTime", rest.date_time(x), [])
  }
  if let Some(x) = v.failure_code {
    xmlv.elem(w, "failureCode", x, [])
  }
  if let Some(x) = v.failure_message {
    xmlv.elem(w, "failureMessage", x, [])
  }
  if let Some(x) = v.nat_gateway_addresses {
    xml_write_nat_gateway_address_list(w, x, "natGatewayAddressSet", [])
  }
  if let Some(x) = v.nat_gateway_id {
    xmlv.elem(w, "natGatewayId", x, [])
  }
  if let Some(x) = v.provisioned_bandwidth {
    xml_write_provisioned_bandwidth(w, x, "provisionedBandwidth", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.subnet_id {
    xmlv.elem(w, "subnetId", x, [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "vpcId", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.connectivity_type {
    xmlv.elem(w, "connectivityType", x.value(), [])
  }
  if let Some(x) = v.availability_mode {
    xmlv.elem(w, "availabilityMode", x.value(), [])
  }
  if let Some(x) = v.auto_scaling_ips {
    xmlv.elem(w, "autoScalingIps", x.value(), [])
  }
  if let Some(x) = v.auto_provision_zones {
    xmlv.elem(w, "autoProvisionZones", x.value(), [])
  }
  if let Some(x) = v.attached_appliances {
    xml_write_nat_gateway_attached_appliance_list(w, x, "attachedApplianceSet", [])
  }
  if let Some(x) = v.route_table_id {
    xmlv.elem(w, "routeTableId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_nat_gateway(e: xml.Element) -> NatGateway ! Str {
  var out = NatGateway{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "createTime" => out.create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "deleteTime" => out.delete_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "failureCode" => out.failure_code = c.text()
      "failureMessage" => out.failure_message = c.text()
      "natGatewayAddressSet" => out.nat_gateway_addresses = xml_read_nat_gateway_address_list(c)?
      "natGatewayId" => out.nat_gateway_id = c.text()
      "provisionedBandwidth" => out.provisioned_bandwidth = xml_read_provisioned_bandwidth(c)?
      "state" => out.state = NatGatewayState.from(c.text())
      "subnetId" => out.subnet_id = c.text()
      "vpcId" => out.vpc_id = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "connectivityType" => out.connectivity_type = ConnectivityType.from(c.text())
      "availabilityMode" => out.availability_mode = AvailabilityMode.from(c.text())
      "autoScalingIps" => out.auto_scaling_ips = AutoScalingIpsState.from(c.text())
      "autoProvisionZones" => out.auto_provision_zones = AutoProvisionZonesState.from(c.text())
      "attachedApplianceSet" => out.attached_appliances = xml_read_nat_gateway_attached_appliance_list(c)?
      "routeTableId" => out.route_table_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

