/// Updates the configuration of a source endpoint.
pub fn (c: Client) update_source_endpoint(input: UpdateSourceEndpointRequest) -> UpdateSourceEndpointResponse ! UpdateSourceEndpointErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_source_endpoint(c.params, input)) ?? e => return Err(UpdateSourceEndpointErr.InvalidInput(e))
  var req = serialize_update_source_endpoint(ep, input, "") ?? e => return Err(UpdateSourceEndpointErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateSourceEndpointErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_source_endpoint_error(resp))
  }
  deserialize_update_source_endpoint(resp) ?? e => Err(UpdateSourceEndpointErr.Deserialize(e))
