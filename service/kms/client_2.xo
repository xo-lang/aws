pub fn (e: VerifyMacErr) display() -> Str {
  match e {
    DisabledException(x) => "DisabledException: ${x:?}"
    DryRunOperationException(x) => "DryRunOperationException: ${x:?}"
    InvalidGrantTokenException(x) => "InvalidGrantTokenException: ${x:?}"
    InvalidKeyUsageException(x) => "InvalidKeyUsageException: ${x:?}"
    KeyUnavailableException(x) => "KeyUnavailableException: ${x:?}"
    KMSInternalException(x) => "KMSInternalException: ${x:?}"
    KMSInvalidMacException(x) => "KMSInvalidMacException: ${x:?}"
    KMSInvalidStateException(x) => "KMSInvalidStateException: ${x:?}"
    NotFoundException(x) => "NotFoundException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

