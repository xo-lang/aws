fn json_of_data_provider_settings(v: DataProviderSettings) -> json.Value {
  match v {
    RedshiftSettings(x) => json.Value.Object([("RedshiftSettings", json_of_redshift_data_provider_settings(x))])
    PostgreSqlSettings(x) => json.Value.Object([("PostgreSqlSettings", json_of_postgre_sql_data_provider_settings(x))])
    MySqlSettings(x) => json.Value.Object([("MySqlSettings", json_of_my_sql_data_provider_settings(x))])
    OracleSettings(x) => json.Value.Object([("OracleSettings", json_of_oracle_data_provider_settings(x))])
    SybaseAseSettings(x) => json.Value.Object([("SybaseAseSettings", json_of_sybase_ase_data_provider_settings(x))])
    MicrosoftSqlServerSettings(x) => json.Value.Object([("MicrosoftSqlServerSettings", json_of_microsoft_sql_server_data_provider_settings(x))])
    DocDbSettings(x) => json.Value.Object([("DocDbSettings", json_of_doc_db_data_provider_settings(x))])
    MariaDbSettings(x) => json.Value.Object([("MariaDbSettings", json_of_maria_db_data_provider_settings(x))])
    IbmDb2LuwSettings(x) => json.Value.Object([("IbmDb2LuwSettings", json_of_ibm_db2_luw_data_provider_settings(x))])
    IbmDb2ZOsSettings(x) => json.Value.Object([("IbmDb2zOsSettings", json_of_ibm_db2_z_os_data_provider_settings(x))])
    MongoDbSettings(x) => json.Value.Object([("MongoDbSettings", json_of_mongo_db_data_provider_settings(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_data_provider_settings(v: json.Value) -> DataProviderSettings ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "RedshiftSettings" => Ok(DataProviderSettings.RedshiftSettings(from_json_redshift_data_provider_settings(fv)?))
      "PostgreSqlSettings" => Ok(DataProviderSettings.PostgreSqlSettings(from_json_postgre_sql_data_provider_settings(fv)?))
      "MySqlSettings" => Ok(DataProviderSettings.MySqlSettings(from_json_my_sql_data_provider_settings(fv)?))
      "OracleSettings" => Ok(DataProviderSettings.OracleSettings(from_json_oracle_data_provider_settings(fv)?))
      "SybaseAseSettings" => Ok(DataProviderSettings.SybaseAseSettings(from_json_sybase_ase_data_provider_settings(fv)?))
      "MicrosoftSqlServerSettings" => Ok(DataProviderSettings.MicrosoftSqlServerSettings(from_json_microsoft_sql_server_data_provider_settings(fv)?))
      "DocDbSettings" => Ok(DataProviderSettings.DocDbSettings(from_json_doc_db_data_provider_settings(fv)?))
      "MariaDbSettings" => Ok(DataProviderSettings.MariaDbSettings(from_json_maria_db_data_provider_settings(fv)?))
      "IbmDb2LuwSettings" => Ok(DataProviderSettings.IbmDb2LuwSettings(from_json_ibm_db2_luw_data_provider_settings(fv)?))
      "IbmDb2zOsSettings" => Ok(DataProviderSettings.IbmDb2ZOsSettings(from_json_ibm_db2_z_os_data_provider_settings(fv)?))
      "MongoDbSettings" => Ok(DataProviderSettings.MongoDbSettings(from_json_mongo_db_data_provider_settings(fv)?))
      _ => Ok(DataProviderSettings.Unknown(k))
    }
  }
  Err("DataProviderSettings: no member set")
}

