///
/// Calls DescribeBotVersion until the BotVersionAvailable acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (10s) to `max_delay` (120s).
pub fn wait_until_bot_version_available(c: Client, input: DescribeBotVersionRequest, max_wait: Duration, min_delay: Duration = 10s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeBotVersionErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_bot_version(input) {
      Ok(out) => {
        let o = jmes_of_describe_bot_version_response(out)
        if state == "" && waiter.path_matches(o, "botStatus", "stringEquals", "Available") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "botStatus", "stringEquals", "Deleting") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "botStatus", "stringEquals", "Failed") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_bot_version(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "retry"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("BotVersionAvailable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

