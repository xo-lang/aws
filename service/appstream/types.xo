/// applications within a stack, based on user attributes. Entitlements
/// apply to SAML 2.0 federated user identities. WorkSpaces Applications
/// user pool and streaming URL users are entitled to all applications in a
/// stack. Entitlements don't apply to the desktop stream view application,
/// or to applications managed by a dynamic app provider using the Dynamic
/// Application Framework.
pub struct Entitlement {
  /// The name of the entitlement.
  pub name: Str? = None
  /// The name of the stack with which the entitlement is associated.
  pub stack_name: Str? = None
  /// The description of the entitlement.
  pub description: Str? = None
  /// Specifies whether all or selected apps are entitled.
  pub app_visibility: AppVisibility? = None
  /// The attributes of the entitlement.
  pub attributes: List[EntitlementAttribute]? = None
  /// The time when the entitlement was created.
  pub created_time: Time? = None
  /// The time when the entitlement was last modified.
  pub last_modified_time: Time? = None
}

/// The entitlement already exists.
pub struct EntitlementAlreadyExistsException {
  pub message: Str? = None
}

/// An attribute associated with an entitlement. Application entitlements
/// work by matching a supported SAML 2.0 attribute name to a value when a
/// user identity federates to a WorkSpaces Applications SAML application.
pub struct EntitlementAttribute {
  /// A supported AWS IAM SAML PrincipalTag attribute that is matched to the
  /// associated value when a user identity federates into a WorkSpaces
  /// Applications SAML application. The following are valid values: roles
  /// department organization groups title costCenter userType
  pub name: Str? = None
  /// A value that is matched to a supported SAML attribute name when a user
  /// identity federates into a WorkSpaces Applications SAML application.
  pub value: Str? = None
}

/// The entitlement can't be found.
pub struct EntitlementNotFoundException {
  pub message: Str? = None
}

/// The error details.
pub struct ErrorDetails {
  /// The error code.
  pub error_code: Str? = None
  /// The error message.
  pub error_message: Str? = None
}

pub struct ExpireSessionRequest {
  /// The identifier of the streaming session.
  pub session_id: Str? = None
}

pub struct ExpireSessionResult {
}

/// Information about an export image task, including its current state,
/// timestamps, and any error details.
pub struct ExportImageTask {
  /// The unique identifier for the export image task. Use this ID to track
  /// the task's progress and retrieve its details.
  pub task_id: Str? = None
  /// The ARN of the WorkSpaces Applications image being exported.
  pub image_arn: Str? = None
  /// The name of the EC2 AMI that will be created by this export task.
  pub ami_name: Str? = None
  /// The date and time when the export image task was created.
  pub created_date: Time? = None
  /// The description that will be applied to the exported EC2 AMI.
  pub ami_description: Str? = None
  /// The current state of the export image task, such as PENDING, RUNNING,
  /// COMPLETED, or FAILED.
  pub state: ExportImageTaskState? = None
  /// The ID of the EC2 AMI that was created by this export task. This field
  /// is only populated when the task completes successfully.
  pub ami_id: Str? = None
  /// The tags that will be applied to the exported EC2 AMI.
  pub tag_specifications: Map[Str, Str]? = None
  /// Details about any errors that occurred during the export process. This
  /// field is only populated when the task fails.
  pub error_details: List[ErrorDetails]? = None
}

pub enum ExportImageTaskState: Str {
  Exporting = "EXPORTING"
  Completed = "COMPLETED"
  Failed = "FAILED"
  TimedOut = "TIMED_OUT"
  Unknown(value: Str)
}

/// A filter for narrowing down the results when listing export image tasks.
/// Filters allow you to specify criteria such as task state or creation
/// date.
pub struct Filter {
  /// The name of the filter. Valid filter names depend on the operation being
  /// performed.
  pub name: Str? = None
  /// The values for the filter. Multiple values can be specified for a single
  /// filter name.
  pub values: List[Str]? = None
}

/// Describes a fleet.
pub struct Fleet {
  /// The Amazon Resource Name (ARN) for the fleet.
  pub arn: Str? = None
  /// The name of the fleet.
  pub name: Str? = None
  /// The fleet name to display.
  pub display_name: Str? = None
  /// The description to display.
  pub description: Str? = None
  /// The name of the image used to create the fleet.
  pub image_name: Str? = None
  /// The ARN for the public, private, or shared image.
  pub image_arn: Str? = None
  /// The instance type to use when launching fleet instances. The following
  /// instance types are available: stream.standard.small
  /// stream.standard.medium stream.standard.large stream.compute.large
  /// stream.compute.xlarge stream.compute.2xlarge stream.compute.4xlarge
  /// stream.compute.8xlarge stream.memory.large stream.memory.xlarge
  /// stream.memory.2xlarge stream.memory.4xlarge stream.memory.8xlarge
  /// stream.memory.z1d.large stream.memory.z1d.xlarge
  /// stream.memory.z1d.2xlarge stream.memory.z1d.3xlarge
  /// stream.memory.z1d.6xlarge stream.memory.z1d.12xlarge
  /// stream.graphics.g4dn.xlarge stream.graphics.g4dn.2xlarge
  /// stream.graphics.g4dn.4xlarge stream.graphics.g4dn.8xlarge
  /// stream.graphics.g4dn.12xlarge stream.graphics.g4dn.16xlarge
  /// stream.graphics.g5.xlarge stream.graphics.g5.2xlarge
  /// stream.graphics.g5.4xlarge stream.graphics.g5.8xlarge
  /// stream.graphics.g5.16xlarge stream.graphics.g5.12xlarge
  /// stream.graphics.g5.24xlarge stream.graphics.g6.xlarge
  /// stream.graphics.g6.2xlarge stream.graphics.g6.4xlarge
  /// stream.graphics.g6.8xlarge stream.graphics.g6.16xlarge
  /// stream.graphics.g6.12xlarge stream.graphics.g6.24xlarge
  /// stream.graphics.gr6.4xlarge stream.graphics.gr6.8xlarge
  /// stream.graphics.g6f.large stream.graphics.g6f.xlarge
  /// stream.graphics.g6f.2xlarge stream.graphics.g6f.4xlarge
  /// stream.graphics.gr6f.4xlarge
  pub instance_type: Str? = None
  /// The fleet type. ALWAYS_ON Provides users with instant-on access to their
  /// apps. You are charged for all running instances in your fleet, even if
  /// no users are streaming apps. ON_DEMAND Provide users with access to
  /// applications after they connect, which takes one to two minutes. You are
  /// charged for instance streaming when users are connected and a small
  /// hourly fee for instances that are not streaming apps.
  pub fleet_type: FleetType? = None
  /// The capacity status for the fleet.
  pub compute_capacity_status: ComputeCapacityStatus? = None
  /// The maximum amount of time that a streaming session can remain active,
  /// in seconds. If users are still connected to a streaming instance five
  /// minutes before this limit is reached, they are prompted to save any open
  /// documents before being disconnected. After this time elapses, the
  /// instance is terminated and replaced by a new instance. Specify a value
  /// between 600 and 360000.
  pub max_user_duration_in_seconds: Int? = None
  /// The amount of time that a streaming session remains active after users
  /// disconnect. If they try to reconnect to the streaming session after a
  /// disconnection or network interruption within this time interval, they
  /// are connected to their previous session. Otherwise, they are connected
  /// to a new session with a new streaming instance. Specify a value between
  /// 60 and 36000.
  pub disconnect_timeout_in_seconds: Int? = None
  /// The current state for the fleet.
  pub state: FleetState? = None
  /// The VPC configuration for the fleet.
  pub vpc_config: VpcConfig? = None
  /// The time the fleet was created.
  pub created_time: Time? = None
  /// The fleet errors.
  pub fleet_errors: List[FleetError]? = None
  /// Indicates whether default internet access is enabled for the fleet.
  pub enable_default_internet_access: Bool? = None
  /// The name of the directory and organizational unit (OU) to use to join
  /// the fleet to a Microsoft Active Directory domain.
  pub domain_join_info: DomainJoinInfo? = None
  /// The amount of time that users can be idle (inactive) before they are
  /// disconnected from their streaming session and the
  /// DisconnectTimeoutInSeconds time interval begins. Users are notified
  /// before they are disconnected due to inactivity. If users try to
  /// reconnect to the streaming session before the time interval specified in
  /// DisconnectTimeoutInSeconds elapses, they are connected to their previous
  /// session. Users are considered idle when they stop providing keyboard or
  /// mouse input during their streaming session. File uploads and downloads,
  /// audio in, audio out, and pixels changing do not qualify as user
  /// activity. If users continue to be idle after the time interval in
  /// IdleDisconnectTimeoutInSeconds elapses, they are disconnected. To
  /// prevent users from being disconnected due to inactivity, specify a value
  /// of 0. Otherwise, specify a value between 60 and 36000. The default value
  /// is 0. If you enable this feature, we recommend that you specify a value
  /// that corresponds exactly to a whole number of minutes (for example, 60,
  /// 120, and 180). If you don't do this, the value is rounded to the nearest
  /// minute. For example, if you specify a value of 70, users are
  /// disconnected after 1 minute of inactivity. If you specify a value that
  /// is at the midpoint between two different minutes, the value is rounded
  /// up. For example, if you specify a value of 90, users are disconnected
  /// after 2 minutes of inactivity.
  pub idle_disconnect_timeout_in_seconds: Int? = None
  /// The ARN of the IAM role that is applied to the fleet. To assume a role,
  /// the fleet instance calls the AWS Security Token Service (STS) AssumeRole
  /// API operation and passes the ARN of the role to use. The operation
  /// creates a new session with temporary credentials. WorkSpaces
  /// Applications retrieves the temporary credentials and creates the
  /// appstream_machine_role credential profile on the instance. For more
  /// information, see Using an IAM Role to Grant Permissions to Applications
  /// and Scripts Running on WorkSpaces Applications Streaming Instances in
  /// the Amazon WorkSpaces Applications Administration Guide .
  pub iam_role_arn: Str? = None
  /// The WorkSpaces Applications view that is displayed to your users when
  /// they stream from the fleet. When APP is specified, only the windows of
  /// applications opened by users display. When DESKTOP is specified, the
  /// standard desktop that is provided by the operating system displays. The
  /// default value is APP .
  pub stream_view: StreamView? = None
  /// The platform of the fleet.
  pub platform: PlatformType? = None
  /// The maximum number of concurrent sessions for the fleet.
  pub max_concurrent_sessions: Int? = None
  /// The USB device filter strings associated with the fleet.
  pub usb_device_filter_strings: List[Str]? = None
  /// The S3 location of the session scripts configuration zip file. This only
  /// applies to Elastic fleets.
  pub session_script_s3_location: S3Location? = None
  /// The maximum number of user sessions on an instance. This only applies to
  /// multi-session fleets.
  pub max_sessions_per_instance: Int? = None
  /// The current configuration of the root volume for fleet instances,
  /// including the storage size in GB.
  pub root_volume_config: VolumeConfig? = None
  /// Indicates whether Instance Metadata Service Version 1 (IMDSv1) is
  /// disabled for the fleet.
  pub disable_imdsv1: Bool? = None
}

