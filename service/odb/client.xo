fn json_of_source_configuration(v: SourceConfiguration) -> json.Value {
  match v {
    DatabaseClone(x) => json.Value.Object([("databaseClone", json_of_database_clone_configuration(x))])
    RestoreFromBackup(x) => json.Value.Object([("restoreFromBackup", json_of_restore_from_backup_configuration(x))])
    PointInTimeRestore(x) => json.Value.Object([("pointInTimeRestore", json_of_point_in_time_restore_configuration(x))])
    CrossRegionDataGuard(x) => json.Value.Object([("crossRegionDataGuard", json_of_cross_region_data_guard_configuration(x))])
    CrossRegionDisasterRecovery(x) => json.Value.Object([("crossRegionDisasterRecovery", json_of_cross_region_disaster_recovery_configuration(x))])
    CloneToRefreshable(x) => json.Value.Object([("cloneToRefreshable", json_of_clone_to_refreshable_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_source_configuration(v: json.Value) -> SourceConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "databaseClone" => Ok(SourceConfiguration.DatabaseClone(from_json_database_clone_configuration(fv)?))
      "restoreFromBackup" => Ok(SourceConfiguration.RestoreFromBackup(from_json_restore_from_backup_configuration(fv)?))
      "pointInTimeRestore" => Ok(SourceConfiguration.PointInTimeRestore(from_json_point_in_time_restore_configuration(fv)?))
      "crossRegionDataGuard" => Ok(SourceConfiguration.CrossRegionDataGuard(from_json_cross_region_data_guard_configuration(fv)?))
      "crossRegionDisasterRecovery" => Ok(SourceConfiguration.CrossRegionDisasterRecovery(from_json_cross_region_disaster_recovery_configuration(fv)?))
      "cloneToRefreshable" => Ok(SourceConfiguration.CloneToRefreshable(from_json_clone_to_refreshable_configuration(fv)?))
      _ => Ok(SourceConfiguration.Unknown(k))
    }
  }
  Err("SourceConfiguration: no member set")
}

