}

/// Represents the email message that you're sending. The Message object
/// consists of a subject line and a message body.
pub struct Message {
  /// The subject line of the email. The subject line can only contain 7-bit
  /// ASCII characters. However, you can specify non-ASCII characters in the
  /// subject line by using encoded-word syntax, as described in RFC 2047 .
  pub subject: Content? = None
  /// The body of the message. You can specify an HTML version of the message,
  /// a text-only version of the message, or both.
  pub body: Body? = None
  /// The list of message headers that will be added to the email message.
  pub headers: List[MessageHeader]? = None
  /// The List of attachments to include in your email. All recipients will
  /// receive the same attachments.
  pub attachments: List[Attachment]? = None
}

/// Contains the name and value of a message header that you add to an
/// email.
pub struct MessageHeader {
  /// The name of the message header. The message header name has to meet the
  /// following criteria: Can contain any printable ASCII character (33 - 126)
  /// except for colon (:). Can contain no more than 126 characters.
  pub name: Str? = None
  /// The value of the message header. The message header value has to meet
  /// the following criteria: Can contain any printable ASCII character. Can
  /// contain no more than 995 characters. The combined length of the header
  /// name and value must not exceed 996 characters.
  pub value: Str? = None
}

/// An object that contains filters applied when performing the Message
/// Insights export.
pub struct MessageInsightsDataSource {
  /// Represents the start date for the export interval as a timestamp. The
  /// start date is inclusive.
  pub start_date: Time? = None
  /// Represents the end date for the export interval as a timestamp. The end
  /// date is inclusive.
  pub end_date: Time? = None
  /// Filters for results to be included in the export file.
  pub include: MessageInsightsFilters? = None
  /// Filters for results to be excluded from the export file.
  pub exclude: MessageInsightsFilters? = None
  /// The maximum number of results. If you don't specify MaxResults , the
  /// export returns a maximum of 1,000 results.
  pub max_results: Int? = None
}

/// An object containing Message Insights filters. If you specify multiple
/// filters, the filters are joined by AND. If you specify multiple values
/// for a filter, the values are joined by OR. Filter values are
/// case-sensitive. FromEmailAddress , Destination , and Subject filters
/// support partial match. A partial match is performed by using the *
/// wildcard character placed at the beginning (suffix match), the end
/// (prefix match) or both ends of the string (contains match). In order to
/// match the literal characters * or \ , they must be escaped using the \
/// character. If no wildcard character is present, an exact match is
/// performed.
pub struct MessageInsightsFilters {
  /// The from address used to send the message.
  pub from_email_address: List[Str]? = None
  /// The recipient's email address.
  pub destination: List[Str]? = None
  /// The subject line of the message.
  pub subject: List[Str]? = None
  /// The recipient's ISP (e.g., Gmail , Yahoo , etc.).
  pub isp: List[Str]? = None
  /// The name of the tenant used when sending the message.
  pub tenant_name: List[Str]? = None
  /// The last delivery-related event for the email, where the ordering is as
  /// follows: SEND BOUNCE DELIVERY COMPLAINT .
  pub last_delivery_event: List[DeliveryEventType]? = None
  /// The last engagement-related event for the email, where the ordering is
  /// as follows: OPEN CLICK . Engagement events are only available if
  /// Engagement tracking is enabled.
  pub last_engagement_event: List[EngagementEventType]? = None
}

