// Signed messages of an input event stream: each event message is the
// payload of an envelope with `:date` and `:chunk-signature` headers,
// signed in a chain (sigv4.StreamSigner); an empty envelope ends it.

use github.com/xo-lang/aws/sigv4

/// The signed envelope of `inner` (an encoded message; empty to end the
/// stream) sent at `now`.
pub fn signed(var signer: sigv4.StreamSigner, inner: Bytes, now: Time) -> Bytes {
  let date = Header{name: ":date", value: HeaderValue.Timestamp(now.unix_millis())}
  let sig = signer.sign(encode_headers([date]), inner, now)
  encode(Message{headers: [date, Header{name: ":chunk-signature", value: HeaderValue.ByteArray(sig)}], payload: inner})
}
