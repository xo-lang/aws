fn json_of_participant(v: Participant) -> json.Value {
  match v {
    PartnerProfile(x) => json.Value.Object([("PartnerProfile", json_of_partner_profile_summary(x))])
    SellerProfile(x) => json.Value.Object([("SellerProfile", json_of_seller_profile_summary(x))])
    Account(x) => json.Value.Object([("Account", json_of_account_summary(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_participant(v: json.Value) -> Participant ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "PartnerProfile" => Ok(Participant.PartnerProfile(from_json_partner_profile_summary(fv)?))
      "SellerProfile" => Ok(Participant.SellerProfile(from_json_seller_profile_summary(fv)?))
      "Account" => Ok(Participant.Account(from_json_account_summary(fv)?))
      _ => Ok(Participant.Unknown(k))
    }
  }
  Err("Participant: no member set")
}

