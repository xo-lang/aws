/// The criteria that are evaluated to determine which AMIs are discoverable
/// and usable in your account for the specified Amazon Web Services Region.
/// For more information, see How Allowed AMIs works in the Amazon EC2 User
/// Guide .
pub struct ImageCriterion {
  /// The image providers whose images are allowed. Possible values: amazon :
  /// Allow AMIs created by Amazon or verified providers. aws-marketplace :
  /// Allow AMIs created by verified providers in the Amazon Web Services
  /// Marketplace. aws-backup-vault : Allow AMIs created by Amazon Web
  /// Services Backup. 12-digit account ID: Allow AMIs created by this
  /// account. One or more account IDs can be specified. none : Allow AMIs
  /// created by your own account only. Maximum: 200 values
  pub image_providers: List[Str]? = None
  /// The Amazon Web Services Marketplace product codes for allowed images.
  /// Length: 1-25 characters Valid characters: Letters ( A–Z, a–z ) and
  /// numbers ( 0–9 ) Maximum: 50 values
  pub marketplace_product_codes: List[Str]? = None
  /// The names of allowed images. Names can include wildcards ( ? and * ).
  /// Length: 1–128 characters. With ? , the minimum is 3 characters. Valid
  /// characters: Letters: A–Z, a–z Numbers: 0–9 Special characters: ( )
  /// [ ] . / - ' @ _ * ? Spaces Maximum: 50 values
  pub image_names: List[Str]? = None
  /// The maximum period since deprecation for allowed images.
  pub deprecation_time_condition: DeprecationTimeCondition? = None
  /// The maximum age for allowed images.
  pub creation_date_condition: CreationDateCondition? = None
  /// The watermark criteria that an AMI must match to be allowed. An AMI is
  /// allowed if it carries at least one watermark that satisfies an
  /// ImageWatermarkFilter. A watermark satisfies a filter when all specified
  /// fields in the ImageWatermarkFilter match the corresponding values on the
  /// watermark of the AMI. Maximum: 50 values
  pub image_watermarks: List[ImageWatermarkFilterResponse]? = None
  /// The Amazon Inspector scan-result criteria that an AMI must meet to be
  /// allowed. The criteria can limit the highest finding severity, the number
  /// of days since Amazon Inspector last scanned the AMI, and the number of
  /// days since Amazon Inspector reported a fix as available.
  pub scan_result_condition: ScanResultCondition? = None
