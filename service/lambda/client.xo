fn json_of_operation(v: Operation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.parent_id {
    fs.push(("ParentId", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.sub_type {
    fs.push(("SubType", json.Value.Str(x)))
  }
  if let Some(x) = v.start_timestamp {
    fs.push(("StartTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.end_timestamp {
    fs.push(("EndTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.execution_details {
    fs.push(("ExecutionDetails", json_of_execution_details(x)))
  }
  if let Some(x) = v.context_details {
    fs.push(("ContextDetails", json_of_context_details(x)))
  }
  if let Some(x) = v.step_details {
    fs.push(("StepDetails", json_of_step_details(x)))
  }
  if let Some(x) = v.wait_details {
    fs.push(("WaitDetails", json_of_wait_details(x)))
  }
  if let Some(x) = v.callback_details {
    fs.push(("CallbackDetails", json_of_callback_details(x)))
  }
  if let Some(x) = v.chained_invoke_details {
    fs.push(("ChainedInvokeDetails", json_of_chained_invoke_details(x)))
  }
  json.Value.Object(fs)
}

fn from_json_operation(v: json.Value) -> Operation ! Str {
  var out = Operation{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Id" => out.id = jsonv.read_str(fv)?
      "ParentId" => out.parent_id = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "Type" => out.type_value = OperationType.from(jsonv.read_str(fv)?)
      "SubType" => out.sub_type = jsonv.read_str(fv)?
