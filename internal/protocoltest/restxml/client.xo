fn xml_write_xml_map_with_xml_namespace_input_output_map(var w: xmlv.Writer, v: Map[Str, Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "K", k, [("xmlns", "https://the-key.example.com")])
    xmlv.elem(w, "V", item, [("xmlns", "https://the-value.example.com")])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_xml_map_with_xml_namespace_input_output_map(e: xml.Element) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "K") ?? ""
    if let Some(vc) = entry.child("V") {
      out.put(k, vc.text())
    }
  }
  Ok(out)
}

