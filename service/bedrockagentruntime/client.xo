/// The events of AgenticRetrieveStream, read as they arrive. `output` has the
/// response's other members; close the stream when done with it.
pub struct AgenticRetrieveStreamEvents {
  pub output: AgenticRetrieveStreamResponse
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
}

/// The next event, None at the end of the stream.
pub fn (var s: AgenticRetrieveStreamEvents) next() -> AgenticRetrieveStreamResponseOutput? ! AgenticRetrieveStreamResponseOutputErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(AgenticRetrieveStreamResponseOutputErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              continue
            }
            return match event_agentic_retrieve_stream_response_output(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(AgenticRetrieveStreamResponseOutputErr.Read(msg))
            }
          }
          "exception" => return Err(exception_agentic_retrieve_stream_response_output(m))
          _ => return Err(AgenticRetrieveStreamResponseOutputErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(AgenticRetrieveStreamResponseOutputErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(AgenticRetrieveStreamResponseOutputErr.Read(e.display()))
          }
        }
      }
    }
  }
  Ok(None)
}

/// Stops reading the stream.
pub fn (var s: AgenticRetrieveStreamEvents) close() {
  if !s.done {
    s.done = true
    s.body.close()
  }
}

/// Why reading a AgenticRetrieveStreamResponseOutput stream stopped.
pub enum AgenticRetrieveStreamResponseOutputErr {
  InternalServerException(e: InternalServerException)
  ValidationException(e: ValidationException)
  ResourceNotFoundException(e: ResourceNotFoundException)
  ServiceQuotaExceededException(e: ServiceQuotaExceededException)
  ThrottlingException(e: ThrottlingException)
  AccessDeniedException(e: AccessDeniedException)
  ConflictException(e: ConflictException)
  DependencyFailedException(e: DependencyFailedException)
  BadGatewayException(e: BadGatewayException)
  /// An error message, or an exception the model does not list.
  Api(e: aws.ApiError)
  /// The body could not be read or is not event stream messages.
  Read(msg: Str)
}

pub fn (e: AgenticRetrieveStreamResponseOutputErr) display() -> Str {
  match e {
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ServiceQuotaExceededException(x) => "ServiceQuotaExceededException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    DependencyFailedException(x) => "DependencyFailedException: ${x:?}"
    BadGatewayException(x) => "BadGatewayException: ${x:?}"
    Api(x) => x.display()
    Read(msg) => "event stream: ${msg}"
  }
}

fn event_agentic_retrieve_stream_response_output(t: Str, m: eventstream.Message) -> AgenticRetrieveStreamResponseOutput ! Str {
  match t {
    "result" => Ok(AgenticRetrieveStreamResponseOutput.Result(event_read_agentic_retrieve_result_event(m)?))
    "traceEvent" => Ok(AgenticRetrieveStreamResponseOutput.TraceEvent(event_read_agentic_retrieve_trace_event(m)?))
    "responseEvent" => Ok(AgenticRetrieveStreamResponseOutput.ResponseEvent(event_read_agentic_retrieve_response_event(m)?))
    _ => Ok(AgenticRetrieveStreamResponseOutput.Unknown(t))
  }
}

fn exception_agentic_retrieve_stream_response_output(m: eventstream.Message) -> AgenticRetrieveStreamResponseOutputErr {
  let t = m.header_str(":exception-type")
  match t {
    "internalServerException" => match exception_read_internal_server_exception(m.payload) {
      Ok(x) => AgenticRetrieveStreamResponseOutputErr.InternalServerException(x)
      Err(msg) => AgenticRetrieveStreamResponseOutputErr.Read(msg)
    }
    "validationException" => match exception_read_validation_exception(m.payload) {
      Ok(x) => AgenticRetrieveStreamResponseOutputErr.ValidationException(x)
      Err(msg) => AgenticRetrieveStreamResponseOutputErr.Read(msg)
    }
    "resourceNotFoundException" => match exception_read_resource_not_found_exception(m.payload) {
      Ok(x) => AgenticRetrieveStreamResponseOutputErr.ResourceNotFoundException(x)
      Err(msg) => AgenticRetrieveStreamResponseOutputErr.Read(msg)
    }
    "serviceQuotaExceededException" => match exception_read_service_quota_exceeded_exception(m.payload) {
      Ok(x) => AgenticRetrieveStreamResponseOutputErr.ServiceQuotaExceededException(x)
