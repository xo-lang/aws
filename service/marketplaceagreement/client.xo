  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(AcceptAgreementCancellationRequestErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_accept_agreement_cancellation_request_error(resp))
  }
  deserialize_accept_agreement_cancellation_request(resp) ?? e => Err(AcceptAgreementCancellationRequestErr.Deserialize(e))
}

