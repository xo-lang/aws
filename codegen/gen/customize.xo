// Service customizations the models do not describe, as aws-sdk-go-v2
// makes them by hand (docs/customizations.md): each keyed by the
// service's sdkId and applied in the generated serializer.

use std/json
use github.com/xo-lang/aws/codegen/model

/// The service's sdkId ("" when it has none).
pub fn sdk_id(g: G) -> Str {
  let svc = g.m.shapes.get(g.m.service) ?? return ""
  match model.trait_of(svc.traits, "aws.api#service") {
    Some(t) => match t.get("sdkId") {
      Some(json.Value.Str(x)) => x
      _ => ""
    }
    None => ""
  }
}

/// Input members replaced before serializing, as `field: expression`
/// over `given` (the caller's input):
/// - Route 53: ids given with their `/hostedzone/`, `/change/` or
///   `/delegationset/` prefix (as other calls return them) are cut to
///   the id (aws-sdk-go-v2's sanitizeURL);
/// - Glacier: the account id defaults to `-`, the credentials' account.
pub fn input_rewrites(g: G, input: model.Shape) -> List[Str] {
  let id = sdk_id(g)
  var out: List[Str] = []
  for m in input.members {
    let f = field_name(m.name)
    if id == "Route 53" {
      let t = model.name_of(m.target)
      if t == "ResourceId" || t == "DelegationSetId" || t == "ChangeId" {
        out.push("${f}: given.${f}.map(fn(v: Str) -> Str { v.split(\"/\").last() ?? v })")
      }
    }
    if id == "Glacier" && m.name == "accountId" {
      out.push("${f}: Some(given.${f} ?? \"-\")")
    }
  }
  out
}

/// Header lines added to every request of the service:
/// - API Gateway: `Accept: application/json` (it answers HAL otherwise);
/// - Glacier: `x-amz-glacier-version`, the API version.
pub fn service_headers(g: G) -> List[Str] {
  let id = sdk_id(g)
  if id == "API Gateway" {
    return ["  headers.push((\"Accept\", \"application/json\"))"]
  }
  if id == "Glacier" {
    let svc = g.m.shapes.get(g.m.service)
    let version = match svc {
      Some(s) => s.version
      None => ""
    }
    return ["  headers.push((\"x-amz-glacier-version\", ${lit_str(version)}))"]
  }
  []
}

/// Lines run once the body is built: Glacier's tree hash and the linear
/// SHA-256 of an upload, unless the caller gave the tree hash.
pub fn body_headers(g: G, input: model.Shape) -> List[Str] {
  if sdk_id(g) != "Glacier" {
    return []
  }
  var has_checksum = false
  var has_body = false
  for m in input.members {
    if m.name == "checksum" {
      has_checksum = true
    }
    if m.name == "body" {
      has_body = true
    }
  }
  if !has_checksum || !has_body {
    return []
  }
  [
    "  if !body.is_empty() && !headers.any(fn(h: (Str, Str)) -> Bool { h.0.to_lower() == \"x-amz-sha256-tree-hash\" }) {",
    "    headers.push((\"x-amz-sha256-tree-hash\", checksum.tree_hash(body)))",
    "  }",
    "  if !body.is_empty() {",
    "    headers.push((\"X-Amz-Content-Sha256\", crypto.digest(crypto.Hash.Sha256, body).to_hex()))",
    "  }",
  ]
}

/// The endpoint expression the request uses instead of `resolved`, for
/// an operation whose input names its own endpoint (Machine Learning's
/// Predict and its PredictEndpoint).
pub fn endpoint_rewrite(g: G, op: Str, input: model.Shape) -> Str? {
  if sdk_id(g) != "Machine Learning" || model.name_of(op) != "Predict" {
    return None
  }
  for m in input.members {
    if m.name == "PredictEndpoint" {
      return Some("if let Some(u) = given.${field_name(m.name)} { rest.parse_endpoint(u) ?? resolved } else { resolved }")
    }
  }
  None
}

/// Integrity checks of a response, as aws-sdk-go-v2 makes them by
/// default: lines run before deserializing (over `resp`) and after (over
/// `input` and `out`), each returning `<Op>Err.Deserialize` on a
/// mismatch.
/// - DynamoDB: the body's CRC32 against `X-Amz-Crc32` (its first field,
///   as Go's header.Get);
/// - SQS: each message body's MD5 against the MD5 the service computed
///   (SendMessage, SendMessageBatch, ReceiveMessage).
pub fn response_checks(g: G, op: Str, en: Str) -> (List[Str], List[Str]) {
  let id = sdk_id(g)
  let name = model.name_of(op)
  if id == "DynamoDB" {
    return ([
      "  if let Some(want) = resp.header_values(\"X-Amz-Crc32\").first() {",
      "    let got = crc32.checksum(resp.body)",
      "    if Int.parse(want) != Some(got) {",
      "      return Err(${en}.Deserialize(\"response CRC32 \${got} does not match X-Amz-Crc32 \${want}\"))",
      "    }",
      "  }",
    ], [])
  }
  if id != "SQS" {
    return ([], [])
  }
  let md5 = "crypto.digest(crypto.Hash.Md5, b.bytes()).to_hex()"
  if name == "SendMessage" {
    return ([], [
      "  if let Some(b) = input.message_body {",
      "    if let Some(want) = out.md5_of_message_body {",
      "      if ${md5} != want {",
      "        return Err(${en}.Deserialize(\"the MD5 of the message body does not match the service's \${want}\"))",
      "      }",
      "    }",
      "  }",
    ])
  }
  if name == "SendMessageBatch" {
    return ([], [
      "  for r in out.successful ?? [] {",
      "    let sent = (input.entries ?? []).find(fn(e: SendMessageBatchRequestEntry) -> Bool { e.id == r.id })",
      "    if let Some(e) = sent {",
      "      if let Some(b) = e.message_body {",
      "        if let Some(want) = r.md5_of_message_body {",
      "          if ${md5} != want {",
      "            return Err(${en}.Deserialize(\"the MD5 of batch entry \${r.id ?? \"\"}'s body does not match the service's \${want}\"))",
      "          }",
      "        }",
      "      }",
      "    }",
      "  }",
    ])
  }
  if name == "ReceiveMessage" {
    return ([], [
      "  for m in out.messages ?? [] {",
      "    if let Some(b) = m.body {",
      "      if let Some(want) = m.md5_of_body {",
      "        if ${md5} != want {",
      "          return Err(${en}.Deserialize(\"the MD5 of message \${m.message_id ?? \"\"}'s body does not match the service's \${want}\"))",
      "        }",
      "      }",
      "    }",
      "  }",
    ])
  }
  ([], [])
}

/// Operations that fill in a cross-region presigned URL (aws-sdk-go-v2's
/// PresignURLAutoFill): (service shape id, operation, presigned URL
/// member).
const PRESIGN_AUTOFILL: List[(Str, Str, Str)] = [
  ("com.amazonaws.rds#AmazonRDSv19", "CopyDBSnapshot", "PreSignedUrl"),
  ("com.amazonaws.rds#AmazonRDSv19", "CreateDBInstanceReadReplica", "PreSignedUrl"),
  ("com.amazonaws.rds#AmazonRDSv19", "CopyDBClusterSnapshot", "PreSignedUrl"),
  ("com.amazonaws.rds#AmazonRDSv19", "CreateDBCluster", "PreSignedUrl"),
  ("com.amazonaws.neptune#AmazonRDSv19", "CopyDBClusterSnapshot", "PreSignedUrl"),
  ("com.amazonaws.neptune#AmazonRDSv19", "CreateDBCluster", "PreSignedUrl"),
  ("com.amazonaws.docdb#AmazonRDSv19", "CopyDBClusterSnapshot", "PreSignedUrl"),
  ("com.amazonaws.docdb#AmazonRDSv19", "CreateDBCluster", "PreSignedUrl"),
  ("com.amazonaws.ec2#AmazonEC2", "CopySnapshot", "PresignedUrl"),
]

/// The presigned URL member of an operation that fills it in.
pub fn presign_autofill(g: G, op: Str) -> Str? {
  for (svc, name, member) in PRESIGN_AUTOFILL {
    if svc == g.m.service && name == model.name_of(op) {
      return Some(member)
    }
  }
  None
}

/// Fields a structure gets beyond its model: the source region of an
/// input whose operation fills in a cross-region presigned URL, where
/// the model has none (RDS, Neptune, DocumentDB; EC2 models it).
/// The member of operation input `s` that is its streaming blob payload
/// (S3 PutObject's Body), sent as it is read when the caller gives an
/// `aws.Upload` (decision 0009). None for query and JSON RPC protocols,
/// which have no payload binding.
pub fn streaming_payload(g: G, s: model.Shape) -> model.Member? {
  if g.query || g.rpc != "" {
    return None
  }
  if !model.operations(g.m).any(fn(op: Str) -> Bool { shape_of(g, op).input == s.id }) {
    return None
  }
  s.members.find(fn(m: model.Member) -> Bool {
    let t = shape_of(g, m.target)
    has(m.traits, "httpPayload") && t.kind is model.Kind.Blob && has(t.traits, "streaming")
  })
}

pub fn extra_fields(g: G, s: model.Shape) -> List[Str] {
  if let Some(m) = streaming_payload(g, s) {
    let f = field_name(m.name)
    return [
      "  /// `${f}` sent as it is read (`aws.upload_file`, `aws.upload_reader`),",
      "  /// in place of `${f}`: a large body without holding it in memory.",
      "  pub ${f}_stream: aws.Upload? = None",
    ]
  }
  for op in model.operations(g.m) {
    let o = shape_of(g, op)
    if o.input == s.id && presign_autofill(g, op).is_some() {
      if s.members.any(fn(m: model.Member) -> Bool { m.name == "SourceRegion" }) {
        return []
      }
      return [
        "  /// The region the source lives in: when set and the presigned URL is",
        "  /// not, the SDK presigns this call in that region and sends it as the",
        "  /// presigned URL (as the other AWS SDKs do). Not sent itself.",
        "  pub source_region: Str? = None",
      ]
    }
  }
  []
}

/// `presigned_url_<op>`: the input with its cross-region presigned URL
/// filled in, when `source_region` is set and the URL is not: the same
/// call routed and serialized for the source region, with
/// DestinationRegion set to this client's region, presigned as a GET for
/// 15 minutes.
pub fn emit_presign_autofill(g: G, op: Str, var out: List[Str]) {
  let member = presign_autofill(g, op) ?? return
  let name = op_name(op)
  let s = shape_of(g, op)
  let in_t = xo_type(g, s.input)
  let url_f = field_name(member)
  let input = shape_of(g, s.input)
  let modeled_dest = input.members.any(fn(m: model.Member) -> Bool { m.name == "DestinationRegion" })
  out.push("/// ${model.name_of(op)}'s input with its presigned URL filled in from `source_region`.")
  out.push("fn (c: Client) presigned_url_${name}(input: ${in_t}) -> ${in_t} ! Str uses (net.dial, clock, rand) {")
  out.push("  let source = input.source_region ?? return Ok(input)")
  out.push("  if input.${url_f}.is_some() || source == c.region {")
  out.push("    return Ok(input)")
  out.push("  }")
  out.push("  var params = c.params")
  out.push("  params.region = source")
  out.push("  let (ep, routed, _) = c.route(endpoint_params_${name}(params, input))?")
  out.push("  // signed for the source region (the route falls back to the client's)")
  out.push("  let signing = routed with {region: source}")
  if modeled_dest {
    out.push("  var req = serialize_${name}(ep, input with {destination_region: c.region}, \"\")?")
    out.push("  var form = req.body.to_str() ?? \"\"")
  } else {
    out.push("  var req = serialize_${name}(ep, input, \"\")?")
    out.push("  var form = \"\${req.body.to_str() ?? \"\"}&DestinationRegion=\${query.escape(c.region)}\"")
  }
  out.push("  req = req with {")
  out.push("    method: \"GET\",")
  out.push("    query: form,")
  out.push("    body: b\"\",")
  out.push("    headers: req.headers.filter(fn(h: (Str, Str)) -> Bool { h.0.to_lower() != \"content-type\" }),")
  out.push("  }")
  out.push("  let p = transport.presign(c.transport, req, signing, 15m) ?? e => return Err(\"presigning in \${source}: \${e:?}\")")
  out.push("  Ok(input with {${url_f}: p.url})")
  out.push("}")
  out.push("")
}

/// The input member that asks for response checksums
/// (`requestValidationModeMember` of `aws.protocols#httpChecksum`: S3
/// GetObject's ChecksumMode), and the header it is sent in.
pub fn validation_member(g: G, op: Str) -> (Str, Str)? {
  let hc = model.trait_of(shape_of(g, op).traits, "aws.protocols#httpChecksum") ?? return None
  let name = match hc.get("requestValidationModeMember") {
    Some(json.Value.Str(m)) => m
    _ => return None
  }
  for m in shape_of(g, shape_of(g, op).input).members {
    if m.name == name {
      if let Some(json.Value.Str(h)) = model.trait_of(m.traits, "httpHeader") {
        return Some((name, h))
      }
    }
  }
  None
}

/// Whether any operation of the service can validate response checksums.
pub fn validates_responses(g: G) -> Bool {
  model.operations(g.m).any(fn(op: Str) -> Bool { validation_member(g, op).is_some() })
}

/// The long polling operations (aws-sdk-go-v2's SetLongPollingContext).
const LONG_POLL: List[(Str, Str)] = [
  ("SQS", "ReceiveMessage"),
  ("SFN", "GetActivityTask"),
  ("SWF", "PollForActivityTask"),
  ("SWF", "PollForDecisionTask"),
]

pub fn long_poll(g: G, op: Str) -> Bool {
  LONG_POLL.contains((sdk_id(g), model.name_of(op)))
}

/// A paginator aws-sdk-go-v2 writes by hand (its handwritten_paginators.go)
/// because the operation's tokens do not fit the paginated trait: several
/// markers, a truncation flag, or a token taken from the page's items.
pub struct HandPager {
  pub sdk: Str
  pub op: Str
  /// Whether there is another page, over the page `out`.
  pub more: Str
  /// The input fields the next page sends, over `out`.
  pub next: List[Str]
  pub doc: Str
}

pub const HAND_PAGERS: List[HandPager] = [
  HandPager{sdk: "S3", op: "ListObjectVersions", more: "out.is_truncated == Some(true)",
    next: ["p.input.key_marker = out.next_key_marker", "p.input.version_id_marker = out.next_version_id_marker"],
    doc: "NextKeyMarker and NextVersionIdMarker as KeyMarker and VersionIdMarker, while IsTruncated"},
  HandPager{sdk: "S3", op: "ListMultipartUploads", more: "out.is_truncated == Some(true)",
    next: ["p.input.key_marker = out.next_key_marker", "p.input.upload_id_marker = out.next_upload_id_marker"],
    doc: "NextKeyMarker and NextUploadIdMarker as KeyMarker and UploadIdMarker, while IsTruncated"},
  HandPager{sdk: "Route 53", op: "ListResourceRecordSets", more: "out.is_truncated == Some(true)",
    next: ["p.input.start_record_name = out.next_record_name", "p.input.start_record_identifier = out.next_record_identifier", "p.input.start_record_type = out.next_record_type"],
    doc: "NextRecordName, NextRecordIdentifier and NextRecordType as StartRecordName, StartRecordIdentifier and StartRecordType, while IsTruncated"},
  HandPager{sdk: "DynamoDB", op: "BatchGetItem", more: "out.unprocessed_keys.map(fn(m: Map[Str, KeysAndAttributes]) -> Bool { !m.is_empty() }) == Some(true)",
    next: ["p.input.request_items = out.unprocessed_keys"],
    doc: "UnprocessedKeys as RequestItems, until none are left"},
  HandPager{sdk: "Kinesis", op: "DescribeStream", more: "out.stream_description.map(fn(d: StreamDescription) -> Bool { d.has_more_shards == Some(true) && !(d.shards ?? []).is_empty() }) == Some(true)",
    next: ["if let Some(d) = out.stream_description {", "  let shards = d.shards ?? []", "  p.input.exclusive_start_shard_id = shards[shards.len() - 1].shard_id", "}"],
    doc: "last shard's ShardId as ExclusiveStartShardId, while HasMoreShards"},
  HandPager{sdk: "AmplifyBackend", op: "ListBackendJobs", more: "(out.next_token ?? \"\") != \"\"",
    next: ["p.input.next_token = out.next_token"],
    doc: "NextToken as NextToken (the model has no paginated trait)"},
]

/// For an operation that takes a checksum but does not require one
/// (`requestAlgorithmMember` without `requestChecksumRequired`): the
/// algorithm member and the members that already carry a checksum
/// (`Checksum<ALG>` values, `ContentMD5`), any of which leaves the
/// default off.
pub fn default_checksum(g: G, op: Str) -> (Str, List[Str])? {
  let hc = model.trait_of(shape_of(g, op).traits, "aws.protocols#httpChecksum") ?? return None
  if hc.get("requestChecksumRequired") == Some(json.Value.Bool(true)) {
    return None
  }
  let alg = match hc.get("requestAlgorithmMember") {
    Some(json.Value.Str(m)) => m
    _ => return None
  }
  var given: List[Str] = []
  for m in shape_of(g, shape_of(g, op).input).members {
    if m.name == "ContentMD5" || (m.name.starts_with("Checksum") && m.name != alg && m.name != "ChecksumType" && m.name != "ChecksumMode") {
      given.push(m.name)
    }
  }
  Some((alg, given))
}

/// Whether any operation of the service has a default request checksum.
pub fn calculates_checksums(g: G) -> Bool {
  model.operations(g.m).any(fn(op: Str) -> Bool { default_checksum(g, op).is_some() })
}
