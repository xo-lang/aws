/// Describes a recommendation.
pub struct Recommendation {
  /// The ID for the recommendation.
  pub recommendation_id: Str? = None
  /// The account to which the recommendation applies.
  pub account_id: Str? = None
  /// The Amazon Web Services Region of the resource.
  pub region: Str? = None
  /// The resource ID for the recommendation.
  pub resource_id: Str? = None
  /// The Amazon Resource Name (ARN) for the recommendation.
  pub resource_arn: Str? = None
  /// The current resource type.
  pub current_resource_type: Str? = None
  /// The recommended resource type.
  pub recommended_resource_type: Str? = None
  /// The estimated monthly savings amount for the recommendation.
  pub estimated_monthly_savings: Float? = None
  /// The estimated savings percentage relative to the total cost over the
  /// cost calculation lookback period.
  pub estimated_savings_percentage: Float? = None
  /// The estimated monthly cost of the current resource. For Reserved
  /// Instances and Savings Plans, it refers to the cost for eligible usage.
  pub estimated_monthly_cost: Float? = None
  /// The currency code used for the recommendation.
  pub currency_code: Str? = None
  /// The effort required to implement the recommendation.
  pub implementation_effort: Str? = None
  /// Whether or not implementing the recommendation requires a restart.
  pub restart_needed: Bool? = None
  /// The type of tasks that can be carried out by this action.
  pub action_type: Str? = None
  /// Whether or not implementing the recommendation can be rolled back.
  pub rollback_possible: Bool? = None
  /// Describes the current resource.
  pub current_resource_summary: Str? = None
  /// Describes the recommended resource.
  pub recommended_resource_summary: Str? = None
  /// The time when the recommendation was last generated.
  pub last_refresh_timestamp: Time? = None
  /// The lookback period that's used to generate the recommendation.
  pub recommendation_lookback_period_in_days: Int? = None
  /// The source of the recommendation.
  pub source: Source? = None
  /// A list of tags assigned to the recommendation.
  pub tags: List[Tag]? = None
}

/// The summary of rightsizing recommendations, including de-duped savings
/// from all types of recommendations.
pub struct RecommendationSummary {
  /// The grouping of recommendations.
  pub group: Str? = None
  /// The estimated total savings resulting from modifications, on a monthly
  /// basis.
  pub estimated_monthly_savings: Float? = None
  /// The total number of instance recommendations.
  pub recommendation_count: Int? = None
}

