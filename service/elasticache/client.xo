fn xml_write_update_action(var w: xmlv.Writer, v: UpdateAction, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.replication_group_id {
    xmlv.elem(w, "ReplicationGroupId", x, [])
  }
  if let Some(x) = v.cache_cluster_id {
    xmlv.elem(w, "CacheClusterId", x, [])
  }
  if let Some(x) = v.service_update_name {
    xmlv.elem(w, "ServiceUpdateName", x, [])
  }
  if let Some(x) = v.service_update_release_date {
    xmlv.elem(w, "ServiceUpdateReleaseDate", rest.date_time(x), [])
  }
  if let Some(x) = v.service_update_severity {
    xmlv.elem(w, "ServiceUpdateSeverity", x.value(), [])
  }
  if let Some(x) = v.service_update_status {
    xmlv.elem(w, "ServiceUpdateStatus", x.value(), [])
  }
  if let Some(x) = v.service_update_recommended_apply_by_date {
    xmlv.elem(w, "ServiceUpdateRecommendedApplyByDate", rest.date_time(x), [])
  }
  if let Some(x) = v.service_update_type {
    xmlv.elem(w, "ServiceUpdateType", x.value(), [])
  }
  if let Some(x) = v.update_action_available_date {
    xmlv.elem(w, "UpdateActionAvailableDate", rest.date_time(x), [])
  }
  if let Some(x) = v.update_action_status {
    xmlv.elem(w, "UpdateActionStatus", x.value(), [])
  }
  if let Some(x) = v.nodes_updated {
    xmlv.elem(w, "NodesUpdated", x, [])
  }
  if let Some(x) = v.update_action_status_modified_date {
    xmlv.elem(w, "UpdateActionStatusModifiedDate", rest.date_time(x), [])
  }
  if let Some(x) = v.sla_met {
    xmlv.elem(w, "SlaMet", x.value(), [])
  }
  if let Some(x) = v.node_group_update_status {
    xml_write_node_group_update_status_list(w, x, "NodeGroupUpdateStatus", [])
  }
  if let Some(x) = v.cache_node_update_status {
    xml_write_cache_node_update_status_list(w, x, "CacheNodeUpdateStatus", [])
  }
  if let Some(x) = v.estimated_update_time {
    xmlv.elem(w, "EstimatedUpdateTime", x, [])
  }
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_update_action(e: xml.Element) -> UpdateAction ! Str {
  var out = UpdateAction{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ReplicationGroupId" => out.replication_group_id = c.text()
      "CacheClusterId" => out.cache_cluster_id = c.text()
      "ServiceUpdateName" => out.service_update_name = c.text()
      "ServiceUpdateReleaseDate" => out.service_update_release_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ServiceUpdateSeverity" => out.service_update_severity = ServiceUpdateSeverity.from(c.text())
      "ServiceUpdateStatus" => out.service_update_status = ServiceUpdateStatus.from(c.text())
      "ServiceUpdateRecommendedApplyByDate" => out.service_update_recommended_apply_by_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ServiceUpdateType" => out.service_update_type = ServiceUpdateType.from(c.text())
      "UpdateActionAvailableDate" => out.update_action_available_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UpdateActionStatus" => out.update_action_status = UpdateActionStatus.from(c.text())
      "NodesUpdated" => out.nodes_updated = c.text()
      "UpdateActionStatusModifiedDate" => out.update_action_status_modified_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SlaMet" => out.sla_met = SlaMet.from(c.text())
      "NodeGroupUpdateStatus" => out.node_group_update_status = xml_read_node_group_update_status_list(c)?
      "CacheNodeUpdateStatus" => out.cache_node_update_status = xml_read_cache_node_update_status_list(c)?
      "EstimatedUpdateTime" => out.estimated_update_time = c.text()
      "Engine" => out.engine = c.text()
      _ => {}
    }
  }
  Ok(out)
}

