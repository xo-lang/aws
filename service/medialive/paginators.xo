/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: ListSdiSourcesPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: ListSdiSourcesPaginator) next_page() -> ListSdiSourcesResponse ! ListSdiSourcesErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_sdi_sources(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}

/// The pages of ListSignalMaps. Each `next_page` sends the input with
/// the previous page's NextToken as its
/// NextToken.
pub struct ListSignalMapsPaginator {
  client: Client
  input: ListSignalMapsRequest
  first: Bool = true
  more: Bool = true
}

pub fn new_list_signal_maps_paginator(c: Client, input: ListSignalMapsRequest) -> ListSignalMapsPaginator {
  ListSignalMapsPaginator{client: c, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: ListSignalMapsPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: ListSignalMapsPaginator) next_page() -> ListSignalMapsResponse ! ListSignalMapsErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_signal_maps(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
