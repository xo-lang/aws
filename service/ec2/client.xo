}

fn xml_read_modify_vpn_tunnel_options_specification(e: xml.Element) -> ModifyVpnTunnelOptionsSpecification ! Str {
  var out = ModifyVpnTunnelOptionsSpecification{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TunnelInsideCidr" => out.tunnel_inside_cidr = c.text()
      "TunnelInsideIpv6Cidr" => out.tunnel_inside_ipv6_cidr = c.text()
      "PreSharedKey" => out.pre_shared_key = c.text()
      "Phase1LifetimeSeconds" => out.phase1_lifetime_seconds = xmlv.read_int(c.text())?
      "Phase2LifetimeSeconds" => out.phase2_lifetime_seconds = xmlv.read_int(c.text())?
      "RekeyMarginTimeSeconds" => out.rekey_margin_time_seconds = xmlv.read_int(c.text())?
      "RekeyFuzzPercentage" => out.rekey_fuzz_percentage = xmlv.read_int(c.text())?
      "ReplayWindowSize" => out.replay_window_size = xmlv.read_int(c.text())?
      "DPDTimeoutSeconds" => out.dpd_timeout_seconds = xmlv.read_int(c.text())?
      "DPDTimeoutAction" => out.dpd_timeout_action = c.text()
      "Phase1EncryptionAlgorithm" => out.phase1_encryption_algorithms = xml_read_phase1_encryption_algorithms_request_list(c)?
      "Phase2EncryptionAlgorithm" => out.phase2_encryption_algorithms = xml_read_phase2_encryption_algorithms_request_list(c)?
      "Phase1IntegrityAlgorithm" => out.phase1_integrity_algorithms = xml_read_phase1_integrity_algorithms_request_list(c)?
      "Phase2IntegrityAlgorithm" => out.phase2_integrity_algorithms = xml_read_phase2_integrity_algorithms_request_list(c)?
      "Phase1DHGroupNumber" => out.phase1_dh_group_numbers = xml_read_phase1_dh_group_numbers_request_list(c)?
      "Phase2DHGroupNumber" => out.phase2_dh_group_numbers = xml_read_phase2_dh_group_numbers_request_list(c)?
      "IKEVersion" => out.ike_versions = xml_read_ike_versions_request_list(c)?
      "StartupAction" => out.startup_action = c.text()
      "LogOptions" => out.log_options = xml_read_vpn_tunnel_log_options_specification(c)?
      "EnableTunnelLifecycleControl" => out.enable_tunnel_lifecycle_control = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

