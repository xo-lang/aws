fn json_of_tls_encryption_configuration(v: TlsEncryptionConfiguration) -> json.Value {
  match v {
    Public(x) => json.Value.Object([("public", json_of_public_tls_encryption_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_tls_encryption_configuration(v: json.Value) -> TlsEncryptionConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "public" => Ok(TlsEncryptionConfiguration.Public(from_json_public_tls_encryption_configuration(fv)?))
      _ => Ok(TlsEncryptionConfiguration.Unknown(k))
    }
  }
  Err("TlsEncryptionConfiguration: no member set")
}

