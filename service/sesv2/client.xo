fn json_of_signing_scheme(v: SigningScheme) -> json.Value {
  match v {
    DefaultScheme(x) => json.Value.Object([("DefaultScheme", json_of_default_signing_scheme(x))])
    SmimeScheme(x) => json.Value.Object([("SmimeScheme", json_of_smime_signing_scheme(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_signing_scheme(v: json.Value) -> SigningScheme ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "DefaultScheme" => Ok(SigningScheme.DefaultScheme(from_json_default_signing_scheme(fv)?))
      "SmimeScheme" => Ok(SigningScheme.SmimeScheme(from_json_smime_signing_scheme(fv)?))
      _ => Ok(SigningScheme.Unknown(k))
    }
  }
  Err("SigningScheme: no member set")
}

