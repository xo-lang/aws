  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateOrganizationConfigurationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_organization_configuration_error(resp))
  }
  deserialize_update_organization_configuration(resp) ?? e => Err(UpdateOrganizationConfigurationErr.Deserialize(e))
