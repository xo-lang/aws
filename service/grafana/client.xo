fn json_of_idp_metadata(v: IdpMetadata) -> json.Value {
  match v {
    Url(x) => json.Value.Object([("url", json.Value.Str(x))])
    Xml(x) => json.Value.Object([("xml", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_idp_metadata(v: json.Value) -> IdpMetadata ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "url" => Ok(IdpMetadata.Url(jsonv.read_str(fv)?))
      "xml" => Ok(IdpMetadata.Xml(jsonv.read_str(fv)?))
      _ => Ok(IdpMetadata.Unknown(k))
    }
  }
  Err("IdpMetadata: no member set")
}

