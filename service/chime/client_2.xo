  let (ep, signing, extra) = c.route(endpoint_params_update_user(c.params, input)) ?? e => return Err(UpdateUserErr.InvalidInput(e))
  var req = serialize_update_user(ep, input, "") ?? e => return Err(UpdateUserErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateUserErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_user_error(resp))
  }
  deserialize_update_user(resp) ?? e => Err(UpdateUserErr.Deserialize(e))
}

