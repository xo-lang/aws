  /// "\u0041" or "\u005A". The following regular expression operators are not
  /// supported: Infinite repeaters: *, +, or {x,} with no upper bound. Wild
  /// card (.)
  pub pattern: Str? = None
}

pub enum SlotValueSelectionStrategy: Str {
  OriginalValue = "ORIGINAL_VALUE"
  TopResolution = "TOP_RESOLUTION"
  Unknown(value: Str)
}

pub enum SortOrder: Str {
  Ascending = "ASCENDING"
  Descending = "DESCENDING"
  Unknown(value: Str)
