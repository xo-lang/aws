fn json_of_general_name(v: GeneralName) -> json.Value {
  match v {
    DirectoryName(x) => json.Value.Object([("DirectoryName", json_of_distinguished_name(x))])
    DnsName(x) => json.Value.Object([("DnsName", json.Value.Str(x))])
    IpAddress(x) => json.Value.Object([("IpAddress", json.Value.Str(x))])
    OtherName(x) => json.Value.Object([("OtherName", json_of_other_name(x))])
    RegisteredId(x) => json.Value.Object([("RegisteredId", json.Value.Str(x))])
    Rfc822Name(x) => json.Value.Object([("Rfc822Name", json.Value.Str(x))])
    UniformResourceIdentifier(x) => json.Value.Object([("UniformResourceIdentifier", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_general_name(v: json.Value) -> GeneralName ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "DirectoryName" => Ok(GeneralName.DirectoryName(from_json_distinguished_name(fv)?))
      "DnsName" => Ok(GeneralName.DnsName(jsonv.read_str(fv)?))
      "IpAddress" => Ok(GeneralName.IpAddress(jsonv.read_str(fv)?))
      "OtherName" => Ok(GeneralName.OtherName(from_json_other_name(fv)?))
      "RegisteredId" => Ok(GeneralName.RegisteredId(jsonv.read_str(fv)?))
      "Rfc822Name" => Ok(GeneralName.Rfc822Name(jsonv.read_str(fv)?))
      "UniformResourceIdentifier" => Ok(GeneralName.UniformResourceIdentifier(jsonv.read_str(fv)?))
      _ => Ok(GeneralName.Unknown(k))
    }
  }
  Err("GeneralName: no member set")
}

fn json_of_general_name_list(v: List[GeneralName]) -> json.Value {
  json.Value.List(v.map(fn(x: GeneralName) -> json.Value { json_of_general_name(x) }))
}

fn from_json_general_name_list(v: json.Value) -> List[GeneralName] ! Str {
