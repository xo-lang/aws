fn xml_write_receipt_rule(var w: xmlv.Writer, v: ReceiptRule, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.enabled {
    xmlv.elem(w, "Enabled", "${x}", [])
  }
  if let Some(x) = v.tls_policy {
    xmlv.elem(w, "TlsPolicy", x.value(), [])
  }
  if let Some(x) = v.recipients {
    xml_write_recipients_list(w, x, "Recipients", [])
  }
  if let Some(x) = v.actions {
    xml_write_receipt_actions_list(w, x, "Actions", [])
  }
  if let Some(x) = v.scan_enabled {
    xmlv.elem(w, "ScanEnabled", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_receipt_rule(e: xml.Element) -> ReceiptRule ! Str {
  var out = ReceiptRule{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Name" => out.name = c.text()
      "Enabled" => out.enabled = xmlv.read_bool(c.text())?
      "TlsPolicy" => out.tls_policy = TlsPolicy.from(c.text())
      "Recipients" => out.recipients = xml_read_recipients_list(c)?
      "Actions" => out.actions = xml_read_receipt_actions_list(c)?
      "ScanEnabled" => out.scan_enabled = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

