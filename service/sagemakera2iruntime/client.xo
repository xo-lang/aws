      Err(msg) => return StopHumanLoopErr.Deserialize(msg)
    }
    _ => {}
  }
  StopHumanLoopErr.Api(restjson.api_error(resp, body))
}

/// Stops the specified human loop.
pub fn (c: Client) stop_human_loop(input: StopHumanLoopRequest) -> StopHumanLoopResponse ! StopHumanLoopErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_stop_human_loop(c.params, input)) ?? e => return Err(StopHumanLoopErr.InvalidInput(e))
  var req = serialize_stop_human_loop(ep, input, "") ?? e => return Err(StopHumanLoopErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(StopHumanLoopErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_stop_human_loop_error(resp))
  }
  deserialize_stop_human_loop(resp) ?? e => Err(StopHumanLoopErr.Deserialize(e))
}
