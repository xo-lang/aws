fn json_of_task(v: Task) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.agent_space_id {
    fs.push(("agentSpaceId", json.Value.Str(x)))
  }
  if let Some(x) = v.task_id {
    fs.push(("taskId", json.Value.Str(x)))
  }
  if let Some(x) = v.execution_id {
    fs.push(("executionId", json.Value.Str(x)))
  }
  if let Some(x) = v.title {
    fs.push(("title", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.reference {
    fs.push(("reference", json_of_reference_output(x)))
  }
  if let Some(x) = v.task_type {
    fs.push(("taskType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.priority {
    fs.push(("priority", json.Value.Str(x.value())))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("updatedAt", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.version {
    fs.push(("version", json.Value.Int(x)))
  }
  if let Some(x) = v.support_metadata {
    fs.push(("supportMetadata", x))
  }
  if let Some(x) = v.metadata {
    fs.push(("metadata", x))
  }
  if let Some(x) = v.primary_task_id {
    fs.push(("primaryTaskId", json.Value.Str(x)))
  }
  if let Some(x) = v.status_reason {
    fs.push(("statusReason", json.Value.Str(x)))
  }
  if let Some(x) = v.has_linked_tasks {
    fs.push(("hasLinkedTasks", json.Value.Bool(x)))
  }
  json.Value.Object(fs)
}

fn from_json_task(v: json.Value) -> Task ! Str {
  var out = Task{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "agentSpaceId" => out.agent_space_id = jsonv.read_str(fv)?
      "taskId" => out.task_id = jsonv.read_str(fv)?
      "executionId" => out.execution_id = jsonv.read_str(fv)?
      "title" => out.title = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "reference" => out.reference = from_json_reference_output(fv)?
      "taskType" => out.task_type = TaskType.from(jsonv.read_str(fv)?)
      "priority" => out.priority = Priority.from(jsonv.read_str(fv)?)
      "status" => out.status = TaskStatus.from(jsonv.read_str(fv)?)
      "createdAt" => out.created_at = jsonv.read_time(fv, "date-time")?
      "updatedAt" => out.updated_at = jsonv.read_time(fv, "date-time")?
      "version" => out.version = jsonv.read_int(fv)?
      "supportMetadata" => out.support_metadata = fv
      "metadata" => out.metadata = fv
      "primaryTaskId" => out.primary_task_id = jsonv.read_str(fv)?
      "statusReason" => out.status_reason = jsonv.read_str(fv)?
      "hasLinkedTasks" => out.has_linked_tasks = jsonv.read_bool(fv)?
      _ => {}
    }
  }
  Ok(out)
}

