          "exception" => return Err(exception_invoke_agent_runtime_command_stream_output(m))
          _ => return Err(InvokeAgentRuntimeCommandStreamOutputErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
