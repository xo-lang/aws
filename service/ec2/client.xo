fn xml_write_network_info(var w: xmlv.Writer, v: NetworkInfo, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.network_performance {
    xmlv.elem(w, "networkPerformance", x, [])
  }
  if let Some(x) = v.maximum_network_interfaces {
    xmlv.elem(w, "maximumNetworkInterfaces", "${x}", [])
  }
  if let Some(x) = v.maximum_network_cards {
    xmlv.elem(w, "maximumNetworkCards", "${x}", [])
  }
  if let Some(x) = v.default_network_card_index {
    xmlv.elem(w, "defaultNetworkCardIndex", "${x}", [])
  }
  if let Some(x) = v.network_cards {
    xml_write_network_card_info_list(w, x, "networkCards", [])
  }
  if let Some(x) = v.ipv4_addresses_per_interface {
    xmlv.elem(w, "ipv4AddressesPerInterface", "${x}", [])
  }
  if let Some(x) = v.ipv6_addresses_per_interface {
    xmlv.elem(w, "ipv6AddressesPerInterface", "${x}", [])
  }
  if let Some(x) = v.ipv6_supported {
    xmlv.elem(w, "ipv6Supported", "${x}", [])
  }
  if let Some(x) = v.ena_support {
    xmlv.elem(w, "enaSupport", x.value(), [])
  }
  if let Some(x) = v.efa_supported {
    xmlv.elem(w, "efaSupported", "${x}", [])
  }
  if let Some(x) = v.efa_info {
    xml_write_efa_info(w, x, "efaInfo", [])
  }
  if let Some(x) = v.encryption_in_transit_supported {
    xmlv.elem(w, "encryptionInTransitSupported", "${x}", [])
  }
  if let Some(x) = v.ena_srd_supported {
    xmlv.elem(w, "enaSrdSupported", "${x}", [])
  }
  if let Some(x) = v.bandwidth_weightings {
    xml_write_bandwidth_weighting_type_list(w, x, "bandwidthWeightings", [])
  }
  if let Some(x) = v.flexible_ena_queues_support {
    xmlv.elem(w, "flexibleEnaQueuesSupport", x.value(), [])
  }
  if let Some(x) = v.connection_tracking_configuration {
    xml_write_default_connection_tracking_configuration(w, x, "connectionTrackingConfiguration", [])
  }
  if let Some(x) = v.secondary_network_supported {
    xmlv.elem(w, "secondaryNetworkSupported", "${x}", [])
  }
  if let Some(x) = v.maximum_secondary_network_interfaces {
    xmlv.elem(w, "maximumSecondaryNetworkInterfaces", "${x}", [])
  }
  if let Some(x) = v.ipv4_addresses_per_secondary_interface {
    xmlv.elem(w, "ipv4AddressesPerSecondaryInterface", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_network_info(e: xml.Element) -> NetworkInfo ! Str {
  var out = NetworkInfo{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "networkPerformance" => out.network_performance = c.text()
      "maximumNetworkInterfaces" => out.maximum_network_interfaces = xmlv.read_int(c.text())?
      "maximumNetworkCards" => out.maximum_network_cards = xmlv.read_int(c.text())?
      "defaultNetworkCardIndex" => out.default_network_card_index = xmlv.read_int(c.text())?
      "networkCards" => out.network_cards = xml_read_network_card_info_list(c)?
      "ipv4AddressesPerInterface" => out.ipv4_addresses_per_interface = xmlv.read_int(c.text())?
      "ipv6AddressesPerInterface" => out.ipv6_addresses_per_interface = xmlv.read_int(c.text())?
      "ipv6Supported" => out.ipv6_supported = xmlv.read_bool(c.text())?
      "enaSupport" => out.ena_support = EnaSupport.from(c.text())
      "efaSupported" => out.efa_supported = xmlv.read_bool(c.text())?
      "efaInfo" => out.efa_info = xml_read_efa_info(c)?
      "encryptionInTransitSupported" => out.encryption_in_transit_supported = xmlv.read_bool(c.text())?
      "enaSrdSupported" => out.ena_srd_supported = xmlv.read_bool(c.text())?
      "bandwidthWeightings" => out.bandwidth_weightings = xml_read_bandwidth_weighting_type_list(c)?
      "flexibleEnaQueuesSupport" => out.flexible_ena_queues_support = FlexibleEnaQueuesSupport.from(c.text())
      "connectionTrackingConfiguration" => out.connection_tracking_configuration = xml_read_default_connection_tracking_configuration(c)?
      "secondaryNetworkSupported" => out.secondary_network_supported = xmlv.read_bool(c.text())?
      "maximumSecondaryNetworkInterfaces" => out.maximum_secondary_network_interfaces = xmlv.read_int(c.text())?
      "ipv4AddressesPerSecondaryInterface" => out.ipv4_addresses_per_secondary_interface = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

