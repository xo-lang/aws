fn from_json_table_description(v: json.Value) -> TableDescription ! Str {
  var out = TableDescription{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "AttributeDefinitions" => out.attribute_definitions = from_json_attribute_definitions(fv)?
      "TableName" => out.table_name = jsonv.read_str(fv)?
      "KeySchema" => out.key_schema = from_json_key_schema(fv)?
      "TableStatus" => out.table_status = TableStatus.from(jsonv.read_str(fv)?)
      "CreationDateTime" => out.creation_date_time = jsonv.read_time(fv, "epoch-seconds")?
      "ProvisionedThroughput" => out.provisioned_throughput = from_json_provisioned_throughput_description(fv)?
      "TableSizeBytes" => out.table_size_bytes = jsonv.read_int(fv)?
      "ItemCount" => out.item_count = jsonv.read_int(fv)?
      "TableArn" => out.table_arn = jsonv.read_str(fv)?
      "TableId" => out.table_id = jsonv.read_str(fv)?
      "BillingModeSummary" => out.billing_mode_summary = from_json_billing_mode_summary(fv)?
      "LocalSecondaryIndexes" => out.local_secondary_indexes = from_json_local_secondary_index_description_list(fv)?
      "GlobalSecondaryIndexes" => out.global_secondary_indexes = from_json_global_secondary_index_description_list(fv)?
      "StreamSpecification" => out.stream_specification = from_json_stream_specification(fv)?
      "LatestStreamLabel" => out.latest_stream_label = jsonv.read_str(fv)?
      "LatestStreamArn" => out.latest_stream_arn = jsonv.read_str(fv)?
      "GlobalTableVersion" => out.global_table_version = jsonv.read_str(fv)?
      "Replicas" => out.replicas = from_json_replica_description_list(fv)?
      "GlobalTableWitnesses" => out.global_table_witnesses = from_json_global_table_witness_description_list(fv)?
      "GlobalTableSettingsReplicationMode" => out.global_table_settings_replication_mode = GlobalTableSettingsReplicationMode.from(jsonv.read_str(fv)?)
      "RestoreSummary" => out.restore_summary = from_json_restore_summary(fv)?
      "SSEDescription" => out.sse_description = from_json_sse_description(fv)?
      "ArchivalSummary" => out.archival_summary = from_json_archival_summary(fv)?
      "TableClassSummary" => out.table_class_summary = from_json_table_class_summary(fv)?
      "DeletionProtectionEnabled" => out.deletion_protection_enabled = jsonv.read_bool(fv)?
      "DisassociationProtectionEnabled" => out.disassociation_protection_enabled = jsonv.read_bool(fv)?
      "OnDemandThroughput" => out.on_demand_throughput = from_json_on_demand_throughput(fv)?
      "WarmThroughput" => out.warm_throughput = from_json_table_warm_throughput_description(fv)?
      "MultiRegionConsistency" => out.multi_region_consistency = MultiRegionConsistency.from(jsonv.read_str(fv)?)
      "VectorIndexes" => out.vector_indexes = from_json_vector_index_description_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

