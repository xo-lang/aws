  pub durability: Durability? = None
}

pub struct CreateReplicationGroupResult {
  pub replication_group: ReplicationGroup? = None
}

pub struct CreateServerlessCacheRequest {
  /// User-provided identifier for the serverless cache. This parameter is
  /// stored as a lowercase string.
  pub serverless_cache_name: Str? = None
  /// User-provided description for the serverless cache. The default is NULL,
  /// i.e. if no description is provided then an empty string will be
  /// returned. The maximum length is 255 characters.
  pub description: Str? = None
  /// The name of the cache engine to be used for creating the serverless
  /// cache.
  pub engine: Str? = None
  /// The version of the cache engine that will be used to create the
  /// serverless cache.
  pub major_engine_version: Str? = None
  /// Sets the cache usage limits for storage and ElastiCache Processing Units
  /// for the cache.
  pub cache_usage_limits: CacheUsageLimits? = None
  /// ARN of the customer managed key for encrypting the data at rest. If no
  /// KMS key is provided, a default service key is used.
  pub kms_key_id: Str? = None
  /// A list of the one or more VPC security groups to be associated with the
  /// serverless cache. The security group will authorize traffic access for
  /// the VPC end-point (private-link). If no other information is given this
  /// will be the VPC’s Default Security Group that is associated with the
  /// cluster VPC end-point.
  pub security_group_ids: List[Str]? = None
  /// The ARN(s) of the snapshot that the new serverless cache will be created
  /// from. Available for Valkey, Redis OSS and Serverless Memcached only.
  pub snapshot_arns_to_restore: List[Str]? = None
  /// The list of tags (key, value) pairs to be added to the serverless cache
  /// resource. Default is NULL.
  pub tags: List[Tag]? = None
  /// The identifier of the UserGroup to be associated with the serverless
  /// cache. Available for Valkey and Redis OSS only. Default is NULL.
  pub user_group_id: Str? = None
  /// A list of the identifiers of the subnets where the VPC endpoint for the
  /// serverless cache will be deployed. All the subnetIds must belong to the
  /// same VPC.
  pub subnet_ids: List[Str]? = None
  /// The number of days for which ElastiCache retains automatic snapshots
  /// before deleting them. Available for Valkey, Redis OSS and Serverless
  /// Memcached only. The maximum value allowed is 35 days.
  pub snapshot_retention_limit: Int? = None
  /// The daily time that snapshots will be created from the new serverless
  /// cache. By default this number is populated with 0, i.e. no snapshots
  /// will be created on an automatic daily basis. Available for Valkey, Redis
  /// OSS and Serverless Memcached only.
  pub daily_snapshot_time: Str? = None
  /// The IP protocol version used by the serverless cache. Must be either
  /// ipv4 | ipv6 | dual_stack . ipv6 is only supported with IPv6-only
  /// subnets. If not specified, defaults to ipv4 , unless all provided
  /// subnets are IPv6-only, in which case it defaults to ipv6 .
  pub network_type: NetworkType? = None
  /// The connection type for the serverless cache. Must be either vpc |
  /// public . Use vpc to access the cache through a VPC endpoint, or public
  /// to access the cache over the internet. If not specified, defaults to vpc
  /// . This value cannot be changed after the serverless cache is created.
  /// Setting this to public requires Valkey 9 or above.
  pub connection_type: ConnectionType? = None
}

pub struct CreateServerlessCacheResponse {
  /// The response for the attempt to create the serverless cache.
  pub serverless_cache: ServerlessCache? = None
}

pub struct CreateServerlessCacheSnapshotRequest {
  /// The name for the snapshot being created. Must be unique for the customer
  /// account. Available for Valkey, Redis OSS and Serverless Memcached only.
  /// Must be between 1 and 255 characters. This value is stored as a
  /// lowercase string.
  pub serverless_cache_snapshot_name: Str? = None
  /// The name of an existing serverless cache. The snapshot is created from
  /// this cache. Available for Valkey, Redis OSS and Serverless Memcached
  /// only.
  pub serverless_cache_name: Str? = None
  /// The ID of the KMS key used to encrypt the snapshot. Available for
  /// Valkey, Redis OSS and Serverless Memcached only. Default: NULL
  pub kms_key_id: Str? = None
  /// A list of tags to be added to the snapshot resource. A tag is a
  /// key-value pair. Available for Valkey, Redis OSS and Serverless Memcached
  /// only.
  pub tags: List[Tag]? = None
}

pub struct CreateServerlessCacheSnapshotResponse {
  /// The state of a serverless cache snapshot at a specific point in time, to
  /// the millisecond. Available for Valkey, Redis OSS and Serverless
  /// Memcached only.
  pub serverless_cache_snapshot: ServerlessCacheSnapshot? = None
}

/// Represents the input of a CreateSnapshot operation.
pub struct CreateSnapshotMessage {
  /// The identifier of an existing replication group. The snapshot is created
  /// from this replication group.
  pub replication_group_id: Str? = None
  /// The identifier of an existing cluster. The snapshot is created from this
  /// cluster.
  pub cache_cluster_id: Str? = None
  /// A name for the snapshot being created. This value is stored as a
  /// lowercase string.
  pub snapshot_name: Str? = None
  /// The ID of the KMS key used to encrypt the snapshot.
  pub kms_key_id: Str? = None
  /// A list of tags to be added to this resource. A tag is a key-value pair.
  /// A tag key must be accompanied by a tag value, although null is accepted.
  pub tags: List[Tag]? = None
}

pub struct CreateSnapshotResult {
  pub snapshot: Snapshot? = None
}

pub struct CreateUserGroupMessage {
  /// The ID of the user group. This value is stored as a lowercase string.
  pub user_group_id: Str? = None
  /// Sets the engine listed in a user group. The options are valkey or redis.
  pub engine: Str? = None
  /// The list of user IDs that belong to the user group.
  pub user_ids: List[Str]? = None
  /// A list of tags to be added to this resource. A tag is a key-value pair.
  /// A tag key must be accompanied by a tag value, although null is accepted.
  /// Available for Valkey and Redis OSS only.
  pub tags: List[Tag]? = None
}

pub struct CreateUserMessage {
  /// The ID of the user. This value is stored as a lowercase string.
  pub user_id: Str? = None
  /// The username of the user.
  pub user_name: Str? = None
  /// The options are valkey or redis.
  pub engine: Str? = None
  /// Passwords used for this user. You can create up to two passwords for
  /// each user.
  pub passwords: List[Str]? = None
  /// Access permissions string used for this user.
  pub access_string: Str? = None
  /// Indicates a password is not required for this user.
  pub no_password_required: Bool? = None
  /// A list of tags to be added to this resource. A tag is a key-value pair.
  /// A tag key must be accompanied by a tag value, although null is accepted.
  pub tags: List[Tag]? = None
  /// Specifies how to authenticate the user.
  pub authentication_mode: AuthenticationMode? = None
}

/// The endpoint from which data should be migrated.
pub struct CustomerNodeEndpoint {
  /// The address of the node endpoint
  pub address: Str? = None
  /// The port of the node endpoint
  pub port: Int? = None
}

/// The data storage limit.
pub struct DataStorage {
  /// The upper limit for data storage the cache is set to use.
  pub maximum: Int? = None
  /// The lower limit for data storage the cache is set to use.
  pub minimum: Int? = None
  /// The unit that the storage is measured in, in GB.
  pub unit: DataStorageUnit? = None
}

pub enum DataStorageUnit: Str {
  Gb = "GB"
  Unknown(value: Str)
}

pub enum DataTieringStatus: Str {
  Enabled = "enabled"
  Disabled = "disabled"
  Unknown(value: Str)
}

pub struct DecreaseNodeGroupsInGlobalReplicationGroupMessage {
  /// The name of the Global datastore
  pub global_replication_group_id: Str? = None
  /// The number of node groups (shards) that results from the modification of
  /// the shard configuration
  pub node_group_count: Int? = None
  /// If the value of NodeGroupCount is less than the current number of node
  /// groups (shards), then either NodeGroupsToRemove or NodeGroupsToRetain is
  /// required. GlobalNodeGroupsToRemove is a list of NodeGroupIds to remove
  /// from the cluster. ElastiCache will attempt to remove all node groups
  /// listed by GlobalNodeGroupsToRemove from the cluster.
  pub global_node_groups_to_remove: List[Str]? = None
  /// If the value of NodeGroupCount is less than the current number of node
  /// groups (shards), then either NodeGroupsToRemove or NodeGroupsToRetain is
  /// required. GlobalNodeGroupsToRetain is a list of NodeGroupIds to retain
  /// from the cluster. ElastiCache will attempt to retain all node groups
  /// listed by GlobalNodeGroupsToRetain from the cluster.
  pub global_node_groups_to_retain: List[Str]? = None
  /// Indicates that the shard reconfiguration process begins immediately. At
  /// present, the only permitted value for this parameter is true.
  pub apply_immediately: Bool? = None
}

pub struct DecreaseNodeGroupsInGlobalReplicationGroupResult {
  pub global_replication_group: GlobalReplicationGroup? = None
}

pub struct DecreaseReplicaCountMessage {
  /// The id of the replication group from which you want to remove replica
  /// nodes.
  pub replication_group_id: Str? = None
  /// The number of read replica nodes you want at the completion of this
  /// operation. For Valkey or Redis OSS (cluster mode disabled) replication
  /// groups, this is the number of replica nodes in the replication group.
  /// For Valkey or Redis OSS (cluster mode enabled) replication groups, this
  /// is the number of replica nodes in each of the replication group's node
  /// groups. The minimum number of replicas in a shard or replication group
  /// is: Valkey or Redis OSS (cluster mode disabled) If Multi-AZ is enabled:
  /// 1 If Multi-AZ is not enabled: 0 Valkey or Redis OSS (cluster mode
  /// enabled): 0 (though you will not be able to failover to a replica if
  /// your primary node fails)
  pub new_replica_count: Int? = None
  /// A list of ConfigureShard objects that can be used to configure each
  /// shard in a Valkey or Redis OSS replication group. The ConfigureShard has
  /// three members: NewReplicaCount , NodeGroupId , and
  /// PreferredAvailabilityZones .
  pub replica_configuration: List[ConfigureShard]? = None
  /// A list of the node ids to remove from the replication group or node
  /// group (shard).
  pub replicas_to_remove: List[Str]? = None
  /// If True , the number of replica nodes is decreased immediately.
  /// ApplyImmediately=False is not currently supported.
  pub apply_immediately: Bool? = None
}

pub struct DecreaseReplicaCountResult {
