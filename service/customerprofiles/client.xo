fn json_of_dimension(v: Dimension) -> json.Value {
  match v {
    ProfileAttributes(x) => json.Value.Object([("ProfileAttributes", json_of_profile_attributes(x))])
    CalculatedAttributes(x) => json.Value.Object([("CalculatedAttributes", json_of_calculated_custom_attributes(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_dimension(v: json.Value) -> Dimension ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "ProfileAttributes" => Ok(Dimension.ProfileAttributes(from_json_profile_attributes(fv)?))
      "CalculatedAttributes" => Ok(Dimension.CalculatedAttributes(from_json_calculated_custom_attributes(fv)?))
      _ => Ok(Dimension.Unknown(k))
    }
  }
  Err("Dimension: no member set")
}

fn json_of_dimension_list(v: List[Dimension]) -> json.Value {
  json.Value.List(v.map(fn(x: Dimension) -> json.Value { json_of_dimension(x) }))
}

fn from_json_dimension_list(v: json.Value) -> List[Dimension] ! Str {
  var out: List[Dimension] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
