fn json_of_compute_capacity_status(v: ComputeCapacityStatus) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.desired {
    fs.push(("Desired", json.Value.Int(x)))
  }
  if let Some(x) = v.running {
    fs.push(("Running", json.Value.Int(x)))
  }
  if let Some(x) = v.in_use {
    fs.push(("InUse", json.Value.Int(x)))
  }
  if let Some(x) = v.available {
    fs.push(("Available", json.Value.Int(x)))
  }
  if let Some(x) = v.desired_user_sessions {
    fs.push(("DesiredUserSessions", json.Value.Int(x)))
  }
  if let Some(x) = v.available_user_sessions {
    fs.push(("AvailableUserSessions", json.Value.Int(x)))
  }
  if let Some(x) = v.active_user_sessions {
    fs.push(("ActiveUserSessions", json.Value.Int(x)))
  }
  if let Some(x) = v.actual_user_sessions {
    fs.push(("ActualUserSessions", json.Value.Int(x)))
