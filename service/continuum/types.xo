  Available = "AVAILABLE"
  Unknown(value: Str)
}

/// Customer delivery of the patches Continuum produced for an issue,
/// summarized across the issue's PATCH artifacts when the issue is read.
/// Each artifact keeps its own `delivery.destination` with the full detail;
/// this summary lets a caller see a failed delivery without listing
/// artifacts.
pub struct IssuePatchDelivery {
  /// The overall result, in priority order: FAILED when any patch's
  /// destination delivery failed or exhausted its retries; otherwise PENDING
  /// while any is still in progress; otherwise SUCCEEDED when at least one
  /// was delivered; otherwise SKIPPED.
  pub status: IssuePatchDeliveryStatus? = None
  /// Number of the issue's patches that have a destination delivery.
  pub patch_count: Int? = None
  /// Number of those patches delivered to their destination.
  pub succeeded_count: Int? = None
  /// Number of those patches whose delivery failed or exhausted its retries.
  pub failed_count: Int? = None
  /// Distinct reasons of the failed deliveries, in ascending order. Present
  /// only when failedCount is greater than zero.
  pub failure_reasons: List[DeliveryReason]? = None
}

/// Overall customer delivery result of an issue's patches.
pub enum IssuePatchDeliveryStatus: Str {
  Pending = "PENDING"
  Succeeded = "SUCCEEDED"
  Failed = "FAILED"
  Skipped = "SKIPPED"
  Unknown(value: Str)
}

/// The part of Continuum's workflow an issue is in (IN_PROGRESS) or failed
/// in (FAILED, when known).
pub enum IssuePhase: Str {
  Validation = "VALIDATION"
  Prioritization = "PRIORITIZATION"
  Remediation = "REMEDIATION"
  Unknown(value: Str)
}

/// Scanner-derived severity assigned to an issue.
pub enum IssueSeverity: Str {
  Low = "LOW"
  Medium = "MEDIUM"
  High = "HIGH"
  Critical = "CRITICAL"
  Unknown(value: Str)
}

/// The customer-facing lifecycle status of an issue. Coarse by design:
/// `phase` says which part of Continuum's workflow an IN_PROGRESS (or
/// FAILED) issue is in, and `statusReason` says why a FAILED issue failed.
/// Distinct from FindingStatus. Continuum sets this value; callers can't
/// set it.
pub enum IssueStatus: Str {
  Created = "CREATED"
  InProgress = "IN_PROGRESS"
  Completed = "COMPLETED"
  Failed = "FAILED"
  Unknown(value: Str)
}

/// Why an issue is FAILED. Present only when `status` is FAILED.
pub enum IssueStatusReason: Str {
  InternalError = "INTERNAL_ERROR"
  RemediationFailed = "REMEDIATION_FAILED"
  Unknown(value: Str)
}

/// A summary of an issue returned in list responses.
pub struct IssueSummary {
  /// The unique identifier of the issue.
  pub issue_id: Str? = None
  /// The ARN of the issue.
  pub issue_arn: Str? = None
  /// The name of the issue.
  pub name: Str? = None
  /// Scanner-derived severity assigned to the issue.
  pub severity: IssueSeverity? = None
  /// The likelihood that this issue is a true positive, expressed as a
  /// percentage (0-100).
  pub confidence: Int? = None
  /// The current lifecycle status of the issue.
  pub status: IssueStatus? = None
  /// The part of the workflow the issue is in. Present when status is
  /// IN_PROGRESS, and when status is FAILED and the failing phase is known.
  pub phase: IssuePhase? = None
  /// Why the issue failed. Present only when status is FAILED.
  pub status_reason: IssueStatusReason? = None
  /// Customer-facing explanation of statusReason. Present only when status is
  /// FAILED.
  pub status_message: Str? = None
  /// The timestamp when the status or phase last changed.
  pub status_updated_at: Time? = None
  /// The timestamp when the issue was created.
  pub created_at: Time? = None
  /// The timestamp when any field of the issue last changed. Advances on
  /// every mutation (including score-only updates that do not transition
  /// status), so it is greater than or equal to statusUpdatedAt.
  pub updated_at: Time? = None
}

