    Heterogeneous(x) => json.Value.Object([("heterogeneous", json_of_heterogeneous(x))])
    Homogeneous(x) => json.Value.Object([("homogeneous", json_of_homogeneous(x))])
    NoPreference(x) => json.Value.Object([("noPreference", json_of_no_database_migration_preference(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_database_migration_preference(v: json.Value) -> DatabaseMigrationPreference ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "heterogeneous" => Ok(DatabaseMigrationPreference.Heterogeneous(from_json_heterogeneous(fv)?))
      "homogeneous" => Ok(DatabaseMigrationPreference.Homogeneous(from_json_homogeneous(fv)?))
      "noPreference" => Ok(DatabaseMigrationPreference.NoPreference(from_json_no_database_migration_preference(fv)?))
      _ => Ok(DatabaseMigrationPreference.Unknown(k))
    }
  }
  Err("DatabaseMigrationPreference: no member set")
}

