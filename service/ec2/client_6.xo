    xml_write_launch_template_instance_maintenance_options(w, x, "maintenanceOptions", [])
  }
  if let Some(x) = v.disable_api_stop {
    xmlv.elem(w, "disableApiStop", "${x}", [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_response(w, x, "operator", [])
