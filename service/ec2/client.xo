  var out = PerformanceStatusSummary{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "status" => out.status = SummaryStatus.from(c.text())
      "impairedSince" => out.impaired_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "remediation" => out.remediation = c.text()
      _ => {}
    }
  }
  Ok(out)
}

