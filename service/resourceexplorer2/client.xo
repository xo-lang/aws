  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateViewErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_view_error(resp))
  }
  deserialize_update_view(resp) ?? e => Err(UpdateViewErr.Deserialize(e))
}
