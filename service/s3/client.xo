fn xml_read_complete_multipart_upload_request(e: xml.Element) -> CompleteMultipartUploadRequest ! Str {
  var out = CompleteMultipartUploadRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Bucket" => out.bucket = c.text()
      "Key" => out.key = c.text()
      "CompleteMultipartUpload" => out.multipart_upload = xml_read_completed_multipart_upload(c)?
      "UploadId" => out.upload_id = c.text()
      "ChecksumCRC32" => out.checksum_crc32 = c.text()
      "ChecksumCRC32C" => out.checksum_crc32_c = c.text()
      "ChecksumCRC64NVME" => out.checksum_crc64_nvme = c.text()
      "ChecksumSHA1" => out.checksum_sha1 = c.text()
      "ChecksumSHA256" => out.checksum_sha256 = c.text()
      "ChecksumSHA512" => out.checksum_sha512 = c.text()
      "ChecksumMD5" => out.checksum_md5 = c.text()
      "ChecksumXXHASH64" => out.checksum_xxhash64 = c.text()
      "ChecksumXXHASH3" => out.checksum_xxhash3 = c.text()
      "ChecksumXXHASH128" => out.checksum_xxhash128 = c.text()
      "ChecksumType" => out.checksum_type = ChecksumType.from(c.text())
      "MpuObjectSize" => out.mpu_object_size = xmlv.read_int(c.text())?
      "RequestPayer" => out.request_payer = RequestPayer.from(c.text())
      "ExpectedBucketOwner" => out.expected_bucket_owner = c.text()
      "IfMatch" => out.if_match = c.text()
      "IfNoneMatch" => out.if_none_match = c.text()
      "SSECustomerAlgorithm" => out.sse_customer_algorithm = c.text()
      "SSECustomerKey" => out.sse_customer_key = c.text()
      "SSECustomerKeyMD5" => out.sse_customer_key_md5 = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_completed_multipart_upload(var w: xmlv.Writer, v: CompletedMultipartUpload, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.parts {
    for item in x {
      xml_write_completed_part(w, item, "Part", [])
    }
  }
  xmlv.end(w, name)
}

fn xml_read_completed_multipart_upload(e: xml.Element) -> CompletedMultipartUpload ! Str {
  var out = CompletedMultipartUpload{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Part" => {
        var items = out.parts ?? []
        items.push(xml_read_completed_part(c)?)
        out.parts = items
      }
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_completed_part(var w: xmlv.Writer, v: CompletedPart, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.e_tag {
    xmlv.elem(w, "ETag", x, [])
  }
  if let Some(x) = v.checksum_crc32 {
    xmlv.elem(w, "ChecksumCRC32", x, [])
  }
  if let Some(x) = v.checksum_crc32_c {
    xmlv.elem(w, "ChecksumCRC32C", x, [])
  }
  if let Some(x) = v.checksum_crc64_nvme {
    xmlv.elem(w, "ChecksumCRC64NVME", x, [])
  }
  if let Some(x) = v.checksum_sha1 {
    xmlv.elem(w, "ChecksumSHA1", x, [])
  }
  if let Some(x) = v.checksum_sha256 {
    xmlv.elem(w, "ChecksumSHA256", x, [])
  }
  if let Some(x) = v.checksum_sha512 {
    xmlv.elem(w, "ChecksumSHA512", x, [])
  }
  if let Some(x) = v.checksum_md5 {
    xmlv.elem(w, "ChecksumMD5", x, [])
  }
  if let Some(x) = v.checksum_xxhash64 {
    xmlv.elem(w, "ChecksumXXHASH64", x, [])
  }
  if let Some(x) = v.checksum_xxhash3 {
    xmlv.elem(w, "ChecksumXXHASH3", x, [])
  }
  if let Some(x) = v.checksum_xxhash128 {
    xmlv.elem(w, "ChecksumXXHASH128", x, [])
  }
  if let Some(x) = v.part_number {
    xmlv.elem(w, "PartNumber", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_completed_part(e: xml.Element) -> CompletedPart ! Str {
  var out = CompletedPart{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ETag" => out.e_tag = c.text()
      "ChecksumCRC32" => out.checksum_crc32 = c.text()
      "ChecksumCRC32C" => out.checksum_crc32_c = c.text()
      "ChecksumCRC64NVME" => out.checksum_crc64_nvme = c.text()
      "ChecksumSHA1" => out.checksum_sha1 = c.text()
      "ChecksumSHA256" => out.checksum_sha256 = c.text()
      "ChecksumSHA512" => out.checksum_sha512 = c.text()
      "ChecksumMD5" => out.checksum_md5 = c.text()
      "ChecksumXXHASH64" => out.checksum_xxhash64 = c.text()
      "ChecksumXXHASH3" => out.checksum_xxhash3 = c.text()
      "ChecksumXXHASH128" => out.checksum_xxhash128 = c.text()
      "PartNumber" => out.part_number = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_completed_part_list(var w: xmlv.Writer, v: List[CompletedPart], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_completed_part(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_completed_part_list(e: xml.Element) -> List[CompletedPart] ! Str {
  var out: List[CompletedPart] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_completed_part(c)?)
  }
  Ok(out)
}

fn xml_write_condition(var w: xmlv.Writer, v: Condition, name: Str, ns: List[(Str, Str)]) {
