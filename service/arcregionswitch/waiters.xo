/// Calls GetPlanEvaluationStatus until the PlanEvaluationStatusPassed acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (120s).
pub fn wait_until_plan_evaluation_status_passed(c: Client, input: GetPlanEvaluationStatusRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetPlanEvaluationStatusErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).get_plan_evaluation_status(input) {
      Ok(out) => {
        let o = jmes_of_get_plan_evaluation_status_response(out)
        if state == "" && waiter.path_matches(o, "evaluationState", "stringEquals", "passed") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "evaluationState", "stringEquals", "actionRequired") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "evaluationState", "stringEquals", "pendingEvaluation") {
          state = "retry"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("PlanEvaluationStatusPassed: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls GetPlanExecution until the PlanExecutionCompleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (120s).
pub fn wait_until_plan_execution_completed(c: Client, input: GetPlanExecutionRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetPlanExecutionErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).get_plan_execution(input) {
      Ok(out) => {
        let o = jmes_of_get_plan_execution_response(out)
        if state == "" && waiter.path_matches(o, "executionState", "stringEquals", "completed") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "executionState", "stringEquals", "completedWithExceptions") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "executionState", "stringEquals", "failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "executionState", "stringEquals", "canceled") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "executionState", "stringEquals", "planExecutionTimedOut") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("PlanExecutionCompleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
