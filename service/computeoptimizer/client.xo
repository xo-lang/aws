  }
  if let Some(x) = v.last_refresh_timestamp {
    fs.push(("lastRefreshTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.finding {
    fs.push(("finding", json.Value.Str(x.value())))
  }
  if let Some(x) = v.finding_reason_codes {
