/// Contains summary information about the custom vocabulary.
pub struct VocabularySummary {
  /// A unique name of the custom vocabulary.
  pub name: Str? = None
  /// The identifier of the custom vocabulary.
  pub id: Str? = None
  /// The Amazon Resource Name (ARN) of the custom vocabulary.
  pub arn: Str? = None
  /// The language code of the vocabulary entries. For a list of languages and
  /// their corresponding language codes, see What is Amazon Transcribe?
  pub language_code: VocabularyLanguageCode? = None
  /// The current state of the custom vocabulary.
  pub state: VocabularyState? = None
  /// The timestamp when the custom vocabulary was last modified.
  pub last_modified_time: Time? = None
  /// The reason why the custom vocabulary was not created.
  pub failure_reason: Str? = None
}

/// Parameters for initiating a voice call test.
pub struct VoiceCallEntryPointParameters {
  /// The source phone number for the test.
  pub source_phone_number: Str? = None
  /// The destination phone number for the test.
  pub destination_phone_number: Str? = None
  /// The flow identifier for the test.
  pub flow_id: Str? = None
}

/// Configuration settings for voice enhancement.
pub struct VoiceEnhancementConfig {
  /// The channel for this voice enhancement configuration. Only VOICE is
  /// supported for this data type.
  pub channel: Channel? = None
  /// The voice enhancement mode.
  pub voice_enhancement_mode: VoiceEnhancementMode? = None
}

pub enum VoiceEnhancementMode: Str {
  VoiceIsolation = "VOICE_ISOLATION"
  NoiseSuppression = "NOISE_SUPPRESSION"
  None = "NONE"
  Unknown(value: Str)
}

/// Contains information about the recording configuration settings.
pub struct VoiceRecordingConfiguration {
  /// Identifies which track is being recorded.
  pub voice_recording_track: VoiceRecordingTrack? = None
  /// Identifies which IVR track is being recorded. One and only one of the
  /// track configurations should be presented in the request.
  pub ivr_recording_track: IvrRecordingTrack? = None
}

pub enum VoiceRecordingTrack: Str {
  FromAgent = "FROM_AGENT"
  ToAgent = "TO_AGENT"
  All = "ALL"
  Unknown(value: Str)
}

/// The content of an outbound web notification, including the notification
/// type, the view to render, and any optional attributes used to populate
/// the view.
pub struct WebNotificationContent {
  /// The type of web notification to send.
  pub type_value: NotificationType? = None
  /// The Amazon Resource Name (ARN) of the view to render for the
  /// notification.
  pub view_arn: Str? = None
  /// Optional attributes used to populate the notification content, such as
  /// recommender configuration for personalized content.
  pub attributes: ContentAttributes? = None
}

/// The source of an outbound web notification. Identifies the campaign and
/// outbound request that triggered the notification.
pub struct WebNotificationSource {
  /// Information about the campaign that triggered the web notification,
  /// including the campaign identifier and outbound request identifier.
  pub source_campaign: SourceCampaign? = None
}

/// The websocket that a chat participant uses to receive messages and
/// events for the chat.
pub struct Websocket {
  /// The URL of the websocket.
  pub url: Str? = None
  /// The expiration of the websocket URL. It's specified in ISO 8601 format:
  /// yyyy-MM-ddThh:mm:ss.SSSZ. For example, 2019-11-08T02:41:28.172Z.
  pub connection_expiry: Str? = None
}

/// The destination for an outbound web notification, specifying the
/// communication widget that delivers the notification and the customer
/// profile of the recipient.
pub struct WidgetDestination {
  /// The identifier of the communication widget that delivers the
  /// notification to the customer's browser.
  pub widget_id: Str? = None
  /// The identifier of the customer profile associated with the browser
  /// session that should receive the notification.
  pub profile_id: Str? = None
}

/// Information about Connect Customer Wisdom.
pub struct WisdomInfo {
  /// The Amazon Resource Name (ARN) of the Wisdom session.
  pub session_arn: Str? = None
  /// The array of AI agents involved in the contact.
  pub ai_agents: List[AiAgentInfo]? = None
}

/// Defines the maximum number of contacts an agent can handle
/// simultaneously for a specific channel and workload type combination.
pub struct WorkloadTypeConcurrency {
  /// The value of the workload type.
  pub workload_type: Str? = None
  /// The maximum number of contacts an agent can handle simultaneously for a
  /// specific channel and workload type combination. Valid Range for VOICE :
  /// Minimum value of 1. Maximum value of 1. Valid Range for CHAT : Minimum
  /// value of 1. Maximum value of 10. Valid Range for TASK : Minimum value of
  /// 1. Maximum value of 10.
  pub concurrency: Int? = None
  /// Defines the cross-channel and workload type routing behavior for each
  /// channel and workload type combination that is enabled for this Routing
  /// Profile.
  pub cross_channel_workload_behavior: CrossChannelWorkloadBehavior? = None
}

/// Contains information about a workspace, which defines the user
/// experience by mapping views to pages.
pub struct Workspace {
  /// Controls who can access the workspace. Valid values are: ALL (all
  /// users), ASSIGNED (only assigned users and routing profiles), and NONE
  /// (not visible).
  pub visibility: Visibility? = None
  /// The unique identifier of the workspace.
  pub id: Str? = None
  /// The name of the workspace.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the workspace.
  pub arn: Str? = None
  /// The description of the workspace.
  pub description: Str? = None
  /// The theme configuration for the workspace, including colors and styling.
  pub theme: WorkspaceTheme? = None
  /// The title displayed for the workspace.
  pub title: Str? = None
  /// The timestamp when the workspace was last modified.
  pub last_modified_time: Time? = None
  /// The Amazon Web Services Region where the workspace was last modified.
  pub last_modified_region: Str? = None
  /// The tags used to organize, track, or control access for the workspace.
  pub tags: Map[Str, Str]? = None
}

/// Defines the search criteria for filtering workspace associations.
pub struct WorkspaceAssociationSearchCriteria {
  /// A list of conditions to be met, where at least one condition must be
  /// satisfied.
  pub or_conditions: List[WorkspaceAssociationSearchCriteria]? = None
  /// A list of conditions that must all be satisfied.
  pub and_conditions: List[WorkspaceAssociationSearchCriteria]? = None
  pub string_condition: StringCondition? = None
}

/// Defines filters to apply when searching for workspace associations, such
/// as tag-based filters.
pub struct WorkspaceAssociationSearchFilter {
  pub attribute_filter: ControlPlaneAttributeFilter? = None
}

/// Contains summary information about a workspace association with a user
/// or routing profile.
pub struct WorkspaceAssociationSearchSummary {
  /// The identifier of the workspace.
  pub workspace_id: Str? = None
  /// The Amazon Resource Name (ARN) of the workspace.
  pub workspace_arn: Str? = None
  /// The identifier of the associated resource (user or routing profile).
  pub resource_id: Str? = None
  /// The Amazon Resource Name (ARN) of the associated resource.
  pub resource_arn: Str? = None
  /// The type of resource associated with the workspace. Valid values are:
  /// USER and ROUTING_PROFILE .
  pub resource_type: Str? = None
  /// The name of the associated resource.
  pub resource_name: Str? = None
}

pub enum WorkspaceFontFamily: Str {
  Arial = "Arial"
  CourierNew = "Courier New"
  Georgia = "Georgia"
  TimesNewRoman = "Times New Roman"
  Trebuchet = "Trebuchet"
