fn json_of_fleet(v: Fleet) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("arn", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.id {
    fs.push(("id", json.Value.Str(x)))
  }
  if let Some(x) = v.created {
    fs.push(("created", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_modified {
    fs.push(("lastModified", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.status {
    fs.push(("status", json_of_fleet_status(x)))
  }
  if let Some(x) = v.base_capacity {
    fs.push(("baseCapacity", json.Value.Int(x)))
  }
  if let Some(x) = v.environment_type {
    fs.push(("environmentType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.compute_type {
    fs.push(("computeType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.compute_configuration {
    fs.push(("computeConfiguration", json_of_compute_configuration(x)))
  }
  if let Some(x) = v.scaling_configuration {
    fs.push(("scalingConfiguration", json_of_scaling_configuration_output(x)))
  }
  if let Some(x) = v.overflow_behavior {
    fs.push(("overflowBehavior", json.Value.Str(x.value())))
  }
  if let Some(x) = v.vpc_config {
    fs.push(("vpcConfig", json_of_vpc_config(x)))
  }
  if let Some(x) = v.proxy_configuration {
    fs.push(("proxyConfiguration", json_of_proxy_configuration(x)))
  }
  if let Some(x) = v.image_id {
    fs.push(("imageId", json.Value.Str(x)))
  }
  if let Some(x) = v.fleet_service_role {
    fs.push(("fleetServiceRole", json.Value.Str(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tag_list(x)))
  }
  json.Value.Object(fs)
}

fn from_json_fleet(v: json.Value) -> Fleet ! Str {
  var out = Fleet{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "arn" => out.arn = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "id" => out.id = jsonv.read_str(fv)?
      "created" => out.created = jsonv.read_time(fv, "epoch-seconds")?
      "lastModified" => out.last_modified = jsonv.read_time(fv, "epoch-seconds")?
      "status" => out.status = from_json_fleet_status(fv)?
      "baseCapacity" => out.base_capacity = jsonv.read_int(fv)?
      "environmentType" => out.environment_type = EnvironmentType.from(jsonv.read_str(fv)?)
      "computeType" => out.compute_type = ComputeType.from(jsonv.read_str(fv)?)
      "computeConfiguration" => out.compute_configuration = from_json_compute_configuration(fv)?
      "scalingConfiguration" => out.scaling_configuration = from_json_scaling_configuration_output(fv)?
      "overflowBehavior" => out.overflow_behavior = FleetOverflowBehavior.from(jsonv.read_str(fv)?)
      "vpcConfig" => out.vpc_config = from_json_vpc_config(fv)?
      "proxyConfiguration" => out.proxy_configuration = from_json_proxy_configuration(fv)?
      "imageId" => out.image_id = jsonv.read_str(fv)?
      "fleetServiceRole" => out.fleet_service_role = jsonv.read_str(fv)?
      "tags" => out.tags = from_json_tag_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

