  /// The status of the Amazon Web Services Region in the replication set.
  pub status: Str? = None
  /// Information displayed about the status of the Amazon Web Services
  /// Region.
  pub status_message: Str? = None
  /// The timestamp for when Incident Manager updated the status of the Amazon
  /// Web Services Region.
  pub status_update_date_time: Time? = None
}

/// The mapping between a Amazon Web Services Region and the key that's used
/// to encrypt the data.
pub struct RegionMapInputValue {
  /// The KMS key used to encrypt the data in your replication set.
  pub sse_kms_key_id: Str? = None
}

/// Resources that responders use to triage and mitigate the incident.
