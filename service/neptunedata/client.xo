/// The fast reset REST API lets you reset a Neptune graph quicky and
/// easily, removing all of its data. Neptune fast reset is a two-step
/// process. First you call ExecuteFastReset with action set to
/// initiateDatabaseReset . This returns a UUID token which you then include
/// when calling ExecuteFastReset again with action set to
/// performDatabaseReset . See Empty an Amazon Neptune DB cluster using the
/// fast reset API . When invoking this operation in a Neptune cluster that
/// has IAM authentication enabled, the IAM user or role making the request
/// must have a policy attached that allows the neptune-db:ResetDatabase IAM
/// action in that cluster.
pub fn (c: Client) execute_fast_reset(input: ExecuteFastResetInput) -> ExecuteFastResetOutput ! ExecuteFastResetErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_execute_fast_reset(c.params, input)) ?? e => return Err(ExecuteFastResetErr.InvalidInput(e))
  var req = serialize_execute_fast_reset(ep, input, "") ?? e => return Err(ExecuteFastResetErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(ExecuteFastResetErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_execute_fast_reset_error(resp))
  }
  deserialize_execute_fast_reset(resp) ?? e => Err(ExecuteFastResetErr.Deserialize(e))
}

