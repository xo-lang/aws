/// An object that contains metrics about an ID mapping job, including
/// counts of input records, processed records, and mapped records between
/// source and target identifiers.
pub struct IdMappingJobMetrics {
  /// The total number of records that were input for processing.
  pub input_records: Int? = None
  /// The total number of records that were processed.
  pub total_records_processed: Int? = None
  /// The total number of records that did not get processed.
  pub records_not_processed: Int? = None
  /// The number of records processed that were marked for deletion in the
  /// input file using the DELETE schema mapping field. These are the records
  /// to be removed from the ID mapping table.
  pub delete_records_processed: Int? = None
  /// The total number of records that were mapped.
  pub total_mapped_records: Int? = None
  /// The total number of mapped source records.
  pub total_mapped_source_records: Int? = None
  /// The total number of distinct mapped target records.
  pub total_mapped_target_records: Int? = None
  /// The number of de-duplicated processed records across all runs, excluding
  /// deletion-related records. Duplicates are determined by the field marked
  /// as UNIQUE_ID in your schema mapping. Records sharing the same value in
  /// this field are considered duplicates. For example, if you specified
  /// "customer_id" as a UNIQUE_ID field and had three records with the same
  /// customer_id value, they would count as one unique record in this metric.
  pub unique_records_loaded: Int? = None
  /// The number of new mapped records.
  pub new_mapped_records: Int? = None
  /// The number of new source records mapped.
  pub new_mapped_source_records: Int? = None
  /// The number of new mapped target records.
  pub new_mapped_target_records: Int? = None
  /// The number of new unique records processed in the current job run, after
  /// removing duplicates. This metric excludes deletion-related records.
  /// Duplicates are determined by the field marked as UNIQUE_ID in your
  /// schema mapping. Records sharing the same value in this field are
  /// considered duplicates. For example, if your current run processes five
  /// new records with the same UNIQUE_ID value, they would count as one new
  /// unique record in this metric.
  pub new_unique_records_loaded: Int? = None
  /// The number of mapped records removed.
  pub mapped_records_removed: Int? = None
  /// The number of source records removed due to ID mapping.
  pub mapped_source_records_removed: Int? = None
  /// The number of mapped target records removed.
  pub mapped_target_records_removed: Int? = None
}

