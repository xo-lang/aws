  /// identifier. For example, for a AWS::DynamoDB::Table resource, the
  /// primary identifiers is TableName so the key-value pair could be
  /// "TableName": "MyDDBTable" . For more information, see primaryIdentifier
  /// in the CloudFormation Command Line Interface (CLI) User Guide .
  pub resource_identifier: Map[Str, Str]? = None
}

