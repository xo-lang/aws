/// The HTTP request of UntagResource.
pub fn serialize_untag_resource(ep: rest.Endpoint, input: UntagResourceRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_resource_arn = match input.resource_arn {
    Some(v) => v
    None => return Err("input member resourceArn is required")
  }
  if label_resource_arn == "" {
    return Err("input member resourceArn must not be empty")
  }
  if let Some(xs) = input.tag_keys {
    for x in xs {
      qs.push(("tagKeys", x))
    }
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "DELETE",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/tags/${rest.escape(label_resource_arn, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_untag_resource(resp: http.Response) -> UntagResourceResponse ! Str {
  var out = UntagResourceResponse{}
  Ok(out)
}

/// The errors of UntagResource.
pub enum UntagResourceErr {
  BadRequestException(e: BadRequestException)
  ConflictException(e: ConflictException)
  InternalFailureException(e: InternalFailureException)
  LimitExceededException(e: LimitExceededException)
  NotFoundException(e: NotFoundException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UntagResourceErr) display() -> Str {
  match e {
    BadRequestException(x) => "BadRequestException: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    InternalFailureException(x) => "InternalFailureException: ${x:?}"
    LimitExceededException(x) => "LimitExceededException: ${x:?}"
    NotFoundException(x) => "NotFoundException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_untag_resource_error(resp: http.Response) -> UntagResourceErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "BadRequestException" => match read_error_bad_request_exception(resp, body) {
      Ok(x) => return UntagResourceErr.BadRequestException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UntagResourceErr.ConflictException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    "InternalFailureException" => match read_error_internal_failure_exception(resp, body) {
      Ok(x) => return UntagResourceErr.InternalFailureException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    "LimitExceededException" => match read_error_limit_exceeded_exception(resp, body) {
      Ok(x) => return UntagResourceErr.LimitExceededException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    "NotFoundException" => match read_error_not_found_exception(resp, body) {
      Ok(x) => return UntagResourceErr.NotFoundException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    _ => {}
  }
  UntagResourceErr.Api(restjson.api_error(resp, body))
}

/// Removes tags from a bot, bot alias or bot channel.
pub fn (c: Client) untag_resource(input: UntagResourceRequest) -> UntagResourceResponse ! UntagResourceErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_untag_resource(c.params, input)) ?? e => return Err(UntagResourceErr.InvalidInput(e))
  var req = serialize_untag_resource(ep, input, "") ?? e => return Err(UntagResourceErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UntagResourceErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_untag_resource_error(resp))
  }
  deserialize_untag_resource(resp) ?? e => Err(UntagResourceErr.Deserialize(e))
}
