fn json_of_signal_exploitability(v: SignalExploitability) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.verdict {
    fs.push(("verdict", json.Value.Str(x.value())))
  }
  if let Some(x) = v.reached_crown_jewels {
    fs.push(("reachedCrownJewels", json.Value.Bool(x)))
  }
  if let Some(x) = v.highest_layer_reached {
    fs.push(("highestLayerReached", json.Value.Int(x)))
  }
  if let Some(x) = v.confidence_tier {
    fs.push(("confidenceTier", json.Value.Str(x.value())))
  }
  if let Some(x) = v.scriptable {
    fs.push(("scriptable", json.Value.Bool(x)))
