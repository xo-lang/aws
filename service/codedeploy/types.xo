/// Information about an instance in a deployment.
pub struct InstanceSummary {
  /// The unique ID of a deployment.
  pub deployment_id: Str? = None
  /// The instance ID.
  pub instance_id: Str? = None
  /// The deployment status for this instance: Pending : The deployment is
  /// pending for this instance. In Progress : The deployment is in progress
  /// for this instance. Succeeded : The deployment has succeeded for this
  /// instance. Failed : The deployment has failed for this instance. Skipped
  /// : The deployment has been skipped for this instance. Unknown : The
  /// deployment status is unknown for this instance.
  pub status: InstanceStatus? = None
  /// A timestamp that indicates when the instance information was last
  /// updated.
  pub last_updated_at: Time? = None
  /// A list of lifecycle events for this instance.
  pub lifecycle_events: List[LifecycleEvent]? = None
  /// Information about which environment an instance belongs to in a
  /// blue/green deployment. BLUE: The instance is part of the original
  /// environment. GREEN: The instance is part of the replacement environment.
  pub instance_type: InstanceType? = None
}

/// A target Amazon EC2 or on-premises instance during a deployment that
/// uses the EC2/On-premises compute platform.
pub struct InstanceTarget {
  /// The unique ID of a deployment.
  pub deployment_id: Str? = None
  /// The unique ID of a deployment target that has a type of instanceTarget .
  pub target_id: Str? = None
  /// The Amazon Resource Name (ARN) of the target.
  pub target_arn: Str? = None
  /// The status an EC2/On-premises deployment's target instance.
  pub status: TargetStatus? = None
  /// The date and time when the target instance was updated by a deployment.
  pub last_updated_at: Time? = None
  /// The lifecycle events of the deployment to this target instance.
  pub lifecycle_events: List[LifecycleEvent]? = None
  /// A label that identifies whether the instance is an original target (
  /// BLUE ) or a replacement target ( GREEN ).
  pub instance_label: TargetLabel? = None
}

