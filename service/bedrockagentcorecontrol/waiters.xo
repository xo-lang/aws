          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "UPDATE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "DELETE_FAILED") {
