fn xml_write_response_launch_template_data(var w: xmlv.Writer, v: ResponseLaunchTemplateData, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.kernel_id {
    xmlv.elem(w, "kernelId", x, [])
  }
  if let Some(x) = v.ebs_optimized {
    xmlv.elem(w, "ebsOptimized", "${x}", [])
  }
  if let Some(x) = v.iam_instance_profile {
    xml_write_launch_template_iam_instance_profile_specification(w, x, "iamInstanceProfile", [])
  }
  if let Some(x) = v.block_device_mappings {
    xml_write_launch_template_block_device_mapping_list(w, x, "blockDeviceMappingSet", [])
  }
  if let Some(x) = v.network_interfaces {
    xml_write_launch_template_instance_network_interface_specification_list(w, x, "networkInterfaceSet", [])
  }
  if let Some(x) = v.image_id {
    xmlv.elem(w, "imageId", x, [])
  }
  if let Some(x) = v.instance_type {
    xmlv.elem(w, "instanceType", x.value(), [])
  }
  if let Some(x) = v.key_name {
    xmlv.elem(w, "keyName", x, [])
  }
  if let Some(x) = v.monitoring {
    xml_write_launch_templates_monitoring(w, x, "monitoring", [])
  }
  if let Some(x) = v.placement {
    xml_write_launch_template_placement(w, x, "placement", [])
  }
  if let Some(x) = v.ram_disk_id {
    xmlv.elem(w, "ramDiskId", x, [])
  }
  if let Some(x) = v.disable_api_termination {
    xmlv.elem(w, "disableApiTermination", "${x}", [])
  }
  if let Some(x) = v.instance_initiated_shutdown_behavior {
    xmlv.elem(w, "instanceInitiatedShutdownBehavior", x.value(), [])
  }
  if let Some(x) = v.user_data {
    xmlv.elem(w, "userData", x, [])
  }
  if let Some(x) = v.tag_specifications {
    xml_write_launch_template_tag_specification_list(w, x, "tagSpecificationSet", [])
  }
  if let Some(x) = v.elastic_gpu_specifications {
    xml_write_elastic_gpu_specification_response_list(w, x, "elasticGpuSpecificationSet", [])
  }
  if let Some(x) = v.elastic_inference_accelerators {
    xml_write_launch_template_elastic_inference_accelerator_response_list(w, x, "elasticInferenceAcceleratorSet", [])
  }
  if let Some(x) = v.security_group_ids {
    xml_write_value_string_list(w, x, "securityGroupIdSet", [])
  }
  if let Some(x) = v.security_groups {
    xml_write_value_string_list(w, x, "securityGroupSet", [])
  }
  if let Some(x) = v.instance_market_options {
    xml_write_launch_template_instance_market_options(w, x, "instanceMarketOptions", [])
  }
  if let Some(x) = v.credit_specification {
    xml_write_credit_specification(w, x, "creditSpecification", [])
  }
  if let Some(x) = v.cpu_options {
    xml_write_launch_template_cpu_options(w, x, "cpuOptions", [])
  }
  if let Some(x) = v.capacity_reservation_specification {
    xml_write_launch_template_capacity_reservation_specification_response(w, x, "capacityReservationSpecification", [])
  }
  if let Some(x) = v.license_specifications {
    xml_write_launch_template_license_list(w, x, "licenseSet", [])
  }
  if let Some(x) = v.hibernation_options {
    xml_write_launch_template_hibernation_options(w, x, "hibernationOptions", [])
  }
  if let Some(x) = v.metadata_options {
    xml_write_launch_template_instance_metadata_options(w, x, "metadataOptions", [])
  }
  if let Some(x) = v.enclave_options {
    xml_write_launch_template_enclave_options(w, x, "enclaveOptions", [])
  }
  if let Some(x) = v.instance_requirements {
    xml_write_instance_requirements(w, x, "instanceRequirements", [])
  }
  if let Some(x) = v.private_dns_name_options {
    xml_write_launch_template_private_dns_name_options(w, x, "privateDnsNameOptions", [])
  }
  if let Some(x) = v.maintenance_options {
    xml_write_launch_template_instance_maintenance_options(w, x, "maintenanceOptions", [])
  }
  if let Some(x) = v.disable_api_stop {
    xmlv.elem(w, "disableApiStop", "${x}", [])
