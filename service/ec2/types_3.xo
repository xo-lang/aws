/// The instance details to specify which volumes should be snapshotted.
pub struct InstanceSpecification {
  /// The instance to specify which volumes should be snapshotted.
  pub instance_id: Str? = None
  /// Excludes the root volume from being snapshotted.
  pub exclude_boot_volume: Bool? = None
  /// The IDs of the data (non-root) volumes to exclude from the multi-volume
  /// snapshot set. If you specify the ID of the root volume, the request
  /// fails. To exclude the root volume, use ExcludeBootVolume . You can
  /// specify up to 40 volume IDs per request.
  pub exclude_data_volume_ids: List[Str]? = None
}

/// Describes the current state of an instance.
pub struct InstanceState {
  /// The state of the instance as a 16-bit unsigned integer. The high byte is
  /// all of the bits between 2^8 and (2^16)-1, which equals decimal values
  /// between 256 and 65,535. These numerical values are used for internal
  /// purposes and should be ignored. The low byte is all of the bits between
  /// 2^0 and (2^8)-1, which equals decimal values between 0 and 255. The
  /// valid values for instance-state-code will all be in the range of the low
  /// byte and they are: 0 : pending 16 : running 32 : shutting-down 48 :
  /// terminated 64 : stopping 80 : stopped You can ignore the high byte value
  /// by zeroing out all of the bits above 2^8 or 256 in decimal.
  pub code: Int? = None
  /// The current state of the instance.
  pub name: InstanceStateName? = None
}

/// Describes an instance state change.
pub struct InstanceStateChange {
  /// The ID of the instance.
  pub instance_id: Str? = None
  /// The current state of the instance.
  pub current_state: InstanceState? = None
  /// The previous state of the instance.
  pub previous_state: InstanceState? = None
}

pub enum InstanceStateName: Str {
  Pending = "pending"
  Running = "running"
  ShuttingDown = "shutting-down"
  Terminated = "terminated"
  Stopping = "stopping"
  Stopped = "stopped"
  Unknown(value: Str)
}

/// Describes the status of an instance, including system status, instance
/// status, attached EBS status, application status, and performance status.
pub struct InstanceStatus {
  /// The Availability Zone of the instance.
  pub availability_zone: Str? = None
  /// The ID of the Availability Zone of the instance.
  pub availability_zone_id: Str? = None
  /// The Amazon Resource Name (ARN) of the Outpost.
  pub outpost_arn: Str? = None
  /// The service provider that manages the instance.
  pub operator: OperatorResponse? = None
  /// Any scheduled events associated with the instance.
  pub events: List[InstanceStatusEvent]? = None
  /// The ID of the instance.
  pub instance_id: Str? = None
  /// The intended state of the instance. DescribeInstanceStatus requires that
  /// an instance be in the running state.
  pub instance_state: InstanceState? = None
  /// Reports impaired functionality that stems from issues internal to the
  /// instance, such as impaired reachability.
  pub instance_status: InstanceStatusSummary? = None
  /// Reports impaired functionality that stems from issues related to the
  /// systems that support an instance, such as hardware failures and network
  /// connectivity problems.
  pub system_status: InstanceStatusSummary? = None
  /// Reports impaired functionality that stems from an attached Amazon EBS
  /// volume that is unreachable and unable to complete I/O operations.
  pub attached_ebs_status: EbsStatusSummary? = None
  /// Reports the application-level health status for the instance.
  pub application_status: ApplicationStatusSummary? = None
  /// Reports the performance-related health status for the instance. This
  /// information is returned only when performance status checks are enabled
  /// for the instance.
  pub performance_status: PerformanceStatusSummary? = None
}

/// Describes the instance status.
pub struct InstanceStatusDetails {
  /// The time when a status check failed. For an instance that was launched
  /// and impaired, this is the time when the instance was launched.
  pub impaired_since: Time? = None
  /// The type of instance status.
  pub name: StatusName? = None
  /// The status.
  pub status: StatusType? = None
}

/// Describes a scheduled event for an instance.
pub struct InstanceStatusEvent {
  /// The ID of the event.
  pub instance_event_id: Str? = None
  /// The event code.
  pub code: EventCode? = None
  /// A description of the event. After a scheduled event is completed, it can
  /// still be described for up to a week. If the event has been completed,
  /// this description starts with the following text: [Completed].
  pub description: Str? = None
  /// The latest scheduled end time for the event.
  pub not_after: Time? = None
  /// The earliest scheduled start time for the event.
  pub not_before: Time? = None
  /// The deadline for starting the event.
  pub not_before_deadline: Time? = None
}

/// Describes the status of an instance.
pub struct InstanceStatusSummary {
  /// The system instance health or application instance health.
  pub details: List[InstanceStatusDetails]? = None
  /// The status.
  pub status: SummaryStatus? = None
}

pub enum InstanceStorageEncryptionSupport: Str {
  Unsupported = "unsupported"
  Required = "required"
  Unknown(value: Str)
}

/// Describes the instance store features that are supported by the instance
/// type.
pub struct InstanceStorageInfo {
  /// The total size of the disks, in GB.
  pub total_size_in_gb: Int? = None
  /// Describes the disks that are available for the instance type.
  pub disks: List[DiskInfo]? = None
  /// Indicates whether non-volatile memory express (NVMe) is supported.
  pub nvme_support: EphemeralNvmeSupport? = None
  /// Indicates whether data is encrypted at rest.
  pub encryption_support: InstanceStorageEncryptionSupport? = None
}

/// Describes the registered tag keys for the current Region.
pub struct InstanceTagNotificationAttribute {
  /// The registered tag keys.
  pub instance_tag_keys: List[Str]? = None
  /// Indicates wheter all tag keys in the current Region are registered to
  /// appear in scheduled event notifications. true indicates that all tag
  /// keys in the current Region are registered.
  pub include_all_tags_of_instance: Bool? = None
}

/// Information about the instance topology.
pub struct InstanceTopology {
  /// The instance ID.
  pub instance_id: Str? = None
  /// The instance type.
  pub instance_type: Str? = None
  /// The name of the placement group that the instance is in.
  pub group_name: Str? = None
  /// The network nodes. The nodes are hashed based on your account. Instances
  /// from different accounts running under the same server will return a
  /// different hashed list of strings. The value is null or empty if: The
  /// instance type is not supported. The instance is in a state other than
  /// running .
  pub network_nodes: List[Str]? = None
  /// The name of the Availability Zone or Local Zone that the instance is in.
  pub availability_zone: Str? = None
  /// The ID of the Availability Zone or Local Zone that the instance is in.
  pub zone_id: Str? = None
  /// The ID of the Capacity Block. This parameter is only supported for
  /// UltraServer instances and identifies instances within the UltraServer
  /// domain.
  pub capacity_block_id: Str? = None
}

