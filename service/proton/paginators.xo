pub fn new_list_tags_for_resource_paginator(c: Client, input: ListTagsForResourceInput) -> ListTagsForResourcePaginator {
  ListTagsForResourcePaginator{client: c with {transport: transport.with_feature(c.transport, "C")}, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: ListTagsForResourcePaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: ListTagsForResourcePaginator) next_page() -> ListTagsForResourceOutput ! ListTagsForResourceErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_tags_for_resource(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
