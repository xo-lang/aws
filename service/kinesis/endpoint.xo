                                    if params.use_fips && params.use_dual_stack {
                                      if partition_result.supports_fips {
                                        if partition_result.supports_dual_stack {
                                          return Ok(endpoints.Endpoint{
                                            url: "https://${channel_id}." +
                                              "${operation_type}-kinesis-fips.${region}." +
                                              "${partition_result.dual_stack_dns_suffix}",
                                          })
                                        }
                                        return Err(endpoints.RuleErr{
                                          msg: "DualStack is enabled, but this partition " +
                                            "does not support DualStack.",
                                        })
                                      }
                                      return Err(endpoints.RuleErr{
                                        msg: "FIPS is enabled, but this partition does not " +
                                          "support FIPS.",
                                      })
                                    }
                                    if params.use_fips {
                                      if partition_result.supports_fips {
                                        return Ok(endpoints.Endpoint{
                                          url: "https://${channel_id}." +
                                            "${operation_type}-kinesis-fips.${region}." +
                                            "${partition_result.dns_suffix}",
                                        })
                                      }
                                      return Err(endpoints.RuleErr{
                                        msg: "FIPS is enabled but this partition does not " +
                                          "support FIPS",
                                      })
                                    }
                                    if params.use_dual_stack {
                                      if partition_result.supports_dual_stack {
                                        return Ok(endpoints.Endpoint{
                                          url: "https://${channel_id}." +
                                            "${operation_type}-kinesis.${region}." +
                                            "${partition_result.dual_stack_dns_suffix}",
                                        })
                                      }
                                      return Err(endpoints.RuleErr{
                                        msg: "DualStack is enabled but this partition does " +
                                          "not support DualStack",
                                      })
                                    }
                                    return Ok(endpoints.Endpoint{
                                      url: "https://${channel_id}." +
                                        "${operation_type}-kinesis.${region}." +
                                        "${partition_result.dns_suffix}",
                                    })
                                  }
                                  return Err(endpoints.RuleErr{
                                    msg: "ChannelARN does not support the `data` operation " +
                                      "type.",
                                  })
                                }
                                return Err(endpoints.RuleErr{
                                  msg: "Invalid ARN: Invalid channel id.",
                                })
                              }
                              return Err(endpoints.RuleErr{
                                msg: "Invalid ARN: Missing channel id.",
                              })
                            }
                            return Err(endpoints.RuleErr{
                              msg: "Operation Type is not set. Please contact service team " +
                                "for resolution.",
                            })
                          }
                          return Err(endpoints.RuleErr{
                            msg: "Partition: ${arn.partition} from ARN doesn't match with " +
                              "partition name: ${partition_result.name}.",
                          })
                        }
                        return Err(endpoints.RuleErr{
                          msg: "Invalid ARN: ChannelARN only supports `channel` arn types, " +
                            "found: `${arn_type}`.",
                        })
                      }
                    }
                    return Err(endpoints.RuleErr{msg: "Invalid ARN: No ARN type specified"})
                  }
                  return Err(endpoints.RuleErr{
                    msg: "Invalid ARN: The ARN was not for the Kinesis service, found: " +
                      "${arn.service}.",
                  })
                }
                return Err(endpoints.RuleErr{msg: "Invalid ARN: Invalid region."})
              }
              return Err(endpoints.RuleErr{msg: "Invalid ARN: Invalid account id."})
            }
            return Err(endpoints.RuleErr{msg: "Invalid ARN: Failed to parse ARN."})
          }
        }
      }
    }
  }
  if params.endpoint.is_none() {
    if let Some(account_id_endpoint_mode) = params.account_id_endpoint_mode {
      if !(account_id_endpoint_mode == "disabled") {
        if let Some(account_id) = params.account_id {
          if let Some(region) = params.region {
            if let Some(partition_result) = endpoints.partition(region) {
              if !(partition_result.name == "aws-iso") &&
                  !(partition_result.name == "aws-iso-b") {
                if endpoints.is_valid_host_label(account_id, false) {
                  if let Some(operation_type) = params.operation_type {
                    if params.use_fips && params.use_dual_stack {
                      if partition_result.supports_fips {
                        if partition_result.supports_dual_stack {
                          return Ok(endpoints.Endpoint{
                            url: "https://${account_id}.${operation_type}-kinesis-fips." +
                              "${region}.${partition_result.dual_stack_dns_suffix}",
                            metric_values: ["O"],
                          })
                        }
                        return Err(endpoints.RuleErr{
                          msg: "DualStack is enabled, but this partition does not support " +
                            "DualStack.",
                        })
                      }
                      return Err(endpoints.RuleErr{
                        msg: "FIPS is enabled, but this partition does not support FIPS.",
                      })
                    }
                    if params.use_fips {
                      if partition_result.supports_fips {
                        return Ok(endpoints.Endpoint{
                          url: "https://${account_id}.${operation_type}-kinesis-fips." +
                            "${region}.${partition_result.dns_suffix}",
                          metric_values: ["O"],
                        })
                      }
                      return Err(endpoints.RuleErr{
                        msg: "FIPS is enabled but this partition does not support FIPS",
                      })
                    }
                    if params.use_dual_stack {
                      if partition_result.supports_dual_stack {
                        return Ok(endpoints.Endpoint{
                          url: "https://${account_id}.${operation_type}-kinesis.${region}." +
                            "${partition_result.dual_stack_dns_suffix}",
                          metric_values: ["O"],
                        })
                      }
                      return Err(endpoints.RuleErr{
                        msg: "DualStack is enabled but this partition does not support " +
                          "DualStack",
                      })
                    }
                    return Ok(endpoints.Endpoint{
                      url: "https://${account_id}.${operation_type}-kinesis.${region}." +
                        "${partition_result.dns_suffix}",
                      metric_values: ["O"],
                    })
                  }
                  return Err(endpoints.RuleErr{
                    msg: "Operation Type is not set. Please contact service team for " +
                      "resolution.",
                  })
                }
                return Err(endpoints.RuleErr{msg: "Invalid account id."})
              }
            }
          }
        }
      }
    }
  }
  if params.endpoint.is_none() {
    if let Some(account_id_endpoint_mode) = params.account_id_endpoint_mode {
      if account_id_endpoint_mode == "required" {
        if let Some(region) = params.region {
          if let Some(partition_result) = endpoints.partition(region) {
            if !(partition_result.name == "aws-iso") &&
                !(partition_result.name == "aws-iso-b") {
              return Err(endpoints.RuleErr{
                msg: "AccountIdEndpointMode is required but no AccountID was provided or " +
                  "able to be loaded",
              })
            }
            return Err(endpoints.RuleErr{
              msg: "Invalid Configuration: AccountIdEndpointMode is required but account " +
                "endpoints are not supported in this partition",
            })
          }
        }
      }
    }
  }
  if let Some(endpoint) = params.endpoint {
    if params.use_fips {
      return Err(endpoints.RuleErr{
        msg: "Invalid Configuration: FIPS and custom endpoint are not supported",
      })
    }
    if params.use_dual_stack {
      return Err(endpoints.RuleErr{
        msg: "Invalid Configuration: Dualstack and custom endpoint are not supported",
      })
    }
    return Ok(endpoints.Endpoint{
      url: endpoint,
    })
  }
  if let Some(region) = params.region {
    if let Some(partition_result) = endpoints.partition(region) {
      if params.use_fips && params.use_dual_stack {
        if partition_result.supports_fips && partition_result.supports_dual_stack {
          return Ok(endpoints.Endpoint{
            url: "https://kinesis-fips.${region}.${partition_result.dual_stack_dns_suffix}",
          })
        }
        return Err(endpoints.RuleErr{
          msg: "FIPS and DualStack are enabled, but this partition does not support one or both",
        })
      }
      if params.use_fips {
        if partition_result.supports_fips {
          if partition_result.name == "aws-us-gov" {
            return Ok(endpoints.Endpoint{
              url: "https://kinesis.${region}.amazonaws.com",
            })
          }
          return Ok(endpoints.Endpoint{
            url: "https://kinesis-fips.${region}.${partition_result.dns_suffix}",
          })
        }
        return Err(endpoints.RuleErr{
          msg: "FIPS is enabled but this partition does not support FIPS",
        })
      }
      if params.use_dual_stack {
        if partition_result.supports_dual_stack {
          return Ok(endpoints.Endpoint{
            url: "https://kinesis.${region}.${partition_result.dual_stack_dns_suffix}",
          })
        }
        return Err(endpoints.RuleErr{
          msg: "DualStack is enabled but this partition does not support DualStack",
        })
      }
      return Ok(endpoints.Endpoint{
        url: "https://kinesis.${region}.${partition_result.dns_suffix}",
      })
    }
    return Err(endpoints.RuleErr{msg: "rules in a matched tree rule were exhausted"})
  }
  return Err(endpoints.RuleErr{msg: "Invalid Configuration: Missing Region"})
}
