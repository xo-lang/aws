  /// The Size parameter is only required when the mode is CUSTOM_ROWS. The
  /// profile job is run on the specified number of rows. The maximum value
  /// for size is Long.MAX_VALUE. Long.MAX_VALUE = 9223372036854775807
  pub size: Int? = None
}

