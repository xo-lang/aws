fn json_of_rule_action(v: RuleAction) -> json.Value {
  match v {
    Forward(x) => json.Value.Object([("forward", json_of_forward_action(x))])
    FixedResponse(x) => json.Value.Object([("fixedResponse", json_of_fixed_response_action(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_rule_action(v: json.Value) -> RuleAction ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "forward" => Ok(RuleAction.Forward(from_json_forward_action(fv)?))
      "fixedResponse" => Ok(RuleAction.FixedResponse(from_json_fixed_response_action(fv)?))
      _ => Ok(RuleAction.Unknown(k))
    }
  }
  Err("RuleAction: no member set")
}

