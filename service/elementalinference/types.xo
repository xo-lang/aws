  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

pub enum ScheduleActionStatus: Str {
  Pending = "PENDING"
  Completed = "COMPLETED"
  Failed = "FAILED"
  Unknown(value: Str)
}

/// A filter for a fixture search. It is used in the filters array of a
/// SearchFixtures request.
pub struct SearchFilter {
  /// The dimension of the fixture to filter on. Valid values: COMPETITOR.
  pub name: FilterName? = None
  /// An array of values to match in the dimension that you specified in name.
  /// You can specify up to 10 values. A fixture appears in the results if it
  /// matches at least one of these values.
  pub values: List[Str]? = None
}

pub struct SearchFixturesRequest {
  /// The sport to search for fixtures. Valid values: basketball (search for
  /// basketball fixtures), american-football (search for american-football
  /// fixtures).
  pub sport: DataSourceSport? = None
  /// The first day of the search window, in UTC. The search includes fixtures
  /// that are scheduled on this day. Specify the date in ISO 8601 format, as
  /// YYYY-MM-DD . For example, 2026-03-14.
  pub start_date: Str? = None
  /// The last day of the search window, in UTC. The search includes fixtures
  /// that are scheduled on this day. Specify the date in ISO 8601 format, as
  /// YYYY-MM-DD . If you omit this parameter, Elemental Inference searches
  /// only the day that you specified in startDate. The window from startDate
  /// through endDate must not exceed seven days.
  pub end_date: Str? = None
  /// An array of filters that narrow the results. Each filter applies to one
  /// dimension of a fixture, such as the competitor. You can specify up to 10
  /// filters. A fixture must satisfy every filter in the array in order to
  /// appear in the results. Within one filter, a fixture must match at least
  /// one of the values.
  pub filters: List[SearchFilter]? = None
  /// The maximum number of fixtures to return for each API request. The
  /// service might return fewer fixtures than the maxResults value. When more
  /// fixtures match the search, the response also includes a nextToken value
  /// that you can use to fetch the next batch of results.
  pub max_results: Int? = None
  /// The token that identifies the batch of results that you want to see. For
  /// example, you submit a SearchFixtures request with maxResults set at 5.
  /// The service returns the first batch of results (up to 5) and a nextToken
  /// value. To see the next batch of results, you submit the SearchFixtures
  /// request a second time, with the same search criteria, and specify the
  /// nextToken value.
  pub next_token: Str? = None
}

pub struct SearchFixturesResponse {
  /// An array of FixtureSummary objects, one for each fixture that matches
  /// the search. The array is empty if no fixtures match.
  pub fixtures: List[FixtureSummary]? = None
  /// The token that identifies the next batch of results. To see the next
  /// batch, submit the SearchFixtures request again, with the same search
  /// criteria, and specify this value in nextToken. This parameter is absent
  /// when there are no more results to return.
  pub next_token: Str? = None
}

/// The request was rejected because it would exceed one or more service
/// quotas for your account. Review your service quotas and either delete
/// unused resources or request a quota increase.
pub struct ServiceQuotaExceededException {
  pub message: Str? = None
}

/// The service is temporarily unable to handle the request. Retry the
/// request. If the problem persists, contact AWS Support.
pub struct ServiceUnavailableException {
  pub message: Str? = None
}

/// A type of OutputConfig, used when the output in a feed is for the smart
/// subtitling feature. Smart subtitling uses automatic speech recognition
/// (ASR) to generate live TTML subtitles from the audio in your source
/// media.
pub struct SubtitlingConfig {
  /// The language of the audio in the source media. Elemental Inference uses
  /// this setting to optimize transcription accuracy. Specify the language
  /// using an ISO 639-2/T three-letter code, optionally with a region subtag.
  /// Supported values: eng, eng-au, eng-gb, eng-us, fra, ita, deu, spa, por.
  pub language: TranscriptionLanguage? = None
  /// The aspect ratio of the output video, specified as width and height
  /// integer values. Elemental Inference uses the aspect ratio to determine
  /// subtitle layout and line lengths.
  pub aspect_ratio: AspectRatio? = None
  /// The ID of a custom dictionary to improve transcription accuracy for
  /// domain-specific terminology. Use the CreateDictionary operation to
  /// create a dictionary.
  pub dictionary: Str? = None
  /// Controls how profanity is handled in the generated subtitles. Valid
  /// values: DISABLED (no filtering, default), CENSOR (replace profanity with
  /// asterisks), DROP (remove profanity from the transcript).
  pub profanity_filter: ProfanityFilterMode? = None
}

pub enum SummaryGenerationMode: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

pub struct TagResourceRequest {
  /// The ARN of the resource where you want to add tags.
  pub resource_arn: Str? = None
  /// A list of tags to add to the resource.
  pub tags: Map[Str, Str]? = None
}

/// A named set of graphics-compositing templates used by the crop feature,
/// specified in the templateGroups array of a CroppingConfig.
pub struct TemplateGroup {
  /// A name for the template group.
  pub name: Str? = None
  /// An array of Amazon S3 URIs that point to the graphics-compositing
  /// templates for this group. You can specify 1 or 2 URIs. Each URI must be
  /// in the form s3://bucket-name/key . Elemental Inference reads these
  /// templates using the IAM role that you specify in accessRoleArn.
  pub template_uris: List[Str]? = None
}

/// The request was denied due to request throttling. Too many requests have
/// been made within a given time period. Reduce the frequency of requests
/// and use exponential backoff when retrying.
pub struct TooManyRequestException {
  pub message: Str? = None
}

pub enum TranscriptionLanguage: Str {
  Eng = "eng"
  EngAu = "eng-au"
  EngGb = "eng-gb"
  EngUs = "eng-us"
  Fra = "fra"
  Ita = "ita"
  Deu = "deu"
  Spa = "spa"
  Por = "por"
  Unknown(value: Str)
}

pub struct UntagResourceRequest {
  /// The ARN of the resource where you want to delete one or more tags.
  pub resource_arn: Str? = None
  /// The keys of the tags to delete.
  pub tag_keys: List[Str]? = None
}

/// Attaches a game to an event clipping output at the action's scheduled
/// time. This is a type of ScheduleActionOperation, and the output must be
/// an event clipping output.
pub struct UpdateClippingDataSourceConfiguration {
  /// The name of the output that you want to attach the game to.
  pub output_name: Str? = None
  /// The game that you want to attach to the output.
  pub data_source_configuration: DataSourceConfiguration? = None
}

pub struct UpdateDictionaryRequest {
  /// The ID of the dictionary to update.
  pub id: Str? = None
  /// A new name for the dictionary. If not specified, the name is not
  /// changed.
  pub name: Str? = None
  /// A new language for the dictionary. If not specified, the language is not
  /// changed.
  pub language: DictionaryLanguage? = None
  /// New dictionary entries. If not specified, the entries are not changed.
  pub entries: Str? = None
}

pub struct UpdateDictionaryResponse {
  /// The updated or original name of the dictionary.
  pub name: Str? = None
  /// The ARN of the dictionary.
  pub arn: Str? = None
  /// The ID of the dictionary.
  pub id: Str? = None
  /// The updated or original language of the dictionary.
  pub language: DictionaryLanguage? = None
  /// The current status of the dictionary.
  pub status: DictionaryStatus? = None
  /// A list of feed IDs that reference this dictionary.
  pub references: List[Str]? = None
  /// Any tags associated with the dictionary.
  pub tags: Map[Str, Str]? = None
}

pub struct UpdateFeedRequest {
  /// Required. You can specify the existing name (to leave it unchanged) or a
  /// new name.
  pub name: Str? = None
  /// The ARN of an IAM role that Elemental Inference assumes to access
  /// resources in your account on your behalf. You can specify the existing
  /// role (to leave it unchanged) or a new role. You specify one access role
  /// for each feed.
  pub access_role_arn: Str? = None
  /// The ID of the feed to update.
  pub id: Str? = None
  /// Required. You can specify the existing array of outputs (to leave
  /// outputs unchanged) or you can specify a new array.
  pub outputs: List[UpdateOutput]? = None
}

pub struct UpdateFeedResponse {
  /// The ARN of the feed.
  pub arn: Str? = None
  /// The updated or original name of the feed.
  pub name: Str? = None
  /// The ID of the feed.
  pub id: Str? = None
  /// The data endpoints of the feed.
  pub data_endpoints: List[Str]? = None
  /// The array of outputs in the feed. You might have left this array
  /// unchanged, or you might have changed it.
  pub outputs: List[GetOutput]? = None
  /// The Amazon Resource Name (ARN) of the AWS Identity and Access Management
  /// (IAM) role for the feed, after the update. This property is absent if
  /// the feed doesn't have an IAM role.
  pub access_role_arn: Str? = None
  /// The status of the feed.
  pub status: FeedStatus? = None
  /// Information about the resource that is associated with the feed, if any.
  pub association: FeedAssociation? = None
  /// The tags associated with the feed.
  pub tags: Map[Str, Str]? = None
}

/// Contains configuration information about one output in a feed. It is
/// used in the UpdateFeed action.
pub struct UpdateOutput {
  /// The name of the output.
  pub name: Str? = None
  /// A typed property for an output in a feed. It identifies the action for
  /// Elemental Inference to perform. It also provides a repository for the
  /// results of that action. For example, CroppingConfig output will contain
  /// the metadata for the crop feature.
  pub output_config: OutputConfig? = None
  /// The status of the output.
  pub status: OutputStatus? = None
  /// A description of the output.
  pub description: Str? = None
  /// Elemental Inference originally sets this parameter to True if this
  /// output was created by AssociateFeed or to False if this output was
  /// created by CreateFeed or UpdateFeed. You must not change this value.
  /// Therefore, use GetFeed to determine the current value. Then in the
  /// UpdateFeed request, if the current value is True, include this parameter
  /// with a value of True. If it's False, omit the parameter.
  pub from_association: Bool? = None
}

/// Enables or disables an output at the action's scheduled time. This is a
/// type of ScheduleActionOperation.
pub struct UpdateOutputStatus {
  /// The name of the output that you want to enable or disable. The output
  /// must exist in the feed when you create the action.
  pub output_name: Str? = None
  /// Specifies whether the output is enabled or disabled after the action
  /// runs.
  pub status: OutputStatus? = None
}

/// The input fails to satisfy the constraints specified by the service.
/// Check the error message for details about which parameter or field is
/// invalid and correct the request before retrying.
pub struct ValidationException {
  pub message: Str? = None
}
