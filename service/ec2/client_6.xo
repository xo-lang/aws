    xmlv.elem(w, "instanceType", x.value(), [])
  }
  if let Some(x) = v.key_name {
    xmlv.elem(w, "keyName", x, [])
  }
  if let Some(x) = v.monitoring {
    xml_write_launch_templates_monitoring(w, x, "monitoring", [])
  }
  if let Some(x) = v.placement {
    xml_write_launch_template_placement(w, x, "placement", [])
  }
  if let Some(x) = v.ram_disk_id {
    xmlv.elem(w, "ramDiskId", x, [])
  }
  if let Some(x) = v.disable_api_termination {
    xmlv.elem(w, "disableApiTermination", "${x}", [])
  }
  if let Some(x) = v.instance_initiated_shutdown_behavior {
    xmlv.elem(w, "instanceInitiatedShutdownBehavior", x.value(), [])
  }
  if let Some(x) = v.user_data {
    xmlv.elem(w, "userData", x, [])
  }
  if let Some(x) = v.tag_specifications {
    xml_write_launch_template_tag_specification_list(w, x, "tagSpecificationSet", [])
  }
  if let Some(x) = v.elastic_gpu_specifications {
    xml_write_elastic_gpu_specification_response_list(w, x, "elasticGpuSpecificationSet", [])
  }
  if let Some(x) = v.elastic_inference_accelerators {
    xml_write_launch_template_elastic_inference_accelerator_response_list(w, x, "elasticInferenceAcceleratorSet", [])
  }
  if let Some(x) = v.security_group_ids {
    xml_write_value_string_list(w, x, "securityGroupIdSet", [])
