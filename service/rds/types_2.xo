  pub min_capacity: Float? = None
  /// Specifies the upper Aurora Serverless v2 capacity limit for a particular
  /// engine version or platform version. Depending on the engine version, the
  /// maximum capacity for an Aurora Serverless v2 cluster might be 256 or 128
  /// .
  pub max_capacity: Float? = None
}

/// This data type is used as a response element in the action
/// DescribeServerlessV2PlatformVersions .
pub struct ServerlessV2PlatformVersionInfo {
  /// The version number of the serverless platform.
  pub serverless_v2_platform_version: Str? = None
  /// The description of the serverless platform.
  pub serverless_v2_platform_version_description: Str? = None
  /// The name of the database engine.
  pub engine: Str? = None
  /// Specifies any Aurora Serverless v2 properties or limits that differ
  /// between Aurora Serverless v2 platform versions. You can retrieve the
  /// platform version of an existing DB cluster and check whether that
  /// version supports certain Aurora Serverless v2 features before you
  /// attempt to use those features.
  pub serverless_v2_features_support: ServerlessV2FeaturesSupport? = None
  /// The status of the serverless platform. Valid statuses are the following:
