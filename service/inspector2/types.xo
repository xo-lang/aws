/// Contains details about a specific vulnerability Amazon Inspector can
/// detect.
pub struct Vulnerability {
  /// The ID for the specific vulnerability.
  pub id: Str? = None
  /// The Common Weakness Enumeration (CWE) associated with the vulnerability.
  pub cwes: List[Str]? = None
  /// An object that contains the Cybersecurity and Infrastructure Security
  /// Agency (CISA) details for the vulnerability.
  pub cisa_data: CisaData? = None
  /// The source of the vulnerability information. Possible results are RHEL ,
  /// AMAZON_CVE , DEBIAN or NVD .
  pub source: Str? = None
  /// A description of the vulnerability.
  pub description: Str? = None
  /// An object that contains information about the Amazon Web Services Threat
  /// Intel Group (ATIG) details for the vulnerability.
  pub atig_data: AtigData? = None
  /// The severity assigned by the vendor.
  pub vendor_severity: Str? = None
  /// An object that contains the Common Vulnerability Scoring System (CVSS)
  /// Version 4 details for the vulnerability.
  pub cvss4: Cvss4? = None
  /// An object that contains the Common Vulnerability Scoring System (CVSS)
  /// Version 3 details for the vulnerability.
  pub cvss3: Cvss3? = None
  /// A list of related vulnerabilities.
  pub related_vulnerabilities: List[Str]? = None
  /// An object that contains the Common Vulnerability Scoring System (CVSS)
  /// Version 2 details for the vulnerability.
  pub cvss2: Cvss2? = None
  /// The date and time when the vendor created this vulnerability.
  pub vendor_created_at: Time? = None
  /// The date and time when the vendor last updated this vulnerability.
  pub vendor_updated_at: Time? = None
  /// A link to the official source material for this vulnerability.
  pub source_url: Str? = None
  /// Links to various resources with more information on this vulnerability.
  pub reference_urls: List[Str]? = None
  /// An object that contains details on when the exploit was observed.
  pub exploit_observed: ExploitObserved? = None
  /// Platforms that the vulnerability can be detected on.
  pub detection_platforms: List[Str]? = None
  /// An object that contains the Exploit Prediction Scoring System (EPSS)
  /// score for a vulnerability.
  pub epss: Epss? = None
}

