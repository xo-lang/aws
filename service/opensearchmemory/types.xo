}

/// Information about a request field that failed validation.
pub struct ValidationExceptionField {
  /// The field name.
  pub name: Str? = None
  /// A message that describes why the field failed validation.
  pub message: Str? = None
}

/// Possible reasons a request failed validation. New values can be added,
/// so treat an unknown value as a general validation failure.
pub enum ValidationExceptionReason: Str {
  DisallowedQueryType = "disallowedQueryType"
  NonFilterableField = "nonFilterableField"
  UnknownField = "unknownField"
  FieldIndexMismatch = "fieldIndexMismatch"
  QueryNestingTooDeep = "queryNestingTooDeep"
  UnboundedPattern = "unboundedPattern"
  QueryBodyTooLarge = "queryBodyTooLarge"
  MalformedQueryBody = "malformedQueryBody"
  InvalidNextToken = "invalidNextToken"
  FieldValidationFailed = "fieldValidationFailed"
  UnsupportedParameter = "unsupportedParameter"
  UnsupportedField = "unsupportedField"
  Other = "other"
  Unknown(value: Str)
}
