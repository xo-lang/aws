  if let Some(x) = v.column_name {
    fs.push(("ColumnName", json.Value.Str(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_column_tag_list(x)))
  }
  json.Value.Object(fs)
}

fn from_json_tag_column_operation(v: json.Value) -> TagColumnOperation ! Str {
  var out = TagColumnOperation{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ColumnName" => out.column_name = jsonv.read_str(fv)?
      "Tags" => out.tags = from_json_column_tag_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_tag_key_list(v: List[Str]) -> json.Value {
  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

fn from_json_tag_key_list(v: json.Value) -> List[Str] ! Str {
  var out: List[Str] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(jsonv.read_str(fv)?)
  }
  Ok(out)
}

