fn json_of_rag_config(v: RAGConfig) -> json.Value {
  match v {
    KnowledgeBaseConfig(x) => json.Value.Object([("knowledgeBaseConfig", json_of_knowledge_base_config(x))])
    PrecomputedRagSourceConfig(x) => json.Value.Object([("precomputedRagSourceConfig", json_of_evaluation_precomputed_rag_source_config(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_rag_config(v: json.Value) -> RAGConfig ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "knowledgeBaseConfig" => Ok(RAGConfig.KnowledgeBaseConfig(from_json_knowledge_base_config(fv)?))
      "precomputedRagSourceConfig" => Ok(RAGConfig.PrecomputedRagSourceConfig(from_json_evaluation_precomputed_rag_source_config(fv)?))
      _ => Ok(RAGConfig.Unknown(k))
    }
  }
  Err("RAGConfig: no member set")
}

