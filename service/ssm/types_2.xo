  /// A message from the third-party cloud provider related to the validation
  /// finding.
  pub provider_message: Str? = None
  /// The scope of the validation finding, identifying the specific resource
  /// affected.
  pub scope: ValidationFindingScope? = None
}

pub enum ValidationFindingCode: Str {
  TargetInaccessible = "TargetInaccessible"
  TargetUnusable = "TargetUnusable"
  TargetMissingPermissions = "TargetMissingPermissions"
  TargetApiDisabled = "TargetApiDisabled"
  TargetStateWarning = "TargetStateWarning"
  AwsRoleAssumptionFailed = "AwsRoleAssumptionFailed"
  WebIdentityTokenFailed = "WebIdentityTokenFailed"
  OutboundWebIdentityFederationDisabled = "OutboundWebIdentityFederationDisabled"
  ProviderCredentialCreationFailed = "ProviderCredentialCreationFailed"
  TenantSummary = "TenantSummary"
  SubscriptionAccessible = "SubscriptionAccessible"
  Unknown(value: Str)
}

/// Identifies the specific resource scope of a validation finding.
pub struct ValidationFindingScope {
  /// The type of the resource scope.
  pub type_value: ValidationFindingScopeType? = None
  /// The ID of the resource within the scope.
  pub id: Str? = None
}

pub enum ValidationFindingScopeType: Str {
  AzureTenant = "azure:tenant"
  AzureSubscription = "azure:subscription"
  GcpOrganization = "gcp:organization"
  GcpProject = "gcp:project"
  Unknown(value: Str)
}

pub enum ValidationFindingType: Str {
  Info = "INFO"
  Warn = "WARN"
  Error = "ERROR"
  Unknown(value: Str)
}
