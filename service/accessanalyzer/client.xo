fn json_of_configuration(v: Configuration) -> json.Value {
  match v {
    EbsSnapshot(x) => json.Value.Object([("ebsSnapshot", json_of_ebs_snapshot_configuration(x))])
    EcrRepository(x) => json.Value.Object([("ecrRepository", json_of_ecr_repository_configuration(x))])
    IamRole(x) => json.Value.Object([("iamRole", json_of_iam_role_configuration(x))])
    EfsFileSystem(x) => json.Value.Object([("efsFileSystem", json_of_efs_file_system_configuration(x))])
    KmsKey(x) => json.Value.Object([("kmsKey", json_of_kms_key_configuration(x))])
    RdsDbClusterSnapshot(x) => json.Value.Object([("rdsDbClusterSnapshot", json_of_rds_db_cluster_snapshot_configuration(x))])
    RdsDbSnapshot(x) => json.Value.Object([("rdsDbSnapshot", json_of_rds_db_snapshot_configuration(x))])
    SecretsManagerSecret(x) => json.Value.Object([("secretsManagerSecret", json_of_secrets_manager_secret_configuration(x))])
    S3Bucket(x) => json.Value.Object([("s3Bucket", json_of_s3_bucket_configuration(x))])
    SnsTopic(x) => json.Value.Object([("snsTopic", json_of_sns_topic_configuration(x))])
    SqsQueue(x) => json.Value.Object([("sqsQueue", json_of_sqs_queue_configuration(x))])
    S3ExpressDirectoryBucket(x) => json.Value.Object([("s3ExpressDirectoryBucket", json_of_s3_express_directory_bucket_configuration(x))])
    DynamodbStream(x) => json.Value.Object([("dynamodbStream", json_of_dynamodb_stream_configuration(x))])
    DynamodbTable(x) => json.Value.Object([("dynamodbTable", json_of_dynamodb_table_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_configuration(v: json.Value) -> Configuration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "ebsSnapshot" => Ok(Configuration.EbsSnapshot(from_json_ebs_snapshot_configuration(fv)?))
      "ecrRepository" => Ok(Configuration.EcrRepository(from_json_ecr_repository_configuration(fv)?))
      "iamRole" => Ok(Configuration.IamRole(from_json_iam_role_configuration(fv)?))
      "efsFileSystem" => Ok(Configuration.EfsFileSystem(from_json_efs_file_system_configuration(fv)?))
      "kmsKey" => Ok(Configuration.KmsKey(from_json_kms_key_configuration(fv)?))
      "rdsDbClusterSnapshot" => Ok(Configuration.RdsDbClusterSnapshot(from_json_rds_db_cluster_snapshot_configuration(fv)?))
      "rdsDbSnapshot" => Ok(Configuration.RdsDbSnapshot(from_json_rds_db_snapshot_configuration(fv)?))
      "secretsManagerSecret" => Ok(Configuration.SecretsManagerSecret(from_json_secrets_manager_secret_configuration(fv)?))
      "s3Bucket" => Ok(Configuration.S3Bucket(from_json_s3_bucket_configuration(fv)?))
      "snsTopic" => Ok(Configuration.SnsTopic(from_json_sns_topic_configuration(fv)?))
      "sqsQueue" => Ok(Configuration.SqsQueue(from_json_sqs_queue_configuration(fv)?))
      "s3ExpressDirectoryBucket" => Ok(Configuration.S3ExpressDirectoryBucket(from_json_s3_express_directory_bucket_configuration(fv)?))
      "dynamodbStream" => Ok(Configuration.DynamodbStream(from_json_dynamodb_stream_configuration(fv)?))
      "dynamodbTable" => Ok(Configuration.DynamodbTable(from_json_dynamodb_table_configuration(fv)?))
      _ => Ok(Configuration.Unknown(k))
    }
  }
  Err("Configuration: no member set")
}

fn json_of_configurations_map(v: Map[Str, Configuration]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, Configuration)) -> (Str, json.Value) { (e.0, json_of_configuration(e.1)) }))
}

fn from_json_configurations_map(v: json.Value) -> Map[Str, Configuration] ! Str {
  var out: Map[Str, Configuration] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_configuration(fv)?)
  }
  Ok(out)
}

