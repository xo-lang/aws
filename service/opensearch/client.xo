/// The HTTP request of AcceptInboundConnection.
pub fn serialize_accept_inbound_connection(ep: rest.Endpoint, input: AcceptInboundConnectionRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_connection_id = match input.connection_id {
    Some(v) => v
    None => return Err("input member ConnectionId is required")
  }
  if label_connection_id == "" {
    return Err("input member ConnectionId must not be empty")
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PUT",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/2021-01-01/opensearch/cc/inboundConnection/${rest.escape(label_connection_id, false)}/accept"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

