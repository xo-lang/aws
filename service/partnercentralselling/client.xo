fn json_of_filter_value(v: FilterValue) -> json.Value {
  match v {
    StringValue(x) => json.Value.Object([("StringValue", json.Value.Str(x))])
    StringListValue(x) => json.Value.Object([("StringListValue", json_of_account_filter_string_list(x))])
    LongValue(x) => json.Value.Object([("LongValue", json.Value.Int(x))])
    DateValue(x) => json.Value.Object([("DateValue", jsonv.time(x, "date-time"))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_filter_value(v: json.Value) -> FilterValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "StringValue" => Ok(FilterValue.StringValue(jsonv.read_str(fv)?))
      "StringListValue" => Ok(FilterValue.StringListValue(from_json_account_filter_string_list(fv)?))
      "LongValue" => Ok(FilterValue.LongValue(jsonv.read_int(fv)?))
      "DateValue" => Ok(FilterValue.DateValue(jsonv.read_time(fv, "date-time")?))
      _ => Ok(FilterValue.Unknown(k))
    }
  }
  Err("FilterValue: no member set")
}

