  /// enabled in the EFSVolumeConfiguration . For more information, see
  /// Working with Amazon EFS access points in the Amazon Elastic File System
  /// User Guide .
  pub access_point_id: Str? = None
  /// Whether or not to use the Batch job IAM role defined in a job definition
  /// when mounting the Amazon EFS file system. If enabled, transit encryption
  /// must be enabled in the EFSVolumeConfiguration . If this parameter is
  /// omitted, the default value of DISABLED is used. For more information,
  /// see Using Amazon EFS access points in the Batch User Guide . EFS IAM
  /// authorization requires that TransitEncryption be ENABLED and that a
  /// JobRoleArn is specified.
  pub iam: EFSAuthorizationConfigIAM? = None
}

pub enum EFSAuthorizationConfigIAM: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

pub enum EFSTransitEncryption: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

