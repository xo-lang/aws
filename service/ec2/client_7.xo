fn xml_write_subnet(var w: xmlv.Writer, v: Subnet, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.availability_zone_id {
    xmlv.elem(w, "availabilityZoneId", x, [])
  }
  if let Some(x) = v.enable_lni_at_device_index {
    xmlv.elem(w, "enableLniAtDeviceIndex", "${x}", [])
  }
  if let Some(x) = v.map_customer_owned_ip_on_launch {
    xmlv.elem(w, "mapCustomerOwnedIpOnLaunch", "${x}", [])
  }
  if let Some(x) = v.customer_owned_ipv4_pool {
    xmlv.elem(w, "customerOwnedIpv4Pool", x, [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.assign_ipv6_address_on_creation {
    xmlv.elem(w, "assignIpv6AddressOnCreation", "${x}", [])
  }
  if let Some(x) = v.ipv6_cidr_block_association_set {
    xml_write_subnet_ipv6_cidr_block_association_set(w, x, "ipv6CidrBlockAssociationSet", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.subnet_arn {
    xmlv.elem(w, "subnetArn", x, [])
  }
  if let Some(x) = v.outpost_arn {
    xmlv.elem(w, "outpostArn", x, [])
  }
  if let Some(x) = v.enable_dns64 {
    xmlv.elem(w, "enableDns64", "${x}", [])
  }
  if let Some(x) = v.ipv6_native {
    xmlv.elem(w, "ipv6Native", "${x}", [])
  }
  if let Some(x) = v.private_dns_name_options_on_launch {
    xml_write_private_dns_name_options_on_launch(w, x, "privateDnsNameOptionsOnLaunch", [])
  }
  if let Some(x) = v.block_public_access_states {
    xml_write_block_public_access_states(w, x, "blockPublicAccessStates", [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "type", x, [])
  }
  if let Some(x) = v.subnet_id {
    xmlv.elem(w, "subnetId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "vpcId", x, [])
  }
  if let Some(x) = v.cidr_block {
    xmlv.elem(w, "cidrBlock", x, [])
  }
  if let Some(x) = v.available_ip_address_count {
    xmlv.elem(w, "availableIpAddressCount", "${x}", [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.default_for_az {
    xmlv.elem(w, "defaultForAz", "${x}", [])
  }
  if let Some(x) = v.map_public_ip_on_launch {
    xmlv.elem(w, "mapPublicIpOnLaunch", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_subnet(e: xml.Element) -> Subnet ! Str {
  var out = Subnet{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "availabilityZoneId" => out.availability_zone_id = c.text()
      "enableLniAtDeviceIndex" => out.enable_lni_at_device_index = xmlv.read_int(c.text())?
      "mapCustomerOwnedIpOnLaunch" => out.map_customer_owned_ip_on_launch = xmlv.read_bool(c.text())?
      "customerOwnedIpv4Pool" => out.customer_owned_ipv4_pool = c.text()
      "ownerId" => out.owner_id = c.text()
      "assignIpv6AddressOnCreation" => out.assign_ipv6_address_on_creation = xmlv.read_bool(c.text())?
      "ipv6CidrBlockAssociationSet" => out.ipv6_cidr_block_association_set = xml_read_subnet_ipv6_cidr_block_association_set(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "subnetArn" => out.subnet_arn = c.text()
      "outpostArn" => out.outpost_arn = c.text()
      "enableDns64" => out.enable_dns64 = xmlv.read_bool(c.text())?
      "ipv6Native" => out.ipv6_native = xmlv.read_bool(c.text())?
      "privateDnsNameOptionsOnLaunch" => out.private_dns_name_options_on_launch = xml_read_private_dns_name_options_on_launch(c)?
      "blockPublicAccessStates" => out.block_public_access_states = xml_read_block_public_access_states(c)?
      "type" => out.type_value = c.text()
      "subnetId" => out.subnet_id = c.text()
      "state" => out.state = SubnetState.from(c.text())
      "vpcId" => out.vpc_id = c.text()
      "cidrBlock" => out.cidr_block = c.text()
      "availableIpAddressCount" => out.available_ip_address_count = xmlv.read_int(c.text())?
      "availabilityZone" => out.availability_zone = c.text()
      "defaultForAz" => out.default_for_az = xmlv.read_bool(c.text())?
      "mapPublicIpOnLaunch" => out.map_public_ip_on_launch = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

