fn json_of_decision(v: Decision) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.decision_type {
    fs.push(("decisionType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.schedule_activity_task_decision_attributes {
    fs.push(("scheduleActivityTaskDecisionAttributes", json_of_schedule_activity_task_decision_attributes(x)))
  }
  if let Some(x) = v.request_cancel_activity_task_decision_attributes {
    fs.push(("requestCancelActivityTaskDecisionAttributes", json_of_request_cancel_activity_task_decision_attributes(x)))
  }
  if let Some(x) = v.complete_workflow_execution_decision_attributes {
    fs.push(("completeWorkflowExecutionDecisionAttributes", json_of_complete_workflow_execution_decision_attributes(x)))
  }
  if let Some(x) = v.fail_workflow_execution_decision_attributes {
    fs.push(("failWorkflowExecutionDecisionAttributes", json_of_fail_workflow_execution_decision_attributes(x)))
  }
  if let Some(x) = v.cancel_workflow_execution_decision_attributes {
    fs.push(("cancelWorkflowExecutionDecisionAttributes", json_of_cancel_workflow_execution_decision_attributes(x)))
  }
  if let Some(x) = v.continue_as_new_workflow_execution_decision_attributes {
    fs.push(("continueAsNewWorkflowExecutionDecisionAttributes", json_of_continue_as_new_workflow_execution_decision_attributes(x)))
  }
  if let Some(x) = v.record_marker_decision_attributes {
    fs.push(("recordMarkerDecisionAttributes", json_of_record_marker_decision_attributes(x)))
  }
  if let Some(x) = v.start_timer_decision_attributes {
    fs.push(("startTimerDecisionAttributes", json_of_start_timer_decision_attributes(x)))
  }
  if let Some(x) = v.cancel_timer_decision_attributes {
    fs.push(("cancelTimerDecisionAttributes", json_of_cancel_timer_decision_attributes(x)))
  }
  if let Some(x) = v.signal_external_workflow_execution_decision_attributes {
    fs.push(("signalExternalWorkflowExecutionDecisionAttributes", json_of_signal_external_workflow_execution_decision_attributes(x)))
  }
  if let Some(x) = v.request_cancel_external_workflow_execution_decision_attributes {
    fs.push(("requestCancelExternalWorkflowExecutionDecisionAttributes", json_of_request_cancel_external_workflow_execution_decision_attributes(x)))
  }
  if let Some(x) = v.start_child_workflow_execution_decision_attributes {
    fs.push(("startChildWorkflowExecutionDecisionAttributes", json_of_start_child_workflow_execution_decision_attributes(x)))
  }
  if let Some(x) = v.schedule_lambda_function_decision_attributes {
    fs.push(("scheduleLambdaFunctionDecisionAttributes", json_of_schedule_lambda_function_decision_attributes(x)))
  }
  json.Value.Object(fs)
}

fn from_json_decision(v: json.Value) -> Decision ! Str {
  var out = Decision{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
