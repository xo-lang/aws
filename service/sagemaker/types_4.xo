/// Represents a high-performance compute server used for distributed
/// training in SageMaker AI. An UltraServer consists of multiple instances
/// within a shared NVLink interconnect domain.
pub struct UltraServer {
  /// The unique identifier for the UltraServer.
  pub ultra_server_id: Str? = None
  /// The type of UltraServer, such as ml.u-p6e-gb200x72.
  pub ultra_server_type: Str? = None
  /// The name of the Availability Zone where the UltraServer is provisioned.
  pub availability_zone: Str? = None
  /// The Amazon EC2 instance type used in the UltraServer.
  pub instance_type: ReservedCapacityInstanceType? = None
  /// The total number of instances in this UltraServer.
  pub total_instance_count: Int? = None
  /// The number of spare instances configured for this UltraServer to provide
  /// enhanced resiliency.
  pub configured_spare_instance_count: Int? = None
  /// The number of instances currently available for use in this UltraServer.
  pub available_instance_count: Int? = None
  /// The number of instances currently in use in this UltraServer.
  pub in_use_instance_count: Int? = None
  /// The number of available spare instances in the UltraServer.
  pub available_spare_instance_count: Int? = None
  /// The number of instances in this UltraServer that are currently in an
  /// unhealthy state.
  pub unhealthy_instance_count: Int? = None
  /// The overall health status of the UltraServer.
  pub health_status: UltraServerHealthStatus? = None
}

pub enum UltraServerHealthStatus: Str {
  Ok = "OK"
  Impaired = "Impaired"
  InsufficientData = "Insufficient-Data"
  Unknown(value: Str)
}

/// Contains information about the UltraServer object.
pub struct UltraServerInfo {
  /// The unique identifier of the UltraServer.
  pub id: Str? = None
  /// The type of the UltraServer.
  pub type_value: Str? = None
}

/// A summary of UltraServer resources and their current status.
pub struct UltraServerSummary {
  /// The type of UltraServer, such as ml.u-p6e-gb200x72.
  pub ultra_server_type: Str? = None
  /// The Amazon EC2 instance type used in the UltraServer.
  pub instance_type: ReservedCapacityInstanceType? = None
  /// The number of UltraServers of this type.
  pub ultra_server_count: Int? = None
  /// The number of available spare instances in the UltraServers.
  pub available_spare_instance_count: Int? = None
  /// The total number of instances across all UltraServers of this type that
  /// are currently in an unhealthy state.
  pub unhealthy_instance_count: Int? = None
}

/// The settings that apply to an Amazon SageMaker AI domain when you use it
/// in Amazon SageMaker Unified Studio.
pub struct UnifiedStudioSettings {
  /// Sets whether you can access the domain in Amazon SageMaker Studio:
  /// ENABLED You can access the domain in Amazon SageMaker Studio. If you
  /// migrate the domain to Amazon SageMaker Unified Studio, you can access it
  /// in both studio interfaces. DISABLED You can't access the domain in
  /// Amazon SageMaker Studio. If you migrate the domain to Amazon SageMaker
  /// Unified Studio, you can access it only in that studio interface. To
  /// migrate a domain to Amazon SageMaker Unified Studio, you specify the
  /// UnifiedStudioSettings data type when you use the UpdateDomain action.
  pub studio_web_portal_access: FeatureStatus? = None
  /// The ID of the Amazon Web Services account that has the Amazon SageMaker
  /// Unified Studio domain. The default value, if you don't specify an ID, is
  /// the ID of the account that has the Amazon SageMaker AI domain.
  pub domain_account_id: Str? = None
  /// The Amazon Web Services Region where the domain is located in Amazon
  /// SageMaker Unified Studio. The default value, if you don't specify a
  /// Region, is the Region where the Amazon SageMaker AI domain is located.
  pub domain_region: Str? = None
  /// The ID of the Amazon SageMaker Unified Studio domain associated with
  /// this domain.
  pub domain_id: Str? = None
  /// The ID of the Amazon SageMaker Unified Studio project that corresponds
  /// to the domain.
  pub project_id: Str? = None
  /// The ID of the environment that Amazon SageMaker Unified Studio
  /// associates with the domain.
  pub environment_id: Str? = None
  /// The location where Amazon S3 stores temporary execution data and other
  /// artifacts for the project that corresponds to the domain.
  pub project_s3_path: Str? = None
  /// The ARN of the Amazon DataZone application managed by Amazon SageMaker
  /// Unified Studio in the Amazon Web Services IAM Identity Center.
  pub single_sign_on_application_arn: Str? = None
}

