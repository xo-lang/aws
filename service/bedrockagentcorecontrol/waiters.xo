  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.enforcement_mode {
    fs.push(("enforcementMode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.definition {
    fs.push(("definition", jmes_of_policy_definition(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.status_reasons {
    fs.push(("statusReasons", jmes_of_policy_status_reasons(x)))
  }
  json.Value.Object(fs)
}

fn jmes_of_policy_definition(v: PolicyDefinition) -> json.Value {
  match v {
    Cedar(x) => json.Value.Object([("cedar", jmes_of_cedar_policy(x))])
    PolicyGeneration(x) => json.Value.Object([("policyGeneration", jmes_of_policy_generation_details(x))])
    Policy(x) => json.Value.Object([("policy", jmes_of_policy_statement(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn jmes_of_cedar_policy(v: CedarPolicy) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.statement {
    fs.push(("statement", json.Value.Str(x)))
