  pub label: Str? = None
  /// Specifies the field position.
  pub position: FieldPosition? = None
  /// Specifies whether to hide a field.
  pub excluded: Bool? = None
  /// Describes the configuration for the default input value to display for a
  /// field.
  pub input_type: FieldInputConfig? = None
  /// The validations to perform on the value in the field.
  pub validations: List[FieldValidationConfiguration]? = None
}

/// Describes the configuration for the default input values to display for
/// a field.
pub struct FieldInputConfig {
  /// The input type for the field.
  pub type_value: Str? = None
  /// Specifies a field that requires input.
  pub required: Bool? = None
  /// Specifies a read only field.
  pub read_only: Bool? = None
  /// The text to display as a placeholder for the field.
  pub placeholder: Str? = None
  /// The default value for the field.
  pub default_value: Str? = None
  /// The text to display to describe the field.
  pub descriptive_text: Str? = None
  /// Specifies whether a field has a default value.
  pub default_checked: Bool? = None
  /// The default country code for a phone number.
  pub default_country_code: Str? = None
  /// The information to use to customize the input fields with data at
  /// runtime.
  pub value_mappings: ValueMappings? = None
  /// The name of the field.
  pub name: Str? = None
  /// The minimum value to display for the field.
  pub min_value: Float? = None
  /// The maximum value to display for the field.
  pub max_value: Float? = None
  /// The stepping increment for a numeric value in a field.
  pub step: Float? = None
  /// The value for the field.
  pub value: Str? = None
  /// Specifies whether to render the field as an array. This property is
  /// ignored if the dataSourceType for the form is a Data Store.
  pub is_array: Bool? = None
  /// The configuration for the file uploader field.
  pub file_uploader_config: FileUploaderFieldConfig? = None
}

/// Describes the field position.
pub enum FieldPosition {
  Fixed(value: FixedPosition)
  RightOf(value: Str)
  Below(value: Str)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// Describes the validation configuration for a field.
pub struct FieldValidationConfiguration {
  /// The validation to perform on an object type.
  pub type_value: Str? = None
  /// The validation to perform on a string value.
  pub str_values: List[Str]? = None
  /// The validation to perform on a number value.
  pub num_values: List[Int]? = None
  /// The validation message to display.
  pub validation_message: Str? = None
}

/// Describes the configuration for the file uploader field.
pub struct FileUploaderFieldConfig {
  /// The access level to assign to the uploaded files in the Amazon S3 bucket
  /// where they are stored. The valid values for this property are private ,
  /// protected , or public . For detailed information about the permissions
  /// associated with each access level, see File access levels in the Amplify
  /// documentation .
  pub access_level: StorageAccessLevel? = None
  /// The file types that are allowed to be uploaded by the file uploader.
  /// Provide this information in an array of strings specifying the valid
  /// file extensions.
  pub accepted_file_types: List[Str]? = None
  /// Specifies whether to display or hide the image preview after selecting a
  /// file for upload. The default value is true to display the image preview.
  pub show_thumbnails: Bool? = None
  /// Allows the file upload operation to be paused and resumed. The default
  /// value is false . When isResumable is set to true , the file uploader
  /// uses a multipart upload to break the files into chunks before upload.
  /// The progress of the upload isn't continuous, because the file uploader
  /// uploads a chunk at a time.
  pub is_resumable: Bool? = None
  /// Specifies the maximum number of files that can be selected to upload.
  /// The default value is an unlimited number of files.
  pub max_file_count: Int? = None
  /// The maximum file size in bytes that the file uploader will accept. The
  /// default value is an unlimited file size.
  pub max_size: Int? = None
}

