      "ExploitAvailable" => out.exploit_available = VulnerabilityExploitAvailable.from(jsonv.read_str(fv)?)
      "LastKnownExploitAt" => out.last_known_exploit_at = jsonv.read_str(fv)?
      "CodeVulnerabilities" => out.code_vulnerabilities = from_json_vulnerability_code_vulnerabilities_list(fv)?
