      "command" => out.command = from_json_string_list(fv)?
      "environment" => out.environment = from_json_environment_variables(fv)?
      "environmentFiles" => out.environment_files = from_json_environment_files(fv)?
      "mountPoints" => out.mount_points = from_json_mount_point_list(fv)?
      "volumesFrom" => out.volumes_from = from_json_volume_from_list(fv)?
      "linuxParameters" => out.linux_parameters = from_json_linux_parameters(fv)?
      "secrets" => out.secrets = from_json_secret_list(fv)?
      "dependsOn" => out.depends_on = from_json_container_dependencies(fv)?
      "startTimeout" => out.start_timeout = jsonv.read_int(fv)?
      "stopTimeout" => out.stop_timeout = jsonv.read_int(fv)?
      "versionConsistency" => out.version_consistency = VersionConsistency.from(jsonv.read_str(fv)?)
      "hostname" => out.hostname = jsonv.read_str(fv)?
      "user" => out.user = jsonv.read_str(fv)?
      "workingDirectory" => out.working_directory = jsonv.read_str(fv)?
      "disableNetworking" => out.disable_networking = jsonv.read_bool(fv)?
      "privileged" => out.privileged = jsonv.read_bool(fv)?
      "readonlyRootFilesystem" => out.readonly_root_filesystem = jsonv.read_bool(fv)?
      "dnsServers" => out.dns_servers = from_json_string_list(fv)?
