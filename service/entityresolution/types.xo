  /// criteria ML_MATCHING : Match records using machine learning models
  /// PROVIDER : Match records using a third-party matching provider
  pub resolution_type: ResolutionType? = None
  /// An object which defines the list of matching rules to run and has a
  /// field rules , which is a list of rule objects.
  pub rule_based_properties: RuleBasedProperties? = None
  /// An object containing the rules for a matching workflow.
  pub rule_condition_properties: RuleConditionProperties? = None
  /// Specifies whether real-time matching is enabled for the rule-based
  /// matching workflow. When you enable real-time matching, you can use the
  /// GenerateMatchId operation with the workflow.
  pub enable_real_time_matching: Bool? = None
  /// The properties of the provider service.
  pub provider_properties: ProviderProperties? = None
}

pub enum ResolutionType: Str {
  RuleMatching = "RULE_MATCHING"
  MlMatching = "ML_MATCHING"
  Provider = "PROVIDER"
  Unknown(value: Str)
}

