    match c.name.local {
      "RuleArn" => out.rule_arn = c.text()
      "Priority" => out.priority = c.text()
      "Conditions" => out.conditions = xml_read_rule_condition_list(c)?
      "Actions" => out.actions = xml_read_actions(c)?
      "IsDefault" => out.is_default = xmlv.read_bool(c.text())?
