  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.source_language_code {
    fs.push(("SourceLanguageCode", json.Value.Str(x)))
  }
  if let Some(x) = v.target_language_codes {
    fs.push(("TargetLanguageCodes", json_of_language_code_string_list(x)))
  }
  if let Some(x) = v.parallel_data_config {
    fs.push(("ParallelDataConfig", json_of_parallel_data_config(x)))
  }
  if let Some(x) = v.message {
    fs.push(("Message", json.Value.Str(x)))
  }
  if let Some(x) = v.imported_data_size {
    fs.push(("ImportedDataSize", json.Value.Int(x)))
  }
  if let Some(x) = v.imported_record_count {
    fs.push(("ImportedRecordCount", json.Value.Int(x)))
  }
  if let Some(x) = v.failed_record_count {
    fs.push(("FailedRecordCount", json.Value.Int(x)))
  }
  if let Some(x) = v.skipped_record_count {
    fs.push(("SkippedRecordCount", json.Value.Int(x)))
  }
  if let Some(x) = v.encryption_key {
    fs.push(("EncryptionKey", json_of_encryption_key(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_updated_at {
    fs.push(("LastUpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.latest_update_attempt_status {
    fs.push(("LatestUpdateAttemptStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.latest_update_attempt_at {
    fs.push(("LatestUpdateAttemptAt", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_parallel_data_properties(v: json.Value) -> ParallelDataProperties ! Str {
  var out = ParallelDataProperties{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Name" => out.name = jsonv.read_str(fv)?
