  var out = FileSystem{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "OwnerId" => out.owner_id = jsonv.read_str(fv)?
      "CreationTime" => out.creation_time = jsonv.read_time(fv, "epoch-seconds")?
      "FileSystemId" => out.file_system_id = jsonv.read_str(fv)?
      "FileSystemType" => out.file_system_type = FileSystemType.from(jsonv.read_str(fv)?)
      "Lifecycle" => out.lifecycle = FileSystemLifecycle.from(jsonv.read_str(fv)?)
      "FailureDetails" => out.failure_details = from_json_file_system_failure_details(fv)?
      "StorageCapacity" => out.storage_capacity = jsonv.read_int(fv)?
      "StorageType" => out.storage_type = StorageType.from(jsonv.read_str(fv)?)
      "VpcId" => out.vpc_id = jsonv.read_str(fv)?
      "SubnetIds" => out.subnet_ids = from_json_subnet_ids(fv)?
      "NetworkInterfaceIds" => out.network_interface_ids = from_json_network_interface_ids(fv)?
      "DNSName" => out.dns_name = jsonv.read_str(fv)?
      "KmsKeyId" => out.kms_key_id = jsonv.read_str(fv)?
      "ResourceARN" => out.resource_arn = jsonv.read_str(fv)?
      "Tags" => out.tags = from_json_tags(fv)?
      "WindowsConfiguration" => out.windows_configuration = from_json_windows_file_system_configuration(fv)?
      "LustreConfiguration" => out.lustre_configuration = from_json_lustre_file_system_configuration(fv)?
      "AdministrativeActions" => out.administrative_actions = from_json_administrative_actions(fv)?
      "OntapConfiguration" => out.ontap_configuration = from_json_ontap_file_system_configuration(fv)?
      "FileSystemTypeVersion" => out.file_system_type_version = jsonv.read_str(fv)?
      "OpenZFSConfiguration" => out.open_zfs_configuration = from_json_open_zfs_file_system_configuration(fv)?
      "NetworkType" => out.network_type = NetworkType.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

