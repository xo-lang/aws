    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_kinesis_streaming_destination(input) {
      Ok(out) => {
        let o = jmes_of_describe_kinesis_streaming_destination_output(out)
        if state == "" && waiter.path_matches(o, "KinesisDataStreamDestinations[].DestinationStatus", "anyStringEquals", "ACTIVE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "length(KinesisDataStreamDestinations) > `0`  && length(KinesisDataStreamDestinations[?DestinationStatus == 'DISABLED' || DestinationStatus == 'ENABLE_FAILED']) ==  length(KinesisDataStreamDestinations)", "booleanEquals", "true") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("KinesisStreamingDestinationActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeTable until the TableExists acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (20s) to `max_delay` (120s).
pub fn wait_until_table_exists(c: Client, input: DescribeTableInput, max_wait: Duration, min_delay: Duration = 20s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeTableErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_table(input) {
      Ok(out) => {
        let o = jmes_of_describe_table_output(out)
        if state == "" && waiter.path_matches(o, "Table.TableStatus", "stringEquals", "ACTIVE") {
          state = "success"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_table(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "retry"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("TableExists: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeTable until the TableNotExists acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (20s) to `max_delay` (120s).
pub fn wait_until_table_not_exists(c: Client, input: DescribeTableInput, max_wait: Duration, min_delay: Duration = 20s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeTableErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_table(input) {
      Ok(_) => {
        state = ""
      }
      Err(e) => {
        let names = waiter_error_names_describe_table(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("TableNotExists: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
