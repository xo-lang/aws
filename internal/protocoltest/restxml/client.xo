fn xml_write_xml_lists_request(var w: xmlv.Writer, v: XmlListsRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.string_list {
    xml_write_string_list(w, x, "stringList", [])
  }
  if let Some(x) = v.string_set {
    xml_write_string_set(w, x, "stringSet", [])
  }
  if let Some(x) = v.integer_list {
    xml_write_integer_list(w, x, "integerList", [])
  }
  if let Some(x) = v.boolean_list {
    xml_write_boolean_list(w, x, "booleanList", [])
  }
  if let Some(x) = v.timestamp_list {
    xml_write_timestamp_list(w, x, "timestampList", [])
  }
  if let Some(x) = v.enum_list {
    xml_write_foo_enum_list(w, x, "enumList", [])
  }
  if let Some(x) = v.int_enum_list {
    xml_write_integer_enum_list(w, x, "intEnumList", [])
  }
  if let Some(x) = v.nested_string_list {
    xml_write_nested_string_list(w, x, "nestedStringList", [])
  }
  if let Some(x) = v.renamed_list_members {
    xml_write_renamed_list_members(w, x, "renamed", [])
  }
  if let Some(x) = v.flattened_list {
    for item in x {
      xmlv.elem(w, "flattenedList", item, [])
    }
  }
  if let Some(x) = v.flattened_list2 {
    for item in x {
      xmlv.elem(w, "customName", item, [])
    }
  }
  if let Some(x) = v.flattened_list_with_member_namespace {
    for item in x {
      xmlv.elem(w, "flattenedListWithMemberNamespace", item, [("xmlns", "https://xml-member.example.com")])
    }
  }
  if let Some(x) = v.flattened_list_with_namespace {
    for item in x {
      xmlv.elem(w, "flattenedListWithNamespace", item, [])
    }
  }
  if let Some(x) = v.structure_list {
    xml_write_structure_list(w, x, "myStructureList", [])
  }
  if let Some(x) = v.flattened_structure_list {
    for item in x {
      xml_write_structure_list_member(w, item, "flattenedStructureList", [])
    }
  }
  xmlv.end(w, name)
}

fn xml_read_xml_lists_request(e: xml.Element) -> XmlListsRequest ! Str {
  var out = XmlListsRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "stringList" => out.string_list = xml_read_string_list(c)?
      "stringSet" => out.string_set = xml_read_string_set(c)?
      "integerList" => out.integer_list = xml_read_integer_list(c)?
      "booleanList" => out.boolean_list = xml_read_boolean_list(c)?
      "timestampList" => out.timestamp_list = xml_read_timestamp_list(c)?
      "enumList" => out.enum_list = xml_read_foo_enum_list(c)?
      "intEnumList" => out.int_enum_list = xml_read_integer_enum_list(c)?
      "nestedStringList" => out.nested_string_list = xml_read_nested_string_list(c)?
      "renamed" => out.renamed_list_members = xml_read_renamed_list_members(c)?
      "flattenedList" => {
        var items = out.flattened_list ?? []
        items.push(c.text())
        out.flattened_list = items
      }
      "customName" => {
        var items = out.flattened_list2 ?? []
        items.push(c.text())
        out.flattened_list2 = items
      }
      "flattenedListWithMemberNamespace" => {
        var items = out.flattened_list_with_member_namespace ?? []
        items.push(c.text())
        out.flattened_list_with_member_namespace = items
      }
      "flattenedListWithNamespace" => {
        var items = out.flattened_list_with_namespace ?? []
        items.push(c.text())
        out.flattened_list_with_namespace = items
      }
      "myStructureList" => out.structure_list = xml_read_structure_list(c)?
      "flattenedStructureList" => {
        var items = out.flattened_structure_list ?? []
        items.push(xml_read_structure_list_member(c)?)
        out.flattened_structure_list = items
      }
      _ => {}
    }
  }
  Ok(out)
}

