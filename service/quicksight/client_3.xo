fn json_of_image_source(v: ImageSource) -> json.Value {
  match v {
    PublicUrl(x) => json.Value.Object([("PublicUrl", json.Value.Str(x))])
    S3Uri(x) => json.Value.Object([("S3Uri", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_image_source(v: json.Value) -> ImageSource ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "PublicUrl" => Ok(ImageSource.PublicUrl(jsonv.read_str(fv)?))
      "S3Uri" => Ok(ImageSource.S3Uri(jsonv.read_str(fv)?))
      _ => Ok(ImageSource.Unknown(k))
    }
  }
  Err("ImageSource: no member set")
}

