fn json_of_job(v: Job) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.job_name {
    fs.push(("JobName", json.Value.Str(x)))
  }
  if let Some(x) = v.job_arn {
    fs.push(("JobArn", json.Value.Str(x)))
  }
  if let Some(x) = v.role_arn {
    fs.push(("RoleArn", json.Value.Str(x)))
  }
  if let Some(x) = v.job_category {
    fs.push(("JobCategory", json.Value.Str(x.value())))
  }
  if let Some(x) = v.job_config_schema_version {
    fs.push(("JobConfigSchemaVersion", json.Value.Str(x)))
  }
  if let Some(x) = v.job_config_document {
    fs.push(("JobConfigDocument", json.Value.Str(x)))
  }
  if let Some(x) = v.creation_time {
    fs.push(("CreationTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_modified_time {
    fs.push(("LastModifiedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.end_time {
    fs.push(("EndTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.job_status {
    fs.push(("JobStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.secondary_status {
    fs.push(("SecondaryStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.secondary_status_transitions {
    fs.push(("SecondaryStatusTransitions", json_of_job_secondary_status_transitions(x)))
  }
  if let Some(x) = v.failure_reason {
    fs.push(("FailureReason", json.Value.Str(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_list(x)))
  }
  json.Value.Object(fs)
}

fn from_json_job(v: json.Value) -> Job ! Str {
  var out = Job{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "JobName" => out.job_name = jsonv.read_str(fv)?
      "JobArn" => out.job_arn = jsonv.read_str(fv)?
      "RoleArn" => out.role_arn = jsonv.read_str(fv)?
      "JobCategory" => out.job_category = JobCategory.from(jsonv.read_str(fv)?)
      "JobConfigSchemaVersion" => out.job_config_schema_version = jsonv.read_str(fv)?
