fn query_put_actions_list(var f: query.Form, prefix: Str, v: List[Str], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query.add(f, k, x)
  }
}

fn query_put_add_permission_input(var f: query.Form, prefix: Str, v: AddPermissionInput) {
  if let Some(x) = v.topic_arn {
    query.add(f, query.key(prefix, "TopicArn"), x)
  }
  if let Some(x) = v.label {
    query.add(f, query.key(prefix, "Label"), x)
  }
  if let Some(x) = v.aws_account_id {
    query_put_delegates_list(f, query.key(prefix, "AWSAccountId"), x, false)
  }
  if let Some(x) = v.action_name {
    query_put_actions_list(f, query.key(prefix, "ActionName"), x, false)
  }
}

