    None => return Err("input member id is required")
  }
  if label_id == "" {
    return Err("input member id must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.yes_no {
    fs.push(("yesNo", json_of_yes_no_question_list(x)))
  }
  if let Some(x) = input.yes_no_per_option {
    fs.push(("yesNoPerOption", json_of_yes_no_per_option_question_list(x)))
  }
  if let Some(x) = input.choose_one {
    fs.push(("chooseOne", json_of_choose_one_question_list(x)))
  }
  if let Some(x) = input.name {
    fs.push(("name", json.Value.Str(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PATCH",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/v1/question-set/${rest.escape(label_id, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

