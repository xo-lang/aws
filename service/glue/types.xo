/// The Field object has information about the different properties
/// associated with a field in the connector.
pub struct Field {
  /// A unique identifier for the field.
  pub field_name: Str? = None
  /// A readable label used for the field.
  pub label: Str? = None
  /// A description of the field.
  pub description: Str? = None
  /// The type of data in the field.
  pub field_type: FieldDataType? = None
  /// Indicates whether this field can used as a primary key for the given
  /// entity.
  pub is_primary_key: Bool? = None
  /// Indicates whether this field can be nullable or not.
  pub is_nullable: Bool? = None
  /// Indicates whether this field can be added in Select clause of SQL query
  /// or whether it is retrievable or not.
  pub is_retrievable: Bool? = None
  /// Indicates whether this field can used in a filter clause ( WHERE clause)
  /// of a SQL statement when querying data.
  pub is_filterable: Bool? = None
  /// Indicates whether a given field can be used in partitioning the query
  /// made to SaaS.
  pub is_partitionable: Bool? = None
  /// Indicates whether this field can be created as part of a destination
  /// write.
  pub is_createable: Bool? = None
  /// Indicates whether this field can be updated as part of a destination
  /// write.
  pub is_updateable: Bool? = None
  /// Indicates whether this field can be upserted as part of a destination
  /// write.
  pub is_upsertable: Bool? = None
  /// Indicates whether this field is populated automatically when the object
  /// is created, such as a created at timestamp.
  pub is_default_on_create: Bool? = None
  /// A list of supported values for the field.
  pub supported_values: List[Str]? = None
  /// Indicates the support filter operators for this field.
  pub supported_filter_operators: List[FieldFilterOperator]? = None
  /// A parent field name for a nested field.
  pub parent_field: Str? = None
  /// The data type returned by the SaaS API, such as “picklist” or
  /// “textarea” from Salesforce.
  pub native_data_type: Str? = None
  /// Optional map of keys which may be returned.
  pub custom_properties: Map[Str, Str]? = None
}

