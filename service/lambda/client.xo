pub fn endpoint_params_add_layer_version_permission(base: EndpointParameters, input: AddLayerVersionPermissionRequest) -> EndpointParameters {
  let _ = input
  base
}

/// The HTTP request of AddLayerVersionPermission.
pub fn serialize_add_layer_version_permission(ep: rest.Endpoint, input: AddLayerVersionPermissionRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_layer_name = match input.layer_name {
    Some(v) => v
    None => return Err("input member LayerName is required")
  }
  if label_layer_name == "" {
    return Err("input member LayerName must not be empty")
  }
  let label_version_number = match input.version_number {
    Some(v) => "${v}"
    None => return Err("input member VersionNumber is required")
  }
  if label_version_number == "" {
    return Err("input member VersionNumber must not be empty")
  }
  if let Some(v) = input.revision_id {
    qs.push(("RevisionId", v))
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.statement_id {
    fs.push(("StatementId", json.Value.Str(x)))
  }
  if let Some(x) = input.action {
    fs.push(("Action", json.Value.Str(x)))
  }
  if let Some(x) = input.principal {
    fs.push(("Principal", json.Value.Str(x)))
  }
  if let Some(x) = input.organization_id {
    fs.push(("OrganizationId", json.Value.Str(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/2018-10-31/layers/${rest.escape(label_layer_name, false)}/versions/${rest.escape(label_version_number, false)}/policy"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_add_layer_version_permission(resp: http.Response) -> AddLayerVersionPermissionResponse ! Str {
  var out = AddLayerVersionPermissionResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Statement" => out.statement = jsonv.read_str(fv)?
      "RevisionId" => out.revision_id = jsonv.read_str(fv)?
      _ => {}
    }
  }
