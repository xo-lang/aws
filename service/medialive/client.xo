fn json_of_failed_media_resource_map(v: Map[Str, MediaResource]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, MediaResource)) -> (Str, json.Value) { (e.0, json_of_media_resource(e.1)) }))
}

fn from_json_failed_media_resource_map(v: json.Value) -> Map[Str, MediaResource] ! Str {
  var out: Map[Str, MediaResource] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_media_resource(fv)?)
  }
  Ok(out)
}

