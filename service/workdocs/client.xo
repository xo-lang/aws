fn json_of_document_version_metadata(v: DocumentVersionMetadata) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.content_type {
    fs.push(("ContentType", json.Value.Str(x)))
  }
  if let Some(x) = v.size {
    fs.push(("Size", json.Value.Int(x)))
  }
  if let Some(x) = v.signature {
    fs.push(("Signature", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created_timestamp {
    fs.push(("CreatedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.modified_timestamp {
    fs.push(("ModifiedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.content_created_timestamp {
    fs.push(("ContentCreatedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.content_modified_timestamp {
