fn json_of_out_of_sync_reasons_view(v: OutOfSyncReasonsView) -> json.Value {
  match v {
    Reasons(x) => json.Value.Object([("reasons", json_of_out_of_sync_reasons(x))])
    NotVisible(x) => json.Value.Object([("notVisible", json_of_not_visible_marker(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_out_of_sync_reasons_view(v: json.Value) -> OutOfSyncReasonsView ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "reasons" => Ok(OutOfSyncReasonsView.Reasons(from_json_out_of_sync_reasons(fv)?))
      "notVisible" => Ok(OutOfSyncReasonsView.NotVisible(from_json_not_visible_marker(fv)?))
      _ => Ok(OutOfSyncReasonsView.Unknown(k))
    }
  }
  Err("OutOfSyncReasonsView: no member set")
}

