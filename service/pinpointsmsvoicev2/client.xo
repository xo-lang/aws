fn json_of_rcs_content(v: RcsContent) -> json.Value {
  match v {
    TextMessage(x) => json.Value.Object([("TextMessage", json_of_rcs_text_message(x))])
    FileMessage(x) => json.Value.Object([("FileMessage", json_of_rcs_file_message(x))])
    RichCard(x) => json.Value.Object([("RichCard", json_of_rcs_standalone_card(x))])
    Carousel(x) => json.Value.Object([("Carousel", json_of_rcs_carousel(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_rcs_content(v: json.Value) -> RcsContent ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "TextMessage" => Ok(RcsContent.TextMessage(from_json_rcs_text_message(fv)?))
      "FileMessage" => Ok(RcsContent.FileMessage(from_json_rcs_file_message(fv)?))
      "RichCard" => Ok(RcsContent.RichCard(from_json_rcs_standalone_card(fv)?))
      "Carousel" => Ok(RcsContent.Carousel(from_json_rcs_carousel(fv)?))
      _ => Ok(RcsContent.Unknown(k))
    }
  }
  Err("RcsContent: no member set")
}

