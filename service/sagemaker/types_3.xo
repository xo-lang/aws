/// Contains information about a training job.
pub struct TrainingJob {
  /// The name of the training job.
  pub training_job_name: Str? = None
  /// The Amazon Resource Name (ARN) of the training job.
  pub training_job_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the associated hyperparameter tuning
  /// job if the training job was launched by a hyperparameter tuning job.
  pub tuning_job_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the labeling job.
  pub labeling_job_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the job.
  pub auto_ml_job_arn: Str? = None
  /// Information about the Amazon S3 location that is configured for storing
  /// model artifacts.
  pub model_artifacts: ModelArtifacts? = None
  /// The status of the training job. Training job statuses are: InProgress -
  /// The training is in progress. Completed - The training job has completed.
  /// Failed - The training job has failed. To see the reason for the failure,
  /// see the FailureReason field in the response to a
  /// DescribeTrainingJobResponse call. Stopping - The training job is
  /// stopping. Stopped - The training job has stopped. For more detailed
  /// information, see SecondaryStatus .
  pub training_job_status: TrainingJobStatus? = None
  /// Provides detailed information about the state of the training job. For
  /// detailed information about the secondary status of the training job, see
  /// StatusMessage under SecondaryStatusTransition . SageMaker provides
  /// primary statuses and secondary statuses that apply to each of them:
  /// InProgress Starting - Starting the training job. Downloading - An
  /// optional stage for algorithms that support File training input mode. It
  /// indicates that data is being downloaded to the ML storage volumes.
  /// Training - Training is in progress. Uploading - Training is complete and
  /// the model artifacts are being uploaded to the S3 location. Completed
  /// Completed - The training job has completed. Failed Failed - The training
  /// job has failed. The reason for the failure is returned in the
  /// FailureReason field of DescribeTrainingJobResponse . Stopped
  /// MaxRuntimeExceeded - The job stopped because it exceeded the maximum
  /// allowed runtime. Stopped - The training job has stopped. Stopping
  /// Stopping - Stopping the training job. Valid values for SecondaryStatus
  /// are subject to change. We no longer support the following secondary
  /// statuses: LaunchingMLInstances PreparingTrainingStack
  /// DownloadingTrainingImage
  pub secondary_status: SecondaryStatus? = None
  /// If the training job failed, the reason it failed.
  pub failure_reason: Str? = None
  /// Algorithm-specific parameters.
  pub hyper_parameters: Map[Str, Str]? = None
  /// Information about the algorithm used for training, and algorithm
  /// metadata.
  pub algorithm_specification: AlgorithmSpecification? = None
  /// The Amazon Web Services Identity and Access Management (IAM) role
  /// configured for the training job.
  pub role_arn: Str? = None
  /// An array of Channel objects that describes each data input channel. Your
  /// input must be in the same Amazon Web Services region as your training
  /// job.
  pub input_data_config: List[Channel]? = None
  /// The S3 path where model artifacts that you configured when creating the
  /// job are stored. SageMaker creates subfolders for model artifacts.
  pub output_data_config: OutputDataConfig? = None
  /// Resources, including ML compute instances and ML storage volumes, that
  /// are configured for model training.
  pub resource_config: ResourceConfig? = None
  /// The status of the warm pool associated with the training job.
  pub warm_pool_status: WarmPoolStatus? = None
  /// A VpcConfig object that specifies the VPC that this training job has
  /// access to. For more information, see Protect Training Jobs by Using an
  /// Amazon Virtual Private Cloud .
  pub vpc_config: VpcConfig? = None
  /// Specifies a limit to how long a model training job can run. It also
  /// specifies how long a managed Spot training job has to complete. When the
  /// job reaches the time limit, SageMaker ends the training job. Use this
  /// API to cap model training costs. To stop a job, SageMaker sends the
  /// algorithm the SIGTERM signal, which delays job termination for 120
  /// seconds. Algorithms can use this 120-second window to save the model
  /// artifacts, so the results of training are not lost.
  pub stopping_condition: StoppingCondition? = None
  /// A timestamp that indicates when the training job was created.
  pub creation_time: Time? = None
  /// Indicates the time when the training job starts on training instances.
  /// You are billed for the time interval between this time and the value of
  /// TrainingEndTime . The start time in CloudWatch Logs might be later than
  /// this time. The difference is due to the time it takes to download the
  /// training data and to the size of the training container.
  pub training_start_time: Time? = None
  /// Indicates the time when the training job ends on training instances. You
  /// are billed for the time interval between the value of TrainingStartTime
  /// and this time. For successful jobs and stopped jobs, this is the time
  /// after model artifacts are uploaded. For failed jobs, this is the time
  /// when SageMaker detects a job failure.
  pub training_end_time: Time? = None
  /// A timestamp that indicates when the status of the training job was last
  /// modified.
  pub last_modified_time: Time? = None
  /// A history of all of the secondary statuses that the training job has
  /// transitioned through.
  pub secondary_status_transitions: List[SecondaryStatusTransition]? = None
  /// A list of final metric values that are set when the training job
  /// completes. Used only if the training job was configured to use metrics.
  pub final_metric_data_list: List[MetricData]? = None
  /// If the TrainingJob was created with network isolation, the value is set
  /// to true . If network isolation is enabled, nodes can't communicate
  /// beyond the VPC they run in.
  pub enable_network_isolation: Bool? = None
  /// To encrypt all communications between ML compute instances in
  /// distributed training, choose True . Encryption provides greater security
  /// for distributed training, but training might take longer. How long it
  /// takes depends on the amount of communication between compute instances,
  /// especially if you use a deep learning algorithm in distributed training.
  pub enable_inter_container_traffic_encryption: Bool? = None
  /// When true, enables managed spot training using Amazon EC2 Spot instances
  /// to run training jobs instead of on-demand instances. For more
  /// information, see Managed Spot Training .
  pub enable_managed_spot_training: Bool? = None
  pub checkpoint_config: CheckpointConfig? = None
  /// The training time in seconds.
  pub training_time_in_seconds: Int? = None
  /// The billable time in seconds.
  pub billable_time_in_seconds: Int? = None
  pub debug_hook_config: DebugHookConfig? = None
  pub experiment_config: ExperimentConfig? = None
  /// Information about the debug rule configuration.
  pub debug_rule_configurations: List[DebugRuleConfiguration]? = None
  pub tensor_board_output_config: TensorBoardOutputConfig? = None
  /// Information about the evaluation status of the rules for the training
  /// job.
  pub debug_rule_evaluation_statuses: List[DebugRuleEvaluationStatus]? = None
  /// The output model package Amazon Resource Name (ARN) that contains model
  /// weights or checkpoint.
  pub output_model_package_arn: Str? = None
  /// The model package configuration.
  pub model_package_config: ModelPackageConfig? = None
  pub profiler_config: ProfilerConfig? = None
  /// The environment variables to set in the Docker container.
  pub environment: Map[Str, Str]? = None
  /// The number of times to retry the job when the job fails due to an
  /// InternalServerError .
  pub retry_strategy: RetryStrategy? = None
  /// An array of key-value pairs. You can use tags to categorize your Amazon
  /// Web Services resources in different ways, for example, by purpose,
  /// owner, or environment. For more information, see Tagging Amazon Web
  /// Services Resources .
  pub tags: List[Tag]? = None
}

/// Defines the input needed to run a training job using the algorithm.
pub struct TrainingJobDefinition {
  pub training_input_mode: TrainingInputMode? = None
  /// The hyperparameters used for the training job.
  pub hyper_parameters: Map[Str, Str]? = None
  /// An array of Channel objects, each of which specifies an input source.
  pub input_data_config: List[Channel]? = None
  /// the path to the S3 bucket where you want to store model artifacts.
  /// SageMaker creates subfolders for the artifacts.
  pub output_data_config: OutputDataConfig? = None
  /// The resources, including the ML compute instances and ML storage
  /// volumes, to use for model training.
  pub resource_config: ResourceConfig? = None
  /// Specifies a limit to how long a model training job can run. It also
  /// specifies how long a managed Spot training job has to complete. When the
  /// job reaches the time limit, SageMaker ends the training job. Use this
  /// API to cap model training costs. To stop a job, SageMaker sends the
  /// algorithm the SIGTERM signal, which delays job termination for 120
  /// seconds. Algorithms can use this 120-second window to save the model
  /// artifacts.
  pub stopping_condition: StoppingCondition? = None
}

pub enum TrainingJobEarlyStoppingType: Str {
  Off = "Off"
  Auto = "Auto"
  Unknown(value: Str)
}

pub enum TrainingJobSortByOptions: Str {
  Name = "Name"
  CreationTime = "CreationTime"
  Status = "Status"
  FinalObjectiveMetricValue = "FinalObjectiveMetricValue"
  Unknown(value: Str)
}

pub enum TrainingJobStatus: Str {
  InProgress = "InProgress"
  Completed = "Completed"
  Failed = "Failed"
  Stopping = "Stopping"
  Stopped = "Stopped"
  Deleting = "Deleting"
  Unknown(value: Str)
}

/// The numbers of training jobs launched by a hyperparameter tuning job,
/// categorized by status.
pub struct TrainingJobStatusCounters {
  /// The number of completed training jobs launched by the hyperparameter
  /// tuning job.
  pub completed: Int? = None
  /// The number of in-progress training jobs launched by a hyperparameter
  /// tuning job.
  pub in_progress: Int? = None
  /// The number of training jobs that failed, but can be retried. A failed
  /// training job can be retried only if it failed because an internal
  /// service error occurred.
  pub retryable_error: Int? = None
  /// The number of training jobs that failed and can't be retried. A failed
  /// training job can't be retried if it failed because a client error
  /// occurred.
  pub non_retryable_error: Int? = None
  /// The number of training jobs launched by a hyperparameter tuning job that
  /// were manually stopped.
  pub stopped: Int? = None
}

/// Metadata for a training job step.
pub struct TrainingJobStepMetadata {
  /// The Amazon Resource Name (ARN) of the training job that was run by this
  /// step execution.
  pub arn: Str? = None
}

/// Provides summary information about a training job.
pub struct TrainingJobSummary {
  /// The name of the training job that you want a summary for.
  pub training_job_name: Str? = None
  /// The Amazon Resource Name (ARN) of the training job.
  pub training_job_arn: Str? = None
  /// A timestamp that shows when the training job was created.
  pub creation_time: Time? = None
  /// A timestamp that shows when the training job ended. This field is set
  /// only if the training job has one of the terminal statuses ( Completed ,
  /// Failed , or Stopped ).
  pub training_end_time: Time? = None
  /// Timestamp when the training job was last modified.
  pub last_modified_time: Time? = None
  /// The status of the training job.
  pub training_job_status: TrainingJobStatus? = None
  /// The secondary status of the training job.
  pub secondary_status: SecondaryStatus? = None
  /// The status of the warm pool associated with the training job.
  pub warm_pool_status: WarmPoolStatus? = None
  /// The Amazon Resource Name (ARN); of the training plan associated with
  /// this training job. For more information about how to reserve GPU
  /// capacity for your SageMaker HyperPod clusters using Amazon SageMaker
  /// Training Plan, see CreateTrainingPlan .
  pub training_plan_arn: Str? = None
}

/// Details about an extension to a training plan, including the offering
/// ID, dates, status, and cost information.
pub struct TrainingPlanExtension {
  /// The unique identifier of the extension offering that was used to create
  /// this extension.
  pub training_plan_extension_offering_id: Str? = None
  /// The timestamp when the extension was created.
  pub extended_at: Time? = None
  /// The start date of the extension period.
  pub start_date: Time? = None
  /// The end date of the extension period.
  pub end_date: Time? = None
  /// The current status of the extension (e.g., Pending, Active, Scheduled,
  /// Failed, Expired).
  pub status: Str? = None
  /// The payment processing status of the extension.
  pub payment_status: Str? = None
  /// The Availability Zone of the extension.
  pub availability_zone: Str? = None
  /// The Availability Zone ID of the extension.
  pub availability_zone_id: Str? = None
  /// The duration of the extension in hours.
  pub duration_hours: Int? = None
  /// The upfront fee for the extension.
  pub upfront_fee: Str? = None
  /// The currency code for the upfront fee (e.g., USD).
  pub currency_code: Str? = None
}

/// Details about an available extension offering for a training plan. Use
/// the offering ID with the ExtendTrainingPlan API to extend a training
/// plan.
pub struct TrainingPlanExtensionOffering {
  /// The unique identifier for this extension offering.
  pub training_plan_extension_offering_id: Str? = None
  /// The Availability Zone for this extension offering.
  pub availability_zone: Str? = None
  /// The start date of this extension offering.
  pub start_date: Time? = None
  /// The end date of this extension offering.
  pub end_date: Time? = None
  /// The duration of this extension offering in hours.
  pub duration_hours: Int? = None
  /// The upfront fee for this extension offering.
  pub upfront_fee: Str? = None
  /// The currency code for the upfront fee (e.g., USD).
  pub currency_code: Str? = None
}

/// A filter to apply when listing or searching for training plans. For more
/// information about how to reserve GPU capacity for your SageMaker
/// HyperPod clusters using Amazon SageMaker Training Plan, see
/// CreateTrainingPlan .
pub struct TrainingPlanFilter {
  /// The name of the filter field (e.g., Status, InstanceType).
  pub name: TrainingPlanFilterName? = None
  /// The value to filter by for the specified field.
  pub value: Str? = None
}

pub enum TrainingPlanFilterName: Str {
  Status = "Status"
  Unknown(value: Str)
}

/// Details about a training plan offering. For more information about how
/// to reserve GPU capacity for your SageMaker HyperPod clusters using
/// Amazon SageMaker Training Plan, see CreateTrainingPlan .
pub struct TrainingPlanOffering {
  /// The unique identifier for this training plan offering.
  pub training_plan_offering_id: Str? = None
  /// The target resources (e.g., SageMaker Training Jobs, SageMaker HyperPod,
  /// SageMaker Endpoints, Studio apps) for this training plan offering.
  /// Training plans are specific to their target resource. A training plan
  /// designed for SageMaker training jobs can only be used to schedule and
  /// run training jobs. A training plan for HyperPod clusters can be used
  /// exclusively to provide compute resources to a cluster's instance group.
  /// A training plan for SageMaker endpoints can be used exclusively to
  /// provide compute resources to SageMaker endpoints for model deployment. A
  /// training plan for Studio apps can be used to launch JupyterLab and Code
  /// Editor apps on reserved training plan capacity.
  pub target_resources: List[SageMakerResourceName]? = None
  /// The requested start time that the user specified when searching for the
  /// training plan offering.
  pub requested_start_time_after: Time? = None
  /// The requested end time that the user specified when searching for the
  /// training plan offering.
  pub requested_end_time_before: Time? = None
  /// The number of whole hours in the total duration for this training plan
  /// offering.
  pub duration_hours: Int? = None
  /// The additional minutes beyond whole hours in the total duration for this
  /// training plan offering.
  pub duration_minutes: Int? = None
  /// The upfront fee for this training plan offering.
  pub upfront_fee: Str? = None
  /// The currency code for the upfront fee (e.g., USD).
  pub currency_code: Str? = None
  /// A list of reserved capacity offerings associated with this training plan
  /// offering.
  pub reserved_capacity_offerings: List[ReservedCapacityOffering]? = None
}

pub enum TrainingPlanSortBy: Str {
  Name = "TrainingPlanName"
  StartTime = "StartTime"
  Status = "Status"
  Unknown(value: Str)
}

pub enum TrainingPlanSortOrder: Str {
  Ascending = "Ascending"
  Descending = "Descending"
  Unknown(value: Str)
}

pub enum TrainingPlanStatus: Str {
  Pending = "Pending"
  Active = "Active"
  Scheduled = "Scheduled"
  Expired = "Expired"
  Failed = "Failed"
  Unknown(value: Str)
}

/// Details of the training plan. For more information about how to reserve
/// GPU capacity for your SageMaker HyperPod clusters using Amazon SageMaker
/// Training Plan, see CreateTrainingPlan .
pub struct TrainingPlanSummary {
  /// The Amazon Resource Name (ARN); of the training plan.
  pub training_plan_arn: Str? = None
  /// The name of the training plan.
  pub training_plan_name: Str? = None
  /// The current status of the training plan (e.g., Pending, Active,
  /// Expired). To see the complete list of status values available for a
  /// training plan, refer to the Status attribute within the
  /// TrainingPlanSummary object.
  pub status: TrainingPlanStatus? = None
  /// A message providing additional information about the current status of
  /// the training plan.
  pub status_message: Str? = None
  /// The number of whole hours in the total duration for this training plan.
  pub duration_hours: Int? = None
  /// The additional minutes beyond whole hours in the total duration for this
  /// training plan.
  pub duration_minutes: Int? = None
  /// The start time of the training plan.
  pub start_time: Time? = None
  /// The end time of the training plan.
  pub end_time: Time? = None
  /// The upfront fee for the training plan.
  pub upfront_fee: Str? = None
  /// The currency code for the upfront fee (e.g., USD).
  pub currency_code: Str? = None
  /// The total number of instances reserved in this training plan.
  pub total_instance_count: Int? = None
  /// The number of instances currently available for use in this training
  /// plan.
  pub available_instance_count: Int? = None
  /// The number of instances currently in use from this training plan.
  pub in_use_instance_count: Int? = None
  /// The total number of UltraServers allocated to this training plan.
  pub total_ultra_server_count: Int? = None
  /// The target resources (e.g., training jobs, HyperPod clusters, Endpoints,
  /// Studio apps) that can use this training plan. Training plans are
  /// specific to their target resource. A training plan designed for
  /// SageMaker training jobs can only be used to schedule and run training
  /// jobs. A training plan for HyperPod clusters can be used exclusively to
  /// provide compute resources to a cluster's instance group. A training plan
  /// for SageMaker endpoints can be used exclusively to provide compute
  /// resources to SageMaker endpoints for model deployment. A training plan
  /// for Studio apps can be used to launch JupyterLab and Code Editor apps on
  /// reserved training plan capacity.
  pub target_resources: List[SageMakerResourceName]? = None
  /// A list of reserved capacities associated with this training plan,
  /// including details such as instance types, counts, and availability
  /// zones.
  pub reserved_capacity_summaries: List[ReservedCapacitySummary]? = None
}

/// The serverless training job progress information.
pub struct TrainingProgressInfo {
  /// The total step count per epoch.
  pub total_step_count_per_epoch: Int? = None
  /// The current step number.
  pub current_step: Int? = None
  /// The current epoch number.
  pub current_epoch: Int? = None
  /// The maximum number of epochs for this job.
  pub max_epoch: Int? = None
}

pub enum TrainingRepositoryAccessMode: Str {
  Platform = "Platform"
  Vpc = "Vpc"
  Unknown(value: Str)
}

/// An object containing authentication information for a private Docker
/// registry.
pub struct TrainingRepositoryAuthConfig {
