  pub aws_regions: List[Str]? = None
  pub non_aws_regions: List[Str]? = None
  pub architectural_design: Str? = None
  pub review_owner: Str? = None
  /// The review restriction date for the workload.
  pub review_restriction_date: Time? = None
  /// Flag indicating whether the workload owner has acknowledged that the
  /// Review owner field is required. If a Review owner is not added to the
  /// workload within 60 days of acknowledgement, access to the workload is
  /// restricted until an owner is added.
  pub is_review_owner_update_acknowledged: Bool? = None
  pub industry_type: Str? = None
  pub industry: Str? = None
  pub notes: Str? = None
  pub improvement_status: WorkloadImprovementStatus? = None
  pub risk_counts: Map[Str, Int]? = None
  pub pillar_priorities: List[Str]? = None
  pub lenses: List[Str]? = None
  pub owner: Str? = None
  /// The ID assigned to the share invitation.
  pub share_invitation_id: Str? = None
  /// The tags associated with the workload.
  pub tags: Map[Str, Str]? = None
  /// Discovery configuration associated to the workload.
  pub discovery_config: WorkloadDiscoveryConfig? = None
  /// List of AppRegistry application ARNs associated to the workload.
  pub applications: List[Str]? = None
  /// Profile associated with a workload.
  pub profiles: List[WorkloadProfile]? = None
  pub prioritized_risk_counts: Map[Str, Int]? = None
  /// Jira configuration for a specific workload.
  pub jira_configuration: WorkloadJiraConfigurationOutput? = None
}

/// Discovery configuration associated to the workload.
pub struct WorkloadDiscoveryConfig {
  /// Discovery integration status in respect to Trusted Advisor for the
  /// workload.
  pub trusted_advisor_integration_status: TrustedAdvisorIntegrationStatus? = None
  /// The mode to use for identifying resources associated with the workload.
  /// You can specify WORKLOAD_METADATA , APP_REGISTRY , or both.
  pub workload_resource_definition: List[DefinitionType]? = None
}

/// The environment for the workload.
pub enum WorkloadEnvironment: Str {
  Production = "PRODUCTION"
  Preproduction = "PREPRODUCTION"
  Unknown(value: Str)
}

/// The improvement status for a workload.
pub enum WorkloadImprovementStatus: Str {
  NotApplicable = "NOT_APPLICABLE"
  NotStarted = "NOT_STARTED"
  InProgress = "IN_PROGRESS"
  Complete = "COMPLETE"
  RiskAcknowledged = "RISK_ACKNOWLEDGED"
  Unknown(value: Str)
}

pub enum WorkloadIssueManagementStatus: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Inherit = "INHERIT"
  Unknown(value: Str)
}

/// Workload-level: Input for the Jira configuration.
pub struct WorkloadJiraConfigurationInput {
  /// Workload-level: Jira issue management status.
  pub issue_management_status: WorkloadIssueManagementStatus? = None
  /// Workload-level: Jira issue management type.
  pub issue_management_type: IssueManagementType? = None
  /// Workload-level: Jira project key to sync workloads to.
  pub jira_project_key: Str? = None
}

/// Workload-level: Output configuration of the Jira integration.
pub struct WorkloadJiraConfigurationOutput {
  /// Workload-level: Jira issue management status.
  pub issue_management_status: WorkloadIssueManagementStatus? = None
  /// Workload-level: Jira issue management type.
  pub issue_management_type: IssueManagementType? = None
  /// Workload-level: Jira project key to sync workloads to.
  pub jira_project_key: Str? = None
  /// Workload-level: Status message on configuration of the Jira integration.
  pub status_message: Str? = None
}

/// The profile associated with a workload.
pub struct WorkloadProfile {
  /// The profile ARN.
  pub profile_arn: Str? = None
  /// The profile version.
  pub profile_version: Str? = None
}

/// A workload share return object.
pub struct WorkloadShare {
  pub share_id: Str? = None
  pub shared_by: Str? = None
  pub shared_with: Str? = None
  pub permission_type: PermissionType? = None
  pub status: ShareStatus? = None
  pub workload_name: Str? = None
  pub workload_id: Str? = None
}

/// A workload share summary return object.
pub struct WorkloadShareSummary {
  pub share_id: Str? = None
  pub shared_with: Str? = None
  pub permission_type: PermissionType? = None
  pub status: ShareStatus? = None
  /// Optional message to compliment the Status field.
  pub status_message: Str? = None
}

/// A workload summary return object.
pub struct WorkloadSummary {
  pub workload_id: Str? = None
  pub workload_arn: Str? = None
  pub workload_name: Str? = None
  pub owner: Str? = None
  /// The date and time when the workload was last updated.
  pub updated_at: Time? = None
  pub lenses: List[Str]? = None
  pub risk_counts: Map[Str, Int]? = None
  pub improvement_status: WorkloadImprovementStatus? = None
  /// Profile associated with a workload.
  pub profiles: List[WorkloadProfile]? = None
  pub prioritized_risk_counts: Map[Str, Int]? = None
}
