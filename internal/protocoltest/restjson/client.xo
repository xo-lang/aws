fn json_of_timestamp_format_headers_io(v: TimestampFormatHeadersIO) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.member_epoch_seconds {
    fs.push(("memberEpochSeconds", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.member_http_date {
    fs.push(("memberHttpDate", jsonv.time(x, "http-date")))
  }
  if let Some(x) = v.member_date_time {
    fs.push(("memberDateTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.default_format {
    fs.push(("defaultFormat", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.target_epoch_seconds {
    fs.push(("targetEpochSeconds", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.target_http_date {
    fs.push(("targetHttpDate", jsonv.time(x, "http-date")))
  }
  if let Some(x) = v.target_date_time {
    fs.push(("targetDateTime", jsonv.time(x, "date-time")))
  }
  json.Value.Object(fs)
}

fn from_json_timestamp_format_headers_io(v: json.Value) -> TimestampFormatHeadersIO ! Str {
  var out = TimestampFormatHeadersIO{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "memberEpochSeconds" => out.member_epoch_seconds = jsonv.read_time(fv, "epoch-seconds")?
      "memberHttpDate" => out.member_http_date = jsonv.read_time(fv, "http-date")?
      "memberDateTime" => out.member_date_time = jsonv.read_time(fv, "date-time")?
      "defaultFormat" => out.default_format = jsonv.read_time(fv, "epoch-seconds")?
      "targetEpochSeconds" => out.target_epoch_seconds = jsonv.read_time(fv, "epoch-seconds")?
      "targetHttpDate" => out.target_http_date = jsonv.read_time(fv, "http-date")?
      "targetDateTime" => out.target_date_time = jsonv.read_time(fv, "date-time")?
      _ => {}
    }
  }
  Ok(out)
}

