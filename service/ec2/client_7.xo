fn xml_write_spot_instance_request(var w: xmlv.Writer, v: SpotInstanceRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.actual_block_hourly_price {
    xmlv.elem(w, "actualBlockHourlyPrice", x, [])
  }
  if let Some(x) = v.availability_zone_group {
    xmlv.elem(w, "availabilityZoneGroup", x, [])
  }
  if let Some(x) = v.block_duration_minutes {
    xmlv.elem(w, "blockDurationMinutes", "${x}", [])
  }
  if let Some(x) = v.create_time {
    xmlv.elem(w, "createTime", rest.date_time(x), [])
  }
  if let Some(x) = v.fault_value {
    xml_write_spot_instance_state_fault(w, x, "fault", [])
  }
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.launch_group {
    xmlv.elem(w, "launchGroup", x, [])
  }
  if let Some(x) = v.launch_specification {
    xml_write_launch_specification(w, x, "launchSpecification", [])
  }
  if let Some(x) = v.launched_availability_zone {
    xmlv.elem(w, "launchedAvailabilityZone", x, [])
  }
  if let Some(x) = v.launched_availability_zone_id {
    xmlv.elem(w, "launchedAvailabilityZoneId", x, [])
  }
  if let Some(x) = v.product_description {
    xmlv.elem(w, "productDescription", x.value(), [])
  }
  if let Some(x) = v.spot_instance_request_id {
    xmlv.elem(w, "spotInstanceRequestId", x, [])
  }
  if let Some(x) = v.spot_price {
    xmlv.elem(w, "spotPrice", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.status {
    xml_write_spot_instance_status(w, x, "status", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "type", x.value(), [])
  }
  if let Some(x) = v.valid_from {
    xmlv.elem(w, "validFrom", rest.date_time(x), [])
  }
  if let Some(x) = v.valid_until {
    xmlv.elem(w, "validUntil", rest.date_time(x), [])
  }
  if let Some(x) = v.instance_interruption_behavior {
    xmlv.elem(w, "instanceInterruptionBehavior", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_spot_instance_request(e: xml.Element) -> SpotInstanceRequest ! Str {
  var out = SpotInstanceRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "actualBlockHourlyPrice" => out.actual_block_hourly_price = c.text()
      "availabilityZoneGroup" => out.availability_zone_group = c.text()
      "blockDurationMinutes" => out.block_duration_minutes = xmlv.read_int(c.text())?
      "createTime" => out.create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "fault" => out.fault_value = xml_read_spot_instance_state_fault(c)?
      "instanceId" => out.instance_id = c.text()
      "launchGroup" => out.launch_group = c.text()
      "launchSpecification" => out.launch_specification = xml_read_launch_specification(c)?
      "launchedAvailabilityZone" => out.launched_availability_zone = c.text()
      "launchedAvailabilityZoneId" => out.launched_availability_zone_id = c.text()
      "productDescription" => out.product_description = RIProductDescription.from(c.text())
      "spotInstanceRequestId" => out.spot_instance_request_id = c.text()
      "spotPrice" => out.spot_price = c.text()
      "state" => out.state = SpotInstanceState.from(c.text())
      "status" => out.status = xml_read_spot_instance_status(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "type" => out.type_value = SpotInstanceType.from(c.text())
      "validFrom" => out.valid_from = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "validUntil" => out.valid_until = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "instanceInterruptionBehavior" => out.instance_interruption_behavior = InstanceInterruptionBehavior.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

