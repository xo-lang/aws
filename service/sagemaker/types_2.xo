  /// Specifies the search strategy hyperparameter tuning uses to choose which
  /// hyperparameters to evaluate at each iteration.
  pub strategy: HyperParameterTuningJobStrategyType? = None
  /// The date and time that the tuning job was created.
  pub creation_time: Time? = None
  /// The date and time that the tuning job ended.
  pub hyper_parameter_tuning_end_time: Time? = None
  /// The date and time that the tuning job was modified.
  pub last_modified_time: Time? = None
  /// The TrainingJobStatusCounters object that specifies the numbers of
