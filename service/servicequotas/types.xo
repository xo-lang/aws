pub enum RequestStatus: Str {
  Pending = "PENDING"
  CaseOpened = "CASE_OPENED"
  Approved = "APPROVED"
  Denied = "DENIED"
  CaseClosed = "CASE_CLOSED"
  NotApproved = "NOT_APPROVED"
