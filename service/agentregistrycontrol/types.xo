pub struct ValidatePublisherRequest {
  pub publisher_arn: Str? = None
}

/// The publisher after verification restarts, in ACTION_REQUIRED with a new
/// domainChallenge.
pub struct ValidatePublisherResponse {
  pub value: Identifier? = None
  /// The identifier type. `DOMAIN` is the only supported value.
  pub identifier_type: IdentifierType? = None
  /// The domain verification status of the publisher: - `ACTION_REQUIRED`:
  /// The registry is waiting to find the DNS TXT record described by
  /// `domainChallenge`. - `ACTIVE`: The domain is verified. You can associate
  /// registry records with the publisher. - `SUSPENDED`: The domain was
  /// verified, but a later check found the TXT record missing or changed. The
  /// publisher returns to `ACTIVE` when the record is found again, and
  /// becomes `FAILED` if the record stays missing. - `FAILED`: Verification
  /// didn't succeed, for example because the TXT record wasn't found in time
  /// or another account verified the domain first. Call `ValidatePublisher`
  /// to try again. - `DELETING`: A delete is in progress.
  pub status: VerificationStatus? = None
  /// The reason for the publisher's current status, such as why verification
  /// failed. Present only when a reason is available.
  pub status_reason: Str? = None
  pub domain_challenge: DomainChallenge? = None
  /// The tags attached to the publisher.
  pub tags: Map[Str, Str]? = None
  /// The date and time that the publisher was created.
  pub created_at: Time? = None
  /// The date and time that the publisher was last updated.
  pub updated_at: Time? = None
  pub publisher_arn: Str? = None
}

/// The request failed validation of one or more input fields.
pub struct ValidationException {
  pub message: Str? = None
  /// The reason the request failed validation.
  pub reason: ValidationExceptionReason? = None
  /// The list of input fields that failed validation.
  pub field_list: List[ValidationExceptionField]? = None
}

/// Describes a single input field that failed validation.
pub struct ValidationExceptionField {
  /// The name of the field that failed validation.
  pub name: Str? = None
  /// A description of why the field failed validation.
  pub message: Str? = None
}

pub enum ValidationExceptionReason: Str {
  CannotParse = "CannotParse"
  FieldValidationFailed = "FieldValidationFailed"
  IdempotentParameterMismatchException = "IdempotentParameterMismatchException"
  RootEventInOtherSession = "EventInOtherSession"
  ResourceConflict = "ResourceConflict"
  UnsupportedInRegion = "UnsupportedInRegion"
  Unknown(value: Str)
}

pub enum VerificationStatus: Str {
  ActionRequired = "ACTION_REQUIRED"
  Active = "ACTIVE"
  Failed = "FAILED"
  Suspended = "SUSPENDED"
  Deleting = "DELETING"
  Unknown(value: Str)
}

/// The workload identity details associated with a source resource. Present
/// on the source details of a provenance entry when the upstream resource
/// has a workload identity configured.
pub struct WorkloadIdentityDetails {
  /// The Amazon Resource Name (ARN) of the workload identity associated with
  /// the source resource.
  pub workload_identity_arn: Str? = None
}
