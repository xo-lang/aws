/// Required settings: You must also set Framerate to 25.
pub enum ProresSlowPal: Str {
  Disabled = "DISABLED"
  Enabled = "ENABLED"
  Unknown(value: Str)
}

/// When you do frame rate conversion from 23.976 frames per second (fps) to
