use github.com/xo-lang/aws

test "environment keys" {
  os.env.set("AWS_ACCESS_KEY_ID", "AKIDTEST0000000000")
  os.env.set("AWS_SECRET_ACCESS_KEY", "invented-secret")
  os.env.set("AWS_SESSION_TOKEN", "invented-token")
  let c = from_env(os.env)?
  expect(c.access_key_id) == "AKIDTEST0000000000"
  expect(c.secret_access_key.reveal()) == "invented-secret"
  expect(c.session_token.map(fn(t) { t.reveal() })) == Some("invented-token")
  expect(c.source) == "EnvironmentVariables"
}

test "older variable names" {
  os.env.set("AWS_ACCESS_KEY", "AKIDTEST0000000000")
  os.env.set("AWS_SECRET_KEY", "invented-secret")
  let c = from_env(os.env)?
  expect(c.access_key_id) == "AKIDTEST0000000000"
  expect(c.session_token.is_none()) == true
}

test "nothing set is NotFound" {
  expect(from_env(os.env) is Err(aws.CredentialsErr.NotFound(_))) == true
}

test "half set is Invalid" {
  os.env.set("AWS_ACCESS_KEY_ID", "AKIDTEST0000000000")
  expect(from_env(os.env) is Err(aws.CredentialsErr.Invalid(_))) == true
}

test "static provider" {
  let p = static_provider("AKIDTEST0000000000", "invented-secret")
  let c = p.retrieve()?
  expect(c.source) == "StaticCredentials"
  expect(static_provider("", "").retrieve() is Err(aws.CredentialsErr.Invalid(_))) == true
}

test "debug output hides secrets" {
  let p = static_provider("AKIDTEST0000000000", "invented-secret", session_token: "invented-token")
  let text = "${p.creds:?}"
  expect(text.contains("invented-secret")) == false
  expect(text.contains("invented-token")) == false
}

test "expiry window" {
  let now = Time.from_unix(1000)
  let c = aws.Credentials{access_key_id: "a", secret_access_key: Secret.new("b"), expires: Time.from_unix(1200)}
  expect(aws.expires_within(c, now, 5m)) == true
  expect(aws.expires_within(c, now, 1m)) == false
}
