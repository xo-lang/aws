}

/// The HTTP request of DeleteConnection.
pub fn serialize_delete_connection(ep: rest.Endpoint, input: DeleteConnectionRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_client_id = match input.client_id {
    Some(v) => v
    None => return Err("input member clientId is required")
  }
  if label_client_id == "" {
    return Err("input member clientId must not be empty")
  }
  if let Some(v) = input.clean_session {
    qs.push(("cleanSession", "${v}"))
  }
  if let Some(v) = input.prevent_will_message {
    qs.push(("preventWillMessage", "${v}"))
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "DELETE",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/connections/${rest.escape(label_client_id, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_delete_connection(resp: http.Response) -> () ! Str {
  let _ = resp
  Ok(())
}

/// The errors of DeleteConnection.
pub enum DeleteConnectionErr {
  ForbiddenException(e: ForbiddenException)
  InternalFailureException(e: InternalFailureException)
  InvalidRequestException(e: InvalidRequestException)
  ResourceNotFoundException(e: ResourceNotFoundException)
  ThrottlingException(e: ThrottlingException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: DeleteConnectionErr) display() -> Str {
  match e {
    ForbiddenException(x) => "ForbiddenException: ${x:?}"
    InternalFailureException(x) => "InternalFailureException: ${x:?}"
    InvalidRequestException(x) => "InvalidRequestException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_delete_connection_error(resp: http.Response) -> DeleteConnectionErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "ForbiddenException" => match read_error_forbidden_exception(resp, body) {
      Ok(x) => return DeleteConnectionErr.ForbiddenException(x)
      Err(msg) => return DeleteConnectionErr.Deserialize(msg)
    }
    "InternalFailureException" => match read_error_internal_failure_exception(resp, body) {
      Ok(x) => return DeleteConnectionErr.InternalFailureException(x)
      Err(msg) => return DeleteConnectionErr.Deserialize(msg)
    }
    "InvalidRequestException" => match read_error_invalid_request_exception(resp, body) {
      Ok(x) => return DeleteConnectionErr.InvalidRequestException(x)
      Err(msg) => return DeleteConnectionErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return DeleteConnectionErr.ResourceNotFoundException(x)
      Err(msg) => return DeleteConnectionErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return DeleteConnectionErr.ThrottlingException(x)
      Err(msg) => return DeleteConnectionErr.Deserialize(msg)
    }
    _ => {}
  }
  DeleteConnectionErr.Api(restjson.api_error(resp, body))
}

/// Disconnects a connected MQTT client from Amazon Web Services IoT Core.
/// When you disconnect a client, Amazon Web Services IoT Core closes the
/// client's network connection and optionally cleans the session state.
/// Requires permission to access the DeleteConnection action.
pub fn (c: Client) delete_connection(input: DeleteConnectionRequest) -> () ! DeleteConnectionErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_delete_connection(c.params, input)) ?? e => return Err(DeleteConnectionErr.InvalidInput(e))
  var req = serialize_delete_connection(ep, input, "") ?? e => return Err(DeleteConnectionErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(DeleteConnectionErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_delete_connection_error(resp))
  }
  deserialize_delete_connection(resp) ?? e => Err(DeleteConnectionErr.Deserialize(e))
}

