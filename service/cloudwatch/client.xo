fn xml_write_metric_stat(var w: xmlv.Writer, v: MetricStat, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.metric {
    xml_write_metric(w, x, "Metric", [])
  }
  if let Some(x) = v.period {
    xmlv.elem(w, "Period", "${x}", [])
  }
  if let Some(x) = v.stat {
    xmlv.elem(w, "Stat", x, [])
  }
  if let Some(x) = v.unit {
    xmlv.elem(w, "Unit", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_metric_stat(e: xml.Element) -> MetricStat ! Str {
  var out = MetricStat{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Metric" => out.metric = xml_read_metric(c)?
      "Period" => out.period = xmlv.read_int(c.text())?
      "Stat" => out.stat = c.text()
      "Unit" => out.unit = StandardUnit.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

