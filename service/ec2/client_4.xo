fn xml_read_instance(e: xml.Element) -> Instance ! Str {
  var out = Instance{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "architecture" => out.architecture = ArchitectureValues.from(c.text())
      "blockDeviceMapping" => out.block_device_mappings = xml_read_instance_block_device_mapping_list(c)?
      "clientToken" => out.client_token = c.text()
      "ebsOptimized" => out.ebs_optimized = xmlv.read_bool(c.text())?
      "enaSupport" => out.ena_support = xmlv.read_bool(c.text())?
      "hypervisor" => out.hypervisor = HypervisorType.from(c.text())
      "iamInstanceProfile" => out.iam_instance_profile = xml_read_iam_instance_profile(c)?
      "instanceLifecycle" => out.instance_lifecycle = InstanceLifecycleType.from(c.text())
      "elasticGpuAssociationSet" => out.elastic_gpu_associations = xml_read_elastic_gpu_association_list(c)?
      "elasticInferenceAcceleratorAssociationSet" => out.elastic_inference_accelerator_associations = xml_read_elastic_inference_accelerator_association_list(c)?
      "networkInterfaceSet" => out.network_interfaces = xml_read_instance_network_interface_list(c)?
      "outpostArn" => out.outpost_arn = c.text()
      "rootDeviceName" => out.root_device_name = c.text()
      "rootDeviceType" => out.root_device_type = DeviceType.from(c.text())
      "groupSet" => out.security_groups = xml_read_group_identifier_list(c)?
      "sourceDestCheck" => out.source_dest_check = xmlv.read_bool(c.text())?
      "spotInstanceRequestId" => out.spot_instance_request_id = c.text()
