/// Projected content for a PATCH artifact: the remediation patch for one
/// repository, with the descriptors needed to verify and apply it and the
/// state of its delivery to the customer's own bucket or repository.
pub struct PatchBody {
  /// The patch exactly as stored, unmodified. Control Plane accepted it only
  /// as a text unified diff, so `git apply` applies it.
  pub patch: Str? = None
  /// The patch's wire format, read from the patch itself, which determines
  /// how to apply it. Absent when the patch starts with neither a git mailbox
  /// header nor a `diff --git` header.
  pub format: PatchFormat? = None
  /// The repository the patch applies to, as named in the source snapshot it
  /// was generated against.
  pub repository_name: Str? = None
  /// SHA-256 of the patch's UTF-8 bytes in lowercase hex, computed by Control
  /// Plane when it stored the patch. Lets a caller confirm the patch it
  /// applies is byte-for-byte the one that was reviewed. Computed over the
  /// patch bytes, so it is verifiable against `patch` without trusting this
  /// value.
  pub patch_sha256: Str? = None
  /// Size of the patch in UTF-8 bytes, the unit the digest is computed over.
  pub size_bytes: Int? = None
  /// Delivery of the patch to the customer's bucket or repository. Absent
  /// when the artifact has no delivery destination.
  pub delivery: PatchDelivery? = None
}

/// Policy governing whether Continuum creates a patch for a proposed
/// remediation.
pub enum PatchCreationPolicy: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// Delivery of a patch to a destination the customer owns: an object in the
/// environment's source bucket or a pull request in the source repository.
pub struct PatchDelivery {
  /// How far delivery to the destination has progressed.
  pub status: DeliveryStatus? = None
  /// Where the patch was or will be delivered. Absent while the destination
  /// is still being resolved, or when delivery was skipped before a
  /// destination was known.
  pub target_value: DestinationTarget? = None
  /// When the delivery status last changed.
  pub updated_at: Time? = None
}

/// How a patch is encoded, which determines the command that applies it.
pub enum PatchFormat: Str {
  GitMailboxPatch = "GIT_MAILBOX_PATCH"
  GitBinaryDiff = "GIT_BINARY_DIFF"
  GitDiff = "GIT_DIFF"
  Unknown(value: Str)
}

