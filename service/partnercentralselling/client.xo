fn json_of_opportunity_search_filter_value(v: OpportunitySearchFilterValue) -> json.Value {
  match v {
    StringValue(x) => json.Value.Object([("StringValue", json.Value.Str(x))])
    StringListValue(x) => json.Value.Object([("StringListValue", json_of_opportunity_search_filter_values(x))])
    LongValue(x) => json.Value.Object([("LongValue", json.Value.Int(x))])
    DoubleValue(x) => json.Value.Object([("DoubleValue", jsonv.float(x))])
    DateValue(x) => json.Value.Object([("DateValue", jsonv.time(x, "date-time"))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_opportunity_search_filter_value(v: json.Value) -> OpportunitySearchFilterValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "StringValue" => Ok(OpportunitySearchFilterValue.StringValue(jsonv.read_str(fv)?))
      "StringListValue" => Ok(OpportunitySearchFilterValue.StringListValue(from_json_opportunity_search_filter_values(fv)?))
      "LongValue" => Ok(OpportunitySearchFilterValue.LongValue(jsonv.read_int(fv)?))
      "DoubleValue" => Ok(OpportunitySearchFilterValue.DoubleValue(jsonv.read_float(fv)?))
      "DateValue" => Ok(OpportunitySearchFilterValue.DateValue(jsonv.read_time(fv, "date-time")?))
      _ => Ok(OpportunitySearchFilterValue.Unknown(k))
    }
  }
  Err("OpportunitySearchFilterValue: no member set")
}

