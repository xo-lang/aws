/// The HTTP request of CreateConnector.
pub fn serialize_create_connector(ep: rest.Endpoint, input: CreateConnectorRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.directory_id {
