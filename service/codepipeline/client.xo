      Ok(x) => return UpdatePipelineErr.InvalidStructureException(x)
      Err(msg) => return UpdatePipelineErr.Deserialize(msg)
    }
    "LimitExceededException" => match read_error_limit_exceeded_exception(resp, body) {
      Ok(x) => return UpdatePipelineErr.LimitExceededException(x)
      Err(msg) => return UpdatePipelineErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdatePipelineErr.ValidationException(x)
      Err(msg) => return UpdatePipelineErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdatePipelineErr.Api(restjson.api_error(resp, body))
}