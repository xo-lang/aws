      "serviceQuotaExceededException" => Ok(CodeInterpreterStreamOutput.ServiceQuotaExceededException(from_json_service_quota_exceeded_exception(fv)?))
      "throttlingException" => Ok(CodeInterpreterStreamOutput.ThrottlingException(from_json_throttling_exception(fv)?))
