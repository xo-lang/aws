  /// The number of rows output from the stage after execution.
  pub output_rows: Int? = None
  /// The number of bytes input into the stage for execution.
  pub input_bytes: Int? = None
  /// The number of rows input into the stage for execution.
  pub input_rows: Int? = None
  /// Time taken to execute this stage.
  pub execution_time: Int? = None
  /// Stage plan information such as name, identifier, sub plans, and source
  /// stages.
  pub query_stage_plan: QueryStagePlanNode? = None
  /// List of sub query stages that form this stage execution plan.
