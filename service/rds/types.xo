pub struct InvalidSubnet {
  pub message: Str? = None
}

/// The DB subnet group doesn't cover all Availability Zones after it's
/// created because of users' change.
pub struct InvalidVPCNetworkStateFault {
  pub message: Str? = None
}

/// The details of an issue with your DB instances, DB clusters, and DB
/// parameter groups.
pub struct IssueDetails {
  /// A detailed description of the issue when the recommendation category is
  /// performance .
  pub performance_issue_details: PerformanceIssueDetails? = None
}

/// An error occurred accessing an Amazon Web Services KMS key.
pub struct KMSKeyNotAccessibleFault {
  pub message: Str? = None
}

pub enum LifecycleSupportName: Str {
  OpenSourceRdsStandardSupport = "open-source-rds-standard-support"
  OpenSourceRdsExtendedSupport = "open-source-rds-extended-support"
  Unknown(value: Str)
}

/// Contains details for Aurora Limitless Database.
pub struct LimitlessDatabase {
  /// The status of Aurora Limitless Database.
  pub status: LimitlessDatabaseStatus? = None
  /// The minimum required capacity for Aurora Limitless Database in Aurora
  /// capacity units (ACUs).
  pub min_required_acu: Float? = None
}

pub enum LimitlessDatabaseStatus: Str {
  Active = "active"
  NotInUse = "not-in-use"
  Enabled = "enabled"
  Disabled = "disabled"
  Enabling = "enabling"
  Disabling = "disabling"
  ModifyingMaxCapacity = "modifying-max-capacity"
  Error = "error"
  Unknown(value: Str)
}

pub struct ListTagsForResourceMessage {
  /// The Amazon RDS resource with tags to be listed. This value is an Amazon
  /// Resource Name (ARN). For information about creating an ARN, see
  /// Constructing an ARN for Amazon RDS in the Amazon RDS User Guide .
  pub resource_name: Str? = None
  /// This parameter isn't currently supported.
  pub filters: List[Filter]? = None
}

pub enum LocalWriteForwardingStatus: Str {
  Enabled = "enabled"
  Disabled = "disabled"
  Enabling = "enabling"
  Disabling = "disabling"
  Requested = "requested"
  Unknown(value: Str)
}

pub enum MasterUserAuthenticationType: Str {
  Password = "password"
  IamDbAuth = "iam-db-auth"
  Unknown(value: Str)
}

/// Contains the secret managed by RDS in Amazon Web Services Secrets
/// Manager for the master user password. For more information, see Password
/// management with Amazon Web Services Secrets Manager in the Amazon RDS
/// User Guide and Password management with Amazon Web Services Secrets
/// Manager in the Amazon Aurora User Guide.
pub struct MasterUserSecret {
  /// The Amazon Resource Name (ARN) of the secret.
  pub secret_arn: Str? = None
  /// The status of the secret. The possible status values include the
  /// following: creating - The secret is being created. active - The secret
  /// is available for normal use and rotation. rotating - The secret is being
  /// rotated. impaired - The secret can be used to access database
  /// credentials, but it can't be rotated. A secret might have this status
  /// if, for example, permissions are changed so that RDS can no longer
  /// access either the secret or the KMS key for the secret. When a secret
  /// has this status, you can correct the condition that caused the status.
  /// Alternatively, modify the DB instance to turn off automatic management
  /// of database credentials, and then modify the DB instance again to turn
  /// on automatic management of database credentials.
  pub secret_status: Str? = None
  /// The Amazon Web Services KMS key identifier that is used to encrypt the
  /// secret.
  pub kms_key_id: Str? = None
}

/// The maximum number of DB shard groups for your Amazon Web Services
/// account in the specified Amazon Web Services Region has been reached.
pub struct MaxDBShardGroupLimitReached {
  pub message: Str? = None
}

/// The representation of a metric.
pub struct Metric {
  /// The name of a metric.
  pub name: Str? = None
  /// A list of metric references (thresholds).
  pub references: List[MetricReference]? = None
  /// The details of different statistics for a metric. The description might
  /// contain markdown.
  pub statistics_details: Str? = None
  /// The query to retrieve metric data points.
  pub metric_query: MetricQuery? = None
}

/// The query to retrieve metric data points.
pub struct MetricQuery {
  /// The Performance Insights query that you can use to retrieve Performance
  /// Insights metric data points.
  pub performance_insights_metric_query: PerformanceInsightsMetricQuery? = None
}