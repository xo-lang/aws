fn xml_write_s3_access_grants_scope_union(var w: xmlv.Writer, v: S3AccessGrantsScopeUnion, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    ReadWriteAccess(x) => {
      xml_write_read_write_access(w, x, "ReadWriteAccess", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_s3_access_grants_scope_union(e: xml.Element) -> S3AccessGrantsScopeUnion ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "ReadWriteAccess" => Ok(S3AccessGrantsScopeUnion.ReadWriteAccess(xml_read_read_write_access(c)?))
      _ => Ok(S3AccessGrantsScopeUnion.Unknown(c.name.local))
    }
  }
  Err("S3AccessGrantsScopeUnion: no member set")
}

