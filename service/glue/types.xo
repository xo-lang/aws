  /// contextual information for encryption. This can only be provided if
  /// KMSKeyId is provided.
  pub additional_encryption_context: Map[Str, Str]? = None
  /// Metadata assigned to the resource consisting of a list of key-value
  /// pairs.
  pub tags: List[Tag]? = None
  /// The possible statuses are: CREATING: The integration is being created.
  /// ACTIVE: The integration creation succeeds. MODIFYING: The integration is
  /// being modified. FAILED: The integration creation fails. DELETING: The
  /// integration is deleted. SYNCING: The integration is synchronizing.
  /// NEEDS_ATTENTION: The integration needs attention, such as
  /// synchronization.
  pub status: IntegrationStatus? = None
  /// The time that the integration was created, in UTC.
  pub create_time: Time? = None
  /// Properties associated with the integration.
  pub integration_config: IntegrationConfig? = None
  /// A list of errors associated with the integration.
  pub errors: List[IntegrationError]? = None
  /// Selects source tables for the integration using Maxwell filter syntax.
  pub data_filter: Str? = None
}

/// Properties associated with the integration.
pub struct IntegrationConfig {
  /// Specifies the frequency at which CDC (Change Data Capture) pulls or
  /// incremental loads should occur. This parameter provides flexibility to
  /// align the refresh rate with your specific data update patterns, system
  /// load considerations, and performance optimization goals. Time increment
  /// can be set from 15 minutes to 8640 minutes (six days).
  pub refresh_interval: Str? = None
  /// A collection of key-value pairs that specify additional properties for
  /// the integration source. These properties provide configuration options
  /// that can be used to customize the behavior of the ODB source during data
  /// integration operations.
  pub source_properties: Map[Str, Str]? = None
  /// Enables continuous synchronization for on-demand data extractions from
  /// SaaS applications to Amazon Web Services data services like Amazon
  /// Redshift and Amazon S3.
  pub continuous_sync: Bool? = None
  /// An optional custom namespace for the integration's target. Supply this
  /// parameter only when the target is an Amazon S3 Tables table bucket; it
  /// is not accepted for other target types. The integration replicates data
  /// into the namespace you specify, reusing it if it already exists. If you
  /// omit this parameter, the target namespace defaults to zetl_ followed by
  /// the integration ID, with hyphens converted to underscores. The value is
  /// immutable after the integration is created; ModifyIntegration rejects
  /// changes to it. It must be a valid Amazon S3 Tables namespace name: 1 to
  /// 255 characters using lowercase letters, numbers, and underscores, with
  /// no leading or trailing underscore and no reserved aws prefix.
  pub target_namespace: Str? = None
}

/// The requested operation conflicts with another operation.
pub struct IntegrationConflictOperationFault {
  /// A message describing the problem.
  pub message: Str? = None
}

/// An error associated with a zero-ETL integration.
pub struct IntegrationError {
