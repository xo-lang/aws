/// Contains information about an IAM user entity. This data type is used as
/// a response element in the following operations: CreateUser GetUser
/// ListUsers
pub struct User {
  /// The path to the user. For more information about paths, see IAM
  /// identifiers in the IAM User Guide . The ARN of the policy used to set
  /// the permissions boundary for the user.
  pub path: Str? = None
  /// The friendly name identifying the user.
  pub user_name: Str? = None
  /// The stable and unique string identifying the user. For more information
  /// about IDs, see IAM identifiers in the IAM User Guide .
  pub user_id: Str? = None
  /// The Amazon Resource Name (ARN) that identifies the user. For more
  /// information about ARNs and how to use ARNs in policies, see IAM
  /// Identifiers in the IAM User Guide .
  pub arn: Str? = None
  /// The date and time, in ISO 8601 date-time format , when the user was
  /// created.
  pub create_date: Time? = None
  /// The date and time, in ISO 8601 date-time format , when the user's
  /// password was last used to sign in to an Amazon Web Services website. For
  /// a list of Amazon Web Services websites that capture a user's last
  /// sign-in time, see the Credential reports topic in the IAM User Guide .
  /// If a password is used more than once in a five-minute span, only the
  /// first use is returned in this field. If the field is null (no value),
  /// then it indicates that they never signed in with a password. This can be
  /// because: The user never had a password. A password exists but has not
  /// been used since IAM started tracking this information on October 20,
  /// 2014. A null value does not mean that the user never had a password.
  /// Also, if the user does not currently have a password but had one in the
  /// past, then this field contains the date and time the most recent
  /// password was used. This value is returned only in the GetUser and
  /// ListUsers operations.
  pub password_last_used: Time? = None
  /// For more information about permissions boundaries, see Permissions
  /// boundaries for IAM identities in the IAM User Guide .
  pub permissions_boundary: AttachedPermissionsBoundary? = None
  /// A list of tags that are associated with the user. For more information
  /// about tagging, see Tagging IAM resources in the IAM User Guide .
  pub tags: List[Tag]? = None
}

/// Contains information about an IAM user, including all the user's
/// policies and all the IAM groups the user is in. This data type is used
/// as a response element in the GetAccountAuthorizationDetails operation.
pub struct UserDetail {
  /// The path to the user. For more information about paths, see IAM
  /// identifiers in the IAM User Guide .
  pub path: Str? = None
  /// The friendly name identifying the user.
  pub user_name: Str? = None
  /// The stable and unique string identifying the user. For more information
  /// about IDs, see IAM identifiers in the IAM User Guide .
  pub user_id: Str? = None
  pub arn: Str? = None
  /// The date and time, in ISO 8601 date-time format , when the user was
  /// created.
  pub create_date: Time? = None
  /// A list of the inline policies embedded in the user.
  pub user_policy_list: List[PolicyDetail]? = None
  /// A list of IAM groups that the user is in.
  pub group_list: List[Str]? = None
  /// A list of the managed policies attached to the user.
  pub attached_managed_policies: List[AttachedPolicy]? = None
  /// The ARN of the policy used to set the permissions boundary for the user.
  /// For more information about permissions boundaries, see Permissions
  /// boundaries for IAM identities in the IAM User Guide .
  pub permissions_boundary: AttachedPermissionsBoundary? = None
  /// A list of tags that are associated with the user. For more information
  /// about tagging, see Tagging IAM resources in the IAM User Guide .
  pub tags: List[Tag]? = None
}

/// Contains information about a virtual MFA device.
pub struct VirtualMFADevice {
  /// The serial number associated with VirtualMFADevice .
  pub serial_number: Str? = None
  /// The base32 seed defined as specified in RFC3548 . The Base32StringSeed
  /// is base32-encoded.
  pub base32_string_seed: Bytes? = None
  /// A QR code PNG image that encodes
  /// otpauth://totp/$virtualMFADeviceName@$AccountName?secret=$Base32String
  /// where $virtualMFADeviceName is one of the create call arguments.
  /// AccountName is the user name if set (otherwise, the account ID
  /// otherwise), and Base32String is the seed in base32 format. The
  /// Base32String value is base64-encoded.
  pub qr_code_png: Bytes? = None
  /// The IAM user associated with this virtual MFA device.
  pub user: User? = None
  /// The date and time on which the virtual MFA device was enabled.
  pub enable_date: Time? = None
  /// A list of tags that are attached to the virtual MFA device. For more
  /// information about tagging, see Tagging IAM resources in the IAM User
  /// Guide .
  pub tags: List[Tag]? = None
}

