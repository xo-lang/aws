fn query_put_domain_membership_list(var f: query.Form, prefix: Str, v: List[DomainMembership], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.DomainMembership.${i + 1}" }
    query_put_domain_membership(f, k, x)
  }
}

