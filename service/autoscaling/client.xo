    xmlv.elem(w, "NewInstancesProtectedFromScaleIn", "${x}", [])
  }
  if let Some(x) = v.service_linked_role_arn {
    xmlv.elem(w, "ServiceLinkedRoleARN", x, [])
  }
  if let Some(x) = v.max_instance_lifetime {
    xmlv.elem(w, "MaxInstanceLifetime", "${x}", [])
  }
  if let Some(x) = v.capacity_rebalance {
    xmlv.elem(w, "CapacityRebalance", "${x}", [])
  }
  if let Some(x) = v.context {
    xmlv.elem(w, "Context", x, [])
  }
  if let Some(x) = v.desired_capacity_type {
    xmlv.elem(w, "DesiredCapacityType", x, [])
  }
