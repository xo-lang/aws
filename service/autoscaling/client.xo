  }
}

fn query_put_activities(var f: query.Form, prefix: Str, v: List[Activity], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_activity(f, k, x)
  }
}

fn query_put_activities_type(var f: query.Form, prefix: Str, v: ActivitiesType) {
  if let Some(x) = v.activities {
    query_put_activities(f, query.key(prefix, "Activities"), x, false)
  }
  if let Some(x) = v.next_token {
    query.add(f, query.key(prefix, "NextToken"), x)
  }
}

fn query_put_activity(var f: query.Form, prefix: Str, v: Activity) {
  if let Some(x) = v.activity_id {
    query.add(f, query.key(prefix, "ActivityId"), x)
  }
  if let Some(x) = v.auto_scaling_group_name {
    query.add(f, query.key(prefix, "AutoScalingGroupName"), x)
  }
  if let Some(x) = v.description {
    query.add(f, query.key(prefix, "Description"), x)
  }
  if let Some(x) = v.cause {
    query.add(f, query.key(prefix, "Cause"), x)
