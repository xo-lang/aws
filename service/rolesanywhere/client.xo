  }
  json.Value.Object(fs)
}

fn from_json_source(v: json.Value) -> Source ! Str {
  var out = Source{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "sourceType" => out.source_type = jsonv.read_str(fv)?
      "sourceData" => out.source_data = from_json_source_data(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_source_data(v: SourceData) -> json.Value {
  match v {
    X509CertificateData(x) => json.Value.Object([("x509CertificateData", json.Value.Str(x))])
    AcmPcaArn(x) => json.Value.Object([("acmPcaArn", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_source_data(v: json.Value) -> SourceData ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "x509CertificateData" => Ok(SourceData.X509CertificateData(jsonv.read_str(fv)?))
      "acmPcaArn" => Ok(SourceData.AcmPcaArn(jsonv.read_str(fv)?))
      _ => Ok(SourceData.Unknown(k))
    }
  }
  Err("SourceData: no member set")
}

