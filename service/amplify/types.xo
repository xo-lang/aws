  /// base64-encode the authorization credentials and provide them in the
  /// format user:password .
  pub basic_auth_credentials: Str? = None
  /// The custom redirect and rewrite rules for an Amplify app.
  pub custom_rules: List[CustomRule]? = None
  /// The build specification (build spec) for an Amplify app.
  pub build_spec: Str? = None
  /// The custom HTTP headers for an Amplify app.
  pub custom_headers: Str? = None
  /// Enables automated branch creation for an Amplify app.
  pub enable_auto_branch_creation: Bool? = None
  /// Describes the automated branch creation glob patterns for an Amplify
  /// app.
  pub auto_branch_creation_patterns: List[Str]? = None
  /// The automated branch creation configuration for an Amplify app.
  pub auto_branch_creation_config: AutoBranchCreationConfig? = None
  /// The name of the Git repository for an Amplify app.
  pub repository: Str? = None
  /// The OAuth token for a third-party source control system for an Amplify
  /// app. The OAuth token is used to create a webhook and a read-only deploy
  /// key using SSH cloning. The OAuth token is not stored. Use oauthToken for
  /// repository providers other than GitHub, such as Bitbucket or CodeCommit.
  /// To authorize access to GitHub as your repository provider, use
  /// accessToken . You must specify either oauthToken or accessToken when you
  /// update an app. Existing Amplify apps deployed from a GitHub repository
  /// using OAuth continue to work with CI/CD. However, we strongly recommend
  /// that you migrate these apps to use the GitHub App. For more information,
  /// see Migrating an existing OAuth app to the Amplify GitHub App in the
  /// Amplify User Guide .
  pub oauth_token: Str? = None
  /// The personal access token for a GitHub repository for an Amplify app.
  /// The personal access token is used to authorize access to a GitHub
  /// repository using the Amplify GitHub App. The token is not stored. Use
  /// accessToken for GitHub repositories only. To authorize access to a
  /// repository provider such as Bitbucket or CodeCommit, use oauthToken .
  /// You must specify either accessToken or oauthToken when you update an
  /// app. Existing Amplify apps deployed from a GitHub repository using OAuth
  /// continue to work with CI/CD. However, we strongly recommend that you
  /// migrate these apps to use the GitHub App. For more information, see
  /// Migrating an existing OAuth app to the Amplify GitHub App in the Amplify
  /// User Guide .
  pub access_token: Str? = None
  /// Describes the configuration details that apply to the jobs for an
  /// Amplify app.
  pub job_config: JobConfig? = None
  /// The cache configuration for the Amplify app.
  pub cache_config: CacheConfig? = None
}

/// The result structure for an Amplify app update request.
pub struct UpdateAppResult {
  /// Represents the updated Amplify app.
  pub app: App? = None
}

/// The request structure for the update branch request.
pub struct UpdateBranchRequest {
  /// The unique ID for an Amplify app.
  pub app_id: Str? = None
  /// The name of the branch.
  pub branch_name: Str? = None
  /// The description for the branch.
  pub description: Str? = None
  /// The framework for the branch.
  pub framework: Str? = None
  /// Describes the current stage for the branch.
  pub stage: Stage? = None
  /// Enables notifications for the branch.
  pub enable_notification: Bool? = None
  /// Enables auto building for the branch.
  pub enable_auto_build: Bool? = None
  /// Specifies whether the skew protection feature is enabled for the branch.
  /// Deployment skew protection is available to Amplify applications to
  /// eliminate version skew issues between client and servers in web
  /// applications. When you apply skew protection to a branch, you can ensure
  /// that your clients always interact with the correct version of
  /// server-side assets, regardless of when a deployment occurs. For more
  /// information about skew protection, see Skew protection for Amplify
  /// deployments in the Amplify User Guide .
  pub enable_skew_protection: Bool? = None
  /// The environment variables for the branch.
  pub environment_variables: Map[Str, Str]? = None
  /// The basic authorization credentials for the branch. You must
  /// base64-encode the authorization credentials and provide them in the
  /// format user:password .
  pub basic_auth_credentials: Str? = None
  /// Enables basic authorization for the branch.
  pub enable_basic_auth: Bool? = None
  /// Enables performance mode for the branch. Performance mode optimizes for
  /// faster hosting performance by keeping content cached at the edge for a
  /// longer interval. When performance mode is enabled, hosting configuration
  /// or code changes can take up to 10 minutes to roll out.
  pub enable_performance_mode: Bool? = None
  /// The build specification (build spec) for the branch.
  pub build_spec: Str? = None
  /// The content Time to Live (TTL) for the website in seconds.
  pub ttl: Str? = None
  /// The display name for a branch. This is used as the default domain
  /// prefix.
  pub display_name: Str? = None
  /// Enables pull request previews for this branch.
  pub enable_pull_request_preview: Bool? = None
  /// The Amplify environment name for the pull request.
  pub pull_request_environment_name: Str? = None
  /// The Amazon Resource Name (ARN) for a backend environment that is part of
  /// a Gen 1 Amplify app. This field is available to Amplify Gen 1 apps only
  /// where the backend is created using Amplify Studio or the Amplify command
  /// line interface (CLI).
  pub backend_environment_arn: Str? = None
  /// The backend for a Branch of an Amplify app. Use for a backend created
  /// from an CloudFormation stack. This field is available to Amplify Gen 2
  /// apps only. When you deploy an application with Amplify Gen 2, you
  /// provision the app's backend infrastructure using Typescript code.
  pub backend: Backend? = None
  /// The Amazon Resource Name (ARN) of the IAM role to assign to a branch of
  /// an SSR app. The SSR Compute role allows the Amplify Hosting compute
  /// service to securely access specific Amazon Web Services resources based
  /// on the role's permissions. For more information about the SSR Compute
  /// role, see Adding an SSR Compute role in the Amplify User Guide .
  pub compute_role_arn: Str? = None
}

/// The result structure for the update branch request.
pub struct UpdateBranchResult {
  /// The branch for an Amplify app, which maps to a third-party repository
  /// branch.
  pub branch: Branch? = None
}

/// The request structure for the update domain association request.
pub struct UpdateDomainAssociationRequest {
  /// The unique ID for an Amplify app.
  pub app_id: Str? = None
  /// The name of the domain.
  pub domain_name: Str? = None
  /// Enables the automated creation of subdomains for branches.
  pub enable_auto_sub_domain: Bool? = None
  /// Describes the settings for the subdomain.
  pub sub_domain_settings: List[SubDomainSetting]? = None
  /// Sets the branch patterns for automatic subdomain creation.
  pub auto_sub_domain_creation_patterns: List[Str]? = None
  /// The required AWS Identity and Access Management (IAM) service role for
  /// the Amazon Resource Name (ARN) for automatically creating subdomains.
  pub auto_sub_domain_iam_role: Str? = None
  /// The type of SSL/TLS certificate to use for your custom domain.
  pub certificate_settings: CertificateSettings? = None
}

/// The result structure for the update domain association request.
pub struct UpdateDomainAssociationResult {
  /// Describes a domain association, which associates a custom domain with an
  /// Amplify app.
  pub domain_association: DomainAssociation? = None
}

pub enum UpdateStatus: Str {
  RequestingCertificate = "REQUESTING_CERTIFICATE"
  PendingVerification = "PENDING_VERIFICATION"
  ImportingCustomCertificate = "IMPORTING_CUSTOM_CERTIFICATE"
  PendingDeployment = "PENDING_DEPLOYMENT"
  AwaitingAppCname = "AWAITING_APP_CNAME"
  UpdateComplete = "UPDATE_COMPLETE"
  UpdateFailed = "UPDATE_FAILED"
  Unknown(value: Str)
}

/// The request structure for the update webhook request.
pub struct UpdateWebhookRequest {
  /// The unique ID for a webhook.
  pub webhook_id: Str? = None
  /// The name for a branch that is part of an Amplify app.
  pub branch_name: Str? = None
  /// The description for a webhook.
  pub description: Str? = None
}

/// The result structure for the update webhook request.
pub struct UpdateWebhookResult {
  /// Describes a webhook that connects repository events to an Amplify app.
  pub webhook: Webhook? = None
}

/// Describes the Firewall configuration for a hosted Amplify application.
/// Firewall support enables you to protect your web applications with a
/// direct integration with WAF. For more information about using WAF
/// protections for an Amplify application, see Firewall support for hosted
/// sites in the Amplify User Guide .
pub struct WafConfiguration {
  /// The Amazon Resource Name (ARN) for the web ACL associated with an
  /// Amplify app.
  pub web_acl_arn: Str? = None
  /// The status of the process to associate or disassociate a web ACL to an
  /// Amplify app.
  pub waf_status: WafStatus? = None
  /// The reason for the current status of the Firewall configuration.
  pub status_reason: Str? = None
}

pub enum WafStatus: Str {
  Associating = "ASSOCIATING"
  AssociationFailed = "ASSOCIATION_FAILED"
  AssociationSuccess = "ASSOCIATION_SUCCESS"
  Disassociating = "DISASSOCIATING"
  DisassociationFailed = "DISASSOCIATION_FAILED"
  Unknown(value: Str)
}

/// Describes a webhook that connects repository events to an Amplify app.
pub struct Webhook {
  /// The Amazon Resource Name (ARN) for the webhook.
  pub webhook_arn: Str? = None
  /// The ID of the webhook.
  pub webhook_id: Str? = None
  /// The URL of the webhook.
  pub webhook_url: Str? = None
  /// The unique ID of an Amplify app.
  pub app_id: Str? = None
  /// The name for a branch that is part of an Amplify app.
  pub branch_name: Str? = None
  /// The description for a webhook.
  pub description: Str? = None
  /// A timestamp of when Amplify created the webhook in your Git repository.
  pub create_time: Time? = None
  /// A timestamp of when Amplify updated the webhook in your Git repository.
  pub update_time: Time? = None
}
