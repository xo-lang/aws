      "Status" => out.status = CommandStatus.from(jsonv.read_str(fv)?)
      "StatusDetails" => out.status_details = jsonv.read_str(fv)?
      "OutputS3Region" => out.output_s3_region = jsonv.read_str(fv)?
      "OutputS3BucketName" => out.output_s3_bucket_name = jsonv.read_str(fv)?
      "OutputS3KeyPrefix" => out.output_s3_key_prefix = jsonv.read_str(fv)?
      "MaxConcurrency" => out.max_concurrency = jsonv.read_str(fv)?
      "MaxErrors" => out.max_errors = jsonv.read_str(fv)?
      "TargetCount" => out.target_count = jsonv.read_int(fv)?
      "CompletedCount" => out.completed_count = jsonv.read_int(fv)?
      "ErrorCount" => out.error_count = jsonv.read_int(fv)?
      "DeliveryTimedOutCount" => out.delivery_timed_out_count = jsonv.read_int(fv)?
      "ServiceRole" => out.service_role = jsonv.read_str(fv)?
      "NotificationConfig" => out.notification_config = from_json_notification_config(fv)?
      "CloudWatchOutputConfig" => out.cloud_watch_output_config = from_json_cloud_watch_output_config(fv)?
      "TimeoutSeconds" => out.timeout_seconds = jsonv.read_int(fv)?
      "AlarmConfiguration" => out.alarm_configuration = from_json_alarm_configuration(fv)?
      "TriggeredAlarms" => out.triggered_alarms = from_json_alarm_state_information_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

