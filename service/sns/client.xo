fn xml_write_map_string_to_string(var w: xmlv.Writer, v: Map[Str, Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", item, [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_map_string_to_string(e: xml.Element) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, vc.text())
    }
  }
  Ok(out)
}

fn xml_write_message_attribute_map(var w: xmlv.Writer, v: Map[Str, MessageAttributeValue], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "Name", k, [])
    xml_write_message_attribute_value(w, item, "Value", [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_message_attribute_map(e: xml.Element) -> Map[Str, MessageAttributeValue] ! Str {
  var out: Map[Str, MessageAttributeValue] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "Name") ?? ""
    if let Some(vc) = entry.child("Value") {
      out.put(k, xml_read_message_attribute_value(vc)?)
    }
  }
  Ok(out)
}

fn xml_write_message_attribute_value(var w: xmlv.Writer, v: MessageAttributeValue, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.data_type {
    xmlv.elem(w, "DataType", x, [])
  }
  if let Some(x) = v.string_value {
    xmlv.elem(w, "StringValue", x, [])
  }
  if let Some(x) = v.binary_value {
    xmlv.elem(w, "BinaryValue", x.to_base64(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_message_attribute_value(e: xml.Element) -> MessageAttributeValue ! Str {
  var out = MessageAttributeValue{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DataType" => out.data_type = c.text()
      "StringValue" => out.string_value = c.text()
      "BinaryValue" => out.binary_value = xmlv.read_blob(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

