test "owner's examples (decision 0002)" {
  expect(snake("SSEKMSKeyId")) == "sse_kms_key_id"
  expect(snake("IAMRoleARN")) == "iam_role_arn"
  expect(snake("DBInstanceIdentifier")) == "db_instance_identifier"
  expect(snake("BucketName")) == "bucket_name"
}

test "acronym runs" {
  expect(snake("CidrIp")) == "cidr_ip"
  expect(snake("CIDRIP")) == "cidr_ip"
  expect(snake("JDBCURL")) == "jdbc_url"
  expect(snake("AWSKMSKeyARN")) == "aws_kms_key_arn"
  expect(snake("SMBACLEnabled")) == "smb_acl_enabled"
  expect(snake("ContentMD5")) == "content_md5"
  expect(snake("HTTPSPort")) == "https_port"
}

test "plurals, versions and digits" {
  expect(snake("ResourceARNs")) == "resource_arns"
  expect(snake("InstanceIDs")) == "instance_ids"
  expect(snake("SizeInGBs")) == "size_in_gbs"
  expect(snake("IPv6Address")) == "ipv6_address"
  expect(snake("Ipv6Address")) == "ipv6_address"
  expect(snake("S3Key")) == "s3_key"
  expect(snake("Ec2InstanceId")) == "ec2_instance_id"
  expect(snake("DBv3Enabled")) == "dbv3_enabled"
}

test "lower camel, single letters and separators" {
  expect(snake("bucketName")) == "bucket_name"
  expect(snake("x")) == "x"
  expect(snake("A")) == "a"
  expect(snake("NextToken")) == "next_token"
  expect(snake("max_results")) == "max_results"
}

test "unsplittable runs are reported" {
  let s = split_words("XXHASH64Checksum")
  expect(s.unsplit) == []
  let t = split_words("PZSOGValue")
  expect(t.unsplit) == ["PZSOG"]
}

test "exceptions win" {
  expect(snake("SSEKMSKeyId", {"SSEKMSKeyId": "kms_key"})) == "kms_key"
}

test "upper camel" {
  expect(upper_camel("SSEKMSKeyId")) == "SseKmsKeyId"
  expect(upper_camel("STANDARD_IA")) == "StandardIa"
  expect(upper_camel("bucket_name")) == "BucketName"
}
