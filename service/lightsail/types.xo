/// caches it, and serves it to viewers via a worldwide network of edge
/// servers.
pub struct Origin {
  /// The name of the origin resource.
  pub name: Str? = None
  /// The resource type of the origin resource ( Instance ).
  pub resource_type: ResourceType? = None
  /// The AWS Region name of the origin resource.
  pub region_name: RegionName? = None
  /// The protocol that your Amazon Lightsail distribution uses when
  /// establishing a connection with your origin to pull content.
  pub protocol_policy: OriginProtocolPolicyEnum? = None
  /// The amount of time, in seconds, that the distribution waits for a
  /// response after forwarding a request to the origin. The minimum timeout
  /// is 1 second, the maximum is 60 seconds, and the default (if you don't
  /// specify otherwise) is 30 seconds.
  pub response_timeout: Int? = None
  /// The IP address type that the distribution uses when connecting to the
  /// origin. The possible values are ipv4 for IPv4 only, ipv6 for IPv6 only,
  /// and dualstack for IPv4 and IPv6.
  pub ip_address_type: OriginIpAddressTypeEnum? = None
  /// Specifies whether private origin access is enabled for the
  /// distribution's origin. With private origin access, the distribution can
  /// serve objects that aren't publicly accessible from a Lightsail bucket.
  /// This applies when you set the bucket's getObject access rule to private
  /// . It also applies when you set getObject to public but set individual
  /// objects to private.
  pub is_private_origin_access_enabled: Bool? = None
}

