  pub source_pipeline_name: Str? = None
  /// The Amazon Resource Name (ARN) of the image pipeline that created this
  /// image. This field is only present for images that a pipeline execution
  /// created.
  pub source_pipeline_arn: Str? = None
  /// The infrastructure that Image Builder used to create this image.
  pub infrastructure_configuration: InfrastructureConfiguration? = None
  /// The distribution configuration that Image Builder used to create this
  /// image.
  pub distribution_configuration: DistributionConfiguration? = None
  /// The image test settings that Image Builder used when it created this
  /// image.
  pub image_tests_configuration: ImageTestsConfiguration? = None
  /// The date on which Image Builder created this image.
  pub date_created: Str? = None
  /// The output resources that Image Builder produces for this image.
  pub output_resources: OutputResources? = None
  /// The tags that apply to this image.
  pub tags: Map[Str, Str]? = None
  /// Indicates the type of build that created this image. The build can be
  /// initiated in the following ways: USER_INITIATED – A manual pipeline
  /// build request. SCHEDULED – A pipeline build initiated by a cron
  /// expression in the Image Builder pipeline, or from EventBridge. IMPORT
