  /// The ID of the Amazon Web Services account that owns the LAG.
  pub owner_account: Str? = None
  /// The name of the LAG.
  pub lag_name: Str? = None
  /// The state of the LAG. The following are the possible values: requested :
  /// The initial state of a LAG. The LAG stays in the requested state until
  /// the Letter of Authorization (LOA) is available. pending : The LAG has
  /// been approved and is being initialized. available : The network link is
  /// established and the LAG is ready for use. down : The network link is
  /// down. deleting : The LAG is being deleted. deleted : The LAG is deleted.
  /// unknown : The state of the LAG is not available.
  pub lag_state: LagState? = None
  /// The location of the LAG.
  pub location: Str? = None
  /// The Amazon Web Services Region where the connection is located.
  pub region: Str? = None
  /// The minimum number of physical dedicated connections that must be
  /// operational for the LAG itself to be operational.
  pub minimum_links: Int? = None
  /// The Direct Connect endpoint that hosts the LAG.
  pub aws_device: Str? = None
  /// The Direct Connect endpoint that hosts the LAG.
  pub aws_device_v2: Str? = None
  /// The Direct Connect endpoint that terminates the logical connection. This
  /// device might be different than the device that terminates the physical
  /// connection.
  pub aws_logical_device_id: Str? = None
  /// The connections bundled by the LAG.
  pub connections: List[Connection]? = None
  /// Indicates whether the LAG can host other connections.
  pub allows_hosted_connections: Bool? = None
  /// Indicates whether jumbo frames are supported.
  pub jumbo_frame_capable: Bool? = None
  /// Indicates whether the LAG supports a secondary BGP peer in the same
  /// address family (IPv4/IPv6).
  pub has_logical_redundancy: HasLogicalRedundancy? = None
  /// The tags associated with the LAG.
  pub tags: List[Tag]? = None
  /// The name of the service provider associated with the LAG.
  pub provider_name: Str? = None
  /// Indicates whether the LAG supports MAC Security (MACsec).
  pub mac_sec_capable: Bool? = None
  /// The LAG MAC Security (MACsec) encryption mode. The valid values are
  /// no_encrypt , should_encrypt , and must_encrypt .
  pub encryption_mode: Str? = None
  /// The MAC Security (MACsec) security keys associated with the LAG.
  pub mac_sec_keys: List[MacSecKey]? = None
  /// The total number of inbound IPv4 route prefixes you can allocate across
  /// the virtual interfaces on the LAG. Not applicable to LAGs that are
  /// interconnects and support hosted connections.
