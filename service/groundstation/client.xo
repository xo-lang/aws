fn json_of_ephemeris_status_list(v: List[EphemerisStatus]) -> json.Value {
  json.Value.List(v.map(fn(x: EphemerisStatus) -> json.Value { json.Value.Str(x.value()) }))
}

fn from_json_ephemeris_status_list(v: json.Value) -> List[EphemerisStatus] ! Str {
  var out: List[EphemerisStatus] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(EphemerisStatus.from(jsonv.read_str(fv)?))
  }
  Ok(out)
}

fn json_of_ephemeris_type_description(v: EphemerisTypeDescription) -> json.Value {
  match v {
    Tle(x) => json.Value.Object([("tle", json_of_ephemeris_description(x))])
    Oem(x) => json.Value.Object([("oem", json_of_ephemeris_description(x))])
    AzEl(x) => json.Value.Object([("azEl", json_of_ephemeris_description(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_ephemeris_type_description(v: json.Value) -> EphemerisTypeDescription ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "tle" => Ok(EphemerisTypeDescription.Tle(from_json_ephemeris_description(fv)?))
      "oem" => Ok(EphemerisTypeDescription.Oem(from_json_ephemeris_description(fv)?))
      "azEl" => Ok(EphemerisTypeDescription.AzEl(from_json_ephemeris_description(fv)?))
      _ => Ok(EphemerisTypeDescription.Unknown(k))
    }
  }
  Err("EphemerisTypeDescription: no member set")
}

