      Ok(x) => return RejectTimeOffErr.ThrottlingException(x)
      Err(msg) => return RejectTimeOffErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return RejectTimeOffErr.ValidationException(x)
      Err(msg) => return RejectTimeOffErr.Deserialize(msg)
    }
    _ => {}
  }
  RejectTimeOffErr.Api(restjson.api_error(resp, body))
}

/// Rejects a time off request. Rejecting a REJECTED request succeeds
/// without a change. Returns ConflictException if the request is PENDING or
/// CANCELLED . PENDING means Connect Customer is still processing the
/// request asynchronously. Wait until GetTimeOff returns a status other
/// than PENDING , and then retry.
pub fn (c: Client) reject_time_off(input: RejectTimeOffRequest) -> RejectTimeOffResponse ! RejectTimeOffErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_reject_time_off(c.params, input)) ?? e => return Err(RejectTimeOffErr.InvalidInput(e))
  var req = serialize_reject_time_off(ep, input, "") ?? e => return Err(RejectTimeOffErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(RejectTimeOffErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_reject_time_off_error(resp))
  }
  deserialize_reject_time_off(resp) ?? e => Err(RejectTimeOffErr.Deserialize(e))
}
