  pub error: ErrorDetail? = None
}

/// A structure containing the column name and column importance score for a
/// column. Column importance helps you understand how columns contribute to
/// your model, by identifying which columns in your records are more
/// important than others.
pub struct ColumnImportance {
  /// The name of a column.
  pub column_name: Str? = None
  /// The column importance score for the column, as a decimal.
  pub importance: Float? = None
}

/// A filter that uses both column-level and row-level filtering.
pub struct ColumnRowFilter {
  /// A string containing the name of the column.
  pub column_name: Str? = None
  /// A string containing the row-level filter expression.
  pub row_filter_expression: Str? = None
}

/// Represents the generated column-level statistics for a table or
/// partition.
pub struct ColumnStatistics {
  /// Name of column which statistics belong to.
  pub column_name: Str? = None
  /// The data type of the column.
  pub column_type: Str? = None
  /// The timestamp of when column statistics were generated.
  pub analyzed_time: Time? = None
  /// A ColumnStatisticData object that contains the statistics data values.
  pub statistics_data: ColumnStatisticsData? = None
}

/// Contains the individual types of column statistics data. Only one data
/// object should be set and indicated by the Type attribute.
pub struct ColumnStatisticsData {
  /// The type of column statistics data.
  pub type_value: ColumnStatisticsType? = None
  /// Boolean column statistics data.
  pub boolean_column_statistics_data: BooleanColumnStatisticsData? = None
  /// Date column statistics data.
  pub date_column_statistics_data: DateColumnStatisticsData? = None
  /// Decimal column statistics data. UnscaledValues within are Base64-encoded
  /// binary objects storing big-endian, two's complement representations of
  /// the decimal's unscaled value.
  pub decimal_column_statistics_data: DecimalColumnStatisticsData? = None
  /// Double column statistics data.
  pub double_column_statistics_data: DoubleColumnStatisticsData? = None
  /// Long column statistics data.
  pub long_column_statistics_data: LongColumnStatisticsData? = None
  /// String column statistics data.
  pub string_column_statistics_data: StringColumnStatisticsData? = None
  /// Binary column statistics data.
  pub binary_column_statistics_data: BinaryColumnStatisticsData? = None
}

/// Encapsulates a ColumnStatistics object that failed and the reason for
/// failure.
pub struct ColumnStatisticsError {
  /// The ColumnStatistics of the column.
  pub column_statistics: ColumnStatistics? = None
  /// An error message with the reason for the failure of an operation.
  pub error: ErrorDetail? = None
}

pub enum ColumnStatisticsState: Str {
  Starting = "STARTING"
  Running = "RUNNING"
  Succeeded = "SUCCEEDED"
  Failed = "FAILED"
  Stopped = "STOPPED"
  Unknown(value: Str)
}

/// An exception thrown when you try to stop a task run when there is no
/// task running.
pub struct ColumnStatisticsTaskNotRunningException {
  /// A message describing the problem.
  pub message: Str? = None
}

/// The object that shows the details of the column stats run.
pub struct ColumnStatisticsTaskRun {
  /// The Amazon Web Services account ID.
  pub customer_id: Str? = None
  /// The identifier for the particular column statistics task run.
  pub column_statistics_task_run_id: Str? = None
  /// The database where the table resides.
  pub database_name: Str? = None
  /// The name of the table for which column statistics is generated.
  pub table_name: Str? = None
  /// A list of the column names. If none is supplied, all column names for
  /// the table will be used by default.
  pub column_name_list: List[Str]? = None
  /// The ID of the Data Catalog where the table resides. If none is supplied,
  /// the Amazon Web Services account ID is used by default.
  pub catalog_id: Str? = None
  /// The IAM role that the service assumes to generate statistics.
  pub role: Str? = None
  /// The percentage of rows used to generate statistics. If none is supplied,
  /// the entire table will be used to generate stats.
  pub sample_size: Float? = None
  /// Name of the security configuration that is used to encrypt CloudWatch
  /// logs for the column stats task run.
  pub security_configuration: Str? = None
  /// The number of workers used to generate column statistics. The job is
  /// preconfigured to autoscale up to 25 instances.
  pub number_of_workers: Int? = None
  /// The type of workers being used for generating stats. The default is g.1x
  /// .
  pub worker_type: Str? = None
  /// The type of column statistics computation.
  pub computation_type: ComputationType? = None
  /// The status of the task run.
  pub status: ColumnStatisticsState? = None
  /// The time that this task was created.
  pub creation_time: Time? = None
  /// The last point in time when this task was modified.
  pub last_updated: Time? = None
  /// The start time of the task.
  pub start_time: Time? = None
  /// The end time of the task.
  pub end_time: Time? = None
  /// The error message for the job.
  pub error_message: Str? = None
  /// The calculated DPU usage in seconds for all autoscaled workers.
  pub dpu_seconds: Float? = None
}

/// An exception thrown when you try to start another job while running a
/// column stats generation job.
pub struct ColumnStatisticsTaskRunningException {
  /// A message describing the problem.
  pub message: Str? = None
}

/// The settings for a column statistics task.
pub struct ColumnStatisticsTaskSettings {
  /// The name of the database where the table resides.
  pub database_name: Str? = None
  /// The name of the table for which to generate column statistics.
  pub table_name: Str? = None
  /// A schedule for running the column statistics, specified in CRON syntax.
  pub schedule: Schedule? = None
  /// A list of column names for which to run statistics.
  pub column_name_list: List[Str]? = None
  /// The ID of the Data Catalog in which the database resides.
  pub catalog_id: Str? = None
  /// The role used for running the column statistics.
  pub role: Str? = None
  /// The percentage of data to sample.
  pub sample_size: Float? = None
  /// Name of the security configuration that is used to encrypt CloudWatch
  /// logs.
  pub security_configuration: Str? = None
  /// The type of schedule for a column statistics task. Possible values may
  /// be CRON or AUTO .
  pub schedule_type: ScheduleType? = None
  /// The source of setting the column statistics task. Possible values may be
  /// CATALOG or TABLE .
  pub setting_source: SettingSource? = None
  /// The last ExecutionAttempt for the column statistics task run.
  pub last_execution_attempt: ExecutionAttempt? = None
}

/// An exception thrown when you try to stop a task run.
pub struct ColumnStatisticsTaskStoppingException {
  /// A message describing the problem.
  pub message: Str? = None
}

pub enum ColumnStatisticsType: Str {
