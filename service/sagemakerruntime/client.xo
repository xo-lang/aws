  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: InvokeEndpointWithResponseStreamErr) display() -> Str {
  match e {
    InternalFailure(x) => "InternalFailure: ${x:?}"
    InternalStreamFailure(x) => "InternalStreamFailure: ${x:?}"
    ModelError(x) => "ModelError: ${x:?}"
    ModelStreamError(x) => "ModelStreamError: ${x:?}"
    ServiceUnavailable(x) => "ServiceUnavailable: ${x:?}"
    ValidationError(x) => "ValidationError: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_invoke_endpoint_with_response_stream_error(resp: http.Response) -> InvokeEndpointWithResponseStreamErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "InternalFailure" => match read_error_internal_failure(resp, body) {
      Ok(x) => return InvokeEndpointWithResponseStreamErr.InternalFailure(x)
      Err(msg) => return InvokeEndpointWithResponseStreamErr.Deserialize(msg)
    }
    "InternalStreamFailure" => match read_error_internal_stream_failure(resp, body) {
      Ok(x) => return InvokeEndpointWithResponseStreamErr.InternalStreamFailure(x)
      Err(msg) => return InvokeEndpointWithResponseStreamErr.Deserialize(msg)
    }
    "ModelError" => match read_error_model_error(resp, body) {
      Ok(x) => return InvokeEndpointWithResponseStreamErr.ModelError(x)
      Err(msg) => return InvokeEndpointWithResponseStreamErr.Deserialize(msg)
    }
    "ModelStreamError" => match read_error_model_stream_error(resp, body) {
      Ok(x) => return InvokeEndpointWithResponseStreamErr.ModelStreamError(x)
      Err(msg) => return InvokeEndpointWithResponseStreamErr.Deserialize(msg)
    }
    "ServiceUnavailable" => match read_error_service_unavailable(resp, body) {
      Ok(x) => return InvokeEndpointWithResponseStreamErr.ServiceUnavailable(x)
      Err(msg) => return InvokeEndpointWithResponseStreamErr.Deserialize(msg)
    }
    "ValidationError" => match read_error_validation_error(resp, body) {
      Ok(x) => return InvokeEndpointWithResponseStreamErr.ValidationError(x)
      Err(msg) => return InvokeEndpointWithResponseStreamErr.Deserialize(msg)
    }
    _ => {}
  }
  InvokeEndpointWithResponseStreamErr.Api(restjson.api_error(resp, body))
}

/// Invokes a model at the specified endpoint to return the inference
/// response as a stream. The inference stream provides the response payload
/// incrementally as a series of parts. Before you can get an inference
/// stream, you must have access to a model that's deployed using Amazon
/// SageMaker AI hosting services, and the container for that model must
/// support inference streaming. For more information that can help you use
/// this API, see the following sections in the Amazon SageMaker AI
/// Developer Guide : For information about how to add streaming support to
/// a model, see How Containers Serve Requests . For information about how
/// to process the streaming response, see Invoke real-time endpoints .
/// Before you can use this operation, your IAM permissions must allow the
/// sagemaker:InvokeEndpoint action. For more information about Amazon
/// SageMaker AI actions for IAM policies, see Actions, resources, and
/// condition keys for Amazon SageMaker AI in the IAM Service Authorization
/// Reference . Amazon SageMaker AI strips all POST headers except those
/// supported by the API. Amazon SageMaker AI might add additional headers.
/// You should not rely on the behavior of headers outside those enumerated
