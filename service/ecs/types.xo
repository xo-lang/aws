/// filters that the gateway applies. A service can have at most one gateway
/// connector.
pub struct GatewayConnector {
  /// The name of the service port that the gateway routes ingress traffic to.
  pub port_name: Str? = None
  /// The health check that the gateway uses to determine whether the targets
  /// for this connector are healthy.
  pub health_check: GatewayConnectorHealthCheck? = None
  /// The filters that control which gateway ingress paths the connector
  /// applies to.
  pub filters: GatewayConnectorFilters? = None
}

/// The filters that determine which gateway ingress paths a connector
/// applies to.
pub struct GatewayConnectorFilters {
  /// The access types of the gateway ingress paths that the connector applies
  /// to. The access type can be one of the following values: PUBLIC - The
  /// ingress path is publicly accessible. PRIVATE - The ingress path is only
  /// accessible privately.
  pub access_types: List[AccessType]? = None
}

/// The health check configuration that a gateway uses to evaluate the
/// targets associated with a gateway connector.
pub struct GatewayConnectorHealthCheck {
  /// The protocol that the gateway uses to perform health checks. Valid
  /// values: HTTP - Health checks are performed over HTTP. HTTPS - Health
  /// checks are performed over HTTPS.
  pub health_check_protocol: GatewayConnectorHealthCheckProtocol? = None
  /// The port that the gateway uses to perform health checks on the targets.
  pub health_check_port: Int? = None
  /// The destination path for health check requests.
  pub health_check_path: Str? = None
  /// The amount of time, in seconds, during which no response from a target
  /// means a failed health check.
  pub health_check_timeout_seconds: Int? = None
  /// The approximate amount of time, in seconds, between health checks of an
  /// individual target.
  pub health_check_interval_seconds: Int? = None
  /// The number of consecutive successful health checks that a target must
  /// pass before the gateway considers it healthy.
  pub healthy_threshold_count: Int? = None
  /// The number of consecutive failed health checks that a target must fail
  /// before the gateway considers it unhealthy.
  pub unhealthy_threshold_count: Int? = None
  /// The HTTP or gRPC codes that indicate a successful health check response
  /// from a target.
  pub matcher: GatewayConnectorHealthCheckMatcher? = None
}

/// The codes that indicate a successful health check response from a
/// target.
pub struct GatewayConnectorHealthCheckMatcher {
  /// The HTTP codes that indicate a successful response from a target.
  pub http_code: Str? = None
  /// The gRPC codes that indicate a successful response from a target.
  pub grpc_code: Str? = None
}

/// The protocol that a gateway uses to perform health checks on connector
/// targets.
pub enum GatewayConnectorHealthCheckProtocol: Str {
  Http = "HTTP"
  Https = "HTTPS"
  Unknown(value: Str)
}

