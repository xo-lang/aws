}

pub enum MigrationSortAttribute: Str {
  V1BotName = "V1_BOT_NAME"
  MigrationDateTime = "MIGRATION_DATE_TIME"
  Unknown(value: Str)
}

pub enum MigrationStatus: Str {
  InProgress = "IN_PROGRESS"
  Completed = "COMPLETED"
  Failed = "FAILED"
  Unknown(value: Str)
}

pub enum MigrationStrategy: Str {
  CreateNew = "CREATE_NEW"
  UpdateExisting = "UPDATE_EXISTING"
  Unknown(value: Str)
}

