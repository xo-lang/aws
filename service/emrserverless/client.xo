fn json_of_job_driver(v: JobDriver) -> json.Value {
  match v {
    SparkSubmit(x) => json.Value.Object([("sparkSubmit", json_of_spark_submit(x))])
    Hive(x) => json.Value.Object([("hive", json_of_hive(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_job_driver(v: json.Value) -> JobDriver ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "sparkSubmit" => Ok(JobDriver.SparkSubmit(from_json_spark_submit(fv)?))
      "hive" => Ok(JobDriver.Hive(from_json_hive(fv)?))
      _ => Ok(JobDriver.Unknown(k))
    }
  }
  Err("JobDriver: no member set")
}

