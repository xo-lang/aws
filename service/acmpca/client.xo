fn json_of_permission(v: Permission) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.certificate_authority_arn {
    fs.push(("CertificateAuthorityArn", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.principal {
    fs.push(("Principal", json.Value.Str(x)))
  }
  if let Some(x) = v.source_account {
    fs.push(("SourceAccount", json.Value.Str(x)))
  }
  if let Some(x) = v.actions {
    fs.push(("Actions", json_of_action_list(x)))
  }
  if let Some(x) = v.policy {
    fs.push(("Policy", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_permission(v: json.Value) -> Permission ! Str {
  var out = Permission{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "CertificateAuthorityArn" => out.certificate_authority_arn = jsonv.read_str(fv)?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "Principal" => out.principal = jsonv.read_str(fv)?
