/// Calls GetCertificateAssociation until the CertificateAssociated acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (15s) to `max_delay` (120s).
pub fn wait_until_certificate_associated(c: Client, input: GetCertificateAssociationRequest, max_wait: Duration, min_delay: Duration = 15s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetCertificateAssociationErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_certificate_association(input) {
      Ok(out) => {
        let o = jmes_of_get_certificate_association_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "ASSOCIATED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "DISASSOCIATED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "PENDING_DISASSOCIATION") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_get_certificate_association(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "failure"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("CertificateAssociated: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

