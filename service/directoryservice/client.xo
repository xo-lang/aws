    match k {
      "DirectoryId" => out.directory_id = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "ShortName" => out.short_name = jsonv.read_str(fv)?
      "Size" => out.size = DirectorySize.from(jsonv.read_str(fv)?)
      "Edition" => out.edition = DirectoryEdition.from(jsonv.read_str(fv)?)
      "Alias" => out.alias = jsonv.read_str(fv)?
      "AccessUrl" => out.access_url = jsonv.read_str(fv)?
      "Description" => out.description = jsonv.read_str(fv)?
      "DnsIpAddrs" => out.dns_ip_addrs = from_json_dns_ip_addrs(fv)?
      "DnsIpv6Addrs" => out.dns_ipv6_addrs = from_json_dns_ipv6_addrs(fv)?
      "Stage" => out.stage = DirectoryStage.from(jsonv.read_str(fv)?)
      "ShareStatus" => out.share_status = ShareStatus.from(jsonv.read_str(fv)?)
      "ShareMethod" => out.share_method = ShareMethod.from(jsonv.read_str(fv)?)
      "ShareNotes" => out.share_notes = jsonv.read_str(fv)?
      "LaunchTime" => out.launch_time = jsonv.read_time(fv, "epoch-seconds")?
      "StageLastUpdatedDateTime" => out.stage_last_updated_date_time = jsonv.read_time(fv, "epoch-seconds")?
      "Type" => out.type_value = DirectoryType.from(jsonv.read_str(fv)?)
      "VpcSettings" => out.vpc_settings = from_json_directory_vpc_settings_description(fv)?
      "ConnectSettings" => out.connect_settings = from_json_directory_connect_settings_description(fv)?
      "RadiusSettings" => out.radius_settings = from_json_radius_settings(fv)?
      "RadiusStatus" => out.radius_status = RadiusStatus.from(jsonv.read_str(fv)?)
      "StageReason" => out.stage_reason = jsonv.read_str(fv)?
      "SsoEnabled" => out.sso_enabled = jsonv.read_bool(fv)?
      "DesiredNumberOfDomainControllers" => out.desired_number_of_domain_controllers = jsonv.read_int(fv)?
      "OwnerDirectoryDescription" => out.owner_directory_description = from_json_owner_directory_description(fv)?
      "RegionsInfo" => out.regions_info = from_json_regions_info(fv)?
      "OsVersion" => out.os_version = OSVersion.from(jsonv.read_str(fv)?)
      "HybridSettings" => out.hybrid_settings = from_json_hybrid_settings_description(fv)?
      "NetworkType" => out.network_type = NetworkType.from(jsonv.read_str(fv)?)
      _ => {}
    }
