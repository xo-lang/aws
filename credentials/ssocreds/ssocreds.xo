// IAM Identity Center (SSO) credentials (decision 0003), as
// aws-sdk-go-v2's credentials/ssocreds: the access token from the SSO
// token cache that `aws sso login` writes (~/.aws/sso/cache/<sha1>.json),
// then the portal's GetRoleCredentials for the profile's account and
// role.
//
// For an `sso_session` profile an expired token is refreshed through SSO
// OIDC's CreateToken with the cached client and refresh token. The new
// token is kept in memory (`aws.TokenFile.set`) and written back to the
// cache file by `cfg.watch_token_files` when it runs; aws-sdk-go-v2
// writes it at once, but `retrieve` has no file effect. A legacy profile
// (sso_start_url and sso_region on the profile) cannot refresh: run
// `aws sso login` again.
//
// The two calls are small and hand written (decision 0003): the
// generated service/sso and service/ssooidc would add module cycles.

use std/crypto
use std/http
use std/json
use std/url
use github.com/xo-lang/aws
use github.com/xo-lang/aws/protocol/jsonv

/// The token cache file for `key` (the sso_session name, or a legacy
/// profile's start URL) under `home`.
pub fn cache_path(home: Str, key: Str) -> Str {
  let h = crypto.digest(crypto.Hash.Sha1, key.bytes()).to_hex().to_lower()
  "${home.trim_end_chars("/")}/.aws/sso/cache/${h}.json"
}

/// The DNS suffix of the SSO endpoints in `region`.
fn dns_suffix(region: Str) -> Str {
  if region.starts_with("cn-") { "amazonaws.com.cn" } else { "amazonaws.com" }
}

pub struct Options {
  /// The SSO region (the session's `sso_region`).
  pub region: Str
  pub account_id: Str
  pub role_name: Str
  /// The token cache file's contents.
  pub token: aws.TokenFile
  /// Whether an expired token may be refreshed (sso_session profiles).
  pub refresh: Bool = false
  /// The portal endpoint ("" for portal.sso.<region>.amazonaws.com).
  pub portal_endpoint: Str = ""
  /// The SSO OIDC endpoint ("" for oidc.<region>.amazonaws.com).
  pub oidc_endpoint: Str = ""
  pub timeout: Duration = 10s
}

/// The provider: wrap it in `credentials.cache`.
pub struct SsoRoleProvider {
  http: http.Client
  clock: Clock
  opts: Options
}

pub fn provider(net: Net, clock: Clock, opts: Options) -> SsoRoleProvider {
  SsoRoleProvider{http: http.client(net, opts.timeout), clock: clock, opts: opts}
}

fn str_field(doc: json.Value, k: Str) -> Str {
  match doc.get(k) {
    Some(json.Value.Str(s)) => s
    _ => ""
  }
}

fn int_field(doc: json.Value, k: Str) -> Int? {
  match doc.get(k) {
    Some(json.Value.Int(n)) => Some(n)
    Some(json.Value.Num(f)) => Some(Int(f))
    _ => None
  }
}

/// `doc` with the fields of `changes` replaced or added.
fn with_fields(doc: json.Value, changes: List[(Str, json.Value)]) -> json.Value {
  let fields = match doc {
    json.Value.Object(fs) => fs
    _ => []
  }
  var out: List[(Str, json.Value)] = []
  for (k, v) in fields {
    if !changes.any(fn(c: (Str, json.Value)) -> Bool { c.0 == k }) {
      out.push((k, v))
    }
  }
  for c in changes {
    out.push(c)
  }
  json.Value.Object(out)
}

/// Why a call failed, with a hint to log in again when the token is the
/// cause.
fn api_error(what: Str, resp: http.Response) -> Str {
  let doc = jsonv.parse_body(resp.body).ok()
  let msg = doc.map(fn(d: json.Value) -> Str { str_field(d, "message") + str_field(d, "Message") + str_field(d, "error_description") }) ?? ""
  let code = resp.header("x-amzn-ErrorType") ?? doc.map(fn(d: json.Value) -> Str { str_field(d, "__type") + str_field(d, "error") }) ?? ""
  let hint = if resp.status == 401 || resp.status == 403 || code.contains("Unauthorized") || code.contains("invalid_grant") || code.contains("Expired") { "; run aws sso login" } else { "" }
  "${what}: HTTP ${resp.status} ${code.split(":").first() ?? ""} ${msg}".trim() + hint
}

pub fn (p: SsoRoleProvider) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  let fail = fn(msg: Str) -> aws.CredentialsErr { aws.CredentialsErr.Fetch("SSO ${p.opts.account_id}/${p.opts.role_name}: ${msg}") }
  let access = p.access_token() ?? e => return Err(fail(e))
  let portal = if p.opts.portal_endpoint != "" { p.opts.portal_endpoint.trim_end_chars("/") } else { "https://portal.sso.${p.opts.region}.${dns_suffix(p.opts.region)}" }
  let q = "account_id=${url.query_escape(p.opts.account_id)}&role_name=${url.query_escape(p.opts.role_name)}"
  let req = http.new_request("GET", "${portal}/federation/credentials?${q}").with_header("x-amz-sso_bearer_token", access).with_header("Accept", "application/json")
  let resp = p.http.send(req) ?? e => return Err(fail("GetRoleCredentials: ${e.display()}"))
  if resp.status != 200 {
    return Err(fail(api_error("GetRoleCredentials", resp)))
  }
  let doc = jsonv.parse_body(resp.body) ?? e => return Err(fail("GetRoleCredentials: ${e}"))
  let rc = doc.get("roleCredentials") ?? return Err(fail("GetRoleCredentials: no roleCredentials"))
  let id = str_field(rc, "accessKeyId")
  if id == "" {
    return Err(fail("GetRoleCredentials: no accessKeyId"))
  }
  let expires = int_field(rc, "expiration").map(fn(ms: Int) -> Time { Time.from_unix_millis(ms) })
  Ok(aws.Credentials{
    access_key_id: id,
    secret_access_key: Secret.new(str_field(rc, "secretAccessKey")),
    session_token: if str_field(rc, "sessionToken") == "" { None } else { Some(Secret.new(str_field(rc, "sessionToken"))) },
    expires: expires,
    source: "SSOProvider",
    account_id: Some(p.opts.account_id),
  })
}

/// The cached access token, refreshed first when it has expired and the
/// profile allows it.
fn (p: SsoRoleProvider) access_token() -> Str ! Str uses (net.dial, clock) {
  let doc = jsonv.parse_body(p.opts.token.get().reveal().bytes()) ?? e => return Err("the SSO token cache ${p.opts.token.path} is not JSON: ${e}")
  let token = str_field(doc, "accessToken")
  let expires = Time.parse_rfc3339(str_field(doc, "expiresAt"))
  let now = p.clock.now()
  let expired = match expires {
    Some(t) => now.unix_millis() >= t.unix_millis()
    None => true
  }
  if token != "" && !expired {
    return Ok(token)
  }
  if !p.opts.refresh {
    return Err("the SSO token has expired; run aws sso login")
  }
  let client_id = str_field(doc, "clientId")
  let secret = str_field(doc, "clientSecret")
  let refresh = str_field(doc, "refreshToken")
  if client_id == "" || secret == "" || refresh == "" {
    return Err("the SSO token has expired and the cache cannot refresh it; run aws sso login")
  }
  let oidc = if p.opts.oidc_endpoint != "" { p.opts.oidc_endpoint.trim_end_chars("/") } else { "https://oidc.${p.opts.region}.${dns_suffix(p.opts.region)}" }
  let body = json.Value.Object([
    ("clientId", json.Value.Str(client_id)),
    ("clientSecret", json.Value.Str(secret)),
    ("grantType", json.Value.Str("refresh_token")),
    ("refreshToken", json.Value.Str(refresh)),
  ]).encode()
  let req = http.new_request("POST", "${oidc}/token", {"Content-Type": "application/json"}, body.bytes())
  let resp = p.http.send(req) ?? e => return Err("refreshing the SSO token: ${e.display()}")
  if resp.status != 200 {
    return Err(api_error("refreshing the SSO token (CreateToken)", resp))
  }
  let out = jsonv.parse_body(resp.body) ?? e => return Err("refreshing the SSO token: ${e}")
  let fresh = str_field(out, "accessToken")
  if fresh == "" {
    return Err("refreshing the SSO token: no accessToken")
  }
  let secs = int_field(out, "expiresIn") ?? 3600
  let until = Time.from_unix_millis(now.unix_millis() + secs * 1000)
  var changes: List[(Str, json.Value)] = [
    ("accessToken", json.Value.Str(fresh)),
    ("expiresAt", json.Value.Str(until.format_rfc3339())),
  ]
  if str_field(out, "refreshToken") != "" {
    changes.push(("refreshToken", json.Value.Str(str_field(out, "refreshToken"))))
  }
  p.opts.token.set(with_fields(doc, changes).encode())
  Ok(fresh)
}
