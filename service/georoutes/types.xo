  /// GrabMaps customers.
  pub side_of_street: RouteSideOfStreetOptions? = None
  /// Duration of the stop. Not supported in ap-southeast-1 and ap-southeast-5
  /// regions for GrabMaps customers. Unit : seconds
  pub stop_duration: Int? = None
}

