fn json_of_operation_union(v: OperationUnion) -> json.Value {
  match v {
    Merge(x) => json.Value.Object([("merge", json_of_merge_operation(x))])
    Split(x) => json.Value.Object([("split", json_of_split_operation(x))])
    Delete(x) => json.Value.Object([("delete", json_of_delete_operation(x))])
    Update(x) => json.Value.Object([("update", json_of_update_operation(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_operation_union(v: json.Value) -> OperationUnion ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "merge" => Ok(OperationUnion.Merge(from_json_merge_operation(fv)?))
      "split" => Ok(OperationUnion.Split(from_json_split_operation(fv)?))
      "delete" => Ok(OperationUnion.Delete(from_json_delete_operation(fv)?))
      "update" => Ok(OperationUnion.Update(from_json_update_operation(fv)?))
      _ => Ok(OperationUnion.Unknown(k))
    }
  }
  Err("OperationUnion: no member set")
}

