    xmlv.elem(w, "quoteState", x.value(), [])
  }
  if let Some(x) = v.current_configuration {
    xml_write_modification_quote_current_configuration(w, x, "currentConfiguration", [])
  }
  if let Some(x) = v.modification_terms {
    xml_write_modification_terms(w, x, "modificationTerms", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_capacity_reservation_modification_quote(e: xml.Element) -> CapacityReservationModificationQuote ! Str {
  var out = CapacityReservationModificationQuote{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "capacityReservationModificationQuoteId" => out.capacity_reservation_modification_quote_id = c.text()
      "capacityReservationId" => out.capacity_reservation_id = c.text()
      "createTime" => out.create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "expirationTime" => out.expiration_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "quoteState" => out.quote_state = CapacityReservationModificationQuoteState.from(c.text())
      "currentConfiguration" => out.current_configuration = xml_read_modification_quote_current_configuration(c)?
      "modificationTerms" => out.modification_terms = xml_read_modification_terms(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

