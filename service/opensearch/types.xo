/// A custom 10-hour, low-traffic window during which OpenSearch Service can
/// perform mandatory configuration changes on the domain. These actions can
/// include scheduled service software updates and blue/green Auto-Tune
/// enhancements. OpenSearch Service will schedule these actions during the
/// window that you specify. If you don't specify a window start time, it
/// defaults to 10:00 P.M. local time. For more information, see Defining
/// off-peak maintenance windows for Amazon OpenSearch Service .
pub struct OffPeakWindow {
  /// A custom start time for the off-peak window, in Coordinated Universal
  /// Time (UTC). The window length will always be 10 hours, so you can't
  /// specify an end time. For example, if you specify 11:00 P.M. UTC as a
  /// start time, the end time will automatically be set to 9:00 A.M.
  pub window_start_time: WindowStartTime? = None
}

/// Options for a domain's off-peak window , during which OpenSearch Service
/// can perform mandatory configuration changes on the domain.
pub struct OffPeakWindowOptions {
  /// Whether to enable an off-peak window. This option is only available when
  /// modifying a domain created prior to February 16, 2023, not when creating
  /// a new domain. All domains created after this date have the off-peak
  /// window enabled by default. You can't disable the off-peak window after
  /// it's enabled for a domain.
  pub enabled: Bool? = None
  /// Off-peak window settings for the domain.
  pub off_peak_window: OffPeakWindow? = None
}

/// The status of off-peak window options for a domain.
pub struct OffPeakWindowOptionsStatus {
  /// The domain's off-peak window configuration.
  pub options: OffPeakWindowOptions? = None
  /// The current status of off-peak window options.
  pub status: OptionStatus? = None
}

