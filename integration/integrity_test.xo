// Response integrity checks on the test network, on by default as in
// aws-sdk-go-v2: DynamoDB's X-Amz-Crc32 over the body, and SQS's MD5 of
// each message body. A mismatch is a Deserialize error, never data.

use std/crc32
use std/crypto
use std/http
use github.com/xo-lang/aws/credentials
use github.com/xo-lang/aws/service/dynamodb
use github.com/xo-lang/aws/service/sqs

fn test_creds() -> credentials.StaticProvider {
  credentials.static_provider("AKIDTEST0000000000", "invented-secret")
}

test "DynamoDB checks the body's CRC32" {
  let body = "{\"Item\":{\"pk\":{\"S\":\"a\"}}}"
  let good = crc32.checksum(body.bytes())
  let n = Mutex[Int].new(0)
  os.net.handle("POST https://dynamodb.us-west-2.amazonaws.com/", fn(req: http.Request) -> http.Response {
    let i = n.with(fn(var x: Int) -> Int { x += 1; x })
    // the first answer is right, every later one claims another CRC
    http.text(200, body).with_header("Content-Type", "application/x-amz-json-1.0").with_header("X-Amz-Crc32", "${if i == 1 { good } else { good + 1 }}")
  })
  let c = dynamodb.new(os.net, os.clock, os.rand, dynamodb.Options{region: "us-west-2", credentials: test_creds()})?
  let input = dynamodb.GetItemInput{table_name: "t", key: {"pk": dynamodb.AttributeValue.S("a")}}
  c.get_item(input)?
  match c.get_item(input) {
    // Go's words; Go itself does not fail the call (README, deliberate differences)
    Err(dynamodb.GetItemErr.Deserialize(msg)) => expect(msg) == "response did not match expected checksum, ${good + 1}, ${good}"
    _ => return Err("a CRC32 mismatch must fail")
  }
}

test "DynamoDB checks the first X-Amz-Crc32 field, as Go's header.Get" {
  let body = "{\"Item\":{\"pk\":{\"S\":\"a\"}}}"
  let good = crc32.checksum(body.bytes())
  os.net.handle("POST https://dynamodb.us-west-2.amazonaws.com/", fn(req: http.Request) -> http.Response {
    http.text(200, body).with_header("Content-Type", "application/x-amz-json-1.0").add_header("X-Amz-Crc32", "${good}").add_header("X-Amz-Crc32", "${good + 1}")
  })
  let c = dynamodb.new(os.net, os.clock, os.rand, dynamodb.Options{region: "us-west-2", credentials: test_creds()})?
  c.get_item(dynamodb.GetItemInput{table_name: "t", key: {"pk": dynamodb.AttributeValue.S("a")}})?
}

test "an X-Amz-Crc32 that does not parse fails as Go's ParseUint(v, 10, 32)" {
  // a local Go program's output (dynamodb v1.73.1 ListTables, a fake
  // answering each field; the error after "deserialization failed, "):
  //   letters: unable to parse checksum header abc, strconv.ParseUint: parsing "abc": invalid syntax
  //   too big: unable to parse checksum header 4294967296, strconv.ParseUint: parsing "4294967296": value out of range
  //   signed: unable to parse checksum header +1324975443, strconv.ParseUint: parsing "+1324975443": invalid syntax
  //   empty, and an empty first field before a good one: ok
  let body = "{\"TableNames\":[\"t1\"]}"
  let good = crc32.checksum(body.bytes())
  expect(good) == 1324975443
  let cases = [
    (["abc"], "unable to parse checksum header abc, strconv.ParseUint: parsing \"abc\": invalid syntax"),
    (["4294967296"], "unable to parse checksum header 4294967296, strconv.ParseUint: parsing \"4294967296\": value out of range"),
    (["+${good}"], "unable to parse checksum header +1324975443, strconv.ParseUint: parsing \"+1324975443\": invalid syntax"),
    ([""], "ok"),
    (["", "${good}"], "ok"),
    (["${good}"], "ok"),
  ]
  // the fake answers the cases in order, one a call
  let n = Mutex[Int].new(0)
  os.net.handle("POST https://dynamodb.us-west-2.amazonaws.com/", fn(req: http.Request) -> http.Response {
    let i = n.with(fn(var x: Int) -> Int { x += 1; x - 1 })
    var r = http.text(200, body).with_header("Content-Type", "application/x-amz-json-1.0")
    for f in cases[i].0 {
      r = r.add_header("X-Amz-Crc32", f)
    }
    r
  })
  let c = dynamodb.new(os.net, os.clock, os.rand, dynamodb.Options{region: "us-west-2", credentials: test_creds()})?
  for (fields, want) in cases {
    let got = match c.list_tables(dynamodb.ListTablesInput{}) {
      Ok(_) => "ok"
      Err(dynamodb.ListTablesErr.Deserialize(msg)) => msg
      Err(e) => "other ${e:?}"
    }
    expect("${fields} ${got}") == "${fields} ${want}"
  }
}

test "SQS checks the MD5 of sent and received message bodies" {
  let sent_md5 = crypto.digest(crypto.Hash.Md5, b"hello").to_hex()
  os.net.handle("POST https://sqs.us-west-2.amazonaws.com/", fn(req: http.Request) -> http.Response {
    let target = req.header("X-Amz-Target") ?? ""
    let text = if target.ends_with("SendMessage") {
      "{\"MessageId\":\"m1\",\"MD5OfMessageBody\":\"${sent_md5}\"}"
    } else {
      "{\"Messages\":[{\"MessageId\":\"m2\",\"Body\":\"hello\",\"MD5OfBody\":\"00000000000000000000000000000000\"}]}"
    }
    http.text(200, text).with_header("Content-Type", "application/x-amz-json-1.0")
  })
  let c = sqs.new(os.net, os.clock, os.rand, sqs.Options{region: "us-west-2", credentials: test_creds()})?
  let q = "https://sqs.us-west-2.amazonaws.com/123456789012/q"
  c.send_message(sqs.SendMessageRequest{queue_url: q, message_body: "hello"})?
  match c.send_message(sqs.SendMessageRequest{queue_url: q, message_body: "changed on the way"}) {
    Err(sqs.SendMessageErr.Deserialize(msg)) => expect(msg.contains("MD5")) == true
    _ => return Err("an MD5 mismatch on send must fail")
  }
  match c.receive_message(sqs.ReceiveMessageRequest{queue_url: q}) {
    Err(sqs.ReceiveMessageErr.Deserialize(msg)) => expect(msg.contains("m2")) == true
    _ => return Err("an MD5 mismatch on receive must fail")
  }
}

test "DynamoDB sends to the credentials' account endpoint unless the mode is disabled" {
  let hosts = Mutex[List[Str]].new([])
  let answer = fn(host: Str) -> fn(http.Request) -> http.Response {
    fn(req: http.Request) -> http.Response {
      hosts.with(fn(var xs: List[Str]) { xs.push(host) })
      http.text(200, "{\"TableNames\":[]}").with_header("Content-Type", "application/x-amz-json-1.0")
    }
  }
  os.net.handle("POST https://123456789012.ddb.us-west-2.amazonaws.com/", answer("123456789012.ddb.us-west-2.amazonaws.com"))
  os.net.handle("POST https://dynamodb.us-west-2.amazonaws.com/", answer("dynamodb.us-west-2.amazonaws.com"))
  let creds = credentials.static_provider("AKIDTEST0000000000", "invented-secret", account_id: "123456789012")
  let c = dynamodb.new(os.net, os.clock, os.rand, dynamodb.Options{region: "us-west-2", credentials: creds})?
  c.list_tables(dynamodb.ListTablesInput{})?
  let off = dynamodb.new(os.net, os.clock, os.rand, dynamodb.Options{region: "us-west-2", credentials: creds, account_id_endpoint_mode: "disabled"})?
  off.list_tables(dynamodb.ListTablesInput{})?
  // credentials without an account use the regional endpoint
  let plain = dynamodb.new(os.net, os.clock, os.rand, dynamodb.Options{region: "us-west-2", credentials: credentials.static_provider("AKIDTEST0000000000", "invented-secret")})?
  plain.list_tables(dynamodb.ListTablesInput{})?
  expect(hosts.with_read(fn(xs: List[Str]) -> List[Str] { xs })) == ["123456789012.ddb.us-west-2.amazonaws.com", "dynamodb.us-west-2.amazonaws.com", "dynamodb.us-west-2.amazonaws.com"]
}
