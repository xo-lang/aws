pub struct AlarmDetails {
  /// The name of the alarm.
  pub alarm_name: Str? = None
}

pub enum AlgorithmSortBy: Str {
  Name = "Name"
  CreationTime = "CreationTime"
  Unknown(value: Str)
}

/// Specifies the training algorithm to use in a CreateTrainingJob request.
/// SageMaker uses its own SageMaker account credentials to pull and access
/// built-in algorithms so built-in algorithms are universally accessible
/// across all Amazon Web Services accounts. As a result, built-in
/// algorithms have standard, unrestricted access. You cannot restrict
/// built-in algorithms using IAM roles. Use custom algorithms if you
/// require specific access controls. For more information about algorithms
/// provided by SageMaker, see Algorithms . For information about using your
/// own algorithms, see Using Your Own Algorithms with Amazon SageMaker .
pub struct AlgorithmSpecification {
  /// The registry path of the Docker image that contains the training
  /// algorithm. For information about docker registry paths for SageMaker
  /// built-in algorithms, see Docker Registry Paths and Example Code in the
  /// Amazon SageMaker developer guide . SageMaker supports both
  /// registry/repository[:tag] and registry/repository[@digest] image path
  /// formats. For more information about using your custom training
  /// container, see Using Your Own Algorithms with Amazon SageMaker . You
  /// must specify either the algorithm name to the AlgorithmName parameter or
  /// the image URI of the algorithm container to the TrainingImage parameter.
  /// For more information, see the note in the AlgorithmName parameter
  /// description.
  pub training_image: Str? = None
  /// The name of the algorithm resource to use for the training job. This
  /// must be an algorithm resource that you created or subscribe to on Amazon
  /// Web Services Marketplace. You must specify either the algorithm name to
  /// the AlgorithmName parameter or the image URI of the algorithm container
  /// to the TrainingImage parameter. Note that the AlgorithmName parameter is
  /// mutually exclusive with the TrainingImage parameter. If you specify a
  /// value for the AlgorithmName parameter, you can't specify a value for
  /// TrainingImage , and vice versa. If you specify values for both
  /// parameters, the training job might break; if you don't specify any value
  /// for both parameters, the training job might raise a null error.
  pub algorithm_name: Str? = None
  pub training_input_mode: TrainingInputMode? = None
  /// A list of metric definition objects. Each object specifies the metric
  /// name and regular expressions used to parse algorithm logs. SageMaker
  /// publishes each metric to Amazon CloudWatch.
  pub metric_definitions: List[MetricDefinition]? = None
  /// To generate and save time-series metrics during training, set to true .
  /// The default is false and time-series metrics aren't generated except in
  /// the following cases: You use one of the SageMaker built-in algorithms
  /// You use one of the following Prebuilt SageMaker Docker Images :
  /// Tensorflow (version &gt;= 1.15) MXNet (version &gt;= 1.6) PyTorch
  /// (version &gt;= 1.3) You specify at least one MetricDefinition
  pub enable_sage_maker_metrics_time_series: Bool? = None
  /// The entrypoint script for a Docker container used to run a training job.
  /// This script takes precedence over the default train processing
  /// instructions. See How Amazon SageMaker Runs Your Training Image for more
  /// information.
  pub container_entrypoint: List[Str]? = None
  /// The arguments for a container used to run a training job. See How Amazon
  /// SageMaker Runs Your Training Image for additional information.
  pub container_arguments: List[Str]? = None
  /// The configuration to use an image from a private Docker registry for a
  /// training job.
  pub training_image_config: TrainingImageConfig? = None
}

pub enum AlgorithmStatus: Str {
  Pending = "Pending"
  InProgress = "InProgress"
  Completed = "Completed"
  Failed = "Failed"
  Deleting = "Deleting"
  Unknown(value: Str)
}

/// Specifies the validation and image scan statuses of the algorithm.
pub struct AlgorithmStatusDetails {
  /// The status of algorithm validation.
  pub validation_statuses: List[AlgorithmStatusItem]? = None
  /// The status of the scan of the algorithm's Docker image container.
  pub image_scan_statuses: List[AlgorithmStatusItem]? = None
}

/// Represents the overall status of an algorithm.
pub struct AlgorithmStatusItem {
  /// The name of the algorithm for which the overall status is being
  /// reported.
  pub name: Str? = None
  /// The current status.
  pub status: DetailedAlgorithmStatus? = None
  /// if the overall status is Failed , the reason for the failure.
  pub failure_reason: Str? = None
}

/// Provides summary information about an algorithm.
pub struct AlgorithmSummary {
  /// The name of the algorithm that is described by the summary.
  pub algorithm_name: Str? = None
  /// The Amazon Resource Name (ARN) of the algorithm.
  pub algorithm_arn: Str? = None
  /// A brief description of the algorithm.
  pub algorithm_description: Str? = None
  /// A timestamp that shows when the algorithm was created.
  pub creation_time: Time? = None
  /// The overall status of the algorithm.
  pub algorithm_status: AlgorithmStatus? = None
}

/// Defines a training job and a batch transform job that SageMaker runs to
/// validate your algorithm. The data provided in the validation profile is
/// made available to your buyers on Amazon Web Services Marketplace.
pub struct AlgorithmValidationProfile {
  /// The name of the profile for the algorithm. The name must have 1 to 63
  /// characters. Valid characters are a-z, A-Z, 0-9, and - (hyphen).
  pub profile_name: Str? = None
  /// The TrainingJobDefinition object that describes the training job that
  /// SageMaker runs to validate your algorithm.
  pub training_job_definition: TrainingJobDefinition? = None
  /// The TransformJobDefinition object that describes the transform job that
  /// SageMaker runs to validate your algorithm.
  pub transform_job_definition: TransformJobDefinition? = None
}

/// Specifies configurations for one or more training jobs that SageMaker
/// runs to test the algorithm.
pub struct AlgorithmValidationSpecification {
  /// The IAM roles that SageMaker uses to run the training jobs.
  pub validation_role: Str? = None
  /// An array of AlgorithmValidationProfile objects, each of which specifies
  /// a training job and batch transform job that SageMaker runs to validate
  /// your algorithm.
  pub validation_profiles: List[AlgorithmValidationProfile]? = None
}

/// A collection of settings that configure the Amazon Q experience within
/// the domain.
pub struct AmazonQSettings {
  /// Whether Amazon Q has been enabled within the domain.
  pub status: FeatureStatus? = None
  /// The ARN of the Amazon Q profile used within the domain.
  pub q_profile_arn: Str? = None
}

