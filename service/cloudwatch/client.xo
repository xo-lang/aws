fn xml_write_warm_up_configuration(var w: xmlv.Writer, v: WarmUpConfiguration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.warm_up_period_duration_in_minutes {
    xmlv.elem(w, "WarmUpPeriodDurationInMinutes", "${x}", [])
  }
  if let Some(x) = v.only_start_evaluating_after_warm_up_period_ends {
    xmlv.elem(w, "OnlyStartEvaluatingAfterWarmUpPeriodEnds", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_warm_up_configuration(e: xml.Element) -> WarmUpConfiguration ! Str {
  var out = WarmUpConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "WarmUpPeriodDurationInMinutes" => out.warm_up_period_duration_in_minutes = xmlv.read_int(c.text())?
      "OnlyStartEvaluatingAfterWarmUpPeriodEnds" => out.only_start_evaluating_after_warm_up_period_ends = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

