  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(StopContactRecordingErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_stop_contact_recording_error(resp))
  }
  deserialize_stop_contact_recording(resp) ?? e => Err(StopContactRecordingErr.Deserialize(e))
}

