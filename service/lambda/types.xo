  /// arn:aws:lambda:us-west-2:123456789012:function:MyFunction:PROD . Partial
  /// ARN – 123456789012:function:MyFunction . The length constraint applies
  /// only to the full ARN. If you specify only the function name, it's
  /// limited to 64 characters in length.
  pub function_name: Str? = None
  /// When true, the event source mapping is active. When false, Lambda pauses
  /// polling and invocation. Default: True
  pub enabled: Bool? = None
  /// The maximum number of records in each batch that Lambda pulls from your
  /// stream or queue and sends to your function. Lambda passes all of the
  /// records in the batch to the function in a single call, up to the payload
  /// limit for synchronous invocation (6 MB). Amazon Kinesis – Default 100.
  /// Max 10,000. Amazon DynamoDB Streams – Default 100. Max 10,000. Amazon
  /// Simple Queue Service – Default 10. For standard queues the max is
  /// 10,000. For FIFO queues the max is 10. Amazon Managed Streaming for
  /// Apache Kafka – Default 100. Max 10,000. Self-managed Apache Kafka –
  /// Default 100. Max 10,000. Amazon MQ (ActiveMQ and RabbitMQ) – Default
  /// 100. Max 10,000. DocumentDB – Default 100. Max 10,000.
  pub batch_size: Int? = None
  /// An object that defines the filter criteria that determine whether Lambda
  /// should process an event. For more information, see Lambda event
  /// filtering .
  pub filter_criteria: FilterCriteria? = None
  /// The ARN of the Key Management Service (KMS) customer managed key that
  /// Lambda uses to encrypt your function's filter criteria . By default,
  /// Lambda does not encrypt your filter criteria object. Specify this
  /// property to encrypt data using your own customer managed key.
  pub kms_key_arn: Str? = None
  /// The metrics configuration for your event source. For more information,
  /// see Event source mapping metrics .
  pub metrics_config: EventSourceMappingMetricsConfig? = None
  /// (Amazon MSK, and self-managed Apache Kafka only) The logging
  /// configuration for your event source. For more information, see Event
  /// source mapping logging .
  pub logging_config: EventSourceMappingLoggingConfig? = None
  /// (Amazon SQS only) The scaling configuration for the event source. For
  /// more information, see Configuring maximum concurrency for Amazon SQS
  /// event sources .
  pub scaling_config: ScalingConfig? = None
  /// The maximum amount of time, in seconds, that Lambda spends gathering
  /// records before invoking the function. You can configure
  /// MaximumBatchingWindowInSeconds to any value from 0 seconds to 300
  /// seconds in increments of seconds. For Kinesis, DynamoDB, and Amazon SQS
  /// event sources, the default batching window is 0 seconds. For Amazon MSK,
  /// Self-managed Apache Kafka, Amazon MQ, and DocumentDB event sources, the
  /// default batching window is 500 ms. Note that because you can only change
  /// MaximumBatchingWindowInSeconds in increments of seconds, you cannot
  /// revert back to the 500 ms default batching window after you have changed
  /// it. To restore the default batching window, you must create a new event
  /// source mapping. Related setting: For Kinesis, DynamoDB, and Amazon SQS
  /// event sources, when you set BatchSize to a value greater than 10, you
  /// must set MaximumBatchingWindowInSeconds to at least 1. Not supported for
  /// Kafka event source mappings when ConsumptionMode is Queue .
  pub maximum_batching_window_in_seconds: Int? = None
  /// (Kinesis and DynamoDB Streams only) The number of batches to process
  /// from each shard concurrently.
  pub parallelization_factor: Int? = None
  /// The position in a stream from which to start reading. Required for
  /// Amazon Kinesis and Amazon DynamoDB Stream event sources. AT_TIMESTAMP is
  /// supported only for Amazon Kinesis streams, Amazon DocumentDB, Amazon
  /// MSK, and self-managed Apache Kafka. Not supported for Kafka event source
  /// mappings when ConsumptionMode is Queue .
  pub starting_position: EventSourcePosition? = None
  /// With StartingPosition set to AT_TIMESTAMP , the time from which to start
  /// reading. StartingPositionTimestamp cannot be in the future. Not
  /// supported for Kafka event source mappings when ConsumptionMode is Queue
  /// .
  pub starting_position_timestamp: Time? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka) A
  /// configuration object that specifies the destination of an event after
  /// Lambda processes it.
  pub destination_config: DestinationConfig? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// Discard records older than the specified age. The default value is
  /// infinite (-1).
  pub maximum_record_age_in_seconds: Int? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// If the function returns an error, split the batch in two and retry.
  pub bisect_batch_on_function_error: Bool? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// Discard records after the specified number of retries. The default value
  /// is infinite (-1). When set to infinite (-1), failed records are retried
  /// until the record expires. For Kafka Stream consumption mode, the default
  /// is -1 (infinite retries; capped at 10 when an on-failure destination is
  /// configured). For Kafka Queue consumption mode, the default is 0 , and if
  /// no on-failure destination is configured the Kafka broker performs
  /// retries.
  pub maximum_retry_attempts: Int? = None
  /// A list of tags to apply to the event source mapping.
  pub tags: Map[Str, Str]? = None
  /// (Kinesis and DynamoDB Streams only) The duration in seconds of a
  /// processing window for DynamoDB and Kinesis Streams event sources. A
  /// value of 0 seconds indicates no tumbling window.
  pub tumbling_window_in_seconds: Int? = None
  /// The name of the Kafka topic.
  pub topics: List[Str]? = None
  /// (MQ) The name of the Amazon MQ broker destination queue to consume.
  pub queues: List[Str]? = None
  /// An array of authentication protocols or VPC components required to
  /// secure your event source.
  pub source_access_configurations: List[SourceAccessConfiguration]? = None
  /// The self-managed Apache Kafka cluster to receive records from.
  pub self_managed_event_source: SelfManagedEventSource? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, self-managed Apache Kafka, and
  /// Amazon SQS) A list of current response type enums applied to the event
  /// source mapping.
  pub function_response_types: List[FunctionResponseType]? = None
  /// Specific configuration settings for an Amazon Managed Streaming for
  /// Apache Kafka (Amazon MSK) event source.
  pub amazon_managed_kafka_event_source_config: AmazonManagedKafkaEventSourceConfig? = None
  /// Specific configuration settings for a self-managed Apache Kafka event
  /// source.
  pub self_managed_kafka_event_source_config: SelfManagedKafkaEventSourceConfig? = None
  /// Specific configuration settings for a DocumentDB event source.
  pub document_db_event_source_config: DocumentDBEventSourceConfig? = None
  /// (Amazon SQS, Amazon MSK, and self-managed Apache Kafka only) The
  /// provisioned mode configuration for the event source. For more
  /// information, see provisioned mode .
  pub provisioned_poller_config: ProvisionedPollerConfig? = None
}

pub struct CreateFunctionRequest {
  /// The name or ARN of the Lambda function. Name formats Function name –
  /// my-function . Function ARN –
  /// arn:aws:lambda:us-west-2:123456789012:function:my-function . Partial ARN
  /// – 123456789012:function:my-function . The length constraint applies
  /// only to the full ARN. If you specify only the function name, it is
  /// limited to 64 characters in length.
  pub function_name: Str? = None
  /// The identifier of the function's runtime . Runtime is required if the
  /// deployment package is a .zip file archive. Specifying a runtime results
  /// in an error if you're deploying a function using a container image. The
  /// following list includes deprecated runtimes. Lambda blocks creating new
  /// functions and updating existing functions shortly after each runtime is
  /// deprecated. For more information, see Runtime use after deprecation .
  /// For a list of all currently supported runtimes, see Supported runtimes .
  pub runtime: Runtime? = None
  /// The Amazon Resource Name (ARN) of the function's execution role.
  pub role: Str? = None
  /// The name of the method within your code that Lambda calls to run your
  /// function. Handler is required if the deployment package is a .zip file
  /// archive. The format includes the file name. It can also include
  /// namespaces and other qualifiers, depending on the runtime. For more
  /// information, see Lambda programming model .
  pub handler: Str? = None
  /// The code for the function.
  pub code: FunctionCode? = None
  /// A description of the function.
  pub description: Str? = None
  /// The amount of time (in seconds) that Lambda allows a function to run
  /// before stopping it. The default is 3 seconds, and the maximum allowed
  /// value is 900 seconds. For functions using Lambda Managed Instances,
  /// asynchronous invocations and event source mapping invocations (except
  /// Amazon MQ and Amazon DocumentDB) support a maximum allowed value of
  /// 5,400 seconds (90 minutes). For more information, see Lambda execution
  /// environment .
  pub timeout: Int? = None
  /// The amount of memory available to the function at runtime. Increasing
  /// the function memory also increases its CPU allocation. The default value
  /// is 128 MB. The value can be any multiple of 1 MB.
  pub memory_size: Int? = None
  /// Set to true to publish the first version of the function during
  /// creation.
  pub publish: Bool? = None
  /// Specifies where to publish the function version or configuration.
  pub publish_to: FunctionVersionLatestPublished? = None
  /// For network connectivity to Amazon Web Services resources in a VPC,
  /// specify a list of security groups and subnets in the VPC. When you
  /// connect a function to a VPC, it can access resources and the internet
  /// only through that VPC. For more information, see Configuring a Lambda
  /// function to access resources in a VPC .
  pub vpc_config: VpcConfig? = None
  /// The type of deployment package. Set to Image for container image and set
  /// to Zip for .zip file archive.
  pub package_type: PackageType? = None
  /// A dead-letter queue configuration that specifies the queue or topic
  /// where Lambda sends asynchronous events when they fail processing. For
  /// more information, see Dead-letter queues .
  pub dead_letter_config: DeadLetterConfig? = None
  /// Environment variables that are accessible from function code during
  /// execution.
  pub environment: Environment? = None
  /// The ARN of the Key Management Service (KMS) customer managed key that's
  /// used to encrypt the following resources: The function's environment
  /// variables . The function's Lambda SnapStart snapshots. When used with
  /// SourceKMSKeyArn , the unzipped version of the .zip deployment package
  /// that's used for function invocations. For more information, see
  /// Specifying a customer managed key for Lambda . The optimized version of
  /// the container image that's used for function invocations. Note that this
  /// is not the same key that's used to protect your container image in the
  /// Amazon Elastic Container Registry (Amazon ECR). For more information,
  /// see Function lifecycle . If you don't provide a customer managed key,
  /// Lambda uses an Amazon Web Services owned key or an Amazon Web Services
  /// managed key .
  pub kms_key_arn: Str? = None
  /// Set Mode to Active to sample and trace a subset of incoming requests
  /// with X-Ray .
  pub tracing_config: TracingConfig? = None
  /// A list of tags to apply to the function.
  pub tags: Map[Str, Str]? = None
  /// A list of function layers to add to the function's execution
  /// environment. Specify each layer by its ARN, including the version.
  pub layers: List[Str]? = None
  /// Connection settings for an Amazon EFS file system or an Amazon S3 Files
  /// file system.
  pub file_system_configs: List[FileSystemConfig]? = None
  /// To enable code signing for this function, specify the ARN of a
  /// code-signing configuration. A code-signing configuration includes a set
  /// of signing profiles, which define the trusted publishers for this
  /// function.
  pub code_signing_config_arn: Str? = None
  /// Container image configuration values that override the values in the
  /// container image Dockerfile.
  pub image_config: ImageConfig? = None
  /// The instruction set architecture that the function supports. Enter a
  /// string array with one of the valid values (arm64 or x86_64). The default
  /// value is x86_64 .
  pub architectures: List[Architecture]? = None
  /// The size of the function's /tmp directory in MB. The default value is
  /// 512, but can be any whole number between 512 and 10,240 MB. For more
  /// information, see Configuring ephemeral storage (console) .
  pub ephemeral_storage: EphemeralStorage? = None
  /// The function's SnapStart setting.
  pub snap_start: SnapStart? = None
  /// The function's Amazon CloudWatch Logs configuration settings.
  pub logging_config: LoggingConfig? = None
  /// Configuration for multi-tenant applications that use Lambda functions.
  /// Defines tenant isolation settings and resource allocations. Required for
  /// functions supporting multiple tenants.
  pub tenancy_config: TenancyConfig? = None
  /// Configuration for the capacity provider that manages compute resources
  /// for Lambda functions.
  pub capacity_provider_config: CapacityProviderConfig? = None
  /// Configuration settings for durable functions. Enables creating functions
  /// with durability that can remember their state and continue execution
  /// even after interruptions.
  pub durable_config: DurableConfig? = None
}

pub struct CreateFunctionUrlConfigRequest {
  /// The name or ARN of the Lambda function. Name formats Function name –
  /// my-function . Function ARN –
  /// arn:aws:lambda:us-west-2:123456789012:function:my-function . Partial ARN
  /// – 123456789012:function:my-function . The length constraint applies
  /// only to the full ARN. If you specify only the function name, it is
