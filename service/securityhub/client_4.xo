    Some(v) => v
    None => return Err("input member InsightArn is required")
  }
  if label_insight_arn == "" {
    return Err("input member InsightArn must not be empty")
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "GET",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/insights/results/${rest.escape(label_insight_arn, true)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_get_insight_results(resp: http.Response) -> GetInsightResultsResponse ! Str {
  var out = GetInsightResultsResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "InsightResults" => out.insight_results = from_json_insight_results(fv)?
      _ => {}
    }
  }
  Ok(out)
}