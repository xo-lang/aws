  /// SourceArn with the resource making the call from Route 53 to CloudWatch
  /// Logs. You would also replace the value of SourceAccount with the Amazon
  /// Web Services account ID making that call. { "Version": "2012-10-17",
  /// "Statement": [ { "Sid": "Route53LogsToCloudWatchLogs", "Effect":
  /// "Allow", "Principal": { "Service": [ "route53.amazonaws.com" ] },
  /// "Action": "logs:PutLogEvents", "Resource": "logArn", "Condition": {
