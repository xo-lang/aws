/// Uploads an object to the specified path. Object sizes are limited to 25
/// MB for standard upload availability and 10 MB for streaming upload
/// availability.
pub fn (c: Client) put_object(input: PutObjectRequest) -> PutObjectResponse ! PutObjectErr uses (net.dial, clock, rand) {
  let (ep, routed, extra) = c.route(endpoint_params_put_object(c.params, input)) ?? e => return Err(PutObjectErr.InvalidInput(e))
  let signing = routed with {unsigned_payload: true}
  var req = serialize_put_object(ep, input, "") ?? e => return Err(PutObjectErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(PutObjectErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_put_object_error(resp))
  }
  deserialize_put_object(resp) ?? e => Err(PutObjectErr.Deserialize(e))
}
