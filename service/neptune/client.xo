  if let Some(x) = v.preferred_maintenance_window {
    xmlv.elem(w, "PreferredMaintenanceWindow", x, [])
  }
  if let Some(x) = v.pending_modified_values {
    xml_write_pending_modified_values(w, x, "PendingModifiedValues", [])
  }
