// The generated Client (decision 0003): Options with the endpoint rules'
// builtins and client context parameters, endpoint resolution per call
// (static and context parameters per operation), and signing from the
// resolved endpoint's auth scheme.

use std/json
use github.com/xo-lang/aws/codegen/model

/// The service's endpoint rule set, when it has one.
pub fn rules_of(g: G) -> json.Value? {
  model.trait_of(shape_of(g, g.m.service).traits, "smithy.rules#endpointRuleSet")
}

/// A rule parameter the client sets from its Options: (parameter name,
/// Options field, Xo type, documentation).
struct ClientParam {
  name: Str
  field: Str
  bool: Bool
  doc: Str
}

fn client_params(g: G) -> List[ClientParam] {
  let rules = rules_of(g) ?? return []
  let ccp = match model.trait_of(shape_of(g, g.m.service).traits, "smithy.rules#clientContextParams") {
    Some(json.Value.Object(fs)) => fs.map(fn(f: (Str, json.Value)) -> Str { f.0 })
    _ => []
  }
  var out: List[ClientParam] = []
  if let Some(json.Value.Object(defs)) = rules.get("parameters") {
    for (name, def) in defs {
      let builtin = match def.get("builtIn") {
        Some(json.Value.Str(b)) => b
        _ => ""
      }
      if builtin == "AWS::Region" || builtin == "SDK::Endpoint" {
        continue
      }
      if builtin == "" && !ccp.contains(name) {
        continue
      }
      let ty = match def.get("type") {
        Some(json.Value.Str(t)) => t.to_lower()
        _ => "string"
      }
      if ty != "boolean" && ty != "string" {
        continue
      }
      let doc = match def.get("documentation") {
        Some(json.Value.Str(d)) => d
        _ => ""
      }
      out.push(ClientParam{name: name, field: field_name(name), bool: ty == "boolean", doc: doc})
    }
  }
  out
}

pub fn param_of(g: G, builtin: Str) -> Str? {
  let rules = rules_of(g) ?? return None
  if let Some(json.Value.Object(defs)) = rules.get("parameters") {
    for (name, def) in defs {
      if def.get("builtIn") == Some(json.Value.Str(builtin)) {
        return Some(name)
      }
    }
  }
  None
}

pub fn emit_client_head(g: G, var out: List[Str]) {
  let with_rules = rules_of(g).is_some()
  out.push("/// How a Client is made.")
  out.push("pub struct Options {")
  if with_rules {
    out.push("  /// A base endpoint to use instead of the resolved one, such as")
    out.push("  /// `http://localhost:9000` for a local emulator.")
    out.push("  pub endpoint: Str? = None")
  } else {
    out.push("  /// The base endpoint, such as `http://localhost:4566`.")
    out.push("  pub endpoint: Str")
  }
  out.push("  pub region: Str = \"us-east-1\"")
  out.push("  pub credentials: aws.CredentialsProvider")
  out.push("  pub max_attempts: Int = 3")
  out.push("  /// Sent as `X-Amzn-Trace-Id` (inside Lambda, from the configuration).")
  out.push("  pub trace_id: Str? = None")
  out.push("  /// The application's id in the User-Agent (`AWS_SDK_UA_APP_ID` or the")
  out.push("  /// profile's `sdk_ua_app_id` through `from_config`).")
  out.push("  pub app_id: Str? = None")
  if calculates_checksums(g) {
    out.push("  /// Send a CRC32 checksum with every operation that takes one, when the")
    out.push("  /// call names no algorithm and carries no checksum (aws-sdk-go-v2's")
    out.push("  /// default, \"when supported\"); false sends one only where required.")
    out.push("  pub calculate_request_checksums: Bool = true")
  }
  if validates_responses(g) {
    out.push("  /// Ask for and check response checksums where the operation supports")
    out.push("  /// them (aws-sdk-go-v2's default, \"when supported\"); false checks them")
    out.push("  /// only when the call sets its checksum mode (\"when required\").")
    out.push("  pub validate_response_checksums: Bool = true")
  }
  if bearer_auth(g) != "" {
    out.push("  /// The token of bearer auth (`AWS_BEARER_TOKEN_${bearer_env(g)}` through")
    out.push(if bearer_auth(g) == "only" { "  /// `from_config`); every call needs it." } else { "  /// `from_config`): when set, calls use it instead of SigV4." })
    out.push("  pub bearer_token: Str? = None")
    if bearer_auth(g) == "only" {
      out.push("  /// Asked for a token when `bearer_token` is not set: the profile's")
      out.push("  /// `sso_session` through `from_config`.")
      out.push("  pub bearer_provider: aws.BearerTokenProvider? = None")
    }
  }
  for p in client_params(g) {
    for l in wrap(strip_html(p.doc), 70) {
      out.push("  /// ${l}")
    }
    out.push("  pub ${p.field}: ${if p.bool { "Bool" } else { "Str" }}? = None")
  }
  out.push("}")
  out.push("")
  out.push("pub struct Client {")
  out.push("  pub region: Str")
  out.push("  pub transport: transport.Client")
  if with_rules {
    out.push("  /// The endpoint rule parameters every call shares.")
    out.push("  pub params: EndpointParameters")
  } else {
    out.push("  pub endpoint: rest.Endpoint")
  }
  out.push("  rand: Rand")
  if g.s3 {
    out.push("  /// S3 Express session credentials, by base credentials and bucket.")
    out.push("  express_sessions: credentials.SessionCache")
  }
  if calculates_checksums(g) {
    out.push("  calculate_checksums: Bool")
  }
  if validates_responses(g) {
    out.push("  validate_checksums: Bool")
  }
  if discovery_op(g).is_some() {
    out.push("  /// Addresses DescribeEndpoints returned (endpoint discovery).")
    out.push("  discovered: discovery.Cache")
    out.push("  clock: Clock")
  }
  out.push("}")
  out.push("")
  out.push("pub fn new(net: Net, clock: Clock, rand: Rand, options: Options) -> Client ! Str {")
  if with_rules {
    out.push("  var params = EndpointParameters{}")
    if let Some(r) = param_of(g, "AWS::Region") {
      out.push("  params.${field_name(r)} = options.region")
    }
    if let Some(e) = param_of(g, "SDK::Endpoint") {
      out.push("  params.${field_name(e)} = options.endpoint")
    }
    for p in client_params(g) {
      out.push("  if let Some(v) = options.${p.field} {")
      out.push("    params.${p.field} = v")
      out.push("  }")
    }
  } else {
    out.push("  let ep = rest.parse_endpoint(options.endpoint) ?? return Err(\"bad endpoint \${options.endpoint}\")")
  }
  // the User-Agent's client feature codes (aws-sdk-go-v2's): E the
  // standard retry mode; Z/a and b/c the checksum settings; P/Q/R the
  // account ID endpoint mode
  out.push("  var ua_features: List[Str] = [\"E\"]")
  if calculates_checksums(g) {
    out.push("  ua_features.push(if options.calculate_request_checksums { \"Z\" } else { \"a\" })")
  }
  if validates_responses(g) {
    out.push("  ua_features.push(if options.validate_response_checksums { \"b\" } else { \"c\" })")
  }
  if let Some(m) = param_of(g, "AWS::Auth::AccountIdEndpointMode") {
    out.push("  ua_features.push(match options.${field_name(m)} {")
    out.push("    Some(\"disabled\") => \"Q\"")
    out.push("    Some(\"required\") => \"R\"")
    out.push("    _ => \"P\"")
    out.push("  })")
  }
  // no versions: modules are tagged one by one (scripts/tag-modules.sh)
  let ua = "xo-lang-aws ua/2.1 lang/xo api/${service_dir(sdk_id(g))}"
  let ua_fields = "user_agent: \"${ua}\", app_id: options.app_id, features: ua_features"
  out.push("  Ok(Client{")
  if with_rules {
    out.push("    params: params,")
  } else {
    out.push("    endpoint: ep,")
  }
  out.push("    region: options.region,")
  if bearer_auth(g) != "" {
    let provider = if bearer_auth(g) == "only" { ", token_provider: options.bearer_provider" } else { "" }
    out.push("    transport: transport.new_client(net, clock, rand, options.credentials, retry.standard(max_attempts: options.max_attempts)) with {token: options.bearer_token.map(fn(t: Str) -> Secret[Str] { Secret.new(t) })${provider}, trace_id: options.trace_id, ${ua_fields}},")
  } else {
    out.push("    transport: transport.new_client(net, clock, rand, options.credentials, retry.standard(max_attempts: options.max_attempts)) with {trace_id: options.trace_id, ${ua_fields}},")
  }
  out.push("    rand: rand,")
  if g.s3 {
    out.push("    express_sessions: credentials.new_session_cache(),")
  }
  if calculates_checksums(g) {
    out.push("    calculate_checksums: options.calculate_request_checksums,")
  }
  if validates_responses(g) {
    out.push("    validate_checksums: options.validate_response_checksums,")
  }
  if discovery_op(g).is_some() {
    out.push("    discovered: discovery.new_cache(),")
    out.push("    clock: clock,")
  }
  out.push("  })")
  out.push("}")
  out.push("")
  if with_rules {
    emit_from_config(g, out)
    emit_with_account(g, out)
  }
  if g.s3 {
    emit_express_session(g, out)
  }
  emit_discover(g, out)
  out.push("const SIGNING_NAME: Str = ${lit_str(sigv4_name(g))}")
  out.push("")
  out.push("/// Where one call goes: the endpoint, how to sign, extra headers.")
  if with_rules {
    out.push("fn (c: Client) route(params: EndpointParameters) -> (rest.Endpoint, transport.Signing, List[(Str, Str)]) ! Str {")
    out.push("  let e = resolve_endpoint(params) ?? err => return Err(\"endpoint: \${err.msg}\")")
    out.push("  let ep = rest.parse_endpoint(e.url) ?? return Err(\"bad endpoint \${e.url}\")")
    out.push("  let (service, region) = endpoints.signing(e)")
    let express = if g.s3 { ", express_bucket: if endpoints.is_s3_express(e) { params.bucket } else { None }" } else { "" }
    out.push("  let signing = transport.Signing{service: service ?? SIGNING_NAME, region: region ?? c.region, s3: ${s3_signing(g)}, region_set: endpoints.region_set(e)${bearer_signing(g)}${express}}")
    out.push("  Ok((ep, signing, endpoints.header_pairs(e)))")
  } else {
    out.push("fn (c: Client) route() -> (rest.Endpoint, transport.Signing, List[(Str, Str)]) ! Str {")
    out.push("  Ok((c.endpoint, transport.Signing{service: SIGNING_NAME, region: c.region, s3: ${s3_signing(g)}${bearer_signing(g)}}, []))")
  }
  out.push("}")
  out.push("")
}

/// The context parameters of input member `m` (its `contextParam`, or
/// S3's Bucket label).
fn context_param(g: G, m: model.Member) -> Str? {
  if let Some(t) = model.trait_of(m.traits, "smithy.rules#contextParam") {
    if let Some(json.Value.Str(n)) = t.get("name") {
      return Some(n)
    }
  }
  if g.s3 && m.name == "Bucket" {
    return Some("Bucket")
  }
  None
}

/// `endpoint_params_<op>`: the client's parameters with an operation's
/// static and context parameters set (services with endpoint rules).
pub fn emit_endpoint_params(g: G, op: Str, var out: List[Str]) {
  let rules = rules_of(g) ?? return
  let params = rule_params(rules)
  let s = shape_of(g, op)
  let name = op_name(op)
  let in_t = if s.input == "smithy.api#Unit" { "()" } else { xo_type(g, s.input) }
  var body: List[Str] = []
  if let Some(json.Value.Object(fs)) = model.trait_of(s.traits, "smithy.rules#staticContextParams") {
    for (k, v) in fs {
      if let Some(p) = params.find(fn(p: Param) -> Bool { p.name == k }) {
        body.push("  p.${p.field} = ${param_lit(p, v.get("value") ?? json.Value.Null)}")
      }
    }
  }
  var used = false
  if s.input != "smithy.api#Unit" {
    for m in shape_of(g, s.input).members {
      let pn = context_param(g, m) ?? continue
      let p = params.find(fn(p: Param) -> Bool { p.name == pn }) ?? continue
      let value = match shape_of(g, m.target).kind {
        String => "x"
        Enum => "x.value()"
        Boolean => "x"
        _ => continue
      }
      used = true
      body.push("  if let Some(x) = input.${field_name(m.name)} {")
      body.push("    p.${p.field} = ${value}")
      body.push("  }")
    }
  }
  out.push("pub fn endpoint_params_${name}(base: EndpointParameters, input: ${in_t}) -> EndpointParameters {")
  if !used {
    out.push("  let _ = input")
  }
  if body.is_empty() {
    out.push("  base")
  } else {
    out.push("  var p = base")
    for l in body {
      out.push(l)
    }
    out.push("  p")
  }
  out.push("}")
  out.push("")
}

/// The service's suffix for configured endpoint URLs: its sdkId upper
/// cased with spaces as underscores (`AWS_ENDPOINT_URL_DYNAMODB`).
fn endpoint_suffix(g: G) -> Str {
  let sdk = match model.trait_of(shape_of(g, g.m.service).traits, "aws.api#service") {
    Some(t) => match t.get("sdkId") {
      Some(json.Value.Str(x)) => x
      _ => model.name_of(g.m.service)
    }
    None => model.name_of(g.m.service)
  }
  sdk.to_upper().replace(" ", "_")
}

/// `options_from_config` and `from_config`: a client from shared
/// configuration (`config.load_default_config`).
fn emit_from_config(g: G, var out: List[Str]) {
  out.push("/// Options from shared configuration (`config.load_default_config`):")
  out.push("/// its region, credentials, attempts, FIPS and dual stack settings,")
  out.push("/// and a configured endpoint URL (`AWS_ENDPOINT_URL_${endpoint_suffix(g)}`,")
  out.push("/// `AWS_ENDPOINT_URL`, or the profile's). Change fields with `with`")
  out.push("/// before calling `new`.")
  out.push("pub fn options_from_config(cfg: aws.Config) -> Options ! Str {")
  out.push("  let creds = cfg.credentials ?? return Err(\"no credentials in the configuration\")")
  out.push("  let region = cfg.region ?? return Err(\"no region in the configuration\")")
  out.push("  var o = Options{")
  out.push("    credentials: creds,")
  out.push("    region: region,")
  out.push("    max_attempts: cfg.max_attempts,")
  out.push("    endpoint: aws.endpoint_for(cfg.endpoints, ${lit_str(endpoint_suffix(g))}),")
  out.push("  }")
  if let Some(f) = param_of(g, "AWS::UseFIPS") {
    out.push("  o.${field_name(f)} = Some(cfg.use_fips)")
  }
  if let Some(d) = param_of(g, "AWS::UseDualStack") {
    out.push("  o.${field_name(d)} = Some(cfg.use_dualstack)")
  }
  out.push("  o.trace_id = cfg.trace_id")
  out.push("  o.app_id = cfg.app_id")
  if calculates_checksums(g) {
    out.push("  o.calculate_request_checksums = cfg.request_checksum_calculation != Some(\"when_required\")")
  }
  if validates_responses(g) {
    out.push("  o.validate_response_checksums = cfg.response_checksum_validation != Some(\"when_required\")")
  }
  if let Some(m) = param_of(g, "AWS::Auth::AccountIdEndpointMode") {
    out.push("  o.${field_name(m)} = cfg.account_id_endpoint_mode")
  }
  if bearer_auth(g) != "" {
    out.push("  o.bearer_token = cfg.bearer_tokens.get(${lit_str(bearer_env(g))})")
    if bearer_auth(g) == "only" {
      out.push("  o.bearer_provider = cfg.bearer_token_provider")
    }
  }
  out.push("  Ok(o)")
  out.push("}")
  out.push("")
  out.push("/// A client from shared configuration: `new` with `options_from_config`.")
  out.push("pub fn from_config(net: Net, clock: Clock, rand: Rand, cfg: aws.Config) -> Client ! Str {")
  out.push("  new(net, clock, rand, options_from_config(cfg)?)")
  out.push("}")
  out.push("")
}

/// Whether the service signs by S3's rules (the payload hash header sent,
/// the path neither normalized nor escaped again): S3, and S3 Control,
/// which refuses a request without `x-amz-content-sha256`.
fn s3_signing(g: G) -> Bool {
  g.s3 || g.m.service == "com.amazonaws.s3control#AWSS3ControlServiceV20180820"
}

/// The operation's auth (Smithy's auth traits on the operation, else the
/// service): "None" for `smithy.api#auth` with no schemes (even with
/// optionalAuth too), "Optional" for `smithy.api#optionalAuth`, else
/// "Required".
pub fn op_auth(g: G, op: Str) -> Str {
  let s = shape_of(g, op)
  let svc = g.m.shapes.get(g.m.service)
  let t = model.trait_of(s.traits, "auth") ?? (match svc {
    Some(x) => model.trait_of(x.traits, "auth")
    None => None
  })
  // no schemes at all wins over optionalAuth (Cognito's GetId has both)
  if let Some(json.Value.List(xs)) = t {
    if xs.is_empty() {
      return "None"
    }
  }
  if model.trait_of(s.traits, "optionalAuth").is_some() {
    return "Optional"
  }
  "Required"
}

/// The lines that route an operation's request: the endpoint, the
/// signing (with the operation's auth) and the endpoint's extra headers.
pub fn route_binding(g: G, op: Str, route: Str, en: Str) -> List[Str] {
  let auth = op_auth(g, op)
  let discovered = needs_discovery(g, op)
  let ep_name = if discovered { "found" } else { "ep" }
  let sig_name = if auth == "Required" { "signing" } else { "routed" }
  if g.s3 {
    // a directory bucket signs with its session (S3 Express)
    var out = ["  let (${ep_name}, routed, extra) = ${route} ?? e => return Err(${en}.InvalidInput(e))"]
    let authed = if auth != "Required" { "routed with {auth: transport.Auth.${auth}}" } else { "routed" }
    for l in precall_match("signing", "c.express_session(${authed})", en) { out.push(l) }
    return out
  }
  // aws.auth#unsignedPayload: UNSIGNED-PAYLOAD instead of the body's
  // hash (EBS, MediaStore Data, Lex, Omics uploads), as aws-sdk-go-v2
  let unsigned = has(shape_of(g, op).traits, "aws.auth#unsignedPayload")
  let name = if unsigned { "routed" } else { sig_name }
  var out = ["  let (${ep_name}, ${name}, extra) = ${route} ?? e => return Err(${en}.InvalidInput(e))"]
  var changes: List[Str] = []
  if auth != "Required" {
    changes.push("auth: transport.Auth.${auth}")
  }
  if unsigned {
    changes.push("unsigned_payload: true")
  }
  if !changes.is_empty() {
    out.push("  let signing = routed with {${changes.join(", ")}}")
  }
  if discovered {
    for l in precall_match("ep", "c.discover(found)", en) { out.push(l) }
  }
  out
}

/// The service's endpoint discovery operation (DescribeEndpoints), when
/// it has `aws.api#clientEndpointDiscovery`.
pub fn discovery_op(g: G) -> Str? {
  let svc = g.m.shapes.get(g.m.service) ?? return None
  let t = model.trait_of(svc.traits, "aws.api#clientEndpointDiscovery") ?? return None
  match t.get("operation") {
    Some(json.Value.Str(op)) => Some(op)
    _ => None
  }
}

/// Whether operation `op` must use a discovered endpoint: its
/// `aws.api#clientDiscoveredEndpoint` says required (Timestream). An
/// optional one (DynamoDB) uses the regional endpoint, as aws-sdk-go-v2
/// does by default.
fn needs_discovery(g: G, op: Str) -> Bool {
  if discovery_op(g).is_none() {
    return false
  }
  match model.trait_of(shape_of(g, op).traits, "aws.api#clientDiscoveredEndpoint") {
    Some(t) => match t.get("required") {
      Some(json.Value.Bool(b)) => b
      _ => false
    }
    None => false
  }
}

/// `discover`: the endpoint to use instead of the resolved one, from
/// DescribeEndpoints, cached per region; the resolved one when the caller
/// configured an endpoint (an emulator, a proxy).
fn emit_discover(g: G, var out: List[Str]) {
  let op = discovery_op(g) ?? return
  let s = shape_of(g, op)
  let endpoint_param = match param_of(g, "SDK::Endpoint") {
    Some(e) => field_name(e)
    None => return
  }
  out.push("/// The discovered endpoint for this client's region (DescribeEndpoints,")
  out.push("/// cached for the period it gives), or `found` when an endpoint was")
  out.push("/// configured.")
  out.push("fn (c: Client) discover(found: rest.Endpoint) -> rest.Endpoint ! transport.PrecallErr uses (net.dial, clock, rand) {")
  out.push("  if c.params.${endpoint_param}.is_some() {")
  out.push("    return Ok(found)")
  out.push("  }")
  out.push("  let now = c.clock.now().unix_millis()")
  out.push("  let host = match c.discovered.get(c.region, now) {")
  out.push("    Some(h) => h")
  out.push("    None => {")
  out.push("      let out = c.${op_name(op)}(${xo_type(g, s.input)}{}) ?? e => return Err(precall_${op_name(op)}(e))")
  out.push("      let all = out.endpoints ?? []")
  out.push("      if all.is_empty() {")
  out.push("        return Err(transport.PrecallErr.Deserialize(\"endpoint discovery: DescribeEndpoints returned no endpoints\"))")
  out.push("      }")
  out.push("      let h = discovery.host_of(all[0].address ?? \"\")")
  out.push("      c.discovered.put(c.region, h, all[0].cache_period_in_minutes ?? 0, now)")
  out.push("      h")
  out.push("    }")
  out.push("  }")
  out.push("  Ok(found with {host: host, port: None})")
  out.push("}")
  out.push("")
  emit_precall(g, op, out)
}

/// `precall_<op>`: the error of `op`, made before another operation, as a
/// transport.PrecallErr (a modeled error becomes an API error with its
/// name as the code).
fn emit_precall(g: G, op: Str, var out: List[Str]) {
  let en = op_err(op)
  out.push("fn precall_${op_name(op)}(e: ${en}) -> transport.PrecallErr {")
  out.push("  match e {")
  for (sh, v) in err_variants(g, op) {
    out.push("    ${en}.${v}(_) => transport.PrecallErr.Api(aws.ApiError{code: \"${model.name_of(sh)}\", message: e.display()})")
  }
  out.push("    ${en}.Api(a) => transport.PrecallErr.Api(a)")
  out.push("    ${en}.Send(s) => transport.PrecallErr.Send(s)")
  out.push("    ${en}.InvalidInput(m) => transport.PrecallErr.InvalidInput(m)")
  out.push("    ${en}.Deserialize(m) => transport.PrecallErr.Deserialize(m)")
  out.push("  }")
  out.push("}")
  out.push("")
}

/// `let <name> = <call>` for a call returning transport.PrecallErr, its
/// error turned into the operation's error `en`.
fn precall_match(name: Str, call: Str, en: Str) -> List[Str] {
  [
    "  let ${name} = match ${call} {",
    "    Ok(v) => v",
    "    Err(transport.PrecallErr.Send(e)) => return Err(${en}.Send(e))",
    "    Err(transport.PrecallErr.Api(e)) => return Err(${en}.Api(e))",
    "    Err(transport.PrecallErr.InvalidInput(m)) => return Err(${en}.InvalidInput(m))",
    "    Err(transport.PrecallErr.Deserialize(m)) => return Err(${en}.Deserialize(m))",
    "  }",
  ]
}

/// The service's bearer auth (`smithy.api#httpBearerAuth`): "only" when
/// it has no SigV4 (CodeCatalyst), "also" when it has both (Bedrock: the
/// token is used when one is set, as aws-sdk-go-v2 prefers it), "" when
/// it has none.
pub fn bearer_auth(g: G) -> Str {
  let svc = g.m.shapes.get(g.m.service) ?? return ""
  if model.trait_of(svc.traits, "httpBearerAuth").is_none() {
    return ""
  }
  if model.trait_of(svc.traits, "aws.auth#sigv4").is_none() { "only" } else { "also" }
}

/// The `auth:` field of the route's Signing for a bearer service.
fn bearer_signing(g: G) -> Str {
  match bearer_auth(g) {
    "only" => ", auth: transport.Auth.Bearer"
    "also" => ", auth: if c.transport.token.is_some() { transport.Auth.Bearer } else { transport.Auth.Required }"
    _ => ""
  }
}

/// The NAME of a bearer service's `AWS_BEARER_TOKEN_<NAME>`: its SigV4
/// signing name upper cased (BEDROCK for both Bedrock clients), else its
/// sdkId's endpoint suffix (CODECATALYST).
fn bearer_env(g: G) -> Str {
  let n = sigv4_name(g)
  if n == "" { endpoint_suffix(g) } else { n.to_upper().replace("-", "_") }
}

/// For a service whose endpoint rules take `AWS::Auth::AccountId`: the
/// account of the credentials, unless the caller set one or the mode is
/// "disabled" (aws-sdk-go-v2 resolves the identity before the endpoint).
/// A credentials error is left for signing to report.
fn emit_with_account(g: G, var out: List[Str]) {
  let a = param_of(g, "AWS::Auth::AccountId") ?? return
  let af = field_name(a)
  out.push("/// The endpoint parameters with the credentials' account filled in.")
  out.push("fn (c: Client) with_account(base: EndpointParameters) -> EndpointParameters uses (net.dial, clock, rand) {")
  out.push("  var p = base")
  if let Some(m) = param_of(g, "AWS::Auth::AccountIdEndpointMode") {
    let mf = field_name(m)
    out.push("  // aws-sdk-go-v2's default mode")
    out.push("  if p.${mf}.is_none() {")
    out.push("    p.${mf} = Some(\"preferred\")")
    out.push("  }")
    out.push("  if p.${af}.is_some() || p.${mf} == Some(\"disabled\") {")
    out.push("    return p")
    out.push("  }")
  } else {
    out.push("  if p.${af}.is_some() {")
    out.push("    return p")
    out.push("  }")
  }
  out.push("  match c.transport.credentials.retrieve() {")
  out.push("    Ok(cr) => p with {${af}: cr.account_id}")
  out.push("    Err(_) => p")
  out.push("  }")
  out.push("}")
  out.push("")
}

/// S3 Express (aws-sdk-go-v2's defaultS3ExpressCredentialsProvider): a
/// directory bucket's calls sign with CreateSession credentials, cached by
/// the base credentials (an HMAC of their keys) and the bucket, and
/// fetched again a minute before they expire. CreateSession itself signs
/// with the base credentials (its endpoint rules say plain SigV4).
fn emit_express_session(g: G, var out: List[Str]) {
  out.push("/// `signing` with the S3 Express session of its directory bucket, if any.")
  out.push("fn (c: Client) express_session(signing: transport.Signing) -> transport.Signing ! transport.PrecallErr uses (net.dial, clock, rand) {")
  if !model.operations(g.m).any(fn(o: Str) -> Bool { model.name_of(o) == "CreateSession" }) {
    // a model without CreateSession (the protocol tests' subset of S3)
    out.push("  Ok(signing)")
    out.push("}")
    out.push("")
    return
  }
  out.push("  let bucket = signing.express_bucket ?? return Ok(signing)")
  out.push("  let base = c.transport.credentials.retrieve() ?? e => return Err(transport.PrecallErr.Send(transport.SendErr.Credentials(e)))")
  out.push("  let mac = crypto.hmac_sha256(base.secret_access_key.reveal().bytes(), base.access_key_id.bytes()).to_hex()")
  out.push("  let key = \"\${mac}/\${bucket}\"")
  out.push("  let now = c.transport.clock.now()")
  out.push("  if let Some(s) = c.express_sessions.get(key, now, 1m) {")
  out.push("    return Ok(signing with {session: s})")
  out.push("  }")
  out.push("  let made = c.create_session(CreateSessionRequest{bucket: bucket}) ?? e => return Err(precall_create_session(e))")
  out.push("  let sc = made.credentials ?? return Err(transport.PrecallErr.Deserialize(\"S3 Express CreateSession for \${bucket}: no credentials in the response\"))")
  out.push("  let s = aws.Credentials{")
  out.push("    access_key_id: sc.access_key_id ?? \"\",")
  out.push("    secret_access_key: Secret.new(sc.secret_access_key ?? \"\"),")
  out.push("    session_token: Secret.new(sc.session_token ?? \"\"),")
  out.push("    expires: sc.expiration,")
  out.push("    source: \"S3ExpressSession\",")
  out.push("  }")
  out.push("  if s.access_key_id == \"\" || sc.session_token.is_none() || sc.expiration.is_none() {")
  out.push("    return Err(transport.PrecallErr.Deserialize(\"S3 Express CreateSession for \${bucket}: incomplete credentials\"))")
  out.push("  }")
  out.push("  let kept = c.express_sessions.put(key, s)")
  out.push("  Ok(signing with {session: kept})")
  out.push("}")
  out.push("")
  if let Some(cs) = model.operations(g.m).find(fn(o: Str) -> Bool { model.name_of(o) == "CreateSession" }) {
    emit_precall(g, cs, out)
  }
}
