fn xml_read_host_reservation(e: xml.Element) -> HostReservation ! Str {
  var out = HostReservation{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "count" => out.count = xmlv.read_int(c.text())?
      "currencyCode" => out.currency_code = CurrencyCodeValues.from(c.text())
      "duration" => out.duration = xmlv.read_int(c.text())?
      "end" => out.end = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "hostIdSet" => out.host_id_set = xml_read_response_host_id_set(c)?
      "hostReservationId" => out.host_reservation_id = c.text()
      "hourlyPrice" => out.hourly_price = c.text()
      "instanceFamily" => out.instance_family = c.text()
      "offeringId" => out.offering_id = c.text()
      "paymentOption" => out.payment_option = PaymentOption.from(c.text())
      "start" => out.start = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "state" => out.state = ReservationState.from(c.text())
      "upfrontPrice" => out.upfront_price = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

