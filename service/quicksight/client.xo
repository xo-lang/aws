  var out = Computation{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "TopBottomRanked" => out.top_bottom_ranked = from_json_top_bottom_ranked_computation(fv)?
