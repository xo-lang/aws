/// minimal amount of sharpening, or High to apply a maximum amount of
/// sharpening.
pub enum BandwidthReductionFilterSharpening: Str {
  Low = "LOW"
  Medium = "MEDIUM"
  High = "HIGH"
  Off = "OFF"
  Unknown(value: Str)
}

/// Specify the strength of the Bandwidth reduction filter. For most
