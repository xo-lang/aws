/// Span computed for the requested SpanAdditionalFeatures.
pub struct RoutePedestrianSpan {
  /// Duration of the computed span without traffic congestion. Unit : seconds
  pub best_case_duration: Int? = None
  /// 3 letter Country code corresponding to the Span.
  pub country: Str? = None
  /// Distance of the computed span. This feature doesn't split a span, but is
  /// always computed on a span split by other properties.
  pub distance: Int? = None
  /// Duration of the computed span. This feature doesn't split a span, but is
  /// always computed on a span split by other properties. Unit : seconds
  pub duration: Int? = None
  /// Dynamic speed details corresponding to the span. Unit : kilometers per
  /// hour
  pub dynamic_speed: RouteSpanDynamicSpeedDetails? = None
  /// A numerical value indicating the functional classification of the road
  /// segment corresponding to the span. Classification values are part of the
  /// hierarchical network that helps determine a logical and efficient route,
  /// and have the following definitions: Roads that allow for high volume,
  /// maximum speed traffic movement between and through major metropolitan
  /// areas. Roads that are used to channel traffic to functional class 1
  /// roads for travel between and through cities in the shortest amount of
  /// time. Roads that intersect functional class 2 roads and provide a high
  /// volume of traffic movement at a lower level of mobility than functional
  /// class 2 roads. Roads that provide for a high volume of traffic movement
  /// at moderate speeds between neighborhoods. Roads with volume and traffic
  /// movement below the level of any other functional class.
  pub functional_classification: Int? = None
  /// Offset in the leg geometry corresponding to the start of this span.
  pub geometry_offset: Int? = None
  /// Incidents corresponding to the span. These index into the Incidents in
  /// the parent Leg.
  pub incidents: List[Int]? = None
  /// Provides an array of names of the pedestrian span in available
  /// languages.
  pub names: List[LocalizedString]? = None
  /// Access attributes for a pedestrian corresponding to the span.
  pub pedestrian_access: List[RouteSpanPedestrianAccessAttribute]? = None
  /// 2-3 letter Region code corresponding to the Span. This is either a
  /// province or a state.
  pub region: Str? = None
  /// Attributes for the road segment corresponding to the span.
  pub road_attributes: List[RouteSpanRoadAttribute]? = None
  /// Designated route name or number corresponding to the span.
  pub route_numbers: List[RouteNumber]? = None
  /// Speed limit details corresponding to the span. Unit : kilometers per
  /// hour
  pub speed_limit: RouteSpanSpeedLimitDetails? = None
  /// Duration of the computed span under typical traffic congestion. Unit :
  /// seconds
  pub typical_duration: Int? = None
}

