/// The input fails to satisfy the constraints.
pub struct ValidationException {
  pub message: Str? = None
  /// The reason for the error.
  pub reason: ValidationExceptionReason? = None
  /// The fields that caused the error, if applicable.
  pub fields: List[ValidationExceptionField]? = None
}

/// Describes a validation exception for a field.
pub struct ValidationExceptionField {
  /// The name of the field.
  pub name: Str? = None
  /// The message for the field.
  pub message: Str? = None
}

pub enum ValidationExceptionReason: Str {
  UnknownOperation = "UnknownOperation"
  CannotParse = "CannotParse"
  FieldValidationFailed = "FieldValidationFailed"
  Other = "Other"
  Unknown(value: Str)
}

/// The list of network function groups and edge overrides for the service
/// insertion action. Used for both the send-to and send-via actions.
pub struct Via {
  /// The list of network function groups associated with the service
  /// insertion action.
  pub network_function_groups: List[NetworkFunctionGroup]? = None
  /// Describes any edge overrides. An edge override is a specific edge to be
  /// used for traffic.
  pub with_edge_overrides: List[EdgeOverride]? = None
}

/// Describes a VPC attachment.
pub struct VpcAttachment {
  /// Provides details about the VPC attachment.
  pub attachment: Attachment? = None
  /// The subnet ARNs.
  pub subnet_arns: List[Str]? = None
  /// Provides details about the VPC attachment.
  pub options: VpcOptions? = None
}

/// Describes the VPC options.
pub struct VpcOptions {
  /// Indicates whether IPv6 is supported.
  pub ipv6_support: Bool? = None
  /// Indicates whether appliance mode is supported. If enabled, traffic flow
  /// between a source and destination use the same Availability Zone for the
  /// VPC attachment for the lifetime of that flow. The default value is false
  /// .
  pub appliance_mode_support: Bool? = None
  /// Indicates whether DNS is supported.
  pub dns_support: Bool? = None
  /// Indicates whether security group referencing is enabled for this VPC
  /// attachment. The default is true . However, at the core network
  /// policy-level the default is set to false .
  pub security_group_referencing_support: Bool? = None
}

/// Displays a list of the destination segments. Used only when the service
/// insertion action is send-to .
pub struct WhenSentTo {
  /// The list of destination segments when the service insertion action is
  /// send-to .
  pub when_sent_to_segments_list: List[Str]? = None
}
