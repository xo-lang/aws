/// Provides information about a single utterance that was made to your bot.
pub struct UtteranceData {
  /// The text that was entered by the user or the text representation of an
  /// audio clip.
  pub utterance_string: Str? = None
  /// The number of times that the utterance was processed.
  pub count: Int? = None
  /// The total number of individuals that used the utterance.
  pub distinct_users: Int? = None
  /// The date that the utterance was first recorded.
  pub first_uttered_date: Time? = None
  /// The date that the utterance was last recorded.
  pub last_uttered_date: Time? = None
}

/// Provides a list of utterances that have been made to a specific version
/// of your bot. The list contains a maximum of 100 utterances.
pub struct UtteranceList {
  /// The version of the bot that processed the list.
  pub bot_version: Str? = None
  /// One or more UtteranceData objects that contain information about the
  /// utterances that have been made to a bot. The maximum number of object is
  /// 100.
  pub utterances: List[UtteranceData]? = None
}
