    UnusedPermissionDetails(x) => json.Value.Object([("unusedPermissionDetails", json_of_unused_permission_details(x))])
    UnusedIamUserAccessKeyDetails(x) => json.Value.Object([("unusedIamUserAccessKeyDetails", json_of_unused_iam_user_access_key_details(x))])
    UnusedIamRoleDetails(x) => json.Value.Object([("unusedIamRoleDetails", json_of_unused_iam_role_details(x))])
    UnusedIamUserPasswordDetails(x) => json.Value.Object([("unusedIamUserPasswordDetails", json_of_unused_iam_user_password_details(x))])
