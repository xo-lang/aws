fn xml_read_db_recommendation(e: xml.Element) -> DBRecommendation ! Str {
  var out = DBRecommendation{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "RecommendationId" => out.recommendation_id = c.text()
      "TypeId" => out.type_id = c.text()
      "Severity" => out.severity = c.text()
      "ResourceArn" => out.resource_arn = c.text()
      "Status" => out.status = c.text()
      "CreatedTime" => out.created_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UpdatedTime" => out.updated_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Detection" => out.detection = c.text()
      "Recommendation" => out.recommendation = c.text()
      "Description" => out.description = c.text()
      "Reason" => out.reason = c.text()
      "RecommendedActions" => out.recommended_actions = xml_read_recommended_action_list(c)?
      "Category" => out.category = c.text()
      "Source" => out.source = c.text()
      "TypeDetection" => out.type_detection = c.text()
      "TypeRecommendation" => out.type_recommendation = c.text()
      "Impact" => out.impact = c.text()
      "AdditionalInfo" => out.additional_info = c.text()
      "Links" => out.links = xml_read_doc_link_list(c)?
      "IssueDetails" => out.issue_details = xml_read_issue_details(c)?
      _ => {}
    }
  }
  Ok(out)
}

