      Ok(out) => {
        let o = jmes_of_describe_channel_output(out)
        if state == "" && waiter.path_matches(o, "ChannelDescription.ChannelStatus", "stringEquals", "ACTIVE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "ChannelDescription.ChannelStatus", "stringEquals", "CREATING") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "ChannelDescription.ChannelStatus", "stringEquals", "UPDATING") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "ChannelDescription.ChannelStatus", "stringEquals", "DELETING") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "ChannelDescription.ChannelStatus", "stringEquals", "FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ChannelActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

