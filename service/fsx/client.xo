fn json_of_lustre_file_system_configuration(v: LustreFileSystemConfiguration) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.weekly_maintenance_start_time {
    fs.push(("WeeklyMaintenanceStartTime", json.Value.Str(x)))
  }
  if let Some(x) = v.data_repository_configuration {
    fs.push(("DataRepositoryConfiguration", json_of_data_repository_configuration(x)))
  }
  if let Some(x) = v.deployment_type {
    fs.push(("DeploymentType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.per_unit_storage_throughput {
    fs.push(("PerUnitStorageThroughput", json.Value.Int(x)))
  }
  if let Some(x) = v.mount_name {
    fs.push(("MountName", json.Value.Str(x)))
  }
  if let Some(x) = v.daily_automatic_backup_start_time {
    fs.push(("DailyAutomaticBackupStartTime", json.Value.Str(x)))
  }
  if let Some(x) = v.automatic_backup_retention_days {
    fs.push(("AutomaticBackupRetentionDays", json.Value.Int(x)))
  }
  if let Some(x) = v.copy_tags_to_backups {
    fs.push(("CopyTagsToBackups", json.Value.Bool(x)))
  }
  if let Some(x) = v.drive_cache_type {
    fs.push(("DriveCacheType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.data_compression_type {
    fs.push(("DataCompressionType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.log_configuration {
    fs.push(("LogConfiguration", json_of_lustre_log_configuration(x)))
  }
  if let Some(x) = v.root_squash_configuration {
    fs.push(("RootSquashConfiguration", json_of_lustre_root_squash_configuration(x)))
  }
  if let Some(x) = v.metadata_configuration {
    fs.push(("MetadataConfiguration", json_of_file_system_lustre_metadata_configuration(x)))
  }
  if let Some(x) = v.efa_enabled {
    fs.push(("EfaEnabled", json.Value.Bool(x)))
  }
  if let Some(x) = v.throughput_capacity {
