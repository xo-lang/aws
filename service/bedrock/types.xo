  /// The unique identifier of the guardrail.
  pub id: Str? = None
  /// The ARN of the guardrail.
  pub arn: Str? = None
  /// The status of the guardrail.
  pub status: GuardrailStatus? = None
  /// The name of the guardrail.
  pub name: Str? = None
  /// A description of the guardrail.
  pub description: Str? = None
  /// The version of the guardrail.
  pub version: Str? = None
  /// The date and time at which the guardrail was created.
  pub created_at: Time? = None
  /// The date and time at which the guardrail was last updated.
  pub updated_at: Time? = None
  /// Details about the system-defined guardrail profile that you're using
  /// with your guardrail, including the guardrail profile ID and Amazon
  /// Resource Name (ARN).
  pub cross_region_details: GuardrailCrossRegionDetails? = None
}

