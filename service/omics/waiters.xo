/// Wait until an annotation import is completed
///
/// Calls GetAnnotationImportJob until the AnnotationImportJobCreated acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (600s).
pub fn wait_until_annotation_import_job_created(c: Client, input: GetAnnotationImportRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 600s) -> () ! waiter.WaitErr[GetAnnotationImportJobErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
