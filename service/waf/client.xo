}

fn json_of_http_request(v: HTTPRequest) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.client_ip {
    fs.push(("ClientIP", json.Value.Str(x)))
  }
  if let Some(x) = v.country {
    fs.push(("Country", json.Value.Str(x)))
  }
  if let Some(x) = v.uri {
    fs.push(("URI", json.Value.Str(x)))
  }
  if let Some(x) = v.method {
    fs.push(("Method", json.Value.Str(x)))
  }
  if let Some(x) = v.http_version {
    fs.push(("HTTPVersion", json.Value.Str(x)))
  }
  if let Some(x) = v.headers {
    fs.push(("Headers", json_of_http_headers(x)))
  }
  json.Value.Object(fs)
}

fn from_json_http_request(v: json.Value) -> HTTPRequest ! Str {
  var out = HTTPRequest{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ClientIP" => out.client_ip = jsonv.read_str(fv)?
      "Country" => out.country = jsonv.read_str(fv)?
      "URI" => out.uri = jsonv.read_str(fv)?
      "Method" => out.method = jsonv.read_str(fv)?
      "HTTPVersion" => out.http_version = jsonv.read_str(fv)?
      "Headers" => out.headers = from_json_http_headers(fv)?
      _ => {}
    }
  }
  Ok(out)
}

