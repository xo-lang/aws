/// Describes the association between a custom domain and an Amplify app.
pub struct DomainAssociation {
  /// The Amazon Resource Name (ARN) for the domain association.
  pub domain_association_arn: Str? = None
  /// The name of the domain.
  pub domain_name: Str? = None
  /// Enables the automated creation of subdomains for branches.
  pub enable_auto_sub_domain: Bool? = None
  /// Sets branch patterns for automatic subdomain creation.
  pub auto_sub_domain_creation_patterns: List[Str]? = None
  /// The required AWS Identity and Access Management (IAM) service role for
  /// the Amazon Resource Name (ARN) for automatically creating subdomains.
  pub auto_sub_domain_iam_role: Str? = None
  /// The current status of the domain association.
  pub domain_status: DomainStatus? = None
  /// The status of the domain update operation that is currently in progress.
  /// The following list describes the valid update states.
  /// REQUESTING_CERTIFICATE The certificate is in the process of being
  /// updated. PENDING_VERIFICATION Indicates that an Amplify managed
  /// certificate is in the process of being verified. This occurs during the
  /// creation of a custom domain or when a custom domain is updated to use a
  /// managed certificate. IMPORTING_CUSTOM_CERTIFICATE Indicates that an
  /// Amplify custom certificate is in the process of being imported. This
  /// occurs during the creation of a custom domain or when a custom domain is
  /// updated to use a custom certificate. PENDING_DEPLOYMENT Indicates that
  /// the subdomain or certificate changes are being propagated.
  /// AWAITING_APP_CNAME Amplify is waiting for CNAME records corresponding to
  /// subdomains to be propagated. If your custom domain is on Route 53,
  /// Amplify handles this for you automatically. For more information about
  /// custom domains, see Setting up custom domains in the Amplify Hosting
  /// User Guide . UPDATE_COMPLETE The certificate has been associated with a
  /// domain. UPDATE_FAILED The certificate has failed to be provisioned or
  /// associated, and there is no existing active certificate to roll back to.
  pub update_status: UpdateStatus? = None
  /// Additional information that describes why the domain association is in
  /// the current state.
  pub status_reason: Str? = None
  /// The DNS record for certificate verification.
  pub certificate_verification_dns_record: Str? = None
  /// The subdomains for the domain association.
  pub sub_domains: List[SubDomain]? = None
  /// Describes the SSL/TLS certificate for the domain association. This can
  /// be your own custom certificate or the default certificate that Amplify
  /// provisions for you. If you are updating your domain to use a different
  /// certificate, certificate points to the new certificate that is being
  /// created instead of the current active certificate. Otherwise,
  /// certificate points to the current active certificate.
  pub certificate: Certificate? = None
}

pub enum DomainStatus: Str {
  PendingVerification = "PENDING_VERIFICATION"
  InProgress = "IN_PROGRESS"
  Available = "AVAILABLE"
  ImportingCustomCertificate = "IMPORTING_CUSTOM_CERTIFICATE"
  PendingDeployment = "PENDING_DEPLOYMENT"
  AwaitingAppCname = "AWAITING_APP_CNAME"
  Failed = "FAILED"
