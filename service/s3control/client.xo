fn xml_write_user_arguments(var w: xmlv.Writer, v: Map[Str, Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", item, [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_user_arguments(e: xml.Element) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, vc.text())
    }
  }
  Ok(out)
}

fn xml_write_versioning_configuration(var w: xmlv.Writer, v: VersioningConfiguration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.mfa_delete {
    xmlv.elem(w, "MfaDelete", x.value(), [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_versioning_configuration(e: xml.Element) -> VersioningConfiguration ! Str {
  var out = VersioningConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "MfaDelete" => out.mfa_delete = MFADelete.from(c.text())
      "Status" => out.status = BucketVersioningStatus.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_vpc_configuration(var w: xmlv.Writer, v: VpcConfiguration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "VpcId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpc_configuration(e: xml.Element) -> VpcConfiguration ! Str {
  var out = VpcConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "VpcId" => out.vpc_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

