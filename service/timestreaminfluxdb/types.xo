/// share the same instance modes and instance type. A cluster's compute
/// topology is defined as a list of node groups.
pub struct NodeGroup {
  /// The functions that the nodes in this group perform. Provide from 1 to 4
  /// unique modes. Valid modes: INGEST – Nodes in this mode ingest data.
  /// Across all node groups, INGEST nodes must total between 1 and 4. QUERY
  /// – Nodes in this mode query data. Across all node groups, QUERY nodes
  /// must total between 0 and 14. COMPACT – Nodes in this mode compact
  /// data. Exactly one node across all node groups must have this mode. If
  /// the cluster has more than three non-compaction nodes, place the COMPACT
  /// node in its own dedicated node group. PROCESS – Nodes in this mode
  /// process data with the processing engine.
  pub instance_modes: List[InstanceMode]? = None
  /// The Timestream for InfluxDB DB instance type to run InfluxDB on for the
  /// nodes in this group.
  pub instance_type: DbInstanceType? = None
  /// The number of nodes in this group. Valid values are 1 to 13.
  pub count: Int? = None
}

