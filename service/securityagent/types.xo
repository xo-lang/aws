/// A code change in a CI/CD pipeline run that defines what a CI/CD pentest
/// job tests. Each scope change identifies an integrated repository and the
/// commit range for the change.
pub struct ScopeChange {
  /// The identifier of the integration for the source-code provider that
  /// hosts the repository.
  pub integration_id: Str? = None
  /// The provider-specific identifier of the repository the change belongs
  /// to.
  pub provider_resource_id: Str? = None
  /// The commit SHA that the change is compared against. When omitted, the
  /// change is evaluated against the head commit alone.
  pub base_commit_sha: Str? = None
  /// The commit SHA at the tip of the change to be tested.
  pub head_commit_sha: Str? = None
  /// The identifier of the CI/CD pipeline run that triggered this pentest
  /// job.
  pub trigger_run_id: Str? = None
}

/// The scoping decision for a CI/CD pentest job, indicating whether the
