    VectorConfig(x) => json.Value.Object([("VectorConfig", json_of_vector_config(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_collection_config(v: json.Value) -> CollectionConfig ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "VectorConfig" => Ok(CollectionConfig.VectorConfig(from_json_vector_config(fv)?))
      _ => Ok(CollectionConfig.Unknown(k))
    }
  }
  Err("CollectionConfig: no member set")
}

