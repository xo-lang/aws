      "nextToken" => out.next_token = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

/// The errors of ListRoles.
pub enum ListRolesErr {
  InternalServerException(e: InternalServerException)
  ThrottlingException(e: ThrottlingException)
  UnauthorizedException(e: UnauthorizedException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: ListRolesErr) display() -> Str {
  match e {
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    UnauthorizedException(x) => "UnauthorizedException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_list_roles_error(resp: http.Response) -> ListRolesErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return ListRolesErr.InternalServerException(x)
      Err(msg) => return ListRolesErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return ListRolesErr.ThrottlingException(x)
      Err(msg) => return ListRolesErr.Deserialize(msg)
    }
    "UnauthorizedException" => match read_error_unauthorized_exception(resp, body) {
      Ok(x) => return ListRolesErr.UnauthorizedException(x)
      Err(msg) => return ListRolesErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return ListRolesErr.ValidationException(x)
      Err(msg) => return ListRolesErr.Deserialize(msg)
    }
    _ => {}
  }
  ListRolesErr.Api(restjson.api_error(resp, body))
}

/// Returns the roles that you are entitled to access within a tenant. The
/// results are paginated. Use a returned role with GetRoleCredentials to
/// obtain temporary credentials.
pub fn (c: Client) list_roles(input: ListRolesRequest) -> ListRolesResponse ! ListRolesErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_list_roles(c.params, input)) ?? e => return Err(ListRolesErr.InvalidInput(e))
  var req = serialize_list_roles(ep, input, "") ?? e => return Err(ListRolesErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(ListRolesErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_list_roles_error(resp))
  }
  deserialize_list_roles(resp) ?? e => Err(ListRolesErr.Deserialize(e))
}
