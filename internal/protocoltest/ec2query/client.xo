fn xml_read_string_list(e: xml.Element) -> List[Str] ! Str {
  var out: List[Str] = []
  for c in xmlv.elements(e) {
    out.push(c.text())
  }
  Ok(out)
}

fn xml_write_string_set(var w: xmlv.Writer, v: List[Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xmlv.elem(w, "member", item, [])
  }
  xmlv.end(w, name)
}

fn xml_read_string_set(e: xml.Element) -> List[Str] ! Str {
  var out: List[Str] = []
  for c in xmlv.elements(e) {
    out.push(c.text())
  }
  Ok(out)
}

fn xml_write_timestamp_list(var w: xmlv.Writer, v: List[Time], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xmlv.elem(w, "member", rest.date_time(item), [])
  }
  xmlv.end(w, name)
}

fn xml_read_timestamp_list(e: xml.Element) -> List[Time] ! Str {
  var out: List[Time] = []
  for c in xmlv.elements(e) {
    out.push((rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp")))
  }
  Ok(out)
}

