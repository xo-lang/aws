fn json_of_payload(v: Payload) -> json.Value {
  match v {
    OpportunityInvitation(x) => json.Value.Object([("OpportunityInvitation", json_of_opportunity_invitation_payload(x))])
    LeadInvitation(x) => json.Value.Object([("LeadInvitation", json_of_lead_invitation_payload(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_payload(v: json.Value) -> Payload ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "OpportunityInvitation" => Ok(Payload.OpportunityInvitation(from_json_opportunity_invitation_payload(fv)?))
      "LeadInvitation" => Ok(Payload.LeadInvitation(from_json_lead_invitation_payload(fv)?))
      _ => Ok(Payload.Unknown(k))
    }
  }
  Err("Payload: no member set")
}

