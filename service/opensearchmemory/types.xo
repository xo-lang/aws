  /// . Scope by owner with the top-level actorId , not in the query.
  /// Searching memories doesn't filter by session. Absent when the service
  /// has no provenance for the memory.
  pub system_metadata: SystemMetadata? = None
  /// The memory's metadata tags. All values are strings. In a query, filter
  /// on a tag as metadata.&lt;key&gt; .
  pub metadata: Map[Str, Str]? = None
  /// The IDs of the events the memory was derived from, without duplicates.
  /// Use them with GetEvent or BatchGetEvent , or to search those events'
  /// content with SearchEvents by filtering on event_ids in the query. Absent
  /// for a memory created directly with CreateMemory . A memory can be
  /// derived from several events. The service sets this value.
  pub source_event_ids: List[Str]? = None
}

/// The timestamp that ListMemories sorts by.
pub enum MemorySortField: Str {
  CreatedAt = "CREATED_AT"
  UpdatedAt = "UPDATED_AT"
  Unknown(value: Str)
}

/// A memory strategy: how a space extracts one kind of memory from its
/// events.
pub struct MemoryStrategy {
  /// The type of memory the strategy extracts.
  pub type_value: MemoryStrategyType? = None
  /// A name for the strategy, unique within the space. Omit it to have the
  /// service generate one from the type, for example semantic_1 . The name
  /// must be 1 to 64 characters: letters, digits, periods, hyphens, and
  /// underscores, starting with a letter or digit. A strategy's name can't be
  /// changed, and the strategy's memories are stored under it: a strategy
  /// added under a new name starts with no memories.
  pub name: Str? = None
  /// A description of the strategy.
  pub description: Str? = None
  /// Settings for the strategy. When you create a strategy, omit it to use
  /// the defaults for the strategy's type. A CUSTOM strategy must set
  /// extractionPrompt .
  pub configuration: MemoryStrategyConfiguration? = None
}

/// Settings for a memory strategy. The defaults described here apply when
/// you create a strategy. In UpdateSpace , a member you omit for a kept
/// strategy keeps its current value.
pub struct MemoryStrategyConfiguration {
  /// Instructions that define what a CUSTOM strategy extracts, up to 30,720
  /// characters. Required for a CUSTOM strategy: CreateSpace and UpdateSpace
  /// fail with ValidationException if a CUSTOM strategy has none. Only CUSTOM
  /// strategies use it. SEMANTIC and SUMMARY strategies always extract with
  /// the service's built-in instructions: the service accepts and stores a
  /// prompt on them, and GetSpace returns it, but extraction doesn't use it.
  pub extraction_prompt: Str? = None
  /// Extract once this many messages have accumulated, from 1 to 1000. Lower
  /// values extract more often, in smaller batches. The default is 12.
  /// Messages accumulate until the first of extractEveryNMessages ,
  /// extractEveryNTokens , and idleTimeoutSeconds is reached. The service
  /// then extracts them together in one pass.
  pub extract_every_n_messages: Int? = None
  /// Extract once this many tokens of conversation have accumulated, from 1
  /// to 80,000, however few messages that takes. Use it to bound how much
  /// text one extraction call carries when message sizes vary widely. Omit it
  /// to bound a batch only by extractEveryNMessages , idleTimeoutSeconds ,
  /// and the service's maximum batch size.
  pub extract_every_n_tokens: Int? = None
  /// Extract what has accumulated once the conversation has been idle for
  /// this many seconds, from 1 to 86,400. The default is 60. This is what
  /// extracts the end of a conversation that stops. Raise it when the pauses
  /// in your conversations are longer than that, so that one exchange isn't
  /// split across several extraction passes.
  pub idle_timeout_seconds: Int? = None
  /// How many of the strategy's stored memories that are most relevant to the
  /// conversation to include in the extraction prompt, from 0 to 20, to
  /// improve extraction and reduce duplicates. If you omit this or set it to
  /// 0, the service uses its default (see extractionSeedRecentN ). When this
  /// and extractionSeedRecentN are both set, the two sets of memories are
  /// combined without duplicates.
  pub extraction_seed_top_k: Int? = None
  /// How many of the strategy's most recent stored memories to include in the
  /// extraction prompt, from 0 to 20. If you omit this or set it to 0, the
  /// service uses its default: no seeding for most strategy types, and the 10
  /// most recent memories for a SUMMARY strategy when neither seed setting is
  /// given. When this and extractionSeedTopK are both set, the two sets of
  /// memories are combined without duplicates.
  pub extraction_seed_recent_n: Int? = None
  /// Specifies whether the strategy consolidates memories. With
  /// consolidation, each new memory is compared with similar stored memories,
  /// and the service adds it, updates a stored memory, or skips it, so
  /// duplicate or contradicting facts don't accumulate. Without it, every
  /// extracted memory is stored as a new memory, which costs less and keeps a
  /// full history. When omitted, the default depends on the strategy's type:
  /// on for SEMANTIC and SUMMARY , off for CUSTOM .
  pub consolidation_enabled: Bool? = None
}

/// The type of memory a strategy extracts.
pub enum MemoryStrategyType: Str {
  Semantic = "SEMANTIC"
  Summary = "SUMMARY"
  Custom = "CUSTOM"
  Unknown(value: Str)
}

/// The type of a memory. Matches the type of the memory strategy that
/// produced it.
pub enum MemoryType: Str {
  Semantic = "SEMANTIC"
  Summary = "SUMMARY"
  Custom = "CUSTOM"
  Unknown(value: Str)
}

