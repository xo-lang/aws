  /// The date and time when the collection group was last modified.
  pub last_modified_date: Int? = None
  /// The generation of Amazon OpenSearch Serverless for the collection group.
  pub generation: Str? = None
}

pub struct UpdateCollectionGroupRequest {
  /// The unique identifier of the collection group to update.
  pub id: Str? = None
  /// A new description for the collection group.
  pub description: Str? = None
  /// The updated capacity limits for the collection group, in OpenSearch
  /// Compute Units (OCUs). Updates to capacity limits are not incremental.
  /// Any field not specified resets to its default value.
