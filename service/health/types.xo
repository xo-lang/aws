  /// events based on whether they require action ( ACTION_REQUIRED ), may
  /// require action ( ACTION_MAY_BE_REQUIRED ) or are informational (
  /// INFORMATIONAL ).
  pub actionabilities: List[EventActionability]? = None
  /// A list of event ARNs (unique identifiers). For example:
  /// "arn:aws:health:us-east-1::event/EC2/EC2_INSTANCE_RETIREMENT_SCHEDULED/EC2_INSTANCE_RETIREMENT_SCHEDULED_ABC123-CDE456",
  /// "arn:aws:health:us-west-1::event/EBS/AWS_EBS_LOST_VOLUME/AWS_EBS_LOST_VOLUME_CHI789_JKL101"
  pub event_arns: List[Str]? = None
  /// A list of unique identifiers for event types. For example,
  /// "AWS_EC2_SYSTEM_MAINTENANCE_EVENT","AWS_RDS_MAINTENANCE_SCHEDULED".
  pub event_type_codes: List[Str]? = None
  /// The Amazon Web Services services associated with the event. For example,
  /// EC2 , RDS .
  pub services: List[Str]? = None
  /// A list of Amazon Web Services Regions.
  pub regions: List[Str]? = None
  /// A list of Amazon Web Services Availability Zones.
  pub availability_zones: List[Str]? = None
  /// A list of dates and times that the event began.
  pub start_times: List[DateTimeRange]? = None
  /// A list of dates and times that the event ended.
  pub end_times: List[DateTimeRange]? = None
  /// A list of dates and times that the event was last updated.
  pub last_updated_times: List[DateTimeRange]? = None
  /// A list of entity ARNs (unique identifiers).
  pub entity_arns: List[Str]? = None
  /// A list of entity identifiers, such as EC2 instance IDs ( i-34ab692e ) or
  /// EBS volumes ( vol-426ab23e ).
  pub entity_values: List[Str]? = None
  /// A list of event type category codes. Possible values are issue ,
  /// accountNotification , or scheduledChange . Currently, the investigation
  /// value isn't supported at this time.
  pub event_type_categories: List[EventTypeCategory]? = None
  /// A map of entity tags attached to the affected entity. Currently, the
  /// tags property isn't supported.
  pub tags: List[Map[Str, Str]]? = None
  /// A list of event status codes.
  pub event_status_codes: List[EventStatusCode]? = None
  /// A list of persona values to filter events. Use this to filter events
  /// based on their target audience: OPERATIONS , SECURITY , or BILLING .
  pub personas: List[EventPersona]? = None
}

pub enum EventPersona: Str {
  Operations = "OPERATIONS"
  Security = "SECURITY"
  Billing = "BILLING"
  Unknown(value: Str)
}

/// Contains the metadata about a type of event that is reported by Health.
/// The EventType shows the category, service, and the event type code of
/// the event. For example, an issue might be the category, EC2 the service,
/// and AWS_EC2_SYSTEM_MAINTENANCE_EVENT the event type code. You can use
/// the DescribeEventTypes API operation to return this information about an
/// event. You can also use the Amazon CloudWatch Events console to create a
/// rule so that you can get notified or take action when Health delivers a
/// specific event to your Amazon Web Services account. For more
/// information, see Monitor for Health events with Amazon CloudWatch Events
/// in the Health User Guide .
pub struct EventType {
  /// The Amazon Web Services service that is affected by the event. For
  /// example, EC2 , RDS .
  pub service: Str? = None
  /// The unique identifier for the event type. The format is AWS_ SERVICE _
  /// DESCRIPTION ; for example, AWS_EC2_SYSTEM_MAINTENANCE_EVENT .
  pub code: Str? = None
  /// A list of event type category codes. Possible values are issue ,
  /// accountNotification , or scheduledChange . Currently, the investigation
  /// value isn't supported at this time.
  pub category: EventTypeCategory? = None
  /// The actionability classification of the event. Possible values are
  /// ACTION_REQUIRED , ACTION_MAY_BE_REQUIRED and INFORMATIONAL . Events with
  /// ACTION_REQUIRED actionability require customer action to resolve or
  /// mitigate the event. Events with ACTION_MAY_BE_REQUIRED actionability
  /// indicates that the current status is unknown or conditional and
  /// inspection is needed to determine if action is required. Events with
  /// INFORMATIONAL actionability are provided for awareness and do not
  /// require immediate action.
  pub actionability: EventTypeActionability? = None
  /// A list of persona classifications that indicate the target audience for
  /// the event. Possible values are OPERATIONS , SECURITY , and BILLING .
  /// Events can be associated with multiple personas to indicate relevance to
  /// different teams or roles within an organization.
  pub personas: List[EventTypePersona]? = None
}

pub enum EventTypeActionability: Str {
  ActionRequired = "ACTION_REQUIRED"
  ActionMayBeRequired = "ACTION_MAY_BE_REQUIRED"
  Informational = "INFORMATIONAL"
  Unknown(value: Str)
}

/// The values to use to filter results from the DescribeEventTypes
/// operation.
pub struct EventTypeFilter {
  /// A list of event type codes.
  pub event_type_codes: List[Str]? = None
  /// The Amazon Web Services services associated with the event. For example,
  /// EC2 , RDS .
  pub services: List[Str]? = None
  /// A list of event type category codes. Possible values are issue ,
  /// accountNotification , or scheduledChange . Currently, the investigation
  /// value isn't supported at this time.
  pub event_type_categories: List[EventTypeCategory]? = None
  /// A list of actionability values to filter event types. Possible values
  /// are ACTION_REQUIRED , ACTION_MAY_BE_REQUIRED and INFORMATIONAL .
  pub actionabilities: List[EventTypeActionability]? = None
  /// A list of persona classifications to filter event types. Possible values
  /// are OPERATIONS , SECURITY , and BILLING .
  pub personas: List[EventTypePersona]? = None
}

pub enum EventTypePersona: Str {
  Operations = "OPERATIONS"
  Security = "SECURITY"
  Billing = "BILLING"
  Unknown(value: Str)
}

/// The specified pagination token ( nextToken ) is not valid.
pub struct InvalidPaginationToken {
  pub message: Str? = None
}

/// A lifecycle event for an Amazon Web Services service version, such as
/// end-of-support or end-of-life.
pub struct LifecycleEvent {
  /// The type of lifecycle event (for example, end-of-support, end-of-life).
  pub lifecycle_event_type: Str? = None
  /// The date of the lifecycle event.
  pub date: Time? = None
  /// The Amazon Web Services Regions affected by this lifecycle event.
  pub regions: List[Str]? = None
  /// The potential impact risks associated with this lifecycle event.
  pub impact_risks: List[Str]? = None
  /// A description of the lifecycle event.
  pub description: Str? = None
}

/// Error information returned when a
/// DescribeAffectedEntitiesForOrganization operation can't find or process
/// a specific entity.
pub struct OrganizationAffectedEntitiesErrorItem {
  /// The 12-digit Amazon Web Services account numbers that contains the
  /// affected entities.
  pub aws_account_id: Str? = None
  /// The unique identifier for the event. The event ARN has the
  /// arn:aws:health: event-region ::event/ SERVICE / EVENT_TYPE_CODE /
  /// EVENT_TYPE_PLUS_ID format. For example, an event ARN might look like the
  /// following:
  /// arn:aws:health:us-east-1::event/EC2/EC2_INSTANCE_RETIREMENT_SCHEDULED/EC2_INSTANCE_RETIREMENT_SCHEDULED_ABC123-DEF456
  pub event_arn: Str? = None
  /// The name of the error.
  pub error_name: Str? = None
  /// A message that describes the error. Follow the error message and retry
  /// your request. For example, the InvalidAccountInputError error message
  /// appears if you call the DescribeAffectedEntitiesForOrganization
  /// operation and specify the AccountSpecific value for the EventScopeCode
  /// parameter, but don't specify an Amazon Web Services account.
  pub error_message: Str? = None
}

/// The aggregate results of entities affected by the specified event in
/// your organization. The results are aggregated by the entity status codes
/// for the specified set of accountsIDs.
pub struct OrganizationEntityAggregate {
  /// A list of event ARNs (unique identifiers). For example:
  /// "arn:aws:health:us-east-1::event/EC2/EC2_INSTANCE_RETIREMENT_SCHEDULED/EC2_INSTANCE_RETIREMENT_SCHEDULED_ABC123-CDE456",
  /// "arn:aws:health:us-west-1::event/EBS/AWS_EBS_LOST_VOLUME/AWS_EBS_LOST_VOLUME_CHI789_JKL101"
  pub event_arn: Str? = None
  /// The number of entities for the organization that match the filter
  /// criteria for the specified events.
  pub count: Int? = None
  /// The number of affected entities aggregated by the entitiy status codes.
  pub statuses: Map[Str, Int]? = None
  /// A list of entity aggregates for each of the specified accounts in your
  /// organization that are affected by a specific event. If there are no
  /// awsAccountIds provided in the request, this field will be empty in the
  /// response.
  pub accounts: List[AccountEntityAggregate]? = None
}

/// Summary information about an event, returned by the
/// DescribeEventsForOrganization operation.
pub struct OrganizationEvent {
  /// The unique identifier for the event. The event ARN has the
  /// arn:aws:health: event-region ::event/ SERVICE / EVENT_TYPE_CODE /
  /// EVENT_TYPE_PLUS_ID format. For example, an event ARN might look like the
  /// following:
  /// arn:aws:health:us-east-1::event/EC2/EC2_INSTANCE_RETIREMENT_SCHEDULED/EC2_INSTANCE_RETIREMENT_SCHEDULED_ABC123-DEF456
  pub arn: Str? = None
  /// The Amazon Web Services service that is affected by the event, such as
  /// EC2 and RDS.
  pub service: Str? = None
  /// The unique identifier for the event type. The format is
  /// AWS_SERVICE_DESCRIPTION . For example, AWS_EC2_SYSTEM_MAINTENANCE_EVENT
  /// .
  pub event_type_code: Str? = None
  /// A list of event type category codes. Possible values are issue ,
  /// accountNotification , or scheduledChange . Currently, the investigation
  /// value isn't supported at this time.
  pub event_type_category: EventTypeCategory? = None
  /// This parameter specifies if the Health event is a public Amazon Web
  /// Services service event or an account-specific event. If the
  /// eventScopeCode value is PUBLIC , then the affectedAccounts value is
  /// always empty. If the eventScopeCode value is ACCOUNT_SPECIFIC , then the
  /// affectedAccounts value lists the affected Amazon Web Services accounts
  /// in your organization. For example, if an event affects a service such as
  /// Amazon Elastic Compute Cloud and you have Amazon Web Services accounts
  /// that use that service, those account IDs appear in the response. If the
  /// eventScopeCode value is NONE , then the eventArn that you specified in
  /// the request is invalid or doesn't exist.
  pub event_scope_code: EventScopeCode? = None
  /// The Amazon Web Services Region name of the event.
  pub region: Str? = None
  /// The date and time that the event began.
  pub start_time: Time? = None
  /// The date and time that the event ended.
  pub end_time: Time? = None
  /// The most recent date and time that the event was updated.
  pub last_updated_time: Time? = None
  /// The most recent status of the event. Possible values are open , closed ,
  /// and upcoming .
  pub status_code: EventStatusCode? = None
  /// The actionability classification of the event. Possible values are
  /// ACTION_REQUIRED , ACTION_MAY_BE_REQUIRED and INFORMATIONAL . Events with
  /// ACTION_REQUIRED actionability require customer action to resolve or
  /// mitigate the event. Events with ACTION_MAY_BE_REQUIRED actionability
  /// indicates that the current status is unknown or conditional and
  /// inspection is needed to determine if action is required. Events with
  /// INFORMATIONAL actionability are provided for awareness and do not
  /// require immediate action.
  pub actionability: EventActionability? = None
  /// A list of persona classifications that indicate the target audience for
  /// the event. Possible values are OPERATIONS , SECURITY , and BILLING .
  /// Events can be associated with multiple personas to indicate relevance to
  /// different teams or roles within an organization.
  pub personas: List[EventPersona]? = None
}

