fn json_of_data_details(v: DataDetails) -> json.Value {
  match v {
    ContentData(x) => json.Value.Object([("contentData", json_of_content_data_details(x))])
    GenerativeData(x) => json.Value.Object([("generativeData", json_of_generative_data_details(x))])
    IntentDetectedData(x) => json.Value.Object([("intentDetectedData", json_of_intent_detected_data_details(x))])
    SourceContentData(x) => json.Value.Object([("sourceContentData", json_of_source_content_data_details(x))])
    GenerativeChunkData(x) => json.Value.Object([("generativeChunkData", json_of_generative_chunk_data_details(x))])
    EmailResponseChunkData(x) => json.Value.Object([("emailResponseChunkData", json_of_email_response_chunk_data_details(x))])
    EmailOverviewChunkData(x) => json.Value.Object([("emailOverviewChunkData", json_of_email_overview_chunk_data_details(x))])
    EmailGenerativeAnswerChunkData(x) => json.Value.Object([("emailGenerativeAnswerChunkData", json_of_email_generative_answer_chunk_data_details(x))])
    CaseSummarizationChunkData(x) => json.Value.Object([("caseSummarizationChunkData", json_of_case_summarization_chunk_data_details(x))])
    SuggestedMessageData(x) => json.Value.Object([("suggestedMessageData", json_of_suggested_message_data_details(x))])
    NotesData(x) => json.Value.Object([("notesData", json_of_notes_data_details(x))])
    NotesChunkData(x) => json.Value.Object([("notesChunkData", json_of_notes_chunk_data_details(x))])
    ProactiveRecommendationData(x) => json.Value.Object([("proactiveRecommendationData", json_of_proactive_recommendation_data_details(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_data_details(v: json.Value) -> DataDetails ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "contentData" => Ok(DataDetails.ContentData(from_json_content_data_details(fv)?))
      "generativeData" => Ok(DataDetails.GenerativeData(from_json_generative_data_details(fv)?))
      "intentDetectedData" => Ok(DataDetails.IntentDetectedData(from_json_intent_detected_data_details(fv)?))
      "sourceContentData" => Ok(DataDetails.SourceContentData(from_json_source_content_data_details(fv)?))
      "generativeChunkData" => Ok(DataDetails.GenerativeChunkData(from_json_generative_chunk_data_details(fv)?))
      "emailResponseChunkData" => Ok(DataDetails.EmailResponseChunkData(from_json_email_response_chunk_data_details(fv)?))
      "emailOverviewChunkData" => Ok(DataDetails.EmailOverviewChunkData(from_json_email_overview_chunk_data_details(fv)?))
      "emailGenerativeAnswerChunkData" => Ok(DataDetails.EmailGenerativeAnswerChunkData(from_json_email_generative_answer_chunk_data_details(fv)?))
      "caseSummarizationChunkData" => Ok(DataDetails.CaseSummarizationChunkData(from_json_case_summarization_chunk_data_details(fv)?))
      "suggestedMessageData" => Ok(DataDetails.SuggestedMessageData(from_json_suggested_message_data_details(fv)?))
      "notesData" => Ok(DataDetails.NotesData(from_json_notes_data_details(fv)?))
      "notesChunkData" => Ok(DataDetails.NotesChunkData(from_json_notes_chunk_data_details(fv)?))
      "proactiveRecommendationData" => Ok(DataDetails.ProactiveRecommendationData(from_json_proactive_recommendation_data_details(fv)?))
      _ => Ok(DataDetails.Unknown(k))
    }
  }
  Err("DataDetails: no member set")
}

fn json_of_data_reference(v: DataReference) -> json.Value {
  match v {
    ContentReference(x) => json.Value.Object([("contentReference", json_of_content_reference(x))])
    GenerativeReference(x) => json.Value.Object([("generativeReference", json_of_generative_reference(x))])
    SuggestedMessageReference(x) => json.Value.Object([("suggestedMessageReference", json_of_suggested_message_reference(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_data_reference(v: json.Value) -> DataReference ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "contentReference" => Ok(DataReference.ContentReference(from_json_content_reference(fv)?))
      "generativeReference" => Ok(DataReference.GenerativeReference(from_json_generative_reference(fv)?))
      "suggestedMessageReference" => Ok(DataReference.SuggestedMessageReference(from_json_suggested_message_reference(fv)?))
      _ => Ok(DataReference.Unknown(k))
    }
  }
  Err("DataReference: no member set")
}

fn json_of_data_summary(v: DataSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.reference {
    fs.push(("reference", json_of_data_reference(x)))
  }
  if let Some(x) = v.details {
    fs.push(("details", json_of_data_details(x)))
  }
  json.Value.Object(fs)
}

fn from_json_data_summary(v: json.Value) -> DataSummary ! Str {
  var out = DataSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "reference" => out.reference = from_json_data_reference(fv)?
      "details" => out.details = from_json_data_details(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_data_summary_list(v: List[DataSummary]) -> json.Value {
  json.Value.List(v.map(fn(x: DataSummary) -> json.Value { json_of_data_summary(x) }))
}

fn from_json_data_summary_list(v: json.Value) -> List[DataSummary] ! Str {
  var out: List[DataSummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_data_summary(fv)?)
  }
  Ok(out)
}

