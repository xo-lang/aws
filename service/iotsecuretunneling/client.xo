/// Revokes the current client access token (CAT) and returns new CAT for
/// clients to use when reconnecting to secure tunneling to access the same
/// tunnel. Requires permission to access the RotateTunnelAccessToken
/// action. Rotating the CAT doesn't extend the tunnel duration. For
/// example, say the tunnel duration is 12 hours and the tunnel has already
/// been open for 4 hours. When you rotate the access tokens, the new tokens
/// that are generated can only be used for the remaining 8 hours.
pub fn (c: Client) rotate_tunnel_access_token(input: RotateTunnelAccessTokenRequest) -> RotateTunnelAccessTokenResponse ! RotateTunnelAccessTokenErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_rotate_tunnel_access_token(c.params, input)) ?? e => return Err(RotateTunnelAccessTokenErr.InvalidInput(e))
  var req = serialize_rotate_tunnel_access_token(ep, input, "") ?? e => return Err(RotateTunnelAccessTokenErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(RotateTunnelAccessTokenErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_rotate_tunnel_access_token_error(resp))
  }
  deserialize_rotate_tunnel_access_token(resp) ?? e => Err(RotateTunnelAccessTokenErr.Deserialize(e))
}

