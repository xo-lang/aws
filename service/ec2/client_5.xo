      "versionNumber" => out.version_number = xmlv.read_int(c.text())?
      "versionDescription" => out.version_description = c.text()
      "createTime" => out.create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "createdBy" => out.created_by = c.text()
      "defaultVersion" => out.default_version = xmlv.read_bool(c.text())?
      "launchTemplateData" => out.launch_template_data = xml_read_response_launch_template_data(c)?
      "operator" => out.operator = xml_read_operator_response(c)?
      _ => {}
