}

/// The HTTP request of CreateEnvironment.
pub fn serialize_create_environment(ep: rest.Endpoint, input: CreateEnvironmentRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = input.desktop_arn {
    fs.push(("desktopArn", json.Value.Str(x)))
  }
  if let Some(x) = input.desktop_endpoint {
    fs.push(("desktopEndpoint", json.Value.Str(x)))
  }
  if let Some(x) = input.software_set_update_schedule {
    fs.push(("softwareSetUpdateSchedule", json.Value.Str(x.value())))
  }
  if let Some(x) = input.maintenance_window {
    fs.push(("maintenanceWindow", json_of_maintenance_window(x)))
  }
  if let Some(x) = input.software_set_update_mode {
    fs.push(("softwareSetUpdateMode", json.Value.Str(x.value())))
  }
  if let Some(x) = input.desired_software_set_id {
    fs.push(("desiredSoftwareSetId", json.Value.Str(x)))
  }
  if let Some(x) = input.kms_key_arn {
    fs.push(("kmsKeyArn", json.Value.Str(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("clientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("clientToken", json.Value.Str(idempotency_token)))
  }
  if let Some(x) = input.tags {
    fs.push(("tags", json_of_tags_map(x)))
  }
  if let Some(x) = input.device_creation_tags {
    fs.push(("deviceCreationTags", json_of_device_creation_tags_map(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: "api.${ep.host}",
    port: ep.port,
    path: rest.join_path(ep.path, "/environments"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_create_environment(resp: http.Response) -> CreateEnvironmentResponse ! Str {
  var out = CreateEnvironmentResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "environment" => out.environment = from_json_environment_summary(fv)?
      _ => {}
    }
  }
  Ok(out)
}

