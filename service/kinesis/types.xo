}

pub struct UpdateStreamRecordDistributionStrategyInput {
  /// The Amazon Resource Name (ARN) of the stream to update.
  pub stream_arn: Str? = None
  /// Not Implemented. Reserved for future use.
  pub stream_id: Str? = None
  /// The record distribution strategy to apply to the stream. Specify one of
