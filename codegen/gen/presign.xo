// Presigned requests: `presign_<op>` for the operations aws-sdk-go-v2's
// presign clients cover (S3's object and bucket calls, STS
// GetCallerIdentity, Polly SynthesizeSpeech). The request is built and routed as the operation's
// own, then signed in its query instead of sent.

use github.com/xo-lang/aws/codegen/model

/// (service shape id, operation name) pairs that get a presign method.
const PRESIGNED: List[(Str, Str)] = [
  ("com.amazonaws.s3#AmazonS3", "GetObject"),
  ("com.amazonaws.s3#AmazonS3", "PutObject"),
  ("com.amazonaws.s3#AmazonS3", "HeadObject"),
  ("com.amazonaws.s3#AmazonS3", "DeleteObject"),
  ("com.amazonaws.s3#AmazonS3", "UploadPart"),
  ("com.amazonaws.s3#AmazonS3", "HeadBucket"),
  ("com.amazonaws.s3#AmazonS3", "DeleteBucket"),
  ("com.amazonaws.sts#AWSSecurityTokenServiceV20110615", "GetCallerIdentity"),
  ("com.amazonaws.polly#Parrot_v1", "SynthesizeSpeech"),
]

pub fn presigned(g: G, op: Str) -> Bool {
  PRESIGNED.contains((g.m.service, model.name_of(op)))
}

pub fn emit_presign(g: G, op: Str, route: Str, token: Str, in_t: Str, var out: List[Str]) {
  let name = op_name(op)
  let en = op_err(op)
  out.push("/// ${model.name_of(op)} as a presigned request: a URL (and the headers")
  out.push("/// to send with it) that works without credentials until `expires`")
  out.push("/// passes (at most 7 days).")
  if g.query {
    out.push("/// The form parameters are sent as the query of a GET, as aws-sdk-go-v2")
    out.push("/// presigns query protocol calls.")
  }
  out.push("pub fn (c: Client) presign_${name}(input: ${in_t}, expires: Duration = 15m) -> transport.Presigned ! ${en} uses (net.dial, clock, rand) {")
  for l in route_binding(g, op, route, en) { out.push(l) }
  out.push("  var req = serialize_${name}(ep, input, ${token}) ?? e => return Err(${en}.InvalidInput(e))")
  out.push("  for h in extra {")
  out.push("    req.headers.push(h)")
  out.push("  }")
  if g.query {
    out.push("  req = req with {")
    out.push("    method: \"GET\",")
    out.push("    query: req.body.to_str() ?? \"\",")
    out.push("    body: b\"\",")
    out.push("    headers: req.headers.filter(fn(h: (Str, Str)) -> Bool { h.0.to_lower() != \"content-type\" }),")
    out.push("  }")
  }
  if !g.query && !g.xml && http_of(shape_of(g, op)).method == "POST" {
    // a JSON body becomes a GET's query, member by member, as
    // aws-sdk-go-v2 presigns Polly's SynthesizeSpeech
    out.push("  var qs: List[(Str, Str)] = []")
    for m in shape_of(g, shape_of(g, op).input).members {
      let f = field_name(m.name)
      let t = shape_of(g, m.target)
      let key = lit_str(m.name)
      match t.kind {
        List => {
          let et = shape_of(g, t.members[0].target)
          let v = if et.kind is model.Kind.Enum { "x.value()" } else { "x" }
          out.push("  for x in input.${f} ?? [] {")
          out.push("    qs.push((${key}, ${v}))")
          out.push("  }")
        }
        Enum => out.push("  if let Some(x) = input.${f} { qs.push((${key}, x.value())) }")
        String => out.push("  if let Some(x) = input.${f} { qs.push((${key}, x)) }")
        _ => out.push("  if let Some(x) = input.${f} { qs.push((${key}, \"\${x}\")) }")
      }
    }
    out.push("  req = req with {")
    out.push("    method: \"GET\",")
    out.push("    query: rest.query(qs),")
    out.push("    body: b\"\",")
    out.push("    headers: req.headers.filter(fn(h: (Str, Str)) -> Bool { h.0.to_lower() != \"content-type\" }),")
    out.push("  }")
  }
  out.push("  transport.presign(c.transport, req, signing, expires) ?? e => Err(${en}.Send(e))")
  out.push("}")
  out.push("")
  if g.s3 && model.name_of(op) == "PutObject" {
    emit_presign_post(g, op, route, in_t, out)
  }
}

/// S3's presigned POST (aws-sdk-go-v2's PresignPostObject): the form
/// fields a browser posts to upload the input's key, under a signed
/// policy. The URL is the bucket's endpoint, without the key.
fn emit_presign_post(g: G, op: Str, route: Str, in_t: Str, var out: List[Str]) {
  let en = op_err(op)
  out.push("/// PutObject as a presigned POST: the URL and form fields with which a")
  out.push("/// browser uploads `input.key` without credentials until `expires`")
  out.push("/// passes (at most 7 days). `conditions` are added to the policy (S3's")
  out.push("/// POST policy conditions, such as `[\"content-length-range\", 1, 1048576]`).")
  out.push("pub fn (c: Client) presign_post_object(input: ${in_t}, expires: Duration = 15m, conditions: List[json.Value] = []) -> transport.PresignedPost ! ${en} uses (net.dial, clock, rand) {")
  for l in route_binding(g, op, route, en) { out.push(l) }
  out.push("  if !extra.is_empty() {")
  out.push("    return Err(${en}.InvalidInput(\"a presigned POST cannot carry the endpoint's headers\"))")
  out.push("  }")
  out.push("  let bucket = input.bucket ?? return Err(${en}.InvalidInput(\"a presigned POST needs a bucket\"))")
  out.push("  let key = input.key ?? return Err(${en}.InvalidInput(\"a presigned POST needs a key\"))")
  out.push("  let port = ep.port.map(fn(p: Int) -> Str { \":\${p}\" }) ?? \"\"")
  out.push("  transport.presign_post(c.transport, \"\${ep.scheme}://\${ep.host}\${port}\${ep.path}\", signing, bucket, key, expires, conditions) ?? e => Err(${en}.Send(e))")
  out.push("}")
  out.push("")
}
