fn xml_write_upload_part_copy_request(var w: xmlv.Writer, v: UploadPartCopyRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.bucket {
    xmlv.elem(w, "Bucket", x, [])
  }
  if let Some(x) = v.copy_source {
    xmlv.elem(w, "CopySource", x, [])
  }
  if let Some(x) = v.copy_source_if_match {
    xmlv.elem(w, "CopySourceIfMatch", x, [])
  }
  if let Some(x) = v.copy_source_if_modified_since {
    xmlv.elem(w, "CopySourceIfModifiedSince", rest.date_time(x), [])
  }
