/// A leg is a section of a route from one waypoint to the next. A leg could
/// be of type Vehicle, Pedestrian or Ferry. Legs of different types could
/// occur together within a single route. For example, a car employing the
/// use of a Ferry will contain Vehicle legs corresponding to journey on
/// land, and Ferry legs corresponding to the journey via Ferry.
pub struct RouteLeg {
  /// FerryLegDetails is populated when the Leg type is Ferry, and provides
  /// additional information that is specific to ferry travel. Not supported
  /// in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
  pub ferry_leg_details: RouteFerryLegDetails? = None
  /// Geometry of the area to be avoided.
  pub geometry: RouteLegGeometry? = None
  /// List of languages for instructions within steps in the response. Not
  /// supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps
  /// customers.
  pub language: Str? = None
  /// Details related to the pedestrian leg.
  pub pedestrian_leg_details: RoutePedestrianLegDetails? = None
  /// Specifies the mode of transport when calculating a route. Used in
  /// estimating the speed of travel and road compatibility. Default value:
  /// Car
  pub travel_mode: RouteLegTravelMode? = None
  /// Type of the leg.
  pub type_value: RouteLegType? = None
  /// Details related to the vehicle leg.
  pub vehicle_leg_details: RouteVehicleLegDetails? = None
  /// Details related to the rental leg. Not supported in ap-southeast-1 and
  /// ap-southeast-5 regions for GrabMaps customers.
  pub rental_leg_details: RouteRentalLegDetails? = None
  /// Details related to the taxi leg. Not supported in ap-southeast-1 and
  /// ap-southeast-5 regions for GrabMaps customers.
  pub taxi_leg_details: RouteTaxiLegDetails? = None
  /// Details related to the transit leg.
  pub transit_leg_details: RouteTransitLegDetails? = None
}

pub enum RouteLegAdditionalFeature: Str {
  Elevation = "Elevation"
  Incidents = "Incidents"
  PassThroughWaypoints = "PassThroughWaypoints"
  Summary = "Summary"
  Tolls = "Tolls"
  TravelStepInstructions = "TravelStepInstructions"
  TruckRoadTypes = "TruckRoadTypes"
  TypicalDuration = "TypicalDuration"
  Zones = "Zones"
  Bookings = "Bookings"
