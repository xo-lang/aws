fn xml_write_instance_attribute(var w: xmlv.Writer, v: InstanceAttribute, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.block_device_mappings {
    xml_write_instance_block_device_mapping_list(w, x, "blockDeviceMapping", [])
  }
  if let Some(x) = v.disable_api_termination {
    xml_write_attribute_boolean_value(w, x, "disableApiTermination", [])
  }
  if let Some(x) = v.ena_support {
    xml_write_attribute_boolean_value(w, x, "enaSupport", [])
  }
  if let Some(x) = v.enclave_options {
    xml_write_enclave_options(w, x, "enclaveOptions", [])
  }
  if let Some(x) = v.ebs_optimized {
    xml_write_attribute_boolean_value(w, x, "ebsOptimized", [])
  }
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.instance_initiated_shutdown_behavior {
    xml_write_attribute_value(w, x, "instanceInitiatedShutdownBehavior", [])
  }
  if let Some(x) = v.instance_type {
    xml_write_attribute_value(w, x, "instanceType", [])
  }
  if let Some(x) = v.kernel_id {
    xml_write_attribute_value(w, x, "kernel", [])
  }
  if let Some(x) = v.product_codes {
    xml_write_product_code_list(w, x, "productCodes", [])
  }
  if let Some(x) = v.ramdisk_id {
    xml_write_attribute_value(w, x, "ramdisk", [])
  }
  if let Some(x) = v.root_device_name {
    xml_write_attribute_value(w, x, "rootDeviceName", [])
  }
  if let Some(x) = v.source_dest_check {
    xml_write_attribute_boolean_value(w, x, "sourceDestCheck", [])
  }
  if let Some(x) = v.sriov_net_support {
    xml_write_attribute_value(w, x, "sriovNetSupport", [])
  }
  if let Some(x) = v.user_data {
    xml_write_attribute_value(w, x, "userData", [])
  }
  if let Some(x) = v.disable_api_stop {
    xml_write_attribute_boolean_value(w, x, "disableApiStop", [])
  }
  if let Some(x) = v.groups {
    xml_write_group_identifier_list(w, x, "groupSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_attribute(e: xml.Element) -> InstanceAttribute ! Str {
  var out = InstanceAttribute{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "blockDeviceMapping" => out.block_device_mappings = xml_read_instance_block_device_mapping_list(c)?
      "disableApiTermination" => out.disable_api_termination = xml_read_attribute_boolean_value(c)?
      "enaSupport" => out.ena_support = xml_read_attribute_boolean_value(c)?
      "enclaveOptions" => out.enclave_options = xml_read_enclave_options(c)?
      "ebsOptimized" => out.ebs_optimized = xml_read_attribute_boolean_value(c)?
      "instanceId" => out.instance_id = c.text()
      "instanceInitiatedShutdownBehavior" => out.instance_initiated_shutdown_behavior = xml_read_attribute_value(c)?
      "instanceType" => out.instance_type = xml_read_attribute_value(c)?
      "kernel" => out.kernel_id = xml_read_attribute_value(c)?
      "productCodes" => out.product_codes = xml_read_product_code_list(c)?
      "ramdisk" => out.ramdisk_id = xml_read_attribute_value(c)?
      "rootDeviceName" => out.root_device_name = xml_read_attribute_value(c)?
      "sourceDestCheck" => out.source_dest_check = xml_read_attribute_boolean_value(c)?
      "sriovNetSupport" => out.sriov_net_support = xml_read_attribute_value(c)?
      "userData" => out.user_data = xml_read_attribute_value(c)?
      "disableApiStop" => out.disable_api_stop = xml_read_attribute_boolean_value(c)?
      "groupSet" => out.groups = xml_read_group_identifier_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

