fn json_of_multiplex(v: Multiplex) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("arn", json.Value.Str(x)))
  }
  if let Some(x) = v.availability_zones {
    fs.push(("availabilityZones", json_of_list_of_string(x)))
  }
  if let Some(x) = v.destinations {
    fs.push(("destinations", json_of_list_of_multiplex_output_destination(x)))
  }
  if let Some(x) = v.id {
    fs.push(("id", json.Value.Str(x)))
  }
  if let Some(x) = v.multiplex_settings {
    fs.push(("multiplexSettings", json_of_multiplex_settings(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.pipelines_running_count {
    fs.push(("pipelinesRunningCount", json.Value.Int(x)))
  }
  if let Some(x) = v.program_count {
    fs.push(("programCount", json.Value.Int(x)))
  }
  if let Some(x) = v.state {
    fs.push(("state", json.Value.Str(x.value())))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tags(x)))
  }
  json.Value.Object(fs)
}

fn from_json_multiplex(v: json.Value) -> Multiplex ! Str {
  var out = Multiplex{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "arn" => out.arn = jsonv.read_str(fv)?
      "availabilityZones" => out.availability_zones = from_json_list_of_string(fv)?
      "destinations" => out.destinations = from_json_list_of_multiplex_output_destination(fv)?
      "id" => out.id = jsonv.read_str(fv)?
      "multiplexSettings" => out.multiplex_settings = from_json_multiplex_settings(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "pipelinesRunningCount" => out.pipelines_running_count = jsonv.read_int(fv)?
      "programCount" => out.program_count = jsonv.read_int(fv)?
      "state" => out.state = MultiplexState.from(jsonv.read_str(fv)?)
