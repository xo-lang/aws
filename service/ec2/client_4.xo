fn xml_write_host(var w: xmlv.Writer, v: Host, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.auto_placement {
    xmlv.elem(w, "autoPlacement", x.value(), [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.available_capacity {
    xml_write_available_capacity(w, x, "availableCapacity", [])
  }
  if let Some(x) = v.client_token {
    xmlv.elem(w, "clientToken", x, [])
  }
  if let Some(x) = v.host_id {
    xmlv.elem(w, "hostId", x, [])
  }
  if let Some(x) = v.host_properties {
    xml_write_host_properties(w, x, "hostProperties", [])
  }
  if let Some(x) = v.host_reservation_id {
    xmlv.elem(w, "hostReservationId", x, [])
  }
  if let Some(x) = v.instances {
    xml_write_host_instance_list(w, x, "instances", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.allocation_time {
    xmlv.elem(w, "allocationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.release_time {
    xmlv.elem(w, "releaseTime", rest.date_time(x), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.host_recovery {
    xmlv.elem(w, "hostRecovery", x.value(), [])
  }
  if let Some(x) = v.allows_multiple_instance_types {
    xmlv.elem(w, "allowsMultipleInstanceTypes", x.value(), [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.availability_zone_id {
    xmlv.elem(w, "availabilityZoneId", x, [])
  }
  if let Some(x) = v.member_of_service_linked_resource_group {
    xmlv.elem(w, "memberOfServiceLinkedResourceGroup", "${x}", [])
  }
  if let Some(x) = v.outpost_arn {
    xmlv.elem(w, "outpostArn", x, [])
  }
  if let Some(x) = v.host_maintenance {
    xmlv.elem(w, "hostMaintenance", x.value(), [])
  }
  if let Some(x) = v.asset_id {
    xmlv.elem(w, "assetId", x, [])
  }
  if let Some(x) = v.cpu_options {
    xml_write_host_cpu_options(w, x, "cpuOptions", [])
  }
  xmlv.end(w, name)
}

fn xml_read_host(e: xml.Element) -> Host ! Str {
  var out = Host{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "autoPlacement" => out.auto_placement = AutoPlacement.from(c.text())
      "availabilityZone" => out.availability_zone = c.text()
      "availableCapacity" => out.available_capacity = xml_read_available_capacity(c)?
      "clientToken" => out.client_token = c.text()
      "hostId" => out.host_id = c.text()
      "hostProperties" => out.host_properties = xml_read_host_properties(c)?
      "hostReservationId" => out.host_reservation_id = c.text()
      "instances" => out.instances = xml_read_host_instance_list(c)?
      "state" => out.state = AllocationState.from(c.text())
      "allocationTime" => out.allocation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "releaseTime" => out.release_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "hostRecovery" => out.host_recovery = HostRecovery.from(c.text())
      "allowsMultipleInstanceTypes" => out.allows_multiple_instance_types = AllowsMultipleInstanceTypes.from(c.text())
      "ownerId" => out.owner_id = c.text()
      "availabilityZoneId" => out.availability_zone_id = c.text()
      "memberOfServiceLinkedResourceGroup" => out.member_of_service_linked_resource_group = xmlv.read_bool(c.text())?
      "outpostArn" => out.outpost_arn = c.text()
      "hostMaintenance" => out.host_maintenance = HostMaintenance.from(c.text())
      "assetId" => out.asset_id = c.text()
      "cpuOptions" => out.cpu_options = xml_read_host_cpu_options(c)?
      _ => {}
    }
  }
  Ok(out)
}

