  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until an ACME endpoint has been deleted.
///
/// Calls DescribeAcmeEndpoint until the AcmeEndpointDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (300s).
pub fn wait_until_acme_endpoint_deleted(c: Client, input: DescribeAcmeEndpointRequest, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 300s) -> () ! waiter.WaitErr[DescribeAcmeEndpointErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_acme_endpoint(input) {
      Ok(out) => {
        let o = jmes_of_describe_acme_endpoint_response(out)
        if state == "" && waiter.path_matches(o, "AcmeEndpoint.Status", "stringEquals", "DELETING") {
          state = "retry"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_acme_endpoint(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("AcmeEndpointDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeCertificate until the CertificateValidated acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (60s) to `max_delay` (120s).
pub fn wait_until_certificate_validated(c: Client, input: DescribeCertificateRequest, max_wait: Duration, min_delay: Duration = 60s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeCertificateErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_certificate(input) {
      Ok(out) => {
        let o = jmes_of_describe_certificate_response(out)
        if state == "" && waiter.path_matches(o, "Certificate.DomainValidationOptions[].ValidationStatus", "allStringEquals", "SUCCESS") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Certificate.DomainValidationOptions[].ValidationStatus", "anyStringEquals", "PENDING_VALIDATION") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "Certificate.Status", "stringEquals", "FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_certificate(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "failure"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("CertificateValidated: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
