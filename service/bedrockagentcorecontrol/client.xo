    fs.push(("timeoutSeconds", json.Value.Int(x)))
  }
  if let Some(x) = v.failure_mode {
    fs.push(("failureMode", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_harness_hook_lambda_target(v: json.Value) -> HarnessHookLambdaTarget ! Str {
  var out = HarnessHookLambdaTarget{}
