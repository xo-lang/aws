  if let Some(x) = v.append_to_prompt {
    fs.push(("appendToPrompt", json.Value.Str(x)))
  }
  if let Some(x) = v.model_id {
    fs.push(("modelId", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_user_preference_extraction_override(v: json.Value) -> UserPreferenceExtractionOverride ! Str {
  var out = UserPreferenceExtractionOverride{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "appendToPrompt" => out.append_to_prompt = jsonv.read_str(fv)?
      "modelId" => out.model_id = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_user_preference_memory_strategy_input(v: UserPreferenceMemoryStrategyInput) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.namespaces {
    fs.push(("namespaces", json_of_namespaces_list(x)))
  }
  if let Some(x) = v.namespace_templates {
    fs.push(("namespaceTemplates", json_of_namespaces_list(x)))
  }
  if let Some(x) = v.memory_record_schema {
    fs.push(("memoryRecordSchema", json_of_memory_record_schema(x)))
  }
  if let Some(x) = v.record_expiry_specification {
    fs.push(("recordExpirySpecification", json_of_record_expiry_specification(x)))
  }
  json.Value.Object(fs)
}

fn from_json_user_preference_memory_strategy_input(v: json.Value) -> UserPreferenceMemoryStrategyInput ! Str {
  var out = UserPreferenceMemoryStrategyInput{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "name" => out.name = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "namespaces" => out.namespaces = from_json_namespaces_list(fv)?
      "namespaceTemplates" => out.namespace_templates = from_json_namespaces_list(fv)?
      "memoryRecordSchema" => out.memory_record_schema = from_json_memory_record_schema(fv)?
      "recordExpirySpecification" => out.record_expiry_specification = from_json_record_expiry_specification(fv)?
      _ => {}
    }
  }
  Ok(out)
}

