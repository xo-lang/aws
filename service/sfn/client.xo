fn json_of_history_event_list(v: List[HistoryEvent]) -> json.Value {
  json.Value.List(v.map(fn(x: HistoryEvent) -> json.Value { json_of_history_event(x) }))
}

fn from_json_history_event_list(v: json.Value) -> List[HistoryEvent] ! Str {
  var out: List[HistoryEvent] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_history_event(fv)?)
  }
  Ok(out)
}

fn json_of_inspection_data(v: InspectionData) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.input {
    fs.push(("input", json.Value.Str(x)))
  }
  if let Some(x) = v.after_arguments {
    fs.push(("afterArguments", json.Value.Str(x)))
  }
  if let Some(x) = v.after_input_path {
    fs.push(("afterInputPath", json.Value.Str(x)))
  }
  if let Some(x) = v.after_parameters {
    fs.push(("afterParameters", json.Value.Str(x)))
  }
  if let Some(x) = v.result {
    fs.push(("result", json.Value.Str(x)))
  }
  if let Some(x) = v.after_result_selector {
    fs.push(("afterResultSelector", json.Value.Str(x)))
  }
  if let Some(x) = v.after_result_path {
    fs.push(("afterResultPath", json.Value.Str(x)))
  }
  if let Some(x) = v.request {
    fs.push(("request", json_of_inspection_data_request(x)))
  }
  if let Some(x) = v.response {
    fs.push(("response", json_of_inspection_data_response(x)))
  }
  if let Some(x) = v.variables {
    fs.push(("variables", json.Value.Str(x)))
  }
  if let Some(x) = v.error_details {
    fs.push(("errorDetails", json_of_inspection_error_details(x)))
  }
  if let Some(x) = v.after_items_path {
    fs.push(("afterItemsPath", json.Value.Str(x)))
  }
  if let Some(x) = v.after_item_selector {
    fs.push(("afterItemSelector", json.Value.Str(x)))
  }
  if let Some(x) = v.after_item_batcher {
    fs.push(("afterItemBatcher", json.Value.Str(x)))
  }
  if let Some(x) = v.after_items_pointer {
    fs.push(("afterItemsPointer", json.Value.Str(x)))
  }
  if let Some(x) = v.tolerated_failure_count {
    fs.push(("toleratedFailureCount", json.Value.Int(x)))
  }
  if let Some(x) = v.tolerated_failure_percentage {
    fs.push(("toleratedFailurePercentage", jsonv.float(x)))
  }
  if let Some(x) = v.max_concurrency {
    fs.push(("maxConcurrency", json.Value.Int(x)))
  }
  json.Value.Object(fs)
}

fn from_json_inspection_data(v: json.Value) -> InspectionData ! Str {
  var out = InspectionData{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "input" => out.input = jsonv.read_str(fv)?
      "afterArguments" => out.after_arguments = jsonv.read_str(fv)?
      "afterInputPath" => out.after_input_path = jsonv.read_str(fv)?
      "afterParameters" => out.after_parameters = jsonv.read_str(fv)?
      "result" => out.result = jsonv.read_str(fv)?
      "afterResultSelector" => out.after_result_selector = jsonv.read_str(fv)?
      "afterResultPath" => out.after_result_path = jsonv.read_str(fv)?
      "request" => out.request = from_json_inspection_data_request(fv)?
      "response" => out.response = from_json_inspection_data_response(fv)?
      "variables" => out.variables = jsonv.read_str(fv)?
      "errorDetails" => out.error_details = from_json_inspection_error_details(fv)?
      "afterItemsPath" => out.after_items_path = jsonv.read_str(fv)?
      "afterItemSelector" => out.after_item_selector = jsonv.read_str(fv)?
      "afterItemBatcher" => out.after_item_batcher = jsonv.read_str(fv)?
      "afterItemsPointer" => out.after_items_pointer = jsonv.read_str(fv)?
      "toleratedFailureCount" => out.tolerated_failure_count = jsonv.read_int(fv)?
      "toleratedFailurePercentage" => out.tolerated_failure_percentage = jsonv.read_float(fv)?
      "maxConcurrency" => out.max_concurrency = jsonv.read_int(fv)?
      _ => {}
    }
  }
  Ok(out)
}

