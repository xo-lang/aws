fn query_put_vpn_connection_options(var f: query.Form, prefix: Str, v: VpnConnectionOptions) {
  if let Some(x) = v.enable_acceleration {
    query.add(f, query.key(prefix, "EnableAcceleration"), "${x}")
  }
  if let Some(x) = v.static_routes_only {
    query.add(f, query.key(prefix, "StaticRoutesOnly"), "${x}")
  }
  if let Some(x) = v.local_ipv4_network_cidr {
    query.add(f, query.key(prefix, "LocalIpv4NetworkCidr"), x)
