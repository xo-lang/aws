fn xml_write_modify_scheduled_action_message(var w: xmlv.Writer, v: ModifyScheduledActionMessage, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.scheduled_action_name {
    xmlv.elem(w, "ScheduledActionName", x, [])
  }
  if let Some(x) = v.target_action {
    xml_write_scheduled_action_type(w, x, "TargetAction", [])
  }
  if let Some(x) = v.schedule {
    xmlv.elem(w, "Schedule", x, [])
  }
  if let Some(x) = v.iam_role {
    xmlv.elem(w, "IamRole", x, [])
  }
  if let Some(x) = v.scheduled_action_description {
    xmlv.elem(w, "ScheduledActionDescription", x, [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "StartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.end_time {
    xmlv.elem(w, "EndTime", rest.date_time(x), [])
  }
  if let Some(x) = v.enable {
    xmlv.elem(w, "Enable", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_modify_scheduled_action_message(e: xml.Element) -> ModifyScheduledActionMessage ! Str {
  var out = ModifyScheduledActionMessage{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ScheduledActionName" => out.scheduled_action_name = c.text()
      "TargetAction" => out.target_action = xml_read_scheduled_action_type(c)?
      "Schedule" => out.schedule = c.text()
      "IamRole" => out.iam_role = c.text()
      "ScheduledActionDescription" => out.scheduled_action_description = c.text()
      "StartTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EndTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Enable" => out.enable = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

