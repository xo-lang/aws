    ConflictException(x) => json.Value.Object([("conflictException", json_of_conflict_exception(x))])
    InternalServerException(x) => json.Value.Object([("internalServerException", json_of_internal_server_exception(x))])
    ResourceNotFoundException(x) => json.Value.Object([("resourceNotFoundException", json_of_resource_not_found_exception(x))])
    ServiceQuotaExceededException(x) => json.Value.Object([("serviceQuotaExceededException", json_of_service_quota_exceeded_exception(x))])
    ThrottlingException(x) => json.Value.Object([("throttlingException", json_of_throttling_exception(x))])
    ValidationException(x) => json.Value.Object([("validationException", json_of_validation_exception(x))])
    Unknown(_) => json.Value.Object([])
