    xmlv.elem(w, "LicenseModel", x, [])
  }
  if let Some(x) = v.iops {
    xmlv.elem(w, "Iops", "${x}", [])
  }
  if let Some(x) = v.option_group_memberships {
    xml_write_option_group_membership_list(w, x, "OptionGroupMemberships", [])
  }
  if let Some(x) = v.character_set_name {
    xmlv.elem(w, "CharacterSetName", x, [])
  }
  if let Some(x) = v.secondary_availability_zone {
    xmlv.elem(w, "SecondaryAvailabilityZone", x, [])
  }
  if let Some(x) = v.publicly_accessible {
    xmlv.elem(w, "PubliclyAccessible", "${x}", [])
  }
  if let Some(x) = v.status_infos {
    xml_write_db_instance_status_info_list(w, x, "StatusInfos", [])
  }
  if let Some(x) = v.storage_type {
    xmlv.elem(w, "StorageType", x, [])
  }
  if let Some(x) = v.tde_credential_arn {
    xmlv.elem(w, "TdeCredentialArn", x, [])
  }
  if let Some(x) = v.db_instance_port {
    xmlv.elem(w, "DbInstancePort", "${x}", [])
  }
  if let Some(x) = v.db_cluster_identifier {
    xmlv.elem(w, "DBClusterIdentifier", x, [])
  }
  if let Some(x) = v.storage_encrypted {
    xmlv.elem(w, "StorageEncrypted", "${x}", [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KmsKeyId", x, [])
  }
  if let Some(x) = v.dbi_resource_id {
    xmlv.elem(w, "DbiResourceId", x, [])
  }
  if let Some(x) = v.ca_certificate_identifier {
    xmlv.elem(w, "CACertificateIdentifier", x, [])
  }
  if let Some(x) = v.domain_memberships {
    xml_write_domain_membership_list(w, x, "DomainMemberships", [])
  }
  if let Some(x) = v.copy_tags_to_snapshot {
    xmlv.elem(w, "CopyTagsToSnapshot", "${x}", [])
  }
  if let Some(x) = v.monitoring_interval {
    xmlv.elem(w, "MonitoringInterval", "${x}", [])
  }
  if let Some(x) = v.enhanced_monitoring_resource_arn {
    xmlv.elem(w, "EnhancedMonitoringResourceArn", x, [])
  }
  if let Some(x) = v.monitoring_role_arn {
    xmlv.elem(w, "MonitoringRoleArn", x, [])
  }
  if let Some(x) = v.promotion_tier {
    xmlv.elem(w, "PromotionTier", "${x}", [])
  }
  if let Some(x) = v.db_instance_arn {
    xmlv.elem(w, "DBInstanceArn", x, [])
  }
  if let Some(x) = v.timezone {
    xmlv.elem(w, "Timezone", x, [])
  }
  if let Some(x) = v.iam_database_authentication_enabled {
    xmlv.elem(w, "IAMDatabaseAuthenticationEnabled", "${x}", [])
  }
  if let Some(x) = v.performance_insights_enabled {
    xmlv.elem(w, "PerformanceInsightsEnabled", "${x}", [])
  }
  if let Some(x) = v.performance_insights_kms_key_id {
