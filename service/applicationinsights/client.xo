  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateWorkloadErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_workload_error(resp))
  }
  deserialize_update_workload(resp) ?? e => Err(UpdateWorkloadErr.Deserialize(e))
}
