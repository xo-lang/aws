/// By default, all new solutions use automatic training. With automatic
/// training, you incur training costs while your solution is active. To
/// avoid unnecessary costs, when you are finished you can update the
/// solution to turn off automatic training. For information about training
/// costs, see Amazon Personalize pricing . An object that provides
/// information about a solution. A solution includes the custom recipe,
/// customized parameters, and trained models (Solution Versions) that
/// Amazon Personalize uses to generate recommendations. After you create a
/// solution, you can’t change its configuration. If you need to make
/// changes, you can clone the solution with the Amazon Personalize console
/// or create a new one.
pub struct Solution {
  /// The name of the solution.
  pub name: Str? = None
  /// The ARN of the solution.
  pub solution_arn: Str? = None
  /// Whether to perform hyperparameter optimization (HPO) on the chosen
  /// recipe. The default is false .
  pub perform_hpo: Bool? = None
  /// We don't recommend enabling automated machine learning. Instead, match
  /// your use case to the available Amazon Personalize recipes. For more
  /// information, see Determining your use case. When true, Amazon
  /// Personalize performs a search for the best USER_PERSONALIZATION recipe
  /// from the list specified in the solution configuration ( recipeArn must
  /// not be specified). When false (the default), Amazon Personalize uses
  /// recipeArn for training.
  pub perform_auto_ml: Bool? = None
  /// Specifies whether the solution automatically creates solution versions.
  /// The default is True and the solution automatically creates new solution
  /// versions every 7 days. For more information about auto training, see
  /// Creating and configuring a solution .
  pub perform_auto_training: Bool? = None
  /// A Boolean value that indicates whether incremental training updates are
  /// performed on the model. When enabled, this allows the model to learn
  /// from new data more frequently without requiring full retraining, which
  /// enables near real-time personalization. This parameter is supported only
  /// for solutions that use the semantic-similarity recipe
  pub perform_incremental_update: Bool? = None
  /// The ARN of the recipe used to create the solution. This is required when
  /// performAutoML is false.
  pub recipe_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset group that provides the
  /// training data.
  pub dataset_group_arn: Str? = None
  /// The event type (for example, 'click' or 'like') that is used for
  /// training the model. If no eventType is provided, Amazon Personalize uses
  /// all interactions for training with equal weight regardless of type.
  pub event_type: Str? = None
  /// Describes the configuration properties for the solution.
  pub solution_config: SolutionConfig? = None
  /// When performAutoML is true, specifies the best recipe found.
  pub auto_ml_result: AutoMLResult? = None
  /// The status of the solution. A solution can be in one of the following
  /// states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or- CREATE FAILED
  /// DELETE PENDING DELETE IN_PROGRESS
  pub status: Str? = None
  /// The creation date and time (in Unix time) of the solution.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) that the solution was last updated.
  pub last_updated_date_time: Time? = None
  /// Describes the latest version of the solution, including the status and
  /// the ARN.
  pub latest_solution_version: SolutionVersionSummary? = None
  /// Provides a summary of the latest updates to the solution.
  pub latest_solution_update: SolutionUpdateSummary? = None
}

/// Describes the configuration properties for the solution.
pub struct SolutionConfig {
  /// Only events with a value greater than or equal to this threshold are
  /// used for training a model.
  pub event_value_threshold: Str? = None
  /// Describes the properties for hyperparameter optimization (HPO).
  pub hpo_config: HPOConfig? = None
  /// Lists the algorithm hyperparameters and their values.
  pub algorithm_hyper_parameters: Map[Str, Str]? = None
  /// Lists the feature transformation parameters.
  pub feature_transformation_parameters: Map[Str, Str]? = None
  /// The AutoMLConfig object containing a list of recipes to search when
  /// AutoML is performed.
  pub auto_ml_config: AutoMLConfig? = None
  /// Describes the configuration of an event, which includes a list of event
  /// parameters. You can specify up to 10 event parameters. Events are used
  /// in solution creation.
  pub events_config: EventsConfig? = None
  /// Describes the additional objective for the solution, such as maximizing
  /// streaming minutes or increasing revenue. For more information see
  /// Optimizing a solution .
  pub optimization_objective: OptimizationObjective? = None
  /// Specifies the training data configuration to use when creating a custom
  /// solution version (trained model).
  pub training_data_config: TrainingDataConfig? = None
  /// Specifies the automatic training configuration to use.
  pub auto_training_config: AutoTrainingConfig? = None
}

