fn xml_write_upgrade_target(var w: xmlv.Writer, v: UpgradeTarget, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.engine_version {
    xmlv.elem(w, "EngineVersion", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.auto_upgrade {
    xmlv.elem(w, "AutoUpgrade", "${x}", [])
  }
  if let Some(x) = v.is_major_version_upgrade {
    xmlv.elem(w, "IsMajorVersionUpgrade", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_upgrade_target(e: xml.Element) -> UpgradeTarget ! Str {
  var out = UpgradeTarget{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Engine" => out.engine = c.text()
      "EngineVersion" => out.engine_version = c.text()
      "Description" => out.description = c.text()
      "AutoUpgrade" => out.auto_upgrade = xmlv.read_bool(c.text())?
      "IsMajorVersionUpgrade" => out.is_major_version_upgrade = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

