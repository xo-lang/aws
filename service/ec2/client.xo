fn xml_write_network_acl(var w: xmlv.Writer, v: NetworkAcl, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.associations {
    xml_write_network_acl_association_list(w, x, "associationSet", [])
  }
  if let Some(x) = v.entries {
    xml_write_network_acl_entry_list(w, x, "entrySet", [])
  }
  if let Some(x) = v.is_default {
    xmlv.elem(w, "default", "${x}", [])
  }
  if let Some(x) = v.network_acl_id {
    xmlv.elem(w, "networkAclId", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "vpcId", x, [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_network_acl(e: xml.Element) -> NetworkAcl ! Str {
  var out = NetworkAcl{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "associationSet" => out.associations = xml_read_network_acl_association_list(c)?
      "entrySet" => out.entries = xml_read_network_acl_entry_list(c)?
      "default" => out.is_default = xmlv.read_bool(c.text())?
      "networkAclId" => out.network_acl_id = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "vpcId" => out.vpc_id = c.text()
      "ownerId" => out.owner_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

