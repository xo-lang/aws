  /// A message describing the error.
  pub error_message: Str? = None
}

/// A filter that can be used when invoking a DescribeIntegrations request.
pub struct IntegrationFilter {
  /// The name of the filter.
  pub name: Str? = None
  /// A list of filter values.
  pub values: List[Str]? = None
}

/// The specified integration could not be found.
pub struct IntegrationNotFoundFault {
  /// A message describing the problem.
  pub message: Str? = None
}

/// A structure that describes how data is partitioned on the target.
pub struct IntegrationPartition {
  /// The field name used to partition data on the target. Avoid using columns
  /// that have unique values for each row (for example,
  /// `LastModifiedTimestamp`, `SystemModTimeStamp`) as the partition column.
  /// These columns are not suitable for partitioning because they create a
  /// large number of small partitions, which can lead to performance issues.
  pub field_name: Str? = None
  /// Specifies the function used to partition data on the target. The
  /// accepted values for this parameter are: identity - Uses source values
  /// directly without transformation year - Extracts the year from timestamp
  /// values (e.g., 2023) month - Extracts the month from timestamp values
  /// (e.g., 2023-01) day - Extracts the day from timestamp values (e.g.,
  /// 2023-01-15) hour - Extracts the hour from timestamp values (e.g.,
  /// 2023-01-15-14)
  pub function_spec: Str? = None
  /// Specifies the timestamp format of the source data. Valid values are:
  /// epoch_sec - Unix epoch timestamp in seconds epoch_milli - Unix epoch
  /// timestamp in milliseconds iso - ISO 8601 formatted timestamp Only
  /// specify ConversionSpec when using timestamp-based partition functions
  /// (year, month, day, or hour). Glue Zero-ETL uses this parameter to
  /// correctly transform source data into timestamp format before
  /// partitioning. Do not use high-cardinality columns with the identity
  /// partition function. High-cardinality columns include: Primary keys
  /// Timestamp fields (such as LastModifiedTimestamp , CreatedDate )
  /// System-generated timestamps Using high-cardinality columns with identity
  /// partitioning creates many small partitions, which can significantly
  /// degrade ingestion performance.
  pub conversion_spec: Str? = None
}

/// The data processed through your integration exceeded your quota.
pub struct IntegrationQuotaExceededFault {
  /// A message describing the problem.
  pub message: Str? = None
}

