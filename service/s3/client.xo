  var out = SelectObjectContentRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Bucket" => out.bucket = c.text()
      "Key" => out.key = c.text()
      "SSECustomerAlgorithm" => out.sse_customer_algorithm = c.text()
      "SSECustomerKey" => out.sse_customer_key = c.text()
      "SSECustomerKeyMD5" => out.sse_customer_key_md5 = c.text()
      "Expression" => out.expression = c.text()
      "ExpressionType" => out.expression_type = ExpressionType.from(c.text())
      "RequestProgress" => out.request_progress = xml_read_request_progress(c)?
      "InputSerialization" => out.input_serialization = xml_read_input_serialization(c)?
      "OutputSerialization" => out.output_serialization = xml_read_output_serialization(c)?
      "ScanRange" => out.scan_range = xml_read_scan_range(c)?
      "ExpectedBucketOwner" => out.expected_bucket_owner = c.text()
      _ => {}
    }
  }
  Ok(out)
}

