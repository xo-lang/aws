fn xml_write_input_and_output_with_headers_io(var w: xmlv.Writer, v: InputAndOutputWithHeadersIO, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.header_string {
    xmlv.elem(w, "headerString", x, [])
  }
  if let Some(x) = v.header_byte {
    xmlv.elem(w, "headerByte", "${x}", [])
  }
  if let Some(x) = v.header_short {
    xmlv.elem(w, "headerShort", "${x}", [])
  }
  if let Some(x) = v.header_integer {
    xmlv.elem(w, "headerInteger", "${x}", [])
  }
  if let Some(x) = v.header_long {
    xmlv.elem(w, "headerLong", "${x}", [])
  }
  if let Some(x) = v.header_float {
    xmlv.elem(w, "headerFloat", rest.float_text(x), [])
  }
  if let Some(x) = v.header_double {
    xmlv.elem(w, "headerDouble", rest.float_text(x), [])
  }
  if let Some(x) = v.header_true_bool {
    xmlv.elem(w, "headerTrueBool", "${x}", [])
  }
  if let Some(x) = v.header_false_bool {
    xmlv.elem(w, "headerFalseBool", "${x}", [])
  }
  if let Some(x) = v.header_string_list {
    xml_write_string_list(w, x, "headerStringList", [])
  }
  if let Some(x) = v.header_string_set {
    xml_write_string_set(w, x, "headerStringSet", [])
  }
  if let Some(x) = v.header_integer_list {
    xml_write_integer_list(w, x, "headerIntegerList", [])
  }
  if let Some(x) = v.header_boolean_list {
    xml_write_boolean_list(w, x, "headerBooleanList", [])
  }
  if let Some(x) = v.header_timestamp_list {
    xml_write_timestamp_list(w, x, "headerTimestampList", [])
  }
  if let Some(x) = v.header_enum {
    xmlv.elem(w, "headerEnum", x.value(), [])
  }
  if let Some(x) = v.header_enum_list {
    xml_write_foo_enum_list(w, x, "headerEnumList", [])
  }
  xmlv.end(w, name)
}

fn xml_read_input_and_output_with_headers_io(e: xml.Element) -> InputAndOutputWithHeadersIO ! Str {
  var out = InputAndOutputWithHeadersIO{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "headerString" => out.header_string = c.text()
      "headerByte" => out.header_byte = xmlv.read_int(c.text())?
      "headerShort" => out.header_short = xmlv.read_int(c.text())?
      "headerInteger" => out.header_integer = xmlv.read_int(c.text())?
      "headerLong" => out.header_long = xmlv.read_int(c.text())?
      "headerFloat" => out.header_float = xmlv.read_float(c.text())?
      "headerDouble" => out.header_double = xmlv.read_float(c.text())?
      "headerTrueBool" => out.header_true_bool = xmlv.read_bool(c.text())?
      "headerFalseBool" => out.header_false_bool = xmlv.read_bool(c.text())?
      "headerStringList" => out.header_string_list = xml_read_string_list(c)?
      "headerStringSet" => out.header_string_set = xml_read_string_set(c)?
      "headerIntegerList" => out.header_integer_list = xml_read_integer_list(c)?
      "headerBooleanList" => out.header_boolean_list = xml_read_boolean_list(c)?
      "headerTimestampList" => out.header_timestamp_list = xml_read_timestamp_list(c)?
      "headerEnum" => out.header_enum = FooEnum.from(c.text())
      "headerEnumList" => out.header_enum_list = xml_read_foo_enum_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

