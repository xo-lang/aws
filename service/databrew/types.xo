/// Configuration for data quality validation. Used to select the Rulesets
/// and Validation Mode to be used in the profile job. When
/// ValidationConfiguration is null, the profile job will run without data
/// quality validation.
pub struct ValidationConfiguration {
  /// The Amazon Resource Name (ARN) for the ruleset to be validated in the
  /// profile job. The TargetArn of the selected ruleset should be the same as
  /// the Amazon Resource Name (ARN) of the dataset that is associated with
  /// the profile job.
  pub ruleset_arn: Str? = None
  /// Mode of data quality validation. Default mode is “CHECK_ALL” which
  /// verifies all rules defined in the selected ruleset.
  pub validation_mode: ValidationMode? = None
}

/// The input parameters for this request failed validation.
pub struct ValidationException {
  pub message: Str? = None
}

pub enum ValidationMode: Str {
  CheckAll = "CHECK_ALL"
  Unknown(value: Str)
}

/// Represents the data being transformed during an action.
pub struct ViewFrame {
  /// The starting index for the range of columns to return in the view frame.
  pub start_column_index: Int? = None
  /// The number of columns to include in the view frame, beginning with the
  /// StartColumnIndex value and ignoring any columns in the HiddenColumns
  /// list.
  pub column_range: Int? = None
  /// A list of columns to hide in the view frame.
  pub hidden_columns: List[Str]? = None
  /// The starting index for the range of rows to return in the view frame.
  pub start_row_index: Int? = None
  /// The number of rows to include in the view frame, beginning with the
  /// StartRowIndex value.
  pub row_range: Int? = None
  /// Controls if analytics computation is enabled or disabled. Enabled by
  /// default.
  pub analytics: AnalyticsMode? = None
}
