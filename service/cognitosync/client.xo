pub fn (e: BulkPublishErr) display() -> Str {
  match e {
    AlreadyStreamedException(x) => "AlreadyStreamedException: ${x:?}"
    DuplicateRequestException(x) => "DuplicateRequestException: ${x:?}"
    InternalErrorException(x) => "InternalErrorException: ${x:?}"
    InvalidParameterException(x) => "InvalidParameterException: ${x:?}"
    NotAuthorizedException(x) => "NotAuthorizedException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

