pub struct StartSigningJobResponse {
  /// The ID of your signing job.
  pub job_id: Str? = None
  /// The AWS account ID of the signing job owner.
  pub job_owner: Str? = None
}

pub struct TagResourceRequest {
  /// The Amazon Resource Name (ARN) for the signing profile.
  pub resource_arn: Str? = None
  /// One or more tags to be associated with the signing profile.
  pub tags: Map[Str, Str]? = None
}

pub struct TagResourceResponse {
}

/// The request was denied due to request throttling. Instead of this error,
/// TooManyRequestsException should be used.
pub struct ThrottlingException {
  pub message: Str? = None
  pub code: Str? = None
}

/// The allowed number of job-signing requests has been exceeded. This error
/// supersedes the error ThrottlingException .
pub struct TooManyRequestsException {
  pub message: Str? = None
  pub code: Str? = None
}

pub struct UntagResourceRequest {
  /// The Amazon Resource Name (ARN) for the signing profile.
  pub resource_arn: Str? = None
  /// A list of tag keys to be removed from the signing profile.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

/// You signing certificate could not be validated.
pub struct ValidationException {
  pub message: Str? = None
  pub code: Str? = None
}

pub enum ValidityType: Str {
  Days = "DAYS"
  Months = "MONTHS"
  Years = "YEARS"
  Unknown(value: Str)
}
