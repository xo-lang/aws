fn xml_read_copy_object_request(e: xml.Element) -> CopyObjectRequest ! Str {
  var out = CopyObjectRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ACL" => out.acl = ObjectCannedACL.from(c.text())
      "Bucket" => out.bucket = c.text()
      "CacheControl" => out.cache_control = c.text()
      "ChecksumAlgorithm" => out.checksum_algorithm = ChecksumAlgorithm.from(c.text())
      "ContentDisposition" => out.content_disposition = c.text()
      "ContentEncoding" => out.content_encoding = c.text()
      "ContentLanguage" => out.content_language = c.text()
      "ContentType" => out.content_type = c.text()
      "CopySource" => out.copy_source = c.text()
      "CopySourceIfMatch" => out.copy_source_if_match = c.text()
      "CopySourceIfModifiedSince" => out.copy_source_if_modified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "CopySourceIfNoneMatch" => out.copy_source_if_none_match = c.text()
      "CopySourceIfUnmodifiedSince" => out.copy_source_if_unmodified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Expires" => out.expires = c.text()
      "GrantFullControl" => out.grant_full_control = c.text()
      "GrantRead" => out.grant_read = c.text()
      "GrantReadACP" => out.grant_read_acp = c.text()
      "GrantWriteACP" => out.grant_write_acp = c.text()
      "IfMatch" => out.if_match = c.text()
      "IfNoneMatch" => out.if_none_match = c.text()
      "Key" => out.key = c.text()
      "Metadata" => out.metadata = xml_read_metadata(c)?
      "MetadataDirective" => out.metadata_directive = MetadataDirective.from(c.text())
      "TaggingDirective" => out.tagging_directive = TaggingDirective.from(c.text())
      "AnnotationDirective" => out.annotation_directive = AnnotationDirective.from(c.text())
      "ServerSideEncryption" => out.server_side_encryption = ServerSideEncryption.from(c.text())
      "StorageClass" => out.storage_class = StorageClass.from(c.text())
      "WebsiteRedirectLocation" => out.website_redirect_location = c.text()
      "SSECustomerAlgorithm" => out.sse_customer_algorithm = c.text()
      "SSECustomerKey" => out.sse_customer_key = c.text()
      "SSECustomerKeyMD5" => out.sse_customer_key_md5 = c.text()
      "SSEKMSKeyId" => out.sse_kms_key_id = c.text()
      "SSEKMSEncryptionContext" => out.sse_kms_encryption_context = c.text()
      "BucketKeyEnabled" => out.bucket_key_enabled = xmlv.read_bool(c.text())?
      "CopySourceSSECustomerAlgorithm" => out.copy_source_sse_customer_algorithm = c.text()
      "CopySourceSSECustomerKey" => out.copy_source_sse_customer_key = c.text()
      "CopySourceSSECustomerKeyMD5" => out.copy_source_sse_customer_key_md5 = c.text()
      "RequestPayer" => out.request_payer = RequestPayer.from(c.text())
      "Tagging" => out.tagging = c.text()
      "ObjectLockMode" => out.object_lock_mode = ObjectLockMode.from(c.text())
      "ObjectLockRetainUntilDate" => out.object_lock_retain_until_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ObjectLockLegalHoldStatus" => out.object_lock_legal_hold_status = ObjectLockLegalHoldStatus.from(c.text())
      "ObjectLockEventHold" => out.object_lock_event_hold = ObjectLockEventHold.from(c.text())
      "ObjectLockEventHoldDurationDays" => out.object_lock_event_hold_duration_days = xmlv.read_int(c.text())?
      "ObjectLockEventHoldDurationYears" => out.object_lock_event_hold_duration_years = xmlv.read_int(c.text())?
      "ExpectedBucketOwner" => out.expected_bucket_owner = c.text()
      "ExpectedSourceBucketOwner" => out.expected_source_bucket_owner = c.text()
      _ => {}
    }
  }
  Ok(out)
}

