fn xml_write_cors_rule(var w: xmlv.Writer, v: CORSRule, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.id {
    xmlv.elem(w, "ID", x, [])
  }
  if let Some(x) = v.allowed_headers {
    for item in x {
      xmlv.elem(w, "AllowedHeader", item, [])
    }
  }
  if let Some(x) = v.allowed_methods {
    for item in x {
      xmlv.elem(w, "AllowedMethod", item, [])
    }
  }
  if let Some(x) = v.allowed_origins {
    for item in x {
      xmlv.elem(w, "AllowedOrigin", item, [])
    }
  }
  if let Some(x) = v.expose_headers {
    for item in x {
      xmlv.elem(w, "ExposeHeader", item, [])
    }
  }
  if let Some(x) = v.max_age_seconds {
    xmlv.elem(w, "MaxAgeSeconds", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_cors_rule(e: xml.Element) -> CORSRule ! Str {
  var out = CORSRule{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ID" => out.id = c.text()
      "AllowedHeader" => {
        var items = out.allowed_headers ?? []
        items.push(c.text())
        out.allowed_headers = items
      }
      "AllowedMethod" => {
        var items = out.allowed_methods ?? []
        items.push(c.text())
        out.allowed_methods = items
      }
      "AllowedOrigin" => {
        var items = out.allowed_origins ?? []
        items.push(c.text())
        out.allowed_origins = items
      }
      "ExposeHeader" => {
        var items = out.expose_headers ?? []
        items.push(c.text())
        out.expose_headers = items
      }
      "MaxAgeSeconds" => out.max_age_seconds = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

