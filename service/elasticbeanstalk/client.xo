fn xml_write_validation_message(var w: xmlv.Writer, v: ValidationMessage, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.message {
    xmlv.elem(w, "Message", x, [])
  }
  if let Some(x) = v.severity {
    xmlv.elem(w, "Severity", x.value(), [])
  }
  if let Some(x) = v.namespace {
    xmlv.elem(w, "Namespace", x, [])
  }
  if let Some(x) = v.option_name {
    xmlv.elem(w, "OptionName", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_validation_message(e: xml.Element) -> ValidationMessage ! Str {
  var out = ValidationMessage{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Message" => out.message = c.text()
      "Severity" => out.severity = ValidationSeverity.from(c.text())
      "Namespace" => out.namespace = c.text()
      "OptionName" => out.option_name = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_validation_messages_list(var w: xmlv.Writer, v: List[ValidationMessage], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_validation_message(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_validation_messages_list(e: xml.Element) -> List[ValidationMessage] ! Str {
  var out: List[ValidationMessage] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_validation_message(c)?)
  }
  Ok(out)
}

