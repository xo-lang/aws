  p.first || p.more
}

pub fn (var p: ListTrustedTokenIssuersPaginator) next_page() -> ListTrustedTokenIssuersResponse ! ListTrustedTokenIssuersErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_trusted_token_issuers(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
