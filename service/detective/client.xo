pub fn (c: Client) update_organization_configuration(input: UpdateOrganizationConfigurationRequest) -> () ! UpdateOrganizationConfigurationErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_organization_configuration(c.params, input)) ?? e => return Err(UpdateOrganizationConfigurationErr.InvalidInput(e))
  var req = serialize_update_organization_configuration(ep, input, "") ?? e => return Err(UpdateOrganizationConfigurationErr.InvalidInput(e))
  for h in extra {
