test "a session cache keeps the longer lived entry and drops one near expiry" {
  let c = new_session_cache()
  let t0 = Time.from_unix(1000)
  let short = Credentials{access_key_id: "A", secret_access_key: Secret.new("s"), expires: Time.from_unix(1100)}
  let long = Credentials{access_key_id: "B", secret_access_key: Secret.new("s"), expires: Time.from_unix(1300)}
  expect(c.put("k", long).access_key_id) == "B"
  expect(c.put("k", short).access_key_id) == "B"
  expect(c.get("k", t0, 1m).map(fn(x: Credentials) -> Str { x.access_key_id })) == Some("B")
  // within a minute of expiry it is not returned
  expect(c.get("k", Time.from_unix(1250), 1m).is_none()) == true
  expect(c.get("other", t0, 1m).is_none()) == true
}
