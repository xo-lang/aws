    xmlv.elem(w, "UserId", x, [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "Arn", x, [])
  }
  if let Some(x) = v.create_date {
    xmlv.elem(w, "CreateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.user_policy_list {
    xml_write_policy_detail_list_type(w, x, "UserPolicyList", [])
  }
  if let Some(x) = v.group_list {
    xml_write_group_name_list_type(w, x, "GroupList", [])
  }
  if let Some(x) = v.attached_managed_policies {
    xml_write_attached_policies_list_type(w, x, "AttachedManagedPolicies", [])
  }
  if let Some(x) = v.permissions_boundary {
    xml_write_attached_permissions_boundary(w, x, "PermissionsBoundary", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list_type(w, x, "Tags", [])
  }
  xmlv.end(w, name)
}

fn xml_read_user_detail(e: xml.Element) -> UserDetail ! Str {
  var out = UserDetail{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Path" => out.path = c.text()
      "UserName" => out.user_name = c.text()
      "UserId" => out.user_id = c.text()
      "Arn" => out.arn = c.text()
      "CreateDate" => out.create_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UserPolicyList" => out.user_policy_list = xml_read_policy_detail_list_type(c)?
      "GroupList" => out.group_list = xml_read_group_name_list_type(c)?
      "AttachedManagedPolicies" => out.attached_managed_policies = xml_read_attached_policies_list_type(c)?
      "PermissionsBoundary" => out.permissions_boundary = xml_read_attached_permissions_boundary(c)?
      "Tags" => out.tags = xml_read_tag_list_type(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_virtual_mfa_device(var w: xmlv.Writer, v: VirtualMFADevice, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.serial_number {
    xmlv.elem(w, "SerialNumber", x, [])
  }
  if let Some(x) = v.base32_string_seed {
    xmlv.elem(w, "Base32StringSeed", x.to_base64(), [])
  }
  if let Some(x) = v.qr_code_png {
    xmlv.elem(w, "QRCodePNG", x.to_base64(), [])
  }
  if let Some(x) = v.user {
    xml_write_user(w, x, "User", [])
  }
  if let Some(x) = v.enable_date {
    xmlv.elem(w, "EnableDate", rest.date_time(x), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list_type(w, x, "Tags", [])
  }
  xmlv.end(w, name)
}

fn xml_read_virtual_mfa_device(e: xml.Element) -> VirtualMFADevice ! Str {
  var out = VirtualMFADevice{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "SerialNumber" => out.serial_number = c.text()
      "Base32StringSeed" => out.base32_string_seed = xmlv.read_blob(c.text())?
      "QRCodePNG" => out.qr_code_png = xmlv.read_blob(c.text())?
      "User" => out.user = xml_read_user(c)?
      "EnableDate" => out.enable_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Tags" => out.tags = xml_read_tag_list_type(c)?
      _ => {}
    }
  }
  Ok(out)
}

