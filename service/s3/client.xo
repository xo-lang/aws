  }
  if let Some(x) = v.checksum {
    xml_write_checksum(w, x, "Checksum", [])
  }
  if let Some(x) = v.object_parts {
    xml_write_get_object_attributes_parts(w, x, "ObjectParts", [])
  }
  if let Some(x) = v.storage_class {
    xmlv.elem(w, "StorageClass", x.value(), [])
  }
  if let Some(x) = v.object_size {
    xmlv.elem(w, "ObjectSize", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_get_object_attributes_output(e: xml.Element) -> GetObjectAttributesOutput ! Str {
  var out = GetObjectAttributesOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DeleteMarker" => out.delete_marker = xmlv.read_bool(c.text())?
      "LastModified" => out.last_modified = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "VersionId" => out.version_id = c.text()
      "RequestCharged" => out.request_charged = RequestCharged.from(c.text())
      "ETag" => out.e_tag = c.text()
      "Checksum" => out.checksum = xml_read_checksum(c)?
      "ObjectParts" => out.object_parts = xml_read_get_object_attributes_parts(c)?
      "StorageClass" => out.storage_class = StorageClass.from(c.text())
      "ObjectSize" => out.object_size = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_get_object_attributes_parts(var w: xmlv.Writer, v: GetObjectAttributesParts, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.total_parts_count {
    xmlv.elem(w, "PartsCount", "${x}", [])
  }
  if let Some(x) = v.part_number_marker {
    xmlv.elem(w, "PartNumberMarker", x, [])
  }
  if let Some(x) = v.next_part_number_marker {
    xmlv.elem(w, "NextPartNumberMarker", x, [])
  }
  if let Some(x) = v.max_parts {
    xmlv.elem(w, "MaxParts", "${x}", [])
  }
  if let Some(x) = v.is_truncated {
    xmlv.elem(w, "IsTruncated", "${x}", [])
  }
  if let Some(x) = v.parts {
    for item in x {
      xml_write_object_part(w, item, "Part", [])
    }
  }
  xmlv.end(w, name)
}

fn xml_read_get_object_attributes_parts(e: xml.Element) -> GetObjectAttributesParts ! Str {
  var out = GetObjectAttributesParts{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "PartsCount" => out.total_parts_count = xmlv.read_int(c.text())?
      "PartNumberMarker" => out.part_number_marker = c.text()
      "NextPartNumberMarker" => out.next_part_number_marker = c.text()
      "MaxParts" => out.max_parts = xmlv.read_int(c.text())?
      "IsTruncated" => out.is_truncated = xmlv.read_bool(c.text())?
      "Part" => {
        var items = out.parts ?? []
        items.push(xml_read_object_part(c)?)
        out.parts = items
      }
      _ => {}
    }
  }
  Ok(out)
}

