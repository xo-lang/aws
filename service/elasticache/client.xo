fn xml_write_describe_events_message(var w: xmlv.Writer, v: DescribeEventsMessage, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.source_identifier {
    xmlv.elem(w, "SourceIdentifier", x, [])
  }
  if let Some(x) = v.source_type {
    xmlv.elem(w, "SourceType", x.value(), [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "StartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.end_time {
    xmlv.elem(w, "EndTime", rest.date_time(x), [])
  }
  if let Some(x) = v.duration {
    xmlv.elem(w, "Duration", "${x}", [])
  }
  if let Some(x) = v.max_records {
    xmlv.elem(w, "MaxRecords", "${x}", [])
  }
  if let Some(x) = v.marker {
    xmlv.elem(w, "Marker", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_describe_events_message(e: xml.Element) -> DescribeEventsMessage ! Str {
  var out = DescribeEventsMessage{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "SourceIdentifier" => out.source_identifier = c.text()
      "SourceType" => out.source_type = SourceType.from(c.text())
      "StartTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EndTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Duration" => out.duration = xmlv.read_int(c.text())?
      "MaxRecords" => out.max_records = xmlv.read_int(c.text())?
      "Marker" => out.marker = c.text()
      _ => {}
    }
  }
  Ok(out)
}

