      "key" => out.key = jsonv.read_str(fv)?
      "lastModified" => out.last_modified = jsonv.read_time(fv, "date-time")?
      "path" => out.path = jsonv.read_str(fv)?
      "publicAccess" => out.public_access = jsonv.read_bool(fv)?
      "serverSideEncryption" => out.server_side_encryption = from_json_server_side_encryption(fv)?
      "size" => out.size = jsonv.read_int(fv)?
      "storageClass" => out.storage_class = StorageClass.from(jsonv.read_str(fv)?)
      "tags" => out.tags = from_json_key_value_pair_list(fv)?
      "versionId" => out.version_id = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

