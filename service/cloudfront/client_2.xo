  var out = TrustStore{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Id" => out.id = c.text()
      "Arn" => out.arn = c.text()
      "Name" => out.name = c.text()
      "Status" => out.status = TrustStoreStatus.from(c.text())
      "NumberOfCaCertificates" => out.number_of_ca_certificates = xmlv.read_int(c.text())?
      "LastModifiedTime" => out.last_modified_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Reason" => out.reason = c.text()
      "UseClientCertificateOCSPEndpoint" => out.use_client_certificate_ocsp_endpoint = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

