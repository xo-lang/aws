  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "userToken" => Ok(UserIdentifier.UserToken(jsonv.read_str(fv)?))
      "userId" => Ok(UserIdentifier.UserId(jsonv.read_str(fv)?))
      _ => Ok(UserIdentifier.Unknown(k))
    }
  }
  Err("UserIdentifier: no member set")
}

