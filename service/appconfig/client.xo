pub fn (e: ValidateConfigurationErr) display() -> Str {
  match e {
    BadRequestException(x) => "BadRequestException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_validate_configuration_error(resp: http.Response) -> ValidateConfigurationErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "BadRequestException" => match read_error_bad_request_exception(resp, body) {
      Ok(x) => return ValidateConfigurationErr.BadRequestException(x)
      Err(msg) => return ValidateConfigurationErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return ValidateConfigurationErr.InternalServerException(x)
      Err(msg) => return ValidateConfigurationErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return ValidateConfigurationErr.ResourceNotFoundException(x)
      Err(msg) => return ValidateConfigurationErr.Deserialize(msg)
    }
    _ => {}
  }
  ValidateConfigurationErr.Api(restjson.api_error(resp, body))
}

/// Uses the validators in a configuration profile to validate a
/// configuration.
pub fn (c: Client) validate_configuration(input: ValidateConfigurationRequest) -> () ! ValidateConfigurationErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_validate_configuration(c.params, input)) ?? e => return Err(ValidateConfigurationErr.InvalidInput(e))
  var req = serialize_validate_configuration(ep, input, "") ?? e => return Err(ValidateConfigurationErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(ValidateConfigurationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_validate_configuration_error(resp))
  }
  deserialize_validate_configuration(resp) ?? e => Err(ValidateConfigurationErr.Deserialize(e))
}
