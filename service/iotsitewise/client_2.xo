/// The events of InvokeAssistant, read as they arrive. `output` has the
/// response's other members; close the stream when done with it.
pub struct InvokeAssistantEvents {
  pub output: InvokeAssistantResponse
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
}

/// The next event, None at the end of the stream.
pub fn (var s: InvokeAssistantEvents) next() -> ResponseStream? ! ResponseStreamErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(ResponseStreamErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              continue
            }
            return match event_response_stream(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(ResponseStreamErr.Read(msg))
            }
          }
          "exception" => return Err(exception_response_stream(m))
          _ => return Err(ResponseStreamErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(ResponseStreamErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(ResponseStreamErr.Read(e.display()))
          }
        }
      }
    }
  }
  Ok(None)
}

/// Stops reading the stream.
pub fn (var s: InvokeAssistantEvents) close() {
  if !s.done {
    s.done = true
    s.body.close()
  }
}

/// Why reading a ResponseStream stream stopped.
pub enum ResponseStreamErr {
  AccessDeniedException(e: AccessDeniedException)
  ConflictingOperationException(e: ConflictingOperationException)
  InternalFailureException(e: InternalFailureException)
  InvalidRequestException(e: InvalidRequestException)
  LimitExceededException(e: LimitExceededException)
  ResourceNotFoundException(e: ResourceNotFoundException)
  ThrottlingException(e: ThrottlingException)
  /// An error message, or an exception the model does not list.
  Api(e: aws.ApiError)
  /// The body could not be read or is not event stream messages.
  Read(msg: Str)
}

pub fn (e: ResponseStreamErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    ConflictingOperationException(x) => "ConflictingOperationException: ${x:?}"
    InternalFailureException(x) => "InternalFailureException: ${x:?}"
    InvalidRequestException(x) => "InvalidRequestException: ${x:?}"
    LimitExceededException(x) => "LimitExceededException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    Api(x) => x.display()
    Read(msg) => "event stream: ${msg}"
  }
}

fn event_response_stream(t: Str, m: eventstream.Message) -> ResponseStream ! Str {
  match t {
    "trace" => Ok(ResponseStream.Trace(event_read_trace(m)?))
    "output" => Ok(ResponseStream.Output(event_read_invocation_output(m)?))
    _ => Ok(ResponseStream.Unknown(t))
  }
}

fn exception_response_stream(m: eventstream.Message) -> ResponseStreamErr {
  let t = m.header_str(":exception-type")
  match t {
    "accessDeniedException" => match exception_read_access_denied_exception(m.payload) {
      Ok(x) => ResponseStreamErr.AccessDeniedException(x)
      Err(msg) => ResponseStreamErr.Read(msg)
    }
    "conflictingOperationException" => match exception_read_conflicting_operation_exception(m.payload) {
      Ok(x) => ResponseStreamErr.ConflictingOperationException(x)
      Err(msg) => ResponseStreamErr.Read(msg)
    }
    "internalFailureException" => match exception_read_internal_failure_exception(m.payload) {
      Ok(x) => ResponseStreamErr.InternalFailureException(x)
      Err(msg) => ResponseStreamErr.Read(msg)
    }
    "invalidRequestException" => match exception_read_invalid_request_exception(m.payload) {
      Ok(x) => ResponseStreamErr.InvalidRequestException(x)
      Err(msg) => ResponseStreamErr.Read(msg)
    }
    "limitExceededException" => match exception_read_limit_exceeded_exception(m.payload) {
      Ok(x) => ResponseStreamErr.LimitExceededException(x)
      Err(msg) => ResponseStreamErr.Read(msg)
    }
    "resourceNotFoundException" => match exception_read_resource_not_found_exception(m.payload) {
      Ok(x) => ResponseStreamErr.ResourceNotFoundException(x)
      Err(msg) => ResponseStreamErr.Read(msg)
    }
    "throttlingException" => match exception_read_throttling_exception(m.payload) {
      Ok(x) => ResponseStreamErr.ThrottlingException(x)
      Err(msg) => ResponseStreamErr.Read(msg)
    }
    _ => ResponseStreamErr.Api(aws.ApiError{code: t, message: m.payload.to_str() ?? ""})
  }
}

fn exception_read_access_denied_exception(b: Bytes) -> AccessDeniedException ! Str {
  Ok(from_json_access_denied_exception(jsonv.parse_body(b)?)?)
}

fn exception_read_conflicting_operation_exception(b: Bytes) -> ConflictingOperationException ! Str {
