  /// Allow Hov (High Occupancy vehicle) lanes while calculating the route.
  /// Default value: false
  pub hov: Bool? = None
}

/// AutoCircle requests the route matrix service to define a Circle boundary
/// that best attempts to include most waypoints ( Origins and Destinations
/// ) using the AutoCircle settings. Any waypoints outside of the
/// auto-defined Circle boundary will be considered out of the routing
/// boundary, which results in a route matrix entry error. AutoCircle is
/// only used in the request to configure a Circle for the route
/// calculation. The derived Circle will also be provided in the response.
pub struct RouteMatrixAutoCircle {
  /// The minimal distance, in meters, between any waypoint and the perimeter
  /// of the circle auto-defined for the boundary. Some margin is usually
  /// recommended so that the routing has enough leeway to travel from one
  /// waypoint to another optimally without conflicting with the routing
  /// boundary. The total of MaxRadius and Margin must be less than or equal
  /// to 200,000 meters.
  pub margin: Int? = None
  /// The maximum radius, in meters, that the auto-defined Circle boundary
  /// should have, before the Margin distance is added to the circle. The
  /// total of MaxRadius and Margin must be less than or equal to 200,000
  /// meters.
  pub max_radius: Int? = None
}

/// Area to be avoided.
pub struct RouteMatrixAvoidanceArea {
  /// Geometry of the area to be avoided.
  pub geometry: RouteMatrixAvoidanceAreaGeometry? = None
}

/// Geometry of the area to be avoided.
pub struct RouteMatrixAvoidanceAreaGeometry {
  /// Geometry defined as a bounding box. The first pair represents the X and
  /// Y coordinates (longitude and latitude,) of the southwest corner of the
  /// bounding box; the second pair represents the X and Y coordinates
  /// (longitude and latitude) of the northeast corner.
  pub bounding_box: List[Float]? = None
  /// Geometry defined as a polygon with only one linear ring.
  pub polygon: List[List[List[Float]]]? = None
  /// A list of Isoline PolylinePolygon, for each isoline PolylinePolygon, it
  /// contains PolylinePolygon of the first linear ring (the outer ring) and
  /// from second item to the last item (the inner rings). For more
  /// information on polyline encoding, see
  /// https://github.com/aws-geospatial/polyline .
  pub polyline_polygon: List[Str]? = None
}

/// Specifies options for areas to avoid when calculating the route. This is
/// a best-effort avoidance setting, meaning the router will try to honor
/// the avoidance preferences but may still include restricted areas if no
/// feasible alternative route exists. If avoidance options are not
/// followed, the response will indicate that the avoidance criteria were
/// violated.
pub struct RouteMatrixAvoidanceOptions {
  /// Areas to be avoided.
  pub areas: List[RouteMatrixAvoidanceArea]? = None
  /// Avoid car-shuttle-trains while calculating the route.
  pub car_shuttle_trains: Bool? = None
  /// Avoid controlled access highways while calculating the route.
  pub controlled_access_highways: Bool? = None
  /// Avoid dirt roads while calculating the route.
  pub dirt_roads: Bool? = None
  /// Avoid ferries while calculating the route.
  pub ferries: Bool? = None
  /// Avoids roads where the specified toll transponders are the only mode of
  /// payment.
  pub toll_roads: Bool? = None
  /// Avoids roads where the specified toll transponders are the only mode of
  /// payment.
  pub toll_transponders: Bool? = None
  /// Truck road type identifiers. BK1 through BK4 apply only to Sweden.
  /// A2,A4,B2,B4,C,D,ET2,ET4 apply only to Mexico. There are currently no
  /// other supported values as of 26th April 2024.
  pub truck_road_types: List[Str]? = None
  /// Avoid tunnels while calculating the route.
  pub tunnels: Bool? = None
  /// Avoid U-turns for calculation on highways and motorways.
  pub u_turns: Bool? = None
  /// Zone categories to be avoided.
  pub zone_categories: List[RouteMatrixAvoidanceZoneCategory]? = None
}

/// Zone categories to be avoided.
pub struct RouteMatrixAvoidanceZoneCategory {
  /// Zone category to be avoided.
  pub category: RouteMatrixZoneCategory? = None
}

/// Boundary within which the matrix is to be calculated. All data, origins
/// and destinations outside the boundary are considered invalid.
pub struct RouteMatrixBoundary {
  /// Geometry of the area to be avoided.
  pub geometry: RouteMatrixBoundaryGeometry? = None
  /// No restrictions in terms of a routing boundary, and is typically used
  /// for longer routes.
  pub unbounded: Bool? = None
}

/// Geometry of the routing boundary.
pub struct RouteMatrixBoundaryGeometry {
  /// AutoCircle requests the route matrix service to define a Circle boundary
  /// that best attempts to include most waypoints ( Origins and Destinations
  /// ) using the AutoCircle settings. Any waypoints outside of the
  /// auto-defined Circle boundary will be considered out of the routing
  /// boundary, which results in a route matrix entry error. AutoCircle is
  /// only used in the request to configure a Circle for the route
  /// calculation. The derived Circle will also be provided in the response.
  pub auto_circle: RouteMatrixAutoCircle? = None
  /// Geometry defined as a circle. The circle defines the routing boundary
  /// area. Any waypoints outside the circle will result in a route matrix
  /// entry error. You can specify a Circle directly in the request, or it
  /// will be auto-derived when AutoCircle is used. When AutoCircle is set in
  /// the request, the response routing boundary will return Circle derived
  /// from the AutoCircle settings.
  pub circle: Circle? = None
  /// Geometry defined as a bounding box. The first pair represents the X and
  /// Y coordinates (longitude and latitude,) of the southwest corner of the
  /// bounding box; the second pair represents the X and Y coordinates
  /// (longitude and latitude) of the northeast corner. Diagonal distance of
  /// the bounding box must be less than or equal to 400,000 meters.
  pub bounding_box: List[Float]? = None
  /// Geometry defined as a polygon with only one linear ring. A linear ring
  /// is a closed sequence of four or more coordinates. The first and last
  /// coordinates are the same, forming a closed boundary. Each coordinate is
  /// a position in [longitude, latitude] format. The structure is an array of
  /// linear rings (only 1 allowed). Each linear ring is an array of
  /// coordinates (minimum 4), and each coordinate is an array of two doubles
  /// [longitude, latitude]. Maximum distance between any two vertices must be
  /// less than or equal to 400,000 meters.
  pub polygon: List[List[List[Float]]]? = None
}

