fn jmes_of_router_input(v: RouterInput) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.state {
    fs.push(("State", json.Value.Str(x.value())))
  }
  if let Some(x) = v.input_type {
    fs.push(("InputType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.configuration {
    fs.push(("Configuration", jmes_of_router_input_configuration(x)))
  }
  if let Some(x) = v.routed_outputs {
    fs.push(("RoutedOutputs", json.Value.Int(x)))
  }
  if let Some(x) = v.maximum_routed_outputs {
    fs.push(("MaximumRoutedOutputs", json.Value.Int(x)))
  }
  if let Some(x) = v.region_name {
    fs.push(("RegionName", json.Value.Str(x)))
  }
  if let Some(x) = v.availability_zone {
    fs.push(("AvailabilityZone", json.Value.Str(x)))
  }
  if let Some(x) = v.maximum_bitrate {
    fs.push(("MaximumBitrate", json.Value.Int(x)))
  }
  if let Some(x) = v.tier {
    fs.push(("Tier", json.Value.Str(x.value())))
  }
  if let Some(x) = v.routing_scope {
    fs.push(("RoutingScope", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("UpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.messages {
    fs.push(("Messages", jmes_of_router_input_messages(x)))
  }
  if let Some(x) = v.transit_encryption {
    fs.push(("TransitEncryption", jmes_of_router_input_transit_encryption(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", jmes_of_map_of_string(x)))
  }
  if let Some(x) = v.stream_details {
    fs.push(("StreamDetails", jmes_of_router_input_stream_details(x)))
  }
  if let Some(x) = v.ip_address {
    fs.push(("IpAddress", json.Value.Str(x)))
  }
  if let Some(x) = v.maintenance_type {
    fs.push(("MaintenanceType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.maintenance_configuration {
    fs.push(("MaintenanceConfiguration", jmes_of_maintenance_configuration(x)))
  }
  if let Some(x) = v.maintenance_schedule_type {
    fs.push(("MaintenanceScheduleType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.maintenance_schedule {
    fs.push(("MaintenanceSchedule", jmes_of_maintenance_schedule(x)))
  }
  if let Some(x) = v.content_quality_analysis_type {
    fs.push(("ContentQualityAnalysisType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.content_quality_analysis_configuration {
