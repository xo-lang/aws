fn xml_write_xml_namespace_nested(var w: xmlv.Writer, v: XmlNamespaceNested, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.foo {
    xmlv.elem(w, "foo", x, [("xmlns:baz", "http://baz.com")])
  }
  if let Some(x) = v.values {
    xml_write_xml_namespaced_list(w, x, "values", [("xmlns", "http://qux.com")])
  }
  xmlv.end(w, name)
}

