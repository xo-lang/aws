fn xml_read_node_group_member_update_status(e: xml.Element) -> NodeGroupMemberUpdateStatus ! Str {
  var out = NodeGroupMemberUpdateStatus{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "CacheClusterId" => out.cache_cluster_id = c.text()
      "CacheNodeId" => out.cache_node_id = c.text()
      "NodeUpdateStatus" => out.node_update_status = NodeUpdateStatus.from(c.text())
      "NodeDeletionDate" => out.node_deletion_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "NodeUpdateStartDate" => out.node_update_start_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "NodeUpdateEndDate" => out.node_update_end_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "NodeUpdateInitiatedBy" => out.node_update_initiated_by = NodeUpdateInitiatedBy.from(c.text())
      "NodeUpdateInitiatedDate" => out.node_update_initiated_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "NodeUpdateStatusModifiedDate" => out.node_update_status_modified_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

