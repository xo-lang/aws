fn json_of_fulfillment_option(v: FulfillmentOption) -> json.Value {
  match v {
    AmazonMachineImageFulfillmentOption(x) => json.Value.Object([("amazonMachineImageFulfillmentOption", json_of_amazon_machine_image_fulfillment_option(x))])
    ApiFulfillmentOption(x) => json.Value.Object([("apiFulfillmentOption", json_of_api_fulfillment_option(x))])
    CloudFormationFulfillmentOption(x) => json.Value.Object([("cloudFormationFulfillmentOption", json_of_cloud_formation_fulfillment_option(x))])
    ContainerFulfillmentOption(x) => json.Value.Object([("containerFulfillmentOption", json_of_container_fulfillment_option(x))])
    HelmFulfillmentOption(x) => json.Value.Object([("helmFulfillmentOption", json_of_helm_fulfillment_option(x))])
    EksAddOnFulfillmentOption(x) => json.Value.Object([("eksAddOnFulfillmentOption", json_of_eks_add_on_fulfillment_option(x))])
    Ec2ImageBuilderComponentFulfillmentOption(x) => json.Value.Object([("ec2ImageBuilderComponentFulfillmentOption", json_of_ec2_image_builder_component_fulfillment_option(x))])
    DataExchangeFulfillmentOption(x) => json.Value.Object([("dataExchangeFulfillmentOption", json_of_data_exchange_fulfillment_option(x))])
    ProfessionalServicesFulfillmentOption(x) => json.Value.Object([("professionalServicesFulfillmentOption", json_of_professional_services_fulfillment_option(x))])
    SaasFulfillmentOption(x) => json.Value.Object([("saasFulfillmentOption", json_of_saas_fulfillment_option(x))])
    SageMakerAlgorithmFulfillmentOption(x) => json.Value.Object([("sageMakerAlgorithmFulfillmentOption", json_of_sage_maker_algorithm_fulfillment_option(x))])
    SageMakerModelFulfillmentOption(x) => json.Value.Object([("sageMakerModelFulfillmentOption", json_of_sage_maker_model_fulfillment_option(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_fulfillment_option(v: json.Value) -> FulfillmentOption ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "amazonMachineImageFulfillmentOption" => Ok(FulfillmentOption.AmazonMachineImageFulfillmentOption(from_json_amazon_machine_image_fulfillment_option(fv)?))
      "apiFulfillmentOption" => Ok(FulfillmentOption.ApiFulfillmentOption(from_json_api_fulfillment_option(fv)?))
      "cloudFormationFulfillmentOption" => Ok(FulfillmentOption.CloudFormationFulfillmentOption(from_json_cloud_formation_fulfillment_option(fv)?))
      "containerFulfillmentOption" => Ok(FulfillmentOption.ContainerFulfillmentOption(from_json_container_fulfillment_option(fv)?))
      "helmFulfillmentOption" => Ok(FulfillmentOption.HelmFulfillmentOption(from_json_helm_fulfillment_option(fv)?))
      "eksAddOnFulfillmentOption" => Ok(FulfillmentOption.EksAddOnFulfillmentOption(from_json_eks_add_on_fulfillment_option(fv)?))
      "ec2ImageBuilderComponentFulfillmentOption" => Ok(FulfillmentOption.Ec2ImageBuilderComponentFulfillmentOption(from_json_ec2_image_builder_component_fulfillment_option(fv)?))
      "dataExchangeFulfillmentOption" => Ok(FulfillmentOption.DataExchangeFulfillmentOption(from_json_data_exchange_fulfillment_option(fv)?))
      "professionalServicesFulfillmentOption" => Ok(FulfillmentOption.ProfessionalServicesFulfillmentOption(from_json_professional_services_fulfillment_option(fv)?))
      "saasFulfillmentOption" => Ok(FulfillmentOption.SaasFulfillmentOption(from_json_saas_fulfillment_option(fv)?))
      "sageMakerAlgorithmFulfillmentOption" => Ok(FulfillmentOption.SageMakerAlgorithmFulfillmentOption(from_json_sage_maker_algorithm_fulfillment_option(fv)?))
      "sageMakerModelFulfillmentOption" => Ok(FulfillmentOption.SageMakerModelFulfillmentOption(from_json_sage_maker_model_fulfillment_option(fv)?))
      _ => Ok(FulfillmentOption.Unknown(k))
    }
  }
  Err("FulfillmentOption: no member set")
}

