  pub publish_cloud_watch_metrics_enabled: Bool? = None
  /// The upper data usage limit (cutoff) for the amount of bytes a single
  /// query in a workgroup is allowed to scan.
  pub bytes_scanned_cutoff_per_query: Int? = None
  /// If set to true , allows members assigned to a workgroup to reference
  /// Amazon S3 Requester Pays buckets in queries. If set to false , workgroup
  /// members cannot query data from Requester Pays buckets, and queries that
  /// retrieve data from Requester Pays buckets cause an error. The default is
  /// false . For more information about Requester Pays buckets, see Requester
  /// Pays Buckets in the Amazon Simple Storage Service Developer Guide .
  pub requester_pays_enabled: Bool? = None
  /// The engine version that all queries running on the workgroup use.
  /// Queries on the AmazonAthenaPreviewFunctionality workgroup run on the
  /// preview engine regardless of this setting.
  pub engine_version: EngineVersion? = None
  /// Specifies a user defined JSON string that is passed to the notebook
  /// engine.
  pub additional_configuration: Str? = None
  /// The ARN of the execution role used to access user resources for Spark
  /// sessions and IAM Identity Center enabled workgroups. This property
  /// applies only to Spark enabled workgroups and IAM Identity Center enabled
  /// workgroups. The property is required for IAM Identity Center enabled
  /// workgroups.
  pub execution_role: Str? = None
  /// Contains the configuration settings for managed log persistence,
  /// delivering logs to Amazon S3 buckets, Amazon CloudWatch log groups etc.
  pub monitoring_configuration: MonitoringConfiguration? = None
  pub engine_configuration: EngineConfiguration? = None
  /// Specifies the KMS key that is used to encrypt the user's data stores in
  /// Athena. This setting does not apply to Athena SQL workgroups.
  pub customer_content_encryption_configuration: CustomerContentEncryptionConfiguration? = None
  /// Enforces a minimal level of encryption for the workgroup for query and
  /// calculation results that are written to Amazon S3. When enabled,
  /// workgroup users can set encryption only to the minimum level set by the
  /// administrator or higher when they submit queries. The
  /// EnforceWorkGroupConfiguration setting takes precedence over the
  /// EnableMinimumEncryptionConfiguration flag. This means that if
  /// EnforceWorkGroupConfiguration is true, the
  /// EnableMinimumEncryptionConfiguration flag is ignored, and the workgroup
  /// configuration for encryption is used.
  pub enable_minimum_encryption_configuration: Bool? = None
  /// Specifies whether the workgroup is IAM Identity Center supported.
  pub identity_center_configuration: IdentityCenterConfiguration? = None
  /// Specifies whether Amazon S3 access grants are enabled for query results.
  pub query_results_s3_access_grants_configuration: QueryResultsS3AccessGrantsConfiguration? = None
}

/// The configuration information that will be updated for this workgroup,
/// which includes the location in Amazon S3 where query and calculation
/// results are stored, the encryption option, if any, used for query
/// results, whether the Amazon CloudWatch Metrics are enabled for the
/// workgroup, whether the workgroup settings override the client-side
/// settings, and the data usage limit for the amount of bytes scanned per
/// query, if it is specified.
pub struct WorkGroupConfigurationUpdates {
  /// If set to "true", the settings for the workgroup override client-side
  /// settings. If set to "false" client-side settings are used. For more
  /// information, see Workgroup Settings Override Client-Side Settings .
  pub enforce_work_group_configuration: Bool? = None
  /// The result configuration information about the queries in this workgroup
  /// that will be updated. Includes the updated results location and an
  /// updated option for encrypting query results.
  pub result_configuration_updates: ResultConfigurationUpdates? = None
  /// Updates configuration information for managed query results in the
  /// workgroup.
  pub managed_query_results_configuration_updates: ManagedQueryResultsConfigurationUpdates? = None
  /// Indicates whether this workgroup enables publishing metrics to Amazon
  /// CloudWatch.
  pub publish_cloud_watch_metrics_enabled: Bool? = None
  /// The upper limit (cutoff) for the amount of bytes a single query in a
  /// workgroup is allowed to scan.
  pub bytes_scanned_cutoff_per_query: Int? = None
  /// Indicates that the data usage control limit per query is removed.
  /// WorkGroupConfiguration$BytesScannedCutoffPerQuery
  pub remove_bytes_scanned_cutoff_per_query: Bool? = None
  /// If set to true , allows members assigned to a workgroup to specify
  /// Amazon S3 Requester Pays buckets in queries. If set to false , workgroup
  /// members cannot query data from Requester Pays buckets, and queries that
  /// retrieve data from Requester Pays buckets cause an error. The default is
  /// false . For more information about Requester Pays buckets, see Requester
  /// Pays Buckets in the Amazon Simple Storage Service Developer Guide .
  pub requester_pays_enabled: Bool? = None
  /// The engine version requested when a workgroup is updated. After the
  /// update, all queries on the workgroup run on the requested engine
  /// version. If no value was previously set, the default is Auto. Queries on
  /// the AmazonAthenaPreviewFunctionality workgroup run on the preview engine
  /// regardless of this setting.
  pub engine_version: EngineVersion? = None
  /// Removes content encryption configuration from an Apache Spark-enabled
  /// Athena workgroup.
  pub remove_customer_content_encryption_configuration: Bool? = None
  /// Contains a user defined string in JSON format for a Spark-enabled
  /// workgroup.
  pub additional_configuration: Str? = None
  /// The ARN of the execution role used to access user resources for Spark
  /// sessions and Identity Center enabled workgroups. This property applies
  /// only to Spark enabled workgroups and Identity Center enabled workgroups.
  pub execution_role: Str? = None
  pub customer_content_encryption_configuration: CustomerContentEncryptionConfiguration? = None
  /// Enforces a minimal level of encryption for the workgroup for query and
  /// calculation results that are written to Amazon S3. When enabled,
  /// workgroup users can set encryption only to the minimum level set by the
  /// administrator or higher when they submit queries. This setting does not
  /// apply to Spark-enabled workgroups. The EnforceWorkGroupConfiguration
  /// setting takes precedence over the EnableMinimumEncryptionConfiguration
  /// flag. This means that if EnforceWorkGroupConfiguration is true, the
  /// EnableMinimumEncryptionConfiguration flag is ignored, and the workgroup
  /// configuration for encryption is used.
  pub enable_minimum_encryption_configuration: Bool? = None
  /// Specifies whether Amazon S3 access grants are enabled for query results.
  pub query_results_s3_access_grants_configuration: QueryResultsS3AccessGrantsConfiguration? = None
  /// Contains the configuration settings for managed log persistence,
  /// delivering logs to Amazon S3 buckets, Amazon CloudWatch log groups etc.
  pub monitoring_configuration: MonitoringConfiguration? = None
  pub engine_configuration: EngineConfiguration? = None
}

pub enum WorkGroupState: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// The summary information for the workgroup, which includes its name,
/// state, description, and the date and time it was created.
pub struct WorkGroupSummary {
  /// The name of the workgroup.
  pub name: Str? = None
  /// The state of the workgroup.
  pub state: WorkGroupState? = None
  /// The workgroup description.
  pub description: Str? = None
  /// The workgroup creation date and time.
  pub creation_time: Time? = None
  /// The engine version setting for all queries on the workgroup. Queries on
  /// the AmazonAthenaPreviewFunctionality workgroup run on the preview engine
  /// regardless of this setting.
  pub engine_version: EngineVersion? = None
  /// The ARN of the IAM Identity Center enabled application associated with
  /// the workgroup.
  pub identity_center_application_arn: Str? = None
}
