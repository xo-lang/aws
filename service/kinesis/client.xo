    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(ReceiveDeadLetterQueueRecordsErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_receive_dead_letter_queue_records_error(resp))
