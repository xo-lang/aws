fn query_put_fleet_data(var f: query.Form, prefix: Str, v: FleetData) {
  if let Some(x) = v.activity_status {
    query.add(f, query.key(prefix, "ActivityStatus"), x.value())
  }
  if let Some(x) = v.create_time {
    query.add(f, query.key(prefix, "CreateTime"), rest.date_time(x))
  }
  if let Some(x) = v.fleet_id {
    query.add(f, query.key(prefix, "FleetId"), x)
  }
  if let Some(x) = v.fleet_state {
    query.add(f, query.key(prefix, "FleetState"), x.value())
  }
  if let Some(x) = v.client_token {
    query.add(f, query.key(prefix, "ClientToken"), x)
  }
  if let Some(x) = v.excess_capacity_termination_policy {
    query.add(f, query.key(prefix, "ExcessCapacityTerminationPolicy"), x.value())
  }
  if let Some(x) = v.fulfilled_capacity {
    query.add(f, query.key(prefix, "FulfilledCapacity"), rest.float_text(x))
  }
  if let Some(x) = v.fulfilled_on_demand_capacity {
    query.add(f, query.key(prefix, "FulfilledOnDemandCapacity"), rest.float_text(x))
  }
  if let Some(x) = v.launch_template_configs {
    query_put_fleet_launch_template_config_list(f, query.key(prefix, "LaunchTemplateConfigs"), x, false)
  }
  if let Some(x) = v.target_capacity_specification {
    query_put_target_capacity_specification(f, query.key(prefix, "TargetCapacitySpecification"), x)
  }
  if let Some(x) = v.terminate_instances_with_expiration {
    query.add(f, query.key(prefix, "TerminateInstancesWithExpiration"), "${x}")
  }
  if let Some(x) = v.type_value {
    query.add(f, query.key(prefix, "Type"), x.value())
  }
  if let Some(x) = v.valid_from {
    query.add(f, query.key(prefix, "ValidFrom"), rest.date_time(x))
  }
  if let Some(x) = v.valid_until {
    query.add(f, query.key(prefix, "ValidUntil"), rest.date_time(x))
  }
  if let Some(x) = v.replace_unhealthy_instances {
    query.add(f, query.key(prefix, "ReplaceUnhealthyInstances"), "${x}")
  }
  if let Some(x) = v.spot_options {
    query_put_spot_options(f, query.key(prefix, "SpotOptions"), x)
  }
  if let Some(x) = v.on_demand_options {
    query_put_on_demand_options(f, query.key(prefix, "OnDemandOptions"), x)
  }
  if let Some(x) = v.reserved_capacity_options {
    query_put_reserved_capacity_options(f, query.key(prefix, "ReservedCapacityOptions"), x)
  }
  if let Some(x) = v.tags {
    query_put_tag_list(f, query.key(prefix, "TagSet"), x, false)
  }
  if let Some(x) = v.errors {
    query_put_describe_fleets_error_set(f, query.key(prefix, "ErrorSet"), x, false)
  }
  if let Some(x) = v.instances {
    query_put_describe_fleets_instances_set(f, query.key(prefix, "FleetInstanceSet"), x, false)
  }
  if let Some(x) = v.context {
    query.add(f, query.key(prefix, "Context"), x)
  }
}

