  var out = DescribeCapacityReservationOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "LastModifiedTime" => out.last_modified_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DecreaseRequestsRemaining" => out.decrease_requests_remaining = xmlv.read_int(c.text())?
      "MinimumLoadBalancerCapacity" => out.minimum_load_balancer_capacity = xml_read_minimum_load_balancer_capacity(c)?
      "CapacityReservationState" => out.capacity_reservation_state = xml_read_zonal_capacity_reservation_states(c)?
      _ => {}
    }
  }
  Ok(out)
}

