  }
  if let Some(x) = v.associated_kms_keys {
    xml_write_associated_kms_key_set(w, x, "associatedKmsKeySet", [])
  }
  if let Some(x) = v.snapshot_id {
    xmlv.elem(w, "snapshotId", x, [])
  }
  if let Some(x) = v.volume_id {
    xmlv.elem(w, "volumeId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.state_message {
