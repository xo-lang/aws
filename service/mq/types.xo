  /// alphanumeric characters, dashes, periods, underscores, and tildes (- . _
  /// ~). This value must be 2-100 characters long.
  pub username: Str? = None
}

/// The scheduled time period relative to UTC during which Amazon MQ begins
/// to apply pending updates or patches to the broker.
pub struct WeeklyStartTime {
  /// Required. The day of the week.
  pub day_of_week: DayOfWeek? = None
  /// Required. The time, in 24-hour format.
  pub time_of_day: Str? = None
  /// The time zone, UTC by default, in either the Country/City format, or the
  /// UTC offset format.
  pub time_zone: Str? = None
}
