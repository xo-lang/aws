/// Contains the modifiable details for updating an existing user, including
/// name, password, security group membership, and invitation settings. A
/// user can only be assigned to a single security group. Attempting to add
/// a user to multiple security groups is not supported and will result in
/// an error.
pub struct UpdateUserDetails {
  /// The new first name for the user.
  pub first_name: Str? = None
  /// The new last name for the user.
  pub last_name: Str? = None
  /// The new username or email address for the user.
  pub username: Str? = None
  /// The updated list of security group IDs to which the user should belong.
  pub security_group_ids: List[Str]? = None
  /// A new custom invite code for the user.
  pub invite_code: Str? = None
  /// The new time-to-live for the invite code in days.
  pub invite_code_ttl: Int? = None
  /// Indicates whether the user can be verified through a custom invite code.
  pub code_validation: Bool? = None
}

pub struct UpdateUserRequest {
  /// The ID of the Wickr network containing the user to update.
  pub network_id: Str? = None
  /// The unique identifier of the user to update.
  pub user_id: Str? = None
  /// An object containing the user details to be updated, such as name,
  /// password, security groups, and invite code settings.
  pub user_details: UpdateUserDetails? = None
}

pub struct UpdateUserResponse {
  /// The unique identifier of the updated user.
  pub user_id: Str? = None
  /// The ID of the network where the user was updated.
  pub network_id: Str? = None
  /// The list of security group IDs to which the user now belongs after the
  /// update.
  pub security_group_ids: List[Str]? = None
  /// The updated first name of the user.
  pub first_name: Str? = None
  /// The updated last name of the user.
  pub last_name: Str? = None
  /// The middle name of the user (currently not used).
  pub middle_name: Str? = None
  /// Indicates whether the user is suspended after the update.
  pub suspended: Bool? = None
  /// The timestamp when the user was last modified, specified in epoch
  /// seconds.
  pub modified: Int? = None
  /// The user's status after the update.
  pub status: Int? = None
  /// The updated invite code for the user, if applicable.
  pub invite_code: Str? = None
  /// The expiration time of the user's invite code, specified in epoch
  /// seconds.
  pub invite_expiration: Int? = None
  /// Indicates whether the user can be verified through a custom invite code.
  pub code_validation: Bool? = None
}

/// Represents a user account in a Wickr network with detailed profile
/// information, status, security settings, and authentication details.
/// codeValidation, inviteCode and inviteCodeTtl are restricted to networks
/// under preview only.
pub struct User {
  /// The unique identifier for the user within the network.
  pub user_id: Str? = None
  /// The first name of the user.
  pub first_name: Str? = None
  /// The last name of the user.
  pub last_name: Str? = None
  /// The email address or username of the user. For bots, this must end in
  /// 'bot'.
  pub username: Str? = None
  /// A list of security group IDs to which the user is assigned, determining
  /// their permissions and feature access.
  pub security_groups: List[Str]? = None
  /// Indicates whether the user has administrator privileges in the network.
  pub is_admin: Bool? = None
  /// Indicates whether the user is currently suspended and unable to access
  /// the network.
  pub suspended: Bool? = None
  /// The current status of the user (1 for pending invitation, 2 for active).
  pub status: Int? = None
  /// Indicates whether one-time password (OTP) authentication is enabled for
  /// the user.
  pub otp_enabled: Bool? = None
  /// The SCIM (System for Cross-domain Identity Management) identifier for
  /// the user, used for identity synchronization. Currently not used.
  pub scim_id: Str? = None
  /// The descriptive type of the user account (e.g., 'user').
  pub type_value: Str? = None
  /// The phone number minus country code, used for cloud deployments.
  pub cell: Str? = None
  /// The country code for the user's phone number, used for cloud
  /// deployments.
  pub country_code: Str? = None
  /// The number of failed password attempts for enterprise deployments, used
  /// for account lockout policies.
  pub challenge_failures: Int? = None
  /// Indicates whether the user's email invitation code has expired,
  /// applicable to cloud deployments.
  pub is_invite_expired: Bool? = None
  /// Indicates whether this account is a user (as opposed to a bot or other
  /// account type).
  pub is_user: Bool? = None
  /// The invitation code for this user, used during registration to join the
  /// network.
  pub invite_code: Str? = None
  /// Indicates whether the user can be verified through a custom invite code.
  pub code_validation: Bool? = None
  /// The unique identifier for the user.
  pub uname: Str? = None
}

pub enum UserStatus: Int {
  Pending = 1
  Active = 2
  Unknown(value: Int)
}

/// One or more fields in the request failed validation. This error provides
/// detailed information about which fields were invalid and why, allowing
/// you to correct the request and retry.
pub struct ValidationError {
  /// A list of validation error details, where each item identifies a
  /// specific field that failed validation and explains the reason for the
  /// failure.
  pub reasons: List[ErrorDetail]? = None
  /// A message describing the validation error error that occurred.
  pub message: Str? = None
}

/// Identifies a Amazon Web Services Wickr network by region and network ID,
/// used for configuring permitted networks for global federation.
pub struct WickrAwsNetworks {
  /// The Amazon Web Services region identifier where the network is hosted
  /// (e.g., 'us-east-1').
  pub region: Str? = None
  /// The network ID of the Wickr Amazon Web Services network.
  pub network_id: Str? = None
}
