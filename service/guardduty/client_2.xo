fn json_of_supporting_data(v: SupportingData) -> json.Value {
  match v {
    Fetch(x) => json.Value.Object([("fetch", json_of_fetch_record(x))])
    Analysis(x) => json.Value.Object([("analysis", json_of_analysis_record(x))])
    Observation(x) => json.Value.Object([("observation", json_of_observation_record(x))])
    Metadata(x) => json.Value.Object([("metadata", json_of_metadata_record(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_supporting_data(v: json.Value) -> SupportingData ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "fetch" => Ok(SupportingData.Fetch(from_json_fetch_record(fv)?))
      "analysis" => Ok(SupportingData.Analysis(from_json_analysis_record(fv)?))
      "observation" => Ok(SupportingData.Observation(from_json_observation_record(fv)?))
      "metadata" => Ok(SupportingData.Metadata(from_json_metadata_record(fv)?))
      _ => Ok(SupportingData.Unknown(k))
    }
  }
  Err("SupportingData: no member set")
}

fn json_of_tactic_coverage(v: TacticCoverage) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.phase {
    fs.push(("phase", json.Value.Str(x.value())))
  }
  if let Some(x) = v.finding_count {
    fs.push(("findingCount", json.Value.Int(x)))
  }
  if let Some(x) = v.finding_types {
    fs.push(("findingTypes", json_of_finding_type_names(x)))
  }
  if let Some(x) = v.techniques {
    fs.push(("techniques", json_of_technique_coverages(x)))
  }
  json.Value.Object(fs)
}

fn from_json_tactic_coverage(v: json.Value) -> TacticCoverage ! Str {
  var out = TacticCoverage{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "phase" => out.phase = AttackPhaseName.from(jsonv.read_str(fv)?)
      "findingCount" => out.finding_count = jsonv.read_int(fv)?
      "findingTypes" => out.finding_types = from_json_finding_type_names(fv)?
      "techniques" => out.techniques = from_json_technique_coverages(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_tactic_coverages(v: List[TacticCoverage]) -> json.Value {
  json.Value.List(v.map(fn(x: TacticCoverage) -> json.Value { json_of_tactic_coverage(x) }))
}

fn from_json_tactic_coverages(v: json.Value) -> List[TacticCoverage] ! Str {
  var out: List[TacticCoverage] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_tactic_coverage(fv)?)
  }
  Ok(out)
}

