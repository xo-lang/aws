  /// The full ARN of the Environment requesting the Collector's data. The
  /// Environment must be in the caller's account. Continuum supplies this
  /// value as the continuum:EnvironmentArn condition key.
  pub environment_arn: Str? = None
}

/// Empty response returned when the authenticated caller is authorized to
/// access the Collector's data.
pub struct GetCollectorDataAccessAuthorizationOutput {
}

/// Specifies the Collector to retrieve.
pub struct GetCollectorInput {
  /// The unique identifier of the Collector to retrieve.
  pub collector_id: Str? = None
}

/// Contains the current state of the Collector.
pub struct GetCollectorOutput {
  /// The unique identifier of the Collector.
