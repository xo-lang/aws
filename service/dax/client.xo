/// Creates a DAX cluster. All nodes in the cluster run the same DAX caching
/// software.
pub fn (c: Client) create_cluster(input: CreateClusterRequest) -> CreateClusterResponse ! CreateClusterErr uses (net.dial, clock, rand) {
