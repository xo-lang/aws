    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_vpc_attachment_error(resp: http.Response) -> UpdateVpcAttachmentErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return UpdateVpcAttachmentErr.AccessDeniedException(x)
      Err(msg) => return UpdateVpcAttachmentErr.Deserialize(msg)
    }
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UpdateVpcAttachmentErr.ConflictException(x)
      Err(msg) => return UpdateVpcAttachmentErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return UpdateVpcAttachmentErr.InternalServerException(x)
      Err(msg) => return UpdateVpcAttachmentErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateVpcAttachmentErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateVpcAttachmentErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateVpcAttachmentErr.ThrottlingException(x)
      Err(msg) => return UpdateVpcAttachmentErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateVpcAttachmentErr.ValidationException(x)
      Err(msg) => return UpdateVpcAttachmentErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateVpcAttachmentErr.Api(restjson.api_error(resp, body))
}

/// Updates a VPC attachment.
pub fn (c: Client) update_vpc_attachment(input: UpdateVpcAttachmentRequest) -> UpdateVpcAttachmentResponse ! UpdateVpcAttachmentErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_vpc_attachment(c.params, input)) ?? e => return Err(UpdateVpcAttachmentErr.InvalidInput(e))
  var req = serialize_update_vpc_attachment(ep, input, "") ?? e => return Err(UpdateVpcAttachmentErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateVpcAttachmentErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_vpc_attachment_error(resp))
  }
  deserialize_update_vpc_attachment(resp) ?? e => Err(UpdateVpcAttachmentErr.Deserialize(e))
}
