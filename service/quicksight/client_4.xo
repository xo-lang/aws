fn json_of_template(v: Template) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.version {
    fs.push(("Version", json_of_template_version(x)))
  }
  if let Some(x) = v.template_id {
    fs.push(("TemplateId", json.Value.Str(x)))
  }
  if let Some(x) = v.last_updated_time {
    fs.push(("LastUpdatedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.created_time {
    fs.push(("CreatedTime", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_template(v: json.Value) -> Template ! Str {
  var out = Template{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Arn" => out.arn = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "Version" => out.version = from_json_template_version(fv)?
      "TemplateId" => out.template_id = jsonv.read_str(fv)?
      "LastUpdatedTime" => out.last_updated_time = jsonv.read_time(fv, "epoch-seconds")?
      "CreatedTime" => out.created_time = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
}

