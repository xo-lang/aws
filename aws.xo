// Package aws holds the types every part of the SDK shares (decision
// 0003): credentials, the provider interface, and their errors.

/// AWS credentials. The secret and the session token are `Secret`, so
/// they never appear in Debug output or logs.
pub struct Credentials {
  pub access_key_id: Str
  pub secret_access_key: Secret[Str]
  pub session_token: Secret[Str]? = None
  /// When the credentials stop working; None for long term keys.
  pub expires: Time? = None
  /// Which provider gave them (`EnvironmentVariables`, `SharedConfigCredentials: default`, ...).
  pub source: Str = ""
}

/// Why credentials could not be had.
pub enum CredentialsErr {
  /// The provider has nothing to give (variables not set, no profile):
  /// a chain moves on to its next provider.
  NotFound(msg: Str)
  /// The provider found configuration but it is wrong: a chain stops.
  Invalid(msg: Str)
  /// Fetching them failed (network, service error).
  Fetch(msg: Str)
}

pub fn (e: CredentialsErr) display() -> Str {
  match e {
    NotFound(msg) => "credentials not found: ${msg}"
    Invalid(msg) => "invalid credentials configuration: ${msg}"
    Fetch(msg) => "fetching credentials failed: ${msg}"
  }
}

/// Anything that gives credentials: static keys, the environment, a
/// profile, a role, a metadata endpoint. Providers that call a service
/// do it at retrieve time, hence the network and clock effects.
pub interface CredentialsProvider {
  fn retrieve(self) -> Credentials ! CredentialsErr uses (net.dial, clock)
}

/// True when `c` expires within `window` of `now` (or already has).
pub fn expires_within(c: Credentials, now: Time, window: Duration) -> Bool {
  match c.expires {
    Some(t) => t.unix_millis() - now.unix_millis() <= window.millis()
    None => false
  }
}

/// How a client retries (decision 0003).
pub enum RetryMode { Standard, Adaptive, Legacy }

/// Shared configuration for every service client, made by
/// `config.load_default_config` or written by hand.
pub struct Config {
  pub region: Str? = None
  pub credentials: CredentialsProvider? = None
  pub retry_mode: RetryMode = RetryMode.Standard
  /// Total attempts per call, the first included.
  pub max_attempts: Int = 3
  /// Configured endpoint URLs (the SDKs' "service-specific endpoints").
  pub endpoints: ConfiguredEndpoints = ConfiguredEndpoints{}
  pub use_fips: Bool = false
  pub use_dualstack: Bool = false
  pub app_id: Str? = None
  /// The profile the configuration came from.
  pub profile: Str = "default"
}

/// Endpoint URLs from the environment and the profile, kept apart so
/// `endpoint_for` applies the SDKs' precedence.
pub struct ConfiguredEndpoints {
  /// `AWS_ENDPOINT_URL`
  pub env_global: Str? = None
  /// `AWS_ENDPOINT_URL_<SUFFIX>`, keyed by the suffix (`S3`, `DYNAMODB`).
  pub env_service: Map[Str, Str] = {}
  /// The profile's `endpoint_url`.
  pub profile_global: Str? = None
  /// The profile's `services` section, keyed by the same upper case suffix.
  pub profile_service: Map[Str, Str] = {}
  /// `AWS_IGNORE_CONFIGURED_ENDPOINT_URLS` or the profile's
  /// `ignore_configured_endpoint_urls`: none of the above applies.
  pub ignore: Bool = false
}

/// The configured endpoint URL for a service, by its environment suffix
/// (its sdkId upper cased, spaces as `_`): the service's variable, the
/// global variable, the profile's services entry, the profile's
/// `endpoint_url`, in that order.
pub fn endpoint_for(e: ConfiguredEndpoints, suffix: Str) -> Str? {
  if e.ignore {
    return None
  }
  e.env_service.get(suffix) ?? e.env_global ?? e.profile_service.get(suffix) ?? e.profile_global
}
