fn json_of_receiver(v: Receiver) -> json.Value {
  match v {
    Account(x) => json.Value.Object([("Account", json_of_account_receiver(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_receiver(v: json.Value) -> Receiver ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Account" => Ok(Receiver.Account(from_json_account_receiver(fv)?))
      _ => Ok(Receiver.Unknown(k))
    }
  }
  Err("Receiver: no member set")
}

