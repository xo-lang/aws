/// Represents the output of a GetMLModel operation. The content consists of
/// the detailed metadata and the current status of the MLModel .
pub struct MLModel {
  /// The ID assigned to the MLModel at creation.
  pub ml_model_id: Str? = None
  /// The ID of the training DataSource . The CreateMLModel operation uses the
  /// TrainingDataSourceId .
