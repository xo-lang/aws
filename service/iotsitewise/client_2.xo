fn json_of_processing_input(v: ProcessingInput) -> json.Value {
  match v {
    Timeseries(x) => json.Value.Object([("timeseries", json_of_timeseries_list(x))])
    Dataset(x) => json.Value.Object([("dataset", json_of_dataset_item(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_processing_input(v: json.Value) -> ProcessingInput ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "timeseries" => Ok(ProcessingInput.Timeseries(from_json_timeseries_list(fv)?))
      "dataset" => Ok(ProcessingInput.Dataset(from_json_dataset_item(fv)?))
      _ => Ok(ProcessingInput.Unknown(k))
    }
  }
  Err("ProcessingInput: no member set")
}

