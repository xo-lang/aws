/// The HTTP request of ContentTypeParameters.
pub fn serialize_content_type_parameters(ep: rest.Endpoint, input: ContentTypeParametersInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var query: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.value {
    fs.push(("value", json.Value.Int(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.1"))
  headers.push(("X-Amz-Target", "JsonProtocol.ContentTypeParameters"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(query),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_content_type_parameters(resp: http.Response) -> ContentTypeParametersOutput ! Str {
  var out = ContentTypeParametersOutput{}
  Ok(out)
}

/// The errors of ContentTypeParameters.
pub enum ContentTypeParametersErr {
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: ContentTypeParametersErr) display() -> Str {
  match e {
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_content_type_parameters_error(resp: http.Response) -> ContentTypeParametersErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  ContentTypeParametersErr.Api(restjson.api_error(resp, body))
}

pub fn (c: Client) content_type_parameters(input: ContentTypeParametersInput) -> ContentTypeParametersOutput ! ContentTypeParametersErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route() ?? e => return Err(ContentTypeParametersErr.InvalidInput(e))
  var req = serialize_content_type_parameters(ep, input, "") ?? e => return Err(ContentTypeParametersErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(ContentTypeParametersErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_content_type_parameters_error(resp))
  }
  deserialize_content_type_parameters(resp) ?? e => Err(ContentTypeParametersErr.Deserialize(e))
}

/// The HTTP request of DatetimeOffsets.
pub fn serialize_datetime_offsets(ep: rest.Endpoint, input: (), idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var query: List[(Str, Str)] = []
  var body = b""
  body = b"{}"
  headers.push(("Content-Type", "application/x-amz-json-1.1"))
  headers.push(("X-Amz-Target", "JsonProtocol.DatetimeOffsets"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(query),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_datetime_offsets(resp: http.Response) -> DatetimeOffsetsOutput ! Str {
  var out = DatetimeOffsetsOutput{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
