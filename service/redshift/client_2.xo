fn query_put_accept_reserved_node_exchange_input_message(var f: query.Form, prefix: Str, v: AcceptReservedNodeExchangeInputMessage) {
  if let Some(x) = v.reserved_node_id {
    query.add(f, query.key(prefix, "ReservedNodeId"), x)
  }
  if let Some(x) = v.target_reserved_node_offering_id {
    query.add(f, query.key(prefix, "TargetReservedNodeOfferingId"), x)
  }
}

fn query_put_accept_reserved_node_exchange_output_message(var f: query.Form, prefix: Str, v: AcceptReservedNodeExchangeOutputMessage) {
  if let Some(x) = v.exchanged_reserved_node {
    query_put_reserved_node(f, query.key(prefix, "ExchangedReservedNode"), x)
  }
}

fn query_put_access_to_cluster_denied_fault(var f: query.Form, prefix: Str, v: AccessToClusterDeniedFault) {
  if let Some(x) = v.message {
    query.add(f, query.key(prefix, "message"), x)
  }
}

fn query_put_access_to_snapshot_denied_fault(var f: query.Form, prefix: Str, v: AccessToSnapshotDeniedFault) {
