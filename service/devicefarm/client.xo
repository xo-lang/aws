  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "arn" => out.arn = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "type" => out.type_value = TestType.from(jsonv.read_str(fv)?)
      "platform" => out.platform = DevicePlatform.from(jsonv.read_str(fv)?)
      "created" => out.created = jsonv.read_time(fv, "epoch-seconds")?
      "status" => out.status = ExecutionStatus.from(jsonv.read_str(fv)?)
      "result" => out.result = ExecutionResult.from(jsonv.read_str(fv)?)
      "started" => out.started = jsonv.read_time(fv, "epoch-seconds")?
      "stopped" => out.stopped = jsonv.read_time(fv, "epoch-seconds")?
      "counters" => out.counters = from_json_counters(fv)?
      "message" => out.message = jsonv.read_str(fv)?
      "totalJobs" => out.total_jobs = jsonv.read_int(fv)?
      "completedJobs" => out.completed_jobs = jsonv.read_int(fv)?
      "billingMethod" => out.billing_method = BillingMethod.from(jsonv.read_str(fv)?)
      "deviceMinutes" => out.device_minutes = from_json_device_minutes(fv)?
      "networkProfile" => out.network_profile = from_json_network_profile(fv)?
      "deviceProxy" => out.device_proxy = from_json_device_proxy(fv)?
      "parsingResultUrl" => out.parsing_result_url = jsonv.read_str(fv)?
      "resultCode" => out.result_code = ExecutionResultCode.from(jsonv.read_str(fv)?)
      "seed" => out.seed = jsonv.read_int(fv)?
      "appUpload" => out.app_upload = jsonv.read_str(fv)?
      "eventCount" => out.event_count = jsonv.read_int(fv)?
      "jobTimeoutMinutes" => out.job_timeout_minutes = jsonv.read_int(fv)?
      "devicePoolArn" => out.device_pool_arn = jsonv.read_str(fv)?
      "locale" => out.locale = jsonv.read_str(fv)?
      "radios" => out.radios = from_json_radios(fv)?
      "location" => out.location = from_json_location(fv)?
      "customerArtifactPaths" => out.customer_artifact_paths = from_json_customer_artifact_paths(fv)?
      "webUrl" => out.web_url = jsonv.read_str(fv)?
      "skipAppResign" => out.skip_app_resign = jsonv.read_bool(fv)?
      "testSpecArn" => out.test_spec_arn = jsonv.read_str(fv)?
      "testPackageArn" => out.test_package_arn = jsonv.read_str(fv)?
      "deviceSelectionResult" => out.device_selection_result = from_json_device_selection_result(fv)?
      "vpcConfig" => out.vpc_config = from_json_vpc_config(fv)?
      "executionRoleArn" => out.execution_role_arn = jsonv.read_str(fv)?
      "environmentVariables" => out.environment_variables = from_json_environment_variables(fv)?
      "insightsTypes" => out.insights_types = from_json_insights_types(fv)?
      "insights" => out.insights = from_json_run_insights(fv)?
      _ => {}
    }
  }
  Ok(out)
}

