pub struct UpdateDaemonRequest {
  /// The Amazon Resource Name (ARN) of the daemon to update.
  pub daemon_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the daemon task definition to use for
  /// the updated daemon.
  pub daemon_task_definition_arn: Str? = None
  /// The Amazon Resource Names (ARNs) of the capacity providers to associate
  /// with the daemon.
  pub capacity_provider_arns: List[Str]? = None
  /// Optional deployment parameters that control how the daemon rolls out
  /// updates, including the drain percentage, alarm-based rollback, and bake
  /// time.
  pub deployment_configuration: DaemonDeploymentConfiguration? = None
  /// Specifies whether to propagate the tags from the daemon to the daemon
  /// tasks. If you don't specify a value, the tags aren't propagated. You can
  /// only propagate tags to daemon tasks during task creation.
  pub propagate_tags: DaemonPropagateTags? = None
  /// Specifies whether to turn on Amazon ECS managed tags for the tasks in
  /// the daemon. For more information, see Tagging your Amazon ECS resources
  /// in the Amazon Elastic Container Service Developer Guide .
  pub enable_ecs_managed_tags: Bool? = None
  /// If true , the execute command functionality is turned on for all tasks
  /// in the daemon. If false , the execute command functionality is turned
  /// off.
  pub enable_execute_command: Bool? = None
  /// If the critical parameter of a daemon is true , and the daemon task
  /// fails, stops, or becomes unhealthy, Amazon ECS drains the container
  /// instance and stops the other tasks running on it. If the critical
  /// parameter is false , the daemon task failure doesn't affect the other
  /// tasks on the instance. The default value is true . A non-critical daemon
  /// doesn't block instance registration. The container instance becomes
  /// active and continues to run your other tasks, whether the daemon task
  /// fails during scale-out or during a deployment. Amazon ECS emits an
  /// EventBridge event when a daemon task fails to start, for both critical
  /// and non-critical daemons. Daemon task launch failures during a
  /// deployment are still counted by the deployment circuit breaker. The
  /// circuit breaker can roll back an unstable target revision.
  pub critical: Bool? = None
}

pub struct UpdateDaemonResponse {
  /// The Amazon Resource Name (ARN) of the daemon.
  pub daemon_arn: Str? = None
  /// The status of the daemon.
  pub status: DaemonStatus? = None
  /// The Unix timestamp for the time when the daemon was created.
  pub created_at: Time? = None
  /// The Unix timestamp for the time when the daemon was last updated.
  pub updated_at: Time? = None
  /// The Amazon Resource Name (ARN) of the daemon deployment that was
  /// triggered by the update.
  pub deployment_arn: Str? = None
}

pub struct UpdateExpressGatewayServiceRequest {
  /// The Amazon Resource Name (ARN) of the Express service to update.
  pub service_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the task execution role for the
  /// Express service.
  pub execution_role_arn: Str? = None
  /// The path on the container for Application Load Balancer health checks.
  pub health_check_path: Str? = None
  /// The primary container configuration for the Express service.
  pub primary_container: ExpressGatewayContainer? = None
  /// The Amazon Resource Name (ARN) of the IAM role for containers in this
  /// task.
  pub task_role_arn: Str? = None
  /// The network configuration for the Express service tasks. By default, the
  /// network configuration for an Express service uses the default VPC.
  pub network_configuration: ExpressGatewayServiceNetworkConfiguration? = None
  /// The number of CPU units used by the task.
  pub cpu: Str? = None
  /// The amount of memory (in MiB) used by the task.
  pub memory: Str? = None
  /// The CPU architecture that the task runs on. If you don't specify a
  /// value, the service keeps its current architecture. Valid values: X86_64
  /// - The x86 64-bit architecture. ARM64 - The 64-bit ARM architecture.
  /// Changing the architecture starts a new deployment that replaces the
  /// running tasks. Ensure that the container image you specify supports the
  /// architecture you choose. The operating system family for an Express
  /// service is always LINUX . You can't specify cpuArchitecture together
  /// with taskDefinitionArn .
  pub cpu_architecture: ExpressCpuArchitecture? = None
  /// The auto-scaling configuration for the Express service.
  pub scaling_target: ExpressGatewayScalingTarget? = None
  /// The Amazon Resource Name (ARN) of a task definition to use to update the
  /// Express Gateway service. This allows you to manage your own task
  /// definition, giving you more control over the service configuration such
  /// as adding sidecar containers. The task definition must have a container
  /// named Main with a single TCP port mapping that includes a container port
  /// and port name. The task definition must also have FARGATE compatibility.
  /// If you provide a task definition ARN, you cannot also specify
  /// primaryContainer , executionRoleArn , taskRoleArn , cpu , memory , or
  /// cpuArchitecture .
  pub task_definition_arn: Str? = None
}

pub struct UpdateExpressGatewayServiceResponse {
  /// The full description of your express gateway service following the
  /// update call.
  pub service: UpdatedExpressGatewayService? = None
}

