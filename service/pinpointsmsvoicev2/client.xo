      "RequestLocation" => Ok(RcsSuggestedAction.RequestLocation(from_json_rcs_request_location_action(fv)?))
      "CreateCalendarEvent" => Ok(RcsSuggestedAction.CreateCalendarEvent(from_json_rcs_create_calendar_event_action(fv)?))
      _ => Ok(RcsSuggestedAction.Unknown(k))
    }
  }
  Err("RcsSuggestedAction: no member set")
}

