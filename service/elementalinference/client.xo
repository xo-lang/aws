    }
    "InternalServerErrorException" => match read_error_internal_server_error_exception(resp, body) {
      Ok(x) => return AssociateFeedErr.InternalServerErrorException(x)
      Err(msg) => return AssociateFeedErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return AssociateFeedErr.ResourceNotFoundException(x)
      Err(msg) => return AssociateFeedErr.Deserialize(msg)
    }
    "ServiceQuotaExceededException" => match read_error_service_quota_exceeded_exception(resp, body) {
