      "ParametersDefinition" => out.parameters_definition = xml_read_parameters_definition_list_type(c)?
      "RoleTagsTemplate" => out.role_tags_template = xml_read_tag_template_list_type(c)?
      "MaxSessionDuration" => out.max_session_duration = xmlv.read_int(c.text())?
      "VersionEnabled" => out.version_enabled = xmlv.read_bool(c.text())?
      "CreateTimestamp" => out.create_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UpdateTimestamp" => out.update_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
