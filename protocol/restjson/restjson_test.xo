use std/http
use std/json

test "an error with no code shows the start of its body" {
  let resp = http.text(404, "<html>no such route</html>")
  let e = api_error(resp, json.Value.Null)
  expect(e.code) == "UnknownError"
  expect(e.message) == "<html>no such route</html>"
  expect(body_hint("x".repeat(300).bytes()).len()) == 203
  expect(body_hint(b"")) == ""
}

test "a repeated error type or request ID is its first field, as Go's Header.Get" {
  let resp = http.text(400, "{}").add_header("X-Amzn-Errortype", "FirstError").add_header("X-Amzn-Errortype", "SecondError")
    .add_header("X-Amzn-Requestid", "rid-1").add_header("X-Amzn-Requestid", "rid-2")
  let e = api_error(resp, json.Value.Null)
  expect(e.code) == "FirstError"
  expect(e.request_id) == "rid-1"
}
