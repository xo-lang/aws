/// For a hyperparameter of the integer type, specifies the range that a
/// hyperparameter tuning job searches.
pub struct IntegerParameterRange {
  /// The name of the hyperparameter to search.
  pub name: Str? = None
  /// The minimum value of the hyperparameter to search.
  pub min_value: Str? = None
  /// The maximum value of the hyperparameter to search.
  pub max_value: Str? = None
  /// The scale that hyperparameter tuning uses to search the hyperparameter
  /// range. For information about choosing a hyperparameter scale, see
  /// Hyperparameter Scaling . One of the following values: Auto SageMaker
  /// hyperparameter tuning chooses the best scale for the hyperparameter.
  /// Linear Hyperparameter tuning searches the values in the hyperparameter
  /// range by using a linear scale. Logarithmic Hyperparameter tuning
  /// searches the values in the hyperparameter range by using a logarithmic
  /// scale. Logarithmic scaling works only for ranges that have only values
  /// greater than 0.
  pub scaling_type: HyperParameterScalingType? = None
}

/// Defines the possible values for an integer hyperparameter.
pub struct IntegerParameterRangeSpecification {
  /// The minimum integer value allowed.
  pub min_value: Str? = None
  /// The maximum integer value allowed.
  pub max_value: Str? = None
}

pub enum IsTrackingServerActive: Str {
  Active = "Active"
  Inactive = "Inactive"
  Unknown(value: Str)
}

/// The context for an iteration of a ForEach step.
pub struct IterationContext {
  /// The name of the ForEach step that generated this iteration.
  pub parent_step_name: Str? = None
  /// The index of the iteration within the ForEach step.
  pub index: Int? = None
  /// The input item that is being processed in this iteration.
  pub item: Str? = None
}

/// The properties of a job returned by the Search API.
pub struct Job {
  /// The name of the job.
  pub job_name: Str? = None
  /// The Amazon Resource Name (ARN) of the job.
  pub job_arn: Str? = None
  /// The ARN of the IAM role associated with the job.
  pub role_arn: Str? = None
  /// The category of the job.
  pub job_category: JobCategory? = None
  /// The schema version used for the job configuration document.
  pub job_config_schema_version: Str? = None
  /// The JSON configuration document for the job.
  pub job_config_document: Str? = None
  /// The date and time that the job was created.
  pub creation_time: Time? = None
  /// The date and time that the job was last modified.
  pub last_modified_time: Time? = None
  /// The date and time that the job ended.
  pub end_time: Time? = None
  /// The current status of the job.
  pub job_status: JobStatus? = None
  /// The detailed secondary status of the job, providing more granular
  /// information about the job's progress.
  pub secondary_status: JobSecondaryStatus? = None
  /// A list of secondary status transitions for the job, with timestamps and
  /// optional status messages.
  pub secondary_status_transitions: List[JobSecondaryStatusTransition]? = None
  /// If the job failed, the reason it failed.
  pub failure_reason: Str? = None
  /// The tags associated with the job.
  pub tags: List[Tag]? = None
}

pub enum JobCategory: Str {
  AgentRft = "AgentRFT"
  AgentRftEvaluation = "AgentRFTEvaluation"
  Unknown(value: Str)
}

/// Provides summary information about a job configuration schema version.
pub struct JobConfigSchemaVersionSummary {
  /// The version of the job configuration schema.
  pub job_config_schema_version: Str? = None
}

pub enum JobSecondaryStatus: Str {
  Starting = "Starting"
  Downloading = "Downloading"
  Training = "Training"
  Uploading = "Uploading"
  Stopping = "Stopping"
  Stopped = "Stopped"
  MaxRuntimeExceeded = "MaxRuntimeExceeded"
  Interrupted = "Interrupted"
  Failed = "Failed"
  Completed = "Completed"
  Restarting = "Restarting"
  Pending = "Pending"
  Evaluating = "Evaluating"
  Deleting = "Deleting"
  DeleteFailed = "DeleteFailed"
  Unknown(value: Str)
}

/// Represents a secondary status transition for a job. Jobs progress
/// through multiple secondary statuses during execution. Each transition
/// records the status, start time, optional end time, and an optional
/// message with additional details.
pub struct JobSecondaryStatusTransition {
  /// The secondary status of the job at this transition point.
  pub status: JobSecondaryStatus? = None
  /// The date and time that the status transition started.
  pub start_time: Time? = None
  /// The date and time that the status transition ended.
  pub end_time: Time? = None
  /// A detailed message about the status transition.
  pub status_message: Str? = None
}

pub enum JobStatus: Str {
  InProgress = "InProgress"
  Completed = "Completed"
  Failed = "Failed"
  Stopping = "Stopping"
  Stopped = "Stopped"
  Deleting = "Deleting"
  DeleteFailed = "DeleteFailed"
  Unknown(value: Str)
}

/// Metadata for a SageMaker job step.
pub struct JobStepMetadata {
  /// The Amazon Resource Name (ARN) of the SageMaker job that was run by this
  /// step execution.
  pub arn: Str? = None
}

/// Provides summary information about a job, returned by the ListJobs
/// operation. Use DescribeJob to get full details for a specific job.
pub struct JobSummary {
  /// The Amazon Resource Name (ARN) of the job.
  pub job_arn: Str? = None
  /// The name of the job.
  pub job_name: Str? = None
  /// The category of the job.
  pub job_category: JobCategory? = None
  /// The current status of the job.
  pub job_status: JobStatus? = None
  /// The secondary status of the job, providing more granular information
  /// about the job's progress. Secondary statuses may change between
  /// releases.
  pub job_secondary_status: JobSecondaryStatus? = None
  /// The date and time that the job was created.
  pub creation_time: Time? = None
  /// The date and time that the job was last modified.
  pub last_modified_time: Time? = None
  /// The date and time that the job ended.
  pub end_time: Time? = None
}

