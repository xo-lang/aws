  }
  json.Value.Object(fs)
}

fn from_json_filter(v: json.Value) -> Filter ! Str {
  var out = Filter{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "attribute" => out.attribute = jsonv.read_str(fv)?
      "value" => out.value = jsonv.read_str(fv)?
      "intValue" => out.int_value = jsonv.read_int(fv)?
      "operator" => out.operator = FilterOperator.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_filter_clause(v: FilterClause) -> json.Value {
  match v {
    Filter(x) => json.Value.Object([("filter", json_of_filter(x))])
    And(x) => json.Value.Object([("and", json_of_filter_list(x))])
    Or(x) => json.Value.Object([("or", json_of_filter_list(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_filter_clause(v: json.Value) -> FilterClause ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "filter" => Ok(FilterClause.Filter(from_json_filter(fv)?))
      "and" => Ok(FilterClause.And(from_json_filter_list(fv)?))
      "or" => Ok(FilterClause.Or(from_json_filter_list(fv)?))
      _ => Ok(FilterClause.Unknown(k))
    }
  }
  Err("FilterClause: no member set")
}

