/// Provides a collection of table statistics in response to a request by
/// the DescribeTableStatistics operation.
pub struct TableStatistics {
  /// The schema name.
  pub schema_name: Str? = None
  /// The name of the table.
  pub table_name: Str? = None
  /// The number of insert actions performed on a table.
  pub inserts: Int? = None
  /// The number of delete actions performed on a table.
  pub deletes: Int? = None
  /// The number of update actions performed on a table.
  pub updates: Int? = None
  /// The data definition language (DDL) used to build and modify the
  /// structure of your tables.
  pub ddls: Int? = None
  /// The number of insert actions applied on a target table.
  pub applied_inserts: Int? = None
  /// The number of delete actions applied on a target table.
  pub applied_deletes: Int? = None
  /// The number of update actions applied on a target table.
  pub applied_updates: Int? = None
  /// The number of data definition language (DDL) statements used to build
  /// and modify the structure of your tables applied on the target.
  pub applied_ddls: Int? = None
  /// The number of rows added during the full load operation.
  pub full_load_rows: Int? = None
  /// The number of rows that failed conditional checks during the full load
  /// operation (valid only for migrations where DynamoDB is the target).
  pub full_load_condtnl_chk_failed_rows: Int? = None
  /// The number of rows that failed to load during the full load operation
  /// (valid only for migrations where DynamoDB is the target).
  pub full_load_error_rows: Int? = None
  /// The time when the full load operation started.
  pub full_load_start_time: Time? = None
  /// The time when the full load operation completed.
  pub full_load_end_time: Time? = None
  /// A value that indicates if the table was reloaded ( true ) or loaded as
  /// part of a new full load operation ( false ).
  pub full_load_reloaded: Bool? = None
  /// The last time a table was updated.
  pub last_update_time: Time? = None
  /// The state of the tables described. Valid states: Table does not exist |
  /// Before load | Full load | Table completed | Table cancelled | Table
  /// error | Table is being reloaded
  pub table_state: Str? = None
  /// The number of records that have yet to be validated.
  pub validation_pending_records: Int? = None
  /// The number of records that failed validation.
  pub validation_failed_records: Int? = None
  /// The number of records that couldn't be validated.
  pub validation_suspended_records: Int? = None
  /// The validation state of the table. This parameter can have the following
  /// values: Not enabled – Validation isn't enabled for the table in the
  /// migration task. Pending records – Some records in the table are
  /// waiting for validation. Mismatched records – Some records in the table
  /// don't match between the source and target. Suspended records – Some
  /// records in the table couldn't be validated. No primary key –The table
  /// couldn't be validated because it has no primary key. Table error – The
  /// table wasn't validated because it's in an error state and some data
  /// wasn't migrated. Validated – All rows in the table are validated. If
  /// the table is updated, the status can change from Validated. Error –
  /// The table couldn't be validated because of an unexpected error. Pending
  /// validation – The table is waiting validation. Preparing table –
  /// Preparing the table enabled in the migration task for validation.
  /// Pending revalidation – All rows in the table are pending validation
  /// after the table was updated.
  pub validation_state: Str? = None
  /// Additional details about the state of validation.
  pub validation_state_details: Str? = None
  /// Records the current state of table resynchronization in the migration
  /// task. This parameter can have the following values: Not enabled –
  /// Resync is not enabled for the table in the migration task. Pending –
  /// The tables are waiting for resync. In progress – Resync in progress
  /// for some records in the table. No primary key – The table could not be
  /// resynced because it has no primary key. Last resync at: date/time –
  /// Resync session is finished at time. Time provided in UTC format.
  pub resync_state: Str? = None
  /// Records the total number of mismatched data rows where the system
  /// attempted to apply fixes in the target database.
  pub resync_rows_attempted: Int? = None
  /// Records the total number of mismatched data rows where fixes were
  /// successfully applied in the target database.
  pub resync_rows_succeeded: Int? = None
  /// Records the total number of mismatched data rows where fix attempts
  /// failed in the target database.
  pub resync_rows_failed: Int? = None
  /// Calculates the percentage of failed validations that were successfully
  /// resynced to the system.
  pub resync_progress: Float? = None
}

