/// The HTTP request of CreateChallenge.
pub fn serialize_create_challenge(ep: rest.Endpoint, input: CreateChallengeRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.connector_arn {
    fs.push(("ConnectorArn", json.Value.Str(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("ClientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("ClientToken", json.Value.Str(idempotency_token)))
  }
  if let Some(x) = input.tags {
    fs.push(("Tags", json_of_tags(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/challenges"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

