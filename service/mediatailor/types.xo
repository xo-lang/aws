  /// An optional stream identifier that you can specify in order to prefetch
  /// for multiple streams that use the same playback configuration.
  pub stream_id: Str? = None
  /// The tags assigned to the prefetch schedule. Tags are key-value pairs
  /// that you can associate with Amazon resources to help with organization,
  /// access control, and cost tracking. For more information, see Tagging AWS
  /// Elemental MediaTailor Resources .
  pub tags: Map[Str, Str]? = None
}

pub enum PrefetchScheduleType: Str {
  Single = "SINGLE"
  Recurring = "RECURRING"
  Unknown(value: Str)
}

