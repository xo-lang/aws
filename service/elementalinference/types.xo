pub struct QuestionOption {
  /// A name for the option. The name must be unique among the options of the
  /// question. The name can be up to 64 characters. It must start with a
  /// letter or an underscore, and can contain only the letters A-Z and a-z,
  /// the digits 0-9, and underscores.
  pub name: Str? = None
  /// The text of the option. The text must be unique among the options of the
  /// question, ignoring case. The text can be up to 16 bytes, encoded in
  /// UTF-8. It can contain the same characters as the text of a question.
  pub text: Str? = None
}

/// Identifies one version of a question set. You specify it in
/// CustomQuestionsConfig.
pub struct QuestionSetReference {
  /// The ID of the question set. The question set must be in your account.
  pub question_set_id: Str? = None
  /// The version of the question set: DRAFT or the number of a published
  /// version. The version must exist. If you specify DRAFT, the output uses
  /// the current DRAFT questions and picks up changes that you make later by
  /// using UpdateQuestionSet. To keep the questions for the output fixed,
  /// specify a published version.
  pub version: Str? = None
}

/// Contains summary information about a question set. Used in the
/// ListQuestionSets response.
pub struct QuestionSetSummary {
  /// The ARN of the question set.
  pub arn: Str? = None
  /// The ID of the question set.
  pub id: Str? = None
  /// The name of the question set.
  pub name: Str? = None
  /// The number of the highest version that you have published for this
  /// question set, even if you have since deleted that version. Elemental
  /// Inference doesn't return this property if you haven't published a
  /// version.
  pub latest_version: Str? = None
}

/// Contains summary information about one version of a question set. Used
/// in the ListQuestionSetVersions response.
pub struct QuestionSetVersionSummary {
  /// The version: DRAFT or the number of a published version.
  pub version: Str? = None
  /// The description that you specified when you published this version.
  /// Elemental Inference doesn't return this property for DRAFT, or for a
  /// version that you published without a description.
  pub description: Str? = None
  /// The SHA-256 hash of this version, as 64 lowercase hexadecimal
  /// characters. The hash covers the name of the question set and its
  /// questions at this version.
  pub sha256: Str? = None
  /// For DRAFT, the time when you created the question set or last updated
  /// DRAFT. For a published version, the time when you published it.
  pub last_modified_at: Time? = None
}

/// Removes the game from an event clipping output at the action's scheduled
/// time. This is a type of ScheduleActionOperation, and the output must be
/// an event clipping output.
pub struct RemoveClippingDataSourceConfiguration {
  /// The name of the output that you want to remove the game from.
  pub output_name: Str? = None
}

/// The resource specified in the action doesn't exist.
pub struct ResourceNotFoundException {
  pub message: Str? = None
}

/// The perScene trigger, which runs the function once for each scene that a
/// contextual metadata output reports. The function runs after the scene
/// ends, with the media of that scene. To choose this trigger, set perScene
/// to an empty object. Specify contextualMetadataSettings to name the
/// contextual metadata output that reports the scenes. You can't use this
/// trigger with a function that references media.transcript or media.clip.
pub struct SceneTrigger {
}

/// Describes one schedule action on a feed, including the changes it makes
/// and whether it has run yet. Elemental Inference returns this structure
/// in the ListScheduleActions operation.
pub struct ScheduleAction {
  /// The name of the schedule action. The name is unique within the feed.
  pub action_name: Str? = None
  /// Specifies when the action runs.
  pub start_configuration: ScheduleActionStartConfiguration? = None
  /// The configuration changes that the action makes to the feed.
  pub operations: List[ScheduleActionOperation]? = None
  /// The status of the action. Valid values are the following: PENDING The
  /// action is waiting for its scheduled time. COMPLETED Elemental Inference
  /// applied all the action's operations to the feed. FAILED Elemental
  /// Inference couldn't apply the action.
  pub status: ScheduleActionStatus? = None
  /// A description of why the action failed. Elemental Inference returns this
  /// property only when the status is FAILED.
  pub error: ScheduleActionError? = None
}

/// Describes the cause of a schedule action failure, including the failure
/// type and a description of what went wrong.
pub struct ScheduleActionError {
  /// The type of failure. Valid values are the following:
  /// INVALID_ACTION_TARGET The action referred to something that didn't exist
  /// or wasn't valid at the scheduled time, for example an output that you
  /// deleted. INTERNAL_ERROR An unexpected error prevented the action from
  /// completing.
  pub error_code: ScheduleActionErrorCode? = None
  /// A description of the failure.
  pub error_message: Str? = None
}

pub enum ScheduleActionErrorCode: Str {
  InvalidActionTarget = "INVALID_ACTION_TARGET"
  InternalError = "INTERNAL_ERROR"
  Unknown(value: Str)
}

/// Holds one typed configuration change that a schedule action makes to a
/// feed. Each operation must contain exactly one property.
pub enum ScheduleActionOperation {
  UpdateOutputStatus(value: UpdateOutputStatus)
  UpdateClippingDataSourceConfiguration(value: UpdateClippingDataSourceConfiguration)
  RemoveClippingDataSourceConfiguration(value: RemoveClippingDataSourceConfiguration)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// Holds the typed start settings that determine when a schedule action
/// runs. Currently, only fixed mode is supported.
pub enum ScheduleActionStartConfiguration {
  FixedModeScheduleActionStartSettings(value: FixedModeScheduleActionStartSettings)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

pub enum ScheduleActionStatus: Str {
  Pending = "PENDING"
  Completed = "COMPLETED"
  Failed = "FAILED"
  Unknown(value: Str)
}

/// A filter for a fixture search. It is used in the filters array of a
/// SearchFixtures request.
pub struct SearchFilter {
  /// The dimension of the fixture to filter on. Valid values: COMPETITOR.
  pub name: FilterName? = None
  /// An array of values to match in the dimension that you specified in name.
  /// You can specify up to 10 values. A fixture appears in the results if it
  /// matches at least one of these values.
  pub values: List[Str]? = None
}

pub struct SearchFixturesRequest {
  /// The sport to search for fixtures. Valid values: basketball (search for
  /// basketball fixtures), american-football (search for american-football
  /// fixtures).
  pub sport: DataSourceSport? = None
  /// The first day of the search window, in UTC. The search includes fixtures
  /// that are scheduled on this day. Specify the date in ISO 8601 format, as
  /// YYYY-MM-DD . For example, 2026-03-14.
  pub start_date: Str? = None
  /// The last day of the search window, in UTC. The search includes fixtures
  /// that are scheduled on this day. Specify the date in ISO 8601 format, as
  /// YYYY-MM-DD . If you omit this parameter, Elemental Inference searches
  /// only the day that you specified in startDate. The window from startDate
  /// through endDate must not exceed seven days.
  pub end_date: Str? = None
  /// An array of filters that narrow the results. Each filter applies to one
  /// dimension of a fixture, such as the competitor. You can specify up to 10
  /// filters. A fixture must satisfy every filter in the array in order to
  /// appear in the results. Within one filter, a fixture must match at least
  /// one of the values.
  pub filters: List[SearchFilter]? = None
  /// The maximum number of fixtures to return for each API request. The
  /// service might return fewer fixtures than the maxResults value. When more
  /// fixtures match the search, the response also includes a nextToken value
  /// that you can use to fetch the next batch of results.
  pub max_results: Int? = None
  /// The token that identifies the batch of results that you want to see. For
  /// example, you submit a SearchFixtures request with maxResults set at 5.
  /// The service returns the first batch of results (up to 5) and a nextToken
  /// value. To see the next batch of results, you submit the SearchFixtures
  /// request a second time, with the same search criteria, and specify the
  /// nextToken value.
  pub next_token: Str? = None
}

pub struct SearchFixturesResponse {
  /// An array of FixtureSummary objects, one for each fixture that matches
  /// the search. The array is empty if no fixtures match.
  pub fixtures: List[FixtureSummary]? = None
  /// The token that identifies the next batch of results. To see the next
  /// batch, submit the SearchFixtures request again, with the same search
  /// criteria, and specify this value in nextToken. This parameter is absent
  /// when there are no more results to return.
  pub next_token: Str? = None
}

