  let (ep, signing, extra) = c.route(endpoint_params_synthesize_speech(c.params, input)) ?? e => return Err(SynthesizeSpeechErr.InvalidInput(e))
  var req = serialize_synthesize_speech(ep, input, "") ?? e => return Err(SynthesizeSpeechErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  var qs: List[(Str, Str)] = []
  if let Some(x) = input.engine { qs.push(("Engine", x.value())) }
  if let Some(x) = input.language_code { qs.push(("LanguageCode", x.value())) }
  for x in input.lexicon_names ?? [] {
    qs.push(("LexiconNames", x))
  }
  if let Some(x) = input.output_format { qs.push(("OutputFormat", x.value())) }
  if let Some(x) = input.sample_rate { qs.push(("SampleRate", x)) }
  for x in input.speech_mark_types ?? [] {
    qs.push(("SpeechMarkTypes", x.value()))
  }
  if let Some(x) = input.text { qs.push(("Text", x)) }
  if let Some(x) = input.text_type { qs.push(("TextType", x.value())) }
  if let Some(x) = input.voice_id { qs.push(("VoiceId", x.value())) }
  req = req with {
    method: "GET",
    query: rest.query(qs),
    body: b"",
    headers: req.headers.filter(fn(h: (Str, Str)) -> Bool { h.0.to_lower() != "content-type" }),
  }
