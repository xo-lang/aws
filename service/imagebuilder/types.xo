}

/// Contains details about a vulnerability scan finding that Amazon
/// Inspector generated for an image.
pub struct ImageScanFinding {
  /// The Amazon Web Services account ID that's associated with the finding.
  pub aws_account_id: Str? = None
  /// The Amazon Resource Name (ARN) of the image build version that's
  /// associated with the finding.
  pub image_build_version_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the image pipeline that's associated
  /// with the finding.
  pub image_pipeline_arn: Str? = None
  /// The type of the finding. Image Builder looks for findings of the type
  /// PACKAGE_VULNERABILITY that apply to output images, and excludes other
  /// types.
  pub type_value: Str? = None
  /// The description of the finding.
  pub description: Str? = None
  /// The title of the finding.
  pub title: Str? = None
  /// An object that contains the details about how to remediate the finding.
  pub remediation: Remediation? = None
  /// The severity of the finding. For more information, see Severity levels
  /// for Amazon Inspector findings in the Amazon Inspector User Guide .
  pub severity: Str? = None
  /// The date and time when the finding was first observed.
  pub first_observed_at: Time? = None
  /// The timestamp when the finding was last updated.
  pub updated_at: Time? = None
  /// The score that Amazon Inspector assigned for the finding.
  pub inspector_score: Float? = None
  /// An object that contains details of the Amazon Inspector score.
  pub inspector_score_details: InspectorScoreDetails? = None
  /// An object that contains the details of a package vulnerability finding.
  pub package_vulnerability_details: PackageVulnerabilityDetails? = None
  /// Details about whether a fix is available for any of the packages that
  /// are identified in the finding through a version update. Valid values
  /// include: YES – A fix is available for all of the packages identified
  /// in the finding. NO – No fix is available. PARTIAL – A fix is
  /// available for some, but not all, of the packages identified in the
  /// finding.
  pub fix_available: Str? = None
}

/// This returns exactly one type of aggregation, based on the filter that
/// Image Builder applies in its API action.
pub struct ImageScanFindingAggregation {
  /// Returns an object that contains severity counts based on an account ID.
  pub account_aggregation: AccountAggregation? = None
  /// Returns an object that contains severity counts based on the Amazon
  /// Resource Name (ARN) for a specific image.
  pub image_aggregation: ImageAggregation? = None
  /// Returns an object that contains severity counts based on an image
  /// pipeline ARN.
  pub image_pipeline_aggregation: ImagePipelineAggregation? = None
  /// Returns an object that contains severity counts based on vulnerability
  /// ID.
  pub vulnerability_id_aggregation: VulnerabilityIdAggregation? = None
}

/// A name value pair that Image Builder applies to streamline results from
/// the vulnerability scan findings list action.
pub struct ImageScanFindingsFilter {
  /// The name of the image scan finding filter. Filter names are
  /// case-sensitive. Valid filter names are: imageBuildVersionArn – Filters
  /// findings by the image build version that was scanned. imagePipelineArn
  /// – Filters findings by the pipeline that created the scanned image.
  /// vulnerabilityId – Filters findings by vulnerability ID, for example a
  /// CVE ID. severity – Filters findings by severity level.
  pub name: Str? = None
  /// The filter values. Filter values are case-sensitive.
  pub values: List[Str]? = None
}

/// Shows the vulnerability scan status for a specific image, and the reason
/// for that status.
pub struct ImageScanState {
  /// The current state of vulnerability scans for the image. The scan starts
  /// as PENDING and moves through SCANNING and COLLECTING to COMPLETED .
  /// Image Builder sets the status to ABANDONED if the image reaches a
  /// terminal state before the scan finding collection completes. A scan can
  /// also end as FAILED or TIMED_OUT .
  pub status: ImageScanStatus? = None
  /// The reason for the scan status for the image.
  pub reason: Str? = None
}

pub enum ImageScanStatus: Str {
  Pending = "PENDING"
  Scanning = "SCANNING"
  Collecting = "COLLECTING"
  Completed = "COMPLETED"
  Abandoned = "ABANDONED"
  Failed = "FAILED"
  TimedOut = "TIMED_OUT"
  Unknown(value: Str)
}

/// Contains settings for Image Builder image resource and container image
/// scans.
pub struct ImageScanningConfiguration {
  /// Specifies whether Amazon Inspector scans for vulnerabilities when you
  /// create a new image. You must also enable image tests. For AMI output,
  /// imageScanningTypes sets whether Amazon Inspector scans the test instance
  /// or the output AMI. For container output, Amazon Inspector scans the
  /// container image that Image Builder pushes to the Amazon ECR repository
  /// from your ecrConfiguration settings. To use container image scans, you
  /// must activate Amazon Inspector for Amazon ECR scanning in your account.
  /// The Image Builder ListImageScanFindings operation returns the findings
  /// of these scans.
  pub image_scanning_enabled: Bool? = None
  /// Contains Amazon ECR settings for vulnerability scans.
  pub ecr_configuration: EcrConfiguration? = None
  /// The type of vulnerability scan that Image Builder runs for AMI output
  /// when imageScanningEnabled is true . Specify a single value. If you omit
  /// imageScanningTypes , Image Builder uses TEST_INSTANCE_CVE . The scan
  /// types work as follows: With TEST_INSTANCE_CVE , Amazon Inspector scans
  /// the test instance during image tests. To use this scan, you must
  /// activate Amazon Inspector for Amazon EC2 scanning in your account. The
  /// Image Builder ListImageScanFindings operation returns the findings. With
  /// ON_DEMAND_AMI_CVE , Amazon Inspector starts an on-demand scan of the
  /// output AMI during image tests. To use this scan, you must build from an
  /// image recipe, but you do not need to activate Amazon Inspector in your
  /// account. The Amazon EC2 GetImageFindings operation returns the findings.
  pub image_scanning_types: List[ImageScanningType]? = None
  /// The condition that the output AMI's scan results must meet for the image
  /// to pass. You can set scanResultCondition only when imageScanningTypes is
  /// ON_DEMAND_AMI_CVE . If you omit it, Image Builder starts the scan but
  /// does not wait for it or use its results to pass or fail the image. When
  /// you set scanResultCondition , the test phase waits for the scan to
  /// finish. Then Image Builder checks the findings against the condition. By
  /// default, Image Builder counts only findings that have a fix available.
  /// To count every finding, set fixAvailable to false . If a counted finding
  /// exceeds maximumSeverityLabel , Image Builder fails the image in the test
  /// phase and does not distribute the AMI.
  pub scan_result_condition: ScanResultCondition? = None
}

pub enum ImageScanningType: Str {
  TestInstanceCve = "TEST_INSTANCE_CVE"
  OnDemandAmiCve = "ON_DEMAND_AMI_CVE"
  Unknown(value: Str)
}

pub enum ImageSource: Str {
  AmazonManaged = "AMAZON_MANAGED"
  AwsMarketplace = "AWS_MARKETPLACE"
  Imported = "IMPORTED"
  Custom = "CUSTOM"
  Unknown(value: Str)
}

/// Image status and the reason for that status.
pub struct ImageState {
  /// The status of the image. A new image moves through build, test, and
  /// distribution statuses during creation, and ends in the AVAILABLE ,
  /// FAILED , or CANCELLED state. The DEPRECATED , DISABLED , and DELETED
  /// statuses come from later resource management actions.
  pub status: ImageStatus? = None
  /// The reason for the status of the image.
  pub reason: Str? = None
  /// The details about the failure, for images that failed to complete. Image
  /// Builder only sets this property when the image status is FAILED .
  pub failure_context: ImageFailureContext? = None
}

pub enum ImageStatus: Str {
  Pending = "PENDING"
  Creating = "CREATING"
  Building = "BUILDING"
  Testing = "TESTING"
  Distributing = "DISTRIBUTING"
  Integrating = "INTEGRATING"
  Available = "AVAILABLE"
  Cancelled = "CANCELLED"
  Failed = "FAILED"
  Deprecated = "DEPRECATED"
  Deleted = "DELETED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// An image summary.
pub struct ImageSummary {
  /// The Amazon Resource Name (ARN) of the image.
  pub arn: Str? = None
  /// The name of the image.
  pub name: Str? = None
  /// Specifies whether this image produces an AMI or a container image.
  pub type_value: ImageType? = None
  /// The version of the image.
  pub version: Str? = None
