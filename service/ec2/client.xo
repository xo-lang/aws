  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.impaired_since {
    xmlv.elem(w, "impairedSince", rest.date_time(x), [])
  }
  if let Some(x) = v.remediation {
    xmlv.elem(w, "remediation", x, [])
  }
  xmlv.end(w, name)
}

