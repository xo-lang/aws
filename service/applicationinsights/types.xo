  /// The time when the problem started, in epoch seconds.
  pub start_time: Time? = None
  /// The time when the problem ended, in epoch seconds.
  pub end_time: Time? = None
  /// A measure of the level of impact of the problem.
  pub severity_level: SeverityLevel? = None
  /// The Amazon Web Services account ID for the owner of the resource group
  /// affected by the problem.
  pub account_id: Str? = None
  /// The name of the resource group affected by the problem.
  pub resource_group_name: Str? = None
  /// Feedback provided by the user about the problem.
  pub feedback: Map[Str, FeedbackValue]? = None
  /// The number of times that the same problem reoccurred after the first
  /// time it was resolved.
  pub recurring_count: Int? = None
  /// The last time that the problem reoccurred after its last resolution.
  pub last_recurrence_time: Time? = None
  /// Specifies whether or not you can view the problem. Updates to ignored
  /// problems do not generate notifications.
  pub visibility: Visibility? = None
  /// Specifies how the problem was resolved. If the value is AUTOMATIC , the
  /// system resolved the problem. If the value is MANUAL , the user resolved
  /// the problem. If the value is UNRESOLVED , then the problem is not
  /// resolved.
  pub resolution_method: ResolutionMethod? = None
}

