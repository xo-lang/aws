fn xml_write_origin(var w: xmlv.Writer, v: Origin, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.id {
    xmlv.elem(w, "Id", x, [])
  }
  if let Some(x) = v.domain_name {
    xmlv.elem(w, "DomainName", x, [])
  }
  if let Some(x) = v.origin_path {
    xmlv.elem(w, "OriginPath", x, [])
  }
  if let Some(x) = v.custom_headers {
    xml_write_custom_headers(w, x, "CustomHeaders", [])
  }
  if let Some(x) = v.s3_origin_config {
    xml_write_s3_origin_config(w, x, "S3OriginConfig", [])
  }
  if let Some(x) = v.custom_origin_config {
    xml_write_custom_origin_config(w, x, "CustomOriginConfig", [])
  }
  if let Some(x) = v.vpc_origin_config {
    xml_write_vpc_origin_config(w, x, "VpcOriginConfig", [])
  }
  if let Some(x) = v.connection_attempts {
    xmlv.elem(w, "ConnectionAttempts", "${x}", [])
  }
  if let Some(x) = v.connection_timeout {
    xmlv.elem(w, "ConnectionTimeout", "${x}", [])
  }
  if let Some(x) = v.response_completion_timeout {
    xmlv.elem(w, "ResponseCompletionTimeout", "${x}", [])
  }
  if let Some(x) = v.origin_shield {
    xml_write_origin_shield(w, x, "OriginShield", [])
  }
  if let Some(x) = v.origin_access_control_id {
    xmlv.elem(w, "OriginAccessControlId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_origin(e: xml.Element) -> Origin ! Str {
  var out = Origin{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Id" => out.id = c.text()
      "DomainName" => out.domain_name = c.text()
      "OriginPath" => out.origin_path = c.text()
      "CustomHeaders" => out.custom_headers = xml_read_custom_headers(c)?
      "S3OriginConfig" => out.s3_origin_config = xml_read_s3_origin_config(c)?
      "CustomOriginConfig" => out.custom_origin_config = xml_read_custom_origin_config(c)?
      "VpcOriginConfig" => out.vpc_origin_config = xml_read_vpc_origin_config(c)?
      "ConnectionAttempts" => out.connection_attempts = xmlv.read_int(c.text())?
      "ConnectionTimeout" => out.connection_timeout = xmlv.read_int(c.text())?
      "ResponseCompletionTimeout" => out.response_completion_timeout = xmlv.read_int(c.text())?
      "OriginShield" => out.origin_shield = xml_read_origin_shield(c)?
      "OriginAccessControlId" => out.origin_access_control_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

