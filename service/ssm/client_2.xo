    match k {
      "Id" => out.id = jsonv.read_str(fv)?
      "ReleaseDate" => out.release_date = jsonv.read_time(fv, "epoch-seconds")?
      "Title" => out.title = jsonv.read_str(fv)?
      "Description" => out.description = jsonv.read_str(fv)?
      "ContentUrl" => out.content_url = jsonv.read_str(fv)?
      "Vendor" => out.vendor = jsonv.read_str(fv)?
