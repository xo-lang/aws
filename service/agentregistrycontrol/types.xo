  Draft = "DRAFT"
  PendingApproval = "PENDING_APPROVAL"
  Approved = "APPROVED"
  Rejected = "REJECTED"
  Deprecated = "DEPRECATED"
  Creating = "CREATING"
  Updating = "UPDATING"
  CreateFailed = "CREATE_FAILED"
  UpdateFailed = "UPDATE_FAILED"
  CreatePendingAuth = "CREATE_PENDING_AUTH"
  UpdatePendingAuth = "UPDATE_PENDING_AUTH"
  Unknown(value: Str)
}

