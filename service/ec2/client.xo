fn xml_write_request_spot_instances_request(var w: xmlv.Writer, v: RequestSpotInstancesRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.launch_specification {
    xml_write_request_spot_launch_specification(w, x, "LaunchSpecification", [])
  }
  if let Some(x) = v.tag_specifications {
    xml_write_tag_specification_list(w, x, "TagSpecification", [])
  }
  if let Some(x) = v.instance_interruption_behavior {
    xmlv.elem(w, "InstanceInterruptionBehavior", x.value(), [])
  }
  if let Some(x) = v.dry_run {
    xmlv.elem(w, "dryRun", "${x}", [])
  }
  if let Some(x) = v.spot_price {
    xmlv.elem(w, "spotPrice", x, [])
  }
  if let Some(x) = v.client_token {
    xmlv.elem(w, "clientToken", x, [])
  }
  if let Some(x) = v.instance_count {
    xmlv.elem(w, "instanceCount", "${x}", [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "type", x.value(), [])
  }
  if let Some(x) = v.valid_from {
    xmlv.elem(w, "validFrom", rest.date_time(x), [])
  }
  if let Some(x) = v.valid_until {
    xmlv.elem(w, "validUntil", rest.date_time(x), [])
  }
  if let Some(x) = v.launch_group {
    xmlv.elem(w, "launchGroup", x, [])
  }
  if let Some(x) = v.availability_zone_group {
    xmlv.elem(w, "availabilityZoneGroup", x, [])
  }
  if let Some(x) = v.block_duration_minutes {
    xmlv.elem(w, "blockDurationMinutes", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_request_spot_instances_request(e: xml.Element) -> RequestSpotInstancesRequest ! Str {
  var out = RequestSpotInstancesRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "LaunchSpecification" => out.launch_specification = xml_read_request_spot_launch_specification(c)?
      "TagSpecification" => out.tag_specifications = xml_read_tag_specification_list(c)?
      "InstanceInterruptionBehavior" => out.instance_interruption_behavior = InstanceInterruptionBehavior.from(c.text())
      "dryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "spotPrice" => out.spot_price = c.text()
      "clientToken" => out.client_token = c.text()
      "instanceCount" => out.instance_count = xmlv.read_int(c.text())?
      "type" => out.type_value = SpotInstanceType.from(c.text())
      "validFrom" => out.valid_from = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "validUntil" => out.valid_until = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "launchGroup" => out.launch_group = c.text()
      "availabilityZoneGroup" => out.availability_zone_group = c.text()
      "blockDurationMinutes" => out.block_duration_minutes = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

