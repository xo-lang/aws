    ShowLocation(x) => json.Value.Object([("ShowLocation", json_of_rcs_show_location_action(x))])
    RequestLocation(x) => json.Value.Object([("RequestLocation", json_of_rcs_request_location_action(x))])
    CreateCalendarEvent(x) => json.Value.Object([("CreateCalendarEvent", json_of_rcs_create_calendar_event_action(x))])
    Unknown(_) => json.Value.Object([])
  }
