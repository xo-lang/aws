  pub kms_key_id: Str? = None
  /// True to enable mapping of Amazon Identity and Access Management (IAM)
  /// accounts to database accounts, and otherwise false. Default: false
  pub enable_iam_database_authentication: Bool? = None
  /// The list of logs that the restored DB cluster is to export to CloudWatch
  /// Logs.
  pub enable_cloudwatch_logs_exports: List[Str]? = None
  /// The name of the DB cluster parameter group to associate with the new DB
  /// cluster. Constraints: If supplied, must match the name of an existing
  /// DBClusterParameterGroup.
  pub db_cluster_parameter_group_name: Str? = None
  /// A value that indicates whether the DB cluster has deletion protection
  /// enabled. The database can't be deleted when deletion protection is
  /// enabled. By default, deletion protection is disabled.
  pub deletion_protection: Bool? = None
  /// Contains the scaling configuration of a Neptune Serverless DB cluster.
  /// For more information, see Using Amazon Neptune Serverless in the Amazon
  /// Neptune User Guide .
  pub serverless_v2_scaling_configuration: ServerlessV2ScalingConfiguration? = None
  /// Specifies the storage type to be associated with the DB cluster. Valid
  /// values: standard , iopt1 Default: standard
  pub storage_type: Str? = None
  /// The network type of the DB cluster. Valid Values: IPV4 – ( the default
  /// ) The DB cluster uses only IPv4 addresses for communication. DUAL –
  /// The DB cluster uses both IPv4 and IPv6 addresses for communication. The
  /// DB subnet group associated with the cluster must support IPv6.
  pub network_type: Str? = None
}

