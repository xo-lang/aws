      "dryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "instanceId" => out.instances = xml_read_instance_id_string_list(c)?
      "status" => out.status = ReportStatusType.from(c.text())
      "startTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "endTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "reasonCode" => out.reason_codes = xml_read_reason_codes_list(c)?
      "description" => out.description = c.text()
      _ => {}
    }
  }
  Ok(out)
}

