fn json_of_domain_association(v: DomainAssociation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.domain_association_arn {
    fs.push(("domainAssociationArn", json.Value.Str(x)))
  }
  if let Some(x) = v.domain_name {
    fs.push(("domainName", json.Value.Str(x)))
  }
  if let Some(x) = v.enable_auto_sub_domain {
    fs.push(("enableAutoSubDomain", json.Value.Bool(x)))
  }
  if let Some(x) = v.auto_sub_domain_creation_patterns {
    fs.push(("autoSubDomainCreationPatterns", json_of_auto_sub_domain_creation_patterns(x)))
  }
  if let Some(x) = v.auto_sub_domain_iam_role {
    fs.push(("autoSubDomainIAMRole", json.Value.Str(x)))
  }
  if let Some(x) = v.domain_status {
    fs.push(("domainStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.update_status {
    fs.push(("updateStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.status_reason {
    fs.push(("statusReason", json.Value.Str(x)))
  }
  if let Some(x) = v.certificate_verification_dns_record {
    fs.push(("certificateVerificationDNSRecord", json.Value.Str(x)))
  }
  if let Some(x) = v.sub_domains {
    fs.push(("subDomains", json_of_sub_domains(x)))
  }
  if let Some(x) = v.certificate {
    fs.push(("certificate", json_of_certificate(x)))
  }
  json.Value.Object(fs)
}

fn from_json_domain_association(v: json.Value) -> DomainAssociation ! Str {
  var out = DomainAssociation{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "domainAssociationArn" => out.domain_association_arn = jsonv.read_str(fv)?
      "domainName" => out.domain_name = jsonv.read_str(fv)?
      "enableAutoSubDomain" => out.enable_auto_sub_domain = jsonv.read_bool(fv)?
      "autoSubDomainCreationPatterns" => out.auto_sub_domain_creation_patterns = from_json_auto_sub_domain_creation_patterns(fv)?
      "autoSubDomainIAMRole" => out.auto_sub_domain_iam_role = jsonv.read_str(fv)?
      "domainStatus" => out.domain_status = DomainStatus.from(jsonv.read_str(fv)?)
      "updateStatus" => out.update_status = UpdateStatus.from(jsonv.read_str(fv)?)
      "statusReason" => out.status_reason = jsonv.read_str(fv)?
      "certificateVerificationDNSRecord" => out.certificate_verification_dns_record = jsonv.read_str(fv)?
      "subDomains" => out.sub_domains = from_json_sub_domains(fv)?
      "certificate" => out.certificate = from_json_certificate(fv)?
      _ => {}
    }
  }
  Ok(out)
}

