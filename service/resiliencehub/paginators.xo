pub fn (var p: ListUnsupportedAppVersionResourcesPaginator) next_page() -> ListUnsupportedAppVersionResourcesResponse ! ListUnsupportedAppVersionResourcesErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_unsupported_app_version_resources(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
