    Coordinate(x) => json.Value.Object([("Coordinate", json_of_coordinate(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_geocode_preference_value(v: json.Value) -> GeocodePreferenceValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "GeocoderHierarchy" => Ok(GeocodePreferenceValue.GeocoderHierarchy(from_json_geocoder_hierarchy(fv)?))
      "Coordinate" => Ok(GeocodePreferenceValue.Coordinate(from_json_coordinate(fv)?))
      _ => Ok(GeocodePreferenceValue.Unknown(k))
    }
  }
  Err("GeocodePreferenceValue: no member set")
}

