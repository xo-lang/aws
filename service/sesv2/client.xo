fn json_of_recommendation(v: Recommendation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.resource_arn {
    fs.push(("ResourceArn", json.Value.Str(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created_timestamp {
    fs.push(("CreatedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_updated_timestamp {
    fs.push(("LastUpdatedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
