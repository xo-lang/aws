/// Represents information about a job.
pub struct Job {
  /// The unique system-generated ID of the job.
  pub id: Str? = None
  /// Other data about a job.
  pub data: JobData? = None
  /// A system-generated random number that CodePipeline uses to ensure that
  /// the job is being worked on by only one job worker. Use this number in an
  /// AcknowledgeJob request.
  pub nonce: Str? = None
  /// The ID of the Amazon Web Services account to use when performing the
  /// job.
  pub account_id: Str? = None
}

/// Represents other information about a job required for a job worker to
/// complete the job.
pub struct JobData {
  /// Represents information about an action type.
  pub action_type_id: ActionTypeId? = None
  /// Represents information about an action configuration.
  pub action_configuration: ActionConfiguration? = None
  /// Represents information about a pipeline to a job worker. Includes
  /// pipelineArn and pipelineExecutionId for custom jobs.
  pub pipeline_context: PipelineContext? = None
  /// The artifact supplied to the job.
  pub input_artifacts: List[Artifact]? = None
  /// The output of the job.
  pub output_artifacts: List[Artifact]? = None
  /// Represents an Amazon Web Services session credentials object. These
  /// credentials are temporary credentials that are issued by Amazon Web
  /// Services Secure Token Service (STS). They can be used to access input
  /// and output artifacts in the S3 bucket used to store artifacts for the
  /// pipeline in CodePipeline.
  pub artifact_credentials: AWSSessionCredentials? = None
  /// A system-generated token, such as a deployment ID, required by a job to
  /// continue the job asynchronously.
  pub continuation_token: Str? = None
  /// Represents information about the key used to encrypt data in the
  /// artifact store, such as an KMS key.
  pub encryption_key: EncryptionKey? = None
}

/// Represents information about the details of a job.
pub struct JobDetails {
  /// The unique system-generated ID of the job.
  pub id: Str? = None
  /// Represents other information about a job required for a job worker to
  /// complete the job.
  pub data: JobData? = None
  /// The Amazon Web Services account ID associated with the job.
  pub account_id: Str? = None
}

/// The job was specified in an invalid format or cannot be found.
pub struct JobNotFoundException {
  /// The message provided to the user in the event of an exception.
  pub message: Str? = None
}

