  pub flush_stream_configuration: FlushStreamConfiguration? = None
}

/// The value of the "Text" parameter is longer than the accepted limits.
/// For the SynthesizeSpeech API, the limit for input text is a maximum of
/// 6000 characters total, of which no more than 3000 can be billed
/// characters. For the StartSpeechSynthesisTask API, the maximum is 200,000
/// characters, of which no more than 100,000 can be billed characters. SSML
/// tags are not counted as billed characters.
pub struct TextLengthExceededException {
  pub message: Str? = None
}

pub enum TextType: Str {
  Ssml = "ssml"
  Text = "text"
  Unknown(value: Str)
}

/// The request was denied because of request throttling.
pub struct ThrottlingException {
  pub message: Str? = None
