/// A significant event that happened during the incident.
pub struct TimelineEvent {
  /// The Amazon Resource Name (ARN) of the incident that the event occurred
  /// during.
  pub incident_record_arn: Str? = None
  /// The ID of the timeline event.
  pub event_id: Str? = None
  /// The timestamp for when the event occurred.
  pub event_time: Time? = None
  /// The timestamp for when the timeline event was last updated.
  pub event_updated_time: Time? = None
  /// The type of event that occurred. Currently Incident Manager supports
  /// only the Custom Event and Note types.
  pub event_type: Str? = None
  /// A short description of the event.
  pub event_data: Str? = None
  /// A list of references in a TimelineEvent .
  pub event_references: List[EventReference]? = None
}

/// Details about what caused the incident to be created in Incident
/// Manager.
pub struct TriggerDetails {
  /// Identifies the service that sourced the event. All events sourced from
  /// within Amazon Web Services begin with " aws. " Customer-generated events
  /// can have any value here, as long as it doesn't begin with " aws. " We
  /// recommend the use of Java package-name style reverse domain-name
  /// strings.
  pub source: Str? = None
  /// The Amazon Resource Name (ARN) of the source that detected the incident.
  pub trigger_arn: Str? = None
  /// The timestamp for when the incident was detected.
  pub timestamp: Time? = None
  /// Raw data passed from either Amazon EventBridge, Amazon CloudWatch, or
  /// Incident Manager when an incident is created.
  pub raw_data: Str? = None
}

