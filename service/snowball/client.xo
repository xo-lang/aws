      "ForwardingAddressId" => out.forwarding_address_id = jsonv.read_str(fv)?
      "TaxDocuments" => out.tax_documents = from_json_tax_documents(fv)?
      "DeviceConfiguration" => out.device_configuration = from_json_device_configuration(fv)?
      "RemoteManagement" => out.remote_management = RemoteManagement.from(jsonv.read_str(fv)?)
      "LongTermPricingId" => out.long_term_pricing_id = jsonv.read_str(fv)?
