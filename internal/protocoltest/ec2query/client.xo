    xmlv.elem(w, "StringArg", x, [])
  }
  if let Some(x) = v.other_arg {
    xmlv.elem(w, "OtherArg", "${x}", [])
  }
  if let Some(x) = v.recursive_arg {
    xml_write_struct_arg(w, x, "RecursiveArg", [])
  }
  xmlv.end(w, name)
}

fn xml_read_struct_arg(e: xml.Element) -> StructArg ! Str {
  var out = StructArg{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "StringArg" => out.string_arg = c.text()
      "OtherArg" => out.other_arg = xmlv.read_bool(c.text())?
      "RecursiveArg" => out.recursive_arg = xml_read_struct_arg(c)?
      _ => {}
    }
  }
  Ok(out)
}

