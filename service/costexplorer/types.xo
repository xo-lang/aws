  /// threshold: { "Dimensions": { "Key": "ANOMALY_TOTAL_IMPACT_PERCENTAGE",
  /// "MatchOptions": [ "GREATER_THAN_OR_EQUAL" ], "Values": [ "100" ] } } AND
  /// two thresholds together: { "And": [ { "Dimensions": { "Key":
  /// "ANOMALY_TOTAL_IMPACT_ABSOLUTE", "MatchOptions": [
  /// "GREATER_THAN_OR_EQUAL" ], "Values": [ "100" ] } }, { "Dimensions": {
