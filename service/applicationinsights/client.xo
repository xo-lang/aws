  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.affected_resource {
    fs.push(("AffectedResource", json.Value.Str(x)))
  }
  if let Some(x) = v.start_time {
    fs.push(("StartTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.end_time {
    fs.push(("EndTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.severity_level {
    fs.push(("SeverityLevel", json.Value.Str(x.value())))
  }
  if let Some(x) = v.account_id {
    fs.push(("AccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.resource_group_name {
    fs.push(("ResourceGroupName", json.Value.Str(x)))
  }
  if let Some(x) = v.feedback {
    fs.push(("Feedback", json_of_feedback(x)))
  }
  if let Some(x) = v.recurring_count {
    fs.push(("RecurringCount", json.Value.Int(x)))
  }
  if let Some(x) = v.last_recurrence_time {
    fs.push(("LastRecurrenceTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.visibility {
    fs.push(("Visibility", json.Value.Str(x.value())))
  }
  if let Some(x) = v.resolution_method {
    fs.push(("ResolutionMethod", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

