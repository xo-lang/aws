    let e = if flat { "${prefix}.${i + 1}" } else { "${prefix}.entry.${i + 1}" }
    query.add(f, "${e}.key", k)
    if let Some(x) = v.get(k) {
      query.add(f, "${e}.value", x)
    }
  }
}

