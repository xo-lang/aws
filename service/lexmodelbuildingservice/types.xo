/// The resource that you are attempting to delete is referred to by another
/// resource. Use this information to remove references to the resource that
/// you are trying to delete. The body of the exception contains a JSON
/// object that describes the resource. { "resourceType": BOT | BOTALIAS |
/// BOTCHANNEL | INTENT, "resourceReference": { "name": string , "version":
/// string } }
pub struct ResourceInUseException {
  pub reference_type: ReferenceType? = None
  pub example_reference: ResourceReference? = None
}

/// Describes the resource that refers to the resource that you are
/// attempting to delete. This object is returned as part of the
/// ResourceInUseException exception.
pub struct ResourceReference {
  /// The name of the resource that is using the resource that you are trying
  /// to delete.
  pub name: Str? = None
  /// The version of the resource that is using the resource that you are
  /// trying to delete.
  pub version: Str? = None
}

pub enum ResourceType: Str {
  Bot = "BOT"
  Intent = "INTENT"
  SlotType = "SLOT_TYPE"
  Unknown(value: Str)
}

/// Identifies the version of a specific slot.
pub struct Slot {
  /// The name of the slot.
  pub name: Str? = None
  /// A description of the slot.
  pub description: Str? = None
  /// Specifies whether the slot is required or optional.
  pub slot_constraint: SlotConstraint? = None
  /// The type of the slot, either a custom slot type that you defined or one
  /// of the built-in slot types.
  pub slot_type: Str? = None
  /// The version of the slot type.
  pub slot_type_version: Str? = None
  /// The prompt that Amazon Lex uses to elicit the slot value from the user.
  pub value_elicitation_prompt: Prompt? = None
  /// Directs Amazon Lex the order in which to elicit this slot value from the
  /// user. For example, if the intent has two slots with priorities 1 and 2,
  /// AWS Amazon Lex first elicits a value for the slot with priority 1. If
  /// multiple slots share the same priority, the order in which Amazon Lex
  /// elicits values is arbitrary.
  pub priority: Int? = None
  /// If you know a specific pattern with which users might respond to an
  /// Amazon Lex request for a slot value, you can provide those utterances to
  /// improve accuracy. This is optional. In most cases, Amazon Lex is capable
  /// of understanding user utterances.
  pub sample_utterances: List[Str]? = None
  /// A set of possible responses for the slot type used by text-based
  /// clients. A user chooses an option from the response card, instead of
  /// using text to reply.
  pub response_card: Str? = None
  /// Determines whether a slot is obfuscated in conversation logs and stored
  /// utterances. When you obfuscate a slot, the value is replaced by the slot
  /// name in curly braces ({}). For example, if the slot name is "full_name",
  /// obfuscated values are replaced with "{full_name}". For more information,
  /// see Slot Obfuscation .
  pub obfuscation_setting: ObfuscationSetting? = None
  /// A list of default values for the slot. Default values are used when
  /// Amazon Lex hasn't determined a value for a slot. You can specify default
  /// values from context variables, session attributes, and defined values.
  pub default_value_spec: SlotDefaultValueSpec? = None
}

pub enum SlotConstraint: Str {
  Required = "Required"
  Optional = "Optional"
  Unknown(value: Str)
}

/// A default value for a slot.
pub struct SlotDefaultValue {
  /// The default value for the slot. You can specify one of the following:
  /// #context-name.slot-name - The slot value "slot-name" in the context
  /// "context-name." {attribute} - The slot value of the session attribute
  /// "attribute." 'value' - The discrete value "value."
  pub default_value: Str? = None
}

/// Contains the default values for a slot. Default values are used when
/// Amazon Lex hasn't determined a value for a slot.
pub struct SlotDefaultValueSpec {
  /// The default values for a slot. You can specify more than one default.
  /// For example, you can specify a default value to use from a matching
  /// context variable, a session attribute, or a fixed value. The default
  /// value chosen is selected based on the order that you specify them in the
  /// list. For example, if you specify a context variable and a fixed value
  /// in that order, Amazon Lex uses the context variable if it is available,
  /// else it uses the fixed value.
  pub default_value_list: List[SlotDefaultValue]? = None
}

/// Provides configuration information for a slot type.
pub struct SlotTypeConfiguration {
  /// A regular expression used to validate the value of a slot.
  pub regex_configuration: SlotTypeRegexConfiguration? = None
}

/// Provides information about a slot type..
pub struct SlotTypeMetadata {
  /// The name of the slot type.
  pub name: Str? = None
  /// A description of the slot type.
  pub description: Str? = None
  /// The date that the slot type was updated. When you create a resource, the
