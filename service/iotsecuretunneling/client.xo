  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.tunnel_id {
    fs.push(("tunnelId", json.Value.Str(x)))
  }
  if let Some(x) = input.client_mode {
    fs.push(("clientMode", json.Value.Str(x.value())))
  }
  if let Some(x) = input.destination_config {
    fs.push(("destinationConfig", json_of_destination_config(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.1"))
  headers.push(("X-Amz-Target", "IoTSecuredTunneling.RotateTunnelAccessToken"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_rotate_tunnel_access_token(resp: http.Response) -> RotateTunnelAccessTokenResponse ! Str {
  var out = RotateTunnelAccessTokenResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "tunnelArn" => out.tunnel_arn = jsonv.read_str(fv)?
      "sourceAccessToken" => out.source_access_token = jsonv.read_str(fv)?
      "destinationAccessToken" => out.destination_access_token = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

