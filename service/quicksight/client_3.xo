fn json_of_free_form_layout_element(v: FreeFormLayoutElement) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.element_id {
    fs.push(("ElementId", json.Value.Str(x)))
  }
  if let Some(x) = v.element_type {
    fs.push(("ElementType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.x_axis_location {
    fs.push(("XAxisLocation", json.Value.Str(x)))
  }
  if let Some(x) = v.y_axis_location {
