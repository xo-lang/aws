  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the destination domain dataset group
  /// for the recommender.
  pub dataset_group_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the recipe that the recommender will
  /// use. For a recommender, a recipe is a Domain dataset group use case.
  /// Only Domain dataset group use cases can be used to create a recommender.
  /// For information about use cases see Choosing recommender use cases .
  pub recipe_arn: Str? = None
  /// The configuration details of the recommender.
  pub recommender_config: RecommenderConfig? = None
  /// A list of tags to apply to the recommender.
  pub tags: List[Tag]? = None
}

pub struct CreateRecommenderResponse {
  /// The Amazon Resource Name (ARN) of the recommender.
  pub recommender_arn: Str? = None
}

pub struct CreateSchemaRequest {
  /// The name for the schema.
  pub name: Str? = None
  /// A schema in Avro JSON format.
  pub schema: Str? = None
  /// The domain for the schema. If you are creating a schema for a dataset in
  /// a Domain dataset group, specify the domain you chose when you created
  /// the Domain dataset group.
  pub domain: Domain? = None
}

pub struct CreateSchemaResponse {
  /// The Amazon Resource Name (ARN) of the created schema.
  pub schema_arn: Str? = None
}

pub struct CreateSolutionRequest {
  /// The name for the solution.
  pub name: Str? = None
  /// Whether to perform hyperparameter optimization (HPO) on the specified or
  /// selected recipe. The default is false . When performing AutoML, this
  /// parameter is always true and you should not set it to false .
  pub perform_hpo: Bool? = None
  /// We don't recommend enabling automated machine learning. Instead, match
  /// your use case to the available Amazon Personalize recipes. For more
  /// information, see Choosing a recipe . Whether to perform automated
  /// machine learning (AutoML). The default is false . For this case, you
  /// must specify recipeArn . When set to true , Amazon Personalize analyzes
  /// your training data and selects the optimal USER_PERSONALIZATION recipe
  /// and hyperparameters. In this case, you must omit recipeArn . Amazon
  /// Personalize determines the optimal recipe by running tests with
  /// different values for the hyperparameters. AutoML lengthens the training
  /// process as compared to selecting a specific recipe.
  pub perform_auto_ml: Bool? = None
  /// Whether the solution uses automatic training to create new solution
  /// versions (trained models). The default is True and the solution
  /// automatically creates new solution versions every 7 days. You can change
  /// the training frequency by specifying a schedulingExpression in the
  /// AutoTrainingConfig as part of solution configuration. For more
  /// information about automatic training, see Configuring automatic training
  /// . Automatic solution version creation starts within one hour after the
  /// solution is ACTIVE. If you manually create a solution version within the
  /// hour, the solution skips the first automatic training. After training
  /// starts, you can get the solution version's Amazon Resource Name (ARN)
  /// with the ListSolutionVersions API operation. To get its status, use the
  /// DescribeSolutionVersion .
  pub perform_auto_training: Bool? = None
  /// Whether to perform incremental training updates on your model. When
  /// enabled, this allows the model to learn from new data more frequently
  /// without requiring full retraining, which enables near real-time
  /// personalization. This parameter is supported only for solutions that use
  /// the semantic-similarity recipe.
  pub perform_incremental_update: Bool? = None
  /// The Amazon Resource Name (ARN) of the recipe to use for model training.
  /// This is required when performAutoML is false. For information about
  /// different Amazon Personalize recipes and their ARNs, see Choosing a
  /// recipe .
  pub recipe_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset group that provides the
  /// training data.
  pub dataset_group_arn: Str? = None
  /// When your have multiple event types (using an EVENT_TYPE schema field),
  /// this parameter specifies which event type (for example, 'click' or
  /// 'like') is used for training the model. If you do not provide an
  /// eventType , Amazon Personalize will use all interactions for training
  /// with equal weight regardless of type.
  pub event_type: Str? = None
  /// The configuration properties for the solution. When performAutoML is set
  /// to true, Amazon Personalize only evaluates the autoMLConfig section of
  /// the solution configuration. Amazon Personalize doesn't support
  /// configuring the hpoObjective at this time.
  pub solution_config: SolutionConfig? = None
  /// A list of tags to apply to the solution.
  pub tags: List[Tag]? = None
}

pub struct CreateSolutionResponse {
  /// The ARN of the solution.
  pub solution_arn: Str? = None
}

pub struct CreateSolutionVersionRequest {
  /// The name of the solution version.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the solution containing the training
  /// configuration information.
  pub solution_arn: Str? = None
  /// The scope of training to be performed when creating the solution
  /// version. The default is FULL . This creates a completely new model based
  /// on the entirety of the training data from the datasets in your dataset
  /// group. If you use User-Personalization , you can specify a training mode
  /// of UPDATE . This updates the model to consider new items for
  /// recommendations. It is not a full retraining. You should still complete
  /// a full retraining weekly. If you specify UPDATE , Amazon Personalize
  /// will stop automatic updates for the solution version. To resume updates,
  /// create a new solution with training mode set to FULL and deploy it in a
  /// campaign. For more information about automatic updates, see Automatic
  /// updates . The UPDATE option can only be used when you already have an
  /// active solution version created from the input solution using the FULL
  /// option and the input solution was trained with the User-Personalization
  /// recipe or the legacy HRNN-Coldstart recipe.
  pub training_mode: TrainingMode? = None
  /// A list of tags to apply to the solution version.
  pub tags: List[Tag]? = None
}

pub struct CreateSolutionVersionResponse {
  /// The ARN of the new solution version.
  pub solution_version_arn: Str? = None
}

/// Describes a job that deletes all references to specific users from an
/// Amazon Personalize dataset group in batches. For information about
/// creating a data deletion job, see Deleting users .
pub struct DataDeletionJob {
  /// The name of the data deletion job.
  pub job_name: Str? = None
  /// The Amazon Resource Name (ARN) of the data deletion job.
  pub data_deletion_job_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset group the job deletes
  /// records from.
  pub dataset_group_arn: Str? = None
  pub data_source: DataSource? = None
  /// The Amazon Resource Name (ARN) of the IAM role that has permissions to
  /// read from the Amazon S3 data source.
  pub role_arn: Str? = None
  /// The status of the data deletion job. A data deletion job can have one of
  /// the following statuses: PENDING IN_PROGRESS COMPLETED -or- FAILED
  pub status: Str? = None
  /// The number of records deleted by a COMPLETED job.
  pub num_deleted: Int? = None
  /// The creation date and time (in Unix time) of the data deletion job.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) the data deletion job was last updated.
  pub last_updated_date_time: Time? = None
  /// If a data deletion job fails, provides the reason why.
  pub failure_reason: Str? = None
}

/// Provides a summary of the properties of a data deletion job. For a
/// complete listing, call the DescribeDataDeletionJob API operation.
pub struct DataDeletionJobSummary {
  /// The Amazon Resource Name (ARN) of the data deletion job.
  pub data_deletion_job_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset group the job deleted
  /// records from.
  pub dataset_group_arn: Str? = None
  /// The name of the data deletion job.
  pub job_name: Str? = None
  /// The status of the data deletion job. A data deletion job can have one of
  /// the following statuses: PENDING IN_PROGRESS COMPLETED -or- FAILED
  pub status: Str? = None
  /// The creation date and time (in Unix time) of the data deletion job.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) the data deletion job was last updated.
  pub last_updated_date_time: Time? = None
  /// If a data deletion job fails, provides the reason why.
  pub failure_reason: Str? = None
}

/// Describes the data source that contains the data to upload to a dataset,
/// or the list of records to delete from Amazon Personalize.
pub struct DataSource {
  /// For dataset import jobs, the path to the Amazon S3 bucket where the data
  /// that you want to upload to your dataset is stored. For data deletion
  /// jobs, the path to the Amazon S3 bucket that stores the list of records
  /// to delete. For example: s3://bucket-name/folder-name/fileName.csv If
  /// your CSV files are in a folder in your Amazon S3 bucket and you want
  /// your import job or data deletion job to consider multiple files, you can
  /// specify the path to the folder. With a data deletion job, Amazon
  /// Personalize uses all files in the folder and any sub folder. Use the
  /// following syntax with a / after the folder name:
  /// s3://bucket-name/folder-name/
  pub data_location: Str? = None
}

/// Provides metadata for a dataset.
pub struct Dataset {
  /// The name of the dataset.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset that you want metadata
  /// for.
  pub dataset_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset group.
  pub dataset_group_arn: Str? = None
  /// One of the following values: Interactions Items Users Actions
  /// Action_Interactions
  pub dataset_type: Str? = None
  /// The ARN of the associated schema.
  pub schema_arn: Str? = None
  /// The status of the dataset. A dataset can be in one of the following
  /// states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or- CREATE FAILED
  /// DELETE PENDING DELETE IN_PROGRESS
  pub status: Str? = None
  /// The creation date and time (in Unix time) of the dataset.
  pub creation_date_time: Time? = None
  /// A time stamp that shows when the dataset was updated.
  pub last_updated_date_time: Time? = None
  /// Describes the latest update to the dataset.
  pub latest_dataset_update: DatasetUpdateSummary? = None
  /// The ID of the event tracker for an Action interactions dataset. You
  /// specify the tracker's ID in the PutActionInteractions API operation.
  /// Amazon Personalize uses it to direct new data to the Action interactions
  /// dataset in your dataset group.
  pub tracking_id: Str? = None
}

/// Describes a job that exports a dataset to an Amazon S3 bucket. For more
/// information, see CreateDatasetExportJob . A dataset export job can be in
/// one of the following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE
/// -or- CREATE FAILED
pub struct DatasetExportJob {
  /// The name of the export job.
  pub job_name: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset export job.
  pub dataset_export_job_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset to export.
  pub dataset_arn: Str? = None
  /// The data to export, based on how you imported the data. You can choose
  /// to export BULK data that you imported using a dataset import job, PUT
  /// data that you imported incrementally (using the console, PutEvents,
  /// PutUsers and PutItems operations), or ALL for both types. The default
  /// value is PUT .
  pub ingestion_mode: IngestionMode? = None
  /// The Amazon Resource Name (ARN) of the IAM service role that has
  /// permissions to add data to your output Amazon S3 bucket.
  pub role_arn: Str? = None
  /// The status of the dataset export job. A dataset export job can be in one
  /// of the following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or-
  /// CREATE FAILED
  pub status: Str? = None
  /// The path to the Amazon S3 bucket where the job's output is stored. For
  /// example: s3://bucket-name/folder-name/
  pub job_output: DatasetExportJobOutput? = None
  /// The creation date and time (in Unix time) of the dataset export job.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) the status of the dataset export job
  /// was last updated.
  pub last_updated_date_time: Time? = None
  /// If a dataset export job fails, provides the reason why.
  pub failure_reason: Str? = None
}

/// The output configuration parameters of a dataset export job.
pub struct DatasetExportJobOutput {
  pub s3_data_destination: S3DataConfig? = None
}

/// Provides a summary of the properties of a dataset export job. For a
/// complete listing, call the DescribeDatasetExportJob API.
pub struct DatasetExportJobSummary {
  /// The Amazon Resource Name (ARN) of the dataset export job.
  pub dataset_export_job_arn: Str? = None
  /// The name of the dataset export job.
  pub job_name: Str? = None
  /// The status of the dataset export job. A dataset export job can be in one
  /// of the following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or-
  /// CREATE FAILED
  pub status: Str? = None
  /// The date and time (in Unix time) that the dataset export job was
  /// created.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) that the dataset export job status was
  /// last updated.
  pub last_updated_date_time: Time? = None
  /// If a dataset export job fails, the reason behind the failure.
  pub failure_reason: Str? = None
}

/// A dataset group is a collection of related datasets (Item interactions,
/// Users, Items, Actions, Action interactions). You create a dataset group
/// by calling CreateDatasetGroup . You then create a dataset and add it to
/// a dataset group by calling CreateDataset . The dataset group is used to
/// create and train a solution by calling CreateSolution . A dataset group
/// can contain only one of each type of dataset. You can specify an Key
/// Management Service (KMS) key to encrypt the datasets in the group.
pub struct DatasetGroup {
  /// The name of the dataset group.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset group.
  pub dataset_group_arn: Str? = None
  /// The current status of the dataset group. A dataset group can be in one
  /// of the following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or-
  /// CREATE FAILED DELETE PENDING
  pub status: Str? = None
  /// The ARN of the Identity and Access Management (IAM) role that has
  /// permissions to access the Key Management Service (KMS) key. Supplying an
  /// IAM role is only valid when also specifying a KMS key.
  pub role_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the Key Management Service (KMS) key
  /// used to encrypt the datasets.
  pub kms_key_arn: Str? = None
  /// The creation date and time (in Unix time) of the dataset group.
  pub creation_date_time: Time? = None
  /// The last update date and time (in Unix time) of the dataset group.
  pub last_updated_date_time: Time? = None
  /// If creating a dataset group fails, provides the reason why.
  pub failure_reason: Str? = None
  /// The domain of a Domain dataset group.
  pub domain: Domain? = None
}

/// Provides a summary of the properties of a dataset group. For a complete
/// listing, call the DescribeDatasetGroup API.
pub struct DatasetGroupSummary {
  /// The name of the dataset group.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset group.
  pub dataset_group_arn: Str? = None
  /// The status of the dataset group. A dataset group can be in one of the
  /// following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or- CREATE
  /// FAILED DELETE PENDING
  pub status: Str? = None
  /// The date and time (in Unix time) that the dataset group was created.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) that the dataset group was last
  /// updated.
  pub last_updated_date_time: Time? = None
  /// If creating a dataset group fails, the reason behind the failure.
  pub failure_reason: Str? = None
  /// The domain of a Domain dataset group.
  pub domain: Domain? = None
}

/// Describes a job that imports training data from a data source (Amazon S3
/// bucket) to an Amazon Personalize dataset. For more information, see
/// CreateDatasetImportJob . A dataset import job can be in one of the
/// following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or- CREATE
/// FAILED
pub struct DatasetImportJob {
  /// The name of the import job.
  pub job_name: Str? = None
  /// The ARN of the dataset import job.
  pub dataset_import_job_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the dataset that receives the imported
  /// data.
  pub dataset_arn: Str? = None
  /// The Amazon S3 bucket that contains the training data to import.
  pub data_source: DataSource? = None
  /// The ARN of the IAM role that has permissions to read from the Amazon S3
  /// data source.
  pub role_arn: Str? = None
  /// The status of the dataset import job. A dataset import job can be in one
  /// of the following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or-
  /// CREATE FAILED
  pub status: Str? = None
  /// The creation date and time (in Unix time) of the dataset import job.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) the dataset was last updated.
  pub last_updated_date_time: Time? = None
  /// If a dataset import job fails, provides the reason why.
  pub failure_reason: Str? = None
  /// The import mode used by the dataset import job to import new records.
  pub import_mode: ImportMode? = None
  /// Whether the job publishes metrics to Amazon S3 for a metric attribution.
  pub publish_attribution_metrics_to_s3: Bool? = None
}

/// Provides a summary of the properties of a dataset import job. For a
/// complete listing, call the DescribeDatasetImportJob API.
pub struct DatasetImportJobSummary {
  /// The Amazon Resource Name (ARN) of the dataset import job.
  pub dataset_import_job_arn: Str? = None
  /// The name of the dataset import job.
  pub job_name: Str? = None
  /// The status of the dataset import job. A dataset import job can be in one
  /// of the following states: CREATE PENDING CREATE IN_PROGRESS ACTIVE -or-
  /// CREATE FAILED
  pub status: Str? = None
  /// The date and time (in Unix time) that the dataset import job was
  /// created.
  pub creation_date_time: Time? = None
  /// The date and time (in Unix time) that the dataset import job status was
  /// last updated.
  pub last_updated_date_time: Time? = None
  /// If a dataset import job fails, the reason behind the failure.
  pub failure_reason: Str? = None
  /// The import mode the dataset import job used to update the data in the
  /// dataset. For more information see Updating existing bulk data .
  pub import_mode: ImportMode? = None
}

