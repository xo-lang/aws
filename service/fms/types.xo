}

/// The violation details for a third-party firewall that's not associated
/// with an Firewall Manager managed route table.
pub struct ThirdPartyFirewallMissingExpectedRouteTableViolation {
  /// The ID of the third-party firewall or VPC resource that's causing the
  /// violation.
  pub violation_target: Str? = None
  /// The resource ID of the VPC associated with a fireawll subnet that's
  /// causing the violation.
  pub vpc: Str? = None
  /// The Availability Zone of the firewall subnet that's causing the
  /// violation.
  pub availability_zone: Str? = None
  /// The resource ID of the current route table that's associated with the
  /// subnet, if one is available.
  pub current_route_table: Str? = None
  /// The resource ID of the route table that should be associated with the
  /// subnet.
  pub expected_route_table: Str? = None
}

/// The violation details about a third-party firewall's subnet that doesn't
/// have a Firewall Manager managed firewall in its VPC.
pub struct ThirdPartyFirewallMissingFirewallViolation {
  /// The ID of the third-party firewall that's causing the violation.
  pub violation_target: Str? = None
  /// The resource ID of the VPC associated with a third-party firewall.
  pub vpc: Str? = None
  /// The Availability Zone of the third-party firewall that's causing the
  /// violation.
  pub availability_zone: Str? = None
  /// The reason the resource is causing this violation, if a reason is
  /// available.
  pub target_violation_reason: Str? = None
}

/// The violation details for a third-party firewall for an Availability
/// Zone that's missing the Firewall Manager managed subnet.
pub struct ThirdPartyFirewallMissingSubnetViolation {
  /// The ID of the third-party firewall or VPC resource that's causing the
  /// violation.
  pub violation_target: Str? = None
  /// The resource ID of the VPC associated with a subnet that's causing the
  /// violation.
  pub vpc: Str? = None
  /// The Availability Zone of a subnet that's causing the violation.
  pub availability_zone: Str? = None
  /// The reason the resource is causing the violation, if a reason is
  /// available.
  pub target_violation_reason: Str? = None
}

/// Configures the deployment model for the third-party firewall.
pub struct ThirdPartyFirewallPolicy {
  /// Defines the deployment model to use for the third-party firewall policy.
  pub firewall_deployment_model: FirewallDeploymentModel? = None
}

pub struct UntagResourceRequest {
  /// The Amazon Resource Name (ARN) of the resource to return tags for. The
  /// Firewall Manager resources that support tagging are policies,
  /// applications lists, and protocols lists.
  pub resource_arn: Str? = None
  /// The keys of the tags to remove from the resource.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

/// Violations for a resource based on the specified Firewall Manager policy
/// and Amazon Web Services account.
pub struct ViolationDetail {
  /// The ID of the Firewall Manager policy that the violation details were
  /// requested for.
  pub policy_id: Str? = None
  /// The Amazon Web Services account that the violation details were
  /// requested for.
  pub member_account: Str? = None
  /// The resource ID that the violation details were requested for.
  pub resource_id: Str? = None
  /// The resource type that the violation details were requested for.
  pub resource_type: Str? = None
  /// List of violations for the requested resource.
  pub resource_violations: List[ResourceViolation]? = None
  /// The ResourceTag objects associated with the resource.
  pub resource_tags: List[Tag]? = None
  /// Brief description for the requested resource.
  pub resource_description: Str? = None
}

pub enum ViolationReason: Str {
  WebAclMissingRuleGroup = "WEB_ACL_MISSING_RULE_GROUP"
  ResourceMissingWebAcl = "RESOURCE_MISSING_WEB_ACL"
  ResourceIncorrectWebAcl = "RESOURCE_INCORRECT_WEB_ACL"
  ResourceMissingShieldProtection = "RESOURCE_MISSING_SHIELD_PROTECTION"
  ResourceMissingWebaclOrShieldProtection = "RESOURCE_MISSING_WEB_ACL_OR_SHIELD_PROTECTION"
  ResourceMissingSecurityGroup = "RESOURCE_MISSING_SECURITY_GROUP"
  ResourceViolatesAuditSecurityGroup = "RESOURCE_VIOLATES_AUDIT_SECURITY_GROUP"
  SecurityGroupUnused = "SECURITY_GROUP_UNUSED"
  SecurityGroupRedundant = "SECURITY_GROUP_REDUNDANT"
  FmsCreatedSecurityGroupEdited = "FMS_CREATED_SECURITY_GROUP_EDITED"
  MissingFirewall = "MISSING_FIREWALL"
  MissingFirewallSubnetInAz = "MISSING_FIREWALL_SUBNET_IN_AZ"
  MissingExpectedRouteTable = "MISSING_EXPECTED_ROUTE_TABLE"
  NetworkFirewallPolicyModified = "NETWORK_FIREWALL_POLICY_MODIFIED"
  FirewallSubnetIsOutOfScope = "FIREWALL_SUBNET_IS_OUT_OF_SCOPE"
  InternetGatewayMissingExpectedRoute = "INTERNET_GATEWAY_MISSING_EXPECTED_ROUTE"
  FirewallSubnetMissingExpectedRoute = "FIREWALL_SUBNET_MISSING_EXPECTED_ROUTE"
  UnexpectedFirewallRoutes = "UNEXPECTED_FIREWALL_ROUTES"
  UnexpectedTargetGatewayRoutes = "UNEXPECTED_TARGET_GATEWAY_ROUTES"
  TrafficInspectionCrossesAzBoundary = "TRAFFIC_INSPECTION_CROSSES_AZ_BOUNDARY"
  InvalidRouteConfiguration = "INVALID_ROUTE_CONFIGURATION"
  MissingTargetGateway = "MISSING_TARGET_GATEWAY"
  InternetTrafficNotInspected = "INTERNET_TRAFFIC_NOT_INSPECTED"
  BlackHoleRouteDetected = "BLACK_HOLE_ROUTE_DETECTED"
  BlackHoleRouteDetectedInFirewallSubnet = "BLACK_HOLE_ROUTE_DETECTED_IN_FIREWALL_SUBNET"
  ResourceMissingDnsFirewall = "RESOURCE_MISSING_DNS_FIREWALL"
  RouteHasOutOfScopeEndpoint = "ROUTE_HAS_OUT_OF_SCOPE_ENDPOINT"
  FirewallSubnetMissingVpcEndpoint = "FIREWALL_SUBNET_MISSING_VPCE_ENDPOINT"
  InvalidNetworkAclEntry = "INVALID_NETWORK_ACL_ENTRY"
  WebAclConfigurationOrScopeOfUse = "WEB_ACL_CONFIGURATION_OR_SCOPE_OF_USE"
  Unknown(value: Str)
}

/// The violation details for a web ACL whose configuration is incompatible
/// with the Firewall Manager policy.
pub struct WebACLHasIncompatibleConfigurationViolation {
  /// The Amazon Resource Name (ARN) of the web ACL.
  pub web_acl_arn: Str? = None
  /// Information about the problems that Firewall Manager encountered with
  /// the web ACL configuration.
  pub description: Str? = None
}

/// The violation details for a web ACL that's associated with at least one
/// resource that's out of scope of the Firewall Manager policy.
pub struct WebACLHasOutOfScopeResourcesViolation {
  /// The Amazon Resource Name (ARN) of the web ACL.
  pub web_acl_arn: Str? = None
  /// An array of Amazon Resource Name (ARN) for the resources that are out of
  /// scope of the policy and are associated with the web ACL.
  pub out_of_scope_resource_list: List[Str]? = None
}
