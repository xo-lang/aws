  /// The status of the cache cluster for the stage, if enabled.
  pub cache_cluster_status: CacheClusterStatus? = None
  /// A map that defines the method settings for a Stage resource. Keys
  /// (designated as /{method_setting_key below) are method paths defined as
  /// {resource_path}/{http_method} for an individual method override, or
  /// /\*/\* for overriding all methods in the stage.
  pub method_settings: Map[Str, MethodSetting]? = None
  /// A map that defines the stage variables for a Stage resource. Variable
  /// names can have alphanumeric and underscore characters, and the values
  /// must match [A-Za-z0-9-._~:/?#&=,]+ .
  pub variables: Map[Str, Str]? = None
  /// The version of the associated API documentation.
  pub documentation_version: Str? = None
  /// Settings for logging access in this stage.
  pub access_log_settings: AccessLogSettings? = None
  /// Settings for the canary deployment in this stage.
  pub canary_settings: CanarySettings? = None
  /// Specifies whether active tracing with X-ray is enabled for the Stage.
