  DirectoryUnavailableException(e: DirectoryUnavailableException)
  EntityNotFoundException(e: EntityNotFoundException)
  EntityStateException(e: EntityStateException)
  InvalidParameterException(e: InvalidParameterException)
  OrganizationNotFoundException(e: OrganizationNotFoundException)
  OrganizationStateException(e: OrganizationStateException)
  UnsupportedOperationException(e: UnsupportedOperationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UpdateUserErr) display() -> Str {
  match e {
    DirectoryServiceAuthenticationFailedException(x) => "DirectoryServiceAuthenticationFailedException: ${x:?}"
    DirectoryUnavailableException(x) => "DirectoryUnavailableException: ${x:?}"
    EntityNotFoundException(x) => "EntityNotFoundException: ${x:?}"
    EntityStateException(x) => "EntityStateException: ${x:?}"
    InvalidParameterException(x) => "InvalidParameterException: ${x:?}"
    OrganizationNotFoundException(x) => "OrganizationNotFoundException: ${x:?}"
    OrganizationStateException(x) => "OrganizationStateException: ${x:?}"
    UnsupportedOperationException(x) => "UnsupportedOperationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_user_error(resp: http.Response) -> UpdateUserErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "DirectoryServiceAuthenticationFailedException" => match read_error_directory_service_authentication_failed_exception(resp, body) {
      Ok(x) => return UpdateUserErr.DirectoryServiceAuthenticationFailedException(x)
      Err(msg) => return UpdateUserErr.Deserialize(msg)
    }
    "DirectoryUnavailableException" => match read_error_directory_unavailable_exception(resp, body) {
      Ok(x) => return UpdateUserErr.DirectoryUnavailableException(x)
      Err(msg) => return UpdateUserErr.Deserialize(msg)
    }
    "EntityNotFoundException" => match read_error_entity_not_found_exception(resp, body) {
      Ok(x) => return UpdateUserErr.EntityNotFoundException(x)
      Err(msg) => return UpdateUserErr.Deserialize(msg)
    }
    "EntityStateException" => match read_error_entity_state_exception(resp, body) {
      Ok(x) => return UpdateUserErr.EntityStateException(x)
      Err(msg) => return UpdateUserErr.Deserialize(msg)
    }
    "InvalidParameterException" => match read_error_invalid_parameter_exception(resp, body) {
      Ok(x) => return UpdateUserErr.InvalidParameterException(x)
      Err(msg) => return UpdateUserErr.Deserialize(msg)
    }
    "OrganizationNotFoundException" => match read_error_organization_not_found_exception(resp, body) {
      Ok(x) => return UpdateUserErr.OrganizationNotFoundException(x)
      Err(msg) => return UpdateUserErr.Deserialize(msg)
    }
    "OrganizationStateException" => match read_error_organization_state_exception(resp, body) {
      Ok(x) => return UpdateUserErr.OrganizationStateException(x)
      Err(msg) => return UpdateUserErr.Deserialize(msg)
    }
    "UnsupportedOperationException" => match read_error_unsupported_operation_exception(resp, body) {
      Ok(x) => return UpdateUserErr.UnsupportedOperationException(x)
      Err(msg) => return UpdateUserErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateUserErr.Api(restjson.api_error(resp, body))
}

/// Updates data for the user. To have the latest information, it must be
/// preceded by a DescribeUser call. The dataset in the request should be
/// the one expected when performing another DescribeUser call.
pub fn (c: Client) update_user(input: UpdateUserRequest) -> UpdateUserResponse ! UpdateUserErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_user(c.params, input)) ?? e => return Err(UpdateUserErr.InvalidInput(e))
  var req = serialize_update_user(ep, input, "") ?? e => return Err(UpdateUserErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateUserErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_user_error(resp))
  }
  deserialize_update_user(resp) ?? e => Err(UpdateUserErr.Deserialize(e))
}
