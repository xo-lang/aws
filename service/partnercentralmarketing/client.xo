fn json_of_template_field_value(v: TemplateFieldValue) -> json.Value {
  match v {
    Text(x) => json.Value.Object([("Text", json.Value.Str(x))])
    ImageReference(x) => json.Value.Object([("ImageReference", json.Value.Str(x))])
    LinkedAssetId(x) => json.Value.Object([("LinkedAssetId", json.Value.Str(x))])
    CampaignAssetImage(x) => json.Value.Object([("CampaignAssetImage", json_of_campaign_asset_image_source(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_template_field_value(v: json.Value) -> TemplateFieldValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Text" => Ok(TemplateFieldValue.Text(jsonv.read_str(fv)?))
      "ImageReference" => Ok(TemplateFieldValue.ImageReference(jsonv.read_str(fv)?))
      "LinkedAssetId" => Ok(TemplateFieldValue.LinkedAssetId(jsonv.read_str(fv)?))
      "CampaignAssetImage" => Ok(TemplateFieldValue.CampaignAssetImage(from_json_campaign_asset_image_source(fv)?))
      _ => Ok(TemplateFieldValue.Unknown(k))
    }
  }
  Err("TemplateFieldValue: no member set")
}

