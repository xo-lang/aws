  /// Pod's DNS policy in the Kubernetes documentation . Valid values: Default
  /// | ClusterFirst | ClusterFirstWithHostNet
  pub dns_policy: Str? = None
  /// References a Kubernetes secret resource. It holds a list of secrets.
