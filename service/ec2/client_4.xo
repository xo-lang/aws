      "usageOperation" => out.usage_operation = c.text()
      "usageOperationUpdateTime" => out.usage_operation_update_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "privateDnsNameOptions" => out.private_dns_name_options = xml_read_private_dns_name_options_response(c)?
      "ipv6Address" => out.ipv6_address = c.text()
      "tpmSupport" => out.tpm_support = c.text()
      "maintenanceOptions" => out.maintenance_options = xml_read_instance_maintenance_options(c)?
      "currentInstanceBootMode" => out.current_instance_boot_mode = InstanceBootModeValues.from(c.text())
      "networkPerformanceOptions" => out.network_performance_options = xml_read_instance_network_performance_options(c)?
      "operator" => out.operator = xml_read_operator_response(c)?
      "secondaryInterfaceSet" => out.secondary_interfaces = xml_read_instance_secondary_interface_list(c)?
      "instanceId" => out.instance_id = c.text()
      "imageId" => out.image_id = c.text()
      "instanceState" => out.state = xml_read_instance_state(c)?
      "privateDnsName" => out.private_dns_name = c.text()
      "dnsName" => out.public_dns_name = c.text()
      "reason" => out.state_transition_reason = c.text()
      "keyName" => out.key_name = c.text()
      "amiLaunchIndex" => out.ami_launch_index = xmlv.read_int(c.text())?
      "productCodes" => out.product_codes = xml_read_product_code_list(c)?
      "instanceType" => out.instance_type = InstanceType.from(c.text())
      "launchTime" => out.launch_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "placement" => out.placement = xml_read_placement(c)?
      "kernelId" => out.kernel_id = c.text()
      "ramdiskId" => out.ramdisk_id = c.text()
      "platform" => out.platform = PlatformValues.from(c.text())
