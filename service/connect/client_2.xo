fn json_of_invalid_request_exception_reason(v: InvalidRequestExceptionReason) -> json.Value {
  match v {
    AttachedFileInvalidRequestExceptionReason(x) => json.Value.Object([("AttachedFileInvalidRequestExceptionReason", json.Value.Str(x.value()))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_invalid_request_exception_reason(v: json.Value) -> InvalidRequestExceptionReason ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "AttachedFileInvalidRequestExceptionReason" => Ok(InvalidRequestExceptionReason.AttachedFileInvalidRequestExceptionReason(AttachedFileInvalidRequestExceptionReason.from(jsonv.read_str(fv)?)))
      _ => Ok(InvalidRequestExceptionReason.Unknown(k))
    }
  }
  Err("InvalidRequestExceptionReason: no member set")
}

