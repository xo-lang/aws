  /// .
  pub allowed_modes: List[RouteTaxiMode]? = None
  /// Specifies the portion of the route for which this leg type is enabled.
  /// By default, the leg type is enabled for all legs. Valid values: FirstLeg
  /// - Enable this leg type for the first non-pedestrian leg of the route.
  /// LastLeg - Enable this leg type for the last non-pedestrian leg of the
  /// route. EntireRoute - Enable this leg type for the entire route. None -
  /// Disable this leg type entirely.
  pub enabled_for: List[RouteIntermodalEnabledLegs]? = None
  /// Excluded taxi transport modes when calculating the route. By default,
