    xmlv.elem(w, "virtualizationType", x.value(), [])
  }
  if let Some(x) = v.cpu_options {
    xml_write_cpu_options(w, x, "cpuOptions", [])
  }
  if let Some(x) = v.capacity_block_id {
    xmlv.elem(w, "capacityBlockId", x, [])
  }
  if let Some(x) = v.capacity_reservation_id {
    xmlv.elem(w, "capacityReservationId", x, [])
  }
  if let Some(x) = v.capacity_reservation_specification {
    xml_write_capacity_reservation_specification_response(w, x, "capacityReservationSpecification", [])
  }
  if let Some(x) = v.hibernation_options {
    xml_write_hibernation_options(w, x, "hibernationOptions", [])
  }
  if let Some(x) = v.licenses {
    xml_write_license_list(w, x, "licenseSet", [])
  }
  if let Some(x) = v.metadata_options {
    xml_write_instance_metadata_options_response(w, x, "metadataOptions", [])
  }
  if let Some(x) = v.enclave_options {
    xml_write_enclave_options(w, x, "enclaveOptions", [])
  }
  if let Some(x) = v.boot_mode {
    xmlv.elem(w, "bootMode", x.value(), [])
  }
  if let Some(x) = v.platform_details {
    xmlv.elem(w, "platformDetails", x, [])
  }
  if let Some(x) = v.usage_operation {
    xmlv.elem(w, "usageOperation", x, [])
  }
  if let Some(x) = v.usage_operation_update_time {
    xmlv.elem(w, "usageOperationUpdateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.private_dns_name_options {
    xml_write_private_dns_name_options_response(w, x, "privateDnsNameOptions", [])
  }
  if let Some(x) = v.ipv6_address {
    xmlv.elem(w, "ipv6Address", x, [])
  }
  if let Some(x) = v.tpm_support {
    xmlv.elem(w, "tpmSupport", x, [])
  }
  if let Some(x) = v.maintenance_options {
    xml_write_instance_maintenance_options(w, x, "maintenanceOptions", [])
  }
  if let Some(x) = v.current_instance_boot_mode {
    xmlv.elem(w, "currentInstanceBootMode", x.value(), [])
  }
  if let Some(x) = v.network_performance_options {
    xml_write_instance_network_performance_options(w, x, "networkPerformanceOptions", [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_response(w, x, "operator", [])
  }
  if let Some(x) = v.secondary_interfaces {
    xml_write_instance_secondary_interface_list(w, x, "secondaryInterfaceSet", [])
  }
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.image_id {
    xmlv.elem(w, "imageId", x, [])
  }
  if let Some(x) = v.state {
    xml_write_instance_state(w, x, "instanceState", [])
  }
  if let Some(x) = v.private_dns_name {
    xmlv.elem(w, "privateDnsName", x, [])
  }
  if let Some(x) = v.public_dns_name {
    xmlv.elem(w, "dnsName", x, [])
  }
  if let Some(x) = v.state_transition_reason {
    xmlv.elem(w, "reason", x, [])
  }
  if let Some(x) = v.key_name {
    xmlv.elem(w, "keyName", x, [])
  }
  if let Some(x) = v.ami_launch_index {
    xmlv.elem(w, "amiLaunchIndex", "${x}", [])
  }
  if let Some(x) = v.product_codes {
    xml_write_product_code_list(w, x, "productCodes", [])
  }
  if let Some(x) = v.instance_type {
    xmlv.elem(w, "instanceType", x.value(), [])
  }
  if let Some(x) = v.launch_time {
    xmlv.elem(w, "launchTime", rest.date_time(x), [])
  }
  if let Some(x) = v.placement {
    xml_write_placement(w, x, "placement", [])
  }
  if let Some(x) = v.kernel_id {
    xmlv.elem(w, "kernelId", x, [])
  }
  if let Some(x) = v.ramdisk_id {
    xmlv.elem(w, "ramdiskId", x, [])
  }
  if let Some(x) = v.platform {
    xmlv.elem(w, "platform", x.value(), [])
  }
  if let Some(x) = v.monitoring {
    xml_write_monitoring(w, x, "monitoring", [])
  }
  if let Some(x) = v.subnet_id {
    xmlv.elem(w, "subnetId", x, [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "vpcId", x, [])
  }
  if let Some(x) = v.private_ip_address {
    xmlv.elem(w, "privateIpAddress", x, [])
  }
  if let Some(x) = v.public_ip_address {
    xmlv.elem(w, "ipAddress", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance(e: xml.Element) -> Instance ! Str {
  var out = Instance{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "architecture" => out.architecture = ArchitectureValues.from(c.text())
      "blockDeviceMapping" => out.block_device_mappings = xml_read_instance_block_device_mapping_list(c)?
      "clientToken" => out.client_token = c.text()
      "ebsOptimized" => out.ebs_optimized = xmlv.read_bool(c.text())?
      "enaSupport" => out.ena_support = xmlv.read_bool(c.text())?
      "hypervisor" => out.hypervisor = HypervisorType.from(c.text())
      "iamInstanceProfile" => out.iam_instance_profile = xml_read_iam_instance_profile(c)?
      "instanceLifecycle" => out.instance_lifecycle = InstanceLifecycleType.from(c.text())
      "elasticGpuAssociationSet" => out.elastic_gpu_associations = xml_read_elastic_gpu_association_list(c)?
      "elasticInferenceAcceleratorAssociationSet" => out.elastic_inference_accelerator_associations = xml_read_elastic_inference_accelerator_association_list(c)?
      "networkInterfaceSet" => out.network_interfaces = xml_read_instance_network_interface_list(c)?
      "outpostArn" => out.outpost_arn = c.text()
      "rootDeviceName" => out.root_device_name = c.text()
      "rootDeviceType" => out.root_device_type = DeviceType.from(c.text())
      "groupSet" => out.security_groups = xml_read_group_identifier_list(c)?
      "sourceDestCheck" => out.source_dest_check = xmlv.read_bool(c.text())?
      "spotInstanceRequestId" => out.spot_instance_request_id = c.text()
      "sriovNetSupport" => out.sriov_net_support = c.text()
      "stateReason" => out.state_reason = xml_read_state_reason(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "virtualizationType" => out.virtualization_type = VirtualizationType.from(c.text())
      "cpuOptions" => out.cpu_options = xml_read_cpu_options(c)?
      "capacityBlockId" => out.capacity_block_id = c.text()
      "capacityReservationId" => out.capacity_reservation_id = c.text()
      "capacityReservationSpecification" => out.capacity_reservation_specification = xml_read_capacity_reservation_specification_response(c)?
      "hibernationOptions" => out.hibernation_options = xml_read_hibernation_options(c)?
      "licenseSet" => out.licenses = xml_read_license_list(c)?
      "metadataOptions" => out.metadata_options = xml_read_instance_metadata_options_response(c)?
      "enclaveOptions" => out.enclave_options = xml_read_enclave_options(c)?
      "bootMode" => out.boot_mode = BootModeValues.from(c.text())
      "platformDetails" => out.platform_details = c.text()
      "usageOperation" => out.usage_operation = c.text()
      "usageOperationUpdateTime" => out.usage_operation_update_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "privateDnsNameOptions" => out.private_dns_name_options = xml_read_private_dns_name_options_response(c)?
      "ipv6Address" => out.ipv6_address = c.text()
      "tpmSupport" => out.tpm_support = c.text()
      "maintenanceOptions" => out.maintenance_options = xml_read_instance_maintenance_options(c)?
      "currentInstanceBootMode" => out.current_instance_boot_mode = InstanceBootModeValues.from(c.text())
      "networkPerformanceOptions" => out.network_performance_options = xml_read_instance_network_performance_options(c)?
      "operator" => out.operator = xml_read_operator_response(c)?
      "secondaryInterfaceSet" => out.secondary_interfaces = xml_read_instance_secondary_interface_list(c)?
      "instanceId" => out.instance_id = c.text()
      "imageId" => out.image_id = c.text()
      "instanceState" => out.state = xml_read_instance_state(c)?
      "privateDnsName" => out.private_dns_name = c.text()
      "dnsName" => out.public_dns_name = c.text()
      "reason" => out.state_transition_reason = c.text()
      "keyName" => out.key_name = c.text()
      "amiLaunchIndex" => out.ami_launch_index = xmlv.read_int(c.text())?
      "productCodes" => out.product_codes = xml_read_product_code_list(c)?
      "instanceType" => out.instance_type = InstanceType.from(c.text())
      "launchTime" => out.launch_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "placement" => out.placement = xml_read_placement(c)?
      "kernelId" => out.kernel_id = c.text()
      "ramdiskId" => out.ramdisk_id = c.text()
      "platform" => out.platform = PlatformValues.from(c.text())
      "monitoring" => out.monitoring = xml_read_monitoring(c)?
