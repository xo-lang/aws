  var req = serialize_batch_execute_statement(ep, input, "") ?? e => return Err(BatchExecuteStatementErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(BatchExecuteStatementErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_batch_execute_statement_error(resp))
  }
  deserialize_batch_execute_statement(resp) ?? e => Err(BatchExecuteStatementErr.Deserialize(e))
}

