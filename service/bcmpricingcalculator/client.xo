    return match k {
      "addReservedInstanceAction" => Ok(BillScenarioCommitmentModificationAction.AddReservedInstanceAction(from_json_add_reserved_instance_action(fv)?))
      "addSavingsPlanAction" => Ok(BillScenarioCommitmentModificationAction.AddSavingsPlanAction(from_json_add_savings_plan_action(fv)?))
