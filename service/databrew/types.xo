  pub account_id: Str? = None
  /// The Amazon Resource Name (ARN) of the user who created the job.
  pub created_by: Str? = None
  /// The date and time that the job was created.
  pub create_date: Time? = None
  /// A dataset that the job is to process.
  pub dataset_name: Str? = None
  /// The Amazon Resource Name (ARN) of an encryption key that is used to
  /// protect the job output. For more information, see Encrypting data
  /// written by DataBrew jobs
  pub encryption_key_arn: Str? = None
  /// The encryption mode for the job, which can be one of the following:
  /// SSE-KMS - Server-side encryption with keys managed by KMS. SSE-S3 -
  /// Server-side encryption with keys managed by Amazon S3.
  pub encryption_mode: EncryptionMode? = None
  /// The unique name of the job.
  pub name: Str? = None
  /// The job type of the job, which must be one of the following: PROFILE - A
  /// job to analyze a dataset, to determine its size, data types, data
  /// distribution, and more. RECIPE - A job to apply one or more
  /// transformations to a dataset.
  pub type_value: JobType? = None
  /// The Amazon Resource Name (ARN) of the user who last modified the job.
  pub last_modified_by: Str? = None
  /// The modification date and time of the job.
  pub last_modified_date: Time? = None
  /// The current status of Amazon CloudWatch logging for the job.
  pub log_subscription: LogSubscription? = None
  /// The maximum number of nodes that can be consumed when the job processes
  /// data.
  pub max_capacity: Int? = None
  /// The maximum number of times to retry the job after a job run fails.
  pub max_retries: Int? = None
  /// One or more artifacts that represent output from running the job.
  pub outputs: List[Output]? = None
  /// One or more artifacts that represent the Glue Data Catalog output from
  /// running the job.
  pub data_catalog_outputs: List[DataCatalogOutput]? = None
  /// Represents a list of JDBC database output objects which defines the
  /// output destination for a DataBrew recipe job to write into.
  pub database_outputs: List[DatabaseOutput]? = None
  /// The name of the project that the job is associated with.
  pub project_name: Str? = None
  /// A set of steps that the job runs.
  pub recipe_reference: RecipeReference? = None
  /// The unique Amazon Resource Name (ARN) for the job.
  pub resource_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the role to be assumed for this job.
  pub role_arn: Str? = None
  /// The job's timeout in minutes. A job that attempts to run longer than
  /// this timeout period ends with a status of TIMEOUT .
  pub timeout: Int? = None
  /// Metadata tags that have been applied to the job.
  pub tags: Map[Str, Str]? = None
  /// A sample configuration for profile jobs only, which determines the
  /// number of rows on which the profile job is run. If a JobSample value
  /// isn't provided, the default value is used. The default value is
  /// CUSTOM_ROWS for the mode parameter and 20,000 for the size parameter.
  pub job_sample: JobSample? = None
  /// List of validation configurations that are applied to the profile job.
  pub validation_configurations: List[ValidationConfiguration]? = None
}

/// Represents one run of a DataBrew job.
pub struct JobRun {
  /// The number of times that DataBrew has attempted to run the job.
  pub attempt: Int? = None
  /// The date and time when the job completed processing.
  pub completed_on: Time? = None
  /// The name of the dataset for the job to process.
  pub dataset_name: Str? = None
  /// A message indicating an error (if any) that was encountered when the job
  /// ran.
  pub error_message: Str? = None
  /// The amount of time, in seconds, during which a job run consumed
  /// resources.
  pub execution_time: Int? = None
  /// The name of the job being processed during this run.
  pub job_name: Str? = None
  /// The unique identifier of the job run.
  pub run_id: Str? = None
  /// The current state of the job run entity itself.
  pub state: JobRunState? = None
  /// The current status of Amazon CloudWatch logging for the job run.
  pub log_subscription: LogSubscription? = None
  /// The name of an Amazon CloudWatch log group, where the job writes
  /// diagnostic messages when it runs.
  pub log_group_name: Str? = None
  /// One or more output artifacts from a job run.
  pub outputs: List[Output]? = None
  /// One or more artifacts that represent the Glue Data Catalog output from
  /// running the job.
  pub data_catalog_outputs: List[DataCatalogOutput]? = None
  /// Represents a list of JDBC database output objects which defines the
  /// output destination for a DataBrew recipe job to write into.
  pub database_outputs: List[DatabaseOutput]? = None
  /// The set of steps processed by the job.
  pub recipe_reference: RecipeReference? = None
  /// The Amazon Resource Name (ARN) of the user who initiated the job run.
  pub started_by: Str? = None
  /// The date and time when the job run began.
  pub started_on: Time? = None
  /// A sample configuration for profile jobs only, which determines the
  /// number of rows on which the profile job is run. If a JobSample value
  /// isn't provided, the default is used. The default value is CUSTOM_ROWS
  /// for the mode parameter and 20,000 for the size parameter.
  pub job_sample: JobSample? = None
  /// List of validation configurations that are applied to the profile job
  /// run.
  pub validation_configurations: List[ValidationConfiguration]? = None
}

pub enum JobRunState: Str {
  Starting = "STARTING"
  Running = "RUNNING"
  Stopping = "STOPPING"
  Stopped = "STOPPED"
  Succeeded = "SUCCEEDED"
  Failed = "FAILED"
