  /// allows requests BLOCK - WAF blocks requests COUNT - WAF increments a
  /// counter of the requests that match all of the conditions in the rule.
  /// WAF then continues to inspect the web request based on the remaining
  /// rules in the web ACL. You can't specify COUNT for the default action for
  /// a web ACL.
  pub type_value: Str? = None
}

