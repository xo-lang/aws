  }
  Ok(out)
}

fn json_of_upper_case_string_with_keys(v: List[Str]) -> json.Value {
  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

fn from_json_upper_case_string_with_keys(v: json.Value) -> List[Str] ! Str {
  var out: List[Str] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(jsonv.read_str(fv)?)
  }
  Ok(out)
}

