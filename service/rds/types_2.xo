  /// mydbsubnetgroup
  pub db_subnet_group_name: Str? = None
  /// Secifies whether the DB instance is a Multi-AZ deployment. This setting
  /// doesn't apply to RDS Custom. Constraints: You can't specify the
  /// AvailabilityZone parameter if the DB instance is a Multi-AZ deployment.
  pub multi_az: Bool? = None
  /// Specifies whether the DB instance is publicly accessible. When the DB
