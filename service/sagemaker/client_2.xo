fn json_of_custom_file_system(v: CustomFileSystem) -> json.Value {
  match v {
    EfsFileSystem(x) => json.Value.Object([("EFSFileSystem", json_of_efs_file_system(x))])
    FSxLustreFileSystem(x) => json.Value.Object([("FSxLustreFileSystem", json_of_f_sx_lustre_file_system(x))])
    S3FileSystem(x) => json.Value.Object([("S3FileSystem", json_of_s3_file_system(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_custom_file_system(v: json.Value) -> CustomFileSystem ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "EFSFileSystem" => Ok(CustomFileSystem.EfsFileSystem(from_json_efs_file_system(fv)?))
      "FSxLustreFileSystem" => Ok(CustomFileSystem.FSxLustreFileSystem(from_json_f_sx_lustre_file_system(fv)?))
      "S3FileSystem" => Ok(CustomFileSystem.S3FileSystem(from_json_s3_file_system(fv)?))
      _ => Ok(CustomFileSystem.Unknown(k))
    }
  }
  Err("CustomFileSystem: no member set")
}

