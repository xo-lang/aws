  }
}

fn from_json_provider_config(v: json.Value) -> ProviderConfig ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "MicrosoftPurview" => Ok(ProviderConfig.MicrosoftPurview(from_json_microsoft_purview_provider_config(fv)?))
      _ => Ok(ProviderConfig.Unknown(k))
    }
  }
  Err("ProviderConfig: no member set")
}

