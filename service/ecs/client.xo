    return match k {
      "logLevel" => Ok(ServiceConnectContainerConfiguration.LogLevel(ServiceConnectContainerLogLevel.from(jsonv.read_str(fv)?)))
      _ => Ok(ServiceConnectContainerConfiguration.Unknown(k))
    }
  }
  Err("ServiceConnectContainerConfiguration: no member set")
}

