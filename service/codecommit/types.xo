/// A single line-level entry in a diff hunk. Each DiffChange describes one
/// line and its change type: unchanged context, an addition in the after
/// blob, or a deletion from the before blob.
pub struct DiffChange {
  /// The type of change for this line. Possible values: CONTEXT – Unchanged
  /// line included for surrounding context. ADD – Line added in the after
  /// blob. DELETE – Line removed from the before blob.
  pub type_value: DiffChangeType? = None
  /// The 1-based line number in the before blob. This field is omitted for
  /// ADD lines.
  pub before_line_number: Int? = None
  /// The 1-based line number in the after blob. This field is omitted for
  /// DELETE lines.
  pub after_line_number: Int? = None
  /// The text content of the line, without the trailing newline.
  pub content: Str? = None
}

pub enum DiffChangeType: Str {
  Context = "CONTEXT"
  Add = "ADD"
  Delete = "DELETE"
  Unknown(value: Str)
}

/// A contiguous run of changed lines from a blob diff, together with any
/// surrounding unchanged context lines. Hunks are returned in order from
/// the start of the file to the end. Adjacent or overlapping hunks are
/// merged into a single hunk in the response.
pub struct DiffHunk {
  /// The 1-based line number in the before blob where this hunk begins. When
  /// the hunk consists entirely of additions, beforeLineCount is 0 .
  pub before_start_line: Int? = None
  /// The number of lines from the before blob covered by this hunk, including
  /// any context lines.
  pub before_line_count: Int? = None
  /// The 1-based line number in the after blob where this hunk begins. When
  /// the hunk consists entirely of deletions, afterLineCount is 0 .
  pub after_start_line: Int? = None
  /// The number of lines from the after blob covered by this hunk, including
  /// any context lines.
  pub after_line_count: Int? = None
  /// An ordered list of line-level changes that make up this hunk. Each entry
  /// indicates whether the line is unchanged context, an addition, or a
  /// deletion.
  pub changes: List[DiffChange]? = None
}

