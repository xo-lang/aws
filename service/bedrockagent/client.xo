fn from_json_flow_validation_details(v: json.Value) -> FlowValidationDetails ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "cyclicConnection" => Ok(FlowValidationDetails.CyclicConnection(from_json_cyclic_connection_flow_validation_details(fv)?))
      "duplicateConnections" => Ok(FlowValidationDetails.DuplicateConnections(from_json_duplicate_connections_flow_validation_details(fv)?))
