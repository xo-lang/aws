  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query.add(f, k, x)
  }
}

fn query_put_domain_name_map(var f: query.Form, prefix: Str, v: Map[Str, Str], flat: Bool) {
  // sorted keys, as aws-sdk-go-v2 writes them
  for (i, k) in v.keys().sort().indexed() {
    let e = if flat { "${prefix}.${i + 1}" } else { "${prefix}.entry.${i + 1}" }
    query.add(f, "${e}.key", k)
    if let Some(x) = v.get(k) {
      query.add(f, "${e}.value", x)
    }
  }
}

fn query_put_domain_status(var f: query.Form, prefix: Str, v: DomainStatus) {
  if let Some(x) = v.domain_id {
    query.add(f, query.key(prefix, "DomainId"), x)
  }
  if let Some(x) = v.domain_name {
    query.add(f, query.key(prefix, "DomainName"), x)
  }
  if let Some(x) = v.arn {
    query.add(f, query.key(prefix, "ARN"), x)
  }
  if let Some(x) = v.created {
    query.add(f, query.key(prefix, "Created"), "${x}")
  }
  if let Some(x) = v.deleted {
    query.add(f, query.key(prefix, "Deleted"), "${x}")
  }
  if let Some(x) = v.doc_service {
    query_put_service_endpoint(f, query.key(prefix, "DocService"), x)
  }
  if let Some(x) = v.search_service {
    query_put_service_endpoint(f, query.key(prefix, "SearchService"), x)
  }
  if let Some(x) = v.requires_index_documents {
    query.add(f, query.key(prefix, "RequiresIndexDocuments"), "${x}")
  }
  if let Some(x) = v.processing {
    query.add(f, query.key(prefix, "Processing"), "${x}")
  }
  if let Some(x) = v.search_instance_type {
    query.add(f, query.key(prefix, "SearchInstanceType"), x)
  }
  if let Some(x) = v.search_partition_count {
    query.add(f, query.key(prefix, "SearchPartitionCount"), "${x}")
  }
  if let Some(x) = v.search_instance_count {
    query.add(f, query.key(prefix, "SearchInstanceCount"), "${x}")
  }
  if let Some(x) = v.limits {
    query_put_limits(f, query.key(prefix, "Limits"), x)
  }
}

