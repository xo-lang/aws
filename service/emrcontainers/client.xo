fn json_of_endpoint(v: Endpoint) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("id", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("arn", json.Value.Str(x)))
  }
  if let Some(x) = v.virtual_cluster_id {
    fs.push(("virtualClusterId", json.Value.Str(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("type", json.Value.Str(x)))
  }
  if let Some(x) = v.state {
    fs.push(("state", json.Value.Str(x.value())))
  }
  if let Some(x) = v.release_label {
    fs.push(("releaseLabel", json.Value.Str(x)))
  }
  if let Some(x) = v.execution_role_arn {
    fs.push(("executionRoleArn", json.Value.Str(x)))
  }
  if let Some(x) = v.certificate_arn {
    fs.push(("certificateArn", json.Value.Str(x)))
  }
  if let Some(x) = v.certificate_authority {
    fs.push(("certificateAuthority", json_of_certificate(x)))
  }
  if let Some(x) = v.configuration_overrides {
    fs.push(("configurationOverrides", json_of_configuration_overrides(x)))
  }
  if let Some(x) = v.server_url {
    fs.push(("serverUrl", json.Value.Str(x)))
  }
  if let Some(x) = v.auth_proxy_url {
    fs.push(("authProxyUrl", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.security_group {
    fs.push(("securityGroup", json.Value.Str(x)))
  }
  if let Some(x) = v.subnet_ids {
    fs.push(("subnetIds", json_of_subnet_ids(x)))
  }
  if let Some(x) = v.state_details {
    fs.push(("stateDetails", json.Value.Str(x)))
  }
  if let Some(x) = v.failure_reason {
    fs.push(("failureReason", json.Value.Str(x.value())))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tag_map(x)))
  }
  json.Value.Object(fs)
}

fn from_json_endpoint(v: json.Value) -> Endpoint ! Str {
  var out = Endpoint{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "id" => out.id = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "arn" => out.arn = jsonv.read_str(fv)?
      "virtualClusterId" => out.virtual_cluster_id = jsonv.read_str(fv)?
      "type" => out.type_value = jsonv.read_str(fv)?
      "state" => out.state = EndpointState.from(jsonv.read_str(fv)?)
      "releaseLabel" => out.release_label = jsonv.read_str(fv)?
      "executionRoleArn" => out.execution_role_arn = jsonv.read_str(fv)?
      "certificateArn" => out.certificate_arn = jsonv.read_str(fv)?
      "certificateAuthority" => out.certificate_authority = from_json_certificate(fv)?
      "configurationOverrides" => out.configuration_overrides = from_json_configuration_overrides(fv)?
      "serverUrl" => out.server_url = jsonv.read_str(fv)?
      "authProxyUrl" => out.auth_proxy_url = jsonv.read_str(fv)?
      "createdAt" => out.created_at = jsonv.read_time(fv, "date-time")?
      "securityGroup" => out.security_group = jsonv.read_str(fv)?
      "subnetIds" => out.subnet_ids = from_json_subnet_ids(fv)?
      "stateDetails" => out.state_details = jsonv.read_str(fv)?
      "failureReason" => out.failure_reason = FailureReason.from(jsonv.read_str(fv)?)
      "tags" => out.tags = from_json_tag_map(fv)?
      _ => {}
    }
  }
  Ok(out)
}

