      "transitGatewayId" => out.transit_gateway_id = c.text()
      "transitGatewayArn" => out.transit_gateway_arn = c.text()
      "state" => out.state = TransitGatewayState.from(c.text())
      "ownerId" => out.owner_id = c.text()
      "description" => out.description = c.text()
      "creationTime" => out.creation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "options" => out.options = xml_read_transit_gateway_options(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

