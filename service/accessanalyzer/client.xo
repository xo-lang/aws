    return match k {
      "internalAccessDetails" => Ok(FindingDetails.InternalAccessDetails(from_json_internal_access_details(fv)?))
      "externalAccessDetails" => Ok(FindingDetails.ExternalAccessDetails(from_json_external_access_details(fv)?))
      "unusedPermissionDetails" => Ok(FindingDetails.UnusedPermissionDetails(from_json_unused_permission_details(fv)?))
      "unusedIamUserAccessKeyDetails" => Ok(FindingDetails.UnusedIamUserAccessKeyDetails(from_json_unused_iam_user_access_key_details(fv)?))
      "unusedIamRoleDetails" => Ok(FindingDetails.UnusedIamRoleDetails(from_json_unused_iam_role_details(fv)?))
      "unusedIamUserPasswordDetails" => Ok(FindingDetails.UnusedIamUserPasswordDetails(from_json_unused_iam_user_password_details(fv)?))
      _ => Ok(FindingDetails.Unknown(k))
    }
  }
  Err("FindingDetails: no member set")
}

