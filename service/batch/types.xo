  /// The capacity usage information for this quota share, including the units
  /// of compute capacity and quantity being used.
  pub capacity_usage: List[QuotaShareCapacityUsage]? = None
}

/// Detailed information about a quota share, including its configuration,
/// state, and capacity limits.
pub struct QuotaShareDetail {
  /// The name of the quota share.
  pub quota_share_name: Str? = None
  /// The Amazon Resource Name (ARN) of the quota share.
