  match v {
    Github(x) => json.Value.Object([("github", json_of_git_hub_details(x))])
    Gitlab(x) => json.Value.Object([("gitlab", json_of_git_lab_details(x))])
    S3(x) => json.Value.Object([("s3", json_of_s3_details(x))])
    Unknown(_) => json.Value.Object([])
