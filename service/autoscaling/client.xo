fn xml_write_instance_refresh(var w: xmlv.Writer, v: InstanceRefresh, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.instance_refresh_id {
    xmlv.elem(w, "InstanceRefreshId", x, [])
  }
  if let Some(x) = v.auto_scaling_group_name {
    xmlv.elem(w, "AutoScalingGroupName", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.status_reason {
    xmlv.elem(w, "StatusReason", x, [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "StartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.end_time {
    xmlv.elem(w, "EndTime", rest.date_time(x), [])
  }
  if let Some(x) = v.percentage_complete {
    xmlv.elem(w, "PercentageComplete", "${x}", [])
  }
  if let Some(x) = v.instances_to_update {
    xmlv.elem(w, "InstancesToUpdate", "${x}", [])
  }
  if let Some(x) = v.progress_details {
    xml_write_instance_refresh_progress_details(w, x, "ProgressDetails", [])
  }
  if let Some(x) = v.preferences {
    xml_write_refresh_preferences(w, x, "Preferences", [])
  }
  if let Some(x) = v.desired_configuration {
    xml_write_desired_configuration(w, x, "DesiredConfiguration", [])
  }
  if let Some(x) = v.rollback_details {
    xml_write_rollback_details(w, x, "RollbackDetails", [])
  }
  if let Some(x) = v.strategy {
    xmlv.elem(w, "Strategy", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_refresh(e: xml.Element) -> InstanceRefresh ! Str {
  var out = InstanceRefresh{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "InstanceRefreshId" => out.instance_refresh_id = c.text()
      "AutoScalingGroupName" => out.auto_scaling_group_name = c.text()
      "Status" => out.status = InstanceRefreshStatus.from(c.text())
      "StatusReason" => out.status_reason = c.text()
      "StartTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EndTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PercentageComplete" => out.percentage_complete = xmlv.read_int(c.text())?
      "InstancesToUpdate" => out.instances_to_update = xmlv.read_int(c.text())?
      "ProgressDetails" => out.progress_details = xml_read_instance_refresh_progress_details(c)?
      "Preferences" => out.preferences = xml_read_refresh_preferences(c)?
      "DesiredConfiguration" => out.desired_configuration = xml_read_desired_configuration(c)?
      "RollbackDetails" => out.rollback_details = xml_read_rollback_details(c)?
      "Strategy" => out.strategy = RefreshStrategy.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

