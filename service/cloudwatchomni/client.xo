fn json_of_rule(v: Rule) -> json.Value {
  match v {
    TelemetryRule(x) => json.Value.Object([("telemetryRule", json_of_telemetry_rule(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_rule(v: json.Value) -> Rule ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "telemetryRule" => Ok(Rule.TelemetryRule(from_json_telemetry_rule(fv)?))
      _ => Ok(Rule.Unknown(k))
    }
  }
  Err("Rule: no member set")
}

