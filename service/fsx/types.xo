pub enum DataRepositoryLifecycle: Str {
  Creating = "CREATING"
  Available = "AVAILABLE"
  Misconfigured = "MISCONFIGURED"
  Updating = "UPDATING"
  Deleting = "DELETING"
  Failed = "FAILED"
  Unknown(value: Str)
}

/// A description of the data repository task. You use import and export
/// data repository tasks to perform bulk transfer operations between an
/// Amazon FSx for Lustre file system and a linked data repository. You use
/// release data repository tasks to release files that have been exported
/// to a linked S3 bucket from your Amazon FSx for Lustre file system. An
/// Amazon File Cache resource uses a task to automatically release files
/// from the cache. To learn more about data repository tasks, see Data
/// Repository Tasks .
pub struct DataRepositoryTask {
  /// The system-generated, unique 17-digit ID of the data repository task.
  pub task_id: Str? = None
  /// The lifecycle status of the data repository task, as follows: PENDING -
  /// The task has not started. EXECUTING - The task is in process. FAILED -
  /// The task was not able to be completed. For example, there may be files
  /// the task failed to process. The DataRepositoryTaskFailureDetails
  /// property provides more information about task failures. SUCCEEDED - The
  /// task has completed successfully. CANCELED - The task was canceled and it
  /// did not complete. CANCELING - The task is in process of being canceled.
  /// You cannot delete an FSx for Lustre file system if there are data
  /// repository tasks for the file system in the PENDING or EXECUTING states.
  /// Please retry when the data repository task is finished (with a status of
  /// CANCELED , SUCCEEDED , or FAILED ). You can use the
  /// DescribeDataRepositoryTask action to monitor the task status. Contact
  /// the FSx team if you need to delete your file system immediately.
  pub lifecycle: DataRepositoryTaskLifecycle? = None
  /// The type of data repository task. EXPORT_TO_REPOSITORY tasks export from
  /// your Amazon FSx for Lustre file system to a linked data repository.
  /// IMPORT_METADATA_FROM_REPOSITORY tasks import metadata changes from a
  /// linked S3 bucket to your Amazon FSx for Lustre file system.
  /// RELEASE_DATA_FROM_FILESYSTEM tasks release files in your Amazon FSx for
  /// Lustre file system that have been exported to a linked S3 bucket and
  /// that meet your specified release criteria. AUTO_RELEASE_DATA tasks
  /// automatically release files from an Amazon File Cache resource.
  pub type_value: DataRepositoryTaskType? = None
  pub creation_time: Time? = None
  /// The time the system began processing the task.
  pub start_time: Time? = None
  /// The time the system completed processing the task, populated after the
  /// task is complete.
  pub end_time: Time? = None
  pub resource_arn: Str? = None
  pub tags: List[Tag]? = None
  /// The globally unique ID of the file system.
  pub file_system_id: Str? = None
  /// An array of paths that specify the data for the data repository task to
  /// process. For example, in an EXPORT_TO_REPOSITORY task, the paths specify
  /// which data to export to the linked data repository. (Default) If Paths
  /// is not specified, Amazon FSx uses the file system root directory.
  pub paths: List[Str]? = None
  /// Failure message describing why the task failed, it is populated only
  /// when Lifecycle is set to FAILED .
  pub failure_details: DataRepositoryTaskFailureDetails? = None
  /// Provides the status of the number of files that the task has processed
  /// successfully and failed to process.
  pub status: DataRepositoryTaskStatus? = None
  pub report: CompletionReport? = None
  /// Specifies the amount of data to release, in GiB, by an Amazon File Cache
  /// AUTO_RELEASE_DATA task that automatically releases files from the cache.
  pub capacity_to_release: Int? = None
  /// The system-generated, unique ID of the cache.
  pub file_cache_id: Str? = None
  /// The configuration that specifies the last accessed time criteria for
  /// files that will be released from an Amazon FSx for Lustre file system.
  pub release_configuration: ReleaseConfiguration? = None
}

