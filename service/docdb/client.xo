fn xml_write_parameter(var w: xmlv.Writer, v: Parameter, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.parameter_name {
    xmlv.elem(w, "ParameterName", x, [])
  }
