  var qs: List[(Str, Str)] = []
  let label_search_job_identifier = match input.search_job_identifier {
    Some(v) => v
    None => return Err("input member SearchJobIdentifier is required")
  }
  if label_search_job_identifier == "" {
    return Err("input member SearchJobIdentifier must not be empty")
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "GET",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/search-jobs/${rest.escape(label_search_job_identifier, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

