fn xml_write_service_integration_list(var w: xmlv.Writer, v: List[ServiceIntegrationsUnion], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_service_integrations_union(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_service_integration_list(e: xml.Element) -> List[ServiceIntegrationsUnion] ! Str {
  var out: List[ServiceIntegrationsUnion] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_service_integrations_union(c)?)
  }
  Ok(out)
}

fn xml_write_service_integrations_union(var w: xmlv.Writer, v: ServiceIntegrationsUnion, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    LakeFormation(x) => {
      xml_write_lake_formation_service_integrations(w, x, "LakeFormation", [])
    }
    S3AccessGrants(x) => {
      xml_write_s3_access_grants_service_integrations(w, x, "S3AccessGrants", [])
    }
    Redshift(x) => {
      xml_write_redshift_service_integrations(w, x, "Redshift", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_service_integrations_union(e: xml.Element) -> ServiceIntegrationsUnion ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "LakeFormation" => Ok(ServiceIntegrationsUnion.LakeFormation(xml_read_lake_formation_service_integrations(c)?))
      "S3AccessGrants" => Ok(ServiceIntegrationsUnion.S3AccessGrants(xml_read_s3_access_grants_service_integrations(c)?))
      "Redshift" => Ok(ServiceIntegrationsUnion.Redshift(xml_read_redshift_service_integrations(c)?))
      _ => Ok(ServiceIntegrationsUnion.Unknown(c.name.local))
    }
  }
  Err("ServiceIntegrationsUnion: no member set")
}

fn xml_write_snapshot(var w: xmlv.Writer, v: Snapshot, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.snapshot_identifier {
    xmlv.elem(w, "SnapshotIdentifier", x, [])
  }
  if let Some(x) = v.cluster_identifier {
    xmlv.elem(w, "ClusterIdentifier", x, [])
  }
  if let Some(x) = v.snapshot_create_time {
    xmlv.elem(w, "SnapshotCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.port {
    xmlv.elem(w, "Port", "${x}", [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "AvailabilityZone", x, [])
  }
  if let Some(x) = v.cluster_create_time {
    xmlv.elem(w, "ClusterCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.master_username {
    xmlv.elem(w, "MasterUsername", x, [])
  }
  if let Some(x) = v.cluster_version {
    xmlv.elem(w, "ClusterVersion", x, [])
  }
  if let Some(x) = v.engine_full_version {
    xmlv.elem(w, "EngineFullVersion", x, [])
  }
  if let Some(x) = v.snapshot_type {
    xmlv.elem(w, "SnapshotType", x, [])
  }
  if let Some(x) = v.node_type {
    xmlv.elem(w, "NodeType", x, [])
  }
  if let Some(x) = v.number_of_nodes {
    xmlv.elem(w, "NumberOfNodes", "${x}", [])
  }
  if let Some(x) = v.db_name {
    xmlv.elem(w, "DBName", x, [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "VpcId", x, [])
  }
  if let Some(x) = v.encrypted {
    xmlv.elem(w, "Encrypted", "${x}", [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KmsKeyId", x, [])
  }
  if let Some(x) = v.encrypted_with_hsm {
    xmlv.elem(w, "EncryptedWithHSM", "${x}", [])
  }
  if let Some(x) = v.accounts_with_restore_access {
    xml_write_accounts_with_restore_access_list(w, x, "AccountsWithRestoreAccess", [])
  }
  if let Some(x) = v.owner_account {
    xmlv.elem(w, "OwnerAccount", x, [])
  }
  if let Some(x) = v.total_backup_size_in_mega_bytes {
    xmlv.elem(w, "TotalBackupSizeInMegaBytes", rest.encode_float(x), [])
  }
  if let Some(x) = v.actual_incremental_backup_size_in_mega_bytes {
    xmlv.elem(w, "ActualIncrementalBackupSizeInMegaBytes", rest.encode_float(x), [])
  }
  if let Some(x) = v.backup_progress_in_mega_bytes {
    xmlv.elem(w, "BackupProgressInMegaBytes", rest.encode_float(x), [])
  }
  if let Some(x) = v.current_backup_rate_in_mega_bytes_per_second {
    xmlv.elem(w, "CurrentBackupRateInMegaBytesPerSecond", rest.encode_float(x), [])
  }
  if let Some(x) = v.estimated_seconds_to_completion {
    xmlv.elem(w, "EstimatedSecondsToCompletion", "${x}", [])
  }
  if let Some(x) = v.elapsed_time_in_seconds {
    xmlv.elem(w, "ElapsedTimeInSeconds", "${x}", [])
  }
  if let Some(x) = v.source_region {
    xmlv.elem(w, "SourceRegion", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "Tags", [])
  }
  if let Some(x) = v.restorable_node_types {
    xml_write_restorable_node_type_list(w, x, "RestorableNodeTypes", [])
  }
  if let Some(x) = v.enhanced_vpc_routing {
    xmlv.elem(w, "EnhancedVpcRouting", "${x}", [])
  }
  if let Some(x) = v.maintenance_track_name {
    xmlv.elem(w, "MaintenanceTrackName", x, [])
  }
  if let Some(x) = v.manual_snapshot_retention_period {
    xmlv.elem(w, "ManualSnapshotRetentionPeriod", "${x}", [])
  }
  if let Some(x) = v.manual_snapshot_remaining_days {
    xmlv.elem(w, "ManualSnapshotRemainingDays", "${x}", [])
  }
  if let Some(x) = v.snapshot_retention_start_time {
    xmlv.elem(w, "SnapshotRetentionStartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.master_password_secret_arn {
    xmlv.elem(w, "MasterPasswordSecretArn", x, [])
  }
  if let Some(x) = v.master_password_secret_kms_key_id {
    xmlv.elem(w, "MasterPasswordSecretKmsKeyId", x, [])
  }
  if let Some(x) = v.snapshot_arn {
    xmlv.elem(w, "SnapshotArn", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_snapshot(e: xml.Element) -> Snapshot ! Str {
  var out = Snapshot{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "SnapshotIdentifier" => out.snapshot_identifier = c.text()
      "ClusterIdentifier" => out.cluster_identifier = c.text()
      "SnapshotCreateTime" => out.snapshot_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Status" => out.status = c.text()
      "Port" => out.port = xmlv.read_int(c.text())?
      "AvailabilityZone" => out.availability_zone = c.text()
      "ClusterCreateTime" => out.cluster_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MasterUsername" => out.master_username = c.text()
      "ClusterVersion" => out.cluster_version = c.text()
      "EngineFullVersion" => out.engine_full_version = c.text()
      "SnapshotType" => out.snapshot_type = c.text()
      "NodeType" => out.node_type = c.text()
      "NumberOfNodes" => out.number_of_nodes = xmlv.read_int(c.text())?
      "DBName" => out.db_name = c.text()
      "VpcId" => out.vpc_id = c.text()
      "Encrypted" => out.encrypted = xmlv.read_bool(c.text())?
      "KmsKeyId" => out.kms_key_id = c.text()
      "EncryptedWithHSM" => out.encrypted_with_hsm = xmlv.read_bool(c.text())?
      "AccountsWithRestoreAccess" => out.accounts_with_restore_access = xml_read_accounts_with_restore_access_list(c)?
      "OwnerAccount" => out.owner_account = c.text()
      "TotalBackupSizeInMegaBytes" => out.total_backup_size_in_mega_bytes = xmlv.read_float(c.text())?
      "ActualIncrementalBackupSizeInMegaBytes" => out.actual_incremental_backup_size_in_mega_bytes = xmlv.read_float(c.text())?
      "BackupProgressInMegaBytes" => out.backup_progress_in_mega_bytes = xmlv.read_float(c.text())?
      "CurrentBackupRateInMegaBytesPerSecond" => out.current_backup_rate_in_mega_bytes_per_second = xmlv.read_float(c.text())?
      "EstimatedSecondsToCompletion" => out.estimated_seconds_to_completion = xmlv.read_int(c.text())?
      "ElapsedTimeInSeconds" => out.elapsed_time_in_seconds = xmlv.read_int(c.text())?
      "SourceRegion" => out.source_region = c.text()
      "Tags" => out.tags = xml_read_tag_list(c)?
      "RestorableNodeTypes" => out.restorable_node_types = xml_read_restorable_node_type_list(c)?
      "EnhancedVpcRouting" => out.enhanced_vpc_routing = xmlv.read_bool(c.text())?
      "MaintenanceTrackName" => out.maintenance_track_name = c.text()
      "ManualSnapshotRetentionPeriod" => out.manual_snapshot_retention_period = xmlv.read_int(c.text())?
      "ManualSnapshotRemainingDays" => out.manual_snapshot_remaining_days = xmlv.read_int(c.text())?
      "SnapshotRetentionStartTime" => out.snapshot_retention_start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MasterPasswordSecretArn" => out.master_password_secret_arn = c.text()
      "MasterPasswordSecretKmsKeyId" => out.master_password_secret_kms_key_id = c.text()
      "SnapshotArn" => out.snapshot_arn = c.text()
      _ => {}
    }
  }
  Ok(out)
}

