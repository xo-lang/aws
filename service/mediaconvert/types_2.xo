pub enum MxfUncompressedAudioWrapping: Str {
  Auto = "AUTO"
  Aes3 = "AES3"
  Unknown(value: Str)
}

/// To create an output that complies with the XAVC file format guidelines
/// for interoperability, keep the default value, Drop frames for
/// compliance. To include all frames from your input in this output, keep
/// the default setting, Allow any duration. The number of frames that
/// MediaConvert excludes when you set this to Drop frames for compliance
/// depends on the output frame rate and duration.
pub enum MxfXavcDurationMode: Str {
  AllowAnyDuration = "ALLOW_ANY_DURATION"
  DropFramesForCompliance = "DROP_FRAMES_FOR_COMPLIANCE"
  Unknown(value: Str)
}

/// Specify the XAVC profile settings for MXF outputs when you set your MXF
/// profile to XAVC.
pub struct MxfXavcProfileSettings {
  /// To create an output that complies with the XAVC file format guidelines
