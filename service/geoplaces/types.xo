pub struct ValidationException {
  pub message: Str? = None
  /// Test stub for reason
  pub reason: ValidationExceptionReason? = None
  /// Test stub for FieldList.
  pub field_list: List[ValidationExceptionField]? = None
}

/// The input fails to satisfy the constraints specified by the Amazon
/// Location service.
pub struct ValidationExceptionField {
  /// The name of the resource.
  pub name: Str? = None
  /// The error message.
  pub message: Str? = None
}

pub enum ValidationExceptionReason: Str {
  UnknownOperation = "UnknownOperation"
  Missing = "Missing"
  CannotParse = "CannotParse"
  FieldValidationFailed = "FieldValidationFailed"
  Other = "Other"
  UnknownField = "UnknownField"
