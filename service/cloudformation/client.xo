    xmlv.elem(w, "DisableRollback", "${x}", [])
  }
  if let Some(x) = v.deployment_config {
    xml_write_deployment_config(w, x, "DeploymentConfig", [])
  }
  if let Some(x) = v.notification_arns {
    xml_write_notification_arns(w, x, "NotificationARNs", [])
  }
