  let out = p.client.list_test_sources(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}

/// The pages of ListTests. Each `next_page` sends the input with
/// the previous page's nextToken as its
/// nextToken.
pub struct ListTestsPaginator {
  client: Client
  input: ListTestsRequest
  first: Bool = true
  more: Bool = true
}

pub fn new_list_tests_paginator(c: Client, input: ListTestsRequest) -> ListTestsPaginator {
  ListTestsPaginator{client: c, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: ListTestsPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: ListTestsPaginator) next_page() -> ListTestsResponse ! ListTestsErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_tests(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}

