}

test "parses_map_of_recursive_structure_shapes" {
  let resp = http.Response{status: 200, headers: {"Content-Type": "application/x-amz-json-1.1"}, body: "{\"RecursiveMap\":{\"key-1\":{\"RecursiveMap\":{\"key-2\":{\"RecursiveMap\":{\"key-3\":{\"String\":\"value\"}}}}}}}".bytes()}
  let got = deserialize_kitchen_sink_operation(resp)?
  let want = KitchenSink{recursive_map: {"key-1": KitchenSink{recursive_map: {"key-2": KitchenSink{recursive_map: {"key-3": KitchenSink{string: "value"}}}}}}}
  expect("${got:?}") == "${want:?}"
}

test "parses_the_request_id_from_the_response" {
  let resp = http.Response{status: 200, headers: {"X-Amzn-Requestid": "amazon-uniq-request-id", "Content-Type": "application/x-amz-json-1.1"}, body: "{}".bytes()}
  let got = deserialize_kitchen_sink_operation(resp)?
  let want = KitchenSink{}
  expect("${got:?}") == "${want:?}"
}

test "AwsJson11StructuresDontSerializeNullValues" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
  let req = serialize_null_operation(ep, NullOperationInputOutput{}, TOKEN, 0)?
  protocoltest.check_request(req, protocoltest.RequestWant{method: "POST", uri: "/", headers: [("Content-Type", "application/x-amz-json-1.1"), ("X-Amz-Target", "JsonProtocol.NullOperation")], body: "{}", body_media_type: "application/json"})?
}

test "AwsJson11StructuresDontDeserializeNullValues" {
  let resp = http.Response{status: 200, headers: {"Content-Type": "application/x-amz-json-1.1"}, body: "{\n    \"string\": null\n}".bytes()}
  let got = deserialize_null_operation(resp)?
  let want = NullOperationInputOutput{}
  expect("${got:?}") == "${want:?}"
}

test "can_call_operation_with_no_input_or_output" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
  let req = serialize_operation_with_optional_input_output(ep, OperationWithOptionalInputOutputInput{}, TOKEN, 0)?
  protocoltest.check_request(req, protocoltest.RequestWant{method: "POST", uri: "/", headers: [("Content-Type", "application/x-amz-json-1.1"), ("X-Amz-Target", "JsonProtocol.OperationWithOptionalInputOutput")], body: "{}", body_media_type: "application/json"})?
}

test "can_call_operation_with_optional_input" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
  let req = serialize_operation_with_optional_input_output(ep, OperationWithOptionalInputOutputInput{value: "Hi"}, TOKEN, 0)?
  protocoltest.check_request(req, protocoltest.RequestWant{method: "POST", uri: "/", headers: [("Content-Type", "application/x-amz-json-1.1"), ("X-Amz-Target", "JsonProtocol.OperationWithOptionalInputOutput")], body: "{\"Value\":\"Hi\"}", body_media_type: "application/json"})?
}

test "PutAndGetInlineDocumentsInput" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
