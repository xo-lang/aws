fn json_of_job_identifier(v: JobIdentifier) -> json.Value {
  match v {
    FileName(x) => json.Value.Object([("fileName", json.Value.Str(x))])
    ScriptName(x) => json.Value.Object([("scriptName", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_job_identifier(v: json.Value) -> JobIdentifier ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "fileName" => Ok(JobIdentifier.FileName(jsonv.read_str(fv)?))
      "scriptName" => Ok(JobIdentifier.ScriptName(jsonv.read_str(fv)?))
      _ => Ok(JobIdentifier.Unknown(k))
    }
  }
  Err("JobIdentifier: no member set")
}

