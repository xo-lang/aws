fn json_of_vector_data(v: VectorData) -> json.Value {
  match v {
    Float32(x) => json.Value.Object([("float32", json_of_float32_vector_data(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_vector_data(v: json.Value) -> VectorData ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "float32" => Ok(VectorData.Float32(from_json_float32_vector_data(fv)?))
      _ => Ok(VectorData.Unknown(k))
    }
  }
  Err("VectorData: no member set")
}

