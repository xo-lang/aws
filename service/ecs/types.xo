  /// The current status of the Express service.
  pub status: ExpressGatewayServiceStatus? = None
  /// The current deployment configuration for the Express service.
  pub current_deployment: Str? = None
  /// The list of active service configurations for the Express service.
  pub active_configurations: List[ExpressGatewayServiceConfiguration]? = None
  /// The metadata applied to the Express service.
  pub tags: List[Tag]? = None
  /// The Unix timestamp for when the Express service was created.
  pub created_at: Time? = None
  /// The Unix timestamp for when the Express service was last updated.
  pub updated_at: Time? = None
}

