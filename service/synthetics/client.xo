    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return AssociateResourceErr.InternalServerException(x)
      Err(msg) => return AssociateResourceErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return AssociateResourceErr.ResourceNotFoundException(x)
      Err(msg) => return AssociateResourceErr.Deserialize(msg)
    }
    "ServiceQuotaExceededException" => match read_error_service_quota_exceeded_exception(resp, body) {
      Ok(x) => return AssociateResourceErr.ServiceQuotaExceededException(x)
      Err(msg) => return AssociateResourceErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return AssociateResourceErr.ValidationException(x)
      Err(msg) => return AssociateResourceErr.Deserialize(msg)
    }
    _ => {}
  }
  AssociateResourceErr.Api(restjson.api_error(resp, body))
}

/// Associates a canary with a group. Using groups can help you with
/// managing and automating your canaries, and you can also view aggregated
/// run results and statistics for all canaries in a group. You must run
/// this operation in the Region where the canary exists.
pub fn (c: Client) associate_resource(input: AssociateResourceRequest) -> AssociateResourceResponse ! AssociateResourceErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_associate_resource(c.params, input)) ?? e => return Err(AssociateResourceErr.InvalidInput(e))
  var req = serialize_associate_resource(ep, input, "") ?? e => return Err(AssociateResourceErr.InvalidInput(e))
