  first: Bool = true
  more: Bool = true
}

pub fn new_list_threat_models_paginator(c: Client, input: ListThreatModelsInput) -> ListThreatModelsPaginator {
  ListThreatModelsPaginator{client: c, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: ListThreatModelsPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: ListThreatModelsPaginator) next_page() -> ListThreatModelsOutput ! ListThreatModelsErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_threat_models(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}

/// The pages of ListThreats. Each `next_page` sends the input with
/// the previous page's nextToken as its
/// nextToken.
pub struct ListThreatsPaginator {
  client: Client
  input: ListThreatsInput
  first: Bool = true
  more: Bool = true
}

pub fn new_list_threats_paginator(c: Client, input: ListThreatsInput) -> ListThreatsPaginator {
  ListThreatsPaginator{client: c, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: ListThreatsPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: ListThreatsPaginator) next_page() -> ListThreatsOutput ! ListThreatsErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_threats(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
