  pub stack_trace: List[Str]? = None
}

/// An event that occurred during the execution of a durable function.
pub struct Event {
  /// The type of event that occurred.
  pub event_type: EventType? = None
  /// The subtype of the event, providing additional categorization.
  pub sub_type: Str? = None
  /// The unique identifier for this event. Event IDs increment sequentially.
  pub event_id: Int? = None
  /// The unique identifier for this operation.
  pub id: Str? = None
  /// The customer-provided name for this operation.
  pub name: Str? = None
  /// The date and time when this event occurred, in ISO-8601 format
  /// (YYYY-MM-DDThh:mm:ss.sTZD).
  pub event_timestamp: Time? = None
  /// The unique identifier of the parent operation, if this operation is
  /// running within a child context.
  pub parent_id: Str? = None
  /// Details about an execution that started.
  pub execution_started_details: ExecutionStartedDetails? = None
  /// Details about an execution that succeeded.
  pub execution_succeeded_details: ExecutionSucceededDetails? = None
  /// Details about an execution that failed.
  pub execution_failed_details: ExecutionFailedDetails? = None
  /// Details about an execution that timed out.
  pub execution_timed_out_details: ExecutionTimedOutDetails? = None
  /// Details about an execution that was stopped.
  pub execution_stopped_details: ExecutionStoppedDetails? = None
  /// Details about a context that started.
  pub context_started_details: ContextStartedDetails? = None
  /// Details about a context that succeeded.
  pub context_succeeded_details: ContextSucceededDetails? = None
  /// Details about a context that failed.
  pub context_failed_details: ContextFailedDetails? = None
  /// Details about a wait operation that started.
  pub wait_started_details: WaitStartedDetails? = None
  /// Details about a wait operation that succeeded.
  pub wait_succeeded_details: WaitSucceededDetails? = None
  /// Details about a wait operation that was cancelled.
  pub wait_cancelled_details: WaitCancelledDetails? = None
  /// Details about a step that started.
  pub step_started_details: StepStartedDetails? = None
  /// Details about a step that succeeded.
  pub step_succeeded_details: StepSucceededDetails? = None
  /// Details about a step that failed.
  pub step_failed_details: StepFailedDetails? = None
  pub chained_invoke_started_details: ChainedInvokeStartedDetails? = None
  /// Details about a chained invocation that succeeded.
  pub chained_invoke_succeeded_details: ChainedInvokeSucceededDetails? = None
  pub chained_invoke_failed_details: ChainedInvokeFailedDetails? = None
  /// Details about a chained invocation that timed out.
  pub chained_invoke_timed_out_details: ChainedInvokeTimedOutDetails? = None
  /// Details about a chained invocation that was stopped.
  pub chained_invoke_stopped_details: ChainedInvokeStoppedDetails? = None
  pub callback_started_details: CallbackStartedDetails? = None
  pub callback_succeeded_details: CallbackSucceededDetails? = None
  pub callback_failed_details: CallbackFailedDetails? = None
  pub callback_timed_out_details: CallbackTimedOutDetails? = None
  /// Details about a function invocation that completed.
  pub invocation_completed_details: InvocationCompletedDetails? = None
}

/// Error information for an event.
pub struct EventError {
  /// The error payload.
  pub payload: ErrorObject? = None
  /// Indicates if the error payload was truncated due to size limits.
  pub truncated: Bool? = None
}

/// Input information for an event.
pub struct EventInput {
  /// The input payload.
  pub payload: Str? = None
  /// Indicates if the error payload was truncated due to size limits.
  pub truncated: Bool? = None
}

/// Result information for an event.
pub struct EventResult {
  /// The result payload.
  pub payload: Str? = None
  /// Indicates if the error payload was truncated due to size limits.
  pub truncated: Bool? = None
}

/// A mapping between an Amazon Web Services resource and a Lambda function.
/// For details, see CreateEventSourceMapping .
pub struct EventSourceMappingConfiguration {
  /// The identifier of the event source mapping.
  pub uuid: Str? = None
  /// The position in a stream from which to start reading. Required for
  /// Amazon Kinesis and Amazon DynamoDB Stream event sources. AT_TIMESTAMP is
  /// supported only for Amazon Kinesis streams, Amazon DocumentDB, Amazon
  /// MSK, and self-managed Apache Kafka.
  pub starting_position: EventSourcePosition? = None
  /// With StartingPosition set to AT_TIMESTAMP , the time from which to start
  /// reading. StartingPositionTimestamp cannot be in the future.
  pub starting_position_timestamp: Time? = None
  /// The maximum number of records in each batch that Lambda pulls from your
  /// stream or queue and sends to your function. Lambda passes all of the
  /// records in the batch to the function in a single call, up to the payload
  /// limit for synchronous invocation (6 MB). Default value: Varies by
  /// service. For Amazon SQS, the default is 10. For all other services, the
  /// default is 100. Related setting: When you set BatchSize to a value
  /// greater than 10, you must set MaximumBatchingWindowInSeconds to at least
  /// 1.
  pub batch_size: Int? = None
  /// The maximum amount of time, in seconds, that Lambda spends gathering
  /// records before invoking the function. You can configure
  /// MaximumBatchingWindowInSeconds to any value from 0 seconds to 300
  /// seconds in increments of seconds. For streams and Amazon SQS event
  /// sources, the default batching window is 0 seconds. For Amazon MSK,
  /// Self-managed Apache Kafka, Amazon MQ, and DocumentDB event sources, the
  /// default batching window is 500 ms. Note that because you can only change
  /// MaximumBatchingWindowInSeconds in increments of seconds, you cannot
  /// revert back to the 500 ms default batching window after you have changed
  /// it. To restore the default batching window, you must create a new event
  /// source mapping. Related setting: For streams and Amazon SQS event
  /// sources, when you set BatchSize to a value greater than 10, you must set
  /// MaximumBatchingWindowInSeconds to at least 1.
  pub maximum_batching_window_in_seconds: Int? = None
  /// (Kinesis and DynamoDB Streams only) The number of batches to process
  /// concurrently from each shard. The default value is 1.
  pub parallelization_factor: Int? = None
  /// The Amazon Resource Name (ARN) of the event source.
  pub event_source_arn: Str? = None
  /// An object that defines the filter criteria that determine whether Lambda
  /// should process an event. For more information, see Lambda event
  /// filtering . If filter criteria is encrypted, this field shows up as null
  /// in the response of ListEventSourceMapping API calls. You can view this
  /// field in plaintext in the response of GetEventSourceMapping and
  /// DeleteEventSourceMapping calls if you have kms:Decrypt permissions for
  /// the correct KMS key.
  pub filter_criteria: FilterCriteria? = None
  /// An object that contains details about an error related to filter
  /// criteria encryption.
  pub filter_criteria_error: FilterCriteriaError? = None
  /// The ARN of the Key Management Service (KMS) customer managed key that
  /// Lambda uses to encrypt your function's filter criteria .
  pub kms_key_arn: Str? = None
  /// The metrics configuration for your event source. For more information,
  /// see Event source mapping metrics .
  pub metrics_config: EventSourceMappingMetricsConfig? = None
  /// (Amazon MSK, and self-managed Apache Kafka only) The logging
  /// configuration for your event source. For more information, see Event
  /// source mapping logging .
  pub logging_config: EventSourceMappingLoggingConfig? = None
  /// (Amazon SQS only) The scaling configuration for the event source. For
  /// more information, see Configuring maximum concurrency for Amazon SQS
  /// event sources .
  pub scaling_config: ScalingConfig? = None
  /// The ARN of the Lambda function.
  pub function_arn: Str? = None
  /// The date that the event source mapping was last updated or that its
  /// state changed.
  pub last_modified: Time? = None
  /// The result of the event source mapping's last processing attempt.
  pub last_processing_result: Str? = None
  /// The state of the event source mapping. It can be one of the following:
  /// Creating , Enabling , Enabled , Disabling , Disabled , Updating , or
  /// Deleting .
  pub state: Str? = None
  /// Indicates whether a user or Lambda made the last change to the event
  /// source mapping.
  pub state_transition_reason: Str? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka) A
  /// configuration object that specifies the destination of an event after
  /// Lambda processes it.
  pub destination_config: DestinationConfig? = None
  /// The name of the Kafka topic.
  pub topics: List[Str]? = None
  /// (Amazon MQ) The name of the Amazon MQ broker destination queue to
  /// consume.
  pub queues: List[Str]? = None
  /// An array of the authentication protocol, VPC components, or virtual host
  /// to secure and define your event source.
  pub source_access_configurations: List[SourceAccessConfiguration]? = None
  /// The self-managed Apache Kafka cluster for your event source.
  pub self_managed_event_source: SelfManagedEventSource? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// Discard records older than the specified age. The default value is -1,
  /// which sets the maximum age to infinite. When the value is set to
  /// infinite, Lambda never discards old records. The minimum valid value for
  /// maximum record age is 60s. Although values less than 60 and greater than
  /// -1 fall within the parameter's absolute range, they are not allowed
  pub maximum_record_age_in_seconds: Int? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// If the function returns an error, split the batch in two and retry. The
  /// default value is false.
  pub bisect_batch_on_function_error: Bool? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// Discard records after the specified number of retries. The default value
  /// is -1, which sets the maximum number of retries to infinite. When
  /// MaximumRetryAttempts is infinite, Lambda retries failed records until
  /// the record expires in the event source.
  pub maximum_retry_attempts: Int? = None
  /// (Kinesis and DynamoDB Streams only) The duration in seconds of a
  /// processing window for DynamoDB and Kinesis Streams event sources. A
  /// value of 0 seconds indicates no tumbling window.
  pub tumbling_window_in_seconds: Int? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, self-managed Apache Kafka, and
  /// Amazon SQS) A list of current response type enums applied to the event
  /// source mapping.
  pub function_response_types: List[FunctionResponseType]? = None
  /// Specific configuration settings for an Amazon Managed Streaming for
  /// Apache Kafka (Amazon MSK) event source.
  pub amazon_managed_kafka_event_source_config: AmazonManagedKafkaEventSourceConfig? = None
  /// Specific configuration settings for a self-managed Apache Kafka event
  /// source.
  pub self_managed_kafka_event_source_config: SelfManagedKafkaEventSourceConfig? = None
  /// Specific configuration settings for a DocumentDB event source.
  pub document_db_event_source_config: DocumentDBEventSourceConfig? = None
  /// The Amazon Resource Name (ARN) of the event source mapping.
  pub event_source_mapping_arn: Str? = None
  /// (Amazon SQS, Amazon MSK, and self-managed Apache Kafka only) The
  /// provisioned mode configuration for the event source. For more
  /// information, see provisioned mode .
  pub provisioned_poller_config: ProvisionedPollerConfig? = None
}

/// (Amazon MSK, and self-managed Apache Kafka only) The logging
/// configuration for your event source. Use this configuration object to
/// define the level of logs for your event source mapping.
pub struct EventSourceMappingLoggingConfig {
  /// The log level you want your event source mapping to use. Lambda event
  /// poller only sends system logs at the selected level of detail and lower,
  /// where DEBUG is the highest level and WARN is the lowest. For more
  /// information about these metrics, see Event source mapping logging .
  pub system_log_level: EventSourceMappingSystemLogLevel? = None
}

