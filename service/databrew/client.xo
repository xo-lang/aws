fn from_json_job_run(v: json.Value) -> JobRun ! Str {
  var out = JobRun{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Attempt" => out.attempt = jsonv.read_int(fv)?
      "CompletedOn" => out.completed_on = jsonv.read_time(fv, "epoch-seconds")?
      "DatasetName" => out.dataset_name = jsonv.read_str(fv)?
      "ErrorMessage" => out.error_message = jsonv.read_str(fv)?
      "ExecutionTime" => out.execution_time = jsonv.read_int(fv)?
      "JobName" => out.job_name = jsonv.read_str(fv)?
      "RunId" => out.run_id = jsonv.read_str(fv)?
      "State" => out.state = JobRunState.from(jsonv.read_str(fv)?)
      "LogSubscription" => out.log_subscription = LogSubscription.from(jsonv.read_str(fv)?)
      "LogGroupName" => out.log_group_name = jsonv.read_str(fv)?
      "Outputs" => out.outputs = from_json_output_list(fv)?
      "DataCatalogOutputs" => out.data_catalog_outputs = from_json_data_catalog_output_list(fv)?
      "DatabaseOutputs" => out.database_outputs = from_json_database_output_list(fv)?
      "RecipeReference" => out.recipe_reference = from_json_recipe_reference(fv)?
      "StartedBy" => out.started_by = jsonv.read_str(fv)?
      "StartedOn" => out.started_on = jsonv.read_time(fv, "epoch-seconds")?
      "JobSample" => out.job_sample = from_json_job_sample(fv)?
      "ValidationConfigurations" => out.validation_configurations = from_json_validation_configuration_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_job_run_list(v: List[JobRun]) -> json.Value {
  json.Value.List(v.map(fn(x: JobRun) -> json.Value { json_of_job_run(x) }))
}

fn from_json_job_run_list(v: json.Value) -> List[JobRun] ! Str {
  var out: List[JobRun] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_job_run(fv)?)
  }
  Ok(out)
}

