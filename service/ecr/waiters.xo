/// Wait until an image scan is complete and findings can be accessed
///
/// Calls DescribeImageScanFindings until the ImageScanComplete acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (120s).
pub fn wait_until_image_scan_complete(c: Client, input: DescribeImageScanFindingsRequest, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeImageScanFindingsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_image_scan_findings(input) {
      Ok(out) => {
        let o = jmes_of_describe_image_scan_findings_response(out)
        if state == "" && waiter.path_matches(o, "imageScanStatus.status", "stringEquals", "COMPLETE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "imageScanStatus.status", "stringEquals", "FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ImageScanComplete: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

