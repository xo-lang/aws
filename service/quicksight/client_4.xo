fn json_of_radar_chart_configuration(v: RadarChartConfiguration) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.field_wells {
    fs.push(("FieldWells", json_of_radar_chart_field_wells(x)))
  }
  if let Some(x) = v.sort_configuration {
    fs.push(("SortConfiguration", json_of_radar_chart_sort_configuration(x)))
  }
  if let Some(x) = v.shape {
    fs.push(("Shape", json.Value.Str(x.value())))
  }
  if let Some(x) = v.base_series_settings {
    fs.push(("BaseSeriesSettings", json_of_radar_chart_series_settings(x)))
  }
  if let Some(x) = v.start_angle {
    fs.push(("StartAngle", jsonv.float(x)))
  }
  if let Some(x) = v.visual_palette {
    fs.push(("VisualPalette", json_of_visual_palette(x)))
  }
  if let Some(x) = v.alternate_band_colors_visibility {
    fs.push(("AlternateBandColorsVisibility", json.Value.Str(x.value())))
  }
  if let Some(x) = v.alternate_band_even_color {
    fs.push(("AlternateBandEvenColor", json.Value.Str(x)))
  }
  if let Some(x) = v.alternate_band_odd_color {
    fs.push(("AlternateBandOddColor", json.Value.Str(x)))
  }
  if let Some(x) = v.category_axis {
    fs.push(("CategoryAxis", json_of_axis_display_options(x)))
  }
  if let Some(x) = v.category_label_options {
    fs.push(("CategoryLabelOptions", json_of_chart_axis_label_options(x)))
  }
  if let Some(x) = v.color_axis {
    fs.push(("ColorAxis", json_of_axis_display_options(x)))
  }
  if let Some(x) = v.color_label_options {
    fs.push(("ColorLabelOptions", json_of_chart_axis_label_options(x)))
  }
  if let Some(x) = v.legend {
    fs.push(("Legend", json_of_legend_options(x)))
  }
  if let Some(x) = v.axes_range_scale {
    fs.push(("AxesRangeScale", json.Value.Str(x.value())))
  }
  if let Some(x) = v.interactions {
    fs.push(("Interactions", json_of_visual_interaction_options(x)))
  }
  json.Value.Object(fs)
}

fn from_json_radar_chart_configuration(v: json.Value) -> RadarChartConfiguration ! Str {
  var out = RadarChartConfiguration{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "FieldWells" => out.field_wells = from_json_radar_chart_field_wells(fv)?
      "SortConfiguration" => out.sort_configuration = from_json_radar_chart_sort_configuration(fv)?
