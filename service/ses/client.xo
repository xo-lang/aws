fn xml_write_verification_attributes(var w: xmlv.Writer, v: Map[Str, IdentityVerificationAttributes], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xml_write_identity_verification_attributes(w, item, "value", [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_verification_attributes(e: xml.Element) -> Map[Str, IdentityVerificationAttributes] ! Str {
  var out: Map[Str, IdentityVerificationAttributes] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, xml_read_identity_verification_attributes(vc)?)
    }
  }
  Ok(out)
}

