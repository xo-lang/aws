  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(UpdateDistributionWithStagingConfigErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_distribution_with_staging_config_error(resp))
  }
  deserialize_update_distribution_with_staging_config(resp) ?? e => Err(UpdateDistributionWithStagingConfigErr.Deserialize(e))
}

