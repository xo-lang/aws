      Err(e) => return Err(InvokeAgentRuntimeCommandStreamOutputErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
