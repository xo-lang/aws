  }
  if let Some(x) = v.end_time {
    fs.push(("endTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.total_time_ms {
    fs.push(("totalTimeMs", json.Value.Int(x)))
  }
  if let Some(x) = v.operation_total_time_ms {
    fs.push(("operationTotalTimeMs", json.Value.Int(x)))
  }
  if let Some(x) = v.client_request_id {
    fs.push(("clientRequestId", json.Value.Str(x)))
  }
  if let Some(x) = v.usage {
    fs.push(("usage", json_of_usage(x)))
  }
  json.Value.Object(fs)
}

fn from_json_metadata(v: json.Value) -> Metadata ! Str {
  var out = Metadata{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "startTime" => out.start_time = jsonv.read_time(fv, "date-time")?
      "endTime" => out.end_time = jsonv.read_time(fv, "date-time")?
