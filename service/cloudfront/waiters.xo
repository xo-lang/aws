/// Wait until a distribution is deployed.
///
/// Calls GetDistribution until the DistributionDeployed acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (60s) to `max_delay` (2100s).
pub fn wait_until_distribution_deployed(c: Client, input: GetDistributionRequest, max_wait: Duration, min_delay: Duration = 60s, max_delay: Duration = 2100s) -> () ! waiter.WaitErr[GetDistributionErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_distribution(input) {
      Ok(out) => {
        let o = jmes_of_get_distribution_result(out)
        if state == "" && waiter.path_matches(o, "Distribution.Status", "stringEquals", "Deployed") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("DistributionDeployed: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until an invalidation has completed.
///
/// Calls GetInvalidation until the InvalidationCompleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (20s) to `max_delay` (600s).
pub fn wait_until_invalidation_completed(c: Client, input: GetInvalidationRequest, max_wait: Duration, min_delay: Duration = 20s, max_delay: Duration = 600s) -> () ! waiter.WaitErr[GetInvalidationErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_invalidation(input) {
      Ok(out) => {
        let o = jmes_of_get_invalidation_result(out)
        if state == "" && waiter.path_matches(o, "Invalidation.Status", "stringEquals", "Completed") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("InvalidationCompleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until an invalidation for distribution tenant has completed.
///
/// Calls GetInvalidationForDistributionTenant until the InvalidationForDistributionTenantCompleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (20s) to `max_delay` (600s).
pub fn wait_until_invalidation_for_distribution_tenant_completed(c: Client, input: GetInvalidationForDistributionTenantRequest, max_wait: Duration, min_delay: Duration = 20s, max_delay: Duration = 600s) -> () ! waiter.WaitErr[GetInvalidationForDistributionTenantErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_invalidation_for_distribution_tenant(input) {
      Ok(out) => {
        let o = jmes_of_get_invalidation_for_distribution_tenant_result(out)
        if state == "" && waiter.path_matches(o, "Invalidation.Status", "stringEquals", "Completed") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("InvalidationForDistributionTenantCompleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

