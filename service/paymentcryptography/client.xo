      "CreateTimestamp" => out.create_timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "UsageStartTimestamp" => out.usage_start_timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "UsageStopTimestamp" => out.usage_stop_timestamp = jsonv.read_time(fv, "epoch-seconds")?
