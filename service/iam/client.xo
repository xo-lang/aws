fn xml_write_map_string_replacement_value_entry(var w: xmlv.Writer, v: Map[Str, ReplacementValueEntry], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xml_write_replacement_value_entry(w, item, "value", [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_map_string_replacement_value_entry(e: xml.Element) -> Map[Str, ReplacementValueEntry] ! Str {
  var out: Map[Str, ReplacementValueEntry] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, xml_read_replacement_value_entry(vc)?)
    }
  }
  Ok(out)
}

