fn xml_write_registered_instance(var w: xmlv.Writer, v: RegisteredInstance, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.sql_server_license_usage {
    xmlv.elem(w, "sqlServerLicenseUsage", x.value(), [])
  }
  if let Some(x) = v.ha_status {
    xmlv.elem(w, "haStatus", x.value(), [])
  }
  if let Some(x) = v.processing_status {
    xmlv.elem(w, "processingStatus", x, [])
  }
  if let Some(x) = v.last_updated_time {
    xmlv.elem(w, "lastUpdatedTime", rest.date_time(x), [])
  }
  if let Some(x) = v.sql_server_credentials {
    xmlv.elem(w, "sqlServerCredentials", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_registered_instance(e: xml.Element) -> RegisteredInstance ! Str {
  var out = RegisteredInstance{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "instanceId" => out.instance_id = c.text()
      "sqlServerLicenseUsage" => out.sql_server_license_usage = SqlServerLicenseUsage.from(c.text())
      "haStatus" => out.ha_status = HaStatus.from(c.text())
      "processingStatus" => out.processing_status = c.text()
      "lastUpdatedTime" => out.last_updated_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "sqlServerCredentials" => out.sql_server_credentials = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

