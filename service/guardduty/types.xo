/// Contains information about the criteria used to query usage statistics.
pub struct UsageCriteria {
  /// The account IDs to aggregate usage statistics from.
  pub account_ids: List[Str]? = None
  /// The data sources to aggregate usage statistics from.
  pub data_sources: List[DataSource]? = None
  /// The resources to aggregate usage statistics from. Only accepts exact
  /// resource names.
  pub resources: List[Str]? = None
  /// The features to aggregate usage statistics from.
  pub features: List[UsageFeature]? = None
}

/// Contains information on the result of usage based on data source type.
pub struct UsageDataSourceResult {
  /// The data source type that generated usage.
  pub data_source: DataSource? = None
  /// Represents the total of usage for the specified data source.
  pub total: Total? = None
}

pub enum UsageFeature: Str {
  FlowLogs = "FLOW_LOGS"
  CloudTrail = "CLOUD_TRAIL"
  DnsLogs = "DNS_LOGS"
  S3DataEvents = "S3_DATA_EVENTS"
  EksAuditLogs = "EKS_AUDIT_LOGS"
  EbsMalwareProtection = "EBS_MALWARE_PROTECTION"
  RdsLoginEvents = "RDS_LOGIN_EVENTS"
  LambdaNetworkLogs = "LAMBDA_NETWORK_LOGS"
  EksRuntimeMonitoring = "EKS_RUNTIME_MONITORING"
  Ec2RuntimeMonitoring = "EC2_RUNTIME_MONITORING"
  FargateRuntimeMonitoring = "FARGATE_RUNTIME_MONITORING"
  RdsDbiProtectionProvisioned = "RDS_DBI_PROTECTION_PROVISIONED"
  RdsDbiProtectionServerless = "RDS_DBI_PROTECTION_SERVERLESS"
  RdsDbiProtectionLimitless = "RDS_DBI_PROTECTION_LIMITLESS"
  RdsDataActivityDbiProtectionProvisioned = "RDS_DATA_ACTIVITY_DBI_PROTECTION_PROVISIONED"
  RdsDataActivityDbiProtectionServerless = "RDS_DATA_ACTIVITY_DBI_PROTECTION_SERVERLESS"
  RdsDataActivityDbiProtectionLimitless = "RDS_DATA_ACTIVITY_DBI_PROTECTION_LIMITLESS"
  AiProtection = "AI_PROTECTION"
  Unknown(value: Str)
}

/// Contains information about the result of the total usage based on the
/// feature.
pub struct UsageFeatureResult {
  /// The feature that generated the usage cost.
  pub feature: UsageFeature? = None
  pub total: Total? = None
}

/// Contains information on the sum of usage based on an Amazon Web Services
/// resource.
pub struct UsageResourceResult {
  /// The Amazon Web Services resource that generated usage.
  pub resource: Str? = None
  /// Represents the sum total of usage for the specified resource type.
  pub total: Total? = None
}

pub enum UsageStatisticType: Str {
  SumByAccount = "SUM_BY_ACCOUNT"
  SumByDataSource = "SUM_BY_DATA_SOURCE"
  SumByResource = "SUM_BY_RESOURCE"
  TopResources = "TOP_RESOURCES"
  SumByFeatures = "SUM_BY_FEATURES"
  TopAccountsByFeature = "TOP_ACCOUNTS_BY_FEATURE"
  Unknown(value: Str)
}

/// Contains the result of GuardDuty usage. If a UsageStatisticType is
/// provided the result for other types will be null.
pub struct UsageStatistics {
  /// The usage statistic sum organized by account ID.
  pub sum_by_account: List[UsageAccountResult]? = None
  /// Lists the top 50 accounts by feature that have generated the most
  /// GuardDuty usage, in the order from most to least expensive. Currently,
  /// this doesn't support RDS_LOGIN_EVENTS .
  pub top_accounts_by_feature: List[UsageTopAccountsResult]? = None
  /// The usage statistic sum organized by on data source.
  pub sum_by_data_source: List[UsageDataSourceResult]? = None
  /// The usage statistic sum organized by resource.
  pub sum_by_resource: List[UsageResourceResult]? = None
  /// Lists the top 50 resources that have generated the most GuardDuty usage,
  /// in order from most to least expensive.
  pub top_resources: List[UsageResourceResult]? = None
  /// The usage statistic sum organized by feature.
  pub sum_by_feature: List[UsageFeatureResult]? = None
}

/// Contains information on the total of usage based on the topmost 50
/// account IDs.
pub struct UsageTopAccountResult {
  /// The unique account ID.
  pub account_id: Str? = None
  pub total: Total? = None
}

/// Information about the usage statistics, calculated by top accounts by
/// feature.
pub struct UsageTopAccountsResult {
  /// Features by which you can generate the usage statistics.
  /// RDS_LOGIN_EVENTS is currently not supported with topAccountsByFeature .
  pub feature: UsageFeature? = None
  /// The accounts that contributed to the total usage cost.
  pub accounts: List[UsageTopAccountResult]? = None
}

/// Contains information about the user involved in the attack sequence.
pub struct User {
  /// The name of the user.
  pub name: Str? = None
  /// The unique identifier of the user.
  pub uid: Str? = None
  /// The type of the user.
  pub type_value: Str? = None
  /// The credentials of the user ID.
  pub credential_uid: Str? = None
  /// Contains information about the Amazon Web Services account within which
  /// the activity took place. This is not necessarily the account that owns
  /// the user identity.
  pub account: Account? = None
}

/// Volume used by the Kubernetes workload.
pub struct Volume {
  /// Volume name.
  pub name: Str? = None
  /// Represents a pre-existing file or directory on the host machine that the
  /// volume maps to.
  pub host_path: HostPath? = None
}

/// Contains EBS volume details.
pub struct VolumeDetail {
  /// EBS volume ARN information.
  pub volume_arn: Str? = None
  /// The EBS volume type.
  pub volume_type: Str? = None
  /// The device name for the EBS volume.
  pub device_name: Str? = None
  /// EBS volume size in GB.
  pub volume_size_in_gb: Int? = None
  /// EBS volume encryption type.
  pub encryption_type: Str? = None
  /// Snapshot ARN of the EBS volume.
  pub snapshot_arn: Str? = None
  /// KMS key ARN used to encrypt the EBS volume.
  pub kms_key_arn: Str? = None
}

/// Container volume mount.
pub struct VolumeMount {
  /// Volume mount name.
  pub name: Str? = None
  /// Volume mount path.
  pub mount_path: Str? = None
}

/// Amazon Virtual Private Cloud configuration details associated with your
/// Lambda function.
pub struct VpcConfig {
  /// The identifiers of the subnets that are associated with your Lambda
  /// function.
  pub subnet_ids: List[Str]? = None
  /// The identifier of the Amazon Virtual Private Cloud.
  pub vpc_id: Str? = None
  /// The identifier of the security group attached to the Lambda function.
  pub security_groups: List[SecurityGroup]? = None
}
