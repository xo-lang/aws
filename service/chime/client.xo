fn json_of_phone_number(v: PhoneNumber) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.phone_number_id {
    fs.push(("PhoneNumberId", json.Value.Str(x)))
  }
  if let Some(x) = v.e164_phone_number {
    fs.push(("E164PhoneNumber", json.Value.Str(x)))
  }
  if let Some(x) = v.country {
    fs.push(("Country", json.Value.Str(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.product_type {
    fs.push(("ProductType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.capabilities {
    fs.push(("Capabilities", json_of_phone_number_capabilities(x)))
  }
  if let Some(x) = v.associations {
    fs.push(("Associations", json_of_phone_number_association_list(x)))
  }
  if let Some(x) = v.calling_name {
    fs.push(("CallingName", json.Value.Str(x)))
  }
  if let Some(x) = v.calling_name_status {
    fs.push(("CallingNameStatus", json.Value.Str(x.value())))
  }
