fn json_of_status_details_map(v: Map[Str, SchedulerResourceStatus]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, SchedulerResourceStatus)) -> (Str, json.Value) { (e.0, json.Value.Str(e.1.value())) }))
}

fn from_json_status_details_map(v: json.Value) -> Map[Str, SchedulerResourceStatus] ! Str {
  var out: Map[Str, SchedulerResourceStatus] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, SchedulerResourceStatus.from(jsonv.read_str(fv)?))
  }
  Ok(out)
}

