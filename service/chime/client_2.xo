/// The HTTP request of UpdateUserSettings.
pub fn serialize_update_user_settings(ep: rest.Endpoint, input: UpdateUserSettingsRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_account_id = match input.account_id {
    Some(v) => v
    None => return Err("input member AccountId is required")
  }
  if label_account_id == "" {
    return Err("input member AccountId must not be empty")
  }
  let label_user_id = match input.user_id {
    Some(v) => v
    None => return Err("input member UserId is required")
  }
  if label_user_id == "" {
    return Err("input member UserId must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.user_settings {
    fs.push(("UserSettings", json_of_user_settings(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PUT",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/accounts/${rest.escape(label_account_id, false)}/users/${rest.escape(label_user_id, false)}/settings"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

