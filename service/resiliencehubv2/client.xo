  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.availability_slo {
    fs.push(("availabilitySlo", json_of_availability_slo(x)))
  }
  if let Some(x) = v.multi_az {
    fs.push(("multiAz", json_of_multi_az_targets(x)))
  }
  if let Some(x) = v.multi_region {
    fs.push(("multiRegion", json_of_multi_region_targets(x)))
  }
  if let Some(x) = v.data_recovery {
    fs.push(("dataRecovery", json_of_data_recovery_targets(x)))
  }
  if let Some(x) = v.sharing_enabled {
    fs.push(("sharingEnabled", json.Value.Bool(x)))
  }
  if let Some(x) = v.organization_id {
    fs.push(("organizationId", json.Value.Str(x)))
  }
  if let Some(x) = v.kms_key_id {
    fs.push(("kmsKeyId", json.Value.Str(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tag_map(x)))
  }
  if let Some(x) = v.associated_service_count {
    fs.push(("associatedServiceCount", json.Value.Int(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("updatedAt", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

