fn json_of_model(v: Model) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.model_name {
    fs.push(("ModelName", json.Value.Str(x)))
  }
  if let Some(x) = v.primary_container {
    fs.push(("PrimaryContainer", json_of_container_definition(x)))
  }
  if let Some(x) = v.containers {
    fs.push(("Containers", json_of_container_definition_list(x)))
  }
  if let Some(x) = v.inference_execution_config {
    fs.push(("InferenceExecutionConfig", json_of_inference_execution_config(x)))
  }
  if let Some(x) = v.execution_role_arn {
    fs.push(("ExecutionRoleArn", json.Value.Str(x)))
  }
  if let Some(x) = v.vpc_config {
    fs.push(("VpcConfig", json_of_vpc_config(x)))
  }
  if let Some(x) = v.creation_time {
    fs.push(("CreationTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.model_arn {
    fs.push(("ModelArn", json.Value.Str(x)))
  }
  if let Some(x) = v.enable_network_isolation {
    fs.push(("EnableNetworkIsolation", json.Value.Bool(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_list(x)))
  }
