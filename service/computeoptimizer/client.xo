  }
  if let Some(x) = v.effective_recommendation_preferences {
    fs.push(("effectiveRecommendationPreferences", json_of_lambda_effective_recommendation_preferences(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tags(x)))
