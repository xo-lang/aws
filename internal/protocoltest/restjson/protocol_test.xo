test "RestJsonQueryIdempotencyTokenAutoFill" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
  let req = serialize_query_idempotency_token_auto_fill(ep, QueryIdempotencyTokenAutoFillInput{}, TOKEN, 0)?
  protocoltest.check_request(req, protocoltest.RequestWant{method: "POST", uri: "/QueryIdempotencyTokenAutoFill", query_params: ["token=00000000-0000-4000-8000-000000000000"], body: ""})?
}

test "RestJsonQueryIdempotencyTokenAutoFillIsSet" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
  let req = serialize_query_idempotency_token_auto_fill(ep, QueryIdempotencyTokenAutoFillInput{token: "00000000-0000-4000-8000-000000000000"}, TOKEN, 0)?
  protocoltest.check_request(req, protocoltest.RequestWant{method: "POST", uri: "/QueryIdempotencyTokenAutoFill", query_params: ["token=00000000-0000-4000-8000-000000000000"], body: ""})?
