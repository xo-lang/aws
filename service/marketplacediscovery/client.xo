      "paymentScheduleTerm" => Ok(OfferTerm.PaymentScheduleTerm(from_json_payment_schedule_term(fv)?))
      "recurringPaymentTerm" => Ok(OfferTerm.RecurringPaymentTerm(from_json_recurring_payment_term(fv)?))
      "renewalTerm" => Ok(OfferTerm.RenewalTerm(from_json_renewal_term(fv)?))
      "supportTerm" => Ok(OfferTerm.SupportTerm(from_json_support_term(fv)?))
      "usageBasedPricingTerm" => Ok(OfferTerm.UsageBasedPricingTerm(from_json_usage_based_pricing_term(fv)?))
      "validityTerm" => Ok(OfferTerm.ValidityTerm(from_json_validity_term(fv)?))
      "variablePaymentTerm" => Ok(OfferTerm.VariablePaymentTerm(from_json_variable_payment_term(fv)?))
      "netPaymentTerm" => Ok(OfferTerm.NetPaymentTerm(from_json_net_payment_term(fv)?))
      _ => Ok(OfferTerm.Unknown(k))
    }
  }
  Err("OfferTerm: no member set")
}

