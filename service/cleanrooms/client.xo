fn json_of_schema(v: Schema) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.columns {
    fs.push(("columns", json_of_column_list(x)))
  }
  if let Some(x) = v.partition_keys {
    fs.push(("partitionKeys", json_of_column_list(x)))
  }
  if let Some(x) = v.analysis_rule_types {
    fs.push(("analysisRuleTypes", json_of_analysis_rule_type_list(x)))
  }
  if let Some(x) = v.analysis_method {
    fs.push(("analysisMethod", json.Value.Str(x.value())))
  }
  if let Some(x) = v.selected_analysis_methods {
    fs.push(("selectedAnalysisMethods", json_of_selected_analysis_methods(x)))
  }
  if let Some(x) = v.creator_account_id {
    fs.push(("creatorAccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.collaboration_id {
    fs.push(("collaborationId", json.Value.Str(x)))
  }
  if let Some(x) = v.collaboration_arn {
    fs.push(("collaborationArn", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.create_time {
    fs.push(("createTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.update_time {
    fs.push(("updateTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.type_value {
    fs.push(("type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.schema_status_details {
    fs.push(("schemaStatusDetails", json_of_schema_status_detail_list(x)))
  }
  if let Some(x) = v.resource_arn {
    fs.push(("resourceArn", json.Value.Str(x)))
  }
  if let Some(x) = v.schema_type_properties {
    fs.push(("schemaTypeProperties", json_of_schema_type_properties(x)))
  }
  json.Value.Object(fs)
}

fn from_json_schema(v: json.Value) -> Schema ! Str {
  var out = Schema{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "columns" => out.columns = from_json_column_list(fv)?
      "partitionKeys" => out.partition_keys = from_json_column_list(fv)?
      "analysisRuleTypes" => out.analysis_rule_types = from_json_analysis_rule_type_list(fv)?
      "analysisMethod" => out.analysis_method = AnalysisMethod.from(jsonv.read_str(fv)?)
      "selectedAnalysisMethods" => out.selected_analysis_methods = from_json_selected_analysis_methods(fv)?
      "creatorAccountId" => out.creator_account_id = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "collaborationId" => out.collaboration_id = jsonv.read_str(fv)?
      "collaborationArn" => out.collaboration_arn = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "createTime" => out.create_time = jsonv.read_time(fv, "epoch-seconds")?
      "updateTime" => out.update_time = jsonv.read_time(fv, "epoch-seconds")?
      "type" => out.type_value = SchemaType.from(jsonv.read_str(fv)?)
      "schemaStatusDetails" => out.schema_status_details = from_json_schema_status_detail_list(fv)?
      "resourceArn" => out.resource_arn = jsonv.read_str(fv)?
      "schemaTypeProperties" => out.schema_type_properties = from_json_schema_type_properties(fv)?
      _ => {}
    }
  }
  Ok(out)
}

