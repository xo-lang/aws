}

/// A request member that failed validation.
pub struct ValidationExceptionField {
  /// The name of the request member that failed validation. For a member
  /// nested inside another member, the name is a path from the request root,
  /// with the segments separated by periods.
  pub name: Str? = None
  /// A description of why this member failed validation.
  pub message: Str? = None
}

pub enum ValidationExceptionReason: Str {
  CannotParse = "CANNOT_PARSE"
  FieldValidationFailed = "FIELD_VALIDATION_FAILED"
  InvalidPaginationToken = "INVALID_PAGINATION_TOKEN"
  UnsupportedAction = "UNSUPPORTED_ACTION"
  Other = "OTHER"
