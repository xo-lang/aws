fn xml_write_option_status(var w: xmlv.Writer, v: OptionStatus, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.creation_date {
    xmlv.elem(w, "CreationDate", rest.date_time(x), [])
  }
  if let Some(x) = v.update_date {
    xmlv.elem(w, "UpdateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.update_version {
    xmlv.elem(w, "UpdateVersion", "${x}", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "State", x.value(), [])
  }
  if let Some(x) = v.pending_deletion {
    xmlv.elem(w, "PendingDeletion", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_option_status(e: xml.Element) -> OptionStatus ! Str {
  var out = OptionStatus{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "CreationDate" => out.creation_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UpdateDate" => out.update_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UpdateVersion" => out.update_version = xmlv.read_int(c.text())?
      "State" => out.state = OptionState.from(c.text())
      "PendingDeletion" => out.pending_deletion = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

