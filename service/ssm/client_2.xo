/// The HTTP request of AddTagsToResource.
pub fn serialize_add_tags_to_resource(ep: rest.Endpoint, input: AddTagsToResourceRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.resource_type {
    fs.push(("ResourceType", json.Value.Str(x.value())))
  }
  if let Some(x) = input.resource_id {
    fs.push(("ResourceId", json.Value.Str(x)))
  }
  if let Some(x) = input.tags {
    fs.push(("Tags", json_of_tag_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.1"))
  headers.push(("X-Amz-Target", "AmazonSSM.AddTagsToResource"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

