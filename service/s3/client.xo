fn xml_write_metrics_filter(var w: xmlv.Writer, v: MetricsFilter, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    Prefix(x) => {
      xmlv.elem(w, "Prefix", x, [])
    }
    Tag(x) => {
      xml_write_tag(w, x, "Tag", [])
    }
    AccessPointArn(x) => {
      xmlv.elem(w, "AccessPointArn", x, [])
    }
    And(x) => {
      xml_write_metrics_and_operator(w, x, "And", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_metrics_filter(e: xml.Element) -> MetricsFilter ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "Prefix" => Ok(MetricsFilter.Prefix(c.text()))
      "Tag" => Ok(MetricsFilter.Tag(xml_read_tag(c)?))
      "AccessPointArn" => Ok(MetricsFilter.AccessPointArn(c.text()))
      "And" => Ok(MetricsFilter.And(xml_read_metrics_and_operator(c)?))
      _ => Ok(MetricsFilter.Unknown(c.name.local))
    }
  }
  Err("MetricsFilter: no member set")
}

fn xml_write_multipart_upload(var w: xmlv.Writer, v: MultipartUpload, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.upload_id {
    xmlv.elem(w, "UploadId", x, [])
  }
  if let Some(x) = v.key {
    xmlv.elem(w, "Key", x, [])
  }
  if let Some(x) = v.initiated {
    xmlv.elem(w, "Initiated", rest.date_time(x), [])
  }
  if let Some(x) = v.storage_class {
    xmlv.elem(w, "StorageClass", x.value(), [])
  }
  if let Some(x) = v.owner {
    xml_write_owner(w, x, "Owner", [])
  }
  if let Some(x) = v.initiator {
    xml_write_initiator(w, x, "Initiator", [])
  }
  if let Some(x) = v.checksum_algorithm {
    xmlv.elem(w, "ChecksumAlgorithm", x.value(), [])
  }
  if let Some(x) = v.checksum_type {
    xmlv.elem(w, "ChecksumType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_multipart_upload(e: xml.Element) -> MultipartUpload ! Str {
  var out = MultipartUpload{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "UploadId" => out.upload_id = c.text()
      "Key" => out.key = c.text()
      "Initiated" => out.initiated = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "StorageClass" => out.storage_class = StorageClass.from(c.text())
      "Owner" => out.owner = xml_read_owner(c)?
      "Initiator" => out.initiator = xml_read_initiator(c)?
      "ChecksumAlgorithm" => out.checksum_algorithm = ChecksumAlgorithm.from(c.text())
      "ChecksumType" => out.checksum_type = ChecksumType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

