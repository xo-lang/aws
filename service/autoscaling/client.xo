  }
  if let Some(x) = v.instance_generations {
    xml_write_instance_generations(w, x, "InstanceGenerations", [])
  }
  if let Some(x) = v.spot_max_price_percentage_over_lowest_price {
    xmlv.elem(w, "SpotMaxPricePercentageOverLowestPrice", "${x}", [])
  }
  if let Some(x) = v.max_spot_price_as_percentage_of_optimal_on_demand_price {
    xmlv.elem(w, "MaxSpotPriceAsPercentageOfOptimalOnDemandPrice", "${x}", [])
  }
  if let Some(x) = v.on_demand_max_price_percentage_over_lowest_price {
    xmlv.elem(w, "OnDemandMaxPricePercentageOverLowestPrice", "${x}", [])
  }
  if let Some(x) = v.bare_metal {
    xmlv.elem(w, "BareMetal", x.value(), [])
  }
  if let Some(x) = v.burstable_performance {
    xmlv.elem(w, "BurstablePerformance", x.value(), [])
  }
  if let Some(x) = v.require_hibernate_support {
    xmlv.elem(w, "RequireHibernateSupport", "${x}", [])
  }
  if let Some(x) = v.network_interface_count {
    xml_write_network_interface_count_request(w, x, "NetworkInterfaceCount", [])
  }
  if let Some(x) = v.local_storage {
    xmlv.elem(w, "LocalStorage", x.value(), [])
  }
  if let Some(x) = v.local_storage_types {
    xml_write_local_storage_types(w, x, "LocalStorageTypes", [])
  }
  if let Some(x) = v.total_local_storage_gb {
    xml_write_total_local_storage_gb_request(w, x, "TotalLocalStorageGB", [])
  }
  if let Some(x) = v.baseline_ebs_bandwidth_mbps {
    xml_write_baseline_ebs_bandwidth_mbps_request(w, x, "BaselineEbsBandwidthMbps", [])
  }
  if let Some(x) = v.accelerator_types {
    xml_write_accelerator_types(w, x, "AcceleratorTypes", [])
  }
  if let Some(x) = v.accelerator_count {
    xml_write_accelerator_count_request(w, x, "AcceleratorCount", [])
  }
  if let Some(x) = v.accelerator_manufacturers {
    xml_write_accelerator_manufacturers(w, x, "AcceleratorManufacturers", [])
  }
  if let Some(x) = v.accelerator_names {
    xml_write_accelerator_names(w, x, "AcceleratorNames", [])
  }
  if let Some(x) = v.accelerator_total_memory_mi_b {
