/// successfully generated the report. SKIPPED: The service did not generate
/// the report because the necessary conditions were not met. For more
/// information about why the service could not generate the report, view
/// the message field in TestReport or JobReport . ERRORED: An error
/// occurred while generating the report. For more information about why the
/// service could not generate the report, view the message field in
/// TestReport or JobReport .
pub enum ReportStatus: Str {
  Pending = "PENDING"
  Running = "RUNNING"
  Completed = "COMPLETED"
  Skipped = "SKIPPED"
  Errored = "ERRORED"
  Unknown(value: Str)
}

/// Represents the screen resolution of a device in height and width,
/// expressed in pixels.
pub struct Resolution {
  /// The screen resolution's width, expressed in pixels.
  pub width: Int? = None
  /// The screen resolution's height, expressed in pixels.
  pub height: Int? = None
}

/// Represents a condition for a device pool.
pub struct Rule {
  /// The rule's stringified attribute. For example, specify the value as
  /// "\"abc\"" . The supported operators for each attribute are provided in
  /// the following list. APPIUM_VERSION The Appium version for the test.
  /// Supported operators: CONTAINS ARN The Amazon Resource Name (ARN) of the
  /// device (for example, arn:aws:devicefarm:us-west-2::device:12345Example .
  /// Supported operators: EQUALS , IN , NOT_IN AVAILABILITY The current
  /// availability of the device. Valid values are AVAILABLE,
  /// HIGHLY_AVAILABLE, BUSY, or TEMPORARY_NOT_AVAILABLE. Supported operators:
  /// EQUALS FLEET_TYPE The fleet type. Valid values are PUBLIC or PRIVATE.
  /// Supported operators: EQUALS FORM_FACTOR The device form factor. Valid
  /// values are PHONE or TABLET. Supported operators: EQUALS , IN , NOT_IN
  /// INSTANCE_ARN The Amazon Resource Name (ARN) of the device instance.
  /// Supported operators: IN , NOT_IN INSTANCE_LABELS The label of the device
  /// instance. Supported operators: CONTAINS MANUFACTURER The device
  /// manufacturer (for example, Apple). Supported operators: EQUALS , IN ,
  /// NOT_IN MODEL The device model, such as Apple iPad Air 2 or Google Pixel.
  /// Supported operators: CONTAINS , EQUALS , IN , NOT_IN OS_VERSION The
  /// operating system version (for example, 10.3.2). Supported operators:
  /// EQUALS , GREATER_THAN , GREATER_THAN_OR_EQUALS , IN , LESS_THAN ,
  /// LESS_THAN_OR_EQUALS , NOT_IN PLATFORM The device platform. Valid values
  /// are ANDROID or IOS. Supported operators: EQUALS , IN , NOT_IN
  /// REMOTE_ACCESS_ENABLED Whether the device is enabled for remote access.
  /// Valid values are TRUE or FALSE. Supported operators: EQUALS
  /// REMOTE_DEBUG_ENABLED Whether the device is enabled for remote debugging.
  /// Valid values are TRUE or FALSE. Supported operators: EQUALS Because
  /// remote debugging is no longer supported , this filter is ignored.
  pub attribute: DeviceAttribute? = None
  /// Specifies how Device Farm compares the rule's attribute to the value.
  /// For the operators that are supported by each attribute, see the
  /// attribute descriptions.
  pub operator: RuleOperator? = None
  /// The rule's value.
  pub value: Str? = None
}

pub enum RuleOperator: Str {
  Equals = "EQUALS"
  LessThan = "LESS_THAN"
  LessThanOrEquals = "LESS_THAN_OR_EQUALS"
  GreaterThan = "GREATER_THAN"
  GreaterThanOrEquals = "GREATER_THAN_OR_EQUALS"
  In = "IN"
  NotIn = "NOT_IN"
  Contains = "CONTAINS"
  Unknown(value: Str)
}

/// Represents a test run on a set of devices with a given app package, test
/// parameters, and so on.
pub struct Run {
  /// The run's ARN.
  pub arn: Str? = None
  /// The run's name.
  pub name: Str? = None
  /// The run's type. Must be one of the following values: BUILTIN_FUZZ
  /// APPIUM_JAVA_JUNIT APPIUM_JAVA_TESTNG APPIUM_PYTHON APPIUM_NODE
  /// APPIUM_RUBY APPIUM_WEB_JAVA_JUNIT APPIUM_WEB_JAVA_TESTNG
  /// APPIUM_WEB_PYTHON APPIUM_WEB_NODE APPIUM_WEB_RUBY INSTRUMENTATION XCTEST
  /// XCTEST_UI
  pub type_value: TestType? = None
  /// The run's platform. Allowed values include: ANDROID IOS
  pub platform: DevicePlatform? = None
  /// When the run was created.
  pub created: Time? = None
  /// The run's status. Allowed values include: PENDING PENDING_CONCURRENCY
  /// PENDING_DEVICE PROCESSING SCHEDULING PREPARING RUNNING COMPLETED
  /// STOPPING
  pub status: ExecutionStatus? = None
  /// The run's result. Allowed values include: PENDING PASSED WARNED FAILED
  /// SKIPPED ERRORED STOPPED
  pub result: ExecutionResult? = None
  /// The run's start time.
  pub started: Time? = None
  /// The run's stop time.
  pub stopped: Time? = None
  /// The run's result counters.
  pub counters: Counters? = None
  /// A message about the run's result.
  pub message: Str? = None
  /// The total number of jobs for the run.
  pub total_jobs: Int? = None
  /// The total number of completed jobs.
  pub completed_jobs: Int? = None
  /// Specifies the billing method for a test run: metered or unmetered . If
  /// the parameter is not specified, the default value is metered . If you
  /// have unmetered device slots, you must set this to unmetered to use them.
  /// Otherwise, the run is counted toward metered device minutes.
  pub billing_method: BillingMethod? = None
  /// Represents the total (metered or unmetered) minutes used by the test
  /// run.
  pub device_minutes: DeviceMinutes? = None
  /// The network profile being used for a test run.
  pub network_profile: NetworkProfile? = None
  /// The device proxy configured for the devices in the run.
  pub device_proxy: DeviceProxy? = None
  /// Read-only URL for an object in an S3 bucket where you can get the
  /// parsing results of the test package. If the test package doesn't parse,
  /// the reason why it doesn't parse appears in the file that this URL points
  /// to.
  pub parsing_result_url: Str? = None
  /// Supporting field for the result field. Set only if result is SKIPPED .
  /// PARSING_FAILED if the result is skipped because of test package parsing
  /// failure.
  pub result_code: ExecutionResultCode? = None
  /// For fuzz tests, this is a seed to use for randomizing the UI fuzz test.
  /// Using the same seed value between tests ensures identical event
  /// sequences.
  pub seed: Int? = None
  /// An app to upload or that has been uploaded.
  pub app_upload: Str? = None
  /// For fuzz tests, this is the number of events, between 1 and 10000, that
  /// the UI fuzz test should perform.
  pub event_count: Int? = None
  /// The number of minutes the job executes before it times out.
  pub job_timeout_minutes: Int? = None
  /// The ARN of the device pool for the run.
  pub device_pool_arn: Str? = None
  /// Information about the locale that is used for the run.
  pub locale: Str? = None
  /// Information about the radio states for the run.
  pub radios: Radios? = None
  /// Information about the location that is used for the run.
  pub location: Location? = None
  /// Output CustomerArtifactPaths object for the test run.
  pub customer_artifact_paths: CustomerArtifactPaths? = None
  /// The Device Farm console URL for the recording of the run.
  pub web_url: Str? = None
  /// When set to true , for private devices, Device Farm does not sign your
  /// app again. For public devices, Device Farm always signs your apps again.
  /// For more information about how Device Farm re-signs your apps, see Do
  /// you modify my app? in the AWS Device Farm FAQs .
  pub skip_app_resign: Bool? = None
  /// The ARN of the YAML-formatted test specification for the run.
  pub test_spec_arn: Str? = None
  /// The ARN of the test package the run was scheduled with. This field is
  /// not returned for test types that do not use a test package, such as
  /// BUILTIN_FUZZ .
  pub test_package_arn: Str? = None
  /// The results of a device filter used to select the devices for a test
  /// run.
  pub device_selection_result: DeviceSelectionResult? = None
  /// The VPC security groups and subnets that are attached to a project.
  pub vpc_config: VpcConfig? = None
  /// The IAM role associated with the run.
  pub execution_role_arn: Str? = None
  /// Environment variables associated with the run.
  pub environment_variables: List[EnvironmentVariable]? = None
  /// The types of insights requested for the run.
  pub insights_types: List[InsightsType]? = None
  /// The insights for the run, including the report status and job-level
  /// metrics. This field contains data only if you specified insightsTypes
  /// when you scheduled the run.
  pub insights: RunInsights? = None
}

/// Contains insights for a run, including report status, and job-level
/// aggregated metrics such as per job execution time and median job
/// execution time.
pub struct RunInsights {
  /// The status of the insights report for the run.
  pub status: ReportStatus? = None
  /// The job-level aggregated report for the run.
  pub job_report: JobReport? = None
}

/// Represents a sample of performance data. Device Farm does not support
/// performance data samples during test executions.
pub struct Sample {
  /// The sample's ARN.
  pub arn: Str? = None
  /// The sample's type. Must be one of the following values: CPU: A CPU
  /// sample type. This is expressed as the app processing CPU time (including
  /// child processes) as reported by process, as a percentage. MEMORY: A
  /// memory usage sample type. This is expressed as the total proportional
  /// set size of an app process, in kilobytes. NATIVE_AVG_DRAWTIME NATIVE_FPS
  /// NATIVE_FRAMES NATIVE_MAX_DRAWTIME NATIVE_MIN_DRAWTIME
  /// OPENGL_AVG_DRAWTIME OPENGL_FPS OPENGL_FRAMES OPENGL_MAX_DRAWTIME
  /// OPENGL_MIN_DRAWTIME RX RX_RATE: The total number of bytes per second
  /// (TCP and UDP) that are sent, by app process. THREADS: A threads sample
  /// type. This is expressed as the total number of threads per app process.
  /// TX TX_RATE: The total number of bytes per second (TCP and UDP) that are
  /// received, by app process.
  pub type_value: SampleType? = None
  /// The presigned Amazon S3 URL that can be used with a GET request to
  /// download the sample's file.
  pub url: Str? = None
}

pub enum SampleType: Str {
  Cpu = "CPU"
  Memory = "MEMORY"
  Threads = "THREADS"
  RxRate = "RX_RATE"
  TxRate = "TX_RATE"
  Rx = "RX"
  Tx = "TX"
  NativeFrames = "NATIVE_FRAMES"
  NativeFps = "NATIVE_FPS"
  NativeMinDrawtime = "NATIVE_MIN_DRAWTIME"
  NativeAvgDrawtime = "NATIVE_AVG_DRAWTIME"
  NativeMaxDrawtime = "NATIVE_MAX_DRAWTIME"
  OpenglFrames = "OPENGL_FRAMES"
  OpenglFps = "OPENGL_FPS"
  OpenglMinDrawtime = "OPENGL_MIN_DRAWTIME"
  OpenglAvgDrawtime = "OPENGL_AVG_DRAWTIME"
  OpenglMaxDrawtime = "OPENGL_MAX_DRAWTIME"
  Unknown(value: Str)
}

/// Represents the settings for a run. Includes things like location, radio
/// states, auxiliary apps, and network profiles.
pub struct ScheduleRunConfiguration {
  /// The ARN of the extra data for the run. The extra data is a .zip file
  /// that AWS Device Farm extracts to external data for Android or the app's
  /// sandbox for iOS.
  pub extra_data_package_arn: Str? = None
  /// Reserved for internal use.
  pub network_profile_arn: Str? = None
  /// Information about the locale that is used for the run.
  pub locale: Str? = None
  /// Information about the location that is used for the run.
  pub location: Location? = None
  /// An array of ARNs for your VPC endpoint configurations.
  pub vpce_configuration_arns: List[Str]? = None
  /// The device proxy to be configured on the device for the run.
  pub device_proxy: DeviceProxy? = None
  /// Input CustomerArtifactPaths object for the scheduled run configuration.
  pub customer_artifact_paths: CustomerArtifactPaths? = None
  /// Information about the radio states for the run.
  pub radios: Radios? = None
  /// A list of upload ARNs for app packages to be installed with your app.
  pub auxiliary_apps: List[Str]? = None
  /// Specifies the billing method for a test run: metered or unmetered . If
  /// the parameter is not specified, the default value is metered . If you
  /// have purchased unmetered device slots, you must set this parameter to
  /// unmetered to make use of them. Otherwise, your run counts against your
  /// metered time.
  pub billing_method: BillingMethod? = None
  /// Environment variables associated with the run.
  pub environment_variables: List[EnvironmentVariable]? = None
  /// An IAM role to be assumed by the test host for the run.
  pub execution_role_arn: Str? = None
  /// The types of insights to generate for a run. If you do not specify a
  /// value, the default is TEST_REPORT for runs that support insights.
  /// Specify NONE if you do not want the service to generate insights for the
  /// run. You cannot combine NONE with any other value. Insights are
  /// supported for custom mode runs of all test types except Appium Ruby and
  /// Appium Web Ruby.
  pub insights_types: List[InsightsType]? = None
}

/// Represents a request to the schedule run operation.
pub struct ScheduleRunRequest {
  /// The ARN of the project for the run to be scheduled.
  pub project_arn: Str? = None
  /// The ARN of an application package to run tests against, created with
  /// CreateUpload . See ListUploads .
  pub app_arn: Str? = None
  /// The ARN of the device pool for the run to be scheduled.
  pub device_pool_arn: Str? = None
  /// The filter criteria used to dynamically select a set of devices for a
  /// test run and the maximum number of devices to be included in the run.
  /// Either devicePoolArn or deviceSelectionConfiguration is required in a
  /// request.
  pub device_selection_configuration: DeviceSelectionConfiguration? = None
  /// The name for the run to be scheduled.
  pub name: Str? = None
  /// Information about the test for the run to be scheduled.
  pub test_value: ScheduleRunTest? = None
  /// Information about the settings for the run to be scheduled.
  pub configuration: ScheduleRunConfiguration? = None
  /// Specifies configuration information about a test run, such as the
  /// execution timeout (in minutes).
  pub execution_configuration: ExecutionConfiguration? = None
}

/// Represents the result of a schedule run request.
pub struct ScheduleRunResult {
  /// Information about the scheduled run.
  pub run: Run? = None
}

/// Represents test settings. This data structure is passed in as the test
/// parameter to ScheduleRun. For an example of the JSON request syntax, see
/// ScheduleRun .
pub struct ScheduleRunTest {
  /// The test's type. Must be one of the following values: BUILTIN_FUZZ
  /// APPIUM_JAVA_JUNIT APPIUM_JAVA_TESTNG APPIUM_PYTHON APPIUM_NODE
  /// APPIUM_RUBY APPIUM_WEB_JAVA_JUNIT APPIUM_WEB_JAVA_TESTNG
  /// APPIUM_WEB_PYTHON APPIUM_WEB_NODE APPIUM_WEB_RUBY INSTRUMENTATION XCTEST
  /// XCTEST_UI
  pub type_value: TestType? = None
  /// The ARN of the uploaded test to be run.
  pub test_package_arn: Str? = None
  /// The ARN of the YAML-formatted test specification.
  pub test_spec_arn: Str? = None
  /// The test's filter.
  pub filter: Str? = None
  /// The test's parameters, such as test framework parameters and fixture
  /// settings. Parameters are represented by name-value pairs of strings. For
  /// fuzz tests (Android only): event_count: The number of events, between 1
  /// and 10000, that the UI fuzz test should perform. throttle: The time, in
  /// ms, between 0 and 1000, that the UI fuzz test should wait between
  /// events. seed: A seed to use for randomizing the UI fuzz test. Using the
  /// same seed value between tests ensures identical event sequences. For
  /// Instrumentation: filter: A test filter string. Examples: Running a
  /// single test case: com.android.abc.Test1 Running a single test:
  /// com.android.abc.Test1#smoke Running multiple tests:
  /// com.android.abc.Test1,com.android.abc.Test2 For XCTest and XCTestUI:
  /// filter: A test filter string. Examples: Running a single test class:
  /// LoginTests Running a multiple test classes: LoginTests,SmokeTests
  /// Running a single test: LoginTests/testValid Running multiple tests:
  /// LoginTests/testValid,LoginTests/testInvalid
  pub parameters: Map[Str, Str]? = None
}

