pub fn (e: UpdateIntegrationErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_integration_error(resp: http.Response) -> UpdateIntegrationErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return UpdateIntegrationErr.AccessDeniedException(x)
      Err(msg) => return UpdateIntegrationErr.Deserialize(msg)
    }
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UpdateIntegrationErr.ConflictException(x)
      Err(msg) => return UpdateIntegrationErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return UpdateIntegrationErr.InternalServerException(x)
      Err(msg) => return UpdateIntegrationErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateIntegrationErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateIntegrationErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateIntegrationErr.ThrottlingException(x)
      Err(msg) => return UpdateIntegrationErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateIntegrationErr.ValidationException(x)
      Err(msg) => return UpdateIntegrationErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateIntegrationErr.Api(restjson.api_error(resp, body))
}

/// Rotates the credentials used by an Amazon S3 integration. Only S3
/// integrations can be updated; GitHub integrations cannot be modified. The
/// integration's name, provider type, and bucket remain fixed. The caller
/// must have iam:PassRole permission for the supplied role, including when
/// only the external ID changes. Continuum verifies that the role can be
/// assumed with the requested external ID and can access the existing
/// bucket before saving both credentials atomically. Omitting externalId
/// preserves its current value. Repeating both current credentials leaves
/// updatedAt unchanged, but still requires authorization and access
/// validation.
pub fn (c: Client) update_integration(input: UpdateIntegrationInput) -> UpdateIntegrationOutput ! UpdateIntegrationErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_integration(c.params, input)) ?? e => return Err(UpdateIntegrationErr.InvalidInput(e))
  var req = serialize_update_integration(ep, input, "") ?? e => return Err(UpdateIntegrationErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateIntegrationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_integration_error(resp))
  }
  deserialize_update_integration(resp) ?? e => Err(UpdateIntegrationErr.Deserialize(e))
}
