fn xml_write_health_check_config(var w: xmlv.Writer, v: HealthCheckConfig, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.ip_address {
    xmlv.elem(w, "IPAddress", x, [])
  }
  if let Some(x) = v.port {
    xmlv.elem(w, "Port", "${x}", [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "Type", x.value(), [])
  }
  if let Some(x) = v.resource_path {
    xmlv.elem(w, "ResourcePath", x, [])
  }
  if let Some(x) = v.fully_qualified_domain_name {
    xmlv.elem(w, "FullyQualifiedDomainName", x, [])
  }
  if let Some(x) = v.search_string {
    xmlv.elem(w, "SearchString", x, [])
  }
  if let Some(x) = v.request_interval {
    xmlv.elem(w, "RequestInterval", "${x}", [])
  }
  if let Some(x) = v.failure_threshold {
    xmlv.elem(w, "FailureThreshold", "${x}", [])
  }
  if let Some(x) = v.measure_latency {
    xmlv.elem(w, "MeasureLatency", "${x}", [])
  }
  if let Some(x) = v.inverted {
    xmlv.elem(w, "Inverted", "${x}", [])
  }
  if let Some(x) = v.disabled {
    xmlv.elem(w, "Disabled", "${x}", [])
  }
  if let Some(x) = v.health_threshold {
    xmlv.elem(w, "HealthThreshold", "${x}", [])
  }
  if let Some(x) = v.child_health_checks {
    xml_write_child_health_check_list(w, x, "ChildHealthChecks", [])
  }
  if let Some(x) = v.enable_sni {
    xmlv.elem(w, "EnableSNI", "${x}", [])
  }
  if let Some(x) = v.regions {
    xml_write_health_check_region_list(w, x, "Regions", [])
  }
  if let Some(x) = v.alarm_identifier {
    xml_write_alarm_identifier(w, x, "AlarmIdentifier", [])
  }
  if let Some(x) = v.insufficient_data_health_status {
    xmlv.elem(w, "InsufficientDataHealthStatus", x.value(), [])
  }
  if let Some(x) = v.routing_control_arn {
    xmlv.elem(w, "RoutingControlArn", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_health_check_config(e: xml.Element) -> HealthCheckConfig ! Str {
  var out = HealthCheckConfig{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "IPAddress" => out.ip_address = c.text()
      "Port" => out.port = xmlv.read_int(c.text())?
      "Type" => out.type_value = HealthCheckType.from(c.text())
      "ResourcePath" => out.resource_path = c.text()
      "FullyQualifiedDomainName" => out.fully_qualified_domain_name = c.text()
      "SearchString" => out.search_string = c.text()
      "RequestInterval" => out.request_interval = xmlv.read_int(c.text())?
      "FailureThreshold" => out.failure_threshold = xmlv.read_int(c.text())?
      "MeasureLatency" => out.measure_latency = xmlv.read_bool(c.text())?
      "Inverted" => out.inverted = xmlv.read_bool(c.text())?
      "Disabled" => out.disabled = xmlv.read_bool(c.text())?
      "HealthThreshold" => out.health_threshold = xmlv.read_int(c.text())?
      "ChildHealthChecks" => out.child_health_checks = xml_read_child_health_check_list(c)?
      "EnableSNI" => out.enable_sni = xmlv.read_bool(c.text())?
      "Regions" => out.regions = xml_read_health_check_region_list(c)?
      "AlarmIdentifier" => out.alarm_identifier = xml_read_alarm_identifier(c)?
      "InsufficientDataHealthStatus" => out.insufficient_data_health_status = InsufficientDataHealthStatus.from(c.text())
      "RoutingControlArn" => out.routing_control_arn = c.text()
      _ => {}
    }
  }
  Ok(out)
}

