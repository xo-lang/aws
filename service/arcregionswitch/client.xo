    RdsSwitchoverReadReplicaConfig(x) => json.Value.Object([("rdsSwitchoverReadReplicaConfig", json_of_rds_switchover_read_replica_configuration(x))])
    SsmSendCommandConfig(x) => json.Value.Object([("ssmSendCommandConfig", json_of_ssm_send_command_configuration(x))])
