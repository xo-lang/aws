fn json_of_image_source(v: ImageSource) -> json.Value {
  match v {
    Bytes(x) => json.Value.Object([("bytes", jsonv.blob(x))])
    S3Location(x) => json.Value.Object([("s3Location", json_of_s3_location(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_image_source(v: json.Value) -> ImageSource ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "bytes" => Ok(ImageSource.Bytes(jsonv.read_blob(fv)?))
      "s3Location" => Ok(ImageSource.S3Location(from_json_s3_location(fv)?))
      _ => Ok(ImageSource.Unknown(k))
    }
  }
  Err("ImageSource: no member set")
}

