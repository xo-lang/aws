fn from_json_s3_settings(v: json.Value) -> S3Settings ! Str {
  var out = S3Settings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ServiceAccessRoleArn" => out.service_access_role_arn = jsonv.read_str(fv)?
      "ExternalTableDefinition" => out.external_table_definition = jsonv.read_str(fv)?
      "CsvRowDelimiter" => out.csv_row_delimiter = jsonv.read_str(fv)?
      "CsvDelimiter" => out.csv_delimiter = jsonv.read_str(fv)?
      "BucketFolder" => out.bucket_folder = jsonv.read_str(fv)?
      "BucketName" => out.bucket_name = jsonv.read_str(fv)?
      "CompressionType" => out.compression_type = CompressionTypeValue.from(jsonv.read_str(fv)?)
      "EncryptionMode" => out.encryption_mode = EncryptionModeValue.from(jsonv.read_str(fv)?)
      "ServerSideEncryptionKmsKeyId" => out.server_side_encryption_kms_key_id = jsonv.read_str(fv)?
      "DataFormat" => out.data_format = DataFormatValue.from(jsonv.read_str(fv)?)
      "EncodingType" => out.encoding_type = EncodingTypeValue.from(jsonv.read_str(fv)?)
      "DictPageSizeLimit" => out.dict_page_size_limit = jsonv.read_int(fv)?
      "RowGroupLength" => out.row_group_length = jsonv.read_int(fv)?
      "DataPageSize" => out.data_page_size = jsonv.read_int(fv)?
      "ParquetVersion" => out.parquet_version = ParquetVersionValue.from(jsonv.read_str(fv)?)
      "EnableStatistics" => out.enable_statistics = jsonv.read_bool(fv)?
      "IncludeOpForFullLoad" => out.include_op_for_full_load = jsonv.read_bool(fv)?
      "CdcInsertsOnly" => out.cdc_inserts_only = jsonv.read_bool(fv)?
      "TimestampColumnName" => out.timestamp_column_name = jsonv.read_str(fv)?
      "ParquetTimestampInMillisecond" => out.parquet_timestamp_in_millisecond = jsonv.read_bool(fv)?
      "CdcInsertsAndUpdates" => out.cdc_inserts_and_updates = jsonv.read_bool(fv)?
      "DatePartitionEnabled" => out.date_partition_enabled = jsonv.read_bool(fv)?
      "DatePartitionSequence" => out.date_partition_sequence = DatePartitionSequenceValue.from(jsonv.read_str(fv)?)
      "DatePartitionDelimiter" => out.date_partition_delimiter = DatePartitionDelimiterValue.from(jsonv.read_str(fv)?)
      "UseCsvNoSupValue" => out.use_csv_no_sup_value = jsonv.read_bool(fv)?
      "CsvNoSupValue" => out.csv_no_sup_value = jsonv.read_str(fv)?
      "PreserveTransactions" => out.preserve_transactions = jsonv.read_bool(fv)?
      "CdcPath" => out.cdc_path = jsonv.read_str(fv)?
      "UseTaskStartTimeForFullLoadTimestamp" => out.use_task_start_time_for_full_load_timestamp = jsonv.read_bool(fv)?
      "CannedAclForObjects" => out.canned_acl_for_objects = CannedAclForObjectsValue.from(jsonv.read_str(fv)?)
      "AddColumnName" => out.add_column_name = jsonv.read_bool(fv)?
      "CdcMaxBatchInterval" => out.cdc_max_batch_interval = jsonv.read_int(fv)?
      "CdcMinFileSize" => out.cdc_min_file_size = jsonv.read_int(fv)?
      "CsvNullValue" => out.csv_null_value = jsonv.read_str(fv)?
      "IgnoreHeaderRows" => out.ignore_header_rows = jsonv.read_int(fv)?
      "MaxFileSize" => out.max_file_size = jsonv.read_int(fv)?
      "Rfc4180" => out.rfc4180 = jsonv.read_bool(fv)?
      "DatePartitionTimezone" => out.date_partition_timezone = jsonv.read_str(fv)?
      "AddTrailingPaddingCharacter" => out.add_trailing_padding_character = jsonv.read_bool(fv)?
      "ExpectedBucketOwner" => out.expected_bucket_owner = jsonv.read_str(fv)?
      "GlueCatalogGeneration" => out.glue_catalog_generation = jsonv.read_bool(fv)?
