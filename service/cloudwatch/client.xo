fn xml_write_entity(var w: xmlv.Writer, v: Entity, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.key_attributes {
    xml_write_entity_key_attributes_map(w, x, "KeyAttributes", [])
  }
  if let Some(x) = v.attributes {
    xml_write_entity_attributes_map(w, x, "Attributes", [])
  }
  xmlv.end(w, name)
}

fn xml_read_entity(e: xml.Element) -> Entity ! Str {
  var out = Entity{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "KeyAttributes" => out.key_attributes = xml_read_entity_key_attributes_map(c)?
      "Attributes" => out.attributes = xml_read_entity_attributes_map(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_entity_attributes_map(var w: xmlv.Writer, v: Map[Str, Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", item, [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_entity_attributes_map(e: xml.Element) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, vc.text())
    }
  }
  Ok(out)
}

fn xml_write_entity_key_attributes_map(var w: xmlv.Writer, v: Map[Str, Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", item, [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_entity_key_attributes_map(e: xml.Element) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, vc.text())
    }
  }
  Ok(out)
}

fn xml_write_entity_metric_data(var w: xmlv.Writer, v: EntityMetricData, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.entity {
    xml_write_entity(w, x, "Entity", [])
  }
  if let Some(x) = v.metric_data {
    xml_write_metric_data(w, x, "MetricData", [])
  }
  xmlv.end(w, name)
}

fn xml_read_entity_metric_data(e: xml.Element) -> EntityMetricData ! Str {
  var out = EntityMetricData{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Entity" => out.entity = xml_read_entity(c)?
      "MetricData" => out.metric_data = xml_read_metric_data(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_entity_metric_data_list(var w: xmlv.Writer, v: List[EntityMetricData], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_entity_metric_data(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_entity_metric_data_list(e: xml.Element) -> List[EntityMetricData] ! Str {
  var out: List[EntityMetricData] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_entity_metric_data(c)?)
  }
  Ok(out)
}

fn xml_write_evaluation_criteria(var w: xmlv.Writer, v: EvaluationCriteria, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    PromQlCriteria(x) => {
      xml_write_alarm_prom_ql_criteria(w, x, "PromQLCriteria", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_evaluation_criteria(e: xml.Element) -> EvaluationCriteria ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "PromQLCriteria" => Ok(EvaluationCriteria.PromQlCriteria(xml_read_alarm_prom_ql_criteria(c)?))
      _ => Ok(EvaluationCriteria.Unknown(c.name.local))
    }
  }
  Err("EvaluationCriteria: no member set")
}

fn xml_write_evaluation_window(var w: xmlv.Writer, v: EvaluationWindow, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    WallClockWindow(x) => {
      xml_write_wall_clock_window(w, x, "WallClockWindow", [])
    }
    SlidingWindow(x) => {
      xml_write_sliding_window(w, x, "SlidingWindow", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_evaluation_window(e: xml.Element) -> EvaluationWindow ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "WallClockWindow" => Ok(EvaluationWindow.WallClockWindow(xml_read_wall_clock_window(c)?))
      "SlidingWindow" => Ok(EvaluationWindow.SlidingWindow(xml_read_sliding_window(c)?))
      _ => Ok(EvaluationWindow.Unknown(c.name.local))
    }
  }
  Err("EvaluationWindow: no member set")
}

