      "transitGatewayRouteTableId" => out.transit_gateway_route_table_id = c.text()
      "transitGatewayId" => out.transit_gateway_id = c.text()
      "state" => out.state = TransitGatewayRouteTableState.from(c.text())
      "defaultAssociationRouteTable" => out.default_association_route_table = xmlv.read_bool(c.text())?
      "defaultPropagationRouteTable" => out.default_propagation_route_table = xmlv.read_bool(c.text())?
      "creationTime" => out.creation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

