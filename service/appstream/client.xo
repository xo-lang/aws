      "AccessEndpoints" => out.access_endpoints = from_json_access_endpoint_list(fv)?
      "EmbedHostDomains" => out.embed_host_domains = from_json_embed_host_domains(fv)?
      "StreamingExperienceSettings" => out.streaming_experience_settings = from_json_streaming_experience_settings(fv)?
      "ContentRedirection" => out.content_redirection = from_json_content_redirection(fv)?
      "AgentAccessConfig" => out.agent_access_config = from_json_agent_access_config(fv)?
      "StorageConnectorAuthentication" => out.storage_connector_authentication = StorageConnectorAuthentication.from(jsonv.read_str(fv)?)
      _ => {}
