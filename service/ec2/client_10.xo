  if let Some(x) = v.vpc {
    query_put_analysis_component(f, query.key(prefix, "Vpc"), x)
  }
  if let Some(x) = v.additional_details {
    query_put_additional_detail_list(f, query.key(prefix, "AdditionalDetailSet"), x, false)
  }
  if let Some(x) = v.transit_gateway {
    query_put_analysis_component(f, query.key(prefix, "TransitGateway"), x)
