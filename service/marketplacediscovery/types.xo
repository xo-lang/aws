/// The input fails to satisfy the constraints specified by the service.
/// Check the reason field for the constraint that failed.
pub struct ValidationException {
  pub message: Str? = None
  /// The reason that the input fails to satisfy the constraints that the
  /// Discovery API specifies. This field has one of the following values:
  /// INVALID_PAGINATION_TOKEN The nextToken value is malformed, expired, or
  /// belongs to a different request. Start the pagination again from the
  /// first page. MALFORMED_REQUEST_PARAMETERS One or more request parameters
  /// have an invalid value. Correct the parameters that you specified, and
  /// then resubmit your request. PAGINATION_LIMIT_EXCEEDED The request asks
  /// for results beyond the deepest page that the operation returns. Narrow
  /// your request with filters or a more specific search.
  pub reason: ValidationExceptionReason? = None
}

pub enum ValidationExceptionReason: Str {
  InvalidPaginationToken = "INVALID_PAGINATION_TOKEN"
  MalformedRequestParameters = "MALFORMED_REQUEST_PARAMETERS"
  PaginationLimitExceeded = "PAGINATION_LIMIT_EXCEEDED"
  Unknown(value: Str)
}

