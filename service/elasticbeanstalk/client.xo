fn xml_write_configuration_option_description(var w: xmlv.Writer, v: ConfigurationOptionDescription, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.namespace {
    xmlv.elem(w, "Namespace", x, [])
  }
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.default_value {
    xmlv.elem(w, "DefaultValue", x, [])
  }
  if let Some(x) = v.change_severity {
    xmlv.elem(w, "ChangeSeverity", x, [])
  }
  if let Some(x) = v.user_defined {
    xmlv.elem(w, "UserDefined", "${x}", [])
  }
  if let Some(x) = v.value_type {
    xmlv.elem(w, "ValueType", x.value(), [])
  }
  if let Some(x) = v.value_options {
    xml_write_configuration_option_possible_values(w, x, "ValueOptions", [])
  }
  if let Some(x) = v.min_value {
    xmlv.elem(w, "MinValue", "${x}", [])
  }
  if let Some(x) = v.max_value {
    xmlv.elem(w, "MaxValue", "${x}", [])
  }
  if let Some(x) = v.max_length {
    xmlv.elem(w, "MaxLength", "${x}", [])
  }
  if let Some(x) = v.regex {
    xml_write_option_restriction_regex(w, x, "Regex", [])
  }
  xmlv.end(w, name)
}

fn xml_read_configuration_option_description(e: xml.Element) -> ConfigurationOptionDescription ! Str {
  var out = ConfigurationOptionDescription{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Namespace" => out.namespace = c.text()
      "Name" => out.name = c.text()
      "DefaultValue" => out.default_value = c.text()
      "ChangeSeverity" => out.change_severity = c.text()
      "UserDefined" => out.user_defined = xmlv.read_bool(c.text())?
      "ValueType" => out.value_type = ConfigurationOptionValueType.from(c.text())
      "ValueOptions" => out.value_options = xml_read_configuration_option_possible_values(c)?
      "MinValue" => out.min_value = xmlv.read_int(c.text())?
      "MaxValue" => out.max_value = xmlv.read_int(c.text())?
      "MaxLength" => out.max_length = xmlv.read_int(c.text())?
      "Regex" => out.regex = xml_read_option_restriction_regex(c)?
      _ => {}
    }
  }
  Ok(out)
}

