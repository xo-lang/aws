fn json_of_autonomous_database_list(v: List[AutonomousDatabaseSummary]) -> json.Value {
  json.Value.List(v.map(fn(x: AutonomousDatabaseSummary) -> json.Value { json_of_autonomous_database_summary(x) }))
}

fn from_json_autonomous_database_list(v: json.Value) -> List[AutonomousDatabaseSummary] ! Str {
  var out: List[AutonomousDatabaseSummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_autonomous_database_summary(fv)?)
  }
  Ok(out)
}

