/// A custom SNS message attribute (data type plus string or binary value).
pub struct SnsMessageAttributeValue {
  /// Attribute data type. Requiredness and the accepted vocabulary belong to
  /// SNS, which rejects an attribute without a data type on delivery.
  pub data_type: Str? = None
  /// String attribute value. A JSONata expression resolves once per delivered
  /// event.
  pub string_value: Str? = None
  /// Base64-encoded literal binary attribute value.
  pub binary_value: Str? = None
}

/// SNS invocation parameters for subscribers. Values are forwarded to the
/// SNS PublishBatch API. All scalar values accept a literal or a JSONata
/// expression (e.g. "{% $events.Data.groupId %}").
pub struct SnsParameters {
  /// Message group ID for FIFO topics. Accepts JSONata expression.
  pub message_group_id: Str? = None
  /// Message deduplication ID for FIFO topics. Accepts JSONata expression.
  pub message_deduplication_id: Str? = None
  /// Subject line for email protocol subscriptions. Accepts JSONata
  /// expression.
  pub subject: Str? = None
  /// Per-protocol message formatting mode, forwarded to SNS Publish
  /// unchanged. Accepts JSONata expression.
  pub message_structure: Str? = None
  /// Custom message attributes for SNS filtering.
  pub message_attributes: Map[Str, SnsMessageAttributeValue]? = None
}

/// A custom SQS message attribute (data type plus string or binary value).
pub struct SqsMessageAttributeValue {
  /// Attribute data type. Requiredness, the accepted vocabulary, and any
  /// custom label belong to SQS, which rejects an attribute without a data
  /// type on delivery.
  pub data_type: Str? = None
  /// String attribute value. A JSONata expression resolves once per delivered
  /// event.
  pub string_value: Str? = None
  /// Base64-encoded literal binary attribute value.
  pub binary_value: Str? = None
}

/// SQS invocation parameters for subscribers. Values are forwarded to the
/// SQS SendMessageBatch API. All scalar values accept a literal or a
/// JSONata expression (e.g. "{% $events.Data.groupId %}").
pub struct SqsParameters {
  /// Message group ID for FIFO queues. Accepts JSONata expression.
  pub message_group_id: Str? = None
  /// Message deduplication ID for FIFO queues. Accepts JSONata expression.
  pub message_deduplication_id: Str? = None
  /// Delay in seconds before the message becomes visible, standard queues
  /// only. Accepts JSONata expression.
  pub delay_seconds: Str? = None
  /// Custom message attributes (name/type/value).
  pub message_attributes: Map[Str, SqsMessageAttributeValue]? = None
  /// System message attributes (e.g., AWSTraceHeader).
  pub message_system_attributes: Map[Str, SqsMessageAttributeValue]? = None
}

/// Starting position for a subscriber.
pub enum StartingPosition: Str {
  Latest = "LATEST"
  PointInTime = "POINT_IN_TIME"
  Unknown(value: Str)
}

/// Step Functions invocation parameters for subscribers. Values are
/// forwarded to the Step Functions StartExecution or StartSyncExecution
/// API. Every string member accepts a literal or a JSONata expression (e.g.
/// "{% $events.Data.executionName %}").
pub struct StepFunctionsParameters {
  /// Selects StartExecution (EVENT) or StartSyncExecution (REQUEST_RESPONSE)
  /// at delivery.
  pub invocation_type: InvocationType? = None
  /// Name for the execution. Must be unique per account/region/state machine.
  /// Accepts JSONata expression.
  pub name: Str? = None
  /// X-Ray trace header for distributed tracing. Accepts JSONata expression.
  pub trace_header: Str? = None
  /// Timeout in seconds for each invocation of the target (1-30).
  /// String-typed (not integer) so the value may be a JSONata expression.
  pub invocation_timeout_seconds: Str? = None
}

/// Event storage configuration for an event bus.
pub struct StorageConfiguration {
  pub retention_period_in_days: Int? = None
}

/// Event storage configuration of an event bus, as returned on reads.
pub struct StorageConfigurationOutput {
  pub retention_period_in_days: Int? = None
  /// The earliest point in time from which stored events are available.
  /// Events older than this have expired from retention.
  pub retention_window_start_time: Time? = None
}

/// Customer-controlled run state of a subscriber, set on create or update.
/// Distinct from the bus lifecycle vocabulary, where ACTIVE means
/// "provisioned and healthy". Delivery requires State RUNNING on a
/// subscriber that is not revoked.
pub enum SubscriberState: Str {
  Running = "RUNNING"
  Stopped = "STOPPED"
  Unknown(value: Str)
}

/// Summary of a subscriber, as returned by ListSubscribers.
pub struct SubscriberSummary {
  pub subscriber_arn: Str? = None
  pub name: Str? = None
  pub event_bus_arn: Str? = None
  pub target_arn: Str? = None
  pub type_value: OrderingType? = None
  /// True when the bus owner has revoked this subscriber. Present only when
  /// true, so a bus owner listing subscribers sees at a glance which ones
  /// they revoked. See DescribeSubscriberResponse$Revoked.
  pub revoked: Bool? = None
  pub state: SubscriberState? = None
  /// The time the subscriber was created.
  pub creation_time: Time? = None
  /// The time the subscriber was last modified.
  pub last_modified_time: Time? = None
  pub subscriber_account_id: Str? = None
}

/// Indicates the outcome for a successfully processed publish entry.
pub enum SuccessCode: Str {
  Published = "PUBLISHED"
  Deduplicated = "DEDUPLICATED"
  Unknown(value: Str)
}

