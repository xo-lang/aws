  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Key" => out.key = jsonv.read_str(fv)?
      "Value" => out.value = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

