pub struct OptimizeWaypointsRequest {
  /// Features that are avoided. Avoidance is on a best-case basis. If an
  /// avoidance can't be satisfied for a particular case, this setting is
  /// ignored.
  pub avoid: WaypointOptimizationAvoidanceOptions? = None
  /// Clustering allows you to specify how nearby waypoints can be clustered
  /// to improve the optimized sequence.
  pub clustering: WaypointOptimizationClusteringOptions? = None
  /// Departure time from the waypoint. Time format: YYYY-MM-DDThh:mm:ss.sssZ
  /// | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples: 2020-04-22T17:57:24Z
  /// 2020-04-22T17:57:24+02:00
  pub departure_time: Str? = None
  /// The final position for the route in the World Geodetic System (WGS 84)
  /// format: [longitude, latitude] .
  pub destination: List[Float]? = None
  /// Destination related options.
  pub destination_options: WaypointOptimizationDestinationOptions? = None
  /// Driver related options.
  pub driver: WaypointOptimizationDriverOptions? = None
  /// Features to be strictly excluded while calculating the route.
  pub exclude: WaypointOptimizationExclusionOptions? = None
  /// Optional: The API key to be used for authorization. Either an API key or
  /// valid SigV4 signature must be provided when making a request.
  pub key: Str? = None
  /// Specifies the optimization criteria for the calculated sequence. Default
  /// value: FastestRoute .
  pub optimize_sequencing_for: WaypointOptimizationSequencingObjective? = None
  /// The start position for the route in World Geodetic System (WGS 84)
  /// format: [longitude, latitude].
  pub origin: List[Float]? = None
  /// Origin related options.
  pub origin_options: WaypointOptimizationOriginOptions? = None
  /// Traffic-related options.
  pub traffic: WaypointOptimizationTrafficOptions? = None
  /// Specifies the mode of transport when calculating a route. Used in
  /// estimating the speed of travel and road compatibility. Default value:
  /// Car
  pub travel_mode: WaypointOptimizationTravelMode? = None
  /// Travel mode related options for the provided travel mode.
  pub travel_mode_options: WaypointOptimizationTravelModeOptions? = None
  /// List of waypoints between the Origin and Destination , in World Geodetic
  /// System (WGS 84) format: [longitude, latitude]. The maximum number of
  /// waypoints allowed per request: Maximum 50 waypoints per request Maximum
  /// 20 waypoints when using constraints ( AccessHours , AppointmentTime ,
  /// ServiceDuration , Heading , SideOfStreet , Before )
  pub waypoints: List[WaypointOptimizationWaypoint]? = None
}

pub struct OptimizeWaypointsResponse {
  /// Details about the connection from one waypoint to the next, within the
  /// optimized sequence.
  pub connections: List[WaypointOptimizationConnection]? = None
  /// Overall distance to travel the whole sequence.
  pub distance: Int? = None
  /// Overall duration to travel the whole sequence. Unit : seconds
  pub duration: Int? = None
  /// Returns waypoints that caused the optimization problem to fail, and the
  /// constraints that were unsatisfied leading to the failure.
  pub impeding_waypoints: List[WaypointOptimizationImpedingWaypoint]? = None
  /// Waypoints in the order of the optimized sequence.
  pub optimized_waypoints: List[WaypointOptimizationOptimizedWaypoint]? = None
  /// The pricing bucket for which the query is charged at.
  pub pricing_bucket: Str? = None
  /// Time breakdown for the sequence.
  pub time_breakdown: WaypointOptimizationTimeBreakdown? = None
}

