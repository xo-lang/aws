fn json_of_connection(v: Connection) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.owner_account {
    fs.push(("ownerAccount", json.Value.Str(x)))
  }
  if let Some(x) = v.connection_id {
    fs.push(("connectionId", json.Value.Str(x)))
  }
  if let Some(x) = v.connection_name {
    fs.push(("connectionName", json.Value.Str(x)))
  }
  if let Some(x) = v.connection_state {
    fs.push(("connectionState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.region {
    fs.push(("region", json.Value.Str(x)))
  }
  if let Some(x) = v.location {
    fs.push(("location", json.Value.Str(x)))
  }
  if let Some(x) = v.bandwidth {
    fs.push(("bandwidth", json.Value.Str(x)))
  }
  if let Some(x) = v.vlan {
    fs.push(("vlan", json.Value.Int(x)))
  }
  if let Some(x) = v.partner_name {
    fs.push(("partnerName", json.Value.Str(x)))
  }
  if let Some(x) = v.loa_issue_time {
    fs.push(("loaIssueTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.lag_id {
    fs.push(("lagId", json.Value.Str(x)))
  }
  if let Some(x) = v.aws_device {
    fs.push(("awsDevice", json.Value.Str(x)))
  }
  if let Some(x) = v.jumbo_frame_capable {
    fs.push(("jumboFrameCapable", json.Value.Bool(x)))
  }
  if let Some(x) = v.aws_device_v2 {
    fs.push(("awsDeviceV2", json.Value.Str(x)))
  }
  if let Some(x) = v.aws_logical_device_id {
    fs.push(("awsLogicalDeviceId", json.Value.Str(x)))
  }
  if let Some(x) = v.has_logical_redundancy {
    fs.push(("hasLogicalRedundancy", json.Value.Str(x.value())))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tag_list(x)))
  }
  if let Some(x) = v.provider_name {
    fs.push(("providerName", json.Value.Str(x)))
  }
  if let Some(x) = v.mac_sec_capable {
    fs.push(("macSecCapable", json.Value.Bool(x)))
  }
  if let Some(x) = v.port_encryption_status {
    fs.push(("portEncryptionStatus", json.Value.Str(x)))
  }
  if let Some(x) = v.encryption_mode {
    fs.push(("encryptionMode", json.Value.Str(x)))
  }
  if let Some(x) = v.mac_sec_keys {
    fs.push(("macSecKeys", json_of_mac_sec_key_list(x)))
  }
  if let Some(x) = v.rate_limiter_status {
    fs.push(("rateLimiterStatus", json_of_rate_limiter_status(x)))
  }
  if let Some(x) = v.partner_interconnect_mac_sec_capable {
    fs.push(("partnerInterconnectMacSecCapable", json.Value.Bool(x)))
  }
  if let Some(x) = v.prefix_pool_size_ipv4 {
    fs.push(("prefixPoolSizeIpv4", json.Value.Int(x)))
  }
  if let Some(x) = v.prefix_pool_size_ipv6 {
    fs.push(("prefixPoolSizeIpv6", json.Value.Int(x)))
  }
  if let Some(x) = v.prefix_pool_unallocated_count_ipv4 {
    fs.push(("prefixPoolUnallocatedCountIpv4", json.Value.Int(x)))
  }
  if let Some(x) = v.prefix_pool_unallocated_count_ipv6 {
    fs.push(("prefixPoolUnallocatedCountIpv6", json.Value.Int(x)))
  }
  if let Some(x) = v.billing_mode {
    fs.push(("billingMode", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_connection(v: json.Value) -> Connection ! Str {
  var out = Connection{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ownerAccount" => out.owner_account = jsonv.read_str(fv)?
      "connectionId" => out.connection_id = jsonv.read_str(fv)?
      "connectionName" => out.connection_name = jsonv.read_str(fv)?
      "connectionState" => out.connection_state = ConnectionState.from(jsonv.read_str(fv)?)
      "region" => out.region = jsonv.read_str(fv)?
      "location" => out.location = jsonv.read_str(fv)?
      "bandwidth" => out.bandwidth = jsonv.read_str(fv)?
      "vlan" => out.vlan = jsonv.read_int(fv)?
      "partnerName" => out.partner_name = jsonv.read_str(fv)?
      "loaIssueTime" => out.loa_issue_time = jsonv.read_time(fv, "epoch-seconds")?
      "lagId" => out.lag_id = jsonv.read_str(fv)?
      "awsDevice" => out.aws_device = jsonv.read_str(fv)?
      "jumboFrameCapable" => out.jumbo_frame_capable = jsonv.read_bool(fv)?
      "awsDeviceV2" => out.aws_device_v2 = jsonv.read_str(fv)?
      "awsLogicalDeviceId" => out.aws_logical_device_id = jsonv.read_str(fv)?
      "hasLogicalRedundancy" => out.has_logical_redundancy = HasLogicalRedundancy.from(jsonv.read_str(fv)?)
      "tags" => out.tags = from_json_tag_list(fv)?
      "providerName" => out.provider_name = jsonv.read_str(fv)?
      "macSecCapable" => out.mac_sec_capable = jsonv.read_bool(fv)?
      "portEncryptionStatus" => out.port_encryption_status = jsonv.read_str(fv)?
      "encryptionMode" => out.encryption_mode = jsonv.read_str(fv)?
      "macSecKeys" => out.mac_sec_keys = from_json_mac_sec_key_list(fv)?
      "rateLimiterStatus" => out.rate_limiter_status = from_json_rate_limiter_status(fv)?
      "partnerInterconnectMacSecCapable" => out.partner_interconnect_mac_sec_capable = jsonv.read_bool(fv)?
      "prefixPoolSizeIpv4" => out.prefix_pool_size_ipv4 = jsonv.read_int(fv)?
      "prefixPoolSizeIpv6" => out.prefix_pool_size_ipv6 = jsonv.read_int(fv)?
      "prefixPoolUnallocatedCountIpv4" => out.prefix_pool_unallocated_count_ipv4 = jsonv.read_int(fv)?
      "prefixPoolUnallocatedCountIpv6" => out.prefix_pool_unallocated_count_ipv6 = jsonv.read_int(fv)?
      "billingMode" => out.billing_mode = BillingMode.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

