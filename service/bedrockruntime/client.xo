fn json_of_converse_request(v: ConverseRequest) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.model_id {
    fs.push(("modelId", json.Value.Str(x)))
  }
  if let Some(x) = v.messages {
    fs.push(("messages", json_of_messages(x)))
  }
  if let Some(x) = v.system {
    fs.push(("system", json_of_system_content_blocks(x)))
  }
  if let Some(x) = v.inference_config {
    fs.push(("inferenceConfig", json_of_inference_configuration(x)))
  }
  if let Some(x) = v.tool_config {
    fs.push(("toolConfig", json_of_tool_configuration(x)))
  }
  if let Some(x) = v.guardrail_config {
    fs.push(("guardrailConfig", json_of_guardrail_configuration(x)))
  }
  if let Some(x) = v.additional_model_request_fields {
    fs.push(("additionalModelRequestFields", x))
  }
  if let Some(x) = v.prompt_variables {
    fs.push(("promptVariables", json_of_prompt_variable_map(x)))
  }
  if let Some(x) = v.additional_model_response_field_paths {
    fs.push(("additionalModelResponseFieldPaths", json_of_additional_model_response_field_paths(x)))
  }
  if let Some(x) = v.request_metadata {
    fs.push(("requestMetadata", json_of_request_metadata(x)))
  }
  if let Some(x) = v.performance_config {
    fs.push(("performanceConfig", json_of_performance_configuration(x)))
  }
  if let Some(x) = v.service_tier {
    fs.push(("serviceTier", json_of_service_tier(x)))
  }
  if let Some(x) = v.output_config {
    fs.push(("outputConfig", json_of_output_config(x)))
  }
  json.Value.Object(fs)
}

fn from_json_converse_request(v: json.Value) -> ConverseRequest ! Str {
  var out = ConverseRequest{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "modelId" => out.model_id = jsonv.read_str(fv)?
      "messages" => out.messages = from_json_messages(fv)?
      "system" => out.system = from_json_system_content_blocks(fv)?
      "inferenceConfig" => out.inference_config = from_json_inference_configuration(fv)?
      "toolConfig" => out.tool_config = from_json_tool_configuration(fv)?
      "guardrailConfig" => out.guardrail_config = from_json_guardrail_configuration(fv)?
      "additionalModelRequestFields" => out.additional_model_request_fields = fv
      "promptVariables" => out.prompt_variables = from_json_prompt_variable_map(fv)?
      "additionalModelResponseFieldPaths" => out.additional_model_response_field_paths = from_json_additional_model_response_field_paths(fv)?
      "requestMetadata" => out.request_metadata = from_json_request_metadata(fv)?
      "performanceConfig" => out.performance_config = from_json_performance_configuration(fv)?
      "serviceTier" => out.service_tier = from_json_service_tier(fv)?
      "outputConfig" => out.output_config = from_json_output_config(fv)?
      _ => {}
    }
  }
  Ok(out)
}

