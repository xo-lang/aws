  /// The maximum Kpra length of the vehicle. Unit : centimeters
  pub max_kpra_length: Int? = None
  /// The maximum length of the vehicle.
  pub max_length: Int? = None
  /// The maximum load capacity of the vehicle. Unit : kilograms
  pub max_payload_capacity: Int? = None
  /// The maximum weight of the route. Unit : kilograms
  pub max_weight: RouteWeightConstraint? = None
  /// The maximum weight per axle of the vehicle. Unit : kilograms
  pub max_weight_per_axle: Int? = None
  /// The maximum weight per axle group of the vehicle. Unit : kilograms
  pub max_weight_per_axle_group: WeightPerAxleGroup? = None
  /// The maximum width of the vehicle.
  pub max_width: Int? = None
  /// The number of occupants in the vehicle. Default value: 1
  pub occupancy: RouteNoticeDetailRange? = None
  /// Access radius restrictions based on time.
  pub restricted_times: Str? = None
  /// The time dependent constraint.
  pub time_dependent: Bool? = None
  /// Number of trailers attached to the vehicle. Default value: 0
  pub trailer_count: RouteNoticeDetailRange? = None
  /// Travel mode corresponding to the leg.
  pub travel_mode: Bool? = None
  /// Truck road type identifiers. BK1 through BK4 apply only to Sweden.
  /// A2,A4,B2,B4,C,D,ET2,ET4 apply only to Mexico. There are currently no
  /// other supported values as of 26th April 2024.
  pub truck_road_type: Str? = None
  /// The type of truck: LightTruck for smaller delivery vehicles,
  /// StraightTruck for rigid body trucks, or Tractor for tractor-trailer
  /// combinations.
  pub truck_type: RouteTruckType? = None
  /// The tunnel restriction code. Tunnel categories in this list indicate the
  /// restrictions which apply to certain tunnels in Great Britain. They
  /// relate to the types of dangerous goods that can be transported through
  /// them. Tunnel Category B Risk Level : Limited risk Restrictions : Few
  /// restrictions Tunnel Category C Risk Level : Medium risk Restrictions :
  /// Some restrictions Tunnel Category D Risk Level : High risk Restrictions
  /// : Many restrictions occur Tunnel Category E Risk Level : Very high risk
  /// Restrictions : Restricted tunnel
  pub tunnel_restriction_code: Str? = None
}

