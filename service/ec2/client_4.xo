fn xml_write_flow_log(var w: xmlv.Writer, v: FlowLog, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "creationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.deliver_logs_error_message {
    xmlv.elem(w, "deliverLogsErrorMessage", x, [])
  }
  if let Some(x) = v.deliver_logs_permission_arn {
    xmlv.elem(w, "deliverLogsPermissionArn", x, [])
  }
  if let Some(x) = v.deliver_cross_account_role {
    xmlv.elem(w, "deliverCrossAccountRole", x, [])
  }
  if let Some(x) = v.deliver_logs_status {
    xmlv.elem(w, "deliverLogsStatus", x, [])
  }
  if let Some(x) = v.flow_log_id {
    xmlv.elem(w, "flowLogId", x, [])
  }
  if let Some(x) = v.flow_log_status {
    xmlv.elem(w, "flowLogStatus", x, [])
  }
  if let Some(x) = v.log_group_name {
    xmlv.elem(w, "logGroupName", x, [])
  }
  if let Some(x) = v.resource_id {
    xmlv.elem(w, "resourceId", x, [])
  }
  if let Some(x) = v.traffic_type {
    xmlv.elem(w, "trafficType", x.value(), [])
  }
  if let Some(x) = v.log_destination_type {
    xmlv.elem(w, "logDestinationType", x.value(), [])
  }
  if let Some(x) = v.log_destination {
    xmlv.elem(w, "logDestination", x, [])
  }
  if let Some(x) = v.log_format {
    xmlv.elem(w, "logFormat", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.max_aggregation_interval {
    xmlv.elem(w, "maxAggregationInterval", "${x}", [])
  }
  if let Some(x) = v.destination_options {
    xml_write_destination_options_response(w, x, "destinationOptions", [])
  }
  if let Some(x) = v.tag_field_specifications {
    xml_write_tag_field_specification_list_response(w, x, "tagFieldSpecificationSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_flow_log(e: xml.Element) -> FlowLog ! Str {
  var out = FlowLog{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "creationTime" => out.creation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "deliverLogsErrorMessage" => out.deliver_logs_error_message = c.text()
      "deliverLogsPermissionArn" => out.deliver_logs_permission_arn = c.text()
      "deliverCrossAccountRole" => out.deliver_cross_account_role = c.text()
      "deliverLogsStatus" => out.deliver_logs_status = c.text()
      "flowLogId" => out.flow_log_id = c.text()
      "flowLogStatus" => out.flow_log_status = c.text()
      "logGroupName" => out.log_group_name = c.text()
      "resourceId" => out.resource_id = c.text()
      "trafficType" => out.traffic_type = TrafficType.from(c.text())
      "logDestinationType" => out.log_destination_type = LogDestinationType.from(c.text())
      "logDestination" => out.log_destination = c.text()
      "logFormat" => out.log_format = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "maxAggregationInterval" => out.max_aggregation_interval = xmlv.read_int(c.text())?
      "destinationOptions" => out.destination_options = xml_read_destination_options_response(c)?
      "tagFieldSpecificationSet" => out.tag_field_specifications = xml_read_tag_field_specification_list_response(c)?
      _ => {}
    }
  }
  Ok(out)
}

