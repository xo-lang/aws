}

/// The HTTP request of Autocomplete.
pub fn serialize_autocomplete(ep: rest.Endpoint, input: AutocompleteRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  if let Some(v) = input.key {
    qs.push(("key", v))
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.query_text {
    fs.push(("QueryText", json.Value.Str(x)))
  }
  if let Some(x) = input.max_results {
    fs.push(("MaxResults", json.Value.Int(x)))
  }
  if let Some(x) = input.bias_position {
    fs.push(("BiasPosition", json_of_position(x)))
  }
  if let Some(x) = input.filter {
    fs.push(("Filter", json_of_autocomplete_filter(x)))
  }
  if let Some(x) = input.postal_code_mode {
    fs.push(("PostalCodeMode", json.Value.Str(x.value())))
  }
  if let Some(x) = input.additional_features {
    fs.push(("AdditionalFeatures", json_of_autocomplete_additional_feature_list(x)))
  }
  if let Some(x) = input.language {
    fs.push(("Language", json.Value.Str(x)))
  }
  if let Some(x) = input.political_view {
    fs.push(("PoliticalView", json.Value.Str(x)))
  }
  if let Some(x) = input.intended_use {
    fs.push(("IntendedUse", json.Value.Str(x.value())))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/v2/autocomplete"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_autocomplete(resp: http.Response) -> AutocompleteResponse ! Str {
  var out = AutocompleteResponse{}
  let body = jsonv.parse_body(resp.body)?
  if let Some(hv) = resp.header("x-amz-geo-pricing-bucket") {
    out.pricing_bucket = hv
  }
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ResultItems" => out.result_items = from_json_autocomplete_result_item_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

/// The errors of Autocomplete.
pub enum AutocompleteErr {
  AccessDeniedException(e: AccessDeniedException)
  InternalServerException(e: InternalServerException)
  ThrottlingException(e: ThrottlingException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: AutocompleteErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_autocomplete_error(resp: http.Response) -> AutocompleteErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return AutocompleteErr.AccessDeniedException(x)
      Err(msg) => return AutocompleteErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return AutocompleteErr.InternalServerException(x)
      Err(msg) => return AutocompleteErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return AutocompleteErr.ThrottlingException(x)
      Err(msg) => return AutocompleteErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return AutocompleteErr.ValidationException(x)
      Err(msg) => return AutocompleteErr.Deserialize(msg)
    }
    _ => {}
  }
  AutocompleteErr.Api(restjson.api_error(resp, body))
}

/// Autocomplete completes potential places and addresses as the user types,
/// based on the partial input. The API enhances the efficiency and accuracy
/// of address by completing query based on a few entered keystrokes. It
/// helps you by completing partial queries with valid address completion.
/// Also, the API supports the filtering of results based on geographic
/// location, country, or specific place types, and can be tailored using
/// optional parameters like language and political views. Not supported in
/// ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. For
/// more information, see Autocomplete in the Amazon Location Service
/// Developer Guide .
pub fn (c: Client) autocomplete(input: AutocompleteRequest) -> AutocompleteResponse ! AutocompleteErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_autocomplete(c.params, input)) ?? e => return Err(AutocompleteErr.InvalidInput(e))
  var req = serialize_autocomplete(ep, input, "") ?? e => return Err(AutocompleteErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(AutocompleteErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_autocomplete_error(resp))
  }
  deserialize_autocomplete(resp) ?? e => Err(AutocompleteErr.Deserialize(e))
}

