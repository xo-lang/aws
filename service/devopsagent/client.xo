  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_agent_space_id = match input.agent_space_id {
    Some(v) => v
    None => return Err("input member agentSpaceId is required")
  }
  if label_agent_space_id == "" {
    return Err("input member agentSpaceId must not be empty")
  }
  let label_asset_id = match input.asset_id {
    Some(v) => v
    None => return Err("input member assetId is required")
  }
  if label_asset_id == "" {
    return Err("input member assetId must not be empty")
  }
  let label_path = match input.path {
    Some(v) => v
    None => return Err("input member path is required")
  }
  if label_path == "" {
    return Err("input member path must not be empty")
  }
  if let Some(v) = input.asset_version {
    qs.push(("assetVersion", "${v}"))
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "GET",
    scheme: ep.scheme,
    host: "dp.${ep.host}",
    port: ep.port,
    path: rest.join_path(ep.path, "/asset/agent-space/${rest.escape(label_agent_space_id, false)}/assets/${rest.escape(label_asset_id, false)}/files/${rest.escape(label_path, true)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

