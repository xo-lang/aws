fn xml_write_instance(var w: xmlv.Writer, v: Instance, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.architecture {
    xmlv.elem(w, "architecture", x.value(), [])
  }
  if let Some(x) = v.block_device_mappings {
    xml_write_instance_block_device_mapping_list(w, x, "blockDeviceMapping", [])
  }
  if let Some(x) = v.client_token {
    xmlv.elem(w, "clientToken", x, [])
  }
  if let Some(x) = v.ebs_optimized {
    xmlv.elem(w, "ebsOptimized", "${x}", [])
  }
  if let Some(x) = v.ena_support {
    xmlv.elem(w, "enaSupport", "${x}", [])
  }
  if let Some(x) = v.hypervisor {
    xmlv.elem(w, "hypervisor", x.value(), [])
  }
