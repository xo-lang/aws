fn json_of_operation(v: Operation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.parent_id {
    fs.push(("ParentId", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.sub_type {
    fs.push(("SubType", json.Value.Str(x)))
  }
  if let Some(x) = v.start_timestamp {
    fs.push(("StartTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.end_timestamp {
    fs.push(("EndTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.status {
