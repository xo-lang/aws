    query.add(f, query.key(prefix, "EbsOptimizedSupport"), x.value())
  }
  if let Some(x) = v.encryption_support {
    query.add(f, query.key(prefix, "EncryptionSupport"), x.value())
  }
  if let Some(x) = v.ebs_optimized_info {
