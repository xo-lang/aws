    query_put_analysis_component(f, query.key(prefix, "Acl"), x)
  }
  if let Some(x) = v.acl_rule {
    query_put_analysis_acl_rule(f, query.key(prefix, "AclRule"), x)
  }
  if let Some(x) = v.address {
    query.add(f, query.key(prefix, "Address"), x)
  }
  if let Some(x) = v.addresses {
    query_put_ip_address_list(f, query.key(prefix, "AddressSet"), x, false)
  }
  if let Some(x) = v.attached_to {
    query_put_analysis_component(f, query.key(prefix, "AttachedTo"), x)
  }
  if let Some(x) = v.availability_zones {
    query_put_value_string_list(f, query.key(prefix, "AvailabilityZoneSet"), x, false)
  }
  if let Some(x) = v.availability_zone_ids {
    query_put_value_string_list(f, query.key(prefix, "AvailabilityZoneIdSet"), x, false)
  }
  if let Some(x) = v.cidrs {
    query_put_value_string_list(f, query.key(prefix, "CidrSet"), x, false)
  }
  if let Some(x) = v.component {
    query_put_analysis_component(f, query.key(prefix, "Component"), x)
  }
  if let Some(x) = v.customer_gateway {
    query_put_analysis_component(f, query.key(prefix, "CustomerGateway"), x)
  }
  if let Some(x) = v.destination {
    query_put_analysis_component(f, query.key(prefix, "Destination"), x)
  }
  if let Some(x) = v.destination_vpc {
    query_put_analysis_component(f, query.key(prefix, "DestinationVpc"), x)
  }
  if let Some(x) = v.direction {
    query.add(f, query.key(prefix, "Direction"), x)
  }
  if let Some(x) = v.explanation_code {
    query.add(f, query.key(prefix, "ExplanationCode"), x)
  }
  if let Some(x) = v.ingress_route_table {
    query_put_analysis_component(f, query.key(prefix, "IngressRouteTable"), x)
  }
  if let Some(x) = v.internet_gateway {
    query_put_analysis_component(f, query.key(prefix, "InternetGateway"), x)
  }
  if let Some(x) = v.load_balancer_arn {
    query.add(f, query.key(prefix, "LoadBalancerArn"), x)
  }
  if let Some(x) = v.classic_load_balancer_listener {
    query_put_analysis_load_balancer_listener(f, query.key(prefix, "ClassicLoadBalancerListener"), x)
  }
  if let Some(x) = v.load_balancer_listener_port {
    query.add(f, query.key(prefix, "LoadBalancerListenerPort"), "${x}")
  }
  if let Some(x) = v.load_balancer_target {
    query_put_analysis_load_balancer_target(f, query.key(prefix, "LoadBalancerTarget"), x)
  }
  if let Some(x) = v.load_balancer_target_group {
    query_put_analysis_component(f, query.key(prefix, "LoadBalancerTargetGroup"), x)
  }
  if let Some(x) = v.load_balancer_target_groups {
    query_put_analysis_component_list(f, query.key(prefix, "LoadBalancerTargetGroupSet"), x, false)
  }
  if let Some(x) = v.load_balancer_target_port {
    query.add(f, query.key(prefix, "LoadBalancerTargetPort"), "${x}")
  }
  if let Some(x) = v.elastic_load_balancer_listener {
    query_put_analysis_component(f, query.key(prefix, "ElasticLoadBalancerListener"), x)
  }
  if let Some(x) = v.missing_component {
    query.add(f, query.key(prefix, "MissingComponent"), x)
  }
  if let Some(x) = v.nat_gateway {
    query_put_analysis_component(f, query.key(prefix, "NatGateway"), x)
  }
  if let Some(x) = v.network_interface {
    query_put_analysis_component(f, query.key(prefix, "NetworkInterface"), x)
  }
  if let Some(x) = v.packet_field {
    query.add(f, query.key(prefix, "PacketField"), x)
  }
  if let Some(x) = v.vpc_peering_connection {
    query_put_analysis_component(f, query.key(prefix, "VpcPeeringConnection"), x)
  }
  if let Some(x) = v.port {
    query.add(f, query.key(prefix, "Port"), "${x}")
  }
  if let Some(x) = v.port_ranges {
    query_put_port_range_list(f, query.key(prefix, "PortRangeSet"), x, false)
  }
  if let Some(x) = v.prefix_list {
    query_put_analysis_component(f, query.key(prefix, "PrefixList"), x)
  }
  if let Some(x) = v.protocols {
    query_put_string_list(f, query.key(prefix, "ProtocolSet"), x, false)
  }
  if let Some(x) = v.route_table_route {
    query_put_analysis_route_table_route(f, query.key(prefix, "RouteTableRoute"), x)
  }
  if let Some(x) = v.route_table {
