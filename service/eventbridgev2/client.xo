pub fn serialize_create_event_bus(ep: rest.Endpoint, input: CreateEventBusRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = input.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = input.encryption_configuration {
    fs.push(("EncryptionConfiguration", json_of_encryption_configuration(x)))
  }
  if let Some(x) = input.storage_configuration {
    fs.push(("StorageConfiguration", json_of_storage_configuration(x)))
  }
  if let Some(x) = input.tags {
    fs.push(("Tags", json_of_tag_map(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("ClientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("ClientToken", json.Value.Str(idempotency_token)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
