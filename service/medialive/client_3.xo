/// Start an input device that is attached to a MediaConnect flow. (There is
/// no need to start a device that is attached to a MediaLive input;
/// MediaLive starts the device when the channel starts.)
pub fn (c: Client) start_input_device(input: StartInputDeviceRequest) -> StartInputDeviceResponse ! StartInputDeviceErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_start_input_device(c.params, input)) ?? e => return Err(StartInputDeviceErr.InvalidInput(e))
  var req = serialize_start_input_device(ep, input, "") ?? e => return Err(StartInputDeviceErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(StartInputDeviceErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_start_input_device_error(resp))
  }
  deserialize_start_input_device(resp) ?? e => Err(StartInputDeviceErr.Deserialize(e))
}

