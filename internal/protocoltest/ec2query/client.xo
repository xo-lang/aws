fn query_put_simple_input_params_input(var f: query.Form, prefix: Str, v: SimpleInputParamsInput) {
  if let Some(x) = v.foo {
    query.add(f, query.key(prefix, "Foo"), x)
  }
  if let Some(x) = v.bar {
    query.add(f, query.key(prefix, "Bar"), x)
  }
  if let Some(x) = v.baz {
    query.add(f, query.key(prefix, "Baz"), "${x}")
  }
  if let Some(x) = v.bam {
    query.add(f, query.key(prefix, "Bam"), "${x}")
  }
  if let Some(x) = v.float_value {
    query.add(f, query.key(prefix, "FloatValue"), rest.float_text(x))
  }
  if let Some(x) = v.boo {
    query.add(f, query.key(prefix, "Boo"), rest.float_text(x))
  }
  if let Some(x) = v.qux {
    query.add(f, query.key(prefix, "Qux"), x.to_base64())
  }
  if let Some(x) = v.foo_enum {
    query.add(f, query.key(prefix, "FooEnum"), x.value())
  }
  if let Some(x) = v.has_query_name {
    query.add(f, query.key(prefix, "HasQueryName"), x)
  }
  if let Some(x) = v.has_query_and_xml_name {
    query.add(f, query.key(prefix, "HasQueryAndXmlName"), x)
  }
  if let Some(x) = v.uses_xml_name {
    query.add(f, query.key(prefix, "UsesXmlName"), x)
  }
  if let Some(x) = v.distinct_query_name {
    query.add(f, query.key(prefix, "QueryName"), x)
  }
  if let Some(x) = v.distinct_query_and_xml_name {
    query.add(f, query.key(prefix, "queryAndXmlName"), x)
  }
  if let Some(x) = v.distinct_xml_name {
    query.add(f, query.key(prefix, "XmlNameOnly"), x)
  }
}

