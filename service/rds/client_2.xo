fn xml_write_tenant_database(var w: xmlv.Writer, v: TenantDatabase, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.tenant_database_create_time {
    xmlv.elem(w, "TenantDatabaseCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.db_instance_identifier {
    xmlv.elem(w, "DBInstanceIdentifier", x, [])
  }
  if let Some(x) = v.tenant_db_name {
    xmlv.elem(w, "TenantDBName", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.master_username {
    xmlv.elem(w, "MasterUsername", x, [])
  }
  if let Some(x) = v.dbi_resource_id {
    xmlv.elem(w, "DbiResourceId", x, [])
  }
  if let Some(x) = v.tenant_database_resource_id {
    xmlv.elem(w, "TenantDatabaseResourceId", x, [])
  }
  if let Some(x) = v.tenant_database_arn {
    xmlv.elem(w, "TenantDatabaseARN", x, [])
  }
  if let Some(x) = v.character_set_name {
    xmlv.elem(w, "CharacterSetName", x, [])
  }
  if let Some(x) = v.nchar_character_set_name {
    xmlv.elem(w, "NcharCharacterSetName", x, [])
  }
  if let Some(x) = v.deletion_protection {
    xmlv.elem(w, "DeletionProtection", "${x}", [])
  }
  if let Some(x) = v.pending_modified_values {
    xml_write_tenant_database_pending_modified_values(w, x, "PendingModifiedValues", [])
  }
  if let Some(x) = v.master_user_secret {
    xml_write_master_user_secret(w, x, "MasterUserSecret", [])
  }
  if let Some(x) = v.tag_list {
    xml_write_tag_list(w, x, "TagList", [])
  }
  xmlv.end(w, name)
}

fn xml_read_tenant_database(e: xml.Element) -> TenantDatabase ! Str {
  var out = TenantDatabase{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TenantDatabaseCreateTime" => out.tenant_database_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DBInstanceIdentifier" => out.db_instance_identifier = c.text()
      "TenantDBName" => out.tenant_db_name = c.text()
      "Status" => out.status = c.text()
      "MasterUsername" => out.master_username = c.text()
      "DbiResourceId" => out.dbi_resource_id = c.text()
      "TenantDatabaseResourceId" => out.tenant_database_resource_id = c.text()
      "TenantDatabaseARN" => out.tenant_database_arn = c.text()
      "CharacterSetName" => out.character_set_name = c.text()
      "NcharCharacterSetName" => out.nchar_character_set_name = c.text()
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "PendingModifiedValues" => out.pending_modified_values = xml_read_tenant_database_pending_modified_values(c)?
      "MasterUserSecret" => out.master_user_secret = xml_read_master_user_secret(c)?
      "TagList" => out.tag_list = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

