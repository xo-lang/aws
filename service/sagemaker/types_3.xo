  /// used to give SageMaker access credentials to your private Docker
  /// registry.
  pub training_repository_credentials_provider_arn: Str? = None
}

/// Contains detailed information about a training session.
pub struct TrainingSessionDetail {
  /// The Amazon Resource Name (ARN) of the training session.
  pub training_session_arn: Str? = None
  /// The name of the training session.
  pub training_session_name: Str? = None
  /// The current status of the training session.
  pub training_session_status: TrainingSessionStatus? = None
  /// The Amazon Resource Name (ARN) of the model package group where
  /// checkpoints are published.
  pub model_package_group_arn: Str? = None
  /// The date and time that the training session was created.
  pub creation_time: Time? = None
  /// The date and time that the training session was last modified.
  pub last_modified_time: Time? = None
  /// The date and time that the training session ended.
  pub end_time: Time? = None
  /// If the training session failed or is blocked, detailed error
  /// information.
  pub error_details: Str? = None
  /// The sequence number of the last training operation received by the
  /// session.
  pub last_received_sequence_number: Int? = None
  /// The billable token usage for the training session.
  pub billable_token_usage: BillableTokenUsage? = None
  /// The Virtual Private Cloud (VPC) configuration for the training session.
  pub vpc_config: VpcConfig? = None
  /// The Amazon Resource Name (ARN) of the IAM role associated with the
  /// training session.
  pub role_arn: Str? = None
  /// The Low-Rank Adaptation (LoRA) configuration for the training session.
  pub lora_config: LoraConfig? = None
  /// The configuration for the base model.
  pub model_config: TrainingSessionModelConfig? = None
  /// The output configuration for the training session.
  pub output_config: TrainingSessionOutputConfig? = None
  /// The tags associated with the training session.
  pub tags: List[Tag]? = None
}

/// The configuration for the base model used in a training session.
pub struct TrainingSessionModelConfig {
  /// The Amazon Resource Name (ARN) of the base foundation model from
  /// SageMaker Hub.
  pub base_model_arn: Str? = None
  /// Specifies whether you accept the end-user license agreement (EULA) for
  /// gated models.
  pub accept_eula: Bool? = None
}

/// The output configuration for a training session, including the Amazon S3
/// location for checkpoints and model artifacts, and optional encryption
/// settings.
pub struct TrainingSessionOutputConfig {
