/// PutObject as a presigned POST: the URL and form fields with which a
/// browser uploads `input.key` without credentials until `expires`
/// passes (at most 7 days). `conditions` are added to the policy (S3's
/// POST policy conditions, such as `["content-length-range", 1, 1048576]`).
pub fn (c: Client) presign_post_object(input: PutObjectRequest, expires: Duration = 15m, conditions: List[json.Value] = []) -> transport.PresignedPost ! PutObjectErr uses (net.dial, clock, rand) {
  let (ep, routed, extra) = c.route(endpoint_params_put_object(c.params, input)) ?? e => return Err(PutObjectErr.InvalidInput(e))
  let signing = match c.express_session(routed) {
    Ok(v) => v
    Err(transport.PrecallErr.Send(e)) => return Err(PutObjectErr.Send(e))
    Err(transport.PrecallErr.Api(e)) => return Err(PutObjectErr.Api(e))
    Err(transport.PrecallErr.InvalidInput(m)) => return Err(PutObjectErr.InvalidInput(m))
    Err(transport.PrecallErr.Deserialize(m)) => return Err(PutObjectErr.Deserialize(m))
  }
  if !extra.is_empty() {
    return Err(PutObjectErr.InvalidInput("a presigned POST cannot carry the endpoint's headers"))
  }
  let bucket = input.bucket ?? return Err(PutObjectErr.InvalidInput("a presigned POST needs a bucket"))
  let key = input.key ?? return Err(PutObjectErr.InvalidInput("a presigned POST needs a key"))
  let port = ep.port.map(fn(p: Int) -> Str { ":${p}" }) ?? ""
  transport.presign_post(c.transport, "${ep.scheme}://${ep.host}${port}${ep.path}", signing, bucket, key, expires, conditions) ?? e => Err(PutObjectErr.Send(e))
}

pub fn endpoint_params_put_object_acl(base: EndpointParameters, input: PutObjectAclRequest) -> EndpointParameters {
  var p = base
  if let Some(x) = input.bucket {
    p.bucket = x
  }
  if let Some(x) = input.key {
    p.key = x
  }
  p
}

