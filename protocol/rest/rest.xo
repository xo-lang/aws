// Shared pieces of the HTTP binding protocols (restJson1, restXml) and
// of every protocol's scalar text forms: label, query and header
// encodings, and the three Smithy timestamp formats, written and read as
// smithy-go does (decision 0003).

use std/http
use std/time
use std/url

const HEX: Str = "0123456789ABCDEF"

/// Escapes a label (or a query key or value): unreserved characters
/// kept, everything else %XX; `/` kept too for a greedy label.
pub fn escape(s: Str, keep_slash: Bool = false) -> Str {
  let b = s.bytes()
  let hex = HEX.bytes()
  var out = BytesBuilder.with_capacity(b.len())
  for c in b {
    let keep = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) ||
      c == 45 || c == 46 || c == 95 || c == 126 || (keep_slash && c == 47)
    if keep {
      out.write_byte(c)
    } else {
      out.write_byte(37)
      out.write_byte(hex[Int(c) >> 4])
      out.write_byte(hex[Int(c) & 15])
    }
  }
  out.freeze().to_str() ?? s
}

/// A query string from pairs, in order (`k=v&...`, a key alone for an
/// empty constant such as `?list`).
pub fn query(pairs: List[(Str, Str)]) -> Str {
  pairs.map(fn(p: (Str, Str)) -> Str { "${escape(p.0)}=${escape(p.1)}" }).join("&")
}

/// The decoded pairs of a raw query.
pub fn parse_query(raw: Str) -> List[(Str, Str)] {
  if raw == "" {
    return []
  }
  raw.split("&").map(fn(part: Str) -> (Str, Str) {
    let (k, v) = part.cut("=") ?? (part, "")
    (url.query_unescape(k).ok() ?? k, url.query_unescape(v).ok() ?? v)
  })
}

/// Go's strconv.FormatFloat(f, 'f', -1, 64) with Smithy's names for the
/// special values: the text forms in labels, queries and headers.
pub fn float_text(f: Float) -> Str {
  if f.is_nan() {
    return "NaN"
  }
  if f.is_inf() {
    return if f > 0.0 { "Infinity" } else { "-Infinity" }
  }
  f.to_fixed(-1)
}

/// NaN and the infinities (Float has no constants for them yet).
pub fn nan() -> Float {
  Float.parse("NaN") ?? 0.0
}

pub fn inf() -> Float {
  Float.parse("Inf") ?? 0.0
}

pub fn parse_float(s: Str) -> Float? {
  match s {
    "NaN" => Some(nan())
    "Infinity" => Some(inf())
    "-Infinity" => Some(-inf())
    _ => Float.parse(s)
  }
}

/// A header list value: each item quoted when it holds a comma or a
/// double quote (smithy-go's httpbinding), joined by ", ".
pub fn header_list(items: List[Str]) -> Str {
  items.map(fn(s: Str) -> Str {
    if s.contains(",") || s.contains("\"") {
      "\"${s.replace("\\", "\\\\").replace("\"", "\\\"")}\""
    } else {
      s
    }
  }).join(", ")
}

/// The first field of `name`, trimmed, as aws-sdk-go-v2's generated
/// deserializers read a scalar header (`Header.Values(name)[0]` with
/// strings.TrimSpace): a repeated header's later fields are ignored.
pub fn first_header(resp: http.Response, name: Str) -> Str? {
  resp.header_values(name).first().map(fn(v: Str) -> Str { go_trim_space(v) })
}

/// Whether `r` is Go's unicode.IsSpace.
fn is_go_space(r: Rune) -> Bool {
  let n = Int(r)
  (n >= 0x09 && n <= 0x0d) || n == 0x20 || n == 0x85 || n == 0xa0 || n == 0x1680 || (n >= 0x2000 && n <= 0x200a) || n == 0x2028 || n == 0x2029 || n == 0x202f || n == 0x205f || n == 0x3000
}

/// Go's strings.TrimSpace.
pub fn go_trim_space(s: Str) -> Str {
  let rs = s.runes()
  var i = 0
  var j = rs.len()
  while i < j && is_go_space(rs[i]) {
    i += 1
  }
  while j > i && is_go_space(rs[j - 1]) {
    j -= 1
  }
  var out = StrBuilder.new()
  for k in i..j {
    out.write("${rs[k]}")
  }
  out.freeze()
}

/// Whether byte `b` is a space to Go's `unicode.IsSpace(rune(b))`, which
/// smithy-go applies to single bytes.
fn is_space_byte(b: UInt8) -> Bool {
  (b >= 0x09 && b <= 0x0d) || b == 0x20 || b == 0x85 || b == 0xa0
}

fn hex_digit(b: UInt8) -> Int? {
  if b >= 0x30 && b <= 0x39 { Some(Int(b) - 0x30) } else if b >= 0x61 && b <= 0x66 { Some(Int(b) - 0x61 + 10) } else if b >= 0x41 && b <= 0x46 { Some(Int(b) - 0x41 + 10) } else { None }
}

/// Go's strconv.Unquote of a double-quoted string (quotes included), or
/// None where Go gives ErrSyntax.
fn go_unquote(s: Str) -> Str? {
  let bs = s.bytes()
  let n = bs.len()
  if n < 2 || bs[0] != 0x22 || bs[n - 1] != 0x22 {
    return None
  }
  let body = bs[1..n - 1]
  var out = BytesBuilder.new()
  var i = 0
  while i < body.len() {
    let c = body[i]
    if c == 0x22 || c == 0x0a {
      return None
    }
    if c != 0x5c {
      out.write_byte(c)
      i += 1
      continue
    }
    if i + 1 >= body.len() {
      return None
    }
    let e = body[i + 1]
    i += 2
    let named = if e == 0x61 { Some(7) } else if e == 0x62 { Some(8) } else if e == 0x66 { Some(12) } else if e == 0x6e { Some(10) } else if e == 0x72 { Some(13) } else if e == 0x74 { Some(9) } else if e == 0x76 { Some(11) } else if e == 0x5c { Some(0x5c) } else if e == 0x22 { Some(0x22) } else { None }
    if let Some(v) = named {
      out.write_byte(UInt8(v))
      continue
    }
    if e == 0x78 || e == 0x75 || e == 0x55 {
      let width = if e == 0x78 { 2 } else if e == 0x75 { 4 } else { 8 }
      if i + width > body.len() {
        return None
      }
      var v = 0
      for k in 0..width {
        v = v * 16 + (hex_digit(body[i + k]) ?? return None)
      }
      i += width
      if e == 0x78 {
        out.write_byte(UInt8(v))
      } else {
        let r = Rune.try(v) ?? return None
        for b in "${r}".bytes() {
          out.write_byte(b)
        }
      }
      continue
    }
    if e >= 0x30 && e <= 0x37 {
      if i + 2 > body.len() {
        return None
      }
      var v = Int(e) - 0x30
      for k in 0..2 {
        let d = body[i + k]
        if d < 0x30 || d > 0x37 {
          return None
        }
        v = v * 8 + Int(d) - 0x30
      }
      if v > 255 {
        return None
      }
      i += 2
      out.write_byte(UInt8(v))
      continue
    }
    return None
  }
  Some(out.freeze().to_str_lossy())
}

/// One header field split as smithy-go's quotedCommaSplit splits it, with
/// its error text: items at commas, a quoted item unquoted as Go's
/// strconv.Unquote, and a trailing comma giving an empty last item.
fn quoted_comma_split(v0: Str) -> List[Str] ! Str {
  let v = go_trim_space(v0)
  let bs = v.bytes()
  var parts: List[Str] = []
  var expect_more = true
  var i = 0
  while i < bs.len() {
    if is_space_byte(bs[i]) {
      i += 1
      continue
    }
    expect_more = false
    let remaining = bs[i..bs.len()]
    let rem = remaining.to_str_lossy()
    var value = ""
    var value_len = 0
    if remaining[0] == 0x22 {
      var j = 1
      var skip_quote = false
      while j < remaining.len() {
        if remaining[j] == 0x5c || skip_quote {
          skip_quote = !skip_quote
          j += 1
          continue
        }
        if remaining[j] == 0x22 {
          break
        }
        j += 1
      }
      if j == remaining.len() || j == 1 {
        return Err("value ${rem} missing closing double quote")
      }
      value_len = j + 1
      let tail = remaining[value_len..remaining.len()]
      var k = 0
      while k < tail.len() {
        if !is_space_byte(tail[k]) && tail[k] != 0x2c {
          return Err("value ${rem} has non-space trailing characters")
        }
        if tail[k] == 0x2c {
          expect_more = true
          break
        }
        k += 1
      }
      value = go_unquote(remaining[0..value_len].to_str_lossy()) ?? return Err("failed to unquote value , invalid syntax")
      value_len += k
    } else {
      value_len = match rem.find(",") {
        Some(c) => {
          expect_more = true
          c
        }
        None => remaining.len()
      }
      value = go_trim_space(remaining[0..value_len].to_str_lossy())
    }
    i += value_len
    parts.push(value)
    // Go's loop adds one after the item (its `i++`), stepping over the
    // comma or the byte after a quoted item's trailing spaces.
    i += 1
  }
  if expect_more {
    parts.push("")
  }
  Ok(parts)
}

/// The items of a list header's fields, as smithy-go's
/// SplitHeaderListValues gives them: each field split on its own.
pub fn split_header_values(vs: List[Str]) -> List[Str] ! Str {
  var out: List[Str] = []
  for v in vs {
    out = out + quoted_comma_split(v)?
  }
  Ok(out)
}

/// The HTTP dates of a list header's fields, as smithy-go's
/// SplitHTTPDateTimestampHeaderListValues gives them: each field split at
/// every second comma; an even count of commas over one is Go's error.
pub fn split_http_date_values(vs: List[Str]) -> List[Str] ! Str {
  var out: List[Str] = []
  for v in vs {
    let n = v.count(",")
    if n <= 1 {
      out.push(v)
      continue
    }
    if n % 2 == 0 {
      return Err("invalid timestamp HTTPDate header comma separations, ${go_quote(v)}")
    }
    let bs = v.bytes()
    var j = 0
    var do_split = false
    for i in 0..bs.len() {
      if bs[i] == 0x2c {
        if do_split {
          do_split = false
          out.push(go_trim_space(bs[j..i].to_str_lossy()))
          j = i + 1
        } else {
          do_split = true
        }
      }
    }
    if j < bs.len() {
      out.push(go_trim_space(bs[j..bs.len()].to_str_lossy()))
    }
  }
  Ok(out)
}

/// Go's strconv.Quote of ASCII text.
fn go_quote(s: Str) -> Str {
  var out = "\""
  for c in s.runes() {
    let n = Int(c)
    out = out + (if c == '"' { "\\\"" } else if c == '\\' { "\\\\" } else if c == '\n' { "\\n" } else if c == '\t' { "\\t" } else if c == '\r' { "\\r" } else if n == 7 { "\\a" } else if n == 8 { "\\b" } else if n == 12 { "\\f" } else if n == 11 { "\\v" } else if n < 0x20 || n == 0x7f { "\\x" + n.to_str_width(2, base: 16, zero: true) } else { "${c}" })
  }
  out + "\""
}

fn unix_nanos(t: Time) -> Int {
  (t - Time.UNIX_EPOCH).nanos()
}

fn from_nanos(n: Int) -> Time {
  Time.UNIX_EPOCH + Duration.from_nanos(n)
}

/// The fraction of a second at millisecond precision, without trailing
/// zeros (".123", ".1", or "" for none).
fn millis_fraction(t: Time) -> Str {
  let ms = ((unix_nanos(t) % 1000000000 + 1000000000) % 1000000000) / 1000000
  if ms == 0 {
    return ""
  }
  var s = "${ms + 1000}".bytes()[1..4].to_str() ?? ""
  while s.ends_with("0") {
    s = s.bytes()[0..s.len() - 1].to_str() ?? s
  }
  ".${s}"
}

/// Smithy `epoch-seconds`: seconds, with milliseconds when there are any.
pub fn epoch_seconds(t: Time) -> Str {
  let n = unix_nanos(t)
  let secs = if n < 0 && n % 1000000000 != 0 { n / 1000000000 - 1 } else { n / 1000000000 }
  "${secs}${millis_fraction(t)}"
}

/// Smithy `date-time`: RFC 3339 in UTC with milliseconds when there are any.
pub fn date_time(t: Time) -> Str {
  "${time.format(t, time.utc(), "{year}-{month}-{day}T{hour}:{minute}:{second}")}${millis_fraction(t)}Z"
}

/// Smithy `http-date`: IMF-fixdate.
pub fn http_date(t: Time) -> Str {
  "${time.format(t, time.utc(), "{weekday:short}, {day} {month:short} {year} {hour}:{minute}:{second}")}${millis_fraction(t)} GMT"
}

/// Reads an `epoch-seconds` number (integer or with a fraction).
pub fn parse_epoch_seconds(s: Str) -> Time? {
  let (whole, frac) = s.cut(".") ?? (s, "")
  let secs = Int.parse(whole) ?? return None
  var nanos = 0
  if frac != "" {
    var digits = frac
    while digits.len() < 9 {
      digits = "${digits}0"
    }
    nanos = Int.parse(digits.bytes()[0..9].to_str() ?? "") ?? return None
    if whole.starts_with("-") {
      nanos = -nanos
    }
  }
  Some(from_nanos(secs * 1000000000 + nanos))
}

pub fn epoch_seconds_float(f: Float) -> Time {
  from_nanos(Int((f * 1000.0).round()) * 1000000)
}

/// Reads a `date-time` (RFC 3339, any offset, any fraction).
pub fn parse_date_time(s: Str) -> Time? {
  Time.parse_rfc3339(s)
}

/// Reads an `http-date`, with or without a fraction of a second.
pub fn parse_http_date(s: Str) -> Time? {
  let trimmed = s.trim()
  // drop a fraction before " GMT"
  let text = match trimmed.cut_suffix(" GMT") {
    Some(head) => match head.cut(".") {
      Some((a, frac)) => {
        let base = time.parse("${a} GMT", time.RFC1123, time.utc()).ok() ?? return None
        let extra = parse_epoch_seconds("0.${frac}") ?? return None
        return Some(base + (extra - Time.UNIX_EPOCH))
      }
      None => trimmed
    }
    None => trimmed
  }
  time.parse(text, time.RFC1123, time.utc()).ok()
}

/// Where requests go: a base endpoint URL's parts.
pub struct Endpoint {
  pub scheme: Str = "https"
  pub host: Str
  pub port: Int? = None
  /// A path prefix the endpoint has ("" for none), without a final `/`.
  pub path: Str = ""
}

/// The parts of a base endpoint such as `https://example.com` or
/// `http://localhost:4566/prefix`.
pub fn parse_endpoint(u: Str) -> Endpoint? {
  let (scheme, rest) = u.cut("://") ?? return None
  let (hostport, path) = match rest.cut("/") {
    Some((h, p)) => (h, "/${p}")
    None => (rest, "")
  }
  let trimmed = if path.ends_with("/") { path.bytes()[0..path.len() - 1].to_str() ?? path } else { path }
  match hostport.cut(":") {
    Some((h, p)) => Some(Endpoint{scheme: scheme, host: h, port: Some(Int.parse(p) ?? return None), path: trimmed})
    None => Some(Endpoint{scheme: scheme, host: hostport, path: trimmed})
  }
}

/// A random (version 4) UUID, the default idempotency token.
pub fn uuid(rand: Rand) -> Str uses rand {
  let b = rand.bytes(16)
  let hex = b.to_hex()
  let v = hex.bytes()
  // version 4 and the RFC 4122 variant
  let x = "${v[0..12].to_str() ?? ""}4${v[13..16].to_str() ?? ""}"
  let variant = "89ab".bytes()[Int(b[8]) & 3]
  var out = BytesBuilder.new()
  out.write(x.bytes())
  out.write_byte(variant)
  out.write(v[17..32])
  let s = out.freeze().to_str() ?? hex
  let sb = s.bytes()
  "${sb[0..8].to_str() ?? ""}-${sb[8..12].to_str() ?? ""}-${sb[12..16].to_str() ?? ""}-${sb[16..20].to_str() ?? ""}-${sb[20..32].to_str() ?? ""}"
}

/// An endpoint's base path joined with an operation's path: the base
/// alone for `/`, no doubled slash otherwise.
pub fn join_path(base: Str, path: Str) -> Str {
  if base == "" || base == "/" {
    return path
  }
  let b = base.cut_suffix("/") ?? base
  if path == "/" || path == "" { b } else { "${b}${path}" }
}

/// The path of an RPC request (awsJson, awsQuery): the base endpoint's
/// path with one trailing slash.
pub fn rpc_path(base: Str) -> Str {
  "${base.cut_suffix("/") ?? base}/"
}
