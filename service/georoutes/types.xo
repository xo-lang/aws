  pub hazardous_cargos: List[RoadSnapHazardousCargoType]? = None
  /// Height of the vehicle. Unit : centimeters
  pub height: Int? = None
  /// Length of the vehicle. Unit : centimeters
  pub length: Int? = None
  /// Trailer options corresponding to the vehicle.
  pub trailer: RoadSnapTrailerOptions? = None
  /// The tunnel restriction code. Tunnel categories in this list indicate the
  /// restrictions which apply to certain tunnels in Great Britain. They
  /// relate to the types of dangerous goods that can be transported through
  /// them. Tunnel Category B Risk Level : Limited risk Restrictions : Few
  /// restrictions Tunnel Category C Risk Level : Medium risk Restrictions :
  /// Some restrictions Tunnel Category D Risk Level : High risk Restrictions
  /// : Many restrictions occur Tunnel Category E Risk Level : Very high risk
  /// Restrictions : Restricted tunnel
  pub tunnel_restriction_code: Str? = None
  /// Width of the vehicle in centimeters.
  pub width: Int? = None
}

/// The route.
pub struct Route {
  /// A leg is a section of a route from one waypoint to the next. A leg could
  /// be of type Vehicle, Pedestrian or Ferry. Legs of different types could
  /// occur together within a single route. For example, a car employing the
  /// use of a Ferry will contain Vehicle legs corresponding to journey on
  /// land, and Ferry legs corresponding to the journey via Ferry.
  pub legs: List[RouteLeg]? = None
  /// Important labels including names and route numbers that differentiate
  /// the current route from the alternatives presented.
  pub major_road_labels: List[RouteMajorRoadLabel]? = None
  /// Summarized details of the leg.
  pub summary: RouteSummary? = None
}

/// Details of the access point.
pub struct RouteAccessPointDetails {
  /// Wheelchair accessibility information for the access point.
  pub accessibility: RouteAccessibilityAvailabilityDetails? = None
}

pub enum RouteAccessibilityAttribute: Str {
  Wheelchair = "Wheelchair"
  Unknown(value: Str)
}

pub enum RouteAccessibilityAvailability: Str {
  Available = "Available"
  Limited = "Limited"
  Unavailable = "Unavailable"
  Unknown = "Unknown"
  UnknownValue(value: Str)
}

/// Details about the availability of accessibility features.
pub struct RouteAccessibilityAvailabilityDetails {
  /// Wheelchair accessibility status.
  pub wheelchair: RouteAccessibilityAvailability? = None
}

/// Features that are allowed while calculating a route.
pub struct RouteAllowOptions {
  /// Allow Hot (High Occupancy Toll) lanes while calculating the route.
  /// Default value: false
  pub hot: Bool? = None
  /// Allow Hov (High Occupancy vehicle) lanes while calculating the route.
  /// Default value: false
  pub hov: Bool? = None
}

/// Required attribution to display.
pub struct RouteAttribution {
  /// The type of the attribution link.
  pub attribution_type: RouteAttributionType? = None
  /// The URL to an external resource.
  pub web_link: RouteWebLink? = None
}

pub enum RouteAttributionType: Str {
  Disclaimer = "Disclaimer"
  Tariff = "Tariff"
  Unknown(value: Str)
}

/// Areas to be avoided.
pub struct RouteAvoidanceArea {
  /// Exceptions to the provided avoidance geometry, to be included while
  /// calculating the route.
  pub except: List[RouteAvoidanceAreaGeometry]? = None
  pub geometry: RouteAvoidanceAreaGeometry? = None
}

/// Geometry of the area to be avoided.
pub struct RouteAvoidanceAreaGeometry {
  /// Geometry defined as a corridor - a LineString with a radius that defines
  /// the width of the corridor.
  pub corridor: Corridor? = None
  /// Geometry defined as a bounding box. The first pair represents the X and
  /// Y coordinates (longitude and latitude,) of the southwest corner of the
  /// bounding box; the second pair represents the X and Y coordinates
  /// (longitude and latitude) of the northeast corner.
  pub bounding_box: List[Float]? = None
  /// Geometry defined as a polygon with only one linear ring.
  pub polygon: List[List[List[Float]]]? = None
  /// Geometry defined as an encoded corridor - an encoded polyline with a
  /// radius that defines the width of the corridor.
  pub polyline_corridor: PolylineCorridor? = None
  /// A list of Isoline PolylinePolygon, for each isoline PolylinePolygon, it
  /// contains PolylinePolygon of the first linear ring (the outer ring) and
  /// from 2nd item to the last item (the inner rings). For more information
  /// on polyline encoding, see https://github.com/aws-geospatial/polyline .
  pub polyline_polygon: List[Str]? = None
}

/// Specifies options for areas to avoid when calculating the route. This is
/// a best-effort avoidance setting, meaning the router will try to honor
/// the avoidance preferences but may still include restricted areas if no
/// feasible alternative route exists. If avoidance options are not
/// followed, the response will indicate that the avoidance criteria were
/// violated.
pub struct RouteAvoidanceOptions {
  /// Areas to be avoided. Not supported in ap-southeast-1 and ap-southeast-5
  /// regions for GrabMaps customers.
  pub areas: List[RouteAvoidanceArea]? = None
  /// Avoid car-shuttle-trains while calculating the route. Not supported in
  /// ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
  pub car_shuttle_trains: Bool? = None
  /// Avoid controlled access highways while calculating the route.
  pub controlled_access_highways: Bool? = None
  /// Avoid dirt roads while calculating the route. Not supported in
  /// ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
  pub dirt_roads: Bool? = None
  /// Avoid ferries while calculating the route.
  pub ferries: Bool? = None
  /// Avoid roads that have seasonal closure while calculating the route. Not
  /// supported in ap-southeast-1 and ap-southeast-5 regions for GrabMaps
  /// customers.
  pub seasonal_closure: Bool? = None
  /// Avoids roads where the specified toll transponders are the only mode of
  /// payment.
  pub toll_roads: Bool? = None
  /// Avoids roads where the specified toll transponders are the only mode of
  /// payment. Not supported in ap-southeast-1 and ap-southeast-5 regions for
  /// GrabMaps customers.
  pub toll_transponders: Bool? = None
  /// Truck road type identifiers. BK1 through BK4 apply only to Sweden.
  /// A2,A4,B2,B4,C,D,ET2,ET4 apply only to Mexico. Not supported in
  /// ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers. There
  /// are currently no other supported values as of 26th April 2024.
  pub truck_road_types: List[Str]? = None
  /// Avoid tunnels while calculating the route. Not supported in
  /// ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
  pub tunnels: Bool? = None
  /// Avoid U-turns for calculation on highways and motorways. Not supported
  /// in ap-southeast-1 and ap-southeast-5 regions for GrabMaps customers.
  pub u_turns: Bool? = None
  /// Zone categories to be avoided. Not supported in ap-southeast-1 and
  /// ap-southeast-5 regions for GrabMaps customers.
  pub zone_categories: List[RouteAvoidanceZoneCategory]? = None
}

/// Zone categories to be avoided. Not supported in ap-southeast-1 and
/// ap-southeast-5 regions for GrabMaps customers.
pub struct RouteAvoidanceZoneCategory {
  /// Zone category to be avoided.
  pub category: RouteZoneCategory? = None
}

/// Travel mode options when the provided travel mode is Car . For GrabMaps
/// customers, ap-southeast-1 and ap-southeast-5 regions support only
/// LicensePlate options.
pub struct RouteCarOptions {
  /// Engine type of the vehicle. Not supported in ap-southeast-1 and
  /// ap-southeast-5 regions for GrabMaps customers.
  pub engine_type: RouteEngineType? = None
  /// The vehicle License Plate.
  pub license_plate: RouteVehicleLicensePlate? = None
  /// Maximum speed specified. Not supported in ap-southeast-1 and
  /// ap-southeast-5 regions for GrabMaps customers. Unit : kilometers per
  /// hour
  pub max_speed: Float? = None
  /// The number of occupants in the vehicle. Not supported in ap-southeast-1
  /// and ap-southeast-5 regions for GrabMaps customers. Default value: 1
  pub occupancy: Int? = None
}

/// Details about the EV charge at the current step.
pub struct RouteChargeStepDetails {
  /// Estimated vehicle battery charge before this step (in kWh).
  pub arrival_charge: Float? = None
  /// Maximum charging power available to the vehicle. Unit : KwH
  pub consumable_power: Float? = None
  /// Details that are specific to a Charge step. Unit : KwH
  pub desired_charge: Float? = None
}

/// Details related to the continue highway step.
pub struct RouteContinueHighwayStepDetails {
  /// Name of the intersection, if applicable to the step.
  pub intersection: List[LocalizedString]? = None
  /// Steering direction for the step.
  pub steering_direction: RouteSteeringDirection? = None
  /// Angle of the turn.
  pub turn_angle: Float? = None
  /// Intensity of the turn.
  pub turn_intensity: RouteTurnIntensity? = None
}

/// Details related to the continue step.
pub struct RouteContinueStepDetails {
  /// Name of the intersection, if applicable to the step.
  pub intersection: List[LocalizedString]? = None
}

/// Options related to the destination.
pub struct RouteDestinationOptions {
  /// The distance in meters from the destination point within which certain
  /// routing actions (such as U-turns or left turns across traffic) are
  /// restricted. This helps generate more practical routes by avoiding
  /// potentially dangerous maneuvers near the endpoint.
  pub avoid_actions_for_distance: Int? = None
  /// Avoid U-turns for calculation on highways and motorways.
  pub avoid_u_turns: Bool? = None
  /// GPS Heading at the position.
  pub heading: Float? = None
  /// Options to configure matching the provided position to the road network.
  pub matching: RouteMatchingOptions? = None
  /// Options to configure matching the provided position to a side of the
  /// street.
  pub side_of_street: RouteSideOfStreetOptions? = None
  /// Duration of the stop. Unit : seconds
  pub stop_duration: Int? = None
}

pub enum RouteDirection: Str {
  East = "East"
  North = "North"
  South = "South"
  West = "West"
  Unknown(value: Str)
}

/// Driver related options.
pub struct RouteDriverOptions {
  /// Driver work-rest schedule. Stops are added to fulfil the provided rest
