pub fn deserialize_update_workteam_error(resp: http.Response) -> UpdateWorkteamErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "ResourceLimitExceeded" => match read_error_resource_limit_exceeded(resp, body) {
      Ok(x) => return UpdateWorkteamErr.ResourceLimitExceeded(x)
      Err(msg) => return UpdateWorkteamErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateWorkteamErr.Api(restjson.api_error(resp, body))
}

/// Updates an existing work team with new member definitions or
