/// The HTTP request of AssociateService.
pub fn serialize_associate_service(ep: rest.Endpoint, input: AssociateServiceInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
