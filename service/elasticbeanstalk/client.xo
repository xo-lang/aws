fn xml_read_environment_description(e: xml.Element) -> EnvironmentDescription ! Str {
  var out = EnvironmentDescription{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "EnvironmentName" => out.environment_name = c.text()
      "EnvironmentId" => out.environment_id = c.text()
      "ApplicationName" => out.application_name = c.text()
      "VersionLabel" => out.version_label = c.text()
      "SolutionStackName" => out.solution_stack_name = c.text()
      "PlatformArn" => out.platform_arn = c.text()
      "TemplateName" => out.template_name = c.text()
      "Description" => out.description = c.text()
      "EndpointURL" => out.endpoint_url = c.text()
      "CNAME" => out.cname = c.text()
      "DateCreated" => out.date_created = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DateUpdated" => out.date_updated = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Status" => out.status = EnvironmentStatus.from(c.text())
      "AbortableOperationInProgress" => out.abortable_operation_in_progress = xmlv.read_bool(c.text())?
      "Health" => out.health = EnvironmentHealth.from(c.text())
      "HealthStatus" => out.health_status = EnvironmentHealthStatus.from(c.text())
      "Resources" => out.resources = xml_read_environment_resources_description(c)?
      "Tier" => out.tier = xml_read_environment_tier(c)?
      "EnvironmentLinks" => out.environment_links = xml_read_environment_links(c)?
      "EnvironmentArn" => out.environment_arn = c.text()
      "OperationsRole" => out.operations_role = c.text()
      _ => {}
    }
  }
  Ok(out)
}

