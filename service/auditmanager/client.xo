      "iamId" => out.iam_id = jsonv.read_str(fv)?
      "complianceCheck" => out.compliance_check = jsonv.read_str(fv)?
      "awsOrganization" => out.aws_organization = jsonv.read_str(fv)?
      "awsAccountId" => out.aws_account_id = jsonv.read_str(fv)?
      "evidenceFolderId" => out.evidence_folder_id = jsonv.read_str(fv)?
      "id" => out.id = jsonv.read_str(fv)?
      "assessmentReportSelection" => out.assessment_report_selection = jsonv.read_str(fv)?
      _ => {}
