fn query_put_transit_gateway_options(var f: query.Form, prefix: Str, v: TransitGatewayOptions) {
  if let Some(x) = v.amazon_side_asn {
    query.add(f, query.key(prefix, "AmazonSideAsn"), "${x}")
  }
  if let Some(x) = v.transit_gateway_cidr_blocks {
