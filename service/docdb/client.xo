    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.Tag.${i + 1}" }
    query_put_tag(f, k, x)
  }
}

fn query_put_tag_list_message(var f: query.Form, prefix: Str, v: TagListMessage) {
  if let Some(x) = v.tag_list {
    query_put_tag_list(f, query.key(prefix, "TagList"), x, false)
  }
}

fn query_put_upgrade_target(var f: query.Form, prefix: Str, v: UpgradeTarget) {
  if let Some(x) = v.engine {
    query.add(f, query.key(prefix, "Engine"), x)
  }
  if let Some(x) = v.engine_version {
    query.add(f, query.key(prefix, "EngineVersion"), x)
  }
  if let Some(x) = v.description {
    query.add(f, query.key(prefix, "Description"), x)
  }
  if let Some(x) = v.auto_upgrade {
    query.add(f, query.key(prefix, "AutoUpgrade"), "${x}")
  }
  if let Some(x) = v.is_major_version_upgrade {
    query.add(f, query.key(prefix, "IsMajorVersionUpgrade"), "${x}")
  }
}

fn query_put_valid_upgrade_target_list(var f: query.Form, prefix: Str, v: List[UpgradeTarget], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.UpgradeTarget.${i + 1}" }
    query_put_upgrade_target(f, k, x)
  }
}

fn query_put_vpc_security_group_id_list(var f: query.Form, prefix: Str, v: List[Str], flat: Bool) {
  if v.is_empty() {
