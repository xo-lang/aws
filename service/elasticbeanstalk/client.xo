fn xml_read_platform_description(e: xml.Element) -> PlatformDescription ! Str {
  var out = PlatformDescription{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "PlatformArn" => out.platform_arn = c.text()
      "PlatformOwner" => out.platform_owner = c.text()
      "PlatformName" => out.platform_name = c.text()
      "PlatformVersion" => out.platform_version = c.text()
      "SolutionStackName" => out.solution_stack_name = c.text()
      "PlatformStatus" => out.platform_status = PlatformStatus.from(c.text())
      "DateCreated" => out.date_created = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DateUpdated" => out.date_updated = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PlatformCategory" => out.platform_category = c.text()
      "Description" => out.description = c.text()
      "Maintainer" => out.maintainer = c.text()
      "OperatingSystemName" => out.operating_system_name = c.text()
      "OperatingSystemVersion" => out.operating_system_version = c.text()
      "ProgrammingLanguages" => out.programming_languages = xml_read_platform_programming_languages(c)?
      "Frameworks" => out.frameworks = xml_read_platform_frameworks(c)?
      "CustomAmiList" => out.custom_ami_list = xml_read_custom_ami_list(c)?
      "DefaultAmiList" => out.default_ami_list = xml_read_default_ami_list(c)?
      "SupportedTierList" => out.supported_tier_list = xml_read_supported_tier_list(c)?
      "SupportedAddonList" => out.supported_addon_list = xml_read_supported_addon_list(c)?
      "PlatformLifecycleState" => out.platform_lifecycle_state = c.text()
      "PlatformBranchName" => out.platform_branch_name = c.text()
      "PlatformBranchLifecycleState" => out.platform_branch_lifecycle_state = c.text()
      _ => {}
    }
  }
  Ok(out)
}

