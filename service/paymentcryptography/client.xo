fn json_of_export_key_material(v: ExportKeyMaterial) -> json.Value {
  match v {
    Tr31KeyBlock(x) => json.Value.Object([("Tr31KeyBlock", json_of_export_tr31_key_block(x))])
    Tr34KeyBlock(x) => json.Value.Object([("Tr34KeyBlock", json_of_export_tr34_key_block(x))])
    KeyCryptogram(x) => json.Value.Object([("KeyCryptogram", json_of_export_key_cryptogram(x))])
    DiffieHellmanTr31KeyBlock(x) => json.Value.Object([("DiffieHellmanTr31KeyBlock", json_of_export_diffie_hellman_tr31_key_block(x))])
    As2805KeyCryptogram(x) => json.Value.Object([("As2805KeyCryptogram", json_of_export_as2805_key_cryptogram(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_export_key_material(v: json.Value) -> ExportKeyMaterial ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Tr31KeyBlock" => Ok(ExportKeyMaterial.Tr31KeyBlock(from_json_export_tr31_key_block(fv)?))
      "Tr34KeyBlock" => Ok(ExportKeyMaterial.Tr34KeyBlock(from_json_export_tr34_key_block(fv)?))
      "KeyCryptogram" => Ok(ExportKeyMaterial.KeyCryptogram(from_json_export_key_cryptogram(fv)?))
      "DiffieHellmanTr31KeyBlock" => Ok(ExportKeyMaterial.DiffieHellmanTr31KeyBlock(from_json_export_diffie_hellman_tr31_key_block(fv)?))
      "As2805KeyCryptogram" => Ok(ExportKeyMaterial.As2805KeyCryptogram(from_json_export_as2805_key_cryptogram(fv)?))
      _ => Ok(ExportKeyMaterial.Unknown(k))
    }
  }
  Err("ExportKeyMaterial: no member set")
}

