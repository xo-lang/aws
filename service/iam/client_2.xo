fn read_error_account_not_management_or_delegated_administrator_exception(resp: http.Response, body: xml.Element) -> AccountNotManagementOrDelegatedAdministratorException ! Str {
  let _ = (resp, body)
  var out = AccountNotManagementOrDelegatedAdministratorException{}
  for c in xmlv.elements(body) {
    match c.name.local.to_lower() {
      "message" => out.message = c.text()
      _ => {}
    }
  }
  Ok(out)
}

