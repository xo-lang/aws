fn json_of_import_key_material(v: ImportKeyMaterial) -> json.Value {
  match v {
    RootCertificatePublicKey(x) => json.Value.Object([("RootCertificatePublicKey", json_of_root_certificate_public_key(x))])
    TrustedCertificatePublicKey(x) => json.Value.Object([("TrustedCertificatePublicKey", json_of_trusted_certificate_public_key(x))])
    Tr31KeyBlock(x) => json.Value.Object([("Tr31KeyBlock", json_of_import_tr31_key_block(x))])
    Tr34KeyBlock(x) => json.Value.Object([("Tr34KeyBlock", json_of_import_tr34_key_block(x))])
    KeyCryptogram(x) => json.Value.Object([("KeyCryptogram", json_of_import_key_cryptogram(x))])
    DiffieHellmanTr31KeyBlock(x) => json.Value.Object([("DiffieHellmanTr31KeyBlock", json_of_import_diffie_hellman_tr31_key_block(x))])
    As2805KeyCryptogram(x) => json.Value.Object([("As2805KeyCryptogram", json_of_import_as2805_key_cryptogram(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_import_key_material(v: json.Value) -> ImportKeyMaterial ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "RootCertificatePublicKey" => Ok(ImportKeyMaterial.RootCertificatePublicKey(from_json_root_certificate_public_key(fv)?))
      "TrustedCertificatePublicKey" => Ok(ImportKeyMaterial.TrustedCertificatePublicKey(from_json_trusted_certificate_public_key(fv)?))
      "Tr31KeyBlock" => Ok(ImportKeyMaterial.Tr31KeyBlock(from_json_import_tr31_key_block(fv)?))
      "Tr34KeyBlock" => Ok(ImportKeyMaterial.Tr34KeyBlock(from_json_import_tr34_key_block(fv)?))
      "KeyCryptogram" => Ok(ImportKeyMaterial.KeyCryptogram(from_json_import_key_cryptogram(fv)?))
      "DiffieHellmanTr31KeyBlock" => Ok(ImportKeyMaterial.DiffieHellmanTr31KeyBlock(from_json_import_diffie_hellman_tr31_key_block(fv)?))
      "As2805KeyCryptogram" => Ok(ImportKeyMaterial.As2805KeyCryptogram(from_json_import_as2805_key_cryptogram(fv)?))
      _ => Ok(ImportKeyMaterial.Unknown(k))
    }
  }
  Err("ImportKeyMaterial: no member set")
}

