/// Waits for the function's State to be Active. This waiter uses
/// GetFunction API. This should be used after new function creation.
///
/// Calls GetFunction until the FunctionActiveV2 acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (1s) to `max_delay` (300s).
pub fn wait_until_function_active_v2(c: Client, input: GetFunctionRequest, max_wait: Duration, min_delay: Duration = 1s, max_delay: Duration = 300s) -> () ! waiter.WaitErr[GetFunctionErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_function(input) {
      Ok(out) => {
        let o = jmes_of_get_function_response(out)
        if state == "" && waiter.path_matches(o, "Configuration.State", "stringEquals", "Active") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Configuration.State", "stringEquals", "Failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "Configuration.State", "stringEquals", "Pending") {
          state = "retry"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("FunctionActiveV2: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls GetFunction until the FunctionExists acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (1s) to `max_delay` (20s).
pub fn wait_until_function_exists(c: Client, input: GetFunctionRequest, max_wait: Duration, min_delay: Duration = 1s, max_delay: Duration = 20s) -> () ! waiter.WaitErr[GetFunctionErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_function(input) {
      Ok(_) => {
        if state == "" && true {
          state = "success"
        }
      }
      Err(e) => {
        let names = waiter_error_names_get_function(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "retry"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("FunctionExists: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

