fn json_of_event(v: Event) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("arn", json.Value.Str(x)))
  }
  if let Some(x) = v.service {
    fs.push(("service", json.Value.Str(x)))
  }
  if let Some(x) = v.event_type_code {
    fs.push(("eventTypeCode", json.Value.Str(x)))
  }
  if let Some(x) = v.event_type_category {
    fs.push(("eventTypeCategory", json.Value.Str(x.value())))
  }
  if let Some(x) = v.region {
    fs.push(("region", json.Value.Str(x)))
  }
  if let Some(x) = v.availability_zone {
    fs.push(("availabilityZone", json.Value.Str(x)))
  }
  if let Some(x) = v.start_time {
    fs.push(("startTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.end_time {
    fs.push(("endTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_updated_time {
    fs.push(("lastUpdatedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.status_code {
    fs.push(("statusCode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.event_scope_code {
    fs.push(("eventScopeCode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.actionability {
    fs.push(("actionability", json.Value.Str(x.value())))
  }
  if let Some(x) = v.personas {
    fs.push(("personas", json_of_event_persona_list(x)))
  }
  json.Value.Object(fs)
}

fn from_json_event(v: json.Value) -> Event ! Str {
  var out = Event{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "arn" => out.arn = jsonv.read_str(fv)?
      "service" => out.service = jsonv.read_str(fv)?
      "eventTypeCode" => out.event_type_code = jsonv.read_str(fv)?
      "eventTypeCategory" => out.event_type_category = EventTypeCategory.from(jsonv.read_str(fv)?)
      "region" => out.region = jsonv.read_str(fv)?
      "availabilityZone" => out.availability_zone = jsonv.read_str(fv)?
      "startTime" => out.start_time = jsonv.read_time(fv, "epoch-seconds")?
      "endTime" => out.end_time = jsonv.read_time(fv, "epoch-seconds")?
      "lastUpdatedTime" => out.last_updated_time = jsonv.read_time(fv, "epoch-seconds")?
      "statusCode" => out.status_code = EventStatusCode.from(jsonv.read_str(fv)?)
      "eventScopeCode" => out.event_scope_code = EventScopeCode.from(jsonv.read_str(fv)?)
      "actionability" => out.actionability = EventActionability.from(jsonv.read_str(fv)?)
      "personas" => out.personas = from_json_event_persona_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

