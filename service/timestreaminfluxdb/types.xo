  /// they are deleted when the number of snapshotted WAL files exceeds this
  /// number. Default: 300
  pub snapshotted_wal_files_to_keep: Int? = None
  /// Specifies the interval to prefetch into the Parquet cache during
  /// compaction. Default: 3d
  pub preemptive_cache_age: DurationShape? = None
  /// Specifies the percentage of entries to prune during a prune operation on
  /// the in-memory Parquet cache. Default: 0.1
  pub parquet_mem_cache_prune_percentage: Float32? = None
  /// Sets the interval to check if the in-memory Parquet cache needs to be
  /// pruned. Default: 1s
  pub parquet_mem_cache_prune_interval: DurationShape? = None
  /// Disables the in-memory Parquet cache. By default, the cache is enabled.
  pub disable_parquet_mem_cache: Bool? = None
  /// Specifies the time window for caching recent Parquet files in memory.
  /// Default: 5h
  pub parquet_mem_cache_query_path_duration: DurationShape? = None
  /// Specifies the interval to evict expired entries from the Last-N-Value
