    fs.push(("IsPartial", json.Value.Bool(x)))
  }
  if let Some(x) = v.http {
    fs.push(("Http", json_of_http(x)))
  }
  if let Some(x) = v.annotations {
    fs.push(("Annotations", json_of_annotations(x)))
  }
  if let Some(x) = v.users {
    fs.push(("Users", json_of_trace_users(x)))
  }
  if let Some(x) = v.service_ids {
    fs.push(("ServiceIds", json_of_service_ids(x)))
  }
  if let Some(x) = v.resource_arns {
    fs.push(("ResourceARNs", json_of_trace_resource_arns(x)))
  }
  if let Some(x) = v.instance_ids {
    fs.push(("InstanceIds", json_of_trace_instance_ids(x)))
  }
  if let Some(x) = v.availability_zones {
    fs.push(("AvailabilityZones", json_of_trace_availability_zones(x)))
  }
  if let Some(x) = v.entry_point {
    fs.push(("EntryPoint", json_of_service_id(x)))
  }
  if let Some(x) = v.fault_root_causes {
    fs.push(("FaultRootCauses", json_of_fault_root_causes(x)))
  }
  if let Some(x) = v.error_root_causes {
