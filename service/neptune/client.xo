fn xml_read_db_instance(e: xml.Element) -> DBInstance ! Str {
  var out = DBInstance{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DBInstanceIdentifier" => out.db_instance_identifier = c.text()
      "DBInstanceClass" => out.db_instance_class = c.text()
      "Engine" => out.engine = c.text()
      "DBInstanceStatus" => out.db_instance_status = c.text()
      "MasterUsername" => out.master_username = c.text()
      "DBName" => out.db_name = c.text()
      "Endpoint" => out.endpoint = xml_read_endpoint(c)?
      "AllocatedStorage" => out.allocated_storage = xmlv.read_int(c.text())?
      "InstanceCreateTime" => out.instance_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PreferredBackupWindow" => out.preferred_backup_window = c.text()
      "BackupRetentionPeriod" => out.backup_retention_period = xmlv.read_int(c.text())?
      "DBSecurityGroups" => out.db_security_groups = xml_read_db_security_group_membership_list(c)?
      "VpcSecurityGroups" => out.vpc_security_groups = xml_read_vpc_security_group_membership_list(c)?
      "DBParameterGroups" => out.db_parameter_groups = xml_read_db_parameter_group_status_list(c)?
      "AvailabilityZone" => out.availability_zone = c.text()
      "DBSubnetGroup" => out.db_subnet_group = xml_read_db_subnet_group(c)?
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "PendingModifiedValues" => out.pending_modified_values = xml_read_pending_modified_values(c)?
      "LatestRestorableTime" => out.latest_restorable_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MultiAZ" => out.multi_az = xmlv.read_bool(c.text())?
      "EngineVersion" => out.engine_version = c.text()
      "AutoMinorVersionUpgrade" => out.auto_minor_version_upgrade = xmlv.read_bool(c.text())?
      "ReadReplicaSourceDBInstanceIdentifier" => out.read_replica_source_db_instance_identifier = c.text()
      "ReadReplicaDBInstanceIdentifiers" => out.read_replica_db_instance_identifiers = xml_read_read_replica_db_instance_identifier_list(c)?
      "ReadReplicaDBClusterIdentifiers" => out.read_replica_db_cluster_identifiers = xml_read_read_replica_db_cluster_identifier_list(c)?
      "LicenseModel" => out.license_model = c.text()
      "Iops" => out.iops = xmlv.read_int(c.text())?
      "OptionGroupMemberships" => out.option_group_memberships = xml_read_option_group_membership_list(c)?
      "CharacterSetName" => out.character_set_name = c.text()
      "SecondaryAvailabilityZone" => out.secondary_availability_zone = c.text()
      "PubliclyAccessible" => out.publicly_accessible = xmlv.read_bool(c.text())?
      "StatusInfos" => out.status_infos = xml_read_db_instance_status_info_list(c)?
      "StorageType" => out.storage_type = c.text()
      "TdeCredentialArn" => out.tde_credential_arn = c.text()
      "DbInstancePort" => out.db_instance_port = xmlv.read_int(c.text())?
      "DBClusterIdentifier" => out.db_cluster_identifier = c.text()
      "StorageEncrypted" => out.storage_encrypted = xmlv.read_bool(c.text())?
      "KmsKeyId" => out.kms_key_id = c.text()
      "DbiResourceId" => out.dbi_resource_id = c.text()
      "CACertificateIdentifier" => out.ca_certificate_identifier = c.text()
      "DomainMemberships" => out.domain_memberships = xml_read_domain_membership_list(c)?
      "CopyTagsToSnapshot" => out.copy_tags_to_snapshot = xmlv.read_bool(c.text())?
      "MonitoringInterval" => out.monitoring_interval = xmlv.read_int(c.text())?
      "EnhancedMonitoringResourceArn" => out.enhanced_monitoring_resource_arn = c.text()
      "MonitoringRoleArn" => out.monitoring_role_arn = c.text()
      "PromotionTier" => out.promotion_tier = xmlv.read_int(c.text())?
      "DBInstanceArn" => out.db_instance_arn = c.text()
      "Timezone" => out.timezone = c.text()
      "IAMDatabaseAuthenticationEnabled" => out.iam_database_authentication_enabled = xmlv.read_bool(c.text())?
      "PerformanceInsightsEnabled" => out.performance_insights_enabled = xmlv.read_bool(c.text())?
      "PerformanceInsightsKMSKeyId" => out.performance_insights_kms_key_id = c.text()
      "EnabledCloudwatchLogsExports" => out.enabled_cloudwatch_logs_exports = xml_read_log_type_list(c)?
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "NetworkType" => out.network_type = c.text()
      _ => {}
    }
  }
  Ok(out)
}

