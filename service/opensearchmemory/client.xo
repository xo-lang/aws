      "actorId" => out.actor_id = jsonv.read_str(fv)?
      "sessionId" => out.session_id = jsonv.read_str(fv)?
      "payload" => out.payload = from_json_event_payload(fv)?
      "metadata" => out.metadata = from_json_metadata_map(fv)?
      "eventTimestamp" => out.event_timestamp = jsonv.read_time(fv, "date-time")?
      _ => {}
    }
