fn json_of_reasoning_content_block(v: ReasoningContentBlock) -> json.Value {
  match v {
    ReasoningText(x) => json.Value.Object([("reasoningText", json_of_reasoning_text_block(x))])
    RedactedContent(x) => json.Value.Object([("redactedContent", jsonv.blob(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_reasoning_content_block(v: json.Value) -> ReasoningContentBlock ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "reasoningText" => Ok(ReasoningContentBlock.ReasoningText(from_json_reasoning_text_block(fv)?))
      "redactedContent" => Ok(ReasoningContentBlock.RedactedContent(jsonv.read_blob(fv)?))
      _ => Ok(ReasoningContentBlock.Unknown(k))
    }
  }
  Err("ReasoningContentBlock: no member set")
}

