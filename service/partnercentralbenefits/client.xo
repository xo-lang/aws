fn json_of_fulfillment_details(v: FulfillmentDetails) -> json.Value {
  match v {
    DisbursementDetails(x) => json.Value.Object([("DisbursementDetails", json_of_disbursement_details(x))])
    ConsumableDetails(x) => json.Value.Object([("ConsumableDetails", json_of_consumable_details(x))])
    CreditDetails(x) => json.Value.Object([("CreditDetails", json_of_credit_details(x))])
    AccessDetails(x) => json.Value.Object([("AccessDetails", json_of_access_details(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_fulfillment_details(v: json.Value) -> FulfillmentDetails ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "DisbursementDetails" => Ok(FulfillmentDetails.DisbursementDetails(from_json_disbursement_details(fv)?))
      "ConsumableDetails" => Ok(FulfillmentDetails.ConsumableDetails(from_json_consumable_details(fv)?))
      "CreditDetails" => Ok(FulfillmentDetails.CreditDetails(from_json_credit_details(fv)?))
      "AccessDetails" => Ok(FulfillmentDetails.AccessDetails(from_json_access_details(fv)?))
      _ => Ok(FulfillmentDetails.Unknown(k))
    }
  }
  Err("FulfillmentDetails: no member set")
}

