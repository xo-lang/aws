/// Retrieves the definitions of some or all of the tables in a given
/// Database .
pub fn (c: Client) get_tables(input: GetTablesRequest) -> GetTablesResponse ! GetTablesErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_get_tables(c.params, input)) ?? e => return Err(GetTablesErr.InvalidInput(e))
  var req = serialize_get_tables(ep, input, "") ?? e => return Err(GetTablesErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(GetTablesErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_get_tables_error(resp))
  }
  deserialize_get_tables(resp) ?? e => Err(GetTablesErr.Deserialize(e))
}

