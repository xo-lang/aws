pub struct UntagResourceRequest {
  /// The Amazon Resource Name (ARN) of the resource from which you want to
  /// remove tags.
  pub resource_arn: Str? = None
  /// The keys of the tags that you want to remove from the resource.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

pub struct UpdateConnectorRequest {
  /// The target capacity.
  pub capacity: CapacityUpdate? = None
  /// A map of keys to values that represent the configuration for the
  /// connector.
  pub connector_configuration: Map[Str, Str]? = None
  /// Specifies whether the update bypasses connector-level and task-level
  /// health checks. If true , the update skips the health checks. The update
  /// stays in effect even if the connector or its tasks are unhealthy, and
  /// Amazon MSK Connect doesn't roll it back. If false or not specified, the
  /// health checks run. If they fail, MSK Connect automatically rolls the
  /// connector back to its previous configuration, and the update doesn't
  /// take effect. To update a connector that is in the PAUSED state, you must
  /// set this parameter to true .
  pub skip_health_validation: Bool? = None
  /// The Amazon Resource Name (ARN) of the connector that you want to update.
  pub connector_arn: Str? = None
  /// The current version of the connector that you want to update.
  pub current_version: Str? = None
  /// Amazon MSK Connect does not currently support specifying multiple
  /// plugins as a list. To use more than one plugin for your connector, you
  /// can create a single custom plugin using a ZIP file that bundles multiple
  /// plugins together. Specifies which plugin to use for the connector. You
  /// must specify a single-element list containing one customPlugin object.
  /// If you don't specify this parameter, the connector keeps its current
  /// plugin.
  pub plugins: List[PluginUpdate]? = None
  /// The worker configuration to use with the connector. Specify the Amazon
  /// Resource Name (ARN) and the revision of the worker configuration. You
  /// can't specify both workerConfiguration and useDefaultWorkerConfiguration
  /// in the same request. If you specify neither parameter, the connector
  /// keeps its current worker configuration.
  pub worker_configuration: WorkerConfigurationUpdate? = None
  /// Specifies whether to switch the connector to the default worker
  /// configuration that Amazon MSK Connect provides. If true , the connector
  /// stops using its custom worker configuration and uses the default worker
  /// configuration instead. If false or not specified, the connector keeps
  /// its current worker configuration. You can't specify both
  /// useDefaultWorkerConfiguration and workerConfiguration in the same
  /// request.
  pub use_default_worker_configuration: Bool? = None
}

pub struct UpdateConnectorResponse {
  /// The Amazon Resource Name (ARN) of the connector.
  pub connector_arn: Str? = None
  /// The state of the connector.
  pub connector_state: Str? = None
  /// The Amazon Resource Name (ARN) of the connector operation.
  pub connector_operation_arn: Str? = None
}

/// Information about the VPC in which the connector resides.
pub struct Vpc {
  /// The security groups for the connector.
  pub security_groups: List[Str]? = None
  /// The subnets for the connector.
  pub subnets: List[Str]? = None
}

/// The description of the VPC in which the connector resides.
pub struct VpcDescription {
  /// The security groups for the connector.
  pub security_groups: List[Str]? = None
  /// The subnets for the connector.
  pub subnets: List[Str]? = None
}

/// The configuration of the workers, which are the processes that run the
/// connector logic.
pub struct WorkerConfiguration {
  /// The revision of the worker configuration.
  pub revision: Int? = None
  /// The Amazon Resource Name (ARN) of the worker configuration.
  pub worker_configuration_arn: Str? = None
}

/// The description of the worker configuration.
pub struct WorkerConfigurationDescription {
  /// The revision of the worker configuration.
  pub revision: Int? = None
  /// The Amazon Resource Name (ARN) of the worker configuration.
  pub worker_configuration_arn: Str? = None
}

/// The description of the worker configuration revision.
pub struct WorkerConfigurationRevisionDescription {
  /// The time that the worker configuration was created.
  pub creation_time: Time? = None
  /// The description of the worker configuration revision.
  pub description: Str? = None
  /// Base64 encoded contents of the connect-distributed.properties file.
  pub properties_file_content: Str? = None
  /// The description of a revision of the worker configuration.
  pub revision: Int? = None
}

/// The summary of a worker configuration revision.
pub struct WorkerConfigurationRevisionSummary {
  /// The time that a worker configuration revision was created.
  pub creation_time: Time? = None
  /// The description of a worker configuration revision.
  pub description: Str? = None
  /// The revision of a worker configuration.
  pub revision: Int? = None
}

/// The summary of a worker configuration.
pub struct WorkerConfigurationSummary {
  /// The time that a worker configuration was created.
  pub creation_time: Time? = None
  /// The description of a worker configuration.
  pub description: Str? = None
  /// The latest revision of a worker configuration.
  pub latest_revision: WorkerConfigurationRevisionSummary? = None
  /// The name of the worker configuration.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the worker configuration.
  pub worker_configuration_arn: Str? = None
  /// The state of the worker configuration.
  pub worker_configuration_state: Str? = None
}

/// The worker configuration to use when you update a connector via
/// UpdateConnector .
pub struct WorkerConfigurationUpdate {
  /// The revision of the worker configuration.
  pub revision: Int? = None
  /// The Amazon Resource Name (ARN) of the worker configuration.
  pub worker_configuration_arn: Str? = None
}

/// Workers can send worker logs to different destination types. This
/// configuration specifies the details of these destinations.
pub struct WorkerLogDelivery {
  /// Details about delivering logs to Amazon CloudWatch Logs.
  pub cloud_watch_logs: CloudWatchLogsLogDelivery? = None
  /// Details about delivering logs to Amazon Kinesis Data Firehose.
  pub firehose: FirehoseLogDelivery? = None
  /// Details about delivering logs to Amazon S3.
  pub s3: S3LogDelivery? = None
}

/// Workers can send worker logs to different destination types. This
/// configuration specifies the details of these destinations.
pub struct WorkerLogDeliveryDescription {
  /// Details about delivering logs to Amazon CloudWatch Logs.
  pub cloud_watch_logs: CloudWatchLogsLogDeliveryDescription? = None
  /// Details about delivering logs to Amazon Kinesis Data Firehose.
  pub firehose: FirehoseLogDeliveryDescription? = None
  /// Details about delivering logs to Amazon S3.
  pub s3: S3LogDeliveryDescription? = None
}

/// Details about worker setting of a connector
pub struct WorkerSetting {
  /// Specifies the compute capacity settings of the connector.
  pub capacity: CapacityDescription? = None
  /// Specifies which plugins the connector uses.
  pub plugins: List[PluginDescription]? = None
  /// Specifies which worker configuration the connector uses.
  pub worker_configuration: WorkerConfigurationDescription? = None
  /// Specifies whether the connector uses the default worker configuration
  /// instead of a custom worker configuration.
  pub use_default_worker_configuration: Bool? = None
}
