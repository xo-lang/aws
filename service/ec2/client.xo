  }
  xmlv.end(w, name)
}

fn xml_read_import_volume_request(e: xml.Element) -> ImportVolumeRequest ! Str {
  var out = ImportVolumeRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "AvailabilityZoneId" => out.availability_zone_id = c.text()
      "dryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "availabilityZone" => out.availability_zone = c.text()
      "image" => out.image = xml_read_disk_image_detail(c)?
      "description" => out.description = c.text()
      "volume" => out.volume = xml_read_volume_detail(c)?
      _ => {}
    }
  }
  Ok(out)
}

