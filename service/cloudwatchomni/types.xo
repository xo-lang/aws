  /// Reason for the current space status.
  pub status_reason: Str? = None
  /// How the space's data at rest is encrypted. Always populated: a space
  /// with no customer managed key reports `encryptionStrategy` AWS_OWNED and
  /// no `kmsKeyArn`.
  pub encryption_configuration: EncryptionConfiguration? = None
}

