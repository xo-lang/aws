      "Tags" => out.tags = from_json_tags(fv)?
      "VolumeId" => out.volume_id = jsonv.read_str(fv)?
      "VolumeType" => out.volume_type = VolumeType.from(jsonv.read_str(fv)?)
      "LifecycleTransitionReason" => out.lifecycle_transition_reason = from_json_lifecycle_transition_reason(fv)?
      "AdministrativeActions" => out.administrative_actions = from_json_administrative_actions(fv)?
      "OpenZFSConfiguration" => out.open_zfs_configuration = from_json_open_zfs_volume_configuration(fv)?
      _ => {}
    }
  }
  Ok(out)
}

