/// Represents a resilience finding from a failure mode assessment.
pub struct Finding {
  /// The unique identifier of the finding.
  pub finding_id: Str? = None
  /// The name of the finding.
  pub name: Str? = None
  pub description: Str? = None
  /// The failure category of the finding.
  pub failure_category: FailureCategory? = None
  /// The current status of the finding.
  pub status: FindingStatus? = None
  /// The reasoning behind the finding.
  pub reasoning: Str? = None
  /// A user-provided comment about the finding.
  pub comment: Str? = None
  /// The severity of the finding.
  pub severity: FindingSeverity? = None
  /// The service functions associated with the finding.
  pub service_functions: List[Str]? = None
  /// The policy component associated with the finding.
  pub policy_component: PolicyComponent? = None
  /// Infrastructure and code recommendations to address the finding.
  pub infrastructure_and_code_recommendations: List[InfrastructureAndCodeRecommendation]? = None
  /// Observability recommendations to address the finding.
  pub observability_recommendations: List[ObservabilityRecommendation]? = None
  /// Testing recommendations to address the finding.
  pub testing_recommendations: List[TestingRecommendation]? = None
  /// The timestamp when the finding was last updated.
  pub updated_at: Time? = None
  /// A deep link to an interactive DevOps Agent investigation seeded with
  /// this finding. This value is null until DevOps Agent creates an
  /// investigation.
  pub investigation_deep_link: Str? = None
}

pub enum FindingSeverity: Str {
  Low = "LOW"
  Medium = "MEDIUM"
  High = "HIGH"
  Unknown(value: Str)
}

pub enum FindingStatus: Str {
  Open = "OPEN"
  Resolved = "RESOLVED"
  Irrelevant = "IRRELEVANT"
  Unknown(value: Str)
}

