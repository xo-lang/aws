  var out = EventSubscription{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "CustomerAwsId" => out.customer_aws_id = c.text()
      "CustSubscriptionId" => out.cust_subscription_id = c.text()
      "SnsTopicArn" => out.sns_topic_arn = c.text()
      "Status" => out.status = c.text()
      "SubscriptionCreationTime" => out.subscription_creation_time = c.text()
      "SourceType" => out.source_type = c.text()
      "SourceIdsList" => out.source_ids_list = xml_read_source_ids_list(c)?
      "EventCategoriesList" => out.event_categories_list = xml_read_event_categories_list(c)?
      "Enabled" => out.enabled = xmlv.read_bool(c.text())?
      "EventSubscriptionArn" => out.event_subscription_arn = c.text()
      _ => {}
    }
  }
  Ok(out)
