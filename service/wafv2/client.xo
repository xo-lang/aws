      "IPSetReferenceStatement" => out.ip_set_reference_statement = from_json_ip_set_reference_statement(fv)?
      "RegexPatternSetReferenceStatement" => out.regex_pattern_set_reference_statement = from_json_regex_pattern_set_reference_statement(fv)?
      "RateBasedStatement" => out.rate_based_statement = from_json_rate_based_statement(fv)?
      "AndStatement" => out.and_statement = from_json_and_statement(fv)?
      "OrStatement" => out.or_statement = from_json_or_statement(fv)?
      "NotStatement" => out.not_statement = from_json_not_statement(fv)?
      "ManagedRuleGroupStatement" => out.managed_rule_group_statement = from_json_managed_rule_group_statement(fv)?
      "LabelMatchStatement" => out.label_match_statement = from_json_label_match_statement(fv)?
      "RegexMatchStatement" => out.regex_match_statement = from_json_regex_match_statement(fv)?
