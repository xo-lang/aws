pub fn serialize_amend_benefit_application(ep: rest.Endpoint, input: AmendBenefitApplicationInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.catalog {
    fs.push(("Catalog", json.Value.Str(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("ClientToken", json.Value.Str(x)))
  }
  if let Some(x) = input.revision {
    fs.push(("Revision", json.Value.Str(x)))
  }
  if let Some(x) = input.identifier {
    fs.push(("Identifier", json.Value.Str(x)))
  }
  if let Some(x) = input.amendment_reason {
    fs.push(("AmendmentReason", json.Value.Str(x)))
  }
  if let Some(x) = input.amendments {
    fs.push(("Amendments", json_of_amendment_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.0"))
  headers.push(("X-Amz-Target", "PartnerCentralBenefitsService.AmendBenefitApplication"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

