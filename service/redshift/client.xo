fn xml_write_logging_status(var w: xmlv.Writer, v: LoggingStatus, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.logging_enabled {
    xmlv.elem(w, "LoggingEnabled", "${x}", [])
  }
  if let Some(x) = v.bucket_name {
    xmlv.elem(w, "BucketName", x, [])
  }
  if let Some(x) = v.s3_key_prefix {
    xmlv.elem(w, "S3KeyPrefix", x, [])
  }
  if let Some(x) = v.last_successful_delivery_time {
    xmlv.elem(w, "LastSuccessfulDeliveryTime", rest.date_time(x), [])
  }
  if let Some(x) = v.last_failure_time {
    xmlv.elem(w, "LastFailureTime", rest.date_time(x), [])
  }
  if let Some(x) = v.last_failure_message {
    xmlv.elem(w, "LastFailureMessage", x, [])
  }
  if let Some(x) = v.log_destination_type {
