fn from_json_code_gen_configuration_node(v: json.Value) -> CodeGenConfigurationNode ! Str {
  var out = CodeGenConfigurationNode{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "AthenaConnectorSource" => out.athena_connector_source = from_json_athena_connector_source(fv)?
      "JDBCConnectorSource" => out.jdbc_connector_source = from_json_jdbc_connector_source(fv)?
      "SparkConnectorSource" => out.spark_connector_source = from_json_spark_connector_source(fv)?
      "CatalogSource" => out.catalog_source = from_json_catalog_source(fv)?
      "RedshiftSource" => out.redshift_source = from_json_redshift_source(fv)?
      "S3CatalogSource" => out.s3_catalog_source = from_json_s3_catalog_source(fv)?
      "S3CsvSource" => out.s3_csv_source = from_json_s3_csv_source(fv)?
      "S3JsonSource" => out.s3_json_source = from_json_s3_json_source(fv)?
      "S3ParquetSource" => out.s3_parquet_source = from_json_s3_parquet_source(fv)?
      "RelationalCatalogSource" => out.relational_catalog_source = from_json_relational_catalog_source(fv)?
      "DynamoDBCatalogSource" => out.dynamo_db_catalog_source = from_json_dynamo_db_catalog_source(fv)?
      "JDBCConnectorTarget" => out.jdbc_connector_target = from_json_jdbc_connector_target(fv)?
      "SparkConnectorTarget" => out.spark_connector_target = from_json_spark_connector_target(fv)?
      "CatalogTarget" => out.catalog_target = from_json_basic_catalog_target(fv)?
      "RedshiftTarget" => out.redshift_target = from_json_redshift_target(fv)?
      "S3CatalogTarget" => out.s3_catalog_target = from_json_s3_catalog_target(fv)?
      "S3GlueParquetTarget" => out.s3_glue_parquet_target = from_json_s3_glue_parquet_target(fv)?
      "S3DirectTarget" => out.s3_direct_target = from_json_s3_direct_target(fv)?
      "ApplyMapping" => out.apply_mapping = from_json_apply_mapping(fv)?
      "SelectFields" => out.select_fields = from_json_select_fields(fv)?
      "DropFields" => out.drop_fields = from_json_drop_fields(fv)?
      "RenameField" => out.rename_field = from_json_rename_field(fv)?
      "Spigot" => out.spigot = from_json_spigot(fv)?
