fn from_json_windows_file_system_configuration(v: json.Value) -> WindowsFileSystemConfiguration ! Str {
  var out = WindowsFileSystemConfiguration{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
