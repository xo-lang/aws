  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "id" => out.id = jsonv.read_str(fv)?
      "domainId" => out.domain_id = jsonv.read_str(fv)?
      "owningProjectId" => out.owning_project_id = jsonv.read_str(fv)?
      "notebookId" => out.notebook_id = jsonv.read_str(fv)?
      "fileFormat" => out.file_format = FileFormat.from(jsonv.read_str(fv)?)
      "status" => out.status = NotebookExportStatus.from(jsonv.read_str(fv)?)
      "outputLocation" => out.output_location = from_json_output_location(fv)?
      "error" => out.error = from_json_notebook_export_error(fv)?
      "completedAt" => out.completed_at = jsonv.read_time(fv, "epoch-seconds")?
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "createdBy" => out.created_by = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_get_notebook_input(v: GetNotebookInput) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.domain_identifier {
    fs.push(("domainIdentifier", json.Value.Str(x)))
  }
  if let Some(x) = v.identifier {
    fs.push(("identifier", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

