  /// The short name or full Amazon Resource Name (ARN) of the cluster that
  /// hosts the container instance to update. If you do not specify a cluster,
  /// the default cluster is assumed.
  pub cluster: Str? = None
  /// A list of up to 10 container instance IDs or full ARN entries.
  pub container_instances: List[Str]? = None
  /// The container instance state to update the container instance with. The
  /// only valid values for this action are ACTIVE and DRAINING . A container
  /// instance can only be updated to DRAINING status once it has reached an
  /// ACTIVE state. If a container instance is in REGISTERING , DEREGISTERING
  /// , or REGISTRATION_FAILED state you can describe the container instance
  /// but can't update the container instance state.
  pub status: ContainerInstanceStatus? = None
}

