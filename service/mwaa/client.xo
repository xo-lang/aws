  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateEnvironmentErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_environment_error(resp))
  }
  deserialize_update_environment(resp) ?? e => Err(UpdateEnvironmentErr.Deserialize(e))
}
