  /// the action was received by Amazon Kendra.
  pub ordering_id: Int? = None
  /// The Amazon Resource Name (ARN) of an IAM role that has access to the S3
  /// file that contains your list of users that belong to a group. For more
  /// information, see IAM roles for Amazon Kendra .
  pub role_arn: Str? = None
}

