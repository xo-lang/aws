    AddSavingsPlanAction(x) => json.Value.Object([("addSavingsPlanAction", json_of_add_savings_plan_action(x))])
    NegateReservedInstanceAction(x) => json.Value.Object([("negateReservedInstanceAction", json_of_negate_reserved_instance_action(x))])
    NegateSavingsPlanAction(x) => json.Value.Object([("negateSavingsPlanAction", json_of_negate_savings_plan_action(x))])
