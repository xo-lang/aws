  }
  if let Some(x) = v.key {
    xmlv.elem(w, "Key", x, [])
  }
  if let Some(x) = v.part_number {
    xmlv.elem(w, "PartNumber", "${x}", [])
  }
  if let Some(x) = v.upload_id {
    xmlv.elem(w, "UploadId", x, [])
  }
  if let Some(x) = v.sse_customer_algorithm {
    xmlv.elem(w, "SSECustomerAlgorithm", x, [])
  }
  if let Some(x) = v.sse_customer_key {
    xmlv.elem(w, "SSECustomerKey", x, [])
  }
  if let Some(x) = v.sse_customer_key_md5 {
    xmlv.elem(w, "SSECustomerKeyMD5", x, [])
  }
  if let Some(x) = v.copy_source_sse_customer_algorithm {
    xmlv.elem(w, "CopySourceSSECustomerAlgorithm", x, [])
  }
  if let Some(x) = v.copy_source_sse_customer_key {
    xmlv.elem(w, "CopySourceSSECustomerKey", x, [])
  }
  if let Some(x) = v.copy_source_sse_customer_key_md5 {
    xmlv.elem(w, "CopySourceSSECustomerKeyMD5", x, [])
  }
