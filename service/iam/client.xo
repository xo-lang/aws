fn xml_write_policy_identifier(var w: xmlv.Writer, v: PolicyIdentifier, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    PolicyType(x) => {
      xmlv.elem(w, "PolicyType", x.value(), [])
    }
    PolicyArn(x) => {
      xmlv.elem(w, "PolicyArn", x, [])
    }
    InlinePolicyIdentifier(x) => {
      xml_write_inline_policy_identifier_type(w, x, "InlinePolicyIdentifier", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_policy_identifier(e: xml.Element) -> PolicyIdentifier ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "PolicyType" => Ok(PolicyIdentifier.PolicyType(PolicyIdentifierPolicyType.from(c.text())))
      "PolicyArn" => Ok(PolicyIdentifier.PolicyArn(c.text()))
      "InlinePolicyIdentifier" => Ok(PolicyIdentifier.InlinePolicyIdentifier(xml_read_inline_policy_identifier_type(c)?))
      _ => Ok(PolicyIdentifier.Unknown(c.name.local))
    }
  }
  Err("PolicyIdentifier: no member set")
}

