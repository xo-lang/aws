      "negateSavingsPlanAction" => Ok(BillScenarioCommitmentModificationAction.NegateSavingsPlanAction(from_json_negate_savings_plan_action(fv)?))
      _ => Ok(BillScenarioCommitmentModificationAction.Unknown(k))
    }
  }
  Err("BillScenarioCommitmentModificationAction: no member set")
}

