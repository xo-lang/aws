/// The HTTP request of ActivateEvaluationForm.
pub fn serialize_activate_evaluation_form(ep: rest.Endpoint, input: ActivateEvaluationFormRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_instance_id = match input.instance_id {
    Some(v) => v
    None => return Err("input member InstanceId is required")
  }
  if label_instance_id == "" {
    return Err("input member InstanceId must not be empty")
  }
  let label_evaluation_form_id = match input.evaluation_form_id {
    Some(v) => v
    None => return Err("input member EvaluationFormId is required")
  }
  if label_evaluation_form_id == "" {
    return Err("input member EvaluationFormId must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.evaluation_form_version {
    fs.push(("EvaluationFormVersion", json.Value.Int(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/evaluation-forms/${rest.escape(label_instance_id, false)}/${rest.escape(label_evaluation_form_id, false)}/activate"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
