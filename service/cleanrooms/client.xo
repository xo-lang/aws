fn json_of_query_constraint(v: QueryConstraint) -> json.Value {
  match v {
    RequireOverlap(x) => json.Value.Object([("requireOverlap", json_of_query_constraint_require_overlap(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_query_constraint(v: json.Value) -> QueryConstraint ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "requireOverlap" => Ok(QueryConstraint.RequireOverlap(from_json_query_constraint_require_overlap(fv)?))
      _ => Ok(QueryConstraint.Unknown(k))
    }
  }
  Err("QueryConstraint: no member set")
}

