  xmlv.end(w, name)
}

fn xml_read_condition(e: xml.Element) -> Condition ! Str {
  var out = Condition{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "HttpErrorCodeReturnedEquals" => out.http_error_code_returned_equals = c.text()
      "KeyPrefixEquals" => out.key_prefix_equals = c.text()
