  pub outpost_mode: OutpostMode? = None
  /// The outpost ARN in which the cache cluster is created.
  pub preferred_outpost_arn: Str? = None
  /// The outpost ARNs in which the cache cluster is created.
  pub preferred_outpost_arns: List[Str]? = None
  /// Specifies the destination, format and type of the logs.
  pub log_delivery_configurations: List[LogDeliveryConfigurationRequest]? = None
  /// A flag that enables in-transit encryption when set to true.
  pub transit_encryption_enabled: Bool? = None
  /// Must be either ipv4 | ipv6 | dual_stack . IPv6 is supported for
