fn xml_write_image_finding(var w: xmlv.Writer, v: ImageFinding, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.fix_available {
    xmlv.elem(w, "fixAvailable", "${x}", [])
  }
  if let Some(x) = v.score {
    xmlv.elem(w, "score", rest.float_text(x), [])
  }
  if let Some(x) = v.first_observed_at {
    xmlv.elem(w, "firstObservedAt", rest.date_time(x), [])
  }
  if let Some(x) = v.updated_at {
    xmlv.elem(w, "updatedAt", rest.date_time(x), [])
  }
  if let Some(x) = v.title {
    xmlv.elem(w, "title", x, [])
  }
  if let Some(x) = v.paths {
    xml_write_image_finding_path_set(w, x, "pathSet", [])
  }
  if let Some(x) = v.severity_label {
    xmlv.elem(w, "severityLabel", x.value(), [])
  }
  if let Some(x) = v.snapshot_id {
    xmlv.elem(w, "snapshotId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_image_finding(e: xml.Element) -> ImageFinding ! Str {
  var out = ImageFinding{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "fixAvailable" => out.fix_available = xmlv.read_bool(c.text())?
      "score" => out.score = xmlv.read_float(c.text())?
      "firstObservedAt" => out.first_observed_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "updatedAt" => out.updated_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "title" => out.title = c.text()
      "pathSet" => out.paths = xml_read_image_finding_path_set(c)?
      "severityLabel" => out.severity_label = SeverityLabel.from(c.text())
      "snapshotId" => out.snapshot_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

