fn json_of_statement(v: Statement) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.byte_match_statement {
    fs.push(("ByteMatchStatement", json_of_byte_match_statement(x)))
  }
  if let Some(x) = v.sqli_match_statement {
    fs.push(("SqliMatchStatement", json_of_sqli_match_statement(x)))
  }
  if let Some(x) = v.xss_match_statement {
    fs.push(("XssMatchStatement", json_of_xss_match_statement(x)))
  }
  if let Some(x) = v.size_constraint_statement {
    fs.push(("SizeConstraintStatement", json_of_size_constraint_statement(x)))
  }
  if let Some(x) = v.geo_match_statement {
    fs.push(("GeoMatchStatement", json_of_geo_match_statement(x)))
  }
  if let Some(x) = v.rule_group_reference_statement {
    fs.push(("RuleGroupReferenceStatement", json_of_rule_group_reference_statement(x)))
  }
  if let Some(x) = v.ip_set_reference_statement {
    fs.push(("IPSetReferenceStatement", json_of_ip_set_reference_statement(x)))
  }
  if let Some(x) = v.regex_pattern_set_reference_statement {
    fs.push(("RegexPatternSetReferenceStatement", json_of_regex_pattern_set_reference_statement(x)))
  }
  if let Some(x) = v.rate_based_statement {
    fs.push(("RateBasedStatement", json_of_rate_based_statement(x)))
  }
  if let Some(x) = v.and_statement {
    fs.push(("AndStatement", json_of_and_statement(x)))
  }
  if let Some(x) = v.or_statement {
    fs.push(("OrStatement", json_of_or_statement(x)))
  }
  if let Some(x) = v.not_statement {
    fs.push(("NotStatement", json_of_not_statement(x)))
  }
  if let Some(x) = v.managed_rule_group_statement {
    fs.push(("ManagedRuleGroupStatement", json_of_managed_rule_group_statement(x)))
  }
  if let Some(x) = v.label_match_statement {
    fs.push(("LabelMatchStatement", json_of_label_match_statement(x)))
  }
  if let Some(x) = v.regex_match_statement {
    fs.push(("RegexMatchStatement", json_of_regex_match_statement(x)))
  }
  if let Some(x) = v.asn_match_statement {
    fs.push(("AsnMatchStatement", json_of_asn_match_statement(x)))
  }
  json.Value.Object(fs)
}

fn from_json_statement(v: json.Value) -> Statement ! Str {
  var out = Statement{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
