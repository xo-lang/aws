fn json_of_hit(v: HIT) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.hit_id {
    fs.push(("HITId", json.Value.Str(x)))
  }
  if let Some(x) = v.hit_type_id {
    fs.push(("HITTypeId", json.Value.Str(x)))
  }
  if let Some(x) = v.hit_group_id {
    fs.push(("HITGroupId", json.Value.Str(x)))
  }
  if let Some(x) = v.hit_layout_id {
    fs.push(("HITLayoutId", json.Value.Str(x)))
  }
  if let Some(x) = v.creation_time {
    fs.push(("CreationTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.title {
    fs.push(("Title", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.question {
    fs.push(("Question", json.Value.Str(x)))
  }
  if let Some(x) = v.keywords {
    fs.push(("Keywords", json.Value.Str(x)))
  }
  if let Some(x) = v.hit_status {
    fs.push(("HITStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.max_assignments {
    fs.push(("MaxAssignments", json.Value.Int(x)))
  }
  if let Some(x) = v.reward {
    fs.push(("Reward", json.Value.Str(x)))
  }
  if let Some(x) = v.auto_approval_delay_in_seconds {
    fs.push(("AutoApprovalDelayInSeconds", json.Value.Int(x)))
  }
  if let Some(x) = v.expiration {
    fs.push(("Expiration", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.assignment_duration_in_seconds {
    fs.push(("AssignmentDurationInSeconds", json.Value.Int(x)))
  }
  if let Some(x) = v.requester_annotation {
    fs.push(("RequesterAnnotation", json.Value.Str(x)))
  }
  if let Some(x) = v.qualification_requirements {
    fs.push(("QualificationRequirements", json_of_qualification_requirement_list(x)))
  }
  if let Some(x) = v.hit_review_status {
    fs.push(("HITReviewStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.number_of_assignments_pending {
    fs.push(("NumberOfAssignmentsPending", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_assignments_available {
    fs.push(("NumberOfAssignmentsAvailable", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_assignments_completed {
    fs.push(("NumberOfAssignmentsCompleted", json.Value.Int(x)))
  }
  json.Value.Object(fs)
}

fn from_json_hit(v: json.Value) -> HIT ! Str {
  var out = HIT{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "HITId" => out.hit_id = jsonv.read_str(fv)?
      "HITTypeId" => out.hit_type_id = jsonv.read_str(fv)?
      "HITGroupId" => out.hit_group_id = jsonv.read_str(fv)?
