fn json_of_memories(v: List[Memory]) -> json.Value {
  json.Value.List(v.map(fn(x: Memory) -> json.Value { json_of_memory(x) }))
}

fn from_json_memories(v: json.Value) -> List[Memory] ! Str {
  var out: List[Memory] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_memory(fv)?)
  }
  Ok(out)
}

fn json_of_memory(v: Memory) -> json.Value {
  match v {
    SessionSummary(x) => json.Value.Object([("sessionSummary", json_of_memory_session_summary(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_memory(v: json.Value) -> Memory ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "sessionSummary" => Ok(Memory.SessionSummary(from_json_memory_session_summary(fv)?))
      _ => Ok(Memory.Unknown(k))
    }
  }
  Err("Memory: no member set")
}

fn json_of_memory_session_summary(v: MemorySessionSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.memory_id {
