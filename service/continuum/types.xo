/// The phase a failed scan was in when it failed. Present only on a FAILED
/// scan, and absent on one that failed before this field existed. Shares
/// its vocabulary with the non-terminal ScanStatus values so a failure
/// reads directly against the phase sequence, with no mapping.
pub enum ScanFailureStage: Str {
  Submitted = "SUBMITTED"
  WaitingForBuild = "WAITING_FOR_BUILD"
  Building = "BUILDING"
  WaitingForScan = "WAITING_FOR_SCAN"
  Scanning = "SCANNING"
  Unknown(value: Str)
}

/// Identifies why a scan run was created.
pub enum ScanOrigin: Str {
  Manual = "MANUAL"
  Scheduled = "SCHEDULED"
  Unknown(value: Str)
}

/// The phase of a scan. A scan always builds the selected source first and
/// then analyzes the verified result, so the phases below span both halves
/// of the work. These values are labels, not an ordered sequence for
/// clients to compare. A scan does not necessarily observe every phase —
/// phases are short-lived and a poll can miss one entirely.
pub enum ScanStatus: Str {
  Submitted = "SUBMITTED"
  WaitingForBuild = "WAITING_FOR_BUILD"
  Building = "BUILDING"
  WaitingForScan = "WAITING_FOR_SCAN"
  Scanning = "SCANNING"
  Succeeded = "SUCCEEDED"
  Failed = "FAILED"
  Unknown(value: Str)
}

