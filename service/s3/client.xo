fn xml_write_upload_part_copy_request(var w: xmlv.Writer, v: UploadPartCopyRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.bucket {
    xmlv.elem(w, "Bucket", x, [])
  }
  if let Some(x) = v.copy_source {
    xmlv.elem(w, "CopySource", x, [])
  }
  if let Some(x) = v.copy_source_if_match {
    xmlv.elem(w, "CopySourceIfMatch", x, [])
  }
  if let Some(x) = v.copy_source_if_modified_since {
    xmlv.elem(w, "CopySourceIfModifiedSince", rest.date_time(x), [])
  }
  if let Some(x) = v.copy_source_if_none_match {
    xmlv.elem(w, "CopySourceIfNoneMatch", x, [])
  }
  if let Some(x) = v.copy_source_if_unmodified_since {
    xmlv.elem(w, "CopySourceIfUnmodifiedSince", rest.date_time(x), [])
  }
  if let Some(x) = v.copy_source_range {
    xmlv.elem(w, "CopySourceRange", x, [])
  }
  if let Some(x) = v.key {
    xmlv.elem(w, "Key", x, [])
  }
  if let Some(x) = v.part_number {
    xmlv.elem(w, "PartNumber", "${x}", [])
  }
  if let Some(x) = v.upload_id {
    xmlv.elem(w, "UploadId", x, [])
  }
  if let Some(x) = v.sse_customer_algorithm {
    xmlv.elem(w, "SSECustomerAlgorithm", x, [])
  }
  if let Some(x) = v.sse_customer_key {
    xmlv.elem(w, "SSECustomerKey", x, [])
  }
  if let Some(x) = v.sse_customer_key_md5 {
    xmlv.elem(w, "SSECustomerKeyMD5", x, [])
  }
  if let Some(x) = v.copy_source_sse_customer_algorithm {
    xmlv.elem(w, "CopySourceSSECustomerAlgorithm", x, [])
  }
  if let Some(x) = v.copy_source_sse_customer_key {
    xmlv.elem(w, "CopySourceSSECustomerKey", x, [])
  }
  if let Some(x) = v.copy_source_sse_customer_key_md5 {
    xmlv.elem(w, "CopySourceSSECustomerKeyMD5", x, [])
  }
  if let Some(x) = v.request_payer {
    xmlv.elem(w, "RequestPayer", x.value(), [])
  }
  if let Some(x) = v.expected_bucket_owner {
    xmlv.elem(w, "ExpectedBucketOwner", x, [])
  }
  if let Some(x) = v.expected_source_bucket_owner {
    xmlv.elem(w, "ExpectedSourceBucketOwner", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_upload_part_copy_request(e: xml.Element) -> UploadPartCopyRequest ! Str {
  var out = UploadPartCopyRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Bucket" => out.bucket = c.text()
      "CopySource" => out.copy_source = c.text()
      "CopySourceIfMatch" => out.copy_source_if_match = c.text()
      "CopySourceIfModifiedSince" => out.copy_source_if_modified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "CopySourceIfNoneMatch" => out.copy_source_if_none_match = c.text()
      "CopySourceIfUnmodifiedSince" => out.copy_source_if_unmodified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "CopySourceRange" => out.copy_source_range = c.text()
      "Key" => out.key = c.text()
      "PartNumber" => out.part_number = xmlv.read_int(c.text())?
      "UploadId" => out.upload_id = c.text()
      "SSECustomerAlgorithm" => out.sse_customer_algorithm = c.text()
      "SSECustomerKey" => out.sse_customer_key = c.text()
      "SSECustomerKeyMD5" => out.sse_customer_key_md5 = c.text()
      "CopySourceSSECustomerAlgorithm" => out.copy_source_sse_customer_algorithm = c.text()
      "CopySourceSSECustomerKey" => out.copy_source_sse_customer_key = c.text()
      "CopySourceSSECustomerKeyMD5" => out.copy_source_sse_customer_key_md5 = c.text()
      "RequestPayer" => out.request_payer = RequestPayer.from(c.text())
      "ExpectedBucketOwner" => out.expected_bucket_owner = c.text()
      "ExpectedSourceBucketOwner" => out.expected_source_bucket_owner = c.text()
      _ => {}
    }
  }
  Ok(out)
}

