  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UpdateQuickResponseErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    PreconditionFailedException(x) => "PreconditionFailedException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_quick_response_error(resp: http.Response) -> UpdateQuickResponseErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return UpdateQuickResponseErr.AccessDeniedException(x)
      Err(msg) => return UpdateQuickResponseErr.Deserialize(msg)
    }
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UpdateQuickResponseErr.ConflictException(x)
      Err(msg) => return UpdateQuickResponseErr.Deserialize(msg)
    }
    "PreconditionFailedException" => match read_error_precondition_failed_exception(resp, body) {
      Ok(x) => return UpdateQuickResponseErr.PreconditionFailedException(x)
      Err(msg) => return UpdateQuickResponseErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateQuickResponseErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateQuickResponseErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateQuickResponseErr.ValidationException(x)
      Err(msg) => return UpdateQuickResponseErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateQuickResponseErr.Api(restjson.api_error(resp, body))
}

/// Updates an existing Wisdom quick response.
pub fn (c: Client) update_quick_response(input: UpdateQuickResponseRequest) -> UpdateQuickResponseResponse ! UpdateQuickResponseErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_quick_response(c.params, input)) ?? e => return Err(UpdateQuickResponseErr.InvalidInput(e))
  var req = serialize_update_quick_response(ep, input, "") ?? e => return Err(UpdateQuickResponseErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateQuickResponseErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_quick_response_error(resp))
  }
  deserialize_update_quick_response(resp) ?? e => Err(UpdateQuickResponseErr.Deserialize(e))
}
