pub struct KubernetesApiCallAction {
  /// The Kubernetes API request URI.
  pub request_uri: Str? = None
  /// The Kubernetes API request HTTP verb.
  pub verb: Str? = None
  /// The resource component in the Kubernetes API call action.
  pub resource: Str? = None
  /// The name of the sub-resource in the Kubernetes API call action.
  pub subresource: Str? = None
  /// The name of the namespace where the Kubernetes API call action takes
  /// place.
  pub namespace: Str? = None
  /// The name of the resource in the Kubernetes API call action.
  pub resource_name: Str? = None
  /// The IP of the Kubernetes API caller and the IPs of any proxies or load
  /// balancers between the caller and the API endpoint.
  pub source_ips: List[Str]? = None
  /// The user agent of the caller of the Kubernetes API.
  pub user_agent: Str? = None
  pub remote_ip_details: RemoteIpDetails? = None
  /// The resulting HTTP response code of the Kubernetes API call action.
  pub status_code: Int? = None
  /// Parameters related to the Kubernetes API call action.
  pub parameters: Str? = None
}

