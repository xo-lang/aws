  }
  if let Some(x) = v.recommended_resource_type {
    fs.push(("recommendedResourceType", json.Value.Str(x)))
  }
  if let Some(x) = v.estimated_monthly_savings {
    fs.push(("estimatedMonthlySavings", jsonv.float(x)))
  }
  if let Some(x) = v.estimated_savings_percentage {
    fs.push(("estimatedSavingsPercentage", jsonv.float(x)))
  }
  if let Some(x) = v.estimated_monthly_cost {
    fs.push(("estimatedMonthlyCost", jsonv.float(x)))
  }
  if let Some(x) = v.currency_code {
    fs.push(("currencyCode", json.Value.Str(x)))
  }
  if let Some(x) = v.implementation_effort {
    fs.push(("implementationEffort", json.Value.Str(x)))
  }
  if let Some(x) = v.restart_needed {
    fs.push(("restartNeeded", json.Value.Bool(x)))
  }
  if let Some(x) = v.action_type {
    fs.push(("actionType", json.Value.Str(x)))
  }
  if let Some(x) = v.rollback_possible {
    fs.push(("rollbackPossible", json.Value.Bool(x)))
  }
  if let Some(x) = v.current_resource_summary {
    fs.push(("currentResourceSummary", json.Value.Str(x)))
  }
  if let Some(x) = v.recommended_resource_summary {
    fs.push(("recommendedResourceSummary", json.Value.Str(x)))
  }
  if let Some(x) = v.last_refresh_timestamp {
    fs.push(("lastRefreshTimestamp", jsonv.time(x, "epoch-seconds")))
