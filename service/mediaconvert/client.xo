      "redPrimaryX" => out.red_primary_x = jsonv.read_int(fv)?
      "redPrimaryY" => out.red_primary_y = jsonv.read_int(fv)?
      "whitePointX" => out.white_point_x = jsonv.read_int(fv)?
      "whitePointY" => out.white_point_y = jsonv.read_int(fv)?
      _ => {}
    }
  }
  Ok(out)
}

