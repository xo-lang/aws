/// Thrown when you attempt to create more resources than the service allows
/// based on service quotas.
pub struct ServiceQuotaExceededException {
  /// Description of the error.
  pub message: Str? = None
  /// Identifier of the resource affected.
  pub resource_id: Str? = None
  /// Type of the resource affected.
  pub resource_type: Str? = None
  /// Service Quotas requirement to identify originating service.
  pub service_code: Str? = None
  /// Service Quotas requirement to identify originating quota.
  pub quota_code: Str? = None
}

/// S3 bucket configuration for SQS-driven ingestion. The scan mode controls
/// only the optional one-time delta scan of existing objects in this
/// bucket.
pub struct StreamBucketConfig {
  /// The name or Amazon Resource Name (ARN) of the Amazon S3 bucket to ingest
  /// data from.
  pub bucket: Str? = None
  /// The AWS account ID that owns the S3 bucket. Optional. If omitted, the
  /// control plane derives it from the account segment of sqsArn.
  pub bucket_owner_account_id: Str? = None
  /// Specifies whether to perform a one-time scan of the objects that already
  /// exist in the bucket before the stream begins processing Amazon S3 event
  /// notifications. If DISABLED , only new objects are ingested.
  pub initial_scan: Str? = None
}

/// A map of key-value pairs associated to an OpenSearch Serverless
/// resource.
pub struct Tag {
  /// The key to use in the tag.
  pub key: Str? = None
  /// The value of the tag.
  pub value: Str? = None
}

pub struct TagResourceRequest {
  /// The Amazon Resource Name (ARN) of the resource. The resource must be
  /// active (not in the DELETING state), and must be owned by the account ID
  /// included in the request.
  pub resource_arn: Str? = None
  /// A list of tags (key-value pairs) to add to the resource. All tag keys in
  /// the request must be unique.
  pub tags: List[Tag]? = None
}

pub struct TagResourceResponse {
}

pub struct UntagResourceRequest {
  /// The Amazon Resource Name (ARN) of the resource to remove tags from. The
  /// resource must be active (not in the DELETING state), and must be owned
  /// by the account ID included in the request.
  pub resource_arn: Str? = None
  /// The tag or set of tags to remove from the resource. All tag keys in the
  /// request must be unique.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

pub struct UpdateAccessPolicyRequest {
  /// The type of policy.
  pub type_value: Str? = None
  /// The name of the policy.
  pub name: Str? = None
  /// The version of the policy being updated.
  pub policy_version: Str? = None
  /// A description of the policy. Typically used to store information about
  /// the permissions defined in the policy.
  pub description: Str? = None
  /// The JSON policy document to use as the content for the policy.
