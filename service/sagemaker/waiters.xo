/// Calls DescribeEndpoint until the EndpointDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (1800s).
pub fn wait_until_endpoint_deleted(c: Client, input: DescribeEndpointInput, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 1800s) -> () ! waiter.WaitErr[DescribeEndpointErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_endpoint(input) {
      Ok(out) => {
        let o = jmes_of_describe_endpoint_output(out)
        if state == "" && waiter.path_matches(o, "EndpointStatus", "stringEquals", "Failed") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_endpoint(e)
        if state == "" && waiter.error_is(names, "ValidationException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("EndpointDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

