  /// 'PUBKEY_MSG_ACK' (to acknowledge the public key message).
  pub action_type: DataRetentionActionType? = None
}

pub struct UpdateDataRetentionResponse {
  /// A message indicating the result of the update operation.
  pub message: Str? = None
}

pub struct UpdateGuestUserRequest {
  /// The ID of the Wickr network where the guest user's status will be
  /// updated.
