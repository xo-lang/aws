    return match k {
      "protectedQueryInputParameters" => Ok(InputChannelDataSource.ProtectedQueryInputParameters(from_json_protected_query_input_parameters(fv)?))
      _ => Ok(InputChannelDataSource.Unknown(k))
    }
  }
  Err("InputChannelDataSource: no member set")
}

