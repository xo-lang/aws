    method: "DELETE",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/virtualclusters/${rest.escape(label_virtual_cluster_id, false)}/jobruns/${rest.escape(label_id, false)}"),
    query: rest.query(qs),
    headers: headers,
