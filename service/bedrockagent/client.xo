    IncompatibleConnectionDataType(x) => json.Value.Object([("incompatibleConnectionDataType", json_of_incompatible_connection_data_type_flow_validation_details(x))])
    MissingConnectionConfiguration(x) => json.Value.Object([("missingConnectionConfiguration", json_of_missing_connection_configuration_flow_validation_details(x))])
    MissingDefaultCondition(x) => json.Value.Object([("missingDefaultCondition", json_of_missing_default_condition_flow_validation_details(x))])
    MissingEndingNodes(x) => json.Value.Object([("missingEndingNodes", json_of_missing_ending_nodes_flow_validation_details(x))])
    MissingNodeConfiguration(x) => json.Value.Object([("missingNodeConfiguration", json_of_missing_node_configuration_flow_validation_details(x))])
    MissingNodeInput(x) => json.Value.Object([("missingNodeInput", json_of_missing_node_input_flow_validation_details(x))])
    MissingNodeOutput(x) => json.Value.Object([("missingNodeOutput", json_of_missing_node_output_flow_validation_details(x))])
    MissingStartingNodes(x) => json.Value.Object([("missingStartingNodes", json_of_missing_starting_nodes_flow_validation_details(x))])
