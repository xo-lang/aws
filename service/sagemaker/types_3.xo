/// The configuration for prefix-aware routing on a SageMaker real-time
/// inference endpoint. Specify PrefixLength and ConcurrencyThreshold to
/// control routing behavior.
pub struct PrefixAwareRoutingConfig {
  /// The maximum length of the prefix used for routing decisions. Required
  /// when RoutingStrategy is PREFIX_AWARE . For the SageMaker Runtime
  /// InvokeEndpoint and InvokeEndpointWithResponseStream APIs, this value
  /// specifies the number of bytes from the beginning of the request body.
  /// For OpenAI-compatible API, this value specifies the number of characters
  /// from the text content of the messages array. The endpoint routes
  /// requests that share the same prefix to the same instance and, when that
  /// instance hosts more than one copy of the invoked inference component, to
  /// the same copy. Set this value to cover shared content (such as system
  /// prompts) plus enough unique content to distribute workloads across
  /// instances and copies.
  pub prefix_length: Int? = None
  /// The number of in-flight requests on the selected instance or inference
  /// component copy at which the endpoint routes a request to another copy or
  /// instance. Required when RoutingStrategy is PREFIX_AWARE . On an endpoint
  /// without inference components, the endpoint compares this threshold with
  /// the number of in-flight requests on the selected instance. When that
  /// number reaches the threshold, the endpoint routes the request to another
  /// instance. On an endpoint with inference components, the endpoint
  /// compares this threshold with the number of in-flight requests on the
  /// selected copy of the invoked inference component. Requests to other
  /// inference components on the same instance don't count. When the instance
  /// hosts more than one copy of the inference component, the endpoint routes
  /// requests that share a prefix to the same copy and, while that copy has
  /// reached the threshold, to another copy on the instance that is under the
  /// threshold. When every copy on the instance has reached the threshold,
  /// the endpoint routes the request to another instance. The threshold
  /// applies to every instance and every copy of every inference component in
  /// the production variant, so choose a value that suits the instance or
  /// copy that can serve the fewest concurrent requests.
  pub concurrency_threshold: Int? = None
}

/// Configuration for accessing hub content through presigned URLs,
