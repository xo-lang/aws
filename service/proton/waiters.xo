/// Wait until an Service has deployed its instances and possibly pipeline.
/// Use this after invoking CreateService
///
/// Calls GetService until the ServiceCreated acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (4999s).
pub fn wait_until_service_created(c: Client, input: GetServiceInput, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 4999s) -> () ! waiter.WaitErr[GetServiceErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
