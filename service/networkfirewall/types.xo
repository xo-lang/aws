/// The object that defines an IPS engine rule group, for use in a Next
/// Generation policy. An IPS engine rule group provides threat-detection
/// rules that the IPS engine evaluates in the context of the traffic flow.
/// You provide the rules as a Suricata-compatible rule string. For more
/// information, see Rule groups for a firewall using a Next Generation
/// policy in the Network Firewall Developer Guide .
pub struct IpsRuleGroup {
  /// The stateful inspection criteria for the IPS engine rule group.
  pub rules_source: IpsRulesSource? = None
  /// Settings that are available for use in the rules in the IPS engine rule
  /// group.
  pub rule_variables: RuleVariables? = None
  /// The list of a rule group's reference sets.
  pub reference_sets: ReferenceSets? = None
}

/// A single entry in the IPS section of a Next Generation policy. An entry
/// either references an existing IPS engine rule group by ARN or embeds a
/// rule group directly in the policy. IPS section entries don't use a
/// priority.
pub struct IpsRuleGroupEntry {
  /// The Amazon Resource Name (ARN) of an existing IPS engine rule group to
  /// reference in this entry. Provide either ResourceArn to reference an
  /// existing rule group or InlineRuleGroup to embed a rule group in the
  /// policy.
  pub resource_arn: Str? = None
  /// An IPS engine rule group defined directly in the policy, instead of
  /// referenced by ARN. Provide either InlineRuleGroup to embed a rule group
  /// or ResourceArn to reference an existing rule group.
  pub inline_rule_group: IpsRuleGroup? = None
  /// The setting that allows the policy owner to change the behavior of the
  /// IPS engine rule group within this policy, such as changing a managed
  /// rule group's action from DROP to ALERT .
  pub override: IpsRuleGroupOverride? = None
}

/// The setting that allows the policy owner to change the behavior of an
/// IPS engine rule group within a Next Generation policy.
pub struct IpsRuleGroupOverride {
  /// The action that changes the rule group from DROP to ALERT . This only
  /// applies to managed rule groups.
  pub action: OverrideAction? = None
}

/// The source of the rules for an IPS engine rule group.
pub struct IpsRulesSource {
  /// IPS engine rules, provided as a single Suricata-compatible rule string.
  /// For the rule format, see Rules Format on the Suricata website.
