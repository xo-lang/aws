use std/http
use std/json

test "an error with no code shows the start of its body" {
  let resp = http.text(404, "<html>no such route</html>")
  let e = api_error(resp, json.Value.Null)
  expect(e.code) == "UnknownError"
  expect(e.message) == "<html>no such route</html>"
  expect(body_hint("x".repeat(300).bytes()).len()) == 203
  expect(body_hint(b"")) == ""
}
