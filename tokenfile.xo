// A token kept in a file that something else rotates: the EKS service
// account token of IRSA (AWS_WEB_IDENTITY_TOKEN_FILE) and of EKS Pod
// Identity (AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE).
//
// aws-sdk-go-v2 reads the file at every credentials refresh. Here a
// provider's `retrieve` has no file effect, so the file is read when it
// is loaded, and `watch`, run as a background task on a group that
// lives as long as the program (`os.tasks`), reads it again every few
// minutes. `config.load_default_config` lists the files it read in
// `Config.token_files`; `cfg.watch_token_files(os.tasks, os.fs, os.clock)`
// starts their watches.

use std/task

/// A token from a file; copies share the token.
pub struct TokenFile {
  pub path: Str
  token: Mutex[Secret[Str]]
}

/// Reads `path` now (surrounding white space dropped).
pub fn load_token_file(fs: Fs, path: Str) -> TokenFile ! Str uses fs.read {
  let t = read_token(fs, path)?
  Ok(TokenFile{path: path, token: Mutex.new(t)})
}

/// A token file holding `token`, for tests and for tokens from elsewhere.
pub fn fixed_token(token: Str) -> TokenFile {
  TokenFile{path: "", token: Mutex.new(Secret.new(token))}
}

/// The token as last read.
pub fn (t: TokenFile) get() -> Secret[Str] {
  t.token.with_read(fn(s: Secret[Str]) -> Secret[Str] { s })
}

/// Reads the file again; on an error the last token is kept and the
/// error returned.
pub fn (t: TokenFile) reload(fs: Fs) -> () ! Str uses fs.read {
  let s = read_token(fs, t.path)?
  t.token.reset(s)
  Ok(())
}

/// Reloads the file every `every` until cancelled. Run it as a
/// background task: `os.tasks.spawn_background(fn() { t.watch(os.fs,
/// os.clock) })`. A failed read keeps the last token (the file is being
/// replaced, or is briefly missing) and is tried again next time.
pub fn (t: TokenFile) watch(fs: Fs, clock: Clock, every: Duration = 5m) uses (fs.read, clock) {
  if t.path == "" {
    return
  }
  while true {
    clock.sleep(every)
    let _ = t.reload(fs).ignore_err("the last token is kept; the next pass reads the file again")
  }
}

/// Starts a watch of each of `c.token_files` on `tasks`, a group that
/// lives as long as the program (`os.tasks`). Long running programs on
/// EKS need it: the service account token rotates and expires (24 hours
/// by default). Lambda and short programs can leave it out.
pub fn (c: Config) watch_token_files(tasks: task.Group, fs: Fs, clock: Clock, every: Duration = 5m) uses (fs.read, clock) {
  for f in c.token_files {
    tasks.spawn_background(fn() { f.watch(fs, clock, every) })
  }
}

fn read_token(fs: Fs, path: Str) -> Secret[Str] ! Str uses fs.read {
  match fs.read_text(path) {
    Ok(s) => {
      let t = s.trim()
      if t == "" {
        return Err("${path} is empty")
      }
      Ok(Secret.new(t))
    }
    Err(e) => Err("${path}: ${e.display()}")
  }
}
