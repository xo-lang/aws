fn json_of_hsm(v: Hsm) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.availability_zone {
    fs.push(("AvailabilityZone", json.Value.Str(x)))
  }
  if let Some(x) = v.cluster_id {
    fs.push(("ClusterId", json.Value.Str(x)))
  }
  if let Some(x) = v.subnet_id {
    fs.push(("SubnetId", json.Value.Str(x)))
  }
  if let Some(x) = v.eni_id {
    fs.push(("EniId", json.Value.Str(x)))
  }
  if let Some(x) = v.eni_ip {
    fs.push(("EniIp", json.Value.Str(x)))
  }
  if let Some(x) = v.eni_ip_v6 {
    fs.push(("EniIpV6", json.Value.Str(x)))
  }
  if let Some(x) = v.hsm_id {
    fs.push(("HsmId", json.Value.Str(x)))
  }
  if let Some(x) = v.hsm_type {
    fs.push(("HsmType", json.Value.Str(x)))
  }
  if let Some(x) = v.state {
    fs.push(("State", json.Value.Str(x.value())))
  }
  if let Some(x) = v.state_message {
    fs.push(("StateMessage", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_hsm(v: json.Value) -> Hsm ! Str {
  var out = Hsm{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "AvailabilityZone" => out.availability_zone = jsonv.read_str(fv)?
      "ClusterId" => out.cluster_id = jsonv.read_str(fv)?
      "SubnetId" => out.subnet_id = jsonv.read_str(fv)?
      "EniId" => out.eni_id = jsonv.read_str(fv)?
      "EniIp" => out.eni_ip = jsonv.read_str(fv)?
      "EniIpV6" => out.eni_ip_v6 = jsonv.read_str(fv)?
      "HsmId" => out.hsm_id = jsonv.read_str(fv)?
      "HsmType" => out.hsm_type = jsonv.read_str(fv)?
      "State" => out.state = HsmState.from(jsonv.read_str(fv)?)
      "StateMessage" => out.state_message = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_hsms(v: List[Hsm]) -> json.Value {
  json.Value.List(v.map(fn(x: Hsm) -> json.Value { json_of_hsm(x) }))
