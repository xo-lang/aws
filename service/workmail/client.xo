  }
  if let Some(x) = v.state {
    fs.push(("State", json.Value.Str(x.value())))
  }
  if let Some(x) = v.enabled_date {
    fs.push(("EnabledDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.disabled_date {
    fs.push(("DisabledDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
