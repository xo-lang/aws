  var out = XmlNamespaceNested{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "foo" => out.foo = c.text()
      "values" => out.values = xml_read_xml_namespaced_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

