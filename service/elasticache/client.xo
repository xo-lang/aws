fn query_put_api_call_rate_for_customer_exceeded_fault(var f: query.Form, prefix: Str, v: APICallRateForCustomerExceededFault) {
  if let Some(x) = v.message {
    query.add(f, query.key(prefix, "message"), x)
  }
}

fn query_put_add_tags_to_resource_message(var f: query.Form, prefix: Str, v: AddTagsToResourceMessage) {
  if let Some(x) = v.resource_name {
    query.add(f, query.key(prefix, "ResourceName"), x)
  }
  if let Some(x) = v.tags {
    query_put_tag_list(f, query.key(prefix, "Tags"), x, false)
  }
}

fn query_put_allowed_node_type_modifications_message(var f: query.Form, prefix: Str, v: AllowedNodeTypeModificationsMessage) {
  if let Some(x) = v.scale_up_modifications {
    query_put_node_type_list(f, query.key(prefix, "ScaleUpModifications"), x, false)
  }
  if let Some(x) = v.scale_down_modifications {
    query_put_node_type_list(f, query.key(prefix, "ScaleDownModifications"), x, false)
  }
}

fn query_put_authentication(var f: query.Form, prefix: Str, v: Authentication) {
  if let Some(x) = v.type_value {
    query.add(f, query.key(prefix, "Type"), x.value())
  }
  if let Some(x) = v.password_count {
    query.add(f, query.key(prefix, "PasswordCount"), "${x}")
  }
}

fn query_put_authentication_mode(var f: query.Form, prefix: Str, v: AuthenticationMode) {
  if let Some(x) = v.type_value {
    query.add(f, query.key(prefix, "Type"), x.value())
  }
  if let Some(x) = v.passwords {
    query_put_password_list_input(f, query.key(prefix, "Passwords"), x, false)
  }
}

fn query_put_authorization_already_exists_fault(var f: query.Form, prefix: Str, v: AuthorizationAlreadyExistsFault) {
  if let Some(x) = v.message {
    query.add(f, query.key(prefix, "message"), x)
  }
}

fn query_put_authorization_not_found_fault(var f: query.Form, prefix: Str, v: AuthorizationNotFoundFault) {
  if let Some(x) = v.message {
