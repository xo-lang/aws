  if let Some(x) = v.backup_retention_period {
    xmlv.elem(w, "BackupRetentionPeriod", "${x}", [])
  }
  if let Some(x) = v.db_security_groups {
    xml_write_db_security_group_membership_list(w, x, "DBSecurityGroups", [])
  }
  if let Some(x) = v.vpc_security_groups {
    xml_write_vpc_security_group_membership_list(w, x, "VpcSecurityGroups", [])
  }
  if let Some(x) = v.db_parameter_groups {
    xml_write_db_parameter_group_status_list(w, x, "DBParameterGroups", [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "AvailabilityZone", x, [])
  }
