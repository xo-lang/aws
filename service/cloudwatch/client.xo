    xmlv.elem(w, "CreationDate", rest.date_time(x), [])
  }
  if let Some(x) = v.last_update_date {
    xmlv.elem(w, "LastUpdateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.name {
