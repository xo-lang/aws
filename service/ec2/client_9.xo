  }
  if let Some(x) = v.security_group_rule {
    query_put_analysis_security_group_rule(f, query.key(prefix, "SecurityGroupRule"), x)
  }
  if let Some(x) = v.security_groups {
    query_put_analysis_component_list(f, query.key(prefix, "SecurityGroupSet"), x, false)
  }
  if let Some(x) = v.source_vpc {
    query_put_analysis_component(f, query.key(prefix, "SourceVpc"), x)
  }
  if let Some(x) = v.state {
    query.add(f, query.key(prefix, "State"), x)
  }
  if let Some(x) = v.subnet {
    query_put_analysis_component(f, query.key(prefix, "Subnet"), x)
  }
  if let Some(x) = v.subnet_route_table {
    query_put_analysis_component(f, query.key(prefix, "SubnetRouteTable"), x)
  }
  if let Some(x) = v.vpc {
    query_put_analysis_component(f, query.key(prefix, "Vpc"), x)
  }
  if let Some(x) = v.vpc_endpoint {
    query_put_analysis_component(f, query.key(prefix, "VpcEndpoint"), x)
  }
  if let Some(x) = v.vpn_connection {
    query_put_analysis_component(f, query.key(prefix, "VpnConnection"), x)
  }
  if let Some(x) = v.vpn_gateway {
    query_put_analysis_component(f, query.key(prefix, "VpnGateway"), x)
  }
  if let Some(x) = v.transit_gateway {
    query_put_analysis_component(f, query.key(prefix, "TransitGateway"), x)
  }
  if let Some(x) = v.transit_gateway_route_table {
    query_put_analysis_component(f, query.key(prefix, "TransitGatewayRouteTable"), x)
  }
  if let Some(x) = v.transit_gateway_route_table_route {
    query_put_transit_gateway_route_table_route(f, query.key(prefix, "TransitGatewayRouteTableRoute"), x)
  }
  if let Some(x) = v.transit_gateway_policy_table {
    query_put_analysis_component(f, query.key(prefix, "TransitGatewayPolicyTable"), x)
