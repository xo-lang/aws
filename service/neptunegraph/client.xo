      Ok(x) => return UpdateGraphErr.InternalServerException(x)
      Err(msg) => return UpdateGraphErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateGraphErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateGraphErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateGraphErr.ThrottlingException(x)
      Err(msg) => return UpdateGraphErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateGraphErr.ValidationException(x)
      Err(msg) => return UpdateGraphErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateGraphErr.Api(restjson.api_error(resp, body))
}

/// Updates the configuration of a specified Neptune Analytics graph
pub fn (c: Client) update_graph(input: UpdateGraphInput) -> UpdateGraphOutput ! UpdateGraphErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_graph(c.params, input)) ?? e => return Err(UpdateGraphErr.InvalidInput(e))
  var req = serialize_update_graph(ep, input, "") ?? e => return Err(UpdateGraphErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateGraphErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_graph_error(resp))
  }
  deserialize_update_graph(resp) ?? e => Err(UpdateGraphErr.Deserialize(e))
}
