/// The HTTP request of RollbackTransaction.
pub fn serialize_rollback_transaction(ep: rest.Endpoint, input: RollbackTransactionRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.resource_arn {
    fs.push(("resourceArn", json.Value.Str(x)))
  }
  if let Some(x) = input.secret_arn {
    fs.push(("secretArn", json.Value.Str(x)))
  }
  if let Some(x) = input.transaction_id {
    fs.push(("transactionId", json.Value.Str(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/RollbackTransaction"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_rollback_transaction(resp: http.Response) -> RollbackTransactionResponse ! Str {
  var out = RollbackTransactionResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
