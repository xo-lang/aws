fn xml_write_lake_formation_scope_union(var w: xmlv.Writer, v: LakeFormationScopeUnion, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    LakeFormationQuery(x) => {
      xml_write_lake_formation_query(w, x, "LakeFormationQuery", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_lake_formation_scope_union(e: xml.Element) -> LakeFormationScopeUnion ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "LakeFormationQuery" => Ok(LakeFormationScopeUnion.LakeFormationQuery(xml_read_lake_formation_query(c)?))
      _ => Ok(LakeFormationScopeUnion.Unknown(c.name.local))
    }
  }
  Err("LakeFormationScopeUnion: no member set")
}

