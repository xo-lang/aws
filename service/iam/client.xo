fn xml_write_delegation_request(var w: xmlv.Writer, v: DelegationRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.delegation_request_id {
    xmlv.elem(w, "DelegationRequestId", x, [])
  }
  if let Some(x) = v.owner_account_id {
    xmlv.elem(w, "OwnerAccountId", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.request_message {
    xmlv.elem(w, "RequestMessage", x, [])
  }
  if let Some(x) = v.permissions {
    xml_write_delegation_permission(w, x, "Permissions", [])
  }
  if let Some(x) = v.permission_policy {
    xmlv.elem(w, "PermissionPolicy", x, [])
  }
  if let Some(x) = v.role_permission_restriction_arns {
    xml_write_role_permission_restriction_arn_list_type(w, x, "RolePermissionRestrictionArns", [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "OwnerId", x, [])
  }
  if let Some(x) = v.approver_id {
    xmlv.elem(w, "ApproverId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "State", x.value(), [])
  }
  if let Some(x) = v.expiration_time {
    xmlv.elem(w, "ExpirationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.requestor_id {
    xmlv.elem(w, "RequestorId", x, [])
  }
  if let Some(x) = v.requestor_name {
    xmlv.elem(w, "RequestorName", x, [])
  }
  if let Some(x) = v.create_date {
    xmlv.elem(w, "CreateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.session_duration {
    xmlv.elem(w, "SessionDuration", "${x}", [])
  }
  if let Some(x) = v.redirect_url {
    xmlv.elem(w, "RedirectUrl", x, [])
  }
  if let Some(x) = v.notes {
    xmlv.elem(w, "Notes", x, [])
  }
  if let Some(x) = v.rejection_reason {
    xmlv.elem(w, "RejectionReason", x, [])
  }
  if let Some(x) = v.only_send_by_owner {
    xmlv.elem(w, "OnlySendByOwner", "${x}", [])
  }
  if let Some(x) = v.updated_time {
    xmlv.elem(w, "UpdatedTime", rest.date_time(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_delegation_request(e: xml.Element) -> DelegationRequest ! Str {
  var out = DelegationRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DelegationRequestId" => out.delegation_request_id = c.text()
      "OwnerAccountId" => out.owner_account_id = c.text()
      "Description" => out.description = c.text()
      "RequestMessage" => out.request_message = c.text()
      "Permissions" => out.permissions = xml_read_delegation_permission(c)?
      "PermissionPolicy" => out.permission_policy = c.text()
      "RolePermissionRestrictionArns" => out.role_permission_restriction_arns = xml_read_role_permission_restriction_arn_list_type(c)?
      "OwnerId" => out.owner_id = c.text()
      "ApproverId" => out.approver_id = c.text()
      "State" => out.state = StateType.from(c.text())
      "ExpirationTime" => out.expiration_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "RequestorId" => out.requestor_id = c.text()
      "RequestorName" => out.requestor_name = c.text()
      "CreateDate" => out.create_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SessionDuration" => out.session_duration = xmlv.read_int(c.text())?
      "RedirectUrl" => out.redirect_url = c.text()
      "Notes" => out.notes = c.text()
      "RejectionReason" => out.rejection_reason = c.text()
      "OnlySendByOwner" => out.only_send_by_owner = xmlv.read_bool(c.text())?
      "UpdatedTime" => out.updated_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

