/// while the last page carried a new token.
pub fn (p: ListSearchesPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: ListSearchesPaginator) next_page() -> ListSearchesResponse ! ListSearchesErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_searches(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}

