  /// A list of pipeline variables used for the pipeline execution.
  pub variables: List[ResolvedPipelineVariable]? = None
  pub trigger: ExecutionTrigger? = None
  /// The method that the pipeline will use to handle multiple executions. The
  /// default mode is SUPERSEDED.
  pub execution_mode: ExecutionMode? = None
  /// The type of the pipeline execution.
  pub execution_type: ExecutionType? = None
  /// The metadata about the execution pertaining to stage rollback.
  pub rollback_metadata: PipelineRollbackMetadata? = None
}

