/// The HTTP request of XmlTimestamps.
pub fn serialize_xml_timestamps(ep: rest.Endpoint, input: XmlTimestampsRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var w = xmlv.writer()
  var attrs: List[(Str, Str)] = []
  xmlv.start(w, "XmlTimestampsRequest", attrs)
  if let Some(x) = input.normal {
    xmlv.elem(w, "normal", rest.date_time(x), [])
  }
  if let Some(x) = input.date_time {
    xmlv.elem(w, "dateTime", rest.date_time(x), [])
  }
  if let Some(x) = input.date_time_on_target {
    xmlv.elem(w, "dateTimeOnTarget", rest.date_time(x), [])
  }
  if let Some(x) = input.epoch_seconds {
    xmlv.elem(w, "epochSeconds", rest.epoch_seconds(x), [])
  }
  if let Some(x) = input.epoch_seconds_on_target {
    xmlv.elem(w, "epochSecondsOnTarget", rest.epoch_seconds(x), [])
  }
  if let Some(x) = input.http_date {
    xmlv.elem(w, "httpDate", rest.http_date(x), [])
  }
  if let Some(x) = input.http_date_on_target {
    xmlv.elem(w, "httpDateOnTarget", rest.http_date(x), [])
  }
  xmlv.end(w, "XmlTimestampsRequest")
  body = xmlv.finish(w)
  headers.push(("Content-Type", "application/xml"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/XmlTimestamps"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

