  pub status: InstanceStatus? = None
  /// The identifier of the instance group to which this instance belongs.
  pub instance_group_id: Str? = None
  /// The unique identifier of the instance fleet to which an Amazon EC2
  /// instance belongs.
  pub instance_fleet_id: Str? = None
  /// The instance purchasing option. Valid values are ON_DEMAND or SPOT .
  pub market: MarketType? = None
  /// The Amazon EC2 instance type, for example m3.xlarge .
  pub instance_type: Str? = None
  /// The list of Amazon EBS volumes that are attached to this instance.
  pub ebs_volumes: List[EbsVolume]? = None
}

pub enum InstanceCollectionType: Str {
  InstanceFleet = "INSTANCE_FLEET"
  InstanceGroup = "INSTANCE_GROUP"
