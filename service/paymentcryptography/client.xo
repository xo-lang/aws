fn json_of_key(v: Key) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.key_arn {
    fs.push(("KeyArn", json.Value.Str(x)))
  }
  if let Some(x) = v.key_attributes {
    fs.push(("KeyAttributes", json_of_key_attributes(x)))
  }
  if let Some(x) = v.key_check_value {
    fs.push(("KeyCheckValue", json.Value.Str(x)))
  }
  if let Some(x) = v.key_check_value_algorithm {
    fs.push(("KeyCheckValueAlgorithm", json.Value.Str(x)))
  }
  if let Some(x) = v.enabled {
    fs.push(("Enabled", json.Value.Bool(x)))
  }
  if let Some(x) = v.exportable {
    fs.push(("Exportable", json.Value.Bool(x)))
  }
  if let Some(x) = v.key_state {
    fs.push(("KeyState", json.Value.Str(x)))
  }
  if let Some(x) = v.key_origin {
    fs.push(("KeyOrigin", json.Value.Str(x)))
  }
  if let Some(x) = v.create_timestamp {
    fs.push(("CreateTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.usage_start_timestamp {
    fs.push(("UsageStartTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.usage_stop_timestamp {
    fs.push(("UsageStopTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.delete_pending_timestamp {
    fs.push(("DeletePendingTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.delete_timestamp {
    fs.push(("DeleteTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.derive_key_usage {
    fs.push(("DeriveKeyUsage", json.Value.Str(x)))
  }
  if let Some(x) = v.multi_region_key_type {
    fs.push(("MultiRegionKeyType", json.Value.Str(x)))
  }
  if let Some(x) = v.primary_region {
    fs.push(("PrimaryRegion", json.Value.Str(x)))
  }
  if let Some(x) = v.replication_status {
    fs.push(("ReplicationStatus", json_of_replication_status(x)))
  }
  if let Some(x) = v.using_default_replication_regions {
    fs.push(("UsingDefaultReplicationRegions", json.Value.Bool(x)))
