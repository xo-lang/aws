    match k {
      "Type" => out.type_value = NodeType.from(jsonv.read_str(fv)?)
      "Name" => out.name = jsonv.read_str(fv)?
      "UniqueId" => out.unique_id = jsonv.read_str(fv)?
      "TriggerDetails" => out.trigger_details = from_json_trigger_node_details(fv)?
      "JobDetails" => out.job_details = from_json_job_node_details(fv)?
      "CrawlerDetails" => out.crawler_details = from_json_crawler_node_details(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_node_id_list(v: List[Str]) -> json.Value {
  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

fn from_json_node_id_list(v: json.Value) -> List[Str] ! Str {
  var out: List[Str] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(jsonv.read_str(fv)?)
  }
  Ok(out)
}

fn json_of_node_list(v: List[Node]) -> json.Value {
  json.Value.List(v.map(fn(x: Node) -> json.Value { json_of_node(x) }))
}

fn from_json_node_list(v: json.Value) -> List[Node] ! Str {
  var out: List[Node] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_node(fv)?)
  }
  Ok(out)
}

fn json_of_notification_property(v: NotificationProperty) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.notify_delay_after {
    fs.push(("NotifyDelayAfter", json.Value.Int(x)))
  }
  json.Value.Object(fs)
}

fn from_json_notification_property(v: json.Value) -> NotificationProperty ! Str {
  var out = NotificationProperty{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "NotifyDelayAfter" => out.notify_delay_after = jsonv.read_int(fv)?
      _ => {}
    }
  }
  Ok(out)
}