  /// The message for this error.
  pub error_message: Str? = None
}

pub enum ServiceLevelObjectiveBudgetStatus: Str {
  Ok = "OK"
  Warning = "WARNING"
  Breached = "BREACHED"
  InsufficientData = "INSUFFICIENT_DATA"
  Unknown(value: Str)
}

