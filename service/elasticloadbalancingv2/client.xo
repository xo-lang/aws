fn xml_write_load_balancer(var w: xmlv.Writer, v: LoadBalancer, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.load_balancer_arn {
    xmlv.elem(w, "LoadBalancerArn", x, [])
  }
  if let Some(x) = v.dns_name {
    xmlv.elem(w, "DNSName", x, [])
  }
  if let Some(x) = v.canonical_hosted_zone_id {
    xmlv.elem(w, "CanonicalHostedZoneId", x, [])
  }
  if let Some(x) = v.created_time {
    xmlv.elem(w, "CreatedTime", rest.date_time(x), [])
  }
  if let Some(x) = v.load_balancer_name {
    xmlv.elem(w, "LoadBalancerName", x, [])
  }
  if let Some(x) = v.scheme {
    xmlv.elem(w, "Scheme", x.value(), [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "VpcId", x, [])
  }
  if let Some(x) = v.state {
    xml_write_load_balancer_state(w, x, "State", [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "Type", x.value(), [])
  }
  if let Some(x) = v.availability_zones {
    xml_write_availability_zones(w, x, "AvailabilityZones", [])
  }
  if let Some(x) = v.security_groups {
    xml_write_security_groups(w, x, "SecurityGroups", [])
  }
  if let Some(x) = v.ip_address_type {
    xmlv.elem(w, "IpAddressType", x.value(), [])
  }
  if let Some(x) = v.customer_owned_ipv4_pool {
    xmlv.elem(w, "CustomerOwnedIpv4Pool", x, [])
  }
  if let Some(x) = v.enforce_security_group_inbound_rules_on_private_link_traffic {
    xmlv.elem(w, "EnforceSecurityGroupInboundRulesOnPrivateLinkTraffic", x, [])
  }
  if let Some(x) = v.enable_prefix_for_ipv6_source_nat {
    xmlv.elem(w, "EnablePrefixForIpv6SourceNat", x.value(), [])
  }
  if let Some(x) = v.ipam_pools {
    xml_write_ipam_pools(w, x, "IpamPools", [])
  }
  xmlv.end(w, name)
}

fn xml_read_load_balancer(e: xml.Element) -> LoadBalancer ! Str {
  var out = LoadBalancer{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "LoadBalancerArn" => out.load_balancer_arn = c.text()
      "DNSName" => out.dns_name = c.text()
      "CanonicalHostedZoneId" => out.canonical_hosted_zone_id = c.text()
      "CreatedTime" => out.created_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "LoadBalancerName" => out.load_balancer_name = c.text()
      "Scheme" => out.scheme = LoadBalancerSchemeEnum.from(c.text())
      "VpcId" => out.vpc_id = c.text()
      "State" => out.state = xml_read_load_balancer_state(c)?
      "Type" => out.type_value = LoadBalancerTypeEnum.from(c.text())
      "AvailabilityZones" => out.availability_zones = xml_read_availability_zones(c)?
      "SecurityGroups" => out.security_groups = xml_read_security_groups(c)?
      "IpAddressType" => out.ip_address_type = IpAddressType.from(c.text())
      "CustomerOwnedIpv4Pool" => out.customer_owned_ipv4_pool = c.text()
      "EnforceSecurityGroupInboundRulesOnPrivateLinkTraffic" => out.enforce_security_group_inbound_rules_on_private_link_traffic = c.text()
      "EnablePrefixForIpv6SourceNat" => out.enable_prefix_for_ipv6_source_nat = EnablePrefixForIpv6SourceNatEnum.from(c.text())
      "IpamPools" => out.ipam_pools = xml_read_ipam_pools(c)?
      _ => {}
    }
  }
  Ok(out)
}

