  var out = InstanceNetworkInterfaceAttachment{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "attachTime" => out.attach_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "attachmentId" => out.attachment_id = c.text()
      "deleteOnTermination" => out.delete_on_termination = xmlv.read_bool(c.text())?
      "deviceIndex" => out.device_index = xmlv.read_int(c.text())?
      "status" => out.status = AttachmentStatus.from(c.text())
      "networkCardIndex" => out.network_card_index = xmlv.read_int(c.text())?
      "enaSrdSpecification" => out.ena_srd_specification = xml_read_instance_attachment_ena_srd_specification(c)?
      "enaQueueCount" => out.ena_queue_count = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

