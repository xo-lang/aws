fn json_of_parameter_value(v: ParameterValue) -> json.Value {
  match v {
    Integer(x) => json.Value.Object([("Integer", json.Value.Int(x))])
    IntegerList(x) => json.Value.Object([("IntegerList", json_of_integer_list(x))])
    Double(x) => json.Value.Object([("Double", jsonv.float(x))])
    String(x) => json.Value.Object([("String", json.Value.Str(x))])
    StringList(x) => json.Value.Object([("StringList", json_of_string_list(x))])
    Boolean(x) => json.Value.Object([("Boolean", json.Value.Bool(x))])
    Enum(x) => json.Value.Object([("Enum", json.Value.Str(x))])
    EnumList(x) => json.Value.Object([("EnumList", json_of_string_list(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_parameter_value(v: json.Value) -> ParameterValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Integer" => Ok(ParameterValue.Integer(jsonv.read_int(fv)?))
      "IntegerList" => Ok(ParameterValue.IntegerList(from_json_integer_list(fv)?))
      "Double" => Ok(ParameterValue.Double(jsonv.read_float(fv)?))
      "String" => Ok(ParameterValue.String(jsonv.read_str(fv)?))
      "StringList" => Ok(ParameterValue.StringList(from_json_string_list(fv)?))
      "Boolean" => Ok(ParameterValue.Boolean(jsonv.read_bool(fv)?))
      "Enum" => Ok(ParameterValue.Enum(jsonv.read_str(fv)?))
      "EnumList" => Ok(ParameterValue.EnumList(from_json_string_list(fv)?))
      _ => Ok(ParameterValue.Unknown(k))
    }
  }
  Err("ParameterValue: no member set")
}

fn json_of_parameters(v: Map[Str, ParameterConfiguration]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, ParameterConfiguration)) -> (Str, json.Value) { (e.0, json_of_parameter_configuration(e.1)) }))
}

fn from_json_parameters(v: json.Value) -> Map[Str, ParameterConfiguration] ! Str {
  var out: Map[Str, ParameterConfiguration] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_parameter_configuration(fv)?)
  }
  Ok(out)
}

