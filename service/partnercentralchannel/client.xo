  if let Some(x) = input.identifier {
    fs.push(("identifier", json.Value.Str(x)))
  }
  if let Some(x) = input.program_management_account_identifier {
    fs.push(("programManagementAccountIdentifier", json.Value.Str(x)))
  }
  if let Some(x) = input.revision {
    fs.push(("revision", json.Value.Str(x)))
  }
  if let Some(x) = input.display_name {
    fs.push(("displayName", json.Value.Str(x)))
  }
  if let Some(x) = input.requested_support_plan {
    fs.push(("requestedSupportPlan", json_of_support_plan(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.0"))
  headers.push(("X-Amz-Target", "PartnerCentralChannel.UpdateRelationship"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_update_relationship(resp: http.Response) -> UpdateRelationshipResponse ! Str {
  var out = UpdateRelationshipResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
