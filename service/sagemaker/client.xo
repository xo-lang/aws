  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "EbsVolumeConfig" => Ok(ClusterInstanceStorageConfig.EbsVolumeConfig(from_json_cluster_ebs_volume_config(fv)?))
      "FsxLustreConfig" => Ok(ClusterInstanceStorageConfig.FsxLustreConfig(from_json_cluster_fsx_lustre_config(fv)?))
      "FsxOpenZfsConfig" => Ok(ClusterInstanceStorageConfig.FsxOpenZfsConfig(from_json_cluster_fsx_open_zfs_config(fv)?))
      _ => Ok(ClusterInstanceStorageConfig.Unknown(k))
    }
  }
  Err("ClusterInstanceStorageConfig: no member set")
}

