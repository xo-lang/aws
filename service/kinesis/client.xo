fn from_json_consumer_description(v: json.Value) -> ConsumerDescription ! Str {
  var out = ConsumerDescription{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ConsumerName" => out.consumer_name = jsonv.read_str(fv)?
