pub fn serialize_decrypt_data(ep: rest.Endpoint, input: DecryptDataInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_key_identifier = match input.key_identifier {
    Some(v) => v
    None => return Err("input member KeyIdentifier is required")
  }
  if label_key_identifier == "" {
    return Err("input member KeyIdentifier must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.cipher_text {
    fs.push(("CipherText", json.Value.Str(x)))
  }
  if let Some(x) = input.decryption_attributes {
    fs.push(("DecryptionAttributes", json_of_encryption_decryption_attributes(x)))
  }
  if let Some(x) = input.wrapped_key {
    fs.push(("WrappedKey", json_of_wrapped_key(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/keys/${rest.escape(label_key_identifier, false)}/decrypt"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
