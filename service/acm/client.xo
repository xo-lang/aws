fn from_json_certificate_summary(v: json.Value) -> CertificateSummary ! Str {
  var out = CertificateSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "CertificateArn" => out.certificate_arn = jsonv.read_str(fv)?
      "DomainName" => out.domain_name = jsonv.read_str(fv)?
      "SubjectAlternativeNameSummaries" => out.subject_alternative_name_summaries = from_json_domain_list(fv)?
      "HasAdditionalSubjectAlternativeNames" => out.has_additional_subject_alternative_names = jsonv.read_bool(fv)?
      "Status" => out.status = CertificateStatus.from(jsonv.read_str(fv)?)
      "Type" => out.type_value = CertificateType.from(jsonv.read_str(fv)?)
      "KeyAlgorithm" => out.key_algorithm = KeyAlgorithm.from(jsonv.read_str(fv)?)
      "KeyUsages" => out.key_usages = from_json_key_usage_names(fv)?
      "ExtendedKeyUsages" => out.extended_key_usages = from_json_extended_key_usage_names(fv)?
      "ExportOption" => out.export_option = CertificateExport.from(jsonv.read_str(fv)?)
      "InUse" => out.in_use = jsonv.read_bool(fv)?
      "Exported" => out.exported = jsonv.read_bool(fv)?
      "RenewalEligibility" => out.renewal_eligibility = RenewalEligibility.from(jsonv.read_str(fv)?)
      "NotBefore" => out.not_before = jsonv.read_time(fv, "epoch-seconds")?
      "NotAfter" => out.not_after = jsonv.read_time(fv, "epoch-seconds")?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "IssuedAt" => out.issued_at = jsonv.read_time(fv, "epoch-seconds")?
      "ImportedAt" => out.imported_at = jsonv.read_time(fv, "epoch-seconds")?
      "RevokedAt" => out.revoked_at = jsonv.read_time(fv, "epoch-seconds")?
      "ManagedBy" => out.managed_by = CertificateManagedBy.from(jsonv.read_str(fv)?)
      "CertificateKeyPairOrigin" => out.certificate_key_pair_origin = CertificateKeyPairOrigin.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_certificate_summary_list(v: List[CertificateSummary]) -> json.Value {
