fn xml_write_destination(var w: xmlv.Writer, v: Destination, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.account {
    xmlv.elem(w, "Account", x, [])
  }
  if let Some(x) = v.bucket {
    xmlv.elem(w, "Bucket", x, [])
  }
  if let Some(x) = v.replication_time {
    xml_write_replication_time(w, x, "ReplicationTime", [])
  }
  if let Some(x) = v.access_control_translation {
    xml_write_access_control_translation(w, x, "AccessControlTranslation", [])
  }
  if let Some(x) = v.encryption_configuration {
    xml_write_encryption_configuration(w, x, "EncryptionConfiguration", [])
  }
  if let Some(x) = v.metrics {
    xml_write_metrics(w, x, "Metrics", [])
  }
  if let Some(x) = v.storage_class {
    xmlv.elem(w, "StorageClass", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_destination(e: xml.Element) -> Destination ! Str {
  var out = Destination{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Account" => out.account = c.text()
      "Bucket" => out.bucket = c.text()
      "ReplicationTime" => out.replication_time = xml_read_replication_time(c)?
      "AccessControlTranslation" => out.access_control_translation = xml_read_access_control_translation(c)?
      "EncryptionConfiguration" => out.encryption_configuration = xml_read_encryption_configuration(c)?
      "Metrics" => out.metrics = xml_read_metrics(c)?
      "StorageClass" => out.storage_class = ReplicationStorageClass.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

