  /// The username of the user.
  pub username: Str? = None
  /// The email address of the user.
  pub email: Str? = None
}

/// Role of a user member associated to an agent space.
pub enum UserRole: Str {
  Member = "MEMBER"
  Unknown(value: Str)
}

/// The input fails to satisfy the constraints specified by the service.
pub struct ValidationException {
  /// A summary of the validation failure.
  pub message: Str? = None
  /// A list of specific failures encountered during validation.
  pub field_list: List[ValidationExceptionField]? = None
}

/// Describes one specific validation failure for an input member.
pub struct ValidationExceptionField {
  /// A JSONPointer expression to the structure member whose value failed to
  /// satisfy the modeled constraint.
  pub path: Str? = None
  /// A detailed description of the validation failure.
  pub message: Str? = None
}

/// Mode of validation to perform on findings
pub enum ValidationMode: Str {
  Disabled = "DISABLED"
  Simulated = "SIMULATED"
  Unknown(value: Str)
}

/// Per-finding sandbox validation status
pub enum ValidationStatus: Str {
  Confirmed = "CONFIRMED"
  NotReproduced = "NOT_REPRODUCED"
  ValidationFailed = "VALIDATION_FAILED"
  Validating = "VALIDATING"
  NotValidated = "NOT_VALIDATED"
  Unknown(value: Str)
}

