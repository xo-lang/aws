pub enum WaypointOptimizationClusteringAlgorithm: Str {
  DrivingDistance = "DrivingDistance"
  TopologySegment = "TopologySegment"
  Unknown(value: Str)
}

/// Options for WaypointOptimizationClustering.
pub struct WaypointOptimizationClusteringOptions {
  /// The algorithm to be used. DrivingDistance assigns all the waypoints that
  /// are within driving distance of each other into a single cluster.
  /// TopologySegment assigns all the waypoints that are within the same
  /// topology segment into a single cluster. A Topology segment is a linear
  /// stretch of road between two junctions.
  pub algorithm: WaypointOptimizationClusteringAlgorithm? = None
  /// Driving distance options to be used when the clustering algorithm is
  /// DrivingDistance.
  pub driving_distance_options: WaypointOptimizationDrivingDistanceOptions? = None
}

/// This contains information such as distance and duration from one
/// waypoint to the next waypoint in the sequence.
pub struct WaypointOptimizationConnection {
  /// Distance of the step.
  pub distance: Int? = None
  /// contains the ID of the starting waypoint in this connection.
  pub from_value: Str? = None
  /// Resting time before the driver can continue driving.
  pub rest_duration: Int? = None
  /// Contains the ID of the ending waypoint in this connection.
  pub to: Str? = None
  /// Total duration. Unit : seconds
  pub travel_duration: Int? = None
  /// Duration of a wait step. Unit : seconds
  pub wait_duration: Int? = None
}

pub enum WaypointOptimizationConstraint: Str {
  AccessHours = "AccessHours"
  AppointmentTime = "AppointmentTime"
  Before = "Before"
  Heading = "Heading"
  ServiceDuration = "ServiceDuration"
  SideOfStreet = "SideOfStreet"
  Unknown(value: Str)
}

/// Destination related options.
pub struct WaypointOptimizationDestinationOptions {
  /// Access hours corresponding to when a waypoint can be visited.
  pub access_hours: WaypointOptimizationAccessHours? = None
  /// Appointment time at the destination.
  pub appointment_time: Str? = None
  /// GPS Heading at the position.
  pub heading: Float? = None
  /// The waypoint Id.
  pub id: Str? = None
  /// Service time spent at the destination. At an appointment, the service
  /// time should be the appointment duration. Unit : seconds
  pub service_duration: Int? = None
  /// Options to configure matching the provided position to a side of the
  /// street.
  pub side_of_street: WaypointOptimizationSideOfStreetOptions? = None
}

/// Driver related options.
pub struct WaypointOptimizationDriverOptions {
  /// Driver work-rest schedules defined by a short and long cycle. A rest
  /// needs to be taken after the short work duration. The short cycle can be
  /// repeated until you hit the long work duration, at which point the long
  /// rest duration should be taken before restarting.
  pub rest_cycles: WaypointOptimizationRestCycles? = None
  /// Pre defined rest profiles for a driver schedule. The only currently
  /// supported profile is EU.
  pub rest_profile: WaypointOptimizationRestProfile? = None
  /// If the service time provided at a waypoint/destination should be
  /// considered as rest or work. This contributes to the total time breakdown
  /// returned within the response.
  pub treat_service_time_as: WaypointOptimizationServiceTimeTreatment? = None
}

/// Driving distance related options.
pub struct WaypointOptimizationDrivingDistanceOptions {
  /// DrivingDistance assigns all the waypoints that are within driving
  /// distance of each other into a single cluster.
  pub driving_distance: Int? = None
}

/// Specifies strict exclusion options for the route calculation. This
/// setting mandates that the router will avoid any routes that include the
/// specified options, rather than merely attempting to minimize them.
pub struct WaypointOptimizationExclusionOptions {
  /// List of countries to be avoided defined by two-letter or three-letter
  /// country codes.
  pub countries: List[Str]? = None
}

/// The failed constraint.
pub struct WaypointOptimizationFailedConstraint {
  /// The failed constraint.
  pub constraint: WaypointOptimizationConstraint? = None
  /// Reason for the failed constraint.
  pub reason: Str? = None
}

pub enum WaypointOptimizationHazardousCargoType: Str {
  Combustible = "Combustible"
  Corrosive = "Corrosive"
  Explosive = "Explosive"
  Flammable = "Flammable"
  Gas = "Gas"
  HarmfulToWater = "HarmfulToWater"
  Organic = "Organic"
  Other = "Other"
  Poison = "Poison"
  PoisonousInhalation = "PoisonousInhalation"
  Radioactive = "Radioactive"
  Unknown(value: Str)
}

/// The impeding waypoint.
pub struct WaypointOptimizationImpedingWaypoint {
  /// Failed constraints for an impeding waypoint.
  pub failed_constraints: List[WaypointOptimizationFailedConstraint]? = None
  /// The waypoint Id.
  pub id: Str? = None
  /// Position in World Geodetic System (WGS 84) format: [longitude,
  /// latitude].
  pub position: List[Float]? = None
}

/// The optimized waypoint.
pub struct WaypointOptimizationOptimizedWaypoint {
  /// Estimated time of arrival at the destination. Time format:
  /// YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples:
  /// 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
  pub arrival_time: Str? = None
  /// Index of the cluster the waypoint is associated with. The index is
  /// included in the response only if clustering was performed while
  /// processing the request.
  pub cluster_index: Int? = None
  /// Estimated time of departure from the origin. Time format:
  /// YYYY-MM-DDThh:mm:ss.sssZ | YYYY-MM-DDThh:mm:ss.sss+hh:mm Examples:
  /// 2020-04-22T17:57:24Z 2020-04-22T17:57:24+02:00
  pub departure_time: Str? = None
  /// The waypoint Id.
  pub id: Str? = None
  /// Position in World Geodetic System (WGS 84) format: [longitude,
  /// latitude].
  pub position: List[Float]? = None
}

/// Origin related options.
pub struct WaypointOptimizationOriginOptions {
  /// The Origin Id.
  pub id: Str? = None
}

/// Options related to a pedestrian.
pub struct WaypointOptimizationPedestrianOptions {
  /// Walking speed. Unit : kilometers per hour
  pub speed: Float? = None
}

/// Driver work-rest schedules defined by a short and long cycle. A rest
/// needs to be taken after the short work duration. The short cycle can be
/// repeated until you hit the long work duration, at which point the long
/// rest duration should be taken before restarting. Unit : seconds
pub struct WaypointOptimizationRestCycleDurations {
  /// Resting phase of the cycle. Unit : seconds
  pub rest_duration: Int? = None
  /// Working phase of the cycle. Unit : seconds
  pub work_duration: Int? = None
}

/// Resting phase of the cycle.
pub struct WaypointOptimizationRestCycles {
  /// Long cycle for a driver work-rest schedule.
  pub long_cycle: WaypointOptimizationRestCycleDurations? = None
  /// Short cycle for a driver work-rest schedule
  pub short_cycle: WaypointOptimizationRestCycleDurations? = None
}

/// Pre defined rest profiles for a driver schedule. The only currently
/// supported profile is EU.
pub struct WaypointOptimizationRestProfile {
  /// Pre defined rest profiles for a driver schedule. The only currently
  /// supported profile is EU.
  pub profile: Str? = None
}

pub enum WaypointOptimizationSequencingObjective: Str {
  FastestRoute = "FastestRoute"
  ShortestRoute = "ShortestRoute"
  Unknown(value: Str)
}

pub enum WaypointOptimizationServiceTimeTreatment: Str {
  Rest = "Rest"
  Work = "Work"
  Unknown(value: Str)
}

/// Options to configure matching the provided position to a side of the
/// street.
pub struct WaypointOptimizationSideOfStreetOptions {
  /// Position in World Geodetic System (WGS 84) format: [longitude,
  /// latitude].
  pub position: List[Float]? = None
  /// Strategy that defines when the side of street position should be used.
  /// AnyStreet will always use the provided position. Default value:
  /// DividedStreetOnly
  pub use_with: SideOfStreetMatchingStrategy? = None
}

/// Time breakdown for the sequence.
pub struct WaypointOptimizationTimeBreakdown {
  /// Resting phase of the cycle. Unit : seconds
  pub rest_duration: Int? = None
  /// Service time spent at the destination. At an appointment, the service
  /// time should be the appointment duration. Unit : seconds
  pub service_duration: Int? = None
  /// Traveling phase of the cycle. Unit : seconds
  pub travel_duration: Int? = None
  /// Waiting phase of the cycle. Unit : seconds
  pub wait_duration: Int? = None
}

/// Options related to traffic.
pub struct WaypointOptimizationTrafficOptions {
  /// Determines if traffic should be used or ignored while calculating the
  /// route. Default value: UseTrafficData
  pub usage: TrafficUsage? = None
}

/// Trailer options corresponding to the vehicle.
pub struct WaypointOptimizationTrailerOptions {
  /// Number of trailers attached to the vehicle. Default value: 0
  pub trailer_count: Int? = None
}

pub enum WaypointOptimizationTravelMode: Str {
  Car = "Car"
  Pedestrian = "Pedestrian"
  Scooter = "Scooter"
  Truck = "Truck"
  Unknown(value: Str)
}

/// Travel mode related options for the provided travel mode.
pub struct WaypointOptimizationTravelModeOptions {
  /// Travel mode options when the provided travel mode is Pedestrian .
  pub pedestrian: WaypointOptimizationPedestrianOptions? = None
  /// Travel mode options when the provided travel mode is Truck .
  pub truck: WaypointOptimizationTruckOptions? = None
}

/// Travel mode options when the provided travel mode is Truck .
pub struct WaypointOptimizationTruckOptions {
  /// Gross weight of the vehicle including trailers, and goods at capacity.
  /// Unit : kilograms
  pub gross_weight: Int? = None
  /// List of Hazardous cargo contained in the vehicle.
  pub hazardous_cargos: List[WaypointOptimizationHazardousCargoType]? = None
  /// Height of the vehicle. Unit : centimeters
  pub height: Int? = None
  /// Length of the vehicle. Unit : centimeters
  pub length: Int? = None
  /// Trailer options corresponding to the vehicle.
  pub trailer: WaypointOptimizationTrailerOptions? = None
  /// The type of truck: LightTruck for smaller delivery vehicles,
  /// StraightTruck for rigid body trucks, or Tractor for tractor-trailer
  /// combinations.
  pub truck_type: WaypointOptimizationTruckType? = None
  /// The tunnel restriction code. Tunnel categories in this list indicate the
  /// restrictions which apply to certain tunnels in Great Britain. They
  /// relate to the types of dangerous goods that can be transported through
  /// them. Tunnel Category B Risk Level : Limited risk Restrictions : Few
  /// restrictions Tunnel Category C Risk Level : Medium risk Restrictions :
  /// Some restrictions Tunnel Category D Risk Level : High risk Restrictions
  /// : Many restrictions occur Tunnel Category E Risk Level : Very high risk
  /// Restrictions : Restricted tunnel
  pub tunnel_restriction_code: Str? = None
  /// Heaviest weight per axle irrespective of the axle type or the axle
  /// group. Meant for usage in countries where the differences in axle types
  /// or axle groups are not distinguished. Unit : kilograms
  pub weight_per_axle: Int? = None
  /// Width of the vehicle. Unit : centimeters
  pub width: Int? = None
}

pub enum WaypointOptimizationTruckType: Str {
  StraightTruck = "StraightTruck"
  Tractor = "Tractor"
  Unknown(value: Str)
}

/// Waypoint between the Origin and Destination.
pub struct WaypointOptimizationWaypoint {
  /// Access hours corresponding to when a waypoint can be visited.
  pub access_hours: WaypointOptimizationAccessHours? = None
  /// Appointment time at the waypoint.
  pub appointment_time: Str? = None
  /// Constraint defining what waypoints are to be visited after this
  /// waypoint.
  pub before: List[Int]? = None
  /// GPS Heading at the position.
  pub heading: Float? = None
  /// The waypoint Id.
  pub id: Str? = None
  /// Position in World Geodetic System (WGS 84) format: [longitude,
  /// latitude].
  pub position: List[Float]? = None
  /// Service time spent at the waypoint. At an appointment, the service time
  /// should be the appointment duration. Unit : seconds
  pub service_duration: Int? = None
  /// Options to configure matching the provided position to a side of the
  /// street.
  pub side_of_street: WaypointOptimizationSideOfStreetOptions? = None
}

/// Specifies the total weight for different axle group configurations. Used
/// in regions where regulations set different weight limits based on axle
/// group types. Unit : kilograms
pub struct WeightPerAxleGroup {
  /// Total weight in kilograms for single axle configurations. Unit :
  /// kilograms
  pub single: Int? = None
  /// Total weight in kilograms for tandem (two adjacent) axle configurations.
  /// Unit : kilograms
  pub tandem: Int? = None
  /// Total weight in kilograms for triple (three adjacent) axle
  /// configurations. Unit : kilograms
  pub triple: Int? = None
  /// Total weight in kilograms for quad (four adjacent) axle configurations.
  /// Unit : kilograms
  pub quad: Int? = None
  /// Total weight in kilograms for quint (five adjacent) axle configurations.
  /// Unit : kilograms
  pub quint: Int? = None
}
