  /// combination that this 3D LUT file applies to. MediaLive reads the color
  /// space in the input metadata, determines the color space that you have
  /// specified for the output, and finds and uses the LUT file that applies
  /// to this combination.
  pub global_color_corrections: List[ColorCorrection]? = None
}

/// Property of colorCorrections. When you are using 3D LUT files to perform
/// color conversion on video, these are the supported color spaces.
