pub struct DiscoveredDeviceSummary {
  /// The third-party device identifier as defined by the connector. This
  /// identifier must not contain personal identifiable information (PII).
  pub connector_device_id: Str? = None
  /// The name of the device as defined by the connector or third-party
  /// system.
  pub connector_device_name: Str? = None
  /// The list of device types or categories that the discovered device
  /// belongs to.
  pub device_types: List[Str]? = None
  /// The identifier of the managed thing created for this discovered device,
  /// if one exists.
  pub managed_thing_id: Str? = None
  /// The status of the discovered device, indicating whether it has been
  /// added, removed, or modified since the last discovery.
  pub modification: DiscoveryModification? = None
  /// The timestamp indicating when the device was discovered.
  pub discovered_at: Time? = None
  /// The brand of the discovered device.
  pub brand: Str? = None
  /// The model of the discovered device.
  pub model: Str? = None
  /// The authentication material required for connecting to the discovered
  /// device, such as credentials or tokens.
  pub authentication_material: Str? = None
}

pub enum DiscoveryAuthMaterialType: Str {
  ZwaveInstallCode = "ZWAVE_INSTALL_CODE"
  Unknown(value: Str)
}

pub enum DiscoveryModification: Str {
  Discovered = "DISCOVERED"
  Updated = "UPDATED"
  NoChange = "NO_CHANGE"
  Unknown(value: Str)
}

pub enum DiscoveryType: Str {
  Zwave = "ZWAVE"
  Zigbee = "ZIGBEE"
  Cloud = "CLOUD"
  Custom = "CUSTOM"
  ControllerCapabilityRediscovery = "CONTROLLER_CAPABILITY_REDISCOVERY"
  Unknown(value: Str)
}

pub enum EncryptionType: Str {
  ManagedIntegrationsDefaultEncryption = "MANAGED_INTEGRATIONS_DEFAULT_ENCRYPTION"
  CustomerKeyEncryption = "CUSTOMER_KEY_ENCRYPTION"
  Unknown(value: Str)
}

