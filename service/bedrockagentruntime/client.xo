fn json_of_agentic_retrieve_stream_response_output(v: AgenticRetrieveStreamResponseOutput) -> json.Value {
  match v {
    Result(x) => json.Value.Object([("result", json_of_agentic_retrieve_result_event(x))])
    TraceEvent(x) => json.Value.Object([("traceEvent", json_of_agentic_retrieve_trace_event(x))])
    ResponseEvent(x) => json.Value.Object([("responseEvent", json_of_agentic_retrieve_response_event(x))])
    InternalServerException(x) => json.Value.Object([("internalServerException", json_of_internal_server_exception(x))])
    ValidationException(x) => json.Value.Object([("validationException", json_of_validation_exception(x))])
    ResourceNotFoundException(x) => json.Value.Object([("resourceNotFoundException", json_of_resource_not_found_exception(x))])
    ServiceQuotaExceededException(x) => json.Value.Object([("serviceQuotaExceededException", json_of_service_quota_exceeded_exception(x))])
    ThrottlingException(x) => json.Value.Object([("throttlingException", json_of_throttling_exception(x))])
    AccessDeniedException(x) => json.Value.Object([("accessDeniedException", json_of_access_denied_exception(x))])
    ConflictException(x) => json.Value.Object([("conflictException", json_of_conflict_exception(x))])
    DependencyFailedException(x) => json.Value.Object([("dependencyFailedException", json_of_dependency_failed_exception(x))])
    BadGatewayException(x) => json.Value.Object([("badGatewayException", json_of_bad_gateway_exception(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_agentic_retrieve_stream_response_output(v: json.Value) -> AgenticRetrieveStreamResponseOutput ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "result" => Ok(AgenticRetrieveStreamResponseOutput.Result(from_json_agentic_retrieve_result_event(fv)?))
      "traceEvent" => Ok(AgenticRetrieveStreamResponseOutput.TraceEvent(from_json_agentic_retrieve_trace_event(fv)?))
      "responseEvent" => Ok(AgenticRetrieveStreamResponseOutput.ResponseEvent(from_json_agentic_retrieve_response_event(fv)?))
      "internalServerException" => Ok(AgenticRetrieveStreamResponseOutput.InternalServerException(from_json_internal_server_exception(fv)?))
      "validationException" => Ok(AgenticRetrieveStreamResponseOutput.ValidationException(from_json_validation_exception(fv)?))
      "resourceNotFoundException" => Ok(AgenticRetrieveStreamResponseOutput.ResourceNotFoundException(from_json_resource_not_found_exception(fv)?))
      "serviceQuotaExceededException" => Ok(AgenticRetrieveStreamResponseOutput.ServiceQuotaExceededException(from_json_service_quota_exceeded_exception(fv)?))
      "throttlingException" => Ok(AgenticRetrieveStreamResponseOutput.ThrottlingException(from_json_throttling_exception(fv)?))
      "accessDeniedException" => Ok(AgenticRetrieveStreamResponseOutput.AccessDeniedException(from_json_access_denied_exception(fv)?))
      "conflictException" => Ok(AgenticRetrieveStreamResponseOutput.ConflictException(from_json_conflict_exception(fv)?))
      "dependencyFailedException" => Ok(AgenticRetrieveStreamResponseOutput.DependencyFailedException(from_json_dependency_failed_exception(fv)?))
      "badGatewayException" => Ok(AgenticRetrieveStreamResponseOutput.BadGatewayException(from_json_bad_gateway_exception(fv)?))
      _ => Ok(AgenticRetrieveStreamResponseOutput.Unknown(k))
    }
  }
  Err("AgenticRetrieveStreamResponseOutput: no member set")
}

