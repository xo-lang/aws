fn xml_write_ebs_info(var w: xmlv.Writer, v: EbsInfo, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.ebs_optimized_support {
    xmlv.elem(w, "ebsOptimizedSupport", x.value(), [])
  }
  if let Some(x) = v.encryption_support {
    xmlv.elem(w, "encryptionSupport", x.value(), [])
  }
  if let Some(x) = v.ebs_optimized_info {
    xml_write_ebs_optimized_info(w, x, "ebsOptimizedInfo", [])
  }
  if let Some(x) = v.nvme_support {
    xmlv.elem(w, "nvmeSupport", x.value(), [])
  }
  if let Some(x) = v.maximum_ebs_attachments {
    xmlv.elem(w, "maximumEbsAttachments", "${x}", [])
  }
  if let Some(x) = v.attachment_limit_type {
    xmlv.elem(w, "attachmentLimitType", x.value(), [])
  }
  if let Some(x) = v.maximum_ebs_cards {
    xmlv.elem(w, "maximumEbsCards", "${x}", [])
  }
  if let Some(x) = v.ebs_cards {
    xml_write_ebs_card_info_list(w, x, "ebsCardSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_ebs_info(e: xml.Element) -> EbsInfo ! Str {
  var out = EbsInfo{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ebsOptimizedSupport" => out.ebs_optimized_support = EbsOptimizedSupport.from(c.text())
      "encryptionSupport" => out.encryption_support = EbsEncryptionSupport.from(c.text())
      "ebsOptimizedInfo" => out.ebs_optimized_info = xml_read_ebs_optimized_info(c)?
      "nvmeSupport" => out.nvme_support = EbsNvmeSupport.from(c.text())
      "maximumEbsAttachments" => out.maximum_ebs_attachments = xmlv.read_int(c.text())?
      "attachmentLimitType" => out.attachment_limit_type = AttachmentLimitType.from(c.text())
      "maximumEbsCards" => out.maximum_ebs_cards = xmlv.read_int(c.text())?
      "ebsCardSet" => out.ebs_cards = xml_read_ebs_card_info_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

