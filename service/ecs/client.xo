fn from_json_service(v: json.Value) -> Service ! Str {
  var out = Service{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "serviceArn" => out.service_arn = jsonv.read_str(fv)?
      "serviceName" => out.service_name = jsonv.read_str(fv)?
      "clusterArn" => out.cluster_arn = jsonv.read_str(fv)?
      "loadBalancers" => out.load_balancers = from_json_load_balancers(fv)?
      "serviceRegistries" => out.service_registries = from_json_service_registries(fv)?
      "status" => out.status = jsonv.read_str(fv)?
      "desiredCount" => out.desired_count = jsonv.read_int(fv)?
      "runningCount" => out.running_count = jsonv.read_int(fv)?
      "pendingCount" => out.pending_count = jsonv.read_int(fv)?
      "launchType" => out.launch_type = LaunchType.from(jsonv.read_str(fv)?)
      "capacityProviderStrategy" => out.capacity_provider_strategy = from_json_capacity_provider_strategy(fv)?
      "platformVersion" => out.platform_version = jsonv.read_str(fv)?
      "platformFamily" => out.platform_family = jsonv.read_str(fv)?
      "taskDefinition" => out.task_definition = jsonv.read_str(fv)?
      "deploymentConfiguration" => out.deployment_configuration = from_json_deployment_configuration(fv)?
      "taskSets" => out.task_sets = from_json_task_sets(fv)?
      "deployments" => out.deployments = from_json_deployments(fv)?
      "roleArn" => out.role_arn = jsonv.read_str(fv)?
      "events" => out.events = from_json_service_events(fv)?
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "currentServiceDeployment" => out.current_service_deployment = jsonv.read_str(fv)?
      "currentServiceRevisions" => out.current_service_revisions = from_json_service_current_revision_summary_list(fv)?
      "placementConstraints" => out.placement_constraints = from_json_placement_constraints(fv)?
      "placementStrategy" => out.placement_strategy = from_json_placement_strategies(fv)?
      "networkConfiguration" => out.network_configuration = from_json_network_configuration(fv)?
      "healthCheckGracePeriodSeconds" => out.health_check_grace_period_seconds = jsonv.read_int(fv)?
      "schedulingStrategy" => out.scheduling_strategy = SchedulingStrategy.from(jsonv.read_str(fv)?)
      "deploymentController" => out.deployment_controller = from_json_deployment_controller(fv)?
      "tags" => out.tags = from_json_tags(fv)?
      "createdBy" => out.created_by = jsonv.read_str(fv)?
      "enableECSManagedTags" => out.enable_ecs_managed_tags = jsonv.read_bool(fv)?
      "propagateTags" => out.propagate_tags = PropagateTags.from(jsonv.read_str(fv)?)
      "enableExecuteCommand" => out.enable_execute_command = jsonv.read_bool(fv)?
      "availabilityZoneRebalancing" => out.availability_zone_rebalancing = AvailabilityZoneRebalancing.from(jsonv.read_str(fv)?)
      "resourceManagementType" => out.resource_management_type = ResourceManagementType.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

