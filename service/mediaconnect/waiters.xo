          state = "success"
        }
        if state == "" && waiter.path_matches(o, "SourceEndpoint.RegistrationState", "stringEquals", "REGISTRATION_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "SourceEndpoint.RegistrationState", "stringEquals", "DEREGISTERING") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_get_source_endpoint(e)
        if state == "" && waiter.error_is(names, "InternalServerErrorException") {
          state = "retry"
        }
        if state == "" && waiter.error_is(names, "ServiceUnavailableException") {
          state = "retry"
        }
        if state == "" && waiter.error_is(names, "TooManyRequestsException") {
          state = "retry"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("SourceEndpointRegistered: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
