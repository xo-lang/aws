      "name" => out.name = jsonv.read_str(fv)?
      "pipelinesRunningCount" => out.pipelines_running_count = jsonv.read_int(fv)?
      "roleArn" => out.role_arn = jsonv.read_str(fv)?
      "state" => out.state = ChannelState.from(jsonv.read_str(fv)?)
