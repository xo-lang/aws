  }
  if let Some(x) = v.ingress_bytes {
    xmlv.elem(w, "ingressBytes", x, [])
  }
  if let Some(x) = v.egress_bytes {
    xmlv.elem(w, "egressBytes", x, [])
  }
  if let Some(x) = v.ingress_packets {
    xmlv.elem(w, "ingressPackets", x, [])
  }
  if let Some(x) = v.egress_packets {
    xmlv.elem(w, "egressPackets", x, [])
  }
  if let Some(x) = v.client_ip {
    xmlv.elem(w, "clientIp", x, [])
  }
  if let Some(x) = v.client_ipv6_address {
    xmlv.elem(w, "clientIpv6Address", x, [])
  }
  if let Some(x) = v.common_name {
    xmlv.elem(w, "commonName", x, [])
  }
  if let Some(x) = v.status {
    xml_write_client_vpn_connection_status(w, x, "status", [])
  }
  if let Some(x) = v.connection_end_time {
    xmlv.elem(w, "connectionEndTime", x, [])
  }
