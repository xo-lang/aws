fn xml_write_recommended_action(var w: xmlv.Writer, v: RecommendedAction, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.action_id {
    xmlv.elem(w, "ActionId", x, [])
  }
  if let Some(x) = v.title {
    xmlv.elem(w, "Title", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.operation {
    xmlv.elem(w, "Operation", x, [])
  }
  if let Some(x) = v.parameters {
    xml_write_recommended_action_parameter_list(w, x, "Parameters", [])
  }
  if let Some(x) = v.apply_modes {
    xml_write_string_list(w, x, "ApplyModes", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.issue_details {
    xml_write_issue_details(w, x, "IssueDetails", [])
  }
  if let Some(x) = v.context_attributes {
    xml_write_context_attribute_list(w, x, "ContextAttributes", [])
  }
  xmlv.end(w, name)
}

fn xml_read_recommended_action(e: xml.Element) -> RecommendedAction ! Str {
  var out = RecommendedAction{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ActionId" => out.action_id = c.text()
      "Title" => out.title = c.text()
      "Description" => out.description = c.text()
      "Operation" => out.operation = c.text()
      "Parameters" => out.parameters = xml_read_recommended_action_parameter_list(c)?
      "ApplyModes" => out.apply_modes = xml_read_string_list(c)?
      "Status" => out.status = c.text()
      "IssueDetails" => out.issue_details = xml_read_issue_details(c)?
      "ContextAttributes" => out.context_attributes = xml_read_context_attribute_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

