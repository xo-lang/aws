  /// threshold.
  pub comparison_operator: ServiceLevelIndicatorComparisonOperator? = None
}

pub enum ServiceLevelIndicatorComparisonOperator: Str {
  GreaterThanOrEqualTo = "GreaterThanOrEqualTo"
  GreaterThan = "GreaterThan"
  LessThan = "LessThan"
  LessThanOrEqualTo = "LessThanOrEqualTo"
  Unknown(value: Str)
}

