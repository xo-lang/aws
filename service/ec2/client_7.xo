  }
  if let Some(x) = v.transit_gateway_id {
    xmlv.elem(w, "transitGatewayId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.default_association_route_table {
    xmlv.elem(w, "defaultAssociationRouteTable", "${x}", [])
  }
  if let Some(x) = v.default_propagation_route_table {
    xmlv.elem(w, "defaultPropagationRouteTable", "${x}", [])
  }
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "creationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

