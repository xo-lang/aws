fn json_of_transform_operation(v: TransformOperation) -> json.Value {
  match v {
    ProjectOperation(x) => json.Value.Object([("ProjectOperation", json_of_project_operation(x))])
    FilterOperation(x) => json.Value.Object([("FilterOperation", json_of_filter_operation(x))])
    CreateColumnsOperation(x) => json.Value.Object([("CreateColumnsOperation", json_of_create_columns_operation(x))])
    RenameColumnOperation(x) => json.Value.Object([("RenameColumnOperation", json_of_rename_column_operation(x))])
    CastColumnTypeOperation(x) => json.Value.Object([("CastColumnTypeOperation", json_of_cast_column_type_operation(x))])
    TagColumnOperation(x) => json.Value.Object([("TagColumnOperation", json_of_tag_column_operation(x))])
    UntagColumnOperation(x) => json.Value.Object([("UntagColumnOperation", json_of_untag_column_operation(x))])
    OverrideDatasetParameterOperation(x) => json.Value.Object([("OverrideDatasetParameterOperation", json_of_override_dataset_parameter_operation(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_transform_operation(v: json.Value) -> TransformOperation ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "ProjectOperation" => Ok(TransformOperation.ProjectOperation(from_json_project_operation(fv)?))
      "FilterOperation" => Ok(TransformOperation.FilterOperation(from_json_filter_operation(fv)?))
      "CreateColumnsOperation" => Ok(TransformOperation.CreateColumnsOperation(from_json_create_columns_operation(fv)?))
      "RenameColumnOperation" => Ok(TransformOperation.RenameColumnOperation(from_json_rename_column_operation(fv)?))
      "CastColumnTypeOperation" => Ok(TransformOperation.CastColumnTypeOperation(from_json_cast_column_type_operation(fv)?))
      "TagColumnOperation" => Ok(TransformOperation.TagColumnOperation(from_json_tag_column_operation(fv)?))
      "UntagColumnOperation" => Ok(TransformOperation.UntagColumnOperation(from_json_untag_column_operation(fv)?))
      "OverrideDatasetParameterOperation" => Ok(TransformOperation.OverrideDatasetParameterOperation(from_json_override_dataset_parameter_operation(fv)?))
      _ => Ok(TransformOperation.Unknown(k))
    }
  }
  Err("TransformOperation: no member set")
}

