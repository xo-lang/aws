      "MasterUserPassword" => out.master_user_password = c.text()
      "PreferredBackupWindow" => out.preferred_backup_window = c.text()
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "CloudwatchLogsExportConfiguration" => out.cloudwatch_logs_export_configuration = xml_read_cloudwatch_logs_export_configuration(c)?
      "EngineVersion" => out.engine_version = c.text()
      "AllowMajorVersionUpgrade" => out.allow_major_version_upgrade = xmlv.read_bool(c.text())?
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "StorageType" => out.storage_type = c.text()
      "ServerlessV2ScalingConfiguration" => out.serverless_v2_scaling_configuration = xml_read_serverless_v2_scaling_configuration(c)?
      "ManageMasterUserPassword" => out.manage_master_user_password = xmlv.read_bool(c.text())?
      "MasterUserSecretKmsKeyId" => out.master_user_secret_kms_key_id = c.text()
      "RotateMasterUserPassword" => out.rotate_master_user_password = xmlv.read_bool(c.text())?
      "NetworkType" => out.network_type = c.text()
      "CopyTagsToSnapshot" => out.copy_tags_to_snapshot = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
