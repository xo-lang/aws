fn json_of_event_tracker(v: EventTracker) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.event_tracker_arn {
    fs.push(("eventTrackerArn", json.Value.Str(x)))
  }
  if let Some(x) = v.account_id {
    fs.push(("accountId", json.Value.Str(x)))
  }
  if let Some(x) = v.tracking_id {
    fs.push(("trackingId", json.Value.Str(x)))
  }
  if let Some(x) = v.dataset_group_arn {
    fs.push(("datasetGroupArn", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x)))
  }
  if let Some(x) = v.creation_date_time {
    fs.push(("creationDateTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_updated_date_time {
