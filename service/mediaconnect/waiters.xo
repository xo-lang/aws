/// Wait until a flow is active
///
/// Calls DescribeFlow until the FlowActive acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (3s) to `max_delay` (120s).
pub fn wait_until_flow_active(c: Client, input: DescribeFlowRequest, max_wait: Duration, min_delay: Duration = 3s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeFlowErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_flow(input) {
      Ok(out) => {
        let o = jmes_of_describe_flow_response(out)
        if state == "" && waiter.path_matches(o, "Flow.Status", "stringEquals", "ACTIVE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Flow.Status", "stringEquals", "STARTING") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "Flow.Status", "stringEquals", "UPDATING") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "Flow.Status", "stringEquals", "STANDBY") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "Flow.Status", "stringEquals", "ERROR") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_flow(e)
        if state == "" && waiter.error_is(names, "InternalServerErrorException") {
          state = "retry"
        }
        if state == "" && waiter.error_is(names, "ServiceUnavailableException") {
          state = "retry"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("FlowActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

