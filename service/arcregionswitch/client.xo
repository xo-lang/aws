  }
}

fn from_json_execution_block_configuration(v: json.Value) -> ExecutionBlockConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "customActionLambdaConfig" => Ok(ExecutionBlockConfiguration.CustomActionLambdaConfig(from_json_custom_action_lambda_configuration(fv)?))
      "ec2AsgCapacityIncreaseConfig" => Ok(ExecutionBlockConfiguration.Ec2AsgCapacityIncreaseConfig(from_json_ec2_asg_capacity_increase_configuration(fv)?))
      "executionApprovalConfig" => Ok(ExecutionBlockConfiguration.ExecutionApprovalConfig(from_json_execution_approval_configuration(fv)?))
      "arcRoutingControlConfig" => Ok(ExecutionBlockConfiguration.ArcRoutingControlConfig(from_json_arc_routing_control_configuration(fv)?))
      "globalAuroraConfig" => Ok(ExecutionBlockConfiguration.GlobalAuroraConfig(from_json_global_aurora_configuration(fv)?))
      "parallelConfig" => Ok(ExecutionBlockConfiguration.ParallelConfig(from_json_parallel_execution_block_configuration(fv)?))
      "regionSwitchPlanConfig" => Ok(ExecutionBlockConfiguration.RegionSwitchPlanConfig(from_json_region_switch_plan_configuration(fv)?))
      "ecsCapacityIncreaseConfig" => Ok(ExecutionBlockConfiguration.EcsCapacityIncreaseConfig(from_json_ecs_capacity_increase_configuration(fv)?))
      "eksResourceScalingConfig" => Ok(ExecutionBlockConfiguration.EksResourceScalingConfig(from_json_eks_resource_scaling_configuration(fv)?))
      "route53HealthCheckConfig" => Ok(ExecutionBlockConfiguration.Route53HealthCheckConfig(from_json_route53_health_check_configuration(fv)?))
      "documentDbConfig" => Ok(ExecutionBlockConfiguration.DocumentDbConfig(from_json_document_db_configuration(fv)?))
      "rdsPromoteReadReplicaConfig" => Ok(ExecutionBlockConfiguration.RdsPromoteReadReplicaConfig(from_json_rds_promote_read_replica_configuration(fv)?))
      "rdsCreateCrossRegionReadReplicaConfig" => Ok(ExecutionBlockConfiguration.RdsCreateCrossRegionReadReplicaConfig(from_json_rds_create_cross_region_replica_configuration(fv)?))
      "lambdaEventSourceMappingConfig" => Ok(ExecutionBlockConfiguration.LambdaEventSourceMappingConfig(from_json_lambda_event_source_mapping_configuration(fv)?))
      "auroraServerlessScalingConfig" => Ok(ExecutionBlockConfiguration.AuroraServerlessScalingConfig(from_json_aurora_serverless_scaling_configuration(fv)?))
      "auroraProvisionedScalingConfig" => Ok(ExecutionBlockConfiguration.AuroraProvisionedScalingConfig(from_json_aurora_provisioned_scaling_configuration(fv)?))
      "neptuneGlobalDatabaseConfig" => Ok(ExecutionBlockConfiguration.NeptuneGlobalDatabaseConfig(from_json_neptune_global_database_configuration(fv)?))
      "rdsSwitchoverReadReplicaConfig" => Ok(ExecutionBlockConfiguration.RdsSwitchoverReadReplicaConfig(from_json_rds_switchover_read_replica_configuration(fv)?))
      "ssmSendCommandConfig" => Ok(ExecutionBlockConfiguration.SsmSendCommandConfig(from_json_ssm_send_command_configuration(fv)?))
      _ => Ok(ExecutionBlockConfiguration.Unknown(k))
    }
  }
  Err("ExecutionBlockConfiguration: no member set")
}

fn json_of_execution_event(v: ExecutionEvent) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.timestamp {
    fs.push(("timestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.type_value {
    fs.push(("type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.step_name {
    fs.push(("stepName", json.Value.Str(x)))
  }
  if let Some(x) = v.execution_block_type {
    fs.push(("executionBlockType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.resources {
    fs.push(("resources", json_of_resources(x)))
  }
  if let Some(x) = v.error {
    fs.push(("error", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.event_id {
    fs.push(("eventId", json.Value.Str(x)))
  }
  if let Some(x) = v.previous_event_id {
    fs.push(("previousEventId", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_execution_event(v: json.Value) -> ExecutionEvent ! Str {
  var out = ExecutionEvent{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "timestamp" => out.timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "type" => out.type_value = ExecutionEventType.from(jsonv.read_str(fv)?)
      "stepName" => out.step_name = jsonv.read_str(fv)?
      "executionBlockType" => out.execution_block_type = ExecutionBlockType.from(jsonv.read_str(fv)?)
      "resources" => out.resources = from_json_resources(fv)?
      "error" => out.error = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "eventId" => out.event_id = jsonv.read_str(fv)?
      "previousEventId" => out.previous_event_id = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_execution_event_list(v: List[ExecutionEvent]) -> json.Value {
  json.Value.List(v.map(fn(x: ExecutionEvent) -> json.Value { json_of_execution_event(x) }))
}

fn from_json_execution_event_list(v: json.Value) -> List[ExecutionEvent] ! Str {
  var out: List[ExecutionEvent] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_execution_event(fv)?)
  }
  Ok(out)
}

