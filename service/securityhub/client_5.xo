/// the control has StandardsControlsUpdatable value NOT_READY_FOR_UPDATES .
pub fn (c: Client) update_standards_control(input: UpdateStandardsControlRequest) -> UpdateStandardsControlResponse ! UpdateStandardsControlErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_standards_control(c.params, input)) ?? e => return Err(UpdateStandardsControlErr.InvalidInput(e))
  var req = serialize_update_standards_control(ep, input, "") ?? e => return Err(UpdateStandardsControlErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateStandardsControlErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_standards_control_error(resp))
  }
  deserialize_update_standards_control(resp) ?? e => Err(UpdateStandardsControlErr.Deserialize(e))
}
