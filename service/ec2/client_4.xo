      "Ipv6Prefix" => out.ipv6_prefixes = xml_read_ipv6_prefix_list(c)?
      "Ipv6PrefixCount" => out.ipv6_prefix_count = xmlv.read_int(c.text())?
      "PrimaryIpv6" => out.primary_ipv6 = xmlv.read_bool(c.text())?
      "EnaSrdSpecification" => out.ena_srd_specification = xml_read_ena_srd_specification_request(c)?
      "ConnectionTrackingSpecification" => out.connection_tracking_specification = xml_read_connection_tracking_specification_request(c)?
      "EnaQueueCount" => out.ena_queue_count = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_instance_network_interface_specification_list(var w: xmlv.Writer, v: List[InstanceNetworkInterfaceSpecification], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_instance_network_interface_specification(w, item, "item", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_network_interface_specification_list(e: xml.Element) -> List[InstanceNetworkInterfaceSpecification] ! Str {
  var out: List[InstanceNetworkInterfaceSpecification] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_instance_network_interface_specification(c)?)
  }
  Ok(out)
}

