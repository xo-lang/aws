// Flexible checksums (the aws.protocols#httpChecksum trait, as in
// aws-sdk-go-v2's service/internal/checksum): the request header an
// operation sends when the model requires a checksum or the caller picks
// an algorithm, and the check of a response checksum the caller asked to
// validate. Values are the digest's bytes in base64, CRCs big-endian.

use std/base64
use std/binary
use std/crc32
use std/crc64
use std/crypto

/// The algorithm used when an operation requires a checksum and the
/// caller named none (aws-sdk-go-v2's default).
pub const DEFAULT: Str = "CRC32"

/// The algorithms response validation prefers, strongest first among the
/// fast ones (aws-sdk-go-v2's order).
pub const VALIDATION_ORDER: List[Str] = ["CRC64NVME", "CRC32C", "CRC32", "SHA1", "SHA256", "SHA512", "MD5"]

/// The base64 checksum of `body` with `algorithm` (an enum value such as
/// "CRC32"), or None for an algorithm this SDK cannot compute.
pub fn compute(algorithm: Str, body: Bytes) -> Str? {
  let raw = match algorithm.to_upper() {
    "CRC32" => binary.u32_be(crc32.checksum(body))
    "CRC32C" => binary.u32_be(crc32.checksum(body, crc32.Poly.Castagnoli))
    "CRC64NVME" => binary.u64_be(crc64.checksum(body, crc64.Poly.Nvme))
    "SHA1" => crypto.digest(crypto.Hash.Sha1, body)
    "SHA256" => crypto.digest(crypto.Hash.Sha256, body)
    "SHA512" => crypto.digest(crypto.Hash.Sha512, body)
    "MD5" => crypto.digest(crypto.Hash.Md5, body)
    _ => return None
  }
  Some(base64.encode(raw))
}

/// The header that carries `algorithm`'s checksum.
pub fn header_name(algorithm: Str) -> Str {
  "x-amz-checksum-${algorithm.to_lower()}"
}

/// Whether `headers` already carry a checksum the caller supplied.
pub fn has_checksum(headers: List[(Str, Str)]) -> Bool {
  headers.any(fn(h: (Str, Str)) -> Bool {
    let n = h.0.to_lower()
    n.starts_with("x-amz-checksum-") && n != "x-amz-checksum-type" || n == "content-md5"
  })
}

/// Adds the request checksum: `algorithm` when the caller named one, else
/// DEFAULT when the operation requires one; nothing when the caller
/// already supplied a checksum header. Err for an algorithm this SDK
/// cannot compute.
pub fn add(var headers: List[(Str, Str)], body: Bytes, algorithm: Str?, required: Bool) -> () ! Str {
  if has_checksum(headers) {
    return Ok(())
  }
  let alg = match algorithm {
    Some(a) => a
    None => {
      if !required {
        return Ok(())
      }
      DEFAULT
    }
  }
  let v = compute(alg, body) ?? return Err("checksum algorithm ${alg} is not supported by this SDK")
  headers.push((header_name(alg), v))
  Ok(())
}

/// The algorithm of a streamed body's trailing checksum: as `add`
/// chooses it (the caller's, else DEFAULT when required), None when the
/// caller supplied a checksum header or none is wanted.
pub fn trailer(headers: List[(Str, Str)], algorithm: Str?, required: Bool) -> Str? {
  if has_checksum(headers) {
    return None
  }
  match algorithm {
    Some(a) => Some(a)
    None => if required { Some(DEFAULT) } else { None }
  }
}

/// The mismatch of a response checksum the caller asked to validate.
pub struct Mismatch {
  pub algorithm: Str
  pub expected: Str
  pub actual: Str
}

/// Checks `body` against the first checksum header the response carries,
/// in VALIDATION_ORDER. A multipart object's composite checksum (a value
/// ending `-<parts>`) cannot be checked against the whole body and is
/// skipped, as in aws-sdk-go-v2. Returns the algorithm checked, None when
/// there was nothing to check.
pub fn validate(headers: List[(Str, Str)], body: Bytes) -> Str? ! Mismatch {
  for alg in VALIDATION_ORDER {
    let name = header_name(alg)
    for h in headers {
      if h.0.to_lower() == name {
        if h.1.contains("-") {
          return Ok(None)
        }
        let actual = compute(alg, body) ?? ""
        if actual != h.1 {
          return Err(Mismatch{algorithm: alg, expected: h.1, actual: actual})
        }
        return Ok(Some(alg))
      }
    }
  }
  Ok(None)
}

/// Glacier's SHA-256 tree hash, in hex: the SHA-256 of each 1 MiB chunk,
/// then of each pair of hashes, level by level (an odd one is carried up
/// as is), as aws-sdk-go-v2's glacier customization computes it. "" for
/// an empty body.
pub fn tree_hash(body: Bytes) -> Str {
  let chunk = 1048576
  var level: List[Bytes] = []
  var i = 0
  while i < body.len() {
    let end = if i + chunk < body.len() { i + chunk } else { body.len() }
    level.push(crypto.digest(crypto.Hash.Sha256, body[i..end]))
    i = end
  }
  if level.is_empty() {
    return ""
  }
  while level.len() > 1 {
    var next: List[Bytes] = []
    var j = 0
    while j < level.len() {
      if j + 1 < level.len() {
        next.push(crypto.digest(crypto.Hash.Sha256, level[j] + level[j + 1]))
      } else {
        next.push(level[j])
      }
      j += 2
    }
    level = next
  }
  level[0].to_hex()
}

/// A checksum computed a piece at a time (a streamed body's trailer).
pub struct Running {
  pub algorithm: Str
  crc: Int = 0
  hasher: crypto.Hasher? = None
}

/// A running checksum of `algorithm`, or None for one this SDK cannot
/// compute.
pub fn running(algorithm: Str) -> Running? {
  let alg = algorithm.to_upper()
  match alg {
    "CRC32" | "CRC32C" | "CRC64NVME" => Some(Running{algorithm: alg})
    "SHA1" => Some(Running{algorithm: alg, hasher: Some(crypto.hasher(crypto.Hash.Sha1))})
    "SHA256" => Some(Running{algorithm: alg, hasher: Some(crypto.hasher(crypto.Hash.Sha256))})
    "SHA512" => Some(Running{algorithm: alg, hasher: Some(crypto.hasher(crypto.Hash.Sha512))})
    "MD5" => Some(Running{algorithm: alg, hasher: Some(crypto.hasher(crypto.Hash.Md5))})
    _ => None
  }
}

/// Adds `data` to the checksum.
pub fn write(var r: Running, data: Bytes) {
  match r.algorithm {
    "CRC32" => r.crc = crc32.update(r.crc, data)
    "CRC32C" => r.crc = crc32.update(r.crc, data, crc32.Poly.Castagnoli)
    "CRC64NVME" => r.crc = crc64.update(r.crc, data, crc64.Poly.Nvme)
    _ => if let Some(h) = r.hasher {
      var x = h
      x.write(data)
      r.hasher = Some(x)
    }
  }
}

/// The base64 checksum of everything written.
pub fn sum(r: Running) -> Str {
  let raw = match r.algorithm {
    "CRC32" | "CRC32C" => binary.u32_be(r.crc)
    "CRC64NVME" => binary.u64_be(r.crc)
    _ => r.hasher.map(fn(h: crypto.Hasher) -> Bytes { h.sum() }) ?? b""
  }
  base64.encode(raw)
}

/// The length of `algorithm`'s base64 checksum (0 for an unknown one).
pub fn encoded_len(algorithm: Str) -> Int {
  let n = match algorithm.to_upper() {
    "CRC32" | "CRC32C" => 4
    "CRC64NVME" => 8
    "SHA1" => 20
    "SHA256" => 32
    "SHA512" => 64
    "MD5" => 16
    _ => 0
  }
  (n + 2) / 3 * 4
}

/// The size of one chunk of the aws-chunked encoding (aws-sdk-go-v2's).
pub const CHUNK: Int = 65536

fn hex(n: Int) -> Str {
  if n == 0 {
    return "0"
  }
  let digits = "0123456789abcdef"
  var out = ""
  var v = n
  while v > 0 {
    out = digits[v % 16..v % 16 + 1] + out
    v = v / 16
  }
  out
}

/// One chunk of an unsigned aws-chunked body: its size in hex, CRLF, the
/// data, CRLF.
pub fn chunk(data: Bytes) -> Bytes {
  "${hex(data.len())}\r\n".bytes() + data + b"\r\n"
}

/// The end of an unsigned aws-chunked body: the zero chunk and the
/// checksum trailer (`x-amz-checksum-crc32:<value>`), then a blank line,
/// as aws-sdk-go-v2's unsigned aws-chunked encoding writes it.
pub fn chunked_end(algorithm: Str, value: Str) -> Bytes {
  "0\r\n${header_name(algorithm)}:${value}\r\n\r\n".bytes()
}

/// The encoded length of a `decoded` byte body sent in CHUNK sized
/// chunks with `algorithm`'s trailer: the request's Content-Length.
pub fn chunked_length(decoded: Int, algorithm: Str) -> Int {
  var n = 0
  var left = decoded
  while left > 0 {
    let c = if left > CHUNK { CHUNK } else { left }
    n += hex(c).len() + 2 + c + 2
    left -= c
  }
  n + 3 + header_name(algorithm).len() + 1 + encoded_len(algorithm) + 2 + 2
}
