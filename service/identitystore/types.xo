pub enum UserStatus: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// The request failed because it contains a syntax error.
pub struct ValidationException {
  pub message: Str? = None
  /// The identifier for each request. This value is a globally unique ID that
  /// is generated by the identity store service for each sent request, and is
  /// then returned inside the exception if the request fails.
  pub request_id: Str? = None
  /// Indicates the reason for the validation error when the service is unable
  /// to access a Customer Managed KMS key. For non-KMS permission errors,
  /// this field is not included.
  pub reason: ValidationExceptionReason? = None
}

pub enum ValidationExceptionReason: Str {
  KmsInvalidArn = "KMS_INVALID_ARN"
  KmsInvalidKeyUsage = "KMS_INVALID_KEY_USAGE"
  KmsInvalidState = "KMS_INVALID_STATE"
  KmsDisabled = "KMS_DISABLED"
  Unknown(value: Str)
}
