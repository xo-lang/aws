/// An image field's constraints and default.
pub struct ImageFieldType {
  /// Maximum accepted file size in bytes.
  pub max_size_bytes: Int? = None
  /// Accepted image formats.
  pub allowed_formats: List[ImageFormat]? = None
  /// The AWS-authored image the asset uses until the partner sets one: shown
  /// in previews and published in an empty slot of an email, landing page,
  /// banner ad or social post. It fills a required image field. A document
  /// leaves an empty image slot blank.
  pub default_value: LayoutPreview? = None
  /// The image size, in pixels, that fills this slot and prints sharply, for
  /// example 1920 x 301 for a full-width header. Shown to the partner as
  /// "Recommended: W x H px". Present, together with
  /// `RecommendedHeightPixels`, on document (PDF) image slots only, where the
  /// slot is a fixed rectangle. Such a slot is always filled: the image is
  /// scaled to cover it, centred, and clipped to it, the same as CSS
  /// `object-fit: cover`. An image whose shape is too far from W:H is refused
  /// with `IMAGE_ASPECT_RATIO_MISMATCH`; one narrower than W is accepted. A
  /// slot showing the partner's logo or badge, and a slot without the two
  /// members (every slot from before sizes existed), fits the image inside
  /// instead (`object-fit: contain`): a logo or a badge is never cropped.
  /// Email and landing-page image slots are laid out by HTML and carry
  /// neither.
  pub recommended_width_pixels: Int? = None
  /// The image height, in pixels, that fills this slot. Present exactly when
  /// `RecommendedWidthPixels` is.
  pub recommended_height_pixels: Int? = None
}

/// An accepted image format.
pub enum ImageFormat: Str {
  Png = "PNG"
  Jpeg = "JPEG"
  Unknown(value: Str)
}

/// Industry shape.
pub enum Industry: Str {
  FinancialServices = "FINANCIAL_SERVICES"
  Healthcare = "HEALTHCARE"
  Manufacturing = "MANUFACTURING"
  Retail = "RETAIL"
  MediaEntertainment = "MEDIA_ENTERTAINMENT"
  Energy = "ENERGY"
  Education = "EDUCATION"
  Government = "GOVERNMENT"
  Telecommunications = "TELECOMMUNICATIONS"
  Automotive = "AUTOMOTIVE"
  Insurance = "INSURANCE"
  Other = "OTHER"
  Unknown(value: Str)
}

/// An unexpected error occurred during the processing of the request.
pub struct InternalServerException {
  /// Error message.
  pub message: Str? = None
  /// Seconds before retry.
  pub retry_after_seconds: Int? = None
}

/// The format of a layout preview.
pub enum LayoutFormat: Str {
  Html = "HTML"
  Pdf = "PDF"
  Image = "IMAGE"
  Unknown(value: Str)
}

/// Which page of a multi-page layout a preview serves.
pub enum LayoutPageType: Str {
  Form = "FORM"
  Confirmation = "CONFIRMATION"
  Unknown(value: Str)
}

/// A rendering of an AWS-authored layout skeleton or placeholder image. The
/// url is a stable, cache-friendly CloudFront URL rather than a presigned
/// GET, because the bytes are AWS marketing content that is already public.
/// The key's random segment is the object's only protection, so the URL is
/// a bearer credential for the object and is withheld entirely while a
/// template is not yet effective — see
/// CampaignTemplate.EffectiveDateBegin.
pub struct LayoutPreview {
  /// The format of the referenced object.
  pub format: LayoutFormat? = None
  /// A stable URL serving the object. Not presigned, so it does not expire.
  pub url: Str? = None
  /// Which page of a multi-page layout this is. Present only for
  /// LANDING_PAGE, which genuinely has two layout objects — the page
  /// carrying the form, and the confirmation page shown after submit — and
  /// absent for every other category, which has one. A confirmation page is a
  /// second LAYOUT, never a second asset: modelling it as its own asset would
  /// give it a lifecycle, an activation and a state it does not have.
  pub page_type: LayoutPageType? = None
}

