  pub remediation_references: List[Str]? = None
}

/// A cloud or application resource a finding concerns.
pub struct FindingResource {
  pub uid: Str? = None
  pub name: Str? = None
  pub type_value: Str? = None
  pub region: Str? = None
}

/// A validator's severity conclusion. UNCHANGED means the producer's
/// reported severity stands.
pub enum FindingSeverityAdjustment: Str {
  Critical = "CRITICAL"
  High = "HIGH"
  Medium = "MEDIUM"
  Low = "LOW"
  Informational = "INFORMATIONAL"
  Unchanged = "UNCHANGED"
  Unknown(value: Str)
}

/// A finding's severity, on the canonical numeric scale OCSF defines
/// (UNKNOWN=0, INFORMATIONAL=1, LOW=2, MEDIUM=3, HIGH=4, CRITICAL=5,
/// FATAL=6, OTHER=99). Named rather than numeric so callers never map the
/// scale themselves, and identical across producers.
pub enum FindingSeverityId: Str {
  Unknown = "UNKNOWN"
  Informational = "INFORMATIONAL"
  Low = "LOW"
  Medium = "MEDIUM"
  High = "HIGH"
  Critical = "CRITICAL"
  Fatal = "FATAL"
  Other = "OTHER"
  UnknownValue(value: Str)
}

/// The lifecycle status of a finding as it moves through Continuum's
/// processing pipeline. CONFIRMED and DISCARDED are terminal states -- a
/// CONFIRMED finding is promoted into a separate Issue (not yet
/// implemented), which owns the subsequent remediation lifecycle; the
/// finding's own status does not change after that.
pub enum FindingStatus: Str {
  Submitted = "SUBMITTED"
  Validating = "VALIDATING"
  Confirmed = "CONFIRMED"
  Discarded = "DISCARDED"
  Unknown(value: Str)
}

/// A summary of a finding returned in list responses. Shares
/// FindingLifecycleFields with the read operations so the list and get
/// projections cannot drift. Carries a lean content subset -- fetch the
/// finding for its full contents.
pub struct FindingSummary {
  /// The unique identifier of the finding.
  pub finding_id: Str? = None
  /// The ARN of the finding.
  pub finding_arn: Str? = None
  /// The environment that owns the finding.
  pub environment_id: Str? = None
  /// The system that produced the finding.
  pub source: Str? = None
  /// The producer's own identifier for the finding.
  pub source_finding_id: Str? = None
  /// When the producer reported the finding -- its own clock, which is not
  /// Continuum's ingestion time. `createdAt` is when Continuum accepted it;
  /// these are genuinely different instants and a reader usually wants this
  /// one. For CreateCodeFinding, this is the submitted OCSF document's own
  /// top-level `time`. For findings Continuum's scanner produces, it is the
  /// finding's own creation time. Continuum does not validate it for
  /// plausibility: a producer's value is echoed as given, so a `timestamp`
  /// here asserts the unit and format, not that the instant is genuine.
  pub reported_at: Time? = None
  /// The current lifecycle status of the finding.
  pub status: FindingStatus? = None
  /// The timestamp when the status last transitioned.
  pub status_updated_at: Time? = None
  /// The timestamp when the finding was ingested.
  pub created_at: Time? = None
  /// The scan that produced the finding, when it came from one. For a finding
  /// Continuum's scanner produced, this is the Continuum scan run (see
  /// GetCodeScan). For a finding submitted with CreateCodeFinding, it is the
  /// OCSF document's `metadata.correlation_uid`, when that value is a valid
  /// ScanRunId. Absent when the finding did not come from a scan.
  pub scan_run_id: Str? = None
  /// Human-readable context about the current status.
  pub status_message: Str? = None
  /// Why the finding was not escalated. Present only when status is
  /// DISCARDED.
  pub discard_reason: FindingDiscardReason? = None
  /// Customer-facing explanation accompanying `discardReason`.
  pub discard_reasoning: Str? = None
  /// The existing issue this finding duplicates. Present only for the
  /// DUPLICATE_OF_* discard reasons.
  pub duplicate_of_issue_id: Str? = None
  /// The issue Continuum created from this finding.
  pub created_issue_id: Str? = None
  /// When processing finished, whether by creating an issue or discarding.
  /// Absent while the finding is still in flight.
  pub completed_at: Time? = None
  /// What kind of finding this is.
  pub type_value: FindingType? = None
  /// The producer's title for the finding.
  pub title: Str? = None
  /// The finding's severity.
  pub severity: FindingSeverityId? = None
  /// The producer's vulnerability category.
  pub category: Str? = None
  /// The file the finding is about, when it has a code location.
  pub file_path: Str? = None
}

/// What kind of finding this is, and who produced it.
pub enum FindingType: Str {
  ContinuumCodeVuln = "CONTINUUM_CODE_VULN"
  CustomerCodeVuln = "CUSTOMER_CODE_VULN"
  Unknown(value: Str)
}

/// A validator's assessment of a finding. Present only when validation
/// actually ran -- absent for finding types that are ingested untested,
/// rather than reporting a verdict Continuum did not reach.
pub struct FindingValidation {
  /// The validator's conclusion.
  pub verdict: FindingVerdict? = None
  /// Why the validator reached that verdict.
  pub blocking_reason: FindingBlockingReason? = None
  /// The validator's confidence, from 0.0 to 1.0 inclusive. Advisory: it does
  /// not drive Continuum's own routing decisions. The range is enforced
  /// server-side, not by a @range trait -- the smithy-rs server SDK does not
  /// support range constraints on double shapes (smithy-rs#2007).
  pub confidence: Float? = None
  /// The validator's reasoning.
  pub rationale: Str? = None
  /// The validator's severity conclusion.
  pub severity_adjustment: FindingSeverityAdjustment? = None
  /// Controls the validator found that reduce exploitability.
  pub mitigating_controls: List[Str]? = None
  /// Conditions exploitation depends on, which bound the severity.
  pub preconditions: List[Str]? = None
  /// Code citations supporting the verdict.
  pub evidence: List[FindingEvidence]? = None
}

/// A validator's conclusion about whether a finding is real.
pub enum FindingVerdict: Str {
  TruePositive = "TRUE_POSITIVE"
  FalsePositive = "FALSE_POSITIVE"
  BenignTruePositive = "BENIGN_TRUE_POSITIVE"
  NeedsReview = "NEEDS_REVIEW"
  Unknown(value: Str)
}

/// One vulnerability reported by a finding. A customer document may report
/// several; each carries its own identity, locations and remediation.
pub struct FindingVulnerability {
  pub title: Str? = None
  pub description: Str? = None
  /// Primary CWE for this vulnerability, e.g. "CWE-89".
  pub cwe_id: Str? = None
  /// The producer's human-readable caption for `cweId`.
  pub cwe_caption: Str? = None
  /// Further CWEs the producer attributed to this same vulnerability.
  pub additional_cwe_ids: List[Str]? = None
  pub cve_id: Str? = None
  /// The CVSS base score for `cveId`, when the producer supplies one, from
  /// 0.0 to 10.0.
  pub cvss_base_score: Float? = None
  /// The producer's description of how completely a fix is available.
  pub fix_coverage: Str? = None
  /// The producer's enum value behind `fixCoverage`.
  pub fix_coverage_id: Int? = None
  /// Every location this vulnerability was reported at.
  pub locations: List[FindingLocation]? = None
  pub remediation: Str? = None
  pub remediation_references: List[Str]? = None
  /// The vulnerable fragment, when the producer supplied one.
  pub code: Str? = None
  /// The producer's extended analysis for this vulnerability.
  pub details: Str? = None
  pub affected_packages: List[AffectedPackage]? = None
}

/// Validation's verdict for one attack flow.
pub struct FlowVerdict {
  /// Identifier of the attack flow assessed.
  pub flow_id: Str? = None
  /// Outcome for this flow.
  pub verdict: FlowVerdictValue? = None
  /// Confidence in this flow's verdict. Absent when out of range.
  pub confidence: Float? = None
  /// Citations supporting the verdict.
  pub evidence: List[Str]? = None
}

/// Outcome recorded for one attack flow.
pub enum FlowVerdictValue: Str {
  Confirmed = "CONFIRMED"
  Denied = "DENIED"
  Inconclusive = "INCONCLUSIVE"
  Unknown(value: Str)
}

/// Specifies the finding to retrieve.
pub struct GetCodeFindingInput {
  /// The environment that owns the finding.
  pub environment_id: Str? = None
  /// The unique identifier of the finding to retrieve.
  pub finding_id: Str? = None
}

/// Contains the current state and details of the requested finding. Which
/// type-specific members are populated depends on `type`.
pub struct GetCodeFindingOutput {
  /// What kind of finding this is. Determines which of the type-specific
  /// members below are populated.
  pub type_value: FindingType? = None
  /// The producer's title for the finding.
  pub title: Str? = None
  /// The finding's severity.
  pub severity: FindingSeverityId? = None
  /// A one-paragraph description.
  pub summary: Str? = None
  /// The full analysis.
  pub detailed_description: Str? = None
  /// The producer's vulnerability category. Not a stable filter key across
  /// finding types -- see FindingCategory.
  pub category: Str? = None
  /// A more specific classification within `category`.
  pub sub_category: Str? = None
  /// CWE identifiers classifying the finding.
  pub cwe_ids: List[Str]? = None
  /// The OWASP Top 10 category, when the producer supplies one.
  pub owasp_category: Str? = None
  /// How to fix the finding.
  pub mitigation: Str? = None
  /// The file the finding is about.
  pub file_path: Str? = None
  /// The 1-indexed line the finding is about. Bounds are enforced server-side
  /// rather than by a constraint trait: a numeric constraint generates a
  /// distinct newtype per enclosing structure, so the same concept would not
  /// share a type across the create input and the read output.
  pub line_number: Int? = None
  /// The CVE this finding reports, for software-composition findings. Both
  /// code types can carry one: a customer document supplies it under
  /// vulnerabilities[].cve, and Continuum's scanner reports CVEs for
  /// dependency-manifest findings.
  pub cve_id: Str? = None
  /// The CVSS base score accompanying `cveId`, when the producer supplies
  /// one, from 0.0 to 10.0. Not computed by Continuum. The range is enforced
  /// server-side, not by a @range trait -- the smithy-rs server SDK does not
  /// support range constraints on double shapes (smithy-rs#2007).
  pub cvss_base_score: Float? = None
  /// Packages implicated by the finding.
  pub affected_packages: List[AffectedPackage]? = None
  /// The vulnerable code fragment.
  pub vulnerable_code: Str? = None
  /// User-controlled inputs that reach the vulnerability.
  pub relevant_inputs: List[Str]? = None
  /// Steps to reproduce or exploit the finding.
  pub steps_to_reproduce: List[Str]? = None
  /// The validator's assessment. Absent when no validation ran.
  pub validation: FindingValidation? = None
  /// The last line of the affected range, from the document's
  /// affected_code[].end_line.
  pub end_line: Int? = None
  /// MITRE ATT&CK technique identifiers, from the document's
  /// finding_info.attacks[].technique.uid.
  pub mitre_techniques: List[Str]? = None
  /// Remediation references, from the document's
  /// vulnerabilities[].remediation.references.
  pub remediation_references: List[Str]? = None
  /// The OCSF class the document declared. Determines whether `posture` is
  /// populated.
  pub ocsf_class: FindingOcsfClass? = None
  /// The OCSF schema version the producer wrote against (metadata.version).
  pub ocsf_schema_version: Str? = None
  /// The producing product and vendor (metadata.product).
  pub product_name: Str? = None
  pub product_vendor_name: Str? = None
  pub product_version: Str? = None
  /// The producer's own status for the finding, and the enum value behind it.
  /// Distinct from `status`, which is Continuum's lifecycle state -- a
  /// producer may call a finding "New" while Continuum has it SUBMITTED.
  pub source_status: Str? = None
  /// The producer's numeric enum value for `sourceStatus`.
  pub source_status_id: Int? = None
  /// When the producer first observed the finding
  /// (finding_info.first_seen_time). The producer's own clock, not
  /// Continuum's.
  pub first_seen_at: Time? = None
  /// The producer's own classification of the finding (finding_info.types).
  pub finding_types: List[Str]? = None
  /// Every vulnerability the document reported. A document may report
  /// several; the flat `cveId`/`cvssBaseScore`/`filePath`/`lineNumber`
  /// members above carry the first one's identity so a caller that only needs
  /// "what and where" does not have to walk this list.
  pub vulnerabilities: List[FindingVulnerability]? = None
  /// Resources the document named (resources[]).
  pub resources: List[FindingResource]? = None
  /// The compliance posture, for an Application Security Posture Finding.
  /// Absent for a vulnerability finding.
  pub posture: FindingPosture? = None
  /// The unique identifier of the finding.
  pub finding_id: Str? = None
  /// The ARN of the finding.
  pub finding_arn: Str? = None
  /// The environment that owns the finding.
  pub environment_id: Str? = None
  /// The system that produced the finding.
  pub source: Str? = None
  /// The producer's own identifier for the finding.
  pub source_finding_id: Str? = None
  /// When the producer reported the finding -- its own clock, which is not
  /// Continuum's ingestion time. `createdAt` is when Continuum accepted it;
  /// these are genuinely different instants and a reader usually wants this
  /// one. For CreateCodeFinding, this is the submitted OCSF document's own
  /// top-level `time`. For findings Continuum's scanner produces, it is the
  /// finding's own creation time. Continuum does not validate it for
  /// plausibility: a producer's value is echoed as given, so a `timestamp`
  /// here asserts the unit and format, not that the instant is genuine.
  pub reported_at: Time? = None
  /// The current lifecycle status of the finding.
  pub status: FindingStatus? = None
  /// The timestamp when the status last transitioned.
  pub status_updated_at: Time? = None
  /// The timestamp when the finding was ingested.
  pub created_at: Time? = None
  /// The scan that produced the finding, when it came from one. For a finding
  /// Continuum's scanner produced, this is the Continuum scan run (see
  /// GetCodeScan). For a finding submitted with CreateCodeFinding, it is the
  /// OCSF document's `metadata.correlation_uid`, when that value is a valid
  /// ScanRunId. Absent when the finding did not come from a scan.
  pub scan_run_id: Str? = None
  /// Human-readable context about the current status.
  pub status_message: Str? = None
  /// Why the finding was not escalated. Present only when status is
  /// DISCARDED.
  pub discard_reason: FindingDiscardReason? = None
  /// Customer-facing explanation accompanying `discardReason`.
  pub discard_reasoning: Str? = None
  /// The existing issue this finding duplicates. Present only for the
  /// DUPLICATE_OF_* discard reasons.
  pub duplicate_of_issue_id: Str? = None
  /// The issue Continuum created from this finding.
  pub created_issue_id: Str? = None
  /// When processing finished, whether by creating an issue or discarding.
  /// Absent while the finding is still in flight.
  pub completed_at: Time? = None
}

/// Specifies the artifact to retrieve.
pub struct GetCodeIssueArtifactInput {
  /// The environment that owns the issue.
  pub environment_id: Str? = None
  /// The issue the artifact is attached to.
  pub issue_id: Str? = None
  /// The unique identifier of the artifact to retrieve.
  pub artifact_id: Str? = None
}

/// Contains the requested artifact and its content.
pub struct GetCodeIssueArtifactOutput {
  /// The unique identifier of the artifact.
  pub artifact_id: Str? = None
  /// Semantic category of the artifact.
  pub artifact_type: IssueArtifactType? = None
  /// MIME type the producer declared for its content.
  pub media_type: Str? = None
  /// The artifact body, projected against the shape defined for its
  /// artifactType. A type with a defined shape is returned as that structure,
  /// and anything else through `IssueArtifactBody.raw`.
  pub body: IssueArtifactBody? = None
  /// Producer-defined structured metadata, when the producer supplied any.
  /// Returned only for an artifactType whose content has no defined shape, so
  /// that the artifact stays inspectable. For an artifactType with a defined
  /// shape, `body` carries the content and this member is omitted.
  pub metadata: json.Value? = None
  /// The agent that produced the artifact.
  pub producer: IssueArtifactProducerSummary? = None
  /// The timestamp when the artifact was created.
  pub created_at: Time? = None
}

/// Specifies the issue to retrieve.
pub struct GetCodeIssueInput {
  /// The environment that owns the issue.
  pub environment_id: Str? = None
  /// The unique identifier of the issue to retrieve.
  pub issue_id: Str? = None
}

/// Contains the current state and details of the requested issue.
pub struct GetCodeIssueOutput {
  /// The unique identifier of the issue.
  pub issue_id: Str? = None
  /// The ARN of the issue.
  pub issue_arn: Str? = None
  /// The name of the issue.
  pub name: Str? = None
  /// A free-form synopsis of the issue.
  pub synopsis: Str? = None
  /// Current severity: the FindingSeverity seed at create, overwritten by the
  /// authoritative severity that prioritization assigns after validation.
  pub severity: IssueSeverity? = None
  /// The likelihood that this issue is a true positive, expressed as a
  /// percentage (0-100).
  pub confidence: Int? = None
  /// The justification for the current severity. Always leads with a
  /// customer-facing basis clause synthesized from how the severity was
  /// determined (e.g. "Severity from finding.", "Severity from Continuum
  /// system."); when prioritization has run, its own reasoning follows.
  /// Issues created before the basis clause was introduced return their
  /// original reasoning without it.
  pub severity_reasoning: Str? = None
  /// The remediation completion summary, when the green stage has run.
  pub summary: Str? = None
  /// The findings that motivated this issue. Bare identifiers only -- a
  /// caller authorized for GetCodeIssue is not necessarily authorized to read
  /// finding detail; call GetCodeFinding for that. Every referenced finding
  /// is included regardless of origin (both CustomerUploaded and
  /// ContinuumScanner).
  pub finding_ids: List[Str]? = None
  /// The current lifecycle status of the issue.
  pub status: IssueStatus? = None
  /// The part of the workflow the issue is in. Present when status is
  /// IN_PROGRESS, and when status is FAILED and the failing phase is known.
  pub phase: IssuePhase? = None
  /// Why the issue failed. Present only when status is FAILED.
  pub status_reason: IssueStatusReason? = None
  /// Customer-facing explanation of statusReason. Present only when status is
  /// FAILED.
  pub status_message: Str? = None
  /// The timestamp when the status or phase last changed.
  pub status_updated_at: Time? = None
  /// The timestamp when the issue was created.
  pub created_at: Time? = None
  /// The timestamp when any field of the issue last changed. Advances on
  /// every mutation (including score-only updates that do not transition
  /// status), so it is greater than or equal to statusUpdatedAt.
  pub updated_at: Time? = None
  /// Whether the issue has any attached evidence (formerly 'artifacts': tool
  /// output, remediation proposals, patches). NONE = no evidence; AVAILABLE =
  /// at least one evidence item exists. Computed at read time.
  pub evidence_availability: IssueEvidenceAvailability? = None
  /// Customer delivery of the issue's patches, summarized from its PATCH
  /// artifacts at read time. Absent when no patch has a destination delivery.
  pub patch_delivery: IssuePatchDelivery? = None
}

pub struct GetCodeScanInput {
  /// Environment that owns the scan.
  pub environment_id: Str? = None
  /// Scan to retrieve.
  pub scan_run_id: Str? = None
}

pub struct GetCodeScanOutput {
  /// Complete customer-visible scan data.
  pub scan: CodeScanData? = None
}

