pub struct DistributionTenantSummary {
  /// The ID of the distribution tenant.
  pub id: Str? = None
  /// The identifier for the multi-tenant distribution. For example:
  /// EDFDVBD632BHDS5 .
  pub distribution_id: Str? = None
  /// The name of the distribution tenant.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the distribution tenant.
  pub arn: Str? = None
  /// The domains associated with the distribution tenant.
  pub domains: List[DomainResult]? = None
  /// The ID of the connection group ID for the distribution tenant. If you
  /// don't specify a connection group, CloudFront uses the default connection
  /// group.
  pub connection_group_id: Str? = None
  /// Customizations for the distribution tenant. For each distribution
  /// tenant, you can specify the geographic restrictions, and the Amazon
  /// Resource Names (ARNs) for the ACM certificate and WAF web ACL. These are
  /// specific values that you can override or disable from the multi-tenant
  /// distribution that was used to create the distribution tenant.
  pub customizations: Customizations? = None
  /// The date and time when the distribution tenant was created.
  pub created_time: Time? = None
  /// The date and time when the distribution tenant was updated.
  pub last_modified_time: Time? = None
  /// The current version of the distribution tenant.
  pub e_tag: Str? = None
  /// Indicates whether the distribution tenants are in an enabled state. If
  /// disabled, the distribution tenant won't service traffic.
  pub enabled: Bool? = None
  /// The status of the distribution tenant.
  pub status: Str? = None
}

/// The DNS configuration for your domain names.
pub struct DnsConfiguration {
  /// The domain name that you're verifying.
  pub domain: Str? = None
  /// The status of your domain name. valid-configuration : The domain name is
  /// correctly configured and points to the correct routing endpoint of the
  /// connection group. invalid-configuration : There is either a missing DNS
  /// record or the DNS record exists but it's using an incorrect routing
  /// endpoint. Update the DNS record to point to the correct routing
  /// endpoint. unknown-configuration : CloudFront can't validate your DNS
  /// configuration. This status can appear if CloudFront can't verify the DNS
  /// record, or the DNS lookup request failed or timed out.
  pub status: DnsConfigurationStatus? = None
  /// Explains the status of the DNS configuration.
  pub reason: Str? = None
}

pub enum DnsConfigurationStatus: Str {
  Valid = "valid-configuration"
  Invalid = "invalid-configuration"
  Unknown = "unknown-configuration"
  UnknownValue(value: Str)
}

/// Contains information about the domain conflict. Use this information to
