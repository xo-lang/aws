fn json_of_query_summary(v: QuerySummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.query_identifier {
    fs.push(("queryIdentifier", json.Value.Int(x)))
  }
  if let Some(x) = v.query {
    fs.push(("query", json.Value.Str(x)))
  }
  if let Some(x) = v.response {
    fs.push(("response", json.Value.Str(x)))
  }
  if let Some(x) = v.review_type {
