/// Waits until a contact has been scheduled
///
/// Calls DescribeContact until the ContactScheduled acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (900s).
pub fn wait_until_contact_scheduled(c: Client, input: DescribeContactRequest, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 900s) -> () ! waiter.WaitErr[DescribeContactErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_contact(input) {
      Ok(out) => {
        let o = jmes_of_describe_contact_response(out)
        if state == "" && waiter.path_matches(o, "contactStatus", "stringEquals", "FAILED_TO_SCHEDULE") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "contactStatus", "stringEquals", "SCHEDULED") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ContactScheduled: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

