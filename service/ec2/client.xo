  }
  if let Some(x) = v.subnet_ids {
    xml_write_value_string_list(w, x, "subnetIds", [])
  }
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "creationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.options {
    xml_write_transit_gateway_vpc_attachment_options(w, x, "options", [])
  }
