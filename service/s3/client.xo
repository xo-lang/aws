fn xml_write_metadata(var w: xmlv.Writer, v: Map[Str, Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", item, [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_metadata(e: xml.Element) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, vc.text())
    }
  }
  Ok(out)
}

