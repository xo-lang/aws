pub struct MetricCalculation {
  /// The list of component metrics referenced in the calculation formula.
  /// Each component has an alias used in the formula expression.
  pub calculation_components: List[CalculationComponent]? = None
  /// The formula expression that defines how the metric is calculated. Uses
  /// component aliases (for example, 100 * SUM(M1) / SUM(M2) ).
  pub calculation: Str? = None
}

/// The method used to create a custom metric. Valid values:
/// SERVICE_LEVEL_BUILDER | METRIC_BUILDER .
pub enum MetricCreationMethod: Str {
  ServiceLevelBuilder = "SERVICE_LEVEL_BUILDER"
  MetricBuilder = "METRIC_BUILDER"
  Unknown(value: Str)
}

/// Contains the name, thresholds, and metric filters.
pub struct MetricDataV2 {
  /// The metric name or metricId, thresholds, and metric filters of the
  /// returned metric.
  pub metric: MetricV2? = None
  /// The corresponding value of the metric returned in the response.
  pub value: Float? = None
}

/// Contains the full definition of a metric, including its calculation,
/// unit, status, and trend indicator.
pub struct MetricDefinition {
  /// The Amazon Resource Name (ARN) of the metric. May be qualified with
  /// $SAVED or $LATEST .
  pub arn: Str? = None
  /// The identifier of the metric.
  pub id: Str? = None
  /// The name of the metric.
  pub name: Str? = None
  /// The description of the metric.
  pub description: Str? = None
  /// The calculation definition for the metric.
  pub metric_calculation: MetricCalculation? = None
  /// The method used to create the metric. Valid values:
  /// SERVICE_LEVEL_BUILDER (created with the guided service-level experience)
  /// | METRIC_BUILDER (created with the free-form metric builder).
  pub creation_method: MetricCreationMethod? = None
  /// The publish status of the metric. Valid values: PUBLISHED | SAVED .
  pub status: MetricStatus? = None
  /// The type of the metric. Valid values: AWS_MANAGED | CUSTOMER_MANAGED .
  pub type_value: MetricType? = None
  /// The display unit for the metric's data.
  pub unit: MetricUnit? = None
  /// How an increase in the metric value should be interpreted. Valid values:
  /// POSITIVE , NEUTRAL , NEGATIVE .
  pub positive_trend_indicator: TrendIndicator? = None
  /// The groupings available for this metric.
  pub groupings: List[Str]? = None
  /// The filters applied to the metric.
  pub filters: List[AvailableFilter]? = None
  /// The earliest time that can be queried for this metric.
  pub effective_time: Time? = None
  /// The minimum interval, in seconds, between data refreshes for this
  /// metric.
  pub refresh_rate: Int? = None
  /// The category of the metric.
  pub category: Str? = None
  /// The stat aggregations available for this metric.
  pub supported_stats: List[Str]? = None
  /// The default stat aggregation for the metric.
  pub default_stat: Str? = None
  /// Specifies whether the metric can be used inside aggregating statistical
  /// functions (SUM, AVG, etc.) in custom metric calculations.
  pub supports_preaggregate_calculation: Bool? = None
  /// Specifies whether the metric can be used as a component of custom
  /// metrics.
  pub supports_custom_calculation: Bool? = None
  /// The primary event source for the metric data.
  pub primary_event_source: Str? = None
  /// The timestamp type that determines where the metric appears on a time
  /// series.
  pub primary_event_source_effective_timestamp_type: Str? = None
  /// The timestamp of when the metric was created.
  pub created_time: Time? = None
  /// The user that created the metric. The creator for metrics created
  /// through the CreateMetric API will be Amazon Connect API .
  pub created_user: CreatedByInfo? = None
  /// The region where the metric was last modified.
  pub last_modified_region: Str? = None
  /// The timestamp of when the metric was last modified.
  pub last_modified_time: Time? = None
  /// The user that last modified the metric. For modifications made through
  /// the API, this will be Amazon Connect API .
  pub last_modified_user: CreatedByInfo? = None
  /// The tags used to organize, track, or control access for this resource.
  /// For example, { "Tags": {"key1":"value1", "key2":"value2"} }.
  pub tags: Map[Str, Str]? = None
}

/// A filter condition applied to a metric component in a calculation.
/// Filters restrict the data included in the metric computation.
pub struct MetricFilter {
  /// The key identifying the field to filter on.
  pub metric_filter_key: Str? = None
  /// Specifies whether the filter condition is negated. When set to true ,
  /// the filter excludes matching data instead of including it.
  pub negate: Bool? = None
  /// A numeric comparison condition.
  pub number_condition: MetricFilterNumberCondition? = None
  /// A string comparison condition.
  pub string_condition: MetricFilterStringCondition? = None
  /// A boolean comparison condition.
  pub boolean_condition: MetricFilterBooleanCondition? = None
}

/// A boolean comparison condition for metric filters.
pub struct MetricFilterBooleanCondition {
  /// The comparison operator. Valid values: IS_TRUE (matches when the field
  /// is true) | IS_FALSE (matches when the field is false).
  pub comparison: MetricFilterBooleanConditionComparison? = None
}

/// The boolean comparison operator for metric filters. Valid values:
/// IS_TRUE | IS_FALSE .
pub enum MetricFilterBooleanConditionComparison: Str {
  IsTrue = "IS_TRUE"
  IsFalse = "IS_FALSE"
  Unknown(value: Str)
}

/// A numeric comparison condition for metric filters.
pub struct MetricFilterNumberCondition {
  /// The comparison operator. Valid values: LESSER (less than) |
  /// LESSER_OR_EQUAL (less than or equal to) | GREATER (greater than) |
  /// GREATER_OR_EQUAL (greater than or equal to).
  pub comparison: MetricFilterNumberConditionComparison? = None
  /// The numeric values to compare against.
  pub values: List[Float]? = None
}

/// The numeric comparison operator for metric filters. Valid values: LESSER
/// | LESSER_OR_EQUAL | GREATER | GREATER_OR_EQUAL .
pub enum MetricFilterNumberConditionComparison: Str {
  Lesser = "LESSER"
  LesserOrEqual = "LESSER_OR_EQUAL"
  Greater = "GREATER"
  GreaterOrEqual = "GREATER_OR_EQUAL"
  Unknown(value: Str)
}

/// A string comparison condition for metric filters.
pub struct MetricFilterStringCondition {
  /// The comparison operator. Valid values: MATCHES_ANY (matches any of the
  /// specified values) | MATCHES_NONE (matches none of the specified values).
  pub comparison: MetricFilterStringConditionComparison? = None
  /// The string values to compare against.
  pub values: List[Str]? = None
}

/// The string comparison operator for metric filters. Valid values:
/// MATCHES_ANY | MATCHES_NONE .
pub enum MetricFilterStringConditionComparison: Str {
  MatchesAny = "MATCHES_ANY"
  MatchesNone = "MATCHES_NONE"
  Unknown(value: Str)
}

/// Contains information about the filter used when retrieving metrics.
/// MetricFiltersV2 can be used on the following metrics:
/// AVG_AGENT_CONNECTING_TIME , CONTACTS_CREATED , CONTACTS_HANDLED ,
/// SUM_CONTACTS_DISCONNECTED .
pub struct MetricFilterV2 {
  /// The key to use for filtering data. Valid metric filter keys:
  /// ANSWERING_MACHINE_DETECTION_STATUS CASE_STATUS DISCONNECT_REASON
  /// FLOWS_ACTION_IDENTIFIER FLOWS_NEXT_ACTION_IDENTIFIER FLOWS_OUTCOME_TYPE
  /// FLOWS_RESOURCE_TYPE INITIATION_METHOD
  pub metric_filter_key: Str? = None
  /// The values to use for filtering data. Values for metric-level filters
  /// can be either a fixed set of values or a customized list, depending on
  /// the use case. For valid values of metric-level filters INITIATION_METHOD
  /// , DISCONNECT_REASON , and ANSWERING_MACHINE_DETECTION_STATUS , see
  /// ContactTraceRecord in the Connect Customer Administrator Guide . For
  /// valid values of the metric-level filter FLOWS_OUTCOME_TYPE , see the
  /// description for the Flow outcome metric in the Connect Customer
  /// Administrator Guide . For valid values of the metric-level filter
  /// BOT_CONVERSATION_OUTCOME_TYPE , see the description for the Bot
  /// conversations completed in the Connect Customer Administrator Guide .
  /// For valid values of the metric-level filter BOT_INTENT_OUTCOME_TYPE ,
  /// see the description for the Bot intents completed metric in the Connect
  /// Customer Administrator Guide .
  pub metric_filter_values: List[Str]? = None
  /// If set to true , the API response contains results that filter out the
  /// results matched by the metric-level filters condition. By default,
  /// Negate is set to false .
  pub negate: Bool? = None
}

/// The interval period with the start and end time for the metrics.
pub struct MetricInterval {
  /// The interval period provided in the API request.
  pub interval: IntervalPeriod? = None
  /// The timestamp, in UNIX Epoch time format. Start time is based on the
  /// interval period selected.
  pub start_time: Time? = None
  /// The timestamp, in UNIX Epoch time format. End time is based on the
  /// interval period selected. For example, If IntervalPeriod is selected
  /// THIRTY_MIN , StartTime and EndTime in the API request differs by 1 day,
  /// then 48 results are returned in the response. Each result is aggregated
  /// by the 30 minutes period, with each StartTime and EndTime differing by
  /// 30 minutes.
  pub end_time: Time? = None
}

/// Contains information about the metric results.
pub struct MetricResultV2 {
  /// The dimension for the metrics.
  pub dimensions: Map[Str, Str]? = None
  /// The interval period with the start and end time for the metrics.
  pub metric_interval: MetricInterval? = None
  /// The set of metrics.
  pub collections: List[MetricDataV2]? = None
}

