    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateUserSettingsErr.ThrottlingException(x)
      Err(msg) => return UpdateUserSettingsErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateUserSettingsErr.ValidationException(x)
      Err(msg) => return UpdateUserSettingsErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateUserSettingsErr.Api(restjson.api_error(resp, body))
}

/// Updates the user settings.
pub fn (c: Client) update_user_settings(input: UpdateUserSettingsRequest) -> UpdateUserSettingsResponse ! UpdateUserSettingsErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_user_settings(c.params, input)) ?? e => return Err(UpdateUserSettingsErr.InvalidInput(e))
  var req = serialize_update_user_settings(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateUserSettingsErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateUserSettingsErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_user_settings_error(resp))
  }
  deserialize_update_user_settings(resp) ?? e => Err(UpdateUserSettingsErr.Deserialize(e))
}
