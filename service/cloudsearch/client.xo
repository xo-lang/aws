fn xml_write_index_field(var w: xmlv.Writer, v: IndexField, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.index_field_name {
    xmlv.elem(w, "IndexFieldName", x, [])
  }
  if let Some(x) = v.index_field_type {
    xmlv.elem(w, "IndexFieldType", x.value(), [])
  }
  if let Some(x) = v.int_options {
    xml_write_int_options(w, x, "IntOptions", [])
  }
  if let Some(x) = v.double_options {
    xml_write_double_options(w, x, "DoubleOptions", [])
  }
  if let Some(x) = v.literal_options {
    xml_write_literal_options(w, x, "LiteralOptions", [])
  }
  if let Some(x) = v.text_options {
    xml_write_text_options(w, x, "TextOptions", [])
  }
  if let Some(x) = v.date_options {
    xml_write_date_options(w, x, "DateOptions", [])
  }
  if let Some(x) = v.lat_lon_options {
    xml_write_lat_lon_options(w, x, "LatLonOptions", [])
  }
  if let Some(x) = v.int_array_options {
    xml_write_int_array_options(w, x, "IntArrayOptions", [])
  }
  if let Some(x) = v.double_array_options {
    xml_write_double_array_options(w, x, "DoubleArrayOptions", [])
  }
  if let Some(x) = v.literal_array_options {
    xml_write_literal_array_options(w, x, "LiteralArrayOptions", [])
  }
  if let Some(x) = v.text_array_options {
    xml_write_text_array_options(w, x, "TextArrayOptions", [])
  }
  if let Some(x) = v.date_array_options {
    xml_write_date_array_options(w, x, "DateArrayOptions", [])
  }
  xmlv.end(w, name)
}

fn xml_read_index_field(e: xml.Element) -> IndexField ! Str {
  var out = IndexField{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "IndexFieldName" => out.index_field_name = c.text()
      "IndexFieldType" => out.index_field_type = IndexFieldType.from(c.text())
      "IntOptions" => out.int_options = xml_read_int_options(c)?
      "DoubleOptions" => out.double_options = xml_read_double_options(c)?
      "LiteralOptions" => out.literal_options = xml_read_literal_options(c)?
      "TextOptions" => out.text_options = xml_read_text_options(c)?
      "DateOptions" => out.date_options = xml_read_date_options(c)?
      "LatLonOptions" => out.lat_lon_options = xml_read_lat_lon_options(c)?
      "IntArrayOptions" => out.int_array_options = xml_read_int_array_options(c)?
      "DoubleArrayOptions" => out.double_array_options = xml_read_double_array_options(c)?
      "LiteralArrayOptions" => out.literal_array_options = xml_read_literal_array_options(c)?
      "TextArrayOptions" => out.text_array_options = xml_read_text_array_options(c)?
      "DateArrayOptions" => out.date_array_options = xml_read_date_array_options(c)?
      _ => {}
    }
  }
  Ok(out)
}

