  xmlv.start(w, name, attrs)
  if let Some(x) = v.transit_gateway_route_table_id {
    xmlv.elem(w, "transitGatewayRouteTableId", x, [])
  }
  if let Some(x) = v.transit_gateway_id {
    xmlv.elem(w, "transitGatewayId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.default_association_route_table {
    xmlv.elem(w, "defaultAssociationRouteTable", "${x}", [])
  }
  if let Some(x) = v.default_propagation_route_table {
    xmlv.elem(w, "defaultPropagationRouteTable", "${x}", [])
  }
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "creationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_transit_gateway_route_table(e: xml.Element) -> TransitGatewayRouteTable ! Str {
  var out = TransitGatewayRouteTable{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "transitGatewayRouteTableId" => out.transit_gateway_route_table_id = c.text()
      "transitGatewayId" => out.transit_gateway_id = c.text()
      "state" => out.state = TransitGatewayRouteTableState.from(c.text())
      "defaultAssociationRouteTable" => out.default_association_route_table = xmlv.read_bool(c.text())?
      "defaultPropagationRouteTable" => out.default_propagation_route_table = xmlv.read_bool(c.text())?
      "creationTime" => out.creation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

