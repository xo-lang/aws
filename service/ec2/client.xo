fn query_put_private_dns_name_options_on_launch(var f: query.Form, prefix: Str, v: PrivateDnsNameOptionsOnLaunch) {
  if let Some(x) = v.hostname_type {
    query.add(f, query.key(prefix, "HostnameType"), x.value())
  }
  if let Some(x) = v.enable_resource_name_dns_a_record {
    query.add(f, query.key(prefix, "EnableResourceNameDnsARecord"), "${x}")
