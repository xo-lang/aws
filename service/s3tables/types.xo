pub enum MigrationFailureCode: Str {
  RolePermissions = "rolePermissions"
  SourcePermissions = "sourcePermissions"
  DestinationPermissions = "destinationPermissions"
  ResourceNotFound = "resourceNotFound"
  SourceNotSupported = "sourceNotSupported"
  ObjectMigrationReport = "objectMigrationReport"
  ObjectCompatibilityReport = "objectCompatibilityReport"
  TableCompatibilityReport = "tableCompatibilityReport"
  InternalError = "internalError"
  ReportBucketNotSupported = "reportBucketNotSupported"
  Unknown(value: Str)
}

/// The reason that a migration failed: a code and, when there is one, the
/// resource or reason it applies to. This value is returned only when the
/// migration is in the failed state.
pub struct MigrationFailureReason {
  /// The failure code. It names the cause or the report that lists the
  /// findings. Valid values: rolePermissions - S3 Tables couldn't assume the
  /// migration role, or the role doesn't have a permission that the migration
  /// needs. detail is the role ARN. sourcePermissions - The migration role
  /// couldn't read the Amazon Web Services Glue table or the source objects.
  /// detail names the table ( database.table ) or the source bucket.
  /// destinationPermissions - The migration role couldn't write to the table
  /// bucket or the report bucket. detail names the bucket. resourceNotFound -
  /// A resource that you specified doesn't exist, such as the Amazon Web
  /// Services Glue table or the source bucket. detail names it.
  /// sourceNotSupported - The source table can't be migrated, for example
  /// because it is empty, has too many objects, or has columns or partitions
  /// that can't be migrated. The table compatibility report lists the
  /// findings. tableCompatibilityReport - The migration couldn't create the
  /// destination table, for example because a table with that name already
  /// exists or the KMS key can't be used. For a sync, the destination table
  /// changed after the previous migration. The table compatibility report
  /// lists the finding. objectCompatibilityReport - Some source objects can't
  /// be migrated, for example because they are archived, or because they were
  /// overwritten after an earlier migration migrated them. The object
  /// compatibility report lists them. objectMigrationReport - Some source
  /// objects failed to migrate. The object migration report lists them and
  /// the cause for each. reportBucketNotSupported - The report bucket can't
  /// receive the migration's reports, for example because it is in a
  /// different Region than the table bucket. internalError - S3 Tables
  /// encountered an internal error. Retry the migration, and contact Amazon
  /// Web Services Support if the error persists.
  pub code: MigrationFailureCode? = None
  /// The resource that the failure applies to, such as the role ARN, the
  /// Amazon Web Services Glue table ( database.table ) or a bucket. For
  /// sourceNotSupported , the reason that the source isn't supported, such as
  /// EMPTY_TABLE . This value isn't returned for the report codes or for
  /// internalError .
  pub detail: Str? = None
}

