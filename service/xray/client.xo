    fs.push(("State", json.Value.Str(x.value())))
  }
  if let Some(x) = v.start_time {
    fs.push(("StartTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.end_time {
    fs.push(("EndTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.summary {
    fs.push(("Summary", json.Value.Str(x)))
  }
  if let Some(x) = v.client_request_impact_statistics {
    fs.push(("ClientRequestImpactStatistics", json_of_request_impact_statistics(x)))
  }
  if let Some(x) = v.root_cause_service_request_impact_statistics {
    fs.push(("RootCauseServiceRequestImpactStatistics", json_of_request_impact_statistics(x)))
  }
  if let Some(x) = v.top_anomalous_services {
    fs.push(("TopAnomalousServices", json_of_anomalous_service_list(x)))
  }
  if let Some(x) = v.last_update_time {
