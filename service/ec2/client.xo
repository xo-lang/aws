fn query_put_accelerator_count(var f: query.Form, prefix: Str, v: AcceleratorCount) {
  if let Some(x) = v.min {
    query.add(f, query.key(prefix, "Min"), "${x}")
  }
  if let Some(x) = v.max {
    query.add(f, query.key(prefix, "Max"), "${x}")
  }
}

fn query_put_accelerator_count_request(var f: query.Form, prefix: Str, v: AcceleratorCountRequest) {
  if let Some(x) = v.min {
    query.add(f, query.key(prefix, "Min"), "${x}")
  }
  if let Some(x) = v.max {
    query.add(f, query.key(prefix, "Max"), "${x}")
  }
}

fn query_put_accelerator_manufacturer_set(var f: query.Form, prefix: Str, v: List[AcceleratorManufacturer], flat: Bool) {
  let _ = flat
  for (i, x) in v.indexed() {
    let k = "${prefix}.${i + 1}"
    query.add(f, k, x.value())
  }
}

fn query_put_accelerator_name_set(var f: query.Form, prefix: Str, v: List[AcceleratorName], flat: Bool) {
  let _ = flat
  for (i, x) in v.indexed() {
