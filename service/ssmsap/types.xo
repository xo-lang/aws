  Unknown(value: Str)
}

pub struct PutResourcePermissionInput {
  pub action_type: PermissionActionType? = None
  pub source_resource_arn: Str? = None
  pub resource_arn: Str? = None
}

pub struct PutResourcePermissionOutput {
  pub policy: Str? = None
}

pub struct RegisterApplicationInput {
  /// The ID of the application.
  pub application_id: Str? = None
  /// The type of the application.
  pub application_type: ApplicationType? = None
  /// The Amazon EC2 instances on which your SAP application is running.
  pub instances: List[Str]? = None
  /// The SAP instance number of the application.
  pub sap_instance_number: Str? = None
  /// The System ID of the application.
  pub sid: Str? = None
  /// The tags to be attached to the SAP application.
  pub tags: Map[Str, Str]? = None
  /// The credentials of the SAP application.
  pub credentials: List[ApplicationCredential]? = None
  /// The Amazon Resource Name of the SAP HANA database.
  pub database_arn: Str? = None
  /// This is an optional parameter for component details to which the SAP
  /// ABAP application is attached, such as Web Dispatcher. This is an array
  /// of ApplicationComponent objects. You may input 0 to 5 items.
  pub components_info: List[ComponentInfo]? = None
}

pub struct RegisterApplicationOutput {
  /// The application registered with AWS Systems Manager for SAP.
  pub application: Application? = None
  /// The ID of the operation.
  pub operation_id: Str? = None
}

pub enum ReplicationMode: Str {
  Primary = "PRIMARY"
  None = "NONE"
  Sync = "SYNC"
  Syncmem = "SYNCMEM"
  Async = "ASYNC"
  Unknown(value: Str)
}

/// Details of the SAP HANA system replication for the instance.
pub struct Resilience {
  /// The tier of the component.
  pub hsr_tier: Str? = None
  /// The replication mode of the component.
  pub hsr_replication_mode: ReplicationMode? = None
  /// The operation mode of the component.
  pub hsr_operation_mode: OperationMode? = None
  /// The cluster status of the component.
  pub cluster_status: ClusterStatus? = None
  /// Indicates if or not enqueue replication is enabled for the ASCS
  /// component.
  pub enqueue_replication: Bool? = None
}

/// The resource contains a ResourceArn and the ResourceType .
pub struct Resource {
  /// The Amazon Resource Name (ARN) of the source resource. Example of
  /// ResourceArn : "
  /// arn:aws:ec2:us-east-1:111111111111:instance/i-abcdefgh987654321 "
  pub resource_arn: Str? = None
  /// The resource type. Example of ResourceType : "
  /// AWS::SystemsManagerSAP::Component " or " AWS::EC2::Instance ".
  pub resource_type: Str? = None
}

/// The resource is not available.
pub struct ResourceNotFoundException {
  pub message: Str? = None
}

/// Represents the result of a single rule within a configuration check.
pub struct RuleResult {
  /// The unique identifier of the rule result.
  pub id: Str? = None
  /// A description of what the rule validates.
  pub description: Str? = None
  /// The status of the rule result.
  pub status: RuleResultStatus? = None
  /// A message providing details about the rule result.
  pub message: Str? = None
  /// Additional metadata associated with the rule result.
  pub metadata: Map[Str, Str]? = None
}

pub enum RuleResultStatus: Str {
  Passed = "PASSED"
  Failed = "FAILED"
  Warning = "WARNING"
  Info = "INFO"
  Unknown = "UNKNOWN"
  UnknownValue(value: Str)
}

/// A summary of rule results, providing counts for each status type.
pub struct RuleStatusCounts {
  /// The number of rules that failed.
  pub failed: Int? = None
  /// The number of rules that returned warnings.
  pub warning: Int? = None
  /// The number of rules that returned informational results.
  pub info: Int? = None
  /// The number of rules that passed.
  pub passed: Int? = None
  /// The number of rules with unknown status.
  pub unknown: Int? = None
}

pub struct StartApplicationInput {
  /// The ID of the application.
  pub application_id: Str? = None
}

pub struct StartApplicationOutput {
  /// The ID of the operation.
  pub operation_id: Str? = None
}

pub struct StartApplicationRefreshInput {
  /// The ID of the application.
  pub application_id: Str? = None
}

pub struct StartApplicationRefreshOutput {
  /// The ID of the operation.
  pub operation_id: Str? = None
}

pub struct StartConfigurationChecksInput {
  /// The ID of the application.
  pub application_id: Str? = None
  /// The list of configuration checks to perform.
  pub configuration_check_ids: List[ConfigurationCheckType]? = None
}

pub struct StartConfigurationChecksOutput {
  /// The configuration check operations that were started.
  pub configuration_check_operations: List[ConfigurationCheckOperation]? = None
}

pub struct StopApplicationInput {
  /// The ID of the application.
  pub application_id: Str? = None
  /// Specify the ConnectedEntityType . Accepted type is DBMS . If this
  /// parameter is included, the connected DBMS (Database Management System)
  /// will be stopped.
  pub stop_connected_entity: ConnectedEntityType? = None
  /// Boolean. If included and if set to True , the StopApplication operation
  /// will shut down the associated Amazon EC2 instance in addition to the
  /// application.
  pub include_ec2_instance_shutdown: Bool? = None
}

pub struct StopApplicationOutput {
  /// The ID of the operation.
  pub operation_id: Str? = None
}

/// Represents the result of a sub-check within a configuration check
/// operation.
pub struct SubCheckResult {
  /// The unique identifier of the sub-check result.
  pub id: Str? = None
  /// The name of the sub-check.
  pub name: Str? = None
  /// A description of what the sub-check validates.
  pub description: Str? = None
  /// A list of references or documentation links related to the sub-check.
  pub references: List[Str]? = None
}

pub struct TagResourceRequest {
  /// The Amazon Resource Name (ARN) of the resource.
  pub resource_arn: Str? = None
  /// The tags on a resource.
  pub tags: Map[Str, Str]? = None
}

