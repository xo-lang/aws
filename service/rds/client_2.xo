  }
  if let Some(x) = v.available_capacity_per_availability_zone_list {
    query_put_available_capacity_per_availability_zone_list(f, query.key(prefix, "AvailableCapacityPerAvailabilityZoneList"), x, false)
  }
  if let Some(x) = v.end_date {
    query.add(f, query.key(prefix, "EndDate"), rest.date_time(x))
  }
  if let Some(x) = v.create_date {
    query.add(f, query.key(prefix, "CreateDate"), rest.date_time(x))
  }
  if let Some(x) = v.start_date {
    query.add(f, query.key(prefix, "StartDate"), rest.date_time(x))
  }
