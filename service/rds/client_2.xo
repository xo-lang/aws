  }
  if let Some(x) = v.minimum_required_minor_engine_version {
    xmlv.elem(w, "MinimumRequiredMinorEngineVersion", x, [])
  }
  if let Some(x) = v.port_required {
    xmlv.elem(w, "PortRequired", "${x}", [])
  }
  if let Some(x) = v.default_port {
    xmlv.elem(w, "DefaultPort", "${x}", [])
  }
  if let Some(x) = v.options_depended_on {
