fn xml_write_instances_distribution(var w: xmlv.Writer, v: InstancesDistribution, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.on_demand_allocation_strategy {
    xmlv.elem(w, "OnDemandAllocationStrategy", x, [])
  }
  if let Some(x) = v.on_demand_base_capacity {
    xmlv.elem(w, "OnDemandBaseCapacity", "${x}", [])
  }
  if let Some(x) = v.on_demand_percentage_above_base_capacity {
    xmlv.elem(w, "OnDemandPercentageAboveBaseCapacity", "${x}", [])
  }
  if let Some(x) = v.spot_allocation_strategy {
    xmlv.elem(w, "SpotAllocationStrategy", x, [])
