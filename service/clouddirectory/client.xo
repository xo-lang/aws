fn json_of_typed_attribute_value(v: TypedAttributeValue) -> json.Value {
  match v {
    StringValue(x) => json.Value.Object([("StringValue", json.Value.Str(x))])
    BinaryValue(x) => json.Value.Object([("BinaryValue", jsonv.blob(x))])
    BooleanValue(x) => json.Value.Object([("BooleanValue", json.Value.Bool(x))])
    NumberValue(x) => json.Value.Object([("NumberValue", json.Value.Str(x))])
    DatetimeValue(x) => json.Value.Object([("DatetimeValue", jsonv.time(x, "epoch-seconds"))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_typed_attribute_value(v: json.Value) -> TypedAttributeValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "StringValue" => Ok(TypedAttributeValue.StringValue(jsonv.read_str(fv)?))
      "BinaryValue" => Ok(TypedAttributeValue.BinaryValue(jsonv.read_blob(fv)?))
      "BooleanValue" => Ok(TypedAttributeValue.BooleanValue(jsonv.read_bool(fv)?))
      "NumberValue" => Ok(TypedAttributeValue.NumberValue(jsonv.read_str(fv)?))
      "DatetimeValue" => Ok(TypedAttributeValue.DatetimeValue(jsonv.read_time(fv, "epoch-seconds")?))
      _ => Ok(TypedAttributeValue.Unknown(k))
    }
  }
  Err("TypedAttributeValue: no member set")
}

fn json_of_typed_attribute_value_range(v: TypedAttributeValueRange) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.start_mode {
    fs.push(("StartMode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.start_value {
    fs.push(("StartValue", json_of_typed_attribute_value(x)))
  }
  if let Some(x) = v.end_mode {
    fs.push(("EndMode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.end_value {
    fs.push(("EndValue", json_of_typed_attribute_value(x)))
  }
  json.Value.Object(fs)
}

fn from_json_typed_attribute_value_range(v: json.Value) -> TypedAttributeValueRange ! Str {
  var out = TypedAttributeValueRange{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "StartMode" => out.start_mode = RangeMode.from(jsonv.read_str(fv)?)
      "StartValue" => out.start_value = from_json_typed_attribute_value(fv)?
      "EndMode" => out.end_mode = RangeMode.from(jsonv.read_str(fv)?)
      "EndValue" => out.end_value = from_json_typed_attribute_value(fv)?
      _ => {}
    }
  }
  Ok(out)
}

