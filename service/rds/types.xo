  /// a CEV and a DB instance, or choose different keys.
  pub kms_key_id: Str? = None
  /// The ARN of a CEV to use as a source for creating a new CEV. You can
  /// specify a different Amazon Machine Imagine (AMI) by using either Source
  /// or UseAwsProvidedLatestImage . You can't specify a different JSON
  /// manifest when you specify SourceCustomDbEngineVersionIdentifier .
  pub source_custom_db_engine_version_identifier: Str? = None
  /// Specifies whether to use the latest service-provided Amazon Machine
  /// Image (AMI) for the CEV. If you specify UseAwsProvidedLatestImage , you
  /// can't also specify ImageId .
  pub use_aws_provided_latest_image: Bool? = None
  /// An optional description of your CEV.
  pub description: Str? = None
  /// The CEV manifest, which is a JSON document that describes the
  /// installation .zip files stored in Amazon S3. Specify the name/value
  /// pairs in a file or a quoted string. RDS Custom applies the patches in
  /// the order in which they are listed. The following JSON fields are valid:
  /// MediaImportTemplateVersion Version of the CEV manifest. The date is in
  /// the format YYYY-MM-DD . databaseInstallationFileNames Ordered list of
  /// installation files for the CEV. opatchFileNames Ordered list of OPatch
  /// installers used for the Oracle DB engine. psuRuPatchFileNames The PSU
  /// and RU patches for this CEV. OtherPatchFileNames The patches that are
  /// not in the list of PSU and RU patches. Amazon RDS applies these patches
  /// after applying the PSU and RU patches. For more information, see
  /// Creating the CEV manifest in the Amazon RDS User Guide .
  pub manifest: Str? = None
  pub tags: List[Tag]? = None
}

pub struct CreateDBCapacityReservationRequest {
  /// The name of the DB capacity reservation. This name must be unique for
  /// your Amazon Web Services account in the Amazon Web Services Region.
  /// Constraints: Must contain from 1 to 63 lowercase letters, digits, or
  /// hyphens. First character must be a lowercase letter. Can't end with a
  /// hyphen or contain two consecutive hyphens. Can't contain more than 16
  /// groups of characters separated by hyphens. Can't begin with dbcr- .
  pub db_capacity_reservation_name: Str? = None
  /// The compute and memory capacity to reserve, for example db.m5.large .
  /// Not all DB instance classes are available in all Amazon Web Services
  /// Regions, or for all database engines. For the full list of DB instance
  /// classes, and availability for your engine, see DB instance classes in
  /// the Amazon RDS User Guide . Constraints: Must be a DB instance class
  /// that the specified Engine supports. For RDS for Oracle with LicenseModel
  /// set to license-included , some DB instance classes aren't supported.
  /// Either choose a supported DB instance class, or set LicenseModel to
  /// bring-your-own-license .
  pub db_instance_class: Str? = None
  /// The database engine to reserve capacity for. Valid Values: aurora-mysql
  /// | aurora-postgresql | mysql | postgres | mariadb | oracle-ee |
  /// oracle-ee-cdb | oracle-se2 | oracle-se2-cdb | sqlserver-ee |
  /// sqlserver-se | sqlserver-web | sqlserver-ex | sqlserver-dev-ee |
  /// sqlserver-dev-se | db2-ae | db2-ce | db2-se The Developer Edition
  /// engines sqlserver-dev-ee and sqlserver-dev-se support no Multi-AZ DB
  /// instance and no read replica. Therefore, a reservation for either engine
  /// serves Single-AZ DB instances only.
  pub engine: Str? = None
  /// The number of DB instances to reserve in each Availability Zone that you
  /// list in AvailabilityZones . Amazon RDS reserves this number of DB
  /// instances in every listed Availability Zone. A Single-AZ DB instance
  /// uses one unit of reserved capacity, in one Availability Zone. A Multi-AZ
  /// DB instance is one DB instance, and it uses one unit of reserved
  /// capacity in each of two Availability Zones. Therefore, a Multi-AZ DB
  /// instance uses two units in total. A read replica uses one unit of
  /// reserved capacity, in the same way as any other DB instance. Amazon RDS
  /// reserves capacity in each Availability Zone separately. Reserved
  /// capacity in one Availability Zone can't serve a DB instance in another
  /// Availability Zone. A request for a DB instance fails when the
  /// Availability Zone of the DB instance has no available capacity.
  /// Therefore, set this value to the number of DB instances that you want to
  /// run at the same time in one Availability Zone. Don't set it to the
  /// number that you want in total. This value multiplied by the number of
  /// Availability Zones counts against the DB instances quota for your Amazon
  /// Web Services account in the Amazon Web Services Region. Your existing DB
  /// instances, and the unused capacity of your other reservations, count
  /// against the same quota. To find the value of the DB instances quota, see
  /// Quotas and constraints for Amazon RDS in the Amazon RDS User Guide .
  /// Constraints: Minimum 1.
  pub capacity_per_availability_zone: Int? = None
  /// A list of Availability Zones for the reservation. You can't change the
  /// Availability Zones of a reservation after you create it. Reserved
  /// capacity in an Availability Zone that no DB instance uses stays unused.
  /// Constraints: Must specify one or more Availability Zones. Each
  /// Availability Zone can appear only once. Each Availability Zone must be
  /// in the Amazon Web Services Region of the request. Each Availability Zone
  /// must have capacity for the requested DB instance class. Must include two
  /// or more Availability Zones to use the reservation for a Multi-AZ DB
  /// instance. A DB instance can use reserved capacity only in an
  /// Availability Zone that its DB subnet group covers. Example: us-east-1a
  pub availability_zones: List[Str]? = None
  /// The date and time when the reservation expires, in Universal Coordinated
  /// Time (UTC). If you don't specify a value, the reservation doesn't
  /// expire. To change the expiration of an existing reservation, use
  /// ModifyDBCapacityReservation . That operation takes EndDateType along
  /// with EndDate . Constraints: Must be a date and time in the future. For a
  /// future-dated reservation, must be at or after StartDate plus
  /// CommitmentDuration . For example, a reservation that starts on
  /// 2026-12-01 with a 30-day commitment can't expire before 2026-12-31. To
  /// reserve capacity for one calendar month, set CommitmentDuration to 30
  /// days or fewer, not to the length of the month. Example:
  /// 2026-12-31T23:59:59Z
  pub end_date: Time? = None
  /// The date and time when the reservation starts, in Universal Coordinated
  /// Time (UTC). Specify this parameter to create a future-dated reservation.
  /// If you don't specify a value, the reservation starts immediately. A
  /// reservation that starts later always carries a capacity commitment.
  /// Therefore, a request that specifies StartDate must also meet every
  /// constraint of a future-dated reservation, including the minimum reserved
  /// capacity in each Availability Zone. Constraints: Must be from 5 to 120
  /// days in the future. You must also specify CommitmentDuration . Example:
  /// 2026-12-01T00:00:00Z
  pub start_date: Time? = None
  /// The length of the capacity commitment that you request for a
  /// future-dated reservation, in seconds. Amazon RDS measures this length
  /// from StartDate . Amazon RDS can grant a shorter capacity commitment than
  /// you request. Therefore, read CommitmentEndDate in CommitmentInfo for the
  /// commitment that Amazon RDS granted. The commitment doesn't end the
  /// reservation. Specify EndDate to set an expiration date. You can't cancel
  /// a reservation in the active state during the commitment. Constraints:
  /// Minimum 1209600, which is 14 days. For a db.x DB instance class, such as
  /// db.x2g.xlarge , the minimum is 7257600, which is 84 days. Must be less
  /// than 315576000, which is 10 years. You must also specify StartDate .
  /// Example: 2592000
  pub commitment_duration: Int? = None
  /// The license model to reserve capacity for. Specify this parameter only
  /// for RDS for Microsoft SQL Server Enterprise Edition, Standard Edition,
  /// and Developer Edition, for RDS for Oracle, or for RDS for Db2 Standard
  /// Edition and Advanced Edition. Amazon RDS rejects the request for any
  /// other engine. This includes Amazon Aurora, the Web and Express editions
  /// of RDS for Microsoft SQL Server, and RDS for Db2 Community Edition.
  /// Valid Values: RDS for Microsoft SQL Server Enterprise Edition and
  /// Standard Edition - license-included | bring-your-own-media RDS for
  /// Microsoft SQL Server Developer Edition - bring-your-own-license RDS for
  /// Oracle - bring-your-own-license | license-included RDS for Db2 Standard
  /// Edition and Advanced Edition - bring-your-own-license |
  /// marketplace-license A DB instance launches into the reservation only
  /// when the license model of the DB instance matches the license model of
  /// the reservation. For a reservation that holds no license model, Amazon
  /// RDS applies no license model check at launch. For RDS for Microsoft SQL
  /// Server Enterprise Edition and Standard Edition, if you don't specify a
  /// value, Amazon RDS uses license-included . For RDS for Microsoft SQL
  /// Server Developer Edition, if you don't specify a value, Amazon RDS uses
  /// bring-your-own-license . That is the only license model that these
  /// engines accept, and Amazon RDS rejects any other value. For RDS for
  /// Oracle, if you don't specify a value, Amazon RDS uses the only orderable
  /// license model for the DB instance class. If more than one license model
  /// is orderable, you must specify one. For RDS for Db2 Standard Edition and
  /// Advanced Edition, if you don't specify a value, Amazon RDS uses
  /// bring-your-own-license . To reserve capacity for Db2 DB instances that
  /// you license through Amazon Web Services Marketplace, specify
  /// marketplace-license . For RDS for Oracle, the license models that you
  /// can reserve depend on the engine and the DB instance class. RDS for
  /// Oracle Enterprise Edition doesn't support license-included .
  pub license_model: Str? = None
  /// Tags to assign to the DB capacity reservation.
  pub tags: List[Tag]? = None
}

pub struct CreateDBCapacityReservationResponse {
  /// Contains the details of the newly created DB capacity reservation.
  pub db_capacity_reservation: DBCapacityReservation? = None
}

pub struct CreateDBClusterEndpointMessage {
