fn json_of_operation(v: Operation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("id", json.Value.Str(x)))
  }
  if let Some(x) = v.resource_name {
    fs.push(("resourceName", json.Value.Str(x)))
  }
  if let Some(x) = v.resource_type {
    fs.push(("resourceType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.location {
    fs.push(("location", json_of_resource_location(x)))
  }
  if let Some(x) = v.is_terminal {
    fs.push(("isTerminal", json.Value.Bool(x)))
  }
  if let Some(x) = v.operation_details {
    fs.push(("operationDetails", json.Value.Str(x)))
  }
  if let Some(x) = v.operation_type {
    fs.push(("operationType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.status_changed_at {
    fs.push(("statusChangedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.error_code {
    fs.push(("errorCode", json.Value.Str(x)))
  }
  if let Some(x) = v.error_details {
    fs.push(("errorDetails", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_operation(v: json.Value) -> Operation ! Str {
  var out = Operation{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "id" => out.id = jsonv.read_str(fv)?
      "resourceName" => out.resource_name = jsonv.read_str(fv)?
      "resourceType" => out.resource_type = ResourceType.from(jsonv.read_str(fv)?)
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "location" => out.location = from_json_resource_location(fv)?
      "isTerminal" => out.is_terminal = jsonv.read_bool(fv)?
      "operationDetails" => out.operation_details = jsonv.read_str(fv)?
      "operationType" => out.operation_type = OperationType.from(jsonv.read_str(fv)?)
      "status" => out.status = OperationStatus.from(jsonv.read_str(fv)?)
      "statusChangedAt" => out.status_changed_at = jsonv.read_time(fv, "epoch-seconds")?
      "errorCode" => out.error_code = jsonv.read_str(fv)?
      "errorDetails" => out.error_details = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

