  /// An optional user-friendly name applied to each workflow run. Can be
  /// overridden per run.
  pub name: Str? = None
  /// The identifier of the run cache to associate with the runs.
  pub cache_id: Str? = None
  /// The cache behavior for the runs. Requires cacheId to be set.
  pub cache_behavior: Str? = None
  /// The ID of the run group to contain all workflow runs in the batch.
  pub run_group_id: Str? = None
  /// An integer priority for the workflow runs. Higher values correspond to
  /// higher priority. A value of 0 corresponds to the lowest priority. Can be
  /// overridden per run.
  pub priority: Int? = None
  /// Workflow parameter names and values shared across all runs. Merged with
  /// per-run parameters; run-specific values take precedence when keys
  /// overlap. Can be overridden per run.
  pub parameters: json.Value? = None
  /// The filesystem size in gibibytes (GiB) provisioned for each workflow run
  /// and shared by all tasks in that run. Defaults to 1200 GiB if not
  /// specified.
  pub storage_capacity: Int? = None
  /// The destination S3 URI for workflow outputs. Must begin with s3:// . The
  /// roleArn must grant write permissions to this bucket. Can be overridden
  /// per run.
  pub output_uri: Str? = None
  /// The verbosity level for CloudWatch Logs emitted during each run.
  pub log_level: Str? = None
  /// Amazon Web Services tags to associate with each workflow run. Merged
  /// with per-run runTags ; run-specific values take precedence when keys
  /// overlap.
  pub run_tags: Map[Str, Str]? = None
  /// The retention behavior for runs after completion.
  pub retention_mode: Str? = None
  /// The storage type for the workflow runs.
  pub storage_type: Str? = None
  /// The Amazon Web Services account ID of the workflow owner, used for
  /// cross-account workflow sharing.
  pub workflow_owner_id: Str? = None
  /// The expected Amazon Web Services account ID of the owner of the output
  /// S3 bucket. Can be overridden per run.
  pub output_bucket_owner_id: Str? = None
  /// The version name of the specified workflow.
  pub workflow_version_name: Str? = None
  /// Optional configuration for run networking behavior. If not specified,
  /// this will default to RESTRICTED.
  pub networking_mode: Str? = None
  /// Optional configuration name to use for the workflow run.
  pub configuration_name: Str? = None
  /// Optional inline policy json for scoping down permissions via a session
