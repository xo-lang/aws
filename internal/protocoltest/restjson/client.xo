  }
  if let Some(x) = v.byte_header {
    fs.push(("byteHeader", json.Value.Int(x)))
  }
  if let Some(x) = v.short_header {
    fs.push(("shortHeader", json.Value.Int(x)))
  }
  if let Some(x) = v.int_header {
    fs.push(("intHeader", json.Value.Int(x)))
  }
  if let Some(x) = v.long_header {
    fs.push(("longHeader", json.Value.Int(x)))
  }
  if let Some(x) = v.blob_header {
    fs.push(("blobHeader", jsonv.blob(x)))
  }
  if let Some(x) = v.string_header {
    fs.push(("stringHeader", json.Value.Str(x)))
  }
  if let Some(x) = v.timestamp_header {
    fs.push(("timestampHeader", jsonv.time(x, "date-time")))
  }
  json.Value.Object(fs)
}

fn from_json_headers_event(v: json.Value) -> HeadersEvent ! Str {
  var out = HeadersEvent{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "booleanHeader" => out.boolean_header = jsonv.read_bool(fv)?
      "byteHeader" => out.byte_header = jsonv.read_int(fv)?
      "shortHeader" => out.short_header = jsonv.read_int(fv)?
      "intHeader" => out.int_header = jsonv.read_int(fv)?
      "longHeader" => out.long_header = jsonv.read_int(fv)?
      "blobHeader" => out.blob_header = jsonv.read_blob(fv)?
      "stringHeader" => out.string_header = jsonv.read_str(fv)?
      "timestampHeader" => out.timestamp_header = jsonv.read_time(fv, "date-time")?
      _ => {}
    }
  }
  Ok(out)
}

