pub enum EntityStatusCode: Str {
  Impaired = "IMPAIRED"
  Unimpaired = "UNIMPAIRED"
  Unknown = "UNKNOWN"
  Pending = "PENDING"
  Resolved = "RESOLVED"
  UnknownValue(value: Str)
}

pub enum EventAggregateField: Str {
  EventTypeCategory = "eventTypeCategory"
  Unknown(value: Str)
}

pub enum EventScopeCode: Str {
  Public = "PUBLIC"
