/// Wait until a Fleet is activated. Use this after invoking CreateFleet or
/// UpdateFleet.
///
/// Calls GetFleet until the FleetActive acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (900s).
pub fn wait_until_fleet_active(c: Client, input: GetFleetRequest, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 900s) -> () ! waiter.WaitErr[GetFleetErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_fleet(input) {
      Ok(out) => {
        let o = jmes_of_get_fleet_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "ACTIVE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "CREATE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "UPDATE_FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("FleetActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until a job reaches any terminal status. Waits up to 1 hour by
/// default.
///
/// Calls GetJob until the JobComplete acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (15s) to `max_delay` (3600s).
pub fn wait_until_job_complete(c: Client, input: GetJobRequest, max_wait: Duration, min_delay: Duration = 15s, max_delay: Duration = 3600s) -> () ! waiter.WaitErr[GetJobErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_job(input) {
      Ok(out) => {
        let o = jmes_of_get_job_response(out)
        if state == "" && waiter.path_matches(o, "taskRunStatus", "stringEquals", "SUCCEEDED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "taskRunStatus", "stringEquals", "FAILED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "taskRunStatus", "stringEquals", "CANCELED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "taskRunStatus", "stringEquals", "SUSPENDED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "taskRunStatus", "stringEquals", "NOT_COMPATIBLE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "lifecycleStatus", "stringEquals", "ARCHIVED") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("JobComplete: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until a job is created. Use this after invoking CreateJob.
///
/// Calls GetJob until the JobCreateComplete acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (1s) to `max_delay` (120s).
pub fn wait_until_job_create_complete(c: Client, input: GetJobRequest, max_wait: Duration, min_delay: Duration = 1s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetJobErr] uses (net.dial, clock, rand) {
