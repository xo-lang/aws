fn xml_write_transit_gateway_vpc_attachment(var w: xmlv.Writer, v: TransitGatewayVpcAttachment, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.transit_gateway_attachment_id {
