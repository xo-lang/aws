fn json_of_event_stream(v: EventStream) -> json.Value {
  match v {
    Headers(x) => json.Value.Object([("headers", json_of_headers_event(x))])
    BlobPayload(x) => json.Value.Object([("blobPayload", json_of_blob_payload_event(x))])
    StringPayload(x) => json.Value.Object([("stringPayload", json_of_string_payload_event(x))])
    StructurePayload(x) => json.Value.Object([("structurePayload", json_of_structure_payload_event(x))])
    UnionPayload(x) => json.Value.Object([("unionPayload", json_of_union_payload_event(x))])
    HeadersAndExplicitPayload(x) => json.Value.Object([("headersAndExplicitPayload", json_of_headers_and_explicit_payload_event(x))])
    HeadersAndImplicitPayload(x) => json.Value.Object([("headersAndImplicitPayload", json_of_headers_and_implicit_payload_event(x))])
    Error(x) => json.Value.Object([("error", json_of_error_event(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_event_stream(v: json.Value) -> EventStream ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "headers" => Ok(EventStream.Headers(from_json_headers_event(fv)?))
      "blobPayload" => Ok(EventStream.BlobPayload(from_json_blob_payload_event(fv)?))
      "stringPayload" => Ok(EventStream.StringPayload(from_json_string_payload_event(fv)?))
      "structurePayload" => Ok(EventStream.StructurePayload(from_json_structure_payload_event(fv)?))
      "unionPayload" => Ok(EventStream.UnionPayload(from_json_union_payload_event(fv)?))
      "headersAndExplicitPayload" => Ok(EventStream.HeadersAndExplicitPayload(from_json_headers_and_explicit_payload_event(fv)?))
      "headersAndImplicitPayload" => Ok(EventStream.HeadersAndImplicitPayload(from_json_headers_and_implicit_payload_event(fv)?))
      "error" => Ok(EventStream.Error(from_json_error_event(fv)?))
      _ => Ok(EventStream.Unknown(k))
    }
  }
  Err("EventStream: no member set")
}

