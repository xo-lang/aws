// Writes endpoints/partitions_table.xo from endpoints/partitions.json:
// the typed partition table aws.partition reads. Run from codegen/:
//   xo run ./cmd/partitions

use std/json

fn s(v: json.Value?) -> Str {
  match v {
    Some(json.Value.Str(x)) => x
    _ => ""
  }
}

fn b(v: json.Value?) -> Bool {
  v == Some(json.Value.Bool(true))
}

fn q(x: Str) -> Str {
  "\"${x.replace("\\", "\\\\").replace("\"", "\\\"").replace("$", "\\$")}\""
}

fn main(os: Os) -> () ! Error {
  let doc = json.parse_value(os.fs.read_text("../endpoints/partitions.json")?)?
  var out: List[Str] = [
    "// Code generated by codegen/cmd/partitions from partitions.json. DO NOT EDIT.",
    "",
    "/// One partition: its regions, region pattern, and outputs.",
    "struct PartitionData {",
    "  id: Str",
    "  region_regex: Str",
    "  regions: List[Str]",
    "  outputs: Partition",
    "}",
    "",
    "fn partition_table() -> List[PartitionData] {",
    "  [",
  ]
  if let Some(json.Value.List(ps)) = doc.get("partitions") {
    for p in ps {
      let o = p.get("outputs") ?? json.Value.Null
      let regions = match p.get("regions") {
        Some(json.Value.Object(fs)) => fs.map(fn(f: (Str, json.Value)) -> Str { q(f.0) })
        _ => []
      }
      out.push("    PartitionData{")
      out.push("      id: ${q(s(p.get("id")))},")
      out.push("      region_regex: ${q(s(p.get("regionRegex")))},")
      out.push("      regions: [${regions.join(", ")}],")
      out.push("      outputs: Partition{")
      out.push("        name: ${q(s(o.get("name")))},")
      out.push("        dns_suffix: ${q(s(o.get("dnsSuffix")))},")
      out.push("        dual_stack_dns_suffix: ${q(s(o.get("dualStackDnsSuffix")))},")
      out.push("        supports_fips: ${b(o.get("supportsFIPS"))},")
      out.push("        supports_dual_stack: ${b(o.get("supportsDualStack"))},")
      out.push("        implicit_global_region: ${q(s(o.get("implicitGlobalRegion")))},")
      out.push("      },")
      out.push("    },")
    }
  }
  out.push("  ]")
  out.push("}")
  os.fs.write("../endpoints/partitions_table.xo", (out.join("\n") + "\n").bytes())?
  os.stdio.println("wrote ../endpoints/partitions_table.xo")
  Ok(())
}
