pub struct NotFoundException {
  pub message: Str? = None
}

pub struct PauseConnectorRequest {
  /// The Amazon Resource Name (ARN) of the connector that you want to pause.
  pub connector_arn: Str? = None
}

pub struct PauseConnectorResponse {
  /// The Amazon Resource Name (ARN) of the connector.
  pub connector_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the connector operation created to
  /// perform the pause.
  pub connector_operation_arn: Str? = None
}

/// A plugin is an Amazon Web Services resource that contains the code that
/// defines your connector logic.
pub struct Plugin {
  /// Details about a custom plugin.
  pub custom_plugin: CustomPlugin? = None
}

/// The description of the plugin.
pub struct PluginDescription {
  /// Details about a custom plugin.
  pub custom_plugin: CustomPluginDescription? = None
}

/// A custom plugin to use when you update a connector via UpdateConnector .
pub struct PluginUpdate {
  /// The custom plugin to use for the connector.
  pub custom_plugin: CustomPluginUpdate? = None
}

/// Details about a connector's provisioned capacity.
pub struct ProvisionedCapacity {
  /// The number of microcontroller units (MCUs) allocated to each connector
  /// worker. The valid values are 1,2,4,8.
  pub mcu_count: Int? = None
  /// The number of workers that are allocated to the connector.
  pub worker_count: Int? = None
}

/// The description of a connector's provisioned capacity.
pub struct ProvisionedCapacityDescription {
  /// The number of microcontroller units (MCUs) allocated to each connector
  /// worker. The valid values are 1,2,4,8.
  pub mcu_count: Int? = None
  /// The number of workers that are allocated to the connector.
  pub worker_count: Int? = None
}

/// An update to a connector's fixed capacity.
pub struct ProvisionedCapacityUpdate {
  /// The number of microcontroller units (MCUs) allocated to each connector
  /// worker. The valid values are 1,2,4,8.
  pub mcu_count: Int? = None
  /// The number of workers that are allocated to the connector.
  pub worker_count: Int? = None
}

pub struct RestartConnectorRequest {
  /// The Amazon Resource Name (ARN) of the connector that you want to
  /// restart.
  pub connector_arn: Str? = None
  /// Specifies whether to restart only the connector's failed tasks. If true
  /// , the operation restarts only the tasks that are currently in a failed
  /// state, and healthy tasks continue running. If false or not specified,
  /// the operation restarts the connector and all of its tasks.
  pub only_failed_tasks: Bool? = None
}

pub struct RestartConnectorResponse {
  /// The Amazon Resource Name (ARN) of the connector.
  pub connector_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the connector operation created to
  /// perform the restart.
  pub connector_operation_arn: Str? = None
}

pub struct ResumeConnectorRequest {
  /// The Amazon Resource Name (ARN) of the connector that you want to resume.
  pub connector_arn: Str? = None
}

pub struct ResumeConnectorResponse {
  /// The Amazon Resource Name (ARN) of the connector.
  pub connector_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the connector operation created to
  /// perform the resume.
  pub connector_operation_arn: Str? = None
}

/// The location of an object in Amazon S3.
pub struct S3Location {
  /// The Amazon Resource Name (ARN) of an S3 bucket.
  pub bucket_arn: Str? = None
  /// The file key for an object in an S3 bucket.
  pub file_key: Str? = None
  /// The version of an object in an S3 bucket.
  pub object_version: Str? = None
}

/// The description of the location of an object in Amazon S3.
pub struct S3LocationDescription {
  /// The Amazon Resource Name (ARN) of an S3 bucket.
  pub bucket_arn: Str? = None
  /// The file key for an object in an S3 bucket.
  pub file_key: Str? = None
  /// The version of an object in an S3 bucket.
  pub object_version: Str? = None
}

/// Details about delivering logs to Amazon S3.
pub struct S3LogDelivery {
  /// The name of the S3 bucket that is the destination for log delivery.
  pub bucket: Str? = None
  /// Specifies whether connector logs get sent to the specified Amazon S3
  /// destination.
  pub enabled: Bool? = None
  /// The S3 prefix that is the destination for log delivery.
  pub prefix: Str? = None
}

/// The description of the details about delivering logs to Amazon S3.
pub struct S3LogDeliveryDescription {
  /// The name of the S3 bucket that is the destination for log delivery.
  pub bucket: Str? = None
  /// Specifies whether connector logs get sent to the specified Amazon S3
  /// destination.
  pub enabled: Bool? = None
  /// The S3 prefix that is the destination for log delivery.
  pub prefix: Str? = None
}

/// The scale-in policy for the connector.
pub struct ScaleInPolicy {
  /// Specifies the CPU utilization percentage threshold at which you want
  /// connector scale in to be triggered.
  pub cpu_utilization_percentage: Int? = None
}

/// The description of the scale-in policy for the connector.
pub struct ScaleInPolicyDescription {
  /// Specifies the CPU utilization percentage threshold at which you want
  /// connector scale in to be triggered.
  pub cpu_utilization_percentage: Int? = None
}

/// An update to the connector's scale-in policy.
pub struct ScaleInPolicyUpdate {
  /// The target CPU utilization percentage threshold at which you want
  /// connector scale in to be triggered.
  pub cpu_utilization_percentage: Int? = None
}

/// The scale-out policy for the connector.
pub struct ScaleOutPolicy {
  /// The CPU utilization percentage threshold at which you want connector
  /// scale out to be triggered.
  pub cpu_utilization_percentage: Int? = None
}

/// The description of the scale-out policy for the connector.
pub struct ScaleOutPolicyDescription {
  /// The CPU utilization percentage threshold at which you want connector
  /// scale out to be triggered.
  pub cpu_utilization_percentage: Int? = None
}

/// An update to the connector's scale-out policy.
pub struct ScaleOutPolicyUpdate {
  /// The target CPU utilization percentage threshold at which you want
  /// connector scale out to be triggered.
  pub cpu_utilization_percentage: Int? = None
}

