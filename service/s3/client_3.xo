pub fn serialize_put_object_acl(ep: rest.Endpoint, input: PutObjectAclRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = [("acl", "")]
  if input.bucket.is_none() {
    return Err("input member Bucket is required")
  }
  let label_key = match input.key {
    Some(v) => v
    None => return Err("input member Key is required")
