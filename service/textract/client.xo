  }
  if let Some(x) = input.human_loop_config {
    fs.push(("HumanLoopConfig", json_of_human_loop_config(x)))
  }
  if let Some(x) = input.queries_config {
    fs.push(("QueriesConfig", json_of_queries_config(x)))
