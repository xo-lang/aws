  pub match_source_cidr: Str? = None
  /// The CIDR block that matching source addresses are translated to.
  pub nat_cidr: Str? = None
  /// The state of the NAT rule. The possible values are the following:
  /// CREATING : The rule is being created. MODIFYING : The rule is being
  /// modified. DELETING : The rule is being deleted. ACTIVATING : NAT gateway
  /// support is being enabled, and the rule is being applied. ACTIVATED : NAT
  /// gateway support is enabled, and the rule is applied. DEACTIVATING : NAT
  /// gateway support is being disabled, and the rule is being removed from
  /// use. DEACTIVATED : NAT gateway support is disabled, and the rule isn't
  /// applied. FAILED : The attachment failed to be created, and the rule
  /// isn't applied. PENDING_ATTACHMENT_ACCEPTANCE : The attachment is pending
  /// acceptance. The rule is applied after the attachment is accepted.
  pub state: NatRuleState? = None
}

/// Describes a NAT rule to configure on an attachment. Source addresses in
/// the source CIDR block of traffic from the attachment are translated to
/// the same host addresses in the NAT CIDR block. Traffic to an address in
/// the NAT CIDR block is translated back to the matching address in the
/// source CIDR block.
pub struct NatRuleRequest {
  /// The rule number, from 1 to 32766. Each rule number must be unique for
  /// the attachment.
  pub rule_number: Int? = None
  /// The IPv4 CIDR block to match against the source address of traffic from
  /// the attachment. The CIDR block can't overlap with the multicast range
  /// (224.0.0.0/4).
  pub match_source_cidr: Str? = None
  /// The IPv4 CIDR block to translate matching source addresses to. The
  /// prefix length must be the same as the prefix length of MatchSourceCidr .
  /// The CIDR block must be within a private (RFC 1918) or shared address
  /// space (RFC 6598) range. The CIDR blocks of the NAT rules of an
  /// attachment can't overlap with each other.
  pub nat_cidr: Str? = None
}

