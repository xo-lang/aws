  }
  if let Some(x) = v.nat_gateway {
    xmlv.elem(w, "NatGateway", x.value(), [])
  }
  if let Some(x) = v.virtual_private_gateway {
    xmlv.elem(w, "VirtualPrivateGateway", x.value(), [])
  }
  if let Some(x) = v.vpc_peering {
    xmlv.elem(w, "VpcPeering", x.value(), [])
  }
  if let Some(x) = v.lambda {
    xmlv.elem(w, "Lambda", x.value(), [])
  }
  if let Some(x) = v.vpc_lattice {
    xmlv.elem(w, "VpcLattice", x.value(), [])
  }
  if let Some(x) = v.elastic_file_system {
    xmlv.elem(w, "ElasticFileSystem", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_modify_account_vpc_encryption_control_request(e: xml.Element) -> ModifyAccountVpcEncryptionControlRequest ! Str {
  var out = ModifyAccountVpcEncryptionControlRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "Mode" => out.mode = AccountVpcEncryptionControlMode.from(c.text())
      "InternetGateway" => out.internet_gateway = VpcEncryptionControlExclusionStateInput.from(c.text())
      "EgressOnlyInternetGateway" => out.egress_only_internet_gateway = VpcEncryptionControlExclusionStateInput.from(c.text())
      "NatGateway" => out.nat_gateway = VpcEncryptionControlExclusionStateInput.from(c.text())
      "VirtualPrivateGateway" => out.virtual_private_gateway = VpcEncryptionControlExclusionStateInput.from(c.text())
      "VpcPeering" => out.vpc_peering = VpcEncryptionControlExclusionStateInput.from(c.text())
      "Lambda" => out.lambda = VpcEncryptionControlExclusionStateInput.from(c.text())
      "VpcLattice" => out.vpc_lattice = VpcEncryptionControlExclusionStateInput.from(c.text())
      "ElasticFileSystem" => out.elastic_file_system = VpcEncryptionControlExclusionStateInput.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

