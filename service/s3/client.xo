}

fn xml_read_list_objects_v2_output(e: xml.Element) -> ListObjectsV2Output ! Str {
  var out = ListObjectsV2Output{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "IsTruncated" => out.is_truncated = xmlv.read_bool(c.text())?
      "Contents" => {
        var items = out.contents ?? []
        items.push(xml_read_object(c)?)
        out.contents = items
      }
      "Name" => out.name = c.text()
      "Prefix" => out.prefix = c.text()
      "Delimiter" => out.delimiter = c.text()
      "MaxKeys" => out.max_keys = xmlv.read_int(c.text())?
      "CommonPrefixes" => {
        var items = out.common_prefixes ?? []
        items.push(xml_read_common_prefix(c)?)
        out.common_prefixes = items
      }
      "EncodingType" => out.encoding_type = EncodingType.from(c.text())
      "KeyCount" => out.key_count = xmlv.read_int(c.text())?
      "ContinuationToken" => out.continuation_token = c.text()
      "NextContinuationToken" => out.next_continuation_token = c.text()
      "StartAfter" => out.start_after = c.text()
      "RequestCharged" => out.request_charged = RequestCharged.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

