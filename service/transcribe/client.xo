fn json_of_rule(v: Rule) -> json.Value {
  match v {
    NonTalkTimeFilter(x) => json.Value.Object([("NonTalkTimeFilter", json_of_non_talk_time_filter(x))])
    InterruptionFilter(x) => json.Value.Object([("InterruptionFilter", json_of_interruption_filter(x))])
    TranscriptFilter(x) => json.Value.Object([("TranscriptFilter", json_of_transcript_filter(x))])
    SentimentFilter(x) => json.Value.Object([("SentimentFilter", json_of_sentiment_filter(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_rule(v: json.Value) -> Rule ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "NonTalkTimeFilter" => Ok(Rule.NonTalkTimeFilter(from_json_non_talk_time_filter(fv)?))
      "InterruptionFilter" => Ok(Rule.InterruptionFilter(from_json_interruption_filter(fv)?))
      "TranscriptFilter" => Ok(Rule.TranscriptFilter(from_json_transcript_filter(fv)?))
      "SentimentFilter" => Ok(Rule.SentimentFilter(from_json_sentiment_filter(fv)?))
      _ => Ok(Rule.Unknown(k))
    }
  }
  Err("Rule: no member set")
}

fn json_of_rule_list(v: List[Rule]) -> json.Value {
  json.Value.List(v.map(fn(x: Rule) -> json.Value { json_of_rule(x) }))
