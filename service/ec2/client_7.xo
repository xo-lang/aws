    xmlv.elem(w, "amazonSideAsn", "${x}", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.vpn_gateway_id {
    xmlv.elem(w, "vpnGatewayId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "type", x.value(), [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.vpc_attachments {
    xml_write_vpc_attachment_list(w, x, "attachments", [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpn_gateway(e: xml.Element) -> VpnGateway ! Str {
  var out = VpnGateway{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "amazonSideAsn" => out.amazon_side_asn = xmlv.read_int(c.text())?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "vpnGatewayId" => out.vpn_gateway_id = c.text()
      "state" => out.state = VpnState.from(c.text())
      "type" => out.type_value = GatewayType.from(c.text())
      "availabilityZone" => out.availability_zone = c.text()
      "attachments" => out.vpc_attachments = xml_read_vpc_attachment_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

