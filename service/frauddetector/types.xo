/// The details of the event variable's impact on the prediction score.
pub struct VariableImpactExplanation {
  /// The event variable name.
  pub event_variable_name: Str? = None
  /// The event variable's relative impact in terms of magnitude on the
  /// prediction scores. The relative impact values consist of a numerical
  /// rating (0-5, 5 being the highest) and direction (increased/decreased)
  /// impact of the fraud risk.
  pub relative_impact: Str? = None
  /// The raw, uninterpreted value represented as log-odds of the fraud. These
  /// values are usually between -10 to +10, but range from - infinity to +
  /// infinity. A positive value indicates that the variable drove the risk
  /// score up. A negative value indicates that the variable drove the risk
  /// score down.
  pub log_odds_impact: Float32? = None
}

/// The variable importance metrics details.
pub struct VariableImportanceMetrics {
  /// List of variable metrics.
  pub log_odds_metrics: List[LogOddsMetric]? = None
}
