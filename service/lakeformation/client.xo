fn json_of_resource(v: Resource) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.catalog {
    fs.push(("Catalog", json_of_catalog_resource(x)))
  }
  if let Some(x) = v.database {
    fs.push(("Database", json_of_database_resource(x)))
  }
  if let Some(x) = v.table {
    fs.push(("Table", json_of_table_resource(x)))
  }
  if let Some(x) = v.table_with_columns {
    fs.push(("TableWithColumns", json_of_table_with_columns_resource(x)))
  }
  if let Some(x) = v.data_location {
    fs.push(("DataLocation", json_of_data_location_resource(x)))
  }
  if let Some(x) = v.data_cells_filter {
    fs.push(("DataCellsFilter", json_of_data_cells_filter_resource(x)))
  }
  if let Some(x) = v.lf_tag {
    fs.push(("LFTag", json_of_lf_tag_key_resource(x)))
  }
  if let Some(x) = v.lf_tag_policy {
    fs.push(("LFTagPolicy", json_of_lf_tag_policy_resource(x)))
  }
  if let Some(x) = v.lf_tag_expression {
    fs.push(("LFTagExpression", json_of_lf_tag_expression_resource(x)))
  }
  if let Some(x) = v.rls_policy {
    fs.push(("RLSPolicy", json_of_rls_policy_resource(x)))
  }
  json.Value.Object(fs)
}

fn from_json_resource(v: json.Value) -> Resource ! Str {
  var out = Resource{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Catalog" => out.catalog = from_json_catalog_resource(fv)?
      "Database" => out.database = from_json_database_resource(fv)?
      "Table" => out.table = from_json_table_resource(fv)?
      "TableWithColumns" => out.table_with_columns = from_json_table_with_columns_resource(fv)?
      "DataLocation" => out.data_location = from_json_data_location_resource(fv)?
      "DataCellsFilter" => out.data_cells_filter = from_json_data_cells_filter_resource(fv)?
      "LFTag" => out.lf_tag = from_json_lf_tag_key_resource(fv)?
      "LFTagPolicy" => out.lf_tag_policy = from_json_lf_tag_policy_resource(fv)?
      "LFTagExpression" => out.lf_tag_expression = from_json_lf_tag_expression_resource(fv)?
      "RLSPolicy" => out.rls_policy = from_json_rls_policy_resource(fv)?
      _ => {}
    }
  }
  Ok(out)
}

