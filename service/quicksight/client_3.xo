      "BorderStyle" => out.border_style = from_json_free_form_layout_element_border_style(fv)?
      "SelectedBorderStyle" => out.selected_border_style = from_json_free_form_layout_element_border_style(fv)?
      "BackgroundStyle" => out.background_style = from_json_free_form_layout_element_background_style(fv)?
      "LoadingAnimation" => out.loading_animation = from_json_loading_animation(fv)?
      "BorderRadius" => out.border_radius = jsonv.read_str(fv)?
      "Padding" => out.padding = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

