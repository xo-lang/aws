  pub print_allowed: Str? = None
  /// The amount of time that a streaming session remains active after users
  /// disconnect.
  pub disconnect_timeout_in_minutes: Int? = None
  /// The amount of time that users can be idle (inactive) before they are
  /// disconnected from their streaming session and the disconnect timeout
  /// interval begins.
  pub idle_disconnect_timeout_in_minutes: Int? = None
  /// The configuration that specifies which cookies should be synchronized
  /// from the end user's local browser to the remote browser.
  pub cookie_synchronization_configuration: CookieSynchronizationConfiguration? = None
  /// Specifies whether the user can use deep links that open automatically
  /// when connecting to a session.
  pub deep_link_allowed: Str? = None
  /// The configuration of the toolbar. This allows administrators to select
  /// the toolbar type and visual mode, set maximum display resolution for
  /// sessions, and choose which items are visible to end users during their
  /// sessions. If administrators do not modify these settings, end users
  /// retain control over their toolbar preferences.
  pub toolbar_configuration: ToolbarConfiguration? = None
  /// The branding configuration output that customizes the appearance of the
  /// web portal for end users.
  pub branding_configuration: BrandingConfiguration? = None
  /// Specifies whether the user can use WebAuthn redirection for passwordless
  /// login to websites within the streaming session.
  pub web_authn_allowed: Str? = None
}

/// There is a validation error.
pub struct ValidationException {
  pub message: Str? = None
  /// Reason the request failed validation
  pub reason: Str? = None
  /// The field that caused the error.
  pub field_list: List[ValidationExceptionField]? = None
}

/// Information about a field passed inside a request that resulted in an
/// exception.
pub struct ValidationExceptionField {
  /// The name of the field that failed validation.
  pub name: Str? = None
  /// The message describing why the field failed validation.
  pub message: Str? = None
}

/// The input for a wallpaper image. Provide the image as either a binary
/// image file or an S3 URI. Maximum 5 MB in JPEG or PNG format.
pub enum WallpaperImageInput {
  Blob(value: Bytes)
  S3Uri(value: Str)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// The policy that specifies which URLs end users are allowed to access or
/// which URLs or domain categories they are restricted from accessing for
/// enhanced security.
pub struct WebContentFilteringPolicy {
  /// Categories of websites that are blocked on the end user’s browsers.
  pub blocked_categories: List[Category]? = None
  /// URLs and domains that are always accessible to end users.
  pub allowed_urls: List[Str]? = None
  /// URLs and domains that end users cannot access.
  pub blocked_urls: List[Str]? = None
}
