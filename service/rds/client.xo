fn xml_write_db_capacity_reservation(var w: xmlv.Writer, v: DBCapacityReservation, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.db_capacity_reservation_name {
    xmlv.elem(w, "DBCapacityReservationName", x, [])
  }
  if let Some(x) = v.db_instance_class {
    xmlv.elem(w, "DBInstanceClass", x, [])
  }
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.license_model {
    xmlv.elem(w, "LicenseModel", x, [])
  }
  if let Some(x) = v.reserved_capacity_per_availability_zone {
    xmlv.elem(w, "ReservedCapacityPerAvailabilityZone", "${x}", [])
  }
  if let Some(x) = v.available_capacity_per_availability_zone_list {
    xml_write_available_capacity_per_availability_zone_list(w, x, "AvailableCapacityPerAvailabilityZoneList", [])
  }
  if let Some(x) = v.end_date {
    xmlv.elem(w, "EndDate", rest.date_time(x), [])
  }
  if let Some(x) = v.create_date {
    xmlv.elem(w, "CreateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.start_date {
    xmlv.elem(w, "StartDate", rest.date_time(x), [])
  }
  if let Some(x) = v.commitment_info {
    xml_write_db_capacity_reservation_commitment_info(w, x, "CommitmentInfo", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "State", x.value(), [])
  }
  if let Some(x) = v.db_capacity_reservation_arn {
    xmlv.elem(w, "DBCapacityReservationArn", x, [])
  }
  if let Some(x) = v.db_capacity_reservation_identifier {
    xmlv.elem(w, "DBCapacityReservationIdentifier", x, [])
  }
  if let Some(x) = v.tag_list {
    xml_write_tag_list(w, x, "TagList", [])
  }
  xmlv.end(w, name)
}

fn xml_read_db_capacity_reservation(e: xml.Element) -> DBCapacityReservation ! Str {
  var out = DBCapacityReservation{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DBCapacityReservationName" => out.db_capacity_reservation_name = c.text()
      "DBInstanceClass" => out.db_instance_class = c.text()
      "Engine" => out.engine = c.text()
      "LicenseModel" => out.license_model = c.text()
      "ReservedCapacityPerAvailabilityZone" => out.reserved_capacity_per_availability_zone = xmlv.read_int(c.text())?
      "AvailableCapacityPerAvailabilityZoneList" => out.available_capacity_per_availability_zone_list = xml_read_available_capacity_per_availability_zone_list(c)?
      "EndDate" => out.end_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "CreateDate" => out.create_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "StartDate" => out.start_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "CommitmentInfo" => out.commitment_info = xml_read_db_capacity_reservation_commitment_info(c)?
      "State" => out.state = DBCapacityReservationState.from(c.text())
      "DBCapacityReservationArn" => out.db_capacity_reservation_arn = c.text()
      "DBCapacityReservationIdentifier" => out.db_capacity_reservation_identifier = c.text()
      "TagList" => out.tag_list = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

