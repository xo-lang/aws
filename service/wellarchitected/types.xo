/// The organizational monitoring boundary configuration. Contains
/// organizational unit entries and individual account entries, each with
/// their own region selections, that define the scope for organizational
/// profile analysis.
pub struct OrganizationalAggregationConfiguration {
  /// A list of organizational unit or root entries that define the
  /// organizational scope. Each entry specifies an OU or root ID and the
  /// regions to monitor within it.
  pub organizational_units: List[OrganizationalUnitEntry]? = None
  /// A list of individual account entries that define additional accounts to
  /// include. Each entry specifies an account ID and the regions to monitor
  /// within it.
  pub accounts: List[OrganizationalAccountEntry]? = None
}

/// Filters narrowing the scope of an Organizational Report. Every member is
/// optional. An absent or empty member places no constraint on that
/// dimension. When the entire structure is absent, the report covers every
/// account and every recommendation in the organization.
pub struct OrganizationalReportFilters {
  /// AWS account IDs to include in the report. Absent or empty means all
  /// accounts in the organization are in scope. Each supplied account is
  /// validated against AWS Organizations membership. Accounts that do not
  /// belong to the caller's organization are excluded and recorded on the
  /// report's coverage summary.
  pub account_ids: List[Str]? = None
  /// AWS Organizational Unit IDs whose member accounts are included in the
  /// report. Absent or empty means no OU-based scoping is applied. Account
  /// and OU filters combine as a union.
  pub organizational_unit_ids: List[Str]? = None
  /// Well-Architected pillars to include. Absent or empty means all pillars.
  pub pillars: List[Pillar]? = None
  /// Recommendation types (RESOURCE, ARCHITECTURE, APPLICATION) to include.
  /// Absent or empty means all types.
  pub recommendation_types: List[RecommendationType]? = None
  /// Recommendation statuses (ACTIVE, SUPPRESSED, COMPLETED) to include.
  /// Absent or empty means all statuses.
  pub statuses: List[RecommendationStatus]? = None
  /// Recommendation priorities (HIGH, MEDIUM, LOW) to include. Absent or
  /// empty means all priorities.
  pub priorities: List[Priority]? = None
  /// Inclusive window on recommendation creation time. Absent means no lower
  /// or upper bound on createdAt.
  pub created_at_range: TimeWindow? = None
  /// Inclusive window on recommendation last-updated time. Absent means no
  /// lower or upper bound on updatedAt.
  pub updated_at_range: TimeWindow? = None
}

/// The output format for an Organizational Report artifact retrieved
/// through GetAgentOrganizationalReportData or delivered through
/// SendAgentOrganizationalReportDataToS3.
pub enum OrganizationalReportFormat: Str {
  Csv = "CSV"
  Json = "JSON"
  Parquet = "PARQUET"
  Unknown(value: Str)
}

/// The lifecycle state of an Organizational Report. The state advances
/// through the asynchronous pipeline: DISCOVERING (expanding the
/// caller-supplied scope into the full list of in-scope accounts and
/// profiles), SNAPSHOTTING (materializing per-account profile and
/// recommendation snapshots), AGGREGATING (merging snapshots into the final
/// artifact), COMPRESSING (writing the final CSV, JSON, or Parquet
/// artifacts to Amazon S3), COMPLETED (the report is ready to download),
/// FAILED (terminal failure), and DELETING (the report is being removed).
pub enum OrganizationalReportState: Str {
  Discovering = "DISCOVERING"
  Snapshotting = "SNAPSHOTTING"
  Aggregating = "AGGREGATING"
  Compressing = "COMPRESSING"
  Completed = "COMPLETED"
  Failed = "FAILED"
  Deleting = "DELETING"
  Unknown(value: Str)
}

/// Summary of an Organizational Report returned in a list response.
/// Includes the core fields of the full report and the optional label, but
/// omits the filters and coverage summary. The filters and coverage summary
/// are available through GetAgentOrganizationalReport. The coverage summary
/// is populated once the report reaches COMPLETED.
pub struct OrganizationalReportSummary {
  /// Unique identifier of the Organizational Report assigned by the service
  /// at creation time.
  pub report_id: Str? = None
  /// AWS account ID of the caller that created the report. Only this account
  /// or a delegated administrator of the same organization may retrieve or
  /// delete the report.
  pub owner_account_id: Str? = None
  /// Identifier of the AWS Organization the report belongs to. Derived from
  /// the caller's authorization context at creation time and not accepted as
  /// a client-supplied input.
  pub organization_id: Str? = None
  /// Optional human-readable label supplied by the caller at creation time.
  pub label: Str? = None
  /// Current lifecycle state of the report.
  pub state: OrganizationalReportState? = None
  /// Timestamp at which the report was created.
  pub created_at: Time? = None
}

