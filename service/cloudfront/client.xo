fn xml_write_distribution(var w: xmlv.Writer, v: Distribution, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.id {
    xmlv.elem(w, "Id", x, [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "ARN", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.last_modified_time {
    xmlv.elem(w, "LastModifiedTime", rest.date_time(x), [])
  }
  if let Some(x) = v.in_progress_invalidation_batches {
    xmlv.elem(w, "InProgressInvalidationBatches", "${x}", [])
  }
  if let Some(x) = v.domain_name {
    xmlv.elem(w, "DomainName", x, [])
  }
  if let Some(x) = v.active_trusted_signers {
    xml_write_active_trusted_signers(w, x, "ActiveTrustedSigners", [])
  }
  if let Some(x) = v.active_trusted_key_groups {
    xml_write_active_trusted_key_groups(w, x, "ActiveTrustedKeyGroups", [])
  }
  if let Some(x) = v.distribution_config {
    xml_write_distribution_config(w, x, "DistributionConfig", [])
  }
  if let Some(x) = v.alias_icp_recordals {
    xml_write_alias_icp_recordals(w, x, "AliasICPRecordals", [])
  }
  xmlv.end(w, name)
}

fn xml_read_distribution(e: xml.Element) -> Distribution ! Str {
  var out = Distribution{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Id" => out.id = c.text()
      "ARN" => out.arn = c.text()
      "Status" => out.status = c.text()
      "LastModifiedTime" => out.last_modified_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "InProgressInvalidationBatches" => out.in_progress_invalidation_batches = xmlv.read_int(c.text())?
      "DomainName" => out.domain_name = c.text()
      "ActiveTrustedSigners" => out.active_trusted_signers = xml_read_active_trusted_signers(c)?
      "ActiveTrustedKeyGroups" => out.active_trusted_key_groups = xml_read_active_trusted_key_groups(c)?
      "DistributionConfig" => out.distribution_config = xml_read_distribution_config(c)?
      "AliasICPRecordals" => out.alias_icp_recordals = xml_read_alias_icp_recordals(c)?
      _ => {}
    }
  }
  Ok(out)
}

