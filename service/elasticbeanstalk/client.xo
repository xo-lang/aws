fn xml_write_event_description(var w: xmlv.Writer, v: EventDescription, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.event_date {
    xmlv.elem(w, "EventDate", rest.date_time(x), [])
  }
  if let Some(x) = v.message {
    xmlv.elem(w, "Message", x, [])
  }
  if let Some(x) = v.application_name {
    xmlv.elem(w, "ApplicationName", x, [])
  }
  if let Some(x) = v.version_label {
    xmlv.elem(w, "VersionLabel", x, [])
  }
  if let Some(x) = v.template_name {
    xmlv.elem(w, "TemplateName", x, [])
  }
  if let Some(x) = v.environment_name {
    xmlv.elem(w, "EnvironmentName", x, [])
  }
  if let Some(x) = v.platform_arn {
    xmlv.elem(w, "PlatformArn", x, [])
  }
  if let Some(x) = v.request_id {
    xmlv.elem(w, "RequestId", x, [])
  }
  if let Some(x) = v.severity {
    xmlv.elem(w, "Severity", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_event_description(e: xml.Element) -> EventDescription ! Str {
  var out = EventDescription{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "EventDate" => out.event_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Message" => out.message = c.text()
      "ApplicationName" => out.application_name = c.text()
      "VersionLabel" => out.version_label = c.text()
      "TemplateName" => out.template_name = c.text()
      "EnvironmentName" => out.environment_name = c.text()
      "PlatformArn" => out.platform_arn = c.text()
      "RequestId" => out.request_id = c.text()
      "Severity" => out.severity = EventSeverity.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

