/// Updates a data transformation profile using chat-based interaction with
/// an agent. Supports multi-turn conversations for iteratively customizing
/// profiles.
pub fn (c: Client) update_profile_with_agent(input: UpdateProfileWithAgentRequest) -> UpdateProfileWithAgentEvents ! UpdateProfileWithAgentErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_profile_with_agent(c.params, input)) ?? e => return Err(UpdateProfileWithAgentErr.InvalidInput(e))
  var req = serialize_update_profile_with_agent(ep, input, "") ?? e => return Err(UpdateProfileWithAgentErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let opened = transport.open(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateProfileWithAgentErr.Send(e))
  match opened {
    Done(resp) => Err(deserialize_update_profile_with_agent_error(resp))
    Stream(head, body) => {
      // the other members are in the headers (an initial-response
      // event carries them in awsJson)
      match deserialize_update_profile_with_agent(http.Response{status: head.status, headers: head.headers, body: b""}) {
        Ok(o) => Ok(UpdateProfileWithAgentEvents{output: o, body: body})
        Err(msg) => {
          body.close()
          Err(UpdateProfileWithAgentErr.Deserialize(msg))
        }
      }
    }
  }
}
