  /// user.
  pub input_contexts: List[InputContext]? = None
  /// An array of OutputContext objects that lists the contexts that the
  /// intent activates when the intent is fulfilled.
  pub output_contexts: List[OutputContext]? = None
}

pub struct PutSlotTypeRequest {
  /// The name of the slot type. The name is not case sensitive. The name
  /// can't match a built-in slot type name, or a built-in slot type name with
  /// "AMAZON." removed. For example, because there is a built-in slot type
  /// called AMAZON.DATE , you can't create a custom slot type called DATE .
