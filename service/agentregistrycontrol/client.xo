}

fn from_json_source_details(v: json.Value) -> SourceDetails ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "agentcoreRuntime" => Ok(SourceDetails.AgentcoreRuntime(from_json_agent_core_runtime_source_details(fv)?))
      "agentcoreGateway" => Ok(SourceDetails.AgentcoreGateway(from_json_agent_core_gateway_source_details(fv)?))
      _ => Ok(SourceDetails.Unknown(k))
    }
  }
  Err("SourceDetails: no member set")
}

