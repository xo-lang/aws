fn xml_read_snapshot(e: xml.Element) -> Snapshot ! Str {
  var out = Snapshot{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "SnapshotName" => out.snapshot_name = c.text()
      "ReplicationGroupId" => out.replication_group_id = c.text()
      "ReplicationGroupDescription" => out.replication_group_description = c.text()
      "CacheClusterId" => out.cache_cluster_id = c.text()
      "SnapshotStatus" => out.snapshot_status = c.text()
      "SnapshotSource" => out.snapshot_source = c.text()
      "CacheNodeType" => out.cache_node_type = c.text()
      "Engine" => out.engine = c.text()
      "EngineVersion" => out.engine_version = c.text()
      "NumCacheNodes" => out.num_cache_nodes = xmlv.read_int(c.text())?
      "PreferredAvailabilityZone" => out.preferred_availability_zone = c.text()
      "PreferredOutpostArn" => out.preferred_outpost_arn = c.text()
      "CacheClusterCreateTime" => out.cache_cluster_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "TopicArn" => out.topic_arn = c.text()
      "Port" => out.port = xmlv.read_int(c.text())?
      "CacheParameterGroupName" => out.cache_parameter_group_name = c.text()
      "CacheSubnetGroupName" => out.cache_subnet_group_name = c.text()
      "VpcId" => out.vpc_id = c.text()
      "AutoMinorVersionUpgrade" => out.auto_minor_version_upgrade = xmlv.read_bool(c.text())?
      "SnapshotRetentionLimit" => out.snapshot_retention_limit = xmlv.read_int(c.text())?
      "SnapshotWindow" => out.snapshot_window = c.text()
      "NumNodeGroups" => out.num_node_groups = xmlv.read_int(c.text())?
      "AutomaticFailover" => out.automatic_failover = AutomaticFailoverStatus.from(c.text())
      "NodeSnapshots" => out.node_snapshots = xml_read_node_snapshot_list(c)?
      "KmsKeyId" => out.kms_key_id = c.text()
      "ARN" => out.arn = c.text()
      "DataTiering" => out.data_tiering = DataTieringStatus.from(c.text())
      "Durability" => out.durability = Durability.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

