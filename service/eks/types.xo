  /// Specify a reason reported by the node monitoring agent that this
  /// override would apply to.
  pub node_unhealthy_reason: Str? = None
  /// Specify the minimum time in minutes to wait before attempting to repair
  /// a node with this specific nodeMonitoringCondition and
  /// nodeUnhealthyReason .
  pub min_repair_wait_time_mins: Int? = None
  /// Specify the repair action to take for nodes when all of the specified
  /// conditions are met.
  pub repair_action: RepairAction? = None
}

