  /// SharePoint fields. For more information, see Mapping data source fields
  /// . The SharePoint data source field names must exist in your SharePoint
  /// custom metadata.
  pub field_mappings: List[DataSourceToIndexFieldMapping]? = None
  /// The Microsoft SharePoint attribute field that contains the title of the
  /// document.
  pub document_title_field_name: Str? = None
  /// TRUE to disable local groups information.
  pub disable_local_groups: Bool? = None
  /// The path to the SSL certificate stored in an Amazon S3 bucket. You use
  /// this to connect to SharePoint Server if you require a secure SSL
  /// connection. You can generate a self-signed X509 certificate on any
  /// computer using OpenSSL. For an example of using OpenSSL to create an
