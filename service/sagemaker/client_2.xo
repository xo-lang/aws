fn json_of_endpoint_input(v: EndpointInput) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.endpoint_name {
    fs.push(("EndpointName", json.Value.Str(x)))
  }
  if let Some(x) = v.local_path {
    fs.push(("LocalPath", json.Value.Str(x)))
  }
  if let Some(x) = v.s3_input_mode {
    fs.push(("S3InputMode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.s3_data_distribution_type {
    fs.push(("S3DataDistributionType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.features_attribute {
    fs.push(("FeaturesAttribute", json.Value.Str(x)))
  }
  if let Some(x) = v.inference_attribute {
    fs.push(("InferenceAttribute", json.Value.Str(x)))
  }
  if let Some(x) = v.probability_attribute {
    fs.push(("ProbabilityAttribute", json.Value.Str(x)))
  }
  if let Some(x) = v.probability_threshold_attribute {
    fs.push(("ProbabilityThresholdAttribute", jsonv.float(x)))
  }
  if let Some(x) = v.start_time_offset {
    fs.push(("StartTimeOffset", json.Value.Str(x)))
  }
  if let Some(x) = v.end_time_offset {
    fs.push(("EndTimeOffset", json.Value.Str(x)))
  }
  if let Some(x) = v.exclude_features_attribute {
    fs.push(("ExcludeFeaturesAttribute", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_endpoint_input(v: json.Value) -> EndpointInput ! Str {
  var out = EndpointInput{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "EndpointName" => out.endpoint_name = jsonv.read_str(fv)?
      "LocalPath" => out.local_path = jsonv.read_str(fv)?
      "S3InputMode" => out.s3_input_mode = ProcessingS3InputMode.from(jsonv.read_str(fv)?)
      "S3DataDistributionType" => out.s3_data_distribution_type = ProcessingS3DataDistributionType.from(jsonv.read_str(fv)?)
      "FeaturesAttribute" => out.features_attribute = jsonv.read_str(fv)?
      "InferenceAttribute" => out.inference_attribute = jsonv.read_str(fv)?
      "ProbabilityAttribute" => out.probability_attribute = jsonv.read_str(fv)?
      "ProbabilityThresholdAttribute" => out.probability_threshold_attribute = jsonv.read_float(fv)?
      "StartTimeOffset" => out.start_time_offset = jsonv.read_str(fv)?
      "EndTimeOffset" => out.end_time_offset = jsonv.read_str(fv)?
      "ExcludeFeaturesAttribute" => out.exclude_features_attribute = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}