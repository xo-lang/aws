/// Calls DescribeAutoScalingGroups until the GroupExists acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (120s).
pub fn wait_until_group_exists(c: Client, input: AutoScalingGroupNamesType, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeAutoScalingGroupsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_auto_scaling_groups(input) {
      Ok(out) => {
        let o = jmes_of_auto_scaling_groups_type(out)
        if state == "" && waiter.path_matches(o, "length(AutoScalingGroups) > `0`", "booleanEquals", "true") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "length(AutoScalingGroups) > `0`", "booleanEquals", "false") {
          state = "retry"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("GroupExists: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeAutoScalingGroups until the GroupInService acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (15s) to `max_delay` (120s).
