  /// Set to true to disassociate the configured KMS key. Mutually exclusive
  /// with kmsKeyArn; the service returns ValidationException if both are
  /// provided.
  pub remove_kms_key: Bool? = None
  /// Idempotency token for safe retries. Repeating a request with the same
  /// token applies the update at most once instead of reprocessing it.
  pub client_token: Str? = None
}

/// The intelligence configuration for the calling account after the update.
pub struct PutIntelligenceConfigurationOutput {
  /// The AWS account ID this configuration applies to.
  pub account_id: Str? = None
  /// The currently active KMS key ARN for customer-managed encryption, if
  /// configured.
  pub kms_key_arn: Str? = None
  /// ISO-8601 timestamp of the last update.
  pub updated_at: Time? = None
  /// ISO-8601 timestamp of initial creation.
  pub created_at: Time? = None
}

/// Query language for an alert rule expression.
pub enum QueryLanguage: Str {
  Sql = "SQL"
  Promql = "PROMQL"
  Unknown(value: Str)
}

/// Statistics about a telemetry query execution.
pub struct QueryStatistics {
  /// The number of bytes scanned by the query.
