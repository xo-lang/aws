/// live?"** — a live asset with a scan in flight and a *stopped* asset
/// with a scan in flight both projected `IN_PROGRESS`, and `FAILED`
/// collapsed the same way, because the projection ranked its inputs by a
/// frozen precedence and precedence discards facts. The fact it discarded
/// was liveness. The three internal axes the projection read now map onto
/// this member plus `LastActivationStatus` plus one internal-only
/// distinction, with no information lost. See campaign-asset-design.md §2
/// and §6. `COMPLETED` went because it was doing delivery's job: it meant
/// "delivered", which is a delivery outcome and not a lifecycle position.
/// For an email it was exactly `DeliveryStatus = DELIVERED`, already
/// modelled and already on the asset; for a social post it was
/// **unachievable**, because this service cannot observe social delivery at
/// all — so half of its stated meaning, "the email was sent, or the post
/// published", was never reachable. The other three startable types have no
/// delivery event whatever. It had no writer and no reader. Anyone
/// reintroducing a terminal position needs a fact observable for **every**
/// startable type, which `DeliveryStatus` explicitly is not — it covers
/// only EMAIL and SOCIAL_POST.
pub enum CampaignAssetState: Str {
  Inactive = "INACTIVE"
  Active = "ACTIVE"
  Unknown(value: Str)
}

/// Why an asset could not be, or was not, activated or delivered — the
/// one per-asset reason vocabulary: a task outcome's `Reason` (refused up
/// front or failed during the run), an `ActivationIssue`'s `Code`,
/// DeactivateCampaignAsset's `StateReason`, and an asset's
/// `DeliveryStatusReason`. Some of these require a change before another
/// attempt can succeed; others are transient and a retry is enough. Treat
/// an unrecognised value as transient and retryable.
pub enum CampaignAssetStateReason: Str {
  AssetNotFound = "ASSET_NOT_FOUND"
  AssetNotStartable = "ASSET_NOT_STARTABLE"
  AssetStartInProgress = "ASSET_START_IN_PROGRESS"
  AssetAlreadyActive = "ASSET_ALREADY_ACTIVE"
  SendWindowTooSoon = "SEND_WINDOW_TOO_SOON"
  RequiredFieldMissing = "REQUIRED_FIELD_MISSING"
  RecipientListMissing = "RECIPIENT_LIST_MISSING"
  EngagementGroupsUnavailable = "ENGAGEMENT_GROUPS_UNAVAILABLE"
  SenderEmailMissing = "SENDER_EMAIL_MISSING"
  EndOnMissing = "END_ON_MISSING"
  AssetContentMissing = "ASSET_CONTENT_MISSING"
  AssetNotActivatable = "ASSET_NOT_ACTIVATABLE"
  TemplateChanged = "TEMPLATE_CHANGED"
  PartnerImageRejected = "PARTNER_IMAGE_REJECTED"
  PrerequisiteAssetNotActive = "PREREQUISITE_ASSET_NOT_ACTIVE"
  PartnerNotProvisioned = "PARTNER_NOT_PROVISIONED"
  RecipientListEmpty = "RECIPIENT_LIST_EMPTY"
  RecipientLimitExceeded = "RECIPIENT_LIMIT_EXCEEDED"
  ContactOptInRequired = "CONTACT_OPT_IN_REQUIRED"
  MailingCreditsExhausted = "MAILING_CREDITS_EXHAUSTED"
  SenderEmailInvalid = "SENDER_EMAIL_INVALID"
  SocialConnectionMissing = "SOCIAL_CONNECTION_MISSING"
  SocialConnectionExpired = "SOCIAL_CONNECTION_EXPIRED"
  SocialConnectionPageRequired = "SOCIAL_CONNECTION_PAGE_REQUIRED"
  DeliveryFailed = "DELIVERY_FAILED"
  InternalError = "INTERNAL_ERROR"
  MailingCreditsInsufficient = "MAILING_CREDITS_INSUFFICIENT"
  PartnerProfileFieldMissing = "PARTNER_PROFILE_FIELD_MISSING"
  PartnerProfileFieldDoesNotFit = "PARTNER_PROFILE_FIELD_DOES_NOT_FIT"
  SocialConnectionNotChosen = "SOCIAL_CONNECTION_NOT_CHOSEN"
  PrivacyPolicyUrlMissing = "PRIVACY_POLICY_URL_MISSING"
  PartnerAddressMissing = "PARTNER_ADDRESS_MISSING"
  SendModeMissing = "SEND_MODE_MISSING"
  ContentRejected = "CONTENT_REJECTED"
  UrlNotAllowed = "URL_NOT_ALLOWED"
  SenderNotApproved = "SENDER_NOT_APPROVED"
  Unknown(value: Str)
}

/// Summary representation of an asset for list operations.
pub struct CampaignAssetSummary {
  /// The asset identifier.
  pub id: Str? = None
  /// The asset category.
  pub category: CampaignAssetCategory? = None
  /// The display name.
  pub name: Str? = None
  /// DOCUMENT only: the words a page uses for this document, such as "eBook".
  /// A client listing the candidates for an `AssetLink` field reads it here,
  /// so a preview can update on pick without a fetch.
  pub link_label: Str? = None
  /// Where the asset sits in its lifecycle.
  pub state: CampaignAssetState? = None
  /// How the last hand-over to the delivery platform ended. Absent before the
  /// first activation.
  pub last_activation_status: AttemptStatus? = None
  /// Whether the platform has delivered the asset.
  pub delivery_status: DeliveryStatus? = None
  /// Why delivery failed. Present only when DeliveryStatus is FAILED. For an
  /// email the platform rejected: SENDER_EMAIL_INVALID, RECIPIENT_LIST_EMPTY,
  /// MAILING_CREDITS_EXHAUSTED or RECIPIENT_LIMIT_EXCEEDED. Otherwise
  /// DELIVERY_FAILED. A Facebook post refused because its connection has no
  /// Page is FAILED with SOCIAL_CONNECTION_PAGE_REQUIRED, and withdrawn:
  /// reconnect Facebook with a Page selected. A social post the platform
  /// stopped retrying, because it could not publish within 12 hours of its
  /// scheduled time, is FAILED with DELIVERY_FAILED. Any other social post
  /// that could not be published stays PENDING while it is investigated, and
  /// is reported FAILED with DELIVERY_FAILED once it is confirmed it will not
  /// go out. Deactivate and activate the asset again to retry.
  pub delivery_status_reason: CampaignAssetStateReason? = None
  /// The asset template this asset was created from. The same value
  /// `CampaignAsset.SourceAssetTemplateId` reports, and absent when it is.
  pub source_asset_template_id: Str? = None
  /// SOCIAL_POST only: the platform the post goes to. Join it with
  /// ListSocialConnections' status for that platform to show a post that
  /// cannot activate (a connection missing, EXPIRED or PAGE_REQUIRED) before
  /// Start is pressed.
  pub social_platform: Platform? = None
  /// When the asset first went live, set once. Absent if it never has.
  pub started_at: Time? = None
  /// Concrete file format of the finished artifact.
  pub file_format: FileFormat? = None
  /// When this asset sends, as chosen with UpdateCampaignAsset. `EMAIL` and
  /// `SOCIAL_POST` only — the two categories whose delivery platform holds
  /// a schedule of its own. Absent until chosen, and then the asset reports
  /// `SEND_MODE_MISSING`.
  pub send_mode: SendMode? = None
  /// The send time, present only when `SendMode` is `SCHEDULED`. It reaches
  /// the delivery platform at the asset's next activation. Was `scheduleDate:
  /// UtcDate`; retyped with the write member of the same name.
  pub scheduled_send_at: Time? = None
}

/// One asset blueprint inside a campaign template. The id is template-local
/// — an asset template is not a standalone resource and has no ARN.
pub struct CampaignAssetTemplate {
  /// The template-local asset template identifier.
  pub id: Str? = None
  /// The kind of asset this blueprint instantiates as.
  pub type_value: CampaignAssetTemplateType? = None
  /// Display label; becomes the instantiated asset's name.
  pub label: Str? = None
  /// Ordering for preview and instantiation.
  pub display_order: Int? = None
  /// The editable-field schema, copied and pinned onto each campaign asset at
  /// create. Fields the service fills itself are not listed.
  pub fields: List[CampaignAssetTemplateField]? = None
  /// Previews of the AWS-authored layout skeleton.
  pub layout_previews: List[LayoutPreview]? = None
  /// The asset templates this one embeds output from, such as an email's
  /// landing page. Each must be in the same `BatchCreateCampaignAsset`
  /// request or already an asset on the campaign, else the create is refused
  /// `PREREQUISITE_ASSET_MISSING`; include them when the partner picks this
  /// one. Absent when there are none. A link the partner chooses, such as a
  /// landing page's download button, is not listed here: it is an `AssetLink`
  /// field and needs nothing at create.
  pub prerequisite_asset_template_ids: List[Str]? = None
  /// SOCIAL_POST only: the platform an asset made from this blueprint posts
  /// to, which the asset reports as `SocialPlatform`. Fixed by the template,
  /// so a client can show which social connection the post needs before it is
  /// created. Absent for every other type.
  pub social_platform: Platform? = None
}

/// One slot in an asset template's layout: addressing key, placement, and
/// the field kind carrying its own constraints, placeholder or default.
pub struct CampaignAssetTemplateField {
  /// The field identifier; matches a {{fieldId}} slot in the layout.
  pub field_id: Str? = None
  /// Human-readable name for the field, for display. Authored in the template
  /// policy, never derived from the field id or the source layout's field
  /// name: the id is a slug (`Page_2_Title`) and is not meant to be shown to
  /// a partner. Absent on fields imported before labels existed.
  pub label: Str? = None
  /// What belongs in this field, in English: its role in the asset and what
  /// good content for it is (for example "Headline that names the customer
  /// and leads with a source-backed statistic"). AWS-authored with the
  /// template; never written by a partner. Absent when the template carries
  /// none, never empty. Pinned onto the asset with the field, so a corrected
  /// description reaches assets created after the correction.
  pub description: Str? = None
  /// Layout section the field belongs to.
  pub section: TemplateFieldSection? = None
  /// One-based page number, for paginated layouts (print documents).
  pub page: Int? = None
  /// Whether the field must be filled before the asset can be activated.
  /// Derived from DG policy — never inherited from an upstream authoring
  /// system. Required for activation, not for saving: `UpdateCampaignAsset`
  /// accepts partial content and may clear a required field. An unfilled
  /// required field appears in the asset's `ActivationIssues` as
  /// `REQUIRED_FIELD_MISSING`, and activation refuses the asset with the same
  /// code. A text field is filled only by a non-blank value, and a rich-text
  /// field only by a value with non-blank text; a `Placeholder` never fills
  /// one. An image field is filled by the partner's image or by the
  /// template's `DefaultValue`. A field the campaign fills
  /// (`CampaignSetting`) or the partner's profile fills
  /// (`PartnerProfileField`) is never unfilled on the asset.
  pub required: Bool? = None
  /// The field kind, with that kind's constraints, placeholder or default.
  pub type_value: FieldType? = None
  /// The campaign setting this field shows, when it shows one: the partner
  /// sets it once on the campaign and every asset displays it. Present only
  /// on such fields. A client shows the field as "Set on the campaign",
  /// linking to the campaign, rather than as an input. `UpdateCampaignAsset`
  /// refuses a value for it with `FIELD_SET_ON_CAMPAIGN`, and on an asset the
  /// field carries no value: read it from the named member of `GetCampaign`'s
  /// `Campaign`.
  pub campaign_setting: CampaignSetting? = None
  /// The partner-profile value this field shows, when it shows one: the
  /// partner's AWS Partner Central profile supplies it, and every asset of
  /// every campaign displays it. Present only on such fields. A client shows
  /// the field as "From your Partner Central profile" rather than as an
  /// input. `UpdateCampaignAsset` refuses a value for it with
  /// `FIELD_FROM_PARTNER_PROFILE`. On a read the field carries the partner's
  /// resolved value — the logo as its URL, the name and website as text —
  /// so a slot renders from this list alone; `GetCampaign`'s
  /// `Campaign$PartnerProfile` carries the same three values.
  pub partner_profile_field: PartnerProfileField? = None
}

/// The kind of asset an asset template instantiates as.
pub enum CampaignAssetTemplateType: Str {
  Email = "EMAIL"
  SocialPost = "SOCIAL_POST"
  LandingPage = "LANDING_PAGE"
  BannerAd = "BANNER_AD"
  Document = "DOCUMENT"
  Unknown(value: Str)
}

/// A campaign setting, named by its `Campaign` member: one an asset field
/// shows, or one an asset needs before it can activate
/// (`ActivationIssue$CampaignSetting`).
pub enum CampaignSetting: Str {
  SenderEmail = "SENDER_EMAIL"
  EndOn = "END_ON"
  EmailTarget = "EMAIL_TARGET"
  PrivacyPolicyUrl = "PRIVACY_POLICY_URL"
  PartnerAddress = "PARTNER_ADDRESS"
  PartnerBadge = "PARTNER_BADGE"
  Unknown(value: Str)
}

/// How to order `ListCampaigns`. Ties break by campaign id, ascending.
pub struct CampaignSort {
  /// The attribute to sort by.
  pub sort_by: CampaignSortName? = None
  /// The direction.
  pub sort_order: SortOrder? = None
}

/// The attribute `ListCampaigns` sorts by.
pub enum CampaignSortName: Str {
  Name = "NAME"
  State = "STATE"
  StartOn = "START_ON"
  CreatedAt = "CREATED_AT"
  Unknown(value: Str)
}

/// A campaign's state, derived on every read from its `EndOn` and its
/// assets: 1. `COMPLETED` once the UTC date is after `EndOn` (so a campaign
/// ending today completes at the next UTC midnight). A campaign with no
/// `EndOn` never completes, and cannot activate until it has one; 2.
/// otherwise `ACTIVE` when any of its assets is `ACTIVE`; 3. otherwise
/// `DRAFT`, including a campaign with no assets. A summary of the assets,
/// not a lifecycle: nothing transitions it, it is never stored, and it
/// gates no operation by itself: the refusal on a completed campaign
/// (`CAMPAIGN_COMPLETED`) reads the same `EndOn`. Otherwise whether an
/// asset can be edited, activated or deleted depends on that asset. So a
/// scheduled email counts as `ACTIVE` once armed, before it sends; a
/// campaign stays `DRAFT` during its first activation; deactivating its
/// only active email or social post returns it to `DRAFT`; and a
/// `COMPLETED` campaign can still have live landing pages.
pub enum CampaignState: Str {
  Draft = "DRAFT"
  Active = "ACTIVE"
  Completed = "COMPLETED"
  Unknown(value: Str)
}

/// Summary representation of a campaign for list operations.
pub struct CampaignSummary {
  /// The campaign identifier.
  pub campaign_id: Str? = None
  /// The campaign ARN. Present on the summary so a caller can tag a campaign
  /// straight from a list result without a GetCampaign per row — the same
  /// reason the audit timestamps are here.
  pub arn: Str? = None
  /// The display name.
  pub name: Str? = None
  /// The campaign's state, derived on every read from `EndOn` and its assets.
  /// See `CampaignState`.
  pub state: CampaignState? = None
  /// The language the campaign's assets are written and typeset in. See
  /// `Campaign$Language`.
  pub language: AssetLanguage? = None
  /// The first day of the campaign's run window.
  pub start_on: Str? = None
  /// The last day of the campaign's run window.
  pub end_on: Str? = None
  /// Creation timestamp. Present on the summary so a caller can order a list
  /// by recency without reading each campaign in full.
  pub created_at: Time? = None
  /// Last update timestamp. Present on the summary for the same reason as
  /// CreatedAt.
  pub updated_at: Time? = None
}

/// A platform-managed campaign template — an AWS-authored kit of asset
/// blueprints a partner creates a campaign from.
pub struct CampaignTemplate {
  /// The campaign template identifier.
  pub id: Str? = None
  /// The display name.
  pub name: Str? = None
  /// Target industry for filtering or categorization.
  pub industry: Industry? = None
  /// Campaign use case for filtering or categorization.
  pub use_case: Str? = None
  /// A short overview of the campaign, as plain text in the template's
  /// language: no HTML and no character entities. Absent when the template
  /// has none; never an empty string.
  pub description: Str? = None
  /// Language the template is authored in, which a campaign created from it
  /// takes. A template has one language; the same content in another language
  /// is another template.
  pub language_code: AssetLanguage? = None
  /// The browsing context the template is listed in. Every template has
  /// exactly one.
  pub collection: CampaignTemplateCollection? = None
  /// AWS services the template promotes.
  pub aws_services: List[Str]? = None
  /// The customer segments the template is written for. Absent when the
  /// template names none, in which case it matches every `CustomerSegments`
  /// search filter.
  pub customer_segments: List[CustomerSegment]? = None
  /// The template's marketing themes. Absent when the template names none, in
  /// which case it matches every `Themes` search filter.
  pub themes: List[Theme]? = None
  /// Estimated setup time.
  pub setup_duration: Str? = None
  /// Thumbnail URL.
  pub thumbnail_url: Str? = None
  /// The instant the template becomes available to partners. Until then the
  /// template does not exist to a partner: SearchCampaignTemplates omits it
  /// and GetCampaignTemplate returns ResourceNotFoundException.
  pub effective_date_begin: Time? = None
  /// The ordered asset blueprints. One call serves both template browsing and
  /// server-side copy-at-create.
  pub asset_templates: List[CampaignAssetTemplate]? = None
  /// The template's reference materials: guides, briefs, copy blocks and
  /// other files a partner downloads and uses in their own channels. Kept
  /// apart from `AssetTemplates` because none of them can become a campaign
  /// asset — they have no editable field and nothing to activate — and
  /// listing them beside the blueprints invited a `BatchCreateCampaignAsset`
  /// that could only fail. Absent when the template has none.
  pub reference_materials: List[ReferenceMaterial]? = None
  /// Creation timestamp.
  pub created_at: Time? = None
  /// Last update timestamp.
  pub updated_at: Time? = None
}

/// Which browsing context a campaign template belongs to. A classification
/// of the template, not a resource: it decides where a client lists the
/// template and grants nothing. Every partner may read and use a template
/// in any collection. Clients must tolerate values added later.
pub enum CampaignTemplateCollection: Str {
  General = "GENERAL"
  BuildWithAi = "BUILD_WITH_AI"
  Unknown(value: Str)
}

/// Summary representation of a campaign template, returned by search.
pub struct CampaignTemplateSummary {
  /// The campaign template identifier.
  pub id: Str? = None
  /// The display name.
  pub name: Str? = None
  /// Target industry for filtering or categorization.
  pub industry: Industry? = None
  /// Campaign use case for filtering or categorization.
  pub use_case: Str? = None
  /// The campaign overview. See `CampaignTemplate$Description`.
  pub description: Str? = None
  /// Language the template is authored in. See
  /// `CampaignTemplate$LanguageCode`.
  pub language_code: AssetLanguage? = None
  /// The browsing context the template is listed in. See
  /// `CampaignTemplate$Collection`.
  pub collection: CampaignTemplateCollection? = None
  /// AWS services the template promotes.
  pub aws_services: List[Str]? = None
  /// The customer segments the template is written for. See
  /// `CampaignTemplate$CustomerSegments`.
  pub customer_segments: List[CustomerSegment]? = None
  /// The template's marketing themes. See `CampaignTemplate$Themes`.
  pub themes: List[Theme]? = None
  /// Thumbnail URL.
  pub thumbnail_url: Str? = None
}

/// Catalog shape.
pub enum Catalog: Str {
  Aws = "AWS"
  Sandbox = "Sandbox"
  Unknown(value: Str)
}

/// CompanySize shape.
pub enum CompanySize: Str {
  Startup = "STARTUP"
  SmallBusiness = "SMALL_BUSINESS"
  MidMarket = "MID_MARKET"
  Enterprise = "ENTERPRISE"
  GlobalEnterprise = "GLOBAL_ENTERPRISE"
  Unknown(value: Str)
}

/// The request conflicts with the current state of the resource.
pub struct ConflictException {
  /// Error message.
  pub message: Str? = None
  /// The affected resource identifier. For a uniqueness conflict this is the
  /// identifier of the *existing* resource, so the caller can act on it
  /// without a separate lookup.
  pub resource_id: Str? = None
  /// The affected resource type.
  pub resource_type: Str? = None
  /// Machine-readable cause, for clients that branch on it. An open set of
  /// `SCREAMING_SNAKE_CASE` tokens, deliberately typed as a string rather
  /// than an enum. `ConflictException` is shared by every resource in this
  /// service, so an enum here would accumulate values that are meaningful for
  /// one resource and inapplicable to the rest — the cohesiveness problem
  /// the Backward Compatibility standard describes under "Sharing enums" —
  /// and each new value would force an SDK regeneration on callers who can
  /// never encounter it. Clients MUST treat an unrecognised value as an
  /// unspecified conflict and fall back to `Message`. Values in use today:
  /// From the campaign asset activation path. Every one of these is decided
  /// before the operation returns, so a caller that receives one knows
  /// nothing was started. These two are thrown by `DeactivateCampaignAsset`,
  /// which refuses one asset outright. `StartCampaignAssetActivationTask`
  /// reports the same two causes **per asset** as a FAILED task entry instead
  /// of throwing, because one bad identifier must not refuse the twenty-four
  /// good ones beside it — so the spellings are deliberately identical to
  /// `CampaignAssetStateReason`'s, letting a client match one string
  /// whichever way the refusal arrived. The two types evolve independently on
  /// purpose: this is an open string shared by every resource, that is a
  /// closed enum owned by one operation. - `ASSET_START_IN_PROGRESS` — the
  /// asset is already being started, or another caller changed it during this
  /// request. Retryable once the outcome is visible. -
  /// `PREREQUISITE_ASSET_NOT_ACTIVE` — this asset embeds output from
  /// another asset that is not live. `ResourceId` carries that asset's
  /// identifier. From the prerequisite edges between a campaign's assets —
  /// an email that embeds its landing page's URL. Both refuse the whole
  /// request and write nothing. - `PREREQUISITE_ASSET_MISSING` — from
  /// `BatchCreateCampaignAsset`: an entry's blueprint embeds another
  /// blueprint's output, and that blueprint is neither named in the same
  /// request nor already an asset on the campaign. Retry with it in the
  /// request. `ResourceId` carries the missing blueprint's identifier. -
  /// `ASSET_HAS_DEPENDENTS` — from `DeleteCampaignAsset`: another asset on
  /// the campaign embeds this asset's output, so deleting it would leave that
  /// asset unactivatable. Delete the dependents first. The message names
  /// them. `CAMPAIGN_COMPLETED` — the campaign is complete (the UTC date is
  /// after its `EndOn`), so it and its assets are read-only. Refuses
  /// `UpdateCampaign`, `BatchCreateCampaignAsset`, `UpdateCampaignAsset`,
  /// `DeleteCampaignAsset` and `StartCampaignAssetActivationTask`; never
  /// `DeactivateCampaignAsset`. **Not retryable, and not fixable** —
  /// `EndOn` cannot be moved once it has passed, so nothing the caller does
  /// will make the write succeed. `ResourceId` carries the campaign
  /// identifier. ⚠️ This is the one conflict reason whose condition
  /// **never clears**, which sits awkwardly with `ConflictException`
  /// promising a state that may change. It is a conflict rather than a
  /// validation failure because the request is well formed and would have
  /// succeeded a moment earlier — the resource's state is what refuses it,
  /// which is what this exception is for. Contrast `ASSET_NOT_STARTABLE`,
  /// which moved to `ValidationException` precisely because it is a property
  /// of the asset's *type* rather than of its state. ⚠️ **`COMPLETED`
  /// also exists as a `CampaignAssetExportTaskStatus` value, on a different
  /// axis.** That one means an export archive finished assembling. The two
  /// are unrelated and must not be unified. `CAMPAIGN_HAS_ACTIVE_ASSETS` —
  /// from `DeleteCampaign`: at least one of the campaign's assets is live,
  /// and deleting the campaign would orphan what the delivery platform still
  /// serves or sends. Deactivate those assets with `DeactivateCampaignAsset`,
  /// then retry. The message names them. `ResourceId` carries the campaign
  /// identifier. `CAMPAIGN_ACTIVATION_IN_PROGRESS` — from
  /// `StartCampaignAssetActivationTask` and `DeleteCampaign`, refusing the
  /// whole request: one activation task runs on a campaign at a time.
  /// `ResourceId` carries the **holding task's id**, so a caller can poll
  /// `GetCampaignAssetActivationTask` rather than guess. Retryable once that
  /// task reaches a terminal status.
  /// `SERVICE_LINKED_ROLE_DELETION_IN_PROGRESS` — from
  /// `StartCampaignAssetActivationTask`, refusing the whole request: this
  /// service's service-linked role is being deleted, so no asset may go live.
  /// Not a lease conflict: `ResourceId` is unset and there is no task to
  /// poll. Retryable after a short wait; if the role was deleted, the next
  /// activation recreates it. `LAYOUT_LOCKED_AFTER_ACTIVATION` — from
  /// `UpdateCampaignAsset`, refusing a `Layout` change on a multi-layout
  /// asset that has activated successfully at least once (DG-044). The
  /// published object is that layout's, so switching would leave the asset
  /// describing a layout that is not the one live. **Not fixable**: the asset
  /// keeps its layout for life. A failed activation does not lock it.
  /// Re-sending the layout already selected is not a change and is accepted.
  /// `ResourceId` carries the asset identifier. `ASSET_START_IN_PROGRESS` —
  /// also from `UpdateCampaignAsset`, refusing any edit to an asset the
  /// campaign's running activation task has accepted and not yet finished:
  /// the run publishes the content it read, so an edit accepted mid-run would
  /// either be published unvalidated or never published. Nothing is written.
  /// Retryable once the asset's outcome on the task
  /// (`GetCampaignAssetActivationTask`) is terminal; the asset's siblings may
  /// still be running. `ResourceId` carries the asset identifier.
  /// `ASSET_ALREADY_ACTIVE` — from `UpdateCampaignAsset`, refusing any
  /// change to a live email or social post, content or schedule. Deactivate
  /// it first; the next activation sends everything current. Landing pages
  /// and documents are edited live and converge by re-activation.
  /// `ResourceId` carries the asset identifier. `ASSET_NOT_DEACTIVATABLE` —
  /// from `DeactivateCampaignAsset`, for an asset that can't be stopped: a
  /// document, banner or landing page until the campaign has completed, when
  /// it becomes removable. Until then, update it and activate it again.
  /// `ResourceId` carries the asset identifier. `ASSET_HAS_LOCKED_SENDS` —
  /// from `DeactivateCampaignAsset`, within an hour of the asset's send (a
  /// social post's publish), when it can no longer be withdrawn.
  /// `ASSET_ALREADY_DELIVERED` — the same, once that time has passed: a
  /// sent email or a published post cannot be recalled. Neither is retryable.
  /// Three values were removed with the campaign lifecycle and the singular
  /// activate, and none should be re-added here: - `CAMPAIGN_NOT_STARTED` —
  /// a campaign has no state to be started out of. - `ASSET_NOT_STARTABLE`
  /// — moved to `ValidationException`, with no reason. The value's own
  /// documentation said it was "not retryable and not fixable: it is a
  /// property of the asset's type", and `ConflictException` promises a state
  /// that may change. The gate itself stays — deleting it lets a
  /// download-only asset into a task with no dispatch arm, which would
  /// succeed and do nothing. - `ASSET_START_UNCONFIRMED` — described a
  /// state that no longer occurs. DG cannot be more idempotent than a
  /// platform whose social create has no idempotency key, so an ambiguous
  /// hand-over is now an ordinary failure carrying `INTERNAL_ERROR`. Holding
  /// the asset in a distinct state bought a guarantee that was never real,
  /// and had no exit.
  pub reason: Str? = None
}

/// Input for CreateCampaign operation.
pub struct CreateCampaignRequest {
  /// The catalog (AWS or Sandbox).
  pub catalog: Catalog? = None
  /// The display name.
  pub name: Str? = None
  /// The campaign template this campaign draws its assets from. Binds the
  /// campaign to a single source template: every asset must come from this
  /// template's asset templates, and one from another template is refused at
  /// `BatchCreateCampaignAsset`. Immutable once set. Every campaign has one:
  /// a campaign's language and its assets' blueprints both come from its
  /// template. Templates are AWS-authored and read-only — they are
  /// discovered through `SearchCampaignTemplates` and `GetCampaignTemplate`,
  /// and there is no create, update or delete operation for one. The
  /// template's id only: a campaign template has no ARN (DG-084). The member
  /// keeps the ` Id` name, which is the convention for referencing another
  /// resource from a body.
  pub campaign_template_id: Str? = None
  /// The address every email of this campaign is sent from. Printable ASCII
  /// only, with no spaces or line breaks, or field code `PATTERN_MISMATCH`.
  /// Then three rules, all checked when the sender is set. Its domain must
  /// exactly match, ignoring case, the domain of the partner's alliance lead
  /// email in AWS Partner Central (a subdomain does not), or field code
  /// `SENDER_DOMAIN_NOT_ALLIANCE_LEAD`. Then, for a sender at example.com,
  /// DNS must hold the CNAME `dkim._domainkey.example.com` →
  /// `dkim._domainkey.md02.com` (field code `SENDER_DOMAIN_DKIM_MISSING`) and
  /// a DMARC record, one TXT `_dmarc.example.com` starting `v=DMARC1` with a
  /// `p` of `none`, `quarantine` or `reject` (field code
  /// `SENDER_DOMAIN_DMARC_MISSING`). Both DNS codes are reported together
  /// when both records are missing. A partner who can't satisfy them can't
  /// set a sender, so can't run email campaigns. A shared mail provider's
  /// domain, such as gmail.com, can't carry the records. Optional here: a
  /// campaign with no sender can be created and edited, but its email assets
  /// cannot be activated until one is set.
  pub sender_email: Str? = None
  /// The URL of the partner's privacy policy, linked from every email and
  /// landing page footer. Optional here: a campaign whose emails or landing
  /// pages show it cannot activate them until one is set.
  pub privacy_policy_url: Str? = None
  /// The partner's physical postal address, shown in every email footer and
  /// as a landing page's contact line. Optional here: an email that shows it
  /// cannot activate until one is set. A landing page that shows it publishes
  /// it empty when it is unset, and a document's footer then prints the
  /// partner's name alone.
  pub partner_address: Str? = None
  /// The partner's badge — a tier or designation badge from AWS Partner
  /// Badge Manager — shown in every badge slot of the campaign's emails,
  /// landing pages and documents. Optional: until one is set, every badge
  /// slot shows the Standalone AWS Partner badge. A PNG or JPEG of at most 2
  /// MB, staged like an asset image and checked the same way: it must have
  /// passed the staging scan (`SCAN_REJECTED`, or `SCAN_IN_PROGRESS` while it
  /// is pending), and its bytes must be the format its name says
  /// (`IMAGE_FORMAT_NOT_SUPPORTED`). Any shape is accepted: a badge is drawn
  /// whole, never cropped. Content moderation judges it when an asset that
  /// shows it is activated.
  pub partner_badge: FileRef? = None
  /// The campaign's send audience — a CSV of recipient email addresses. The
  /// campaign's *target*: who the campaign is sent to, as distinct from a
  /// `CampaignAsset`, which is the content that is sent. It sits on the
  /// campaign and not on the activation call because a partner assembles it
  /// in the same wizard flow that sets the name and the dates — and because
  /// attaching it here means it is validated, staged and resolved to a count
  /// before anything is activated, rather than at the last click. Required
  /// format: a header row naming the email column `Email`, `E-mail`, `Email
  /// Address` or `E-mail Address` — compared without case, spaces or
  /// punctuation. Other columns are permitted and ignored, and with two email
  /// columns the first is used. A file without such a header is refused with
  /// field code `EMAIL_COLUMN_MISSING`: the address column is never guessed.
  /// The rows reach the delivery platform's importer as the partner wrote
  /// them — a partner's audience is never rewritten. At most 5 MB, checked
  /// against the object's size before anything is copied, and at most 10,000
  /// distinct addresses, refused with `RECIPIENT_LIST_TOO_LARGE`. A file with
  /// no valid address at all is refused with `RECIPIENT_LIST_EMPTY`;
  /// otherwise rows without a usable address are not a refusal: they are
  /// skipped and counted, and `GetCampaign` reports the counts. Optional
  /// here, because a campaign is a container and holds no state to be
  /// incomplete in — but an email asset cannot be activated without it, so
  /// the requirement moved to the point of activation. Editable at any time,
  /// and an edit reaches the delivery platform only when an asset is
  /// activated after it. Each email activation loads the audience into a
  /// contact list of its own, so an address taken off the file is not sent to
  /// by the next activation. The bytes are write-only. No response returns a
  /// URL or an `S3Uri` for this file; `GetCampaign` returns the scan verdict,
  /// when the list was attached and how its rows resolved, and nothing more.
  pub email_target: FileRef? = None
  /// Engagement groups whose contacts the campaign's emails will also go to:
  /// the `Id`s `ListEngagementGroups` returns (AWS Partner Central Selling).
  /// 1–10, each named once. Each group is named once: a repeated id is
  /// refused with field code `INVALID_VALUE`. Not checked against your groups
  /// when saved. StartCampaignAssetActivationTask resolves them to
  /// recipients. On a stage that can't resolve groups yet, Start refuses an
  /// email while groups are set (`ENGAGEMENT_GROUPS_UNAVAILABLE`), rather
  /// than send to `EmailTarget` alone.
  pub email_target_engagement_group_ids: List[Str]? = None
  /// Advisory targeting metadata. Refined later, and not validated here.
  pub target_audience: TargetAudience? = None
  /// What the partner expects the campaign to cost.
  pub estimated_budget: MonetaryValue? = None
  /// The campaign's total budget.
  pub total_budget: MonetaryValue? = None
  /// The first day of the campaign's run window. Not after `EndOn`
  /// (`ValidationException`, `INVALID_VALUE`).
  pub start_on: Str? = None
  /// The last day of the campaign's run window, inclusive and in UTC. Not in
  /// the past: the campaign completes at the UTC midnight after it (see
  /// `CampaignState`). A scheduled send must fall on or before it. Optional
  /// here, but required before any asset activates: until it is set,
  /// GetCampaign's `ActivationIssues` reports `END_ON_MISSING` and
  /// StartCampaignAssetActivationTask refuses (`CAMPAIGN_INCOMPLETE`). Set it
  /// with UpdateCampaign.
  pub end_on: Str? = None
  /// Idempotency token. Same token within 24h returns existing resource.
  pub client_token: Str? = None
  /// Tags to apply at creation. Tag-on-create rather than create-then-tag is
  /// a Tagris requirement, not a convenience: it is what lets a tag-based
  /// access control policy govern the creation itself. A campaign created
  /// untagged and tagged a moment later is briefly outside any such policy. A
  /// key beginning `aws:` (any case) is reserved for AWS-applied system tags
  /// and is refused with `ValidationException`, as is a key repeated in the
  /// list; nothing is created. The tags are recorded before the campaign is
  /// written, so a create that cannot record them fails and creates nothing.
  /// A retry with the same `ClientToken` returns the campaign the first
  /// attempt created and does not re-apply tags — use `TagResource` to
  /// change them afterwards. `ListTagsForResource` returns them.
  pub tags: List[Tag]? = None
}

