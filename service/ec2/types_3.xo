  /// size. You can specify a volume size that is equal to or larger than the
  /// snapshot size. The following are the supported sizes for each volume
  /// type: gp2 : 1 - 16,384 GiB gp3 : 1 - 65,536 GiB io1 : 4 - 16,384 GiB io2
  /// : 4 - 65,536 GiB st1 and sc1 : 125 - 16,384 GiB standard : 1 - 1024 GiB
  pub volume_size: Int? = None
  /// The volume type. For more information, see Amazon EBS volume types in
  /// the Amazon EBS User Guide .
  pub volume_type: VolumeType? = None
}

