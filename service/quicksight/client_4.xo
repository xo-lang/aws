      "StartAngle" => out.start_angle = jsonv.read_float(fv)?
      "VisualPalette" => out.visual_palette = from_json_visual_palette(fv)?
      "AlternateBandColorsVisibility" => out.alternate_band_colors_visibility = Visibility.from(jsonv.read_str(fv)?)
      "AlternateBandEvenColor" => out.alternate_band_even_color = jsonv.read_str(fv)?
      "AlternateBandOddColor" => out.alternate_band_odd_color = jsonv.read_str(fv)?
      "CategoryAxis" => out.category_axis = from_json_axis_display_options(fv)?
      "CategoryLabelOptions" => out.category_label_options = from_json_chart_axis_label_options(fv)?
      "ColorAxis" => out.color_axis = from_json_axis_display_options(fv)?
      "ColorLabelOptions" => out.color_label_options = from_json_chart_axis_label_options(fv)?
      "Legend" => out.legend = from_json_legend_options(fv)?
      "AxesRangeScale" => out.axes_range_scale = RadarChartAxesRangeScale.from(jsonv.read_str(fv)?)
      "Interactions" => out.interactions = from_json_visual_interaction_options(fv)?
      _ => {}
