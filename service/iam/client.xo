fn xml_write_eval_decision_details_type(var w: xmlv.Writer, v: Map[Str, PolicyEvaluationDecisionType], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", item.value(), [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_eval_decision_details_type(e: xml.Element) -> Map[Str, PolicyEvaluationDecisionType] ! Str {
  var out: Map[Str, PolicyEvaluationDecisionType] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, PolicyEvaluationDecisionType.from(vc.text()))
    }
  }
  Ok(out)
}

fn xml_write_evaluation_result(var w: xmlv.Writer, v: EvaluationResult, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.eval_action_name {
    xmlv.elem(w, "EvalActionName", x, [])
  }
  if let Some(x) = v.eval_resource_name {
    xmlv.elem(w, "EvalResourceName", x, [])
  }
  if let Some(x) = v.eval_decision {
    xmlv.elem(w, "EvalDecision", x.value(), [])
  }
  if let Some(x) = v.matched_statements {
    xml_write_statement_list_type(w, x, "MatchedStatements", [])
  }
  if let Some(x) = v.missing_context_values {
    xml_write_context_key_names_result_list_type(w, x, "MissingContextValues", [])
  }
  if let Some(x) = v.organizations_decision_detail {
    xml_write_organizations_decision_detail(w, x, "OrganizationsDecisionDetail", [])
  }
  if let Some(x) = v.permissions_boundary_decision_detail {
    xml_write_permissions_boundary_decision_detail(w, x, "PermissionsBoundaryDecisionDetail", [])
  }
  if let Some(x) = v.eval_decision_details {
    xml_write_eval_decision_details_type(w, x, "EvalDecisionDetails", [])
  }
  if let Some(x) = v.resource_specific_results {
    xml_write_resource_specific_result_list_type(w, x, "ResourceSpecificResults", [])
  }
  xmlv.end(w, name)
}

fn xml_read_evaluation_result(e: xml.Element) -> EvaluationResult ! Str {
  var out = EvaluationResult{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "EvalActionName" => out.eval_action_name = c.text()
      "EvalResourceName" => out.eval_resource_name = c.text()
      "EvalDecision" => out.eval_decision = PolicyEvaluationDecisionType.from(c.text())
      "MatchedStatements" => out.matched_statements = xml_read_statement_list_type(c)?
      "MissingContextValues" => out.missing_context_values = xml_read_context_key_names_result_list_type(c)?
      "OrganizationsDecisionDetail" => out.organizations_decision_detail = xml_read_organizations_decision_detail(c)?
      "PermissionsBoundaryDecisionDetail" => out.permissions_boundary_decision_detail = xml_read_permissions_boundary_decision_detail(c)?
      "EvalDecisionDetails" => out.eval_decision_details = xml_read_eval_decision_details_type(c)?
      "ResourceSpecificResults" => out.resource_specific_results = xml_read_resource_specific_result_list_type(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_evaluation_results_list_type(var w: xmlv.Writer, v: List[EvaluationResult], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_evaluation_result(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_evaluation_results_list_type(e: xml.Element) -> List[EvaluationResult] ! Str {
  var out: List[EvaluationResult] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_evaluation_result(c)?)
  }
  Ok(out)
}

