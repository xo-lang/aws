  pub fabric: MemberFabricLogPublishingConfiguration? = None
}

pub enum MemberStatus: Str {
  Creating = "CREATING"
  Available = "AVAILABLE"
  CreateFailed = "CREATE_FAILED"
  Updating = "UPDATING"
  Deleting = "DELETING"
  Deleted = "DELETED"
  InaccessibleEncryptionKey = "INACCESSIBLE_ENCRYPTION_KEY"
  Unknown(value: Str)
}

/// A summary of configuration properties for a member. Applies only to
/// Hyperledger Fabric.
pub struct MemberSummary {
  /// The unique identifier of the member.
  pub id: Str? = None
  /// The name of the member.
  pub name: Str? = None
  /// An optional description of the member.
  pub description: Str? = None
  /// The status of the member. CREATING - The Amazon Web Services account is
  /// in the process of creating a member. AVAILABLE - The member has been
  /// created and can participate in the network. CREATE_FAILED - The Amazon
  /// Web Services account attempted to create a member and creation failed.
  /// UPDATING - The member is in the process of being updated. DELETING - The
  /// member and all associated resources are in the process of being deleted.
  /// Either the Amazon Web Services account that owns the member deleted it,
  /// or the member is being deleted as the result of an APPROVED PROPOSAL to
  /// remove the member. DELETED - The member can no longer participate on the
  /// network and all associated resources are deleted. Either the Amazon Web
  /// Services account that owns the member deleted it, or the member is being
  /// deleted as the result of an APPROVED PROPOSAL to remove the member.
  /// INACCESSIBLE_ENCRYPTION_KEY - The member is impaired and might not
  /// function as expected because it cannot access the specified customer
  /// managed key in Key Management Service (KMS) for encryption at rest.
  /// Either the KMS key was disabled or deleted, or the grants on the key
  /// were revoked. The effect of disabling or deleting a key or of revoking a
  /// grant isn't immediate. It might take some time for the member resource
  /// to discover that the key is inaccessible. When a resource is in this
  /// state, we recommend deleting and recreating the resource.
  pub status: MemberStatus? = None
  /// The date and time that the member was created.
  pub creation_date: Time? = None
  /// An indicator of whether the member is owned by your Amazon Web Services
  /// account or a different Amazon Web Services account.
  pub is_owned: Bool? = None
  /// The Amazon Resource Name (ARN) of the member. For more information about
  /// ARNs and their format, see Amazon Resource Names (ARNs) in the Amazon
  /// Web Services General Reference .
  pub arn: Str? = None
}

/// Network configuration properties.
pub struct Network {
  /// The unique identifier of the network.
  pub id: Str? = None
  /// The name of the network.
  pub name: Str? = None
  /// Attributes of the blockchain framework for the network.
  pub description: Str? = None
  /// The blockchain framework that the network uses.
  pub framework: Framework? = None
  /// The version of the blockchain framework that the network uses.
  pub framework_version: Str? = None
  /// Attributes of the blockchain framework that the network uses.
  pub framework_attributes: NetworkFrameworkAttributes? = None
  /// The VPC endpoint service name of the VPC endpoint service of the
  /// network. Members use the VPC endpoint service name to create a VPC
  /// endpoint to access network resources.
  pub vpc_endpoint_service_name: Str? = None
  /// The voting rules that the network uses to decide if a proposal is
  /// accepted.
  pub voting_policy: VotingPolicy? = None
  /// The current status of the network.
  pub status: NetworkStatus? = None
  /// The date and time that the network was created.
  pub creation_date: Time? = None
  /// Tags assigned to the network. Each tag consists of a key and optional
  /// value. For more information about tags, see Tagging Resources in the
  /// Amazon Managed Blockchain Ethereum Developer Guide , or Tagging
  /// Resources in the Amazon Managed Blockchain Hyperledger Fabric Developer
  /// Guide .
  pub tags: Map[Str, Str]? = None
  /// The Amazon Resource Name (ARN) of the network. For more information
  /// about ARNs and their format, see Amazon Resource Names (ARNs) in the
  /// Amazon Web Services General Reference .
  pub arn: Str? = None
}

