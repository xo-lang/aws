/// The HTTP request of CreateCapability.
pub fn serialize_create_capability(ep: rest.Endpoint, input: CreateCapabilityRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = input.type_value {
    fs.push(("type", json.Value.Str(x.value())))
  }
  if let Some(x) = input.configuration {
    fs.push(("configuration", json_of_capability_configuration(x)))
  }
  if let Some(x) = input.instructions_documents {
    fs.push(("instructionsDocuments", json_of_instructions_documents(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("clientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("clientToken", json.Value.Str(idempotency_token)))
  }
  if let Some(x) = input.tags {
    fs.push(("tags", json_of_tag_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.0"))
  headers.push(("X-Amz-Target", "B2BI.CreateCapability"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

