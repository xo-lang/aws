fn xml_write_event(var w: xmlv.Writer, v: Event, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.source_identifier {
    xmlv.elem(w, "SourceIdentifier", x, [])
  }
  if let Some(x) = v.source_type {
    xmlv.elem(w, "SourceType", x.value(), [])
  }
  if let Some(x) = v.message {
    xmlv.elem(w, "Message", x, [])
  }
  if let Some(x) = v.event_categories {
    xml_write_event_categories_list(w, x, "EventCategories", [])
  }
  if let Some(x) = v.date {
    xmlv.elem(w, "Date", rest.date_time(x), [])
  }
  if let Some(x) = v.source_arn {
    xmlv.elem(w, "SourceArn", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_event(e: xml.Element) -> Event ! Str {
  var out = Event{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "SourceIdentifier" => out.source_identifier = c.text()
      "SourceType" => out.source_type = SourceType.from(c.text())
      "Message" => out.message = c.text()
      "EventCategories" => out.event_categories = xml_read_event_categories_list(c)?
      "Date" => out.date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SourceArn" => out.source_arn = c.text()
      _ => {}
    }
  }
  Ok(out)
}

