  /// details on COSE, see:
  /// https://opensource.contentauthenticity.org/docs/manifest/signing-manifests
  pub certificate_secret: Str? = None
  /// When enabled, file composition times will start at zero, composition
  /// times in the 'ctts' (composition time to sample) box for B-frames will
  /// be negative, and a 'cslg' (composition shift least greatest) box will be
  /// included per 14496-1 amendment 1. This improves compatibility with Apple
  /// players and tools.
  pub cslg_atom: Mp4CslgAtom? = None
  /// Ignore this setting unless compliance to the CTTS box version
  /// specification matters in your workflow. Specify a value of 1 to set your
  /// CTTS box version to 1 and make your output compliant with the
  /// specification. When you specify a value of 1, you must also set CSLG
  /// atom to the value INCLUDE. Keep the default value 0 to set your CTTS box
  /// version to 0. This can provide backward compatibility for some players
  /// and packagers.
  pub ctts_version: Int? = None
  /// Inserts a free-space box immediately after the moov box.
  pub free_space_box: Mp4FreeSpaceBox? = None
  /// To place the MOOV atom at the beginning of your output, which is useful
  /// for progressive downloading: Leave blank or choose Progressive download.
  /// To place the MOOV at the end of your output: Choose Normal.
  pub moov_placement: Mp4MoovPlacement? = None
  /// Overrides the "Major Brand" field in the output file. Usually not
