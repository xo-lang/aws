fn xml_write_key_pair_info(var w: xmlv.Writer, v: KeyPairInfo, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.key_pair_id {
    xmlv.elem(w, "keyPairId", x, [])
  }
  if let Some(x) = v.key_type {
    xmlv.elem(w, "keyType", x.value(), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.public_key {
    xmlv.elem(w, "publicKey", x, [])
  }
  if let Some(x) = v.create_time {
    xmlv.elem(w, "createTime", rest.date_time(x), [])
  }
  if let Some(x) = v.key_name {
    xmlv.elem(w, "keyName", x, [])
  }
  if let Some(x) = v.key_fingerprint {
    xmlv.elem(w, "keyFingerprint", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_key_pair_info(e: xml.Element) -> KeyPairInfo ! Str {
  var out = KeyPairInfo{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "keyPairId" => out.key_pair_id = c.text()
      "keyType" => out.key_type = KeyType.from(c.text())
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "publicKey" => out.public_key = c.text()
      "createTime" => out.create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "keyName" => out.key_name = c.text()
      "keyFingerprint" => out.key_fingerprint = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_key_pair_list(var w: xmlv.Writer, v: List[KeyPairInfo], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
