  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.pipeline_configuration_body {
    fs.push(("PipelineConfigurationBody", json.Value.Str(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/2022-01-01/osis/validatePipeline"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_validate_pipeline(resp: http.Response) -> ValidatePipelineResponse ! Str {
  var out = ValidatePipelineResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "isValid" => out.is_valid = jsonv.read_bool(fv)?
      "Errors" => out.errors = from_json_validation_message_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

/// The errors of ValidatePipeline.
pub enum ValidatePipelineErr {
  AccessDeniedException(e: AccessDeniedException)
  DisabledOperationException(e: DisabledOperationException)
  InternalException(e: InternalException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
