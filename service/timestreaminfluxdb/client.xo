fn json_of_parameters(v: Parameters) -> json.Value {
  match v {
    InfluxDbv2(x) => json.Value.Object([("InfluxDBv2", json_of_influx_dbv2_parameters(x))])
    InfluxDbv3Core(x) => json.Value.Object([("InfluxDBv3Core", json_of_influx_dbv3_core_parameters(x))])
    InfluxDbv3Enterprise(x) => json.Value.Object([("InfluxDBv3Enterprise", json_of_influx_dbv3_enterprise_parameters(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_parameters(v: json.Value) -> Parameters ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "InfluxDBv2" => Ok(Parameters.InfluxDbv2(from_json_influx_dbv2_parameters(fv)?))
      "InfluxDBv3Core" => Ok(Parameters.InfluxDbv3Core(from_json_influx_dbv3_core_parameters(fv)?))
      "InfluxDBv3Enterprise" => Ok(Parameters.InfluxDbv3Enterprise(from_json_influx_dbv3_enterprise_parameters(fv)?))
      _ => Ok(Parameters.Unknown(k))
    }
  }
  Err("Parameters: no member set")
}

fn json_of_percent_or_absolute_long(v: PercentOrAbsoluteLong) -> json.Value {
  match v {
    Percent(x) => json.Value.Object([("percent", json.Value.Str(x))])
    Absolute(x) => json.Value.Object([("absolute", json.Value.Int(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_percent_or_absolute_long(v: json.Value) -> PercentOrAbsoluteLong ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "percent" => Ok(PercentOrAbsoluteLong.Percent(jsonv.read_str(fv)?))
      "absolute" => Ok(PercentOrAbsoluteLong.Absolute(jsonv.read_int(fv)?))
      _ => Ok(PercentOrAbsoluteLong.Unknown(k))
    }
  }
  Err("PercentOrAbsoluteLong: no member set")
}

