/// A resource could not be validated.
pub struct ValidationException {
  /// A message describing the problem.
  pub message: Str? = None
  /// The reason that the resource could not be validated.
  pub reason: ValidationExceptionReason? = None
}

pub enum ValidationExceptionReason: Str {
  ConstraintViolation = "CONSTRAINT_VIOLATION"
  IllegalArgument = "ILLEGAL_ARGUMENT"
  MalformedQuery = "MALFORMED_QUERY"
  QueryCancelled = "QUERY_CANCELLED"
  QueryTooLarge = "QUERY_TOO_LARGE"
  UnsupportedOperation = "UNSUPPORTED_OPERATION"
  BadRequest = "BAD_REQUEST"
  Unknown(value: Str)
}

