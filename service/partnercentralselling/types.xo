  /// The timestamp when the prospecting task completed processing. The format
  /// is ISO 8601 (UTC).
  pub end_time: Time? = None
  /// The unique identifier of the prospecting task that generates this
  /// result.
  pub task_id: Str? = None
  /// The Amazon Resource Name (ARN) of the prospecting task. Use this ARN to
