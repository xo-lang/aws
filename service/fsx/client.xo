      "AutomaticBackupRetentionDays" => out.automatic_backup_retention_days = jsonv.read_int(fv)?
      "CopyTagsToBackups" => out.copy_tags_to_backups = jsonv.read_bool(fv)?
      "Aliases" => out.aliases = from_json_aliases(fv)?
      "AuditLogConfiguration" => out.audit_log_configuration = from_json_windows_audit_log_configuration(fv)?
      "DiskIopsConfiguration" => out.disk_iops_configuration = from_json_disk_iops_configuration(fv)?
      "PreferredFileServerIpv6" => out.preferred_file_server_ipv6 = jsonv.read_str(fv)?
      "FsrmConfiguration" => out.fsrm_configuration = from_json_windows_fsrm_configuration(fv)?
      _ => {}
