fn xml_read_transit_gateway_vpc_attachment(e: xml.Element) -> TransitGatewayVpcAttachment ! Str {
  var out = TransitGatewayVpcAttachment{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "transitGatewayAttachmentId" => out.transit_gateway_attachment_id = c.text()
      "transitGatewayId" => out.transit_gateway_id = c.text()
      "vpcId" => out.vpc_id = c.text()
      "vpcOwnerId" => out.vpc_owner_id = c.text()
      "state" => out.state = TransitGatewayAttachmentState.from(c.text())
      "subnetIds" => out.subnet_ids = xml_read_value_string_list(c)?
      "creationTime" => out.creation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "options" => out.options = xml_read_transit_gateway_vpc_attachment_options(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

