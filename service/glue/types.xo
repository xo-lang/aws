/// Brief information about a supported connection type returned by the
/// ListConnectionTypes API.
pub struct ConnectionTypeBrief {
  /// The name of the connection type.
  pub connection_type: ConnectionType? = None
  /// The human-readable name for the connection type that is displayed in the
  /// Glue console.
  pub display_name: Str? = None
  /// The name of the vendor or provider that created or maintains this
  /// connection type.
  pub vendor: Str? = None
  /// A description of the connection type.
  pub description: Str? = None
  /// A list of categories that this connection type belongs to. Categories
  /// help users filter and find appropriate connection types based on their
  /// use cases.
  pub categories: List[Str]? = None
  /// The supported authentication types, data interface types (compute
  /// environments), and data operations of the connector.
  pub capabilities: Capabilities? = None
  /// The URL of the logo associated with a connection type.
  pub logo_url: Str? = None
  /// A list of variants available for this connection type. Different
  /// variants may provide specialized configurations for specific use cases
  /// or implementations of the same general connection type.
  pub connection_type_variants: List[ConnectionTypeVariant]? = None
}

/// Represents a variant of a connection type in Glue. Connection type
/// variants provide specific configurations and behaviors for different
/// implementations of the same general connection type.
pub struct ConnectionTypeVariant {
  /// The unique identifier for the connection type variant. This name is used
  /// internally to identify the specific variant of a connection type.
  pub connection_type_variant_name: Str? = None
  /// The human-readable name for the connection type variant that is
  /// displayed in the Glue console.
  pub display_name: Str? = None
  /// A detailed description of the connection type variant, including its
  /// purpose, use cases, and any specific configuration requirements.
  pub description: Str? = None
  /// The URL of the logo associated with a connection type variant.
  pub logo_url: Str? = None
}

/// Specifies the connections used by a job.
pub struct ConnectionsList {
  /// A list of connections used by the job.
  pub connections: List[Str]? = None
}

/// Configuration that defines the supported authentication types and
/// required properties for the connection type.
pub struct ConnectorAuthenticationConfiguration {
  /// A list of authentication types supported by this connection type, such
  /// as Basic, OAuth2, or Custom authentication methods.
  pub authentication_types: List[AuthenticationType]? = None
  pub o_auth2_properties: ConnectorOAuth2Properties? = None
  pub basic_authentication_properties: BasicAuthenticationProperties? = None
  pub custom_authentication_properties: CustomAuthenticationProperties? = None
}

/// OAuth2 authorization code configuration that defines the properties
/// needed for the Authorization Code grant type flow.
pub struct ConnectorAuthorizationCodeProperties {
  /// The authorization endpoint URL where users will be redirected to grant
  /// authorization.
  pub authorization_code_url: ConnectorProperty? = None
  /// The authorization code received from the authorization server after user
  /// consent.
  pub authorization_code: ConnectorProperty? = None
  /// The redirect URI that must match the URI registered with the
  /// authorization server.
  pub redirect_uri: ConnectorProperty? = None
  /// The token endpoint URL where the authorization code will be exchanged
  /// for an access token.
  pub token_url: ConnectorProperty? = None
  /// The HTTP method to use when making token exchange requests, typically
  /// POST.
  pub request_method: HTTPMethod? = None
  /// The content type to use for token exchange requests, such as
  /// application/x-www-form-urlencoded or application/json.
  pub content_type: ContentType? = None
  /// The OAuth2 client identifier provided by the authorization server.
  pub client_id: ConnectorProperty? = None
  /// The OAuth2 client secret provided by the authorization server.
  pub client_secret: ConnectorProperty? = None
  /// The OAuth2 scope that defines the level of access requested for the
  /// authorization code flow.
  pub scope: ConnectorProperty? = None
  /// The OAuth2 prompt parameter that controls the authorization server's
  /// behavior during user authentication.
  pub prompt: ConnectorProperty? = None
  /// Additional parameters to include in token URL requests as key-value
  /// pairs.
  pub token_url_parameters: List[ConnectorProperty]? = None
}

/// Specifies a source generated with standard connection options.
pub struct ConnectorDataSource {
  /// The name of this source node.
  pub name: Str? = None
  /// The connectionType , as provided to the underlying Glue library. This
  /// node type supports the following connection types: opensearch azuresql
  /// azurecosmos bigquery saphana teradata vertica
  pub connection_type: Str? = None
  /// A map specifying connection options for the node. You can find standard
  /// connection options for the corresponding connection type in the
  /// Connection parameters section of the Glue documentation.
  pub data: Map[Str, Str]? = None
  /// Specifies the data schema for this source.
  pub output_schemas: List[GlueSchema]? = None
}

/// Specifies a target generated with standard connection options.
pub struct ConnectorDataTarget {
  /// The name of this target node.
  pub name: Str? = None
  /// The connectionType , as provided to the underlying Glue library. This
  /// node type supports the following connection types: opensearch azuresql
  /// azurecosmos bigquery saphana teradata vertica
  pub connection_type: Str? = None
  /// A map specifying connection options for the node. You can find standard
  /// connection options for the corresponding connection type in the
  /// Connection parameters section of the Glue documentation.
  pub data: Map[Str, Str]? = None
  /// The nodes that are inputs to the data target.
  pub inputs: List[Str]? = None
}

pub enum ConnectorOAuth2GrantType: Str {
  ClientCredentials = "CLIENT_CREDENTIALS"
  JwtBearer = "JWT_BEARER"
  AuthorizationCode = "AUTHORIZATION_CODE"
  Unknown(value: Str)
}

/// OAuth2 configuration container that defines the authentication
/// properties and flow-specific configurations for OAuth2-based
/// connections.
pub struct ConnectorOAuth2Properties {
  /// The OAuth2 grant type to use for authentication, such as
  /// CLIENT_CREDENTIALS, JWT_BEARER, or AUTHORIZATION_CODE.
  pub o_auth2_grant_type: ConnectorOAuth2GrantType? = None
  /// Configuration properties specific to the OAuth2 Client Credentials grant
  /// type flow.
  pub client_credentials_properties: ClientCredentialsProperties? = None
  /// Configuration properties specific to the OAuth2 JWT Bearer grant type
  /// flow.
  pub jwt_bearer_properties: JWTBearerProperties? = None
  /// Configuration properties specific to the OAuth2 Authorization Code grant
  /// type flow.
  pub authorization_code_properties: ConnectorAuthorizationCodeProperties? = None
