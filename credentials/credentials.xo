// Package credentials holds the credential providers that need no
// service call (decision 0003): static keys and the environment. The
// shared files are read by package config, which builds the chain.

use github.com/xo-lang/aws

/// Fixed keys, for tests and for programs that load keys themselves.
pub struct StaticProvider {
  pub creds: aws.Credentials
}

pub fn static_provider(access_key_id: Str, secret_access_key: Str, session_token: Str? = None) -> StaticProvider {
  StaticProvider{creds: aws.Credentials{
    access_key_id: access_key_id,
    secret_access_key: Secret.new(secret_access_key),
    session_token: session_token.map(fn(t) { Secret.new(t) }),
    source: "StaticCredentials",
  }}
}

fn (p: StaticProvider) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock) {
  if p.creds.access_key_id == "" || p.creds.secret_access_key.reveal() == "" {
    return Err(aws.CredentialsErr.Invalid("static credentials are empty"))
  }
  Ok(p.creds)
}

/// The keys in `AWS_ACCESS_KEY_ID`, `AWS_SECRET_ACCESS_KEY` and
/// `AWS_SESSION_TOKEN` (with aws-sdk-go-v2's older names `AWS_ACCESS_KEY`
/// and `AWS_SECRET_KEY` as fallbacks), read once when the provider is
/// made. Both keys missing is NotFound; one of them missing is Invalid.
pub fn from_env(env: Env) -> aws.Credentials ! aws.CredentialsErr uses env {
  let id = non_empty(env.get("AWS_ACCESS_KEY_ID")) ?? non_empty(env.get("AWS_ACCESS_KEY")) ?? ""
  let secret = non_empty(env.get("AWS_SECRET_ACCESS_KEY")) ?? non_empty(env.get("AWS_SECRET_KEY")) ?? ""
  if id == "" && secret == "" {
    return Err(aws.CredentialsErr.NotFound("AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are not set"))
  }
  if id == "" {
    return Err(aws.CredentialsErr.Invalid("AWS_SECRET_ACCESS_KEY is set but AWS_ACCESS_KEY_ID is not"))
  }
  if secret == "" {
    return Err(aws.CredentialsErr.Invalid("AWS_ACCESS_KEY_ID is set but AWS_SECRET_ACCESS_KEY is not"))
  }
  Ok(aws.Credentials{
    access_key_id: id,
    secret_access_key: Secret.new(secret),
    session_token: non_empty(env.get("AWS_SESSION_TOKEN")).map(fn(t) { Secret.new(t) }),
    source: "EnvironmentVariables",
  })
}

fn non_empty(s: Str?) -> Str? {
  match s {
    Some(v) => if v == "" { None } else { Some(v) }
    None => None
  }
}
