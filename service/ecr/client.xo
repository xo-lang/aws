fn json_of_lifecycle_policy_preview_result(v: LifecyclePolicyPreviewResult) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.image_tags {
    fs.push(("imageTags", json_of_image_tag_list(x)))
  }
  if let Some(x) = v.image_digest {
    fs.push(("imageDigest", json.Value.Str(x)))
  }
  if let Some(x) = v.image_pushed_at {
    fs.push(("imagePushedAt", jsonv.time(x, "epoch-seconds")))
