fn xml_write_delete_objects_output(var w: xmlv.Writer, v: DeleteObjectsOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.deleted {
    for item in x {
      xml_write_deleted_object(w, item, "Deleted", [])
    }
  }
  if let Some(x) = v.request_charged {
    xmlv.elem(w, "RequestCharged", x.value(), [])
  }
  if let Some(x) = v.errors {
    for item in x {
      xml_write_error_shape(w, item, "Error", [])
    }
  }
  xmlv.end(w, name)
}

fn xml_read_delete_objects_output(e: xml.Element) -> DeleteObjectsOutput ! Str {
  var out = DeleteObjectsOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Deleted" => {
        var items = out.deleted ?? []
        items.push(xml_read_deleted_object(c)?)
        out.deleted = items
      }
      "RequestCharged" => out.request_charged = RequestCharged.from(c.text())
      "Error" => {
        var items = out.errors ?? []
        items.push(xml_read_error_shape(c)?)
        out.errors = items
      }
      _ => {}
    }
  }
  Ok(out)
}

