      "MetricSelections" => out.metric_selections = xml_read_resource_metric_selection_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_update_resource_metrics_configuration_output(var w: xmlv.Writer, v: UpdateResourceMetricsConfigurationOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.resource_metrics_configuration {
    xml_write_resource_metrics_configuration(w, x, "ResourceMetricsConfiguration", [])
  }
  xmlv.end(w, name)
}

fn xml_read_update_resource_metrics_configuration_output(e: xml.Element) -> UpdateResourceMetricsConfigurationOutput ! Str {
  var out = UpdateResourceMetricsConfigurationOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ResourceMetricsConfiguration" => out.resource_metrics_configuration = xml_read_resource_metrics_configuration(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_validation_exception(var w: xmlv.Writer, v: ValidationException, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.message {
    xmlv.elem(w, "message", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_validation_exception(e: xml.Element) -> ValidationException ! Str {
  var out = ValidationException{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "message" => out.message = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_values(var w: xmlv.Writer, v: List[Float], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xmlv.elem(w, "member", rest.float_text(item), [])
  }
  xmlv.end(w, name)
}

fn xml_read_values(e: xml.Element) -> List[Float] ! Str {
  var out: List[Float] = []
  for c in xmlv.elements(e) {
    out.push(xmlv.read_float(c.text())?)
  }
  Ok(out)
}

