  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.last_modified_by {
    fs.push(("lastModifiedBy", json.Value.Str(x)))
  }
  if let Some(x) = v.last_modified_at {
    fs.push(("lastModifiedAt", jsonv.time(x, "date-time")))
  }
  json.Value.Object(fs)
}

