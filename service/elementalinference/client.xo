pub fn endpoint_params_associate_feed(base: EndpointParameters, input: AssociateFeedRequest) -> EndpointParameters {
  let _ = input
  base
}

/// The HTTP request of AssociateFeed.
pub fn serialize_associate_feed(ep: rest.Endpoint, input: AssociateFeedRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_id = match input.id {
    Some(v) => v
    None => return Err("input member id is required")
  }
  if label_id == "" {
    return Err("input member id must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.associated_resource_name {
    fs.push(("associatedResourceName", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("associatedResourceName", json.Value.Str(idempotency_token)))
  }
  if let Some(x) = input.outputs {
    fs.push(("outputs", json_of_create_output_list(x)))
  }
  if let Some(x) = input.dry_run {
    fs.push(("dryRun", json.Value.Bool(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
