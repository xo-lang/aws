  }
  if let Some(x) = v.transit_gateway_attachment {
    query_put_analysis_component(f, query.key(prefix, "TransitGatewayAttachment"), x)
  }
  if let Some(x) = v.component_account {
    query.add(f, query.key(prefix, "ComponentAccount"), x)
  }
  if let Some(x) = v.component_region {
    query.add(f, query.key(prefix, "ComponentRegion"), x)
  }
  if let Some(x) = v.firewall_stateless_rule {
    query_put_firewall_stateless_rule(f, query.key(prefix, "FirewallStatelessRule"), x)
  }
  if let Some(x) = v.firewall_stateful_rule {
    query_put_firewall_stateful_rule(f, query.key(prefix, "FirewallStatefulRule"), x)
  }
}

fn query_put_explanation_list(var f: query.Form, prefix: Str, v: List[Explanation], flat: Bool) {
  let _ = flat
  for (i, x) in v.indexed() {
    let k = "${prefix}.${i + 1}"
    query_put_explanation(f, k, x)
  }
}

