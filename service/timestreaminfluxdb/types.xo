  pub data_fusion_runtime_thread_keep_alive: DurationShape? = None
  /// Sets the thread priority for tokio DataFusion runtime workers. Default:
  /// 10
  pub data_fusion_runtime_thread_priority: Int? = None
  /// When multiple parquet files are required in a sorted way (deduplication
