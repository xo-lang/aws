fn from_json_data_source_parameters(v: json.Value) -> DataSourceParameters ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "AmazonElasticsearchParameters" => Ok(DataSourceParameters.AmazonElasticsearchParameters(from_json_amazon_elasticsearch_parameters(fv)?))
      "AthenaParameters" => Ok(DataSourceParameters.AthenaParameters(from_json_athena_parameters(fv)?))
      "AuroraParameters" => Ok(DataSourceParameters.AuroraParameters(from_json_aurora_parameters(fv)?))
      "AuroraPostgreSqlParameters" => Ok(DataSourceParameters.AuroraPostgreSqlParameters(from_json_aurora_postgre_sql_parameters(fv)?))
      "AwsIotAnalyticsParameters" => Ok(DataSourceParameters.AwsIotAnalyticsParameters(from_json_aws_iot_analytics_parameters(fv)?))
      "JiraParameters" => Ok(DataSourceParameters.JiraParameters(from_json_jira_parameters(fv)?))
      "MariaDbParameters" => Ok(DataSourceParameters.MariaDbParameters(from_json_maria_db_parameters(fv)?))
      "MySqlParameters" => Ok(DataSourceParameters.MySqlParameters(from_json_my_sql_parameters(fv)?))
      "OracleParameters" => Ok(DataSourceParameters.OracleParameters(from_json_oracle_parameters(fv)?))
      "PostgreSqlParameters" => Ok(DataSourceParameters.PostgreSqlParameters(from_json_postgre_sql_parameters(fv)?))
      "PrestoParameters" => Ok(DataSourceParameters.PrestoParameters(from_json_presto_parameters(fv)?))
      "RdsParameters" => Ok(DataSourceParameters.RdsParameters(from_json_rds_parameters(fv)?))
      "RedshiftParameters" => Ok(DataSourceParameters.RedshiftParameters(from_json_redshift_parameters(fv)?))
      "S3Parameters" => Ok(DataSourceParameters.S3Parameters(from_json_s3_parameters(fv)?))
      "S3TablesParameters" => Ok(DataSourceParameters.S3TablesParameters(from_json_s3_tables_parameters(fv)?))
      "S3KnowledgeBaseParameters" => Ok(DataSourceParameters.S3KnowledgeBaseParameters(from_json_s3_knowledge_base_parameters(fv)?))
      "ServiceNowParameters" => Ok(DataSourceParameters.ServiceNowParameters(from_json_service_now_parameters(fv)?))
      "SnowflakeParameters" => Ok(DataSourceParameters.SnowflakeParameters(from_json_snowflake_parameters(fv)?))
      "SparkParameters" => Ok(DataSourceParameters.SparkParameters(from_json_spark_parameters(fv)?))
      "SqlServerParameters" => Ok(DataSourceParameters.SqlServerParameters(from_json_sql_server_parameters(fv)?))
      "TeradataParameters" => Ok(DataSourceParameters.TeradataParameters(from_json_teradata_parameters(fv)?))
      "TwitterParameters" => Ok(DataSourceParameters.TwitterParameters(from_json_twitter_parameters(fv)?))
      "AmazonOpenSearchParameters" => Ok(DataSourceParameters.AmazonOpenSearchParameters(from_json_amazon_open_search_parameters(fv)?))
      "ExasolParameters" => Ok(DataSourceParameters.ExasolParameters(from_json_exasol_parameters(fv)?))
      "DatabricksParameters" => Ok(DataSourceParameters.DatabricksParameters(from_json_databricks_parameters(fv)?))
      "StarburstParameters" => Ok(DataSourceParameters.StarburstParameters(from_json_starburst_parameters(fv)?))
      "TrinoParameters" => Ok(DataSourceParameters.TrinoParameters(from_json_trino_parameters(fv)?))
      "BigQueryParameters" => Ok(DataSourceParameters.BigQueryParameters(from_json_big_query_parameters(fv)?))
      "ImpalaParameters" => Ok(DataSourceParameters.ImpalaParameters(from_json_impala_parameters(fv)?))
      "CustomConnectionParameters" => Ok(DataSourceParameters.CustomConnectionParameters(from_json_custom_connection_parameters(fv)?))
      "WebCrawlerParameters" => Ok(DataSourceParameters.WebCrawlerParameters(from_json_web_crawler_parameters(fv)?))
      "ConfluenceParameters" => Ok(DataSourceParameters.ConfluenceParameters(from_json_confluence_parameters(fv)?))
      "QBusinessParameters" => Ok(DataSourceParameters.QBusinessParameters(from_json_q_business_parameters(fv)?))
      "SharePointParameters" => Ok(DataSourceParameters.SharePointParameters(from_json_share_point_parameters(fv)?))
      "GoogleDriveParameters" => Ok(DataSourceParameters.GoogleDriveParameters(from_json_google_drive_parameters(fv)?))
      "OneDriveParameters" => Ok(DataSourceParameters.OneDriveParameters(from_json_one_drive_parameters(fv)?))
      "FMKBParameters" => Ok(DataSourceParameters.FmkbParameters(from_json_fmkb_parameters(fv)?))
      _ => Ok(DataSourceParameters.Unknown(k))
    }
  }
  Err("DataSourceParameters: no member set")
}

