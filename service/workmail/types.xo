/// The representation of an WorkMail user.
pub struct User {
  /// The identifier of the user.
  pub id: Str? = None
  /// The email of the user.
  pub email: Str? = None
  /// The name of the user.
  pub name: Str? = None
  /// The display name of the user.
  pub display_name: Str? = None
  /// The state of the user, which can be ENABLED, DISABLED, or DELETED.
  pub state: EntityState? = None
  /// The role of the user.
  pub user_role: UserRole? = None
  /// The date indicating when the user was enabled for WorkMail use.
  pub enabled_date: Time? = None
  /// The date indicating when the user was disabled from WorkMail use.
  pub disabled_date: Time? = None
  /// User ID from the IAM Identity Center. If this parameter is empty it will
  /// be updated automatically when the user logs in for the first time to the
  /// mailbox associated with WorkMail.
  pub identity_provider_user_id: Str? = None
  /// Identity store ID from the IAM Identity Center. If this parameter is
  /// empty it will be updated automatically when the user logs in for the
  /// first time to the mailbox associated with WorkMail.
  pub identity_provider_identity_store_id: Str? = None
}

pub enum UserRole: Str {
  User = "USER"
  Resource = "RESOURCE"
  SystemUser = "SYSTEM_USER"
  RemoteUser = "REMOTE_USER"
  Unknown(value: Str)
}
