      Ok(x) => return UpdateBenefitApplicationErr.ValidationException(x)
      Err(msg) => return UpdateBenefitApplicationErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateBenefitApplicationErr.Api(restjson.api_error(resp, body))
}

/// Updates an existing benefit application with new information while
/// maintaining revision control.
pub fn (c: Client) update_benefit_application(input: UpdateBenefitApplicationInput) -> UpdateBenefitApplicationOutput ! UpdateBenefitApplicationErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_benefit_application(c.params, input)) ?? e => return Err(UpdateBenefitApplicationErr.InvalidInput(e))
  var req = serialize_update_benefit_application(ep, input, "") ?? e => return Err(UpdateBenefitApplicationErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateBenefitApplicationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_benefit_application_error(resp))
  }
  deserialize_update_benefit_application(resp) ?? e => Err(UpdateBenefitApplicationErr.Deserialize(e))
}
