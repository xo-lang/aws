fn json_of_or_condition(v: OrCondition) -> json.Value {
  match v {
    AndConditions(x) => json.Value.Object([("andConditions", json_of_and_conditions(x))])
    TagCondition(x) => json.Value.Object([("tagCondition", json_of_tag_condition(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_or_condition(v: json.Value) -> OrCondition ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "andConditions" => Ok(OrCondition.AndConditions(from_json_and_conditions(fv)?))
      "tagCondition" => Ok(OrCondition.TagCondition(from_json_tag_condition(fv)?))
      _ => Ok(OrCondition.Unknown(k))
    }
  }
  Err("OrCondition: no member set")
}

fn json_of_or_conditions(v: List[OrCondition]) -> json.Value {
  json.Value.List(v.map(fn(x: OrCondition) -> json.Value { json_of_or_condition(x) }))
