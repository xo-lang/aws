fn json_of_limits_by_role(v: Map[Str, Limits]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, Limits)) -> (Str, json.Value) { (e.0, json_of_limits(e.1)) }))
}

fn from_json_limits_by_role(v: json.Value) -> Map[Str, Limits] ! Str {
  var out: Map[Str, Limits] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_limits(fv)?)
  }
  Ok(out)
}

