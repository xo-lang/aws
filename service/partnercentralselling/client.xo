    Lead(x) => json.Value.Object([("Lead", json_of_lead_context(x))])
    ProspectingResult(x) => json.Value.Object([("ProspectingResult", json_of_prospecting_result(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_engagement_context_payload(v: json.Value) -> EngagementContextPayload ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "CustomerProject" => Ok(EngagementContextPayload.CustomerProject(from_json_customer_projects_context(fv)?))
      "Lead" => Ok(EngagementContextPayload.Lead(from_json_lead_context(fv)?))
      "ProspectingResult" => Ok(EngagementContextPayload.ProspectingResult(from_json_prospecting_result(fv)?))
      _ => Ok(EngagementContextPayload.Unknown(k))
    }
  }
  Err("EngagementContextPayload: no member set")
}

