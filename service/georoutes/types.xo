  RoundaboutExit = "RoundaboutExit"
  RoundaboutPass = "RoundaboutPass"
  Turn = "Turn"
  UTurn = "UTurn"
  Unknown(value: Str)
}

/// Provides details about toll information along a route, including the
/// payment sites, applicable toll rates, toll systems, and the country
/// associated with the toll collection.
pub struct RouteToll {
  /// The alpha-2 or alpha-3 character code for the country.
  pub country: Str? = None
  /// Locations or sites where the toll fare is collected.
  pub payment_sites: List[RouteTollPaymentSite]? = None
  /// Toll rates that need to be paid to travel this leg of the route.
  pub rates: List[RouteTollRate]? = None
  /// Toll systems are authorities that collect payments for the toll.
  pub systems: List[Int]? = None
}

/// Options related to Tolls on a route.
pub struct RouteTollOptions {
  /// Specifies if the user has valid transponder with access to all toll
  /// systems. This impacts toll calculation, and if true the price with
  /// transponders is used.
  pub all_transponders: Bool? = None
  /// Specifies if the user has valid vignettes with access for all toll
  /// roads. If a user has a vignette for a toll road, then toll cost for that
  /// road is omitted since no further payment is necessary.
  pub all_vignettes: Bool? = None
  /// Currency code corresponding to the price. This is the same as Currency
  /// specified in the request.
  pub currency: Str? = None
  /// Emission type of the vehicle for toll cost calculation. Valid values :
  /// Euro1, Euro2, Euro3, Euro4, Euro5, Euro6, EuroEev
  pub emission_type: RouteEmissionType? = None
  /// Vehicle category for toll cost calculation.
  pub vehicle_category: RouteTollVehicleCategory? = None
}

/// Details if the toll rate can be a pass that supports multiple trips.
pub struct RouteTollPass {
  /// If the pass includes the rate for the return leg of the trip.
  pub includes_return_trip: Bool? = None
  /// If the pass is only valid for senior persons.
  pub senior_pass: Bool? = None
  /// If the toll pass can be transferred, and how many times.
  pub transfer_count: Int? = None
  /// Number of trips the pass is valid for.
  pub trip_count: Int? = None
  /// Period for which the pass is valid.
  pub validity_period: RouteTollPassValidityPeriod? = None
}

/// Period for which the pass is valid.
pub struct RouteTollPassValidityPeriod {
  /// Validity period.
  pub period: RouteTollPassValidityPeriodType? = None
  /// Counts for the validity period.
  pub period_count: Int? = None
}

pub enum RouteTollPassValidityPeriodType: Str {
  Annual = "Annual"
  Days = "Days"
  ExtendedAnnual = "ExtendedAnnual"
  Minutes = "Minutes"
  Months = "Months"
  Unknown(value: Str)
}

pub enum RouteTollPaymentMethod: Str {
  BankCard = "BankCard"
  Cash = "Cash"
  CashExact = "CashExact"
  CreditCard = "CreditCard"
  PassSubscription = "PassSubscription"
  TravelCard = "TravelCard"
  Transponder = "Transponder"
  VideoToll = "VideoToll"
  Unknown(value: Str)
}

/// Locations or sites where the toll fare is collected.
pub struct RouteTollPaymentSite {
  /// Name of the payment site.
  pub name: Str? = None
  /// Position in World Geodetic System (WGS 84) format: [longitude,
  /// latitude].
  pub position: List[Float]? = None
}

/// The toll price.
pub struct RouteTollPrice {
  /// Currency code corresponding to the price. This is the same as Currency
  /// specified in the request.
  pub currency: Str? = None
  /// If the price is an estimate or an exact value.
  pub estimate: Bool? = None
  /// Duration for which the price corresponds to. Unit : seconds
  pub per_duration: Int? = None
  /// If the price is a range or an exact value. If any of the toll fares
  /// making up the route is a range, the overall price is also a range.
  pub range: Bool? = None
  /// Price range with a minimum and maximum value, if a range.
  pub range_value: RouteTollPriceValueRange? = None
  /// Exact price, if not a range.
  pub value: Float? = None
}

/// Summary of the route and toll price.
pub struct RouteTollPriceSummary {
  /// Currency code corresponding to the price. This is the same as Currency
  /// specified in the request.
  pub currency: Str? = None
  /// If the price is an estimate or an exact value.
  pub estimate: Bool? = None
  /// If the price is a range or an exact value. If any of the toll fares
  /// making up the route is a range, the overall price is also a range.
  pub range: Bool? = None
  /// Price range with a minimum and maximum value, if a range.
  pub range_value: RouteTollPriceValueRange? = None
  /// Exact price, if not a range.
  pub value: Float? = None
}

/// Price range with a minimum and maximum value, if a range.
pub struct RouteTollPriceValueRange {
  /// Minimum price.
  pub min: Float? = None
  /// Maximum price.
  pub max: Float? = None
}

/// The toll rate.
pub struct RouteTollRate {
  /// Time when the rate is valid.
  pub applicable_times: Str? = None
  /// Price in the converted currency as specified in the request.
  pub converted_price: RouteTollPrice? = None
  /// The Toll rate Id.
  pub id: Str? = None
  /// Price in the local regional currency.
  pub local_price: RouteTollPrice? = None
  /// The name of the toll.
  pub name: Str? = None
  /// Details if the toll rate can be a pass that supports multiple trips.
  pub pass: RouteTollPass? = None
  /// Accepted payment methods at the toll.
  pub payment_methods: List[RouteTollPaymentMethod]? = None
  /// Transponders for which this toll can be applied.
  pub transponders: List[RouteTransponder]? = None
}

/// The toll summary for the complete route.
pub struct RouteTollSummary {
  /// Total toll summary for the complete route. Total is the only summary
  /// available today.
  pub total: RouteTollPriceSummary? = None
}

/// Toll systems are authorities that collect payments for the toll.
pub struct RouteTollSystem {
  /// The toll system name.
  pub name: Str? = None
}

pub enum RouteTollVehicleCategory: Str {
  Minibus = "Minibus"
  Unknown(value: Str)
}

/// Traffic options for the route.
pub struct RouteTrafficOptions {
  /// Duration for which flow traffic is considered valid. For this period,
  /// the flow traffic is used over historical traffic data. Flow traffic
  /// refers to congestion, which changes very quickly. Duration in seconds
  /// for which flow traffic event would be considered valid. While flow
  /// traffic event is valid it will be used over the historical traffic data.
  pub flow_event_threshold_override: Int? = None
  /// Specifies how traffic data should be used when calculating routes.
  /// Default Value: UseTrafficData Traffic data usage depends on the time
  /// parameters in your route request: When Usage is set to UseTrafficData :
  /// If DepartNow is set to true , or if you specify DepartureTime or
  /// ArrivalTime , then all traffic data is considered (including live
  /// traffic and closures). If DepartNow , DepartureTime , and ArrivalTime
  /// are all unspecified, then only long-term closures are considered,
  /// regardless of this setting. When Usage is set to IgnoreTrafficData ,
  /// then all traffic data is ignored regardless of the time parameters in
  /// your route request.
  pub usage: TrafficUsage? = None
}

/// Trailer options corresponding to the vehicle.
pub struct RouteTrailerOptions {
  /// Total number of axles of the vehicle.
  pub axle_count: Int? = None
  /// Number of trailers attached to the vehicle. Default value: 0
  pub trailer_count: Int? = None
}

