  pub kms_key_arn: Str? = None
}

/// The status of a training session.
pub enum TrainingSessionStatus: Str {
  Created = "Created"
  Blocked = "Blocked"
  Running = "Running"
  Failed = "Failed"
  Scheduled = "Scheduled"
  Stopping = "Stopping"
  Stopped = "Stopped"
  Expired = "Expired"
  Deleting = "Deleting"
  DeletionFailed = "DeletionFailed"
