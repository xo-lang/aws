  var req = serialize_suggest(ep, input, "") ?? e => return Err(SuggestErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(SuggestErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_suggest_error(resp))
  }
  deserialize_suggest(resp) ?? e => Err(SuggestErr.Deserialize(e))
}
