fn json_of_grant(v: Grant) -> json.Value {
  match v {
    AuthorizationCode(x) => json.Value.Object([("AuthorizationCode", json_of_authorization_code_grant(x))])
    JwtBearer(x) => json.Value.Object([("JwtBearer", json_of_jwt_bearer_grant(x))])
    RefreshToken(x) => json.Value.Object([("RefreshToken", json_of_refresh_token_grant(x))])
    TokenExchange(x) => json.Value.Object([("TokenExchange", json_of_token_exchange_grant(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_grant(v: json.Value) -> Grant ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "AuthorizationCode" => Ok(Grant.AuthorizationCode(from_json_authorization_code_grant(fv)?))
      "JwtBearer" => Ok(Grant.JwtBearer(from_json_jwt_bearer_grant(fv)?))
      "RefreshToken" => Ok(Grant.RefreshToken(from_json_refresh_token_grant(fv)?))
      "TokenExchange" => Ok(Grant.TokenExchange(from_json_token_exchange_grant(fv)?))
      _ => Ok(Grant.Unknown(k))
    }
  }
  Err("Grant: no member set")
}

