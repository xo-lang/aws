/// The HTTP request of BatchExecuteStatement.
pub fn serialize_batch_execute_statement(ep: rest.Endpoint, input: BatchExecuteStatementInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.statements {
    fs.push(("Statements", json_of_parti_ql_batch_request(x)))
  }
  if let Some(x) = input.return_consumed_capacity {
    fs.push(("ReturnConsumedCapacity", json.Value.Str(x.value())))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.0"))
  headers.push(("X-Amz-Target", "DynamoDB_20120810.BatchExecuteStatement"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_batch_execute_statement(resp: http.Response) -> BatchExecuteStatementOutput ! Str {
  var out = BatchExecuteStatementOutput{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Responses" => out.responses = from_json_parti_ql_batch_response(fv)?
      "ConsumedCapacity" => out.consumed_capacity = from_json_consumed_capacity_multiple(fv)?
      _ => {}
    }
  }
  Ok(out)
}

/// The errors of BatchExecuteStatement.
pub enum BatchExecuteStatementErr {
  InternalServerError(e: InternalServerError)
  RequestLimitExceeded(e: RequestLimitExceeded)
  ThrottlingException(e: ThrottlingException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: BatchExecuteStatementErr) display() -> Str {
  match e {
    InternalServerError(x) => "InternalServerError: ${x:?}"
    RequestLimitExceeded(x) => "RequestLimitExceeded: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_batch_execute_statement_error(resp: http.Response) -> BatchExecuteStatementErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "InternalServerError" => match read_error_internal_server_error(resp, body) {
      Ok(x) => return BatchExecuteStatementErr.InternalServerError(x)
      Err(msg) => return BatchExecuteStatementErr.Deserialize(msg)
    }
    "RequestLimitExceeded" => match read_error_request_limit_exceeded(resp, body) {
      Ok(x) => return BatchExecuteStatementErr.RequestLimitExceeded(x)
      Err(msg) => return BatchExecuteStatementErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return BatchExecuteStatementErr.ThrottlingException(x)
      Err(msg) => return BatchExecuteStatementErr.Deserialize(msg)
    }
    _ => {}
  }
  BatchExecuteStatementErr.Api(restjson.api_error(resp, body))
}

/// This operation allows you to perform batch reads or writes on data
/// stored in DynamoDB, using PartiQL. Each read statement in a
/// BatchExecuteStatement must specify an equality condition on all key
/// attributes. This enforces that each SELECT statement in a batch returns
/// at most a single item. For more information, see Running batch
/// operations with PartiQL for DynamoDB . The entire batch must consist of
/// either read statements or write statements, you cannot mix both in one
/// batch. A HTTP 200 response does not mean that all statements in the
/// BatchExecuteStatement succeeded. Error details for individual statements
/// can be found under the Error field of the BatchStatementResponse for
/// each statement.
pub fn (c: Client) batch_execute_statement(input: BatchExecuteStatementInput) -> BatchExecuteStatementOutput ! BatchExecuteStatementErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_batch_execute_statement(c.params, input)) ?? e => return Err(BatchExecuteStatementErr.InvalidInput(e))
  var req = serialize_batch_execute_statement(ep, input, "") ?? e => return Err(BatchExecuteStatementErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
