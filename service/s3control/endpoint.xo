      if let Some(bucket_arn) = endpoints.parse_arn(bucket) {
        if let Some(arn_type) = bucket_arn.resource_id.get(0) {
          if !(arn_type == "") {
            if bucket_arn.service == "s3-outposts" {
              if let Some(outpost_id) = bucket_arn.resource_id.get(1) {
                if endpoints.is_valid_host_label(outpost_id, false) {
                  if params.endpoint.is_some() && params.use_dual_stack {
                    return Err(endpoints.RuleErr{
                      msg: "Invalid Configuration: DualStack and custom endpoint are not " +
                        "supported",
                    })
                  }
                  if let Some(use_arn_region) = params.use_arn_region {
                    if !use_arn_region && !(bucket_arn.region == "${region}") {
                      return Err(endpoints.RuleErr{
                        msg: "Invalid configuration: region from ARN " +
                          "`${bucket_arn.region}` does not match client region " +
                          "`${region}` and UseArnRegion is `false`",
                      })
                    }
                  }
                  if let Some(arn_partition) = endpoints.partition(bucket_arn.region) {
                    if let Some(partition_result) = endpoints.partition(region) {
                      if arn_partition.name == partition_result.name {
                        if endpoints.is_valid_host_label(bucket_arn.region, true) {
                          if !(bucket_arn.account_id == "") {
                            if endpoints.is_valid_host_label(bucket_arn.account_id, false) {
                              if let Some(account_id) = params.account_id {
                                if !(account_id == "${bucket_arn.account_id}") {
                                  return Err(endpoints.RuleErr{
                                    msg: "Invalid ARN: the accountId specified in the ARN " +
                                      "(`${bucket_arn.account_id}`) does not match the " +
                                      "parameter (`${account_id}`)",
                                  })
                                }
                              }
                              if let Some(outpost_type) = bucket_arn.resource_id.get(2) {
                                if bucket_arn.resource_id.get(3).is_some() {
                                  if outpost_type == "bucket" {
                                    if params.use_fips && params.use_dual_stack {
                                      return Ok(endpoints.Endpoint{
                                        url: "https://s3-outposts-fips." +
                                          "${bucket_arn.region}." +
                                          "${arn_partition.dual_stack_dns_suffix}",
                                        auth_schemes: [
                                          endpoints.AuthScheme{
                                            disable_double_encoding: true,
                                            name: "sigv4",
                                            signing_name: "s3-outposts",
                                            signing_region: "${bucket_arn.region}",
                                          },
                                        ],
                                        headers: [
                                          ("x-amz-account-id", ["${bucket_arn.account_id}"]),
                                          ("x-amz-outpost-id", ["${outpost_id}"]),
                                        ],
                                      })
                                    }
                                    if params.use_fips {
                                      return Ok(endpoints.Endpoint{
                                        url: "https://s3-outposts-fips." +
                                          "${bucket_arn.region}." +
                                          "${arn_partition.dns_suffix}",
                                        auth_schemes: [
                                          endpoints.AuthScheme{
                                            disable_double_encoding: true,
                                            name: "sigv4",
                                            signing_name: "s3-outposts",
                                            signing_region: "${bucket_arn.region}",
                                          },
                                        ],
                                        headers: [
                                          ("x-amz-account-id", ["${bucket_arn.account_id}"]),
                                          ("x-amz-outpost-id", ["${outpost_id}"]),
                                        ],
                                      })
                                    }
                                    if params.use_dual_stack {
                                      return Ok(endpoints.Endpoint{
                                        url: "https://s3-outposts.${bucket_arn.region}." +
                                          "${arn_partition.dual_stack_dns_suffix}",
                                        auth_schemes: [
                                          endpoints.AuthScheme{
                                            disable_double_encoding: true,
                                            name: "sigv4",
                                            signing_name: "s3-outposts",
                                            signing_region: "${bucket_arn.region}",
                                          },
                                        ],
                                        headers: [
                                          ("x-amz-account-id", ["${bucket_arn.account_id}"]),
                                          ("x-amz-outpost-id", ["${outpost_id}"]),
                                        ],
                                      })
                                    }
                                    if let Some(endpoint) = params.endpoint {
                                      if let Some(url) = endpoints.parse_url(endpoint) {
                                        return Ok(endpoints.Endpoint{
                                          url: "${url.scheme}://${url.authority}${url.path}",
                                          auth_schemes: [
                                            endpoints.AuthScheme{
                                              disable_double_encoding: true,
                                              name: "sigv4",
                                              signing_name: "s3-outposts",
                                              signing_region: "${bucket_arn.region}",
                                            },
                                          ],
                                          headers: [
                                            ("x-amz-account-id", ["${bucket_arn.account_id}"]),
                                            ("x-amz-outpost-id", ["${outpost_id}"]),
                                          ],
                                        })
                                      }
                                    }
                                    return Ok(endpoints.Endpoint{
                                      url: "https://s3-outposts.${bucket_arn.region}." +
                                        "${arn_partition.dns_suffix}",
                                      auth_schemes: [
                                        endpoints.AuthScheme{
                                          disable_double_encoding: true,
                                          name: "sigv4",
                                          signing_name: "s3-outposts",
                                          signing_region: "${bucket_arn.region}",
                                        },
                                      ],
                                      headers: [
                                        ("x-amz-account-id", ["${bucket_arn.account_id}"]),
                                        ("x-amz-outpost-id", ["${outpost_id}"]),
                                      ],
                                    })
                                  }
                                  return Err(endpoints.RuleErr{
                                    msg: "Invalid ARN: Expected an outpost type `bucket`, " +
                                      "found `${outpost_type}`",
                                  })
                                }
                                return Err(endpoints.RuleErr{
                                  msg: "Invalid ARN: expected a bucket name",
                                })
                              }
                              return Err(endpoints.RuleErr{
                                msg: "Invalid ARN: Expected a 4-component resource",
                              })
                            }
                            return Err(endpoints.RuleErr{
                              msg: "Invalid ARN: The account id may only contain a-z, A-Z, " +
                                "0-9 and `-`. Found: `${bucket_arn.account_id}`",
                            })
                          }
                          return Err(endpoints.RuleErr{msg: "Invalid ARN: missing account ID"})
                        }
                        return Err(endpoints.RuleErr{
                          msg: "Invalid region in ARN: `${bucket_arn.region}` (invalid DNS " +
                            "name)",
                        })
                      }
                      return Err(endpoints.RuleErr{
                        msg: "Client was configured for partition " +
                          "`${partition_result.name}` but ARN has " +
                          "`${arn_partition.name}`",
                      })
                    }
                    return Err(endpoints.RuleErr{
                      msg: "rules in a matched tree rule were exhausted",
                    })
                  }
                  return Err(endpoints.RuleErr{
                    msg: "rules in a matched tree rule were exhausted",
                  })
                }
                return Err(endpoints.RuleErr{
                  msg: "Invalid ARN: The outpost Id must only contain a-z, A-Z, 0-9 and " +
                    "`-`., found: `${outpost_id}`",
                })
              }
              return Err(endpoints.RuleErr{msg: "Invalid ARN: The Outpost Id was not set"})
            }
            return Err(endpoints.RuleErr{msg: "rules in a matched tree rule were exhausted"})
          }
        }
        return Err(endpoints.RuleErr{msg: "Invalid ARN: No ARN type specified"})
      }
    }
    if let Some(partition_result) = endpoints.partition(region) {
      if endpoints.is_valid_host_label(region, true) {
        if let Some(requires_account_id) = params.requires_account_id {
          if requires_account_id && params.account_id.is_none() {
            return Err(endpoints.RuleErr{msg: "AccountId is required but not set"})
          }
        }
        if let Some(account_id) = params.account_id {
          if !endpoints.is_valid_host_label(account_id, false) {
            return Err(endpoints.RuleErr{
              msg: "AccountId must only contain a-z, A-Z, 0-9 and `-`.",
            })
          }
        }
        if let Some(endpoint) = params.endpoint {
          if let Some(url) = endpoints.parse_url(endpoint) {
            if params.use_dual_stack {
              return Err(endpoints.RuleErr{
                msg: "Invalid Configuration: DualStack and custom endpoint are not supported",
              })
            }
            if params.requires_account_id == Some(true) {
              if let Some(account_id) = params.account_id {
                return Ok(endpoints.Endpoint{
                  url: "${url.scheme}://${account_id}.${url.authority}${url.path}",
                  auth_schemes: [
                    endpoints.AuthScheme{
                      disable_double_encoding: true,
                      name: "sigv4",
                      signing_name: "s3",
                      signing_region: "${region}",
                    },
                  ],
                })
              }
            }
            return Ok(endpoints.Endpoint{
              url: "${url.scheme}://${url.authority}${url.path}",
              auth_schemes: [
                endpoints.AuthScheme{
                  disable_double_encoding: true,
                  name: "sigv4",
                  signing_name: "s3",
                  signing_region: "${region}",
                },
              ],
            })
          }
        }
        if params.use_fips &&
            params.use_dual_stack &&
            params.requires_account_id == Some(true) {
          if let Some(account_id) = params.account_id {
            return Ok(endpoints.Endpoint{
              url: "https://${account_id}.s3-control-fips.dualstack.${region}." +
                "${partition_result.dns_suffix}",
              auth_schemes: [
                endpoints.AuthScheme{
                  disable_double_encoding: true,
                  name: "sigv4",
                  signing_name: "s3",
                  signing_region: "${region}",
                },
              ],
            })
          }
        }
        if params.use_fips && params.use_dual_stack {
          return Ok(endpoints.Endpoint{
            url: "https://s3-control-fips.dualstack.${region}.${partition_result.dns_suffix}",
            auth_schemes: [
              endpoints.AuthScheme{
                disable_double_encoding: true,
                name: "sigv4",
                signing_name: "s3",
                signing_region: "${region}",
              },
            ],
          })
        }
        if params.use_fips &&
            !params.use_dual_stack &&
            params.requires_account_id == Some(true) {
          if let Some(account_id) = params.account_id {
            return Ok(endpoints.Endpoint{
              url: "https://${account_id}.s3-control-fips.${region}." +
                "${partition_result.dns_suffix}",
              auth_schemes: [
                endpoints.AuthScheme{
                  disable_double_encoding: true,
                  name: "sigv4",
                  signing_name: "s3",
                  signing_region: "${region}",
                },
              ],
            })
          }
        }
        if params.use_fips && !params.use_dual_stack {
          return Ok(endpoints.Endpoint{
            url: "https://s3-control-fips.${region}.${partition_result.dns_suffix}",
            auth_schemes: [
              endpoints.AuthScheme{
                disable_double_encoding: true,
                name: "sigv4",
                signing_name: "s3",
                signing_region: "${region}",
              },
            ],
          })
        }
        if !params.use_fips &&
            params.use_dual_stack &&
            params.requires_account_id == Some(true) {
          if let Some(account_id) = params.account_id {
            return Ok(endpoints.Endpoint{
              url: "https://${account_id}.s3-control.dualstack.${region}." +
                "${partition_result.dns_suffix}",
              auth_schemes: [
                endpoints.AuthScheme{
                  disable_double_encoding: true,
                  name: "sigv4",
                  signing_name: "s3",
                  signing_region: "${region}",
                },
              ],
            })
          }
        }
        if !params.use_fips && params.use_dual_stack {
          return Ok(endpoints.Endpoint{
            url: "https://s3-control.dualstack.${region}.${partition_result.dns_suffix}",
            auth_schemes: [
              endpoints.AuthScheme{
                disable_double_encoding: true,
                name: "sigv4",
                signing_name: "s3",
                signing_region: "${region}",
              },
            ],
          })
        }
        if !params.use_fips &&
            !params.use_dual_stack &&
            params.requires_account_id == Some(true) {
          if let Some(account_id) = params.account_id {
            return Ok(endpoints.Endpoint{
              url: "https://${account_id}.s3-control.${region}.${partition_result.dns_suffix}",
              auth_schemes: [
                endpoints.AuthScheme{
                  disable_double_encoding: true,
                  name: "sigv4",
                  signing_name: "s3",
                  signing_region: "${region}",
                },
              ],
            })
          }
        }
        if !params.use_fips && !params.use_dual_stack {
          return Ok(endpoints.Endpoint{
            url: "https://s3-control.${region}.${partition_result.dns_suffix}",
            auth_schemes: [
              endpoints.AuthScheme{
                disable_double_encoding: true,
                name: "sigv4",
                signing_name: "s3",
                signing_region: "${region}",
              },
            ],
          })
        }
        return Err(endpoints.RuleErr{msg: "rules in a matched tree rule were exhausted"})
      }
      return Err(endpoints.RuleErr{msg: "Invalid region: region was not a valid DNS name."})
    }
    return Err(endpoints.RuleErr{msg: "rules in a matched tree rule were exhausted"})
  }
  return Err(endpoints.RuleErr{msg: "Region must be set"})
}
