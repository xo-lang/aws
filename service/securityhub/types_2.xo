  /// The Amazon Resource Name (ARN) of the Lambda layer in which the code
  /// vulnerability is located.
  pub source_arn: Str? = None
}

pub enum VulnerabilityExploitAvailable: Str {
  Yes = "YES"
  No = "NO"
  Unknown(value: Str)
}

pub enum VulnerabilityFixAvailable: Str {
