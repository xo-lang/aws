fn xml_write_vpn_connection(var w: xmlv.Writer, v: VpnConnection, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.category {
    xmlv.elem(w, "category", x, [])
  }
  if let Some(x) = v.transit_gateway_id {
    xmlv.elem(w, "transitGatewayId", x, [])
  }
  if let Some(x) = v.vpn_concentrator_id {
    xmlv.elem(w, "vpnConcentratorId", x, [])
  }
  if let Some(x) = v.core_network_arn {
    xmlv.elem(w, "coreNetworkArn", x, [])
  }
  if let Some(x) = v.core_network_attachment_arn {
    xmlv.elem(w, "coreNetworkAttachmentArn", x, [])
  }
  if let Some(x) = v.gateway_association_state {
    xmlv.elem(w, "gatewayAssociationState", x.value(), [])
  }
  if let Some(x) = v.options {
    xml_write_vpn_connection_options(w, x, "options", [])
  }
  if let Some(x) = v.routes {
    xml_write_vpn_static_route_list(w, x, "routes", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.vgw_telemetry {
    xml_write_vgw_telemetry_list(w, x, "vgwTelemetry", [])
  }
  if let Some(x) = v.pre_shared_key_arn {
    xmlv.elem(w, "preSharedKeyArn", x, [])
  }
  if let Some(x) = v.vpn_connection_id {
    xmlv.elem(w, "vpnConnectionId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.customer_gateway_configuration {
    xmlv.elem(w, "customerGatewayConfiguration", x, [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "type", x.value(), [])
  }
  if let Some(x) = v.customer_gateway_id {
    xmlv.elem(w, "customerGatewayId", x, [])
  }
  if let Some(x) = v.vpn_gateway_id {
    xmlv.elem(w, "vpnGatewayId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpn_connection(e: xml.Element) -> VpnConnection ! Str {
  var out = VpnConnection{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "category" => out.category = c.text()
      "transitGatewayId" => out.transit_gateway_id = c.text()
      "vpnConcentratorId" => out.vpn_concentrator_id = c.text()
      "coreNetworkArn" => out.core_network_arn = c.text()
      "coreNetworkAttachmentArn" => out.core_network_attachment_arn = c.text()
      "gatewayAssociationState" => out.gateway_association_state = GatewayAssociationState.from(c.text())
      "options" => out.options = xml_read_vpn_connection_options(c)?
      "routes" => out.routes = xml_read_vpn_static_route_list(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "vgwTelemetry" => out.vgw_telemetry = xml_read_vgw_telemetry_list(c)?
      "preSharedKeyArn" => out.pre_shared_key_arn = c.text()
      "vpnConnectionId" => out.vpn_connection_id = c.text()
      "state" => out.state = VpnState.from(c.text())
      "customerGatewayConfiguration" => out.customer_gateway_configuration = c.text()
      "type" => out.type_value = GatewayType.from(c.text())
      "customerGatewayId" => out.customer_gateway_id = c.text()
      "vpnGatewayId" => out.vpn_gateway_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

