  }
  if let Some(x) = v.snapshot_identifier {
    query.add(f, query.key(prefix, "SnapshotIdentifier"), x)
  }
  if let Some(x) = v.source_database_name {
    query.add(f, query.key(prefix, "SourceDatabaseName"), x)
  }
  if let Some(x) = v.source_schema_name {
    query.add(f, query.key(prefix, "SourceSchemaName"), x)
  }
  if let Some(x) = v.source_table_name {
    query.add(f, query.key(prefix, "SourceTableName"), x)
  }
  if let Some(x) = v.target_database_name {
    query.add(f, query.key(prefix, "TargetDatabaseName"), x)
  }
  if let Some(x) = v.target_schema_name {
    query.add(f, query.key(prefix, "TargetSchemaName"), x)
