/// RANDOM_WITHIN_WINDOW ". Recovery point types ( required ) Valid values:
/// " SNAPSHOT " and/or " CONTINUOUS ". Include SNAPSHOT to restore only
/// snapshot recovery points; include CONTINUOUS to restore continuous
/// recovery points (point in time restore / PITR); use both to restore
/// either a snapshot or a continuous recovery point. The recovery point
/// will be determined by the value for Algorithm . IncludeVaults ( required
/// ). You must include one or more backup vaults. Use the wildcard ["*"] or
/// specific ARNs. SelectionWindowDays ( optional ) Value must be an integer
/// (in days) from 1 to 365. If not included, the value defaults to 30 .
/// ExcludeVaults ( optional ). You can choose to input one or more specific
/// backup vault ARNs to exclude those vaults' contents from restore
/// eligibility. Or, you can include a list of selectors. If this parameter
/// and its value are not included, it defaults to empty list.
pub struct RestoreTestingRecoveryPointSelection {
  /// Acceptable values include "LATEST_WITHIN_WINDOW" or
  /// "RANDOM_WITHIN_WINDOW"
  pub algorithm: RestoreTestingRecoveryPointSelectionAlgorithm? = None
  /// Accepted values include specific ARNs or list of selectors. Defaults to
  /// empty list if not listed.
  pub exclude_vaults: List[Str]? = None
  /// Accepted values include wildcard ["*"] or by specific ARNs or ARN
  /// wilcard replacement
  /// ["arn:aws:backup:us-west-2:123456789012:backup-vault:asdf", ...]
  /// ["arn:aws:backup:*:*:backup-vault:asdf-*", ...]
  pub include_vaults: List[Str]? = None
  /// These are the types of recovery points. Include SNAPSHOT to restore only
  /// snapshot recovery points; include CONTINUOUS to restore continuous
  /// recovery points (point in time restore / PITR); use both to restore
  /// either a snapshot or a continuous recovery point. The recovery point
  /// will be determined by the value for Algorithm .
  pub recovery_point_types: List[RestoreTestingRecoveryPointType]? = None
  /// Accepted values are integers from 1 to 365. If not included, the value
  /// defaults to 30. The selection window is calculated from the actual job
  /// execution time, not the plan's scheduled start time.
  pub selection_window_days: Int? = None
}

