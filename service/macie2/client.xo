  var out = BucketMetadata{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "accountId" => out.account_id = jsonv.read_str(fv)?
      "allowsUnencryptedObjectUploads" => out.allows_unencrypted_object_uploads = AllowsUnencryptedObjectUploads.from(jsonv.read_str(fv)?)
      "automatedDiscoveryMonitoringStatus" => out.automated_discovery_monitoring_status = AutomatedDiscoveryMonitoringStatus.from(jsonv.read_str(fv)?)
      "bucketArn" => out.bucket_arn = jsonv.read_str(fv)?
      "bucketCreatedAt" => out.bucket_created_at = jsonv.read_time(fv, "date-time")?
      "bucketName" => out.bucket_name = jsonv.read_str(fv)?
      "classifiableObjectCount" => out.classifiable_object_count = jsonv.read_int(fv)?
      "classifiableSizeInBytes" => out.classifiable_size_in_bytes = jsonv.read_int(fv)?
      "errorCode" => out.error_code = BucketMetadataErrorCode.from(jsonv.read_str(fv)?)
      "errorMessage" => out.error_message = jsonv.read_str(fv)?
      "jobDetails" => out.job_details = from_json_job_details(fv)?
      "lastAutomatedDiscoveryTime" => out.last_automated_discovery_time = jsonv.read_time(fv, "date-time")?
      "lastUpdated" => out.last_updated = jsonv.read_time(fv, "date-time")?
      "objectCount" => out.object_count = jsonv.read_int(fv)?
      "objectCountByEncryptionType" => out.object_count_by_encryption_type = from_json_object_count_by_encryption_type(fv)?
      "publicAccess" => out.public_access = from_json_bucket_public_access(fv)?
      "region" => out.region = jsonv.read_str(fv)?
      "replicationDetails" => out.replication_details = from_json_replication_details(fv)?
      "sensitivityScore" => out.sensitivity_score = jsonv.read_int(fv)?
      "serverSideEncryption" => out.server_side_encryption = from_json_bucket_server_side_encryption(fv)?
      "sharedAccess" => out.shared_access = SharedAccess.from(jsonv.read_str(fv)?)
      "sizeInBytes" => out.size_in_bytes = jsonv.read_int(fv)?
      "sizeInBytesCompressed" => out.size_in_bytes_compressed = jsonv.read_int(fv)?
      "tags" => out.tags = from_json_list_of_key_value_pair(fv)?
      "unclassifiableObjectCount" => out.unclassifiable_object_count = from_json_object_level_statistics(fv)?
      "unclassifiableObjectSizeInBytes" => out.unclassifiable_object_size_in_bytes = from_json_object_level_statistics(fv)?
      "versioning" => out.versioning = jsonv.read_bool(fv)?
      _ => {}
    }
  }
  Ok(out)
}

