/// captions will have red and yellow text. When you choose ALL_TEXT, your
/// font color setting applies to all of your output captions text.
pub enum DvbSubtitleApplyFontColor: Str {
  WhiteTextOnly = "WHITE_TEXT_ONLY"
  AllText = "ALL_TEXT"
  Unknown(value: Str)
}

/// Specify the color of the rectangle behind the captions. Leave background
/// color blank and set Style passthrough to enabled to use the background
/// color data from your input captions, if present.
pub enum DvbSubtitleBackgroundColor: Str {
  None = "NONE"
  Black = "BLACK"
  White = "WHITE"
  Auto = "AUTO"
  Unknown(value: Str)
}

/// Specify the color of the captions text. Leave Font color blank and set
