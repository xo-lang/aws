}

pub enum WordCloudWordScaling: Str {
  Emphasize = "EMPHASIZE"
  Normal = "NORMAL"
  Unknown(value: Str)
}

/// The options that are available for a single Y axis in a chart.
pub struct YAxisOptions {
  /// The Y axis type to be used in the chart. If you choose PRIMARY_Y_AXIS ,
  /// the primary Y Axis is located on the leftmost vertical axis of the
  /// chart.
  pub y_axis: SingleYAxisOption? = None
}
