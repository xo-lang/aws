/// The HTTP request of ActivateKeySigningKey.
pub fn serialize_activate_key_signing_key(ep: rest.Endpoint, given: ActivateKeySigningKeyRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  let input = given with {hosted_zone_id: given.hosted_zone_id.map(fn(v: Str) -> Str { v.split("/").last() ?? v })}
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_hosted_zone_id = match input.hosted_zone_id {
    Some(v) => v
    None => return Err("input member HostedZoneId is required")
  }
  if label_hosted_zone_id == "" {
    return Err("input member HostedZoneId must not be empty")
  }
  let label_name = match input.name {
    Some(v) => v
    None => return Err("input member Name is required")
  }
  if label_name == "" {
    return Err("input member Name must not be empty")
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/2013-04-01/keysigningkey/${rest.escape(label_hosted_zone_id, false)}/${rest.escape(label_name, false)}/activate"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

