/// Allows the creation of an asynchronous synthesis task, by starting a new
/// SpeechSynthesisTask . This operation requires all the standard
/// information needed for speech synthesis, plus the name of an Amazon S3
/// bucket for the service to store the output of the synthesis task and two
/// optional parameters ( OutputS3KeyPrefix and SnsTopicArn ). Once the
/// synthesis task is created, this operation will return a
/// SpeechSynthesisTask object, which will include an identifier of this
/// task as well as the current status. The SpeechSynthesisTask object is
/// available for 72 hours after starting the asynchronous synthesis task.
pub fn (c: Client) start_speech_synthesis_task(input: StartSpeechSynthesisTaskInput) -> StartSpeechSynthesisTaskOutput ! StartSpeechSynthesisTaskErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_start_speech_synthesis_task(c.params, input)) ?? e => return Err(StartSpeechSynthesisTaskErr.InvalidInput(e))
  var req = serialize_start_speech_synthesis_task(ep, input, "") ?? e => return Err(StartSpeechSynthesisTaskErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(StartSpeechSynthesisTaskErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_start_speech_synthesis_task_error(resp))
  }
  deserialize_start_speech_synthesis_task(resp) ?? e => Err(StartSpeechSynthesisTaskErr.Deserialize(e))
}

