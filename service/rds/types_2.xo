pub enum TargetType: Str {
  RdsInstance = "RDS_INSTANCE"
  RdsServerlessEndpoint = "RDS_SERVERLESS_ENDPOINT"
  TrackedCluster = "TRACKED_CLUSTER"
  Unknown(value: Str)
}

/// A tenant database in the DB instance. This data type is an element in
/// the response to the DescribeTenantDatabases action.
pub struct TenantDatabase {
  /// The creation time of the tenant database.
  pub tenant_database_create_time: Time? = None
  /// The ID of the DB instance that contains the tenant database.
  pub db_instance_identifier: Str? = None
  /// The database name of the tenant database.
  pub tenant_db_name: Str? = None
  /// The status of the tenant database.
  pub status: Str? = None
  /// The master username of the tenant database.
  pub master_username: Str? = None
  /// The Amazon Web Services Region-unique, immutable identifier for the DB
  /// instance.
  pub dbi_resource_id: Str? = None
  /// The Amazon Web Services Region-unique, immutable identifier for the
  /// tenant database.
  pub tenant_database_resource_id: Str? = None
  /// The Amazon Resource Name (ARN) for the tenant database.
  pub tenant_database_arn: Str? = None
  /// The character set of the tenant database.
  pub character_set_name: Str? = None
  /// The NCHAR character set name of the tenant database.
  pub nchar_character_set_name: Str? = None
  /// Specifies whether deletion protection is enabled for the DB instance.
  pub deletion_protection: Bool? = None
  /// Information about pending changes for a tenant database.
  pub pending_modified_values: TenantDatabasePendingModifiedValues? = None
  pub master_user_secret: MasterUserSecret? = None
  pub tag_list: List[Tag]? = None
}

/// You attempted to either create a tenant database that already exists or
/// modify a tenant database to use the name of an existing tenant database.
pub struct TenantDatabaseAlreadyExistsFault {
  pub message: Str? = None
}

/// The specified tenant database wasn't found in the DB instance.
pub struct TenantDatabaseNotFoundFault {
  pub message: Str? = None
}

/// A response element in the ModifyTenantDatabase operation that describes
/// changes that will be applied. Specific changes are identified by
/// subelements.
pub struct TenantDatabasePendingModifiedValues {
  /// The master password for the tenant database.
  pub master_user_password: Str? = None
  /// The name of the tenant database.
  pub tenant_db_name: Str? = None
}

/// You attempted to create more tenant databases than are permitted in your
/// Amazon Web Services account.
pub struct TenantDatabaseQuotaExceededFault {
  pub message: Str? = None
}

pub struct TenantDatabasesMessage {
  /// An optional pagination token provided by a previous
  /// DescribeTenantDatabases request. If this parameter is specified, the
  /// response includes only records beyond the marker, up to the value
  /// specified by MaxRecords .
  pub marker: Str? = None
  /// An array of the tenant databases requested by the
  /// DescribeTenantDatabases operation.
  pub tenant_databases: List[TenantDatabase]? = None
}

/// A time zone associated with a DBInstance or a DBSnapshot . This data
/// type is an element in the response to the DescribeDBInstances , the
/// DescribeDBSnapshots , and the DescribeDBEngineVersions actions.
pub struct Timezone {
  /// The name of the time zone.
  pub timezone_name: Str? = None
}

/// The specified DB engine version isn't supported for Aurora Limitless
/// Database.
pub struct UnsupportedDBEngineVersionFault {
  pub message: Str? = None
}

pub enum UpgradeRolloutOrder: Str {
  First = "first"
  Second = "second"
  Last = "last"
  Unknown(value: Str)
}

/// The version of the database engine that a DB instance can be upgraded
/// to.
pub struct UpgradeTarget {
  /// The name of the upgrade target database engine.
  pub engine: Str? = None
  /// The version number of the upgrade target database engine.
  pub engine_version: Str? = None
  /// The version of the database engine that a DB instance can be upgraded
  /// to.
  pub description: Str? = None
  /// Indicates whether the target version is applied to any source DB
  /// instances that have AutoMinorVersionUpgrade set to true. This parameter
  /// is dynamic, and is set by RDS.
  pub auto_upgrade: Bool? = None
  /// Indicates whether upgrading to the target version requires upgrading the
  /// major version of the database engine.
  pub is_major_version_upgrade: Bool? = None
  /// A list of the supported DB engine modes for the target engine version.
  pub supported_engine_modes: List[Str]? = None
  /// Indicates whether you can use Aurora parallel query with the target
  /// engine version.
  pub supports_parallel_query: Bool? = None
  /// Indicates whether you can use Aurora global databases with the target
  /// engine version.
  pub supports_global_databases: Bool? = None
  /// Indicates whether you can use Babelfish for Aurora PostgreSQL with the
  /// target engine version.
  pub supports_babelfish: Bool? = None
  /// Indicates whether the DB engine version supports Aurora Limitless
  /// Database.
  pub supports_limitless_database: Bool? = None
  /// Indicates whether the target engine version supports forwarding write
  /// operations from reader DB instances to the writer DB instance in the DB
  /// cluster. By default, write operations aren't allowed on reader DB
  /// instances. Valid for: Aurora DB clusters only
  pub supports_local_write_forwarding: Bool? = None
  /// Indicates whether the DB engine version supports zero-ETL integrations
  /// with Amazon Redshift.
  pub supports_integrations: Bool? = None
}

/// Specifies the details of authentication used by a proxy to log in as a
/// specific database user.
pub struct UserAuthConfig {
  /// A user-specified description about the authentication used by a proxy to
  /// log in as a specific database user.
  pub description: Str? = None
  /// The name of the database user to which the proxy connects.
  pub user_name: Str? = None
  /// The type of authentication that the proxy uses for connections from the
  /// proxy to the underlying database.
  pub auth_scheme: AuthScheme? = None
  /// The Amazon Resource Name (ARN) representing the secret that the proxy
  /// uses to authenticate to the RDS DB instance or Aurora DB cluster. These
  /// secrets are stored within Amazon Secrets Manager.
  pub secret_arn: Str? = None
  /// A value that indicates whether to require or disallow Amazon Web
  /// Services Identity and Access Management (IAM) authentication for
  /// connections to the proxy. The ENABLED value is valid only for proxies
  /// with RDS for Microsoft SQL Server.
  pub iam_auth: IAMAuthMode? = None
  /// The type of authentication the proxy uses for connections from clients.
  /// The following values are defaults for the corresponding engines: RDS for
  /// MySQL: MYSQL_CACHING_SHA2_PASSWORD RDS for SQL Server:
  /// SQL_SERVER_AUTHENTICATION RDS for PostgreSQL: POSTGRES_SCRAM_SHA2_256
  pub client_password_auth_type: ClientPasswordAuthType? = None
}

/// Returns the details of authentication used by a proxy to log in as a
/// specific database user.
pub struct UserAuthConfigInfo {
  /// A user-specified description about the authentication used by a proxy to
  /// log in as a specific database user.
  pub description: Str? = None
  /// The name of the database user to which the proxy connects.
  pub user_name: Str? = None
  /// The type of authentication that the proxy uses for connections from the
  /// proxy to the underlying database.
  pub auth_scheme: AuthScheme? = None
  /// The Amazon Resource Name (ARN) representing the secret that the proxy
  /// uses to authenticate to the RDS DB instance or Aurora DB cluster. These
  /// secrets are stored within Amazon Secrets Manager.
  pub secret_arn: Str? = None
  /// Whether to require or disallow Amazon Web Services Identity and Access
  /// Management (IAM) authentication for connections to the proxy.
  pub iam_auth: IAMAuthMode? = None
  /// The type of authentication the proxy uses for connections from clients.
  pub client_password_auth_type: ClientPasswordAuthType? = None
}

/// Contains the valid options for additional storage volumes for a DB
/// instance.
pub struct ValidAdditionalStorageOptions {
  /// Indicates whether the DB instance supports additional storage volumes.
  pub supports_additional_storage_volumes: Bool? = None
  /// The valid additional storage volume options for the DB instance.
  pub volumes: List[ValidVolumeOptions]? = None
}

/// Information about valid modifications that you can make to your DB
/// instance. Contains the result of a successful call to the
/// DescribeValidDBInstanceModifications action. You can use this
/// information when you call ModifyDBInstance .
pub struct ValidDBInstanceModificationsMessage {
  /// Valid storage options for your DB instance.
  pub storage: List[ValidStorageOptions]? = None
  /// Valid processor features for your DB instance.
  pub valid_processor_features: List[AvailableProcessorFeature]? = None
  /// Indicates whether a DB instance supports using a dedicated log volume
  /// (DLV).
  pub supports_dedicated_log_volume: Bool? = None
  /// The valid additional storage options for the DB instance.
  pub additional_storage: ValidAdditionalStorageOptions? = None
}

/// Information about valid modifications that you can make to your DB
/// instance. Contains the result of a successful call to the
/// DescribeValidDBInstanceModifications action.
pub struct ValidStorageOptions {
  /// The valid storage types for your DB instance. For example: gp2, gp3,
  /// io1, io2.
  pub storage_type: Str? = None
  /// The valid range of storage in gibibytes (GiB). For example, 100 to
  /// 16,384.
  pub storage_size: List[Range]? = None
  /// The valid range of provisioned IOPS. For example, 1000-256,000.
  pub provisioned_iops: List[Range]? = None
  /// The valid range of Provisioned IOPS to gibibytes of storage multiplier.
  /// For example, 3-10, which means that provisioned IOPS can be between 3
  /// and 10 times storage.
  pub iops_to_storage_ratio: List[DoubleRange]? = None
  /// The valid range of provisioned storage throughput. For example,
  /// 500-4,000 mebibytes per second (MiBps).
  pub provisioned_storage_throughput: List[Range]? = None
  /// The valid range of storage throughput to provisioned IOPS ratios. For
  /// example, 0-0.25.
  pub storage_throughput_to_iops_ratio: List[DoubleRange]? = None
  /// Indicates whether or not Amazon RDS can automatically scale storage for
  /// DB instances that use the new instance class.
  pub supports_storage_autoscaling: Bool? = None
}

/// Contains the valid options for an additional storage volume.
pub struct ValidVolumeOptions {
  /// The name of the additional storage volume.
  pub volume_name: Str? = None
  /// The valid storage options for the additional storage volume.
  pub storage: List[ValidStorageOptions]? = None
}

/// The operation violates VPC encryption control settings. Make sure that
/// your DB instance type supports the Nitro encryption-in-transit
/// capability, or modify your VPC's encryption controls to not enforce
/// encryption-in-transit.
pub struct VpcEncryptionControlViolationException {
  pub message: Str? = None
}

/// This data type is used as a response element for queries on VPC security
/// group membership.
pub struct VpcSecurityGroupMembership {
  /// The name of the VPC security group.
  pub vpc_security_group_id: Str? = None
  /// The membership status of the VPC security group. Currently, the only
  /// valid status is active .
  pub status: Str? = None
}

pub enum WriteForwardingStatus: Str {
  Enabled = "enabled"
  Disabled = "disabled"
  Enabling = "enabling"
  Disabling = "disabling"
  Unknown = "unknown"
  UnknownValue(value: Str)
}
