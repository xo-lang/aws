fn from_json_graphql_api(v: json.Value) -> GraphqlApi ! Str {
  var out = GraphqlApi{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "name" => out.name = jsonv.read_str(fv)?
      "apiId" => out.api_id = jsonv.read_str(fv)?
