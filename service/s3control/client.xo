fn xml_write_job_descriptor(var w: xmlv.Writer, v: JobDescriptor, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.job_id {
    xmlv.elem(w, "JobId", x, [])
  }
  if let Some(x) = v.confirmation_required {
    xmlv.elem(w, "ConfirmationRequired", "${x}", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.job_arn {
    xmlv.elem(w, "JobArn", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.manifest {
    xml_write_job_manifest(w, x, "Manifest", [])
  }
  if let Some(x) = v.operation {
    xml_write_job_operation(w, x, "Operation", [])
  }
  if let Some(x) = v.priority {
    xmlv.elem(w, "Priority", "${x}", [])
  }
  if let Some(x) = v.progress_summary {
    xml_write_job_progress_summary(w, x, "ProgressSummary", [])
  }
  if let Some(x) = v.status_update_reason {
    xmlv.elem(w, "StatusUpdateReason", x, [])
  }
  if let Some(x) = v.failure_reasons {
    xml_write_job_failure_list(w, x, "FailureReasons", [])
  }
  if let Some(x) = v.report {
    xml_write_job_report(w, x, "Report", [])
  }
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "CreationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.termination_date {
    xmlv.elem(w, "TerminationDate", rest.date_time(x), [])
  }
  if let Some(x) = v.role_arn {
    xmlv.elem(w, "RoleArn", x, [])
  }
  if let Some(x) = v.suspended_date {
    xmlv.elem(w, "SuspendedDate", rest.date_time(x), [])
  }
  if let Some(x) = v.suspended_cause {
    xmlv.elem(w, "SuspendedCause", x, [])
  }
  if let Some(x) = v.manifest_generator {
    xml_write_job_manifest_generator(w, x, "ManifestGenerator", [])
  }
  if let Some(x) = v.generated_manifest_descriptor {
    xml_write_s3_generated_manifest_descriptor(w, x, "GeneratedManifestDescriptor", [])
  }
  xmlv.end(w, name)
}

fn xml_read_job_descriptor(e: xml.Element) -> JobDescriptor ! Str {
  var out = JobDescriptor{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "JobId" => out.job_id = c.text()
      "ConfirmationRequired" => out.confirmation_required = xmlv.read_bool(c.text())?
      "Description" => out.description = c.text()
      "JobArn" => out.job_arn = c.text()
      "Status" => out.status = JobStatus.from(c.text())
      "Manifest" => out.manifest = xml_read_job_manifest(c)?
      "Operation" => out.operation = xml_read_job_operation(c)?
      "Priority" => out.priority = xmlv.read_int(c.text())?
      "ProgressSummary" => out.progress_summary = xml_read_job_progress_summary(c)?
      "StatusUpdateReason" => out.status_update_reason = c.text()
      "FailureReasons" => out.failure_reasons = xml_read_job_failure_list(c)?
      "Report" => out.report = xml_read_job_report(c)?
      "CreationTime" => out.creation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "TerminationDate" => out.termination_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "RoleArn" => out.role_arn = c.text()
      "SuspendedDate" => out.suspended_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SuspendedCause" => out.suspended_cause = c.text()
      "ManifestGenerator" => out.manifest_generator = xml_read_job_manifest_generator(c)?
      "GeneratedManifestDescriptor" => out.generated_manifest_descriptor = xml_read_s3_generated_manifest_descriptor(c)?
      _ => {}
    }
  }
  Ok(out)
}

