fn json_of_partner_profile(v: PartnerProfile) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.display_name {
    fs.push(("DisplayName", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.website_url {
    fs.push(("WebsiteUrl", json.Value.Str(x)))
  }
  if let Some(x) = v.logo_url {
    fs.push(("LogoUrl", json.Value.Str(x)))
  }
  if let Some(x) = v.primary_solution_type {
    fs.push(("PrimarySolutionType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.industry_segments {
    fs.push(("IndustrySegments", json_of_industry_segment_list(x)))
  }
  if let Some(x) = v.translation_source_locale {
    fs.push(("TranslationSourceLocale", json.Value.Str(x)))
  }
  if let Some(x) = v.localized_contents {
    fs.push(("LocalizedContents", json_of_localized_content_list(x)))
  }
