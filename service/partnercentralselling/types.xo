/// Contains enrichment data for engagement invitations. You can view
/// propensity scores, program eligibility, and lead readiness insights
/// directly in the invitation, before you take action on the invitation.
pub struct EnrichmentContext {
  /// The customer account data and propensity insights for the prospected
  /// account. It includes geographic, industry, and segment classifications,
  /// along with engagement and solution scoring.
  pub prospecting_result_aws: InvitationProspectingResultAws? = None
  /// The AI-generated lead readiness score for this lead. Use this score to
  /// assess lead quality and prioritize engagement efforts.
  pub lead_insights: LeadInsights? = None
}

/// The expected duration of a partner's contract with the customer. Used to
/// convert Total Contract Value (TCV) to Monthly Recurring Revenue (MRR)
/// for opportunity dealsizing calculations.
pub struct ExpectedContractDuration {
  /// The unit of measurement for the contract duration value. Currently
  /// accepts only Months .
  pub term: ExpectedContractDurationTerm? = None
  /// A String representation of the contract duration as an integer,
  /// expressed in the unit defined by Term . Valid values range from 1 to 144
  /// .
  pub value: Str? = None
}

/// The unit of measurement for the contract duration value. Currently
/// accepts only Months .
pub enum ExpectedContractDurationTerm: Str {
  Months = "Months"
  Unknown(value: Str)
}

/// Provides an estimate of the revenue that the partner is expected to
/// generate from the opportunity. This information helps partners assess
/// the financial value of the project.
pub struct ExpectedCustomerSpend {
  /// Represents the estimated monthly revenue that the partner expects to
  /// earn from the opportunity. This helps in forecasting financial returns.
  pub amount: Str? = None
  /// Indicates the currency in which the revenue estimate is provided. This
  /// helps in understanding the financial impact across different markets.
  /// Accepted values are USD (US Dollars) and EUR (Euros). If the AWS
  /// Partition is aws-eusc (AWS European Sovereign Cloud), the currency code
  /// must be EUR .
  pub currency_code: CurrencyCode? = None
  /// Indicates how frequently the customer is expected to spend the projected
  /// amount. Use Monthly for recurring monthly spend (required for
  /// TargetCompany: "AWS" entries). Use None for one-time deal value entries
  /// (required for TargetCompany: "Self" entries when providing Total
  /// Contract Value).
  pub frequency: PaymentFrequency? = None
  /// Specifies the entity associated with this spend entry. Use AWS for the
  /// system’s AWS Monthly Recurring Revenue (MRR) estimate. Use Self for
  /// the partner’s own deal value entry when providing Total Contract Value
  /// (TCV) for automatic MRR conversion. When ExpectedContractDuration is
  /// present on the Project, only AWS and Self are accepted. When
  /// ExpectedContractDuration is not present, only AWS is accepted and any
  /// other value will be automatically set to AWS .
  pub target_company: Str? = None
  /// A URL providing additional information or context about the spend
  /// estimation.
  pub estimation_url: Str? = None
}

