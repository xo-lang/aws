  /// The network types supported by this subnet. Returns an array of strings
  /// that can include ipv4 , ipv6 , or both, indicating whether the subnet
  /// group supports IPv4 only, IPv6 only, or dual-stack deployments.
  pub supported_network_types: List[NetworkType]? = None
}

