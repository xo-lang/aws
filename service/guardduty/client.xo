fn json_of_lineage(v: List[LineageObject]) -> json.Value {
  json.Value.List(v.map(fn(x: LineageObject) -> json.Value { json_of_lineage_object(x) }))
}

fn from_json_lineage(v: json.Value) -> List[LineageObject] ! Str {
  var out: List[LineageObject] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_lineage_object(fv)?)
  }
  Ok(out)
}

fn json_of_lineage_object(v: LineageObject) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.start_time {
    fs.push(("startTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.namespace_pid {
    fs.push(("namespacePid", json.Value.Int(x)))
  }
  if let Some(x) = v.user_id {
    fs.push(("userId", json.Value.Int(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.pid {
    fs.push(("pid", json.Value.Int(x)))
  }
  if let Some(x) = v.uuid {
    fs.push(("uuid", json.Value.Str(x)))
  }
  if let Some(x) = v.executable_path {
    fs.push(("executablePath", json.Value.Str(x)))
  }
  if let Some(x) = v.euid {
    fs.push(("euid", json.Value.Int(x)))
  }
  if let Some(x) = v.parent_uuid {
    fs.push(("parentUuid", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

