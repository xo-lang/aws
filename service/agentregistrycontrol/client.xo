fn json_of_source_details(v: SourceDetails) -> json.Value {
  match v {
    AgentcoreRuntime(x) => json.Value.Object([("agentcoreRuntime", json_of_agent_core_runtime_source_details(x))])
    AgentcoreGateway(x) => json.Value.Object([("agentcoreGateway", json_of_agent_core_gateway_source_details(x))])
