  let (ep, signing, extra) = c.route(endpoint_params_validate_configuration_settings(c.params, input)) ?? e => return Err(ValidateConfigurationSettingsErr.InvalidInput(e))
  var req = serialize_validate_configuration_settings(ep, input, "") ?? e => return Err(ValidateConfigurationSettingsErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(ValidateConfigurationSettingsErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_validate_configuration_settings_error(resp))
  }
  deserialize_validate_configuration_settings(resp) ?? e => Err(ValidateConfigurationSettingsErr.Deserialize(e))
}
