  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_db_instances(input) {
      Ok(out) => {
        let o = jmes_of_db_instance_message(out)
        if state == "" && waiter.path_matches(o, "DBInstances[].DBInstanceStatus", "allStringEquals", "available") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "DBInstances[].DBInstanceStatus", "anyStringEquals", "deleted") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBInstances[].DBInstanceStatus", "anyStringEquals", "deleting") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBInstances[].DBInstanceStatus", "anyStringEquals", "failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBInstances[].DBInstanceStatus", "anyStringEquals", "incompatible-restore") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBInstances[].DBInstanceStatus", "anyStringEquals", "incompatible-parameters") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("DBInstanceAvailable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
