fn json_of_service_discovery(v: ServiceDiscovery) -> json.Value {
  match v {
    Dns(x) => json.Value.Object([("dns", json_of_dns_service_discovery(x))])
    AwsCloudMap(x) => json.Value.Object([("awsCloudMap", json_of_aws_cloud_map_service_discovery(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_service_discovery(v: json.Value) -> ServiceDiscovery ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "dns" => Ok(ServiceDiscovery.Dns(from_json_dns_service_discovery(fv)?))
      "awsCloudMap" => Ok(ServiceDiscovery.AwsCloudMap(from_json_aws_cloud_map_service_discovery(fv)?))
      _ => Ok(ServiceDiscovery.Unknown(k))
    }
  }
  Err("ServiceDiscovery: no member set")
}

