  var out = ApplicationStatus{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "status" => out.status = ApplicationStatusEnum.from(c.text())
      "statusTimeStamp" => out.status_time_stamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "statusSince" => out.status_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "resumeAt" => out.resume_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "detailSet" => out.details = xml_read_application_status_detail_set(c)?
      _ => {}
    }
  }
  Ok(out)
}

