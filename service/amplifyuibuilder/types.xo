  /// The name of the backend environment that is part of the Amplify app.
  pub environment_name: Str? = None
  /// The unique ID for the component.
  pub id: Str? = None
  /// The unique client token.
  pub client_token: Str? = None
  /// The configuration of the updated component.
  pub updated_component: UpdateComponentData? = None
}

pub struct UpdateComponentResponse {
  /// Describes the configuration of the updated component.
  pub entity: Component? = None
}

/// Updates and saves all of the information about a form, based on form ID.
pub struct UpdateFormData {
  /// The name of the form.
  pub name: Str? = None
  /// The type of data source to use to create the form.
  pub data_type: FormDataTypeConfig? = None
  /// Specifies whether to perform a create or update action on the form.
  pub form_action_type: FormActionType? = None
  /// The configuration information for the form's fields.
  pub fields: Map[Str, FieldConfig]? = None
  /// The configuration for the form's style.
  pub style: FormStyle? = None
  /// The configuration information for the visual helper elements for the
  /// form. These elements are not associated with any data.
  pub sectional_elements: Map[Str, SectionalElement]? = None
  /// The schema version of the form.
  pub schema_version: Str? = None
  /// The FormCTA object that stores the call to action configuration for the
  /// form.
  pub cta: FormCTA? = None
  /// Specifies an icon or decoration to display on the form.
  pub label_decorator: Str? = None
}

pub struct UpdateFormRequest {
  /// The unique ID for the Amplify app.
  pub app_id: Str? = None
  /// The name of the backend environment that is part of the Amplify app.
  pub environment_name: Str? = None
  /// The unique ID for the form.
  pub id: Str? = None
  /// The unique client token.
  pub client_token: Str? = None
  /// The request accepts the following data in JSON format.
  pub updated_form: UpdateFormData? = None
}

pub struct UpdateFormResponse {
  /// Describes the configuration of the updated form.
  pub entity: Form? = None
}

/// Saves the data binding information for a theme.
pub struct UpdateThemeData {
  /// The unique ID of the theme to update.
  pub id: Str? = None
  /// The name of the theme to update.
  pub name: Str? = None
  /// A list of key-value pairs that define the theme's properties.
  pub values: List[ThemeValues]? = None
  /// Describes the properties that can be overriden to customize the theme.
  pub overrides: List[ThemeValues]? = None
}

pub struct UpdateThemeRequest {
  /// The unique ID for the Amplify app.
  pub app_id: Str? = None
  /// The name of the backend environment that is part of the Amplify app.
  pub environment_name: Str? = None
  /// The unique ID for the theme.
  pub id: Str? = None
  /// The unique client token.
  pub client_token: Str? = None
  /// The configuration of the updated theme.
  pub updated_theme: UpdateThemeData? = None
}

pub struct UpdateThemeResponse {
  /// Describes the configuration of the updated theme.
  pub entity: Theme? = None
}

/// Associates a complex object with a display value. Use ValueMapping to
/// store how to represent complex objects when they are displayed.
pub struct ValueMapping {
  /// The value to display for the complex object.
  pub display_value: FormInputValueProperty? = None
  /// The complex object.
  pub value: FormInputValueProperty? = None
}

/// Represents the data binding configuration for a value map.
pub struct ValueMappings {
  /// The value and display value pairs.
  pub values: List[ValueMapping]? = None
  /// The information to bind fields to data at runtime.
  pub binding_properties: Map[Str, FormInputBindingPropertiesValue]? = None
}
