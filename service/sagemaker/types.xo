/// Details about an Amazon SageMaker AI app.
pub struct AppDetails {
  /// The domain ID.
  pub domain_id: Str? = None
  /// The user profile name.
  pub user_profile_name: Str? = None
  /// The name of the space.
  pub space_name: Str? = None
  /// The type of app.
  pub app_type: AppType? = None
  /// The name of the app.
  pub app_name: Str? = None
  /// The status.
  pub status: AppStatus? = None
  /// The creation time.
  pub creation_time: Time? = None
  pub resource_spec: ResourceSpec? = None
}

/// The configuration for running a SageMaker AI image as a KernelGateway
/// app.
pub struct AppImageConfigDetails {
  /// The ARN of the AppImageConfig.
  pub app_image_config_arn: Str? = None
  /// The name of the AppImageConfig. Must be unique to your account.
  pub app_image_config_name: Str? = None
  /// When the AppImageConfig was created.
  pub creation_time: Time? = None
  /// When the AppImageConfig was last modified.
  pub last_modified_time: Time? = None
  /// The configuration for the file system and kernels in the SageMaker AI
  /// image.
  pub kernel_gateway_image_config: KernelGatewayImageConfig? = None
  /// The configuration for the file system and the runtime, such as the
  /// environment variables and entry point.
  pub jupyter_lab_app_image_config: JupyterLabAppImageConfig? = None
  /// The configuration for the file system and the runtime, such as the
  /// environment variables and entry point.
  pub code_editor_app_image_config: CodeEditorAppImageConfig? = None
}

pub enum AppImageConfigSortKey: Str {
  CreationTime = "CreationTime"
  LastModifiedTime = "LastModifiedTime"
  Name = "Name"
  Unknown(value: Str)
}

