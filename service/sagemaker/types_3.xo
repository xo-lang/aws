/// An Amazon SageMaker processing job that is used to analyze data and
/// evaluate models. For more information, see Process Data and Evaluate
/// Models .
pub struct ProcessingJob {
  /// List of input configurations for the processing job.
  pub processing_inputs: List[ProcessingInput]? = None
  pub processing_output_config: ProcessingOutputConfig? = None
  /// The name of the processing job.
  pub processing_job_name: Str? = None
  pub processing_resources: ProcessingResources? = None
  pub stopping_condition: ProcessingStoppingCondition? = None
  pub app_specification: AppSpecification? = None
  /// Sets the environment variables in the Docker container.
  pub environment: Map[Str, Str]? = None
  pub network_config: NetworkConfig? = None
  /// The ARN of the role used to create the processing job.
  pub role_arn: Str? = None
  pub experiment_config: ExperimentConfig? = None
  /// The ARN of the processing job.
  pub processing_job_arn: Str? = None
  /// The status of the processing job.
  pub processing_job_status: ProcessingJobStatus? = None
  /// A string, up to one KB in size, that contains metadata from the
  /// processing container when the processing job exits.
  pub exit_message: Str? = None
  /// A string, up to one KB in size, that contains the reason a processing
  /// job failed, if it failed.
  pub failure_reason: Str? = None
  /// The time that the processing job ended.
  pub processing_end_time: Time? = None
  /// The time that the processing job started.
  pub processing_start_time: Time? = None
  /// The time the processing job was last modified.
  pub last_modified_time: Time? = None
  /// The time the processing job was created.
  pub creation_time: Time? = None
  /// The ARN of a monitoring schedule for an endpoint associated with this
  /// processing job.
  pub monitoring_schedule_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the AutoML job associated with this
  /// processing job.
  pub auto_ml_job_arn: Str? = None
  /// The ARN of the training job associated with this processing job.
  pub training_job_arn: Str? = None
  /// An array of key-value pairs. For more information, see Using Cost
  /// Allocation Tags in the Amazon Web Services Billing and Cost Management
  /// User Guide .
  pub tags: List[Tag]? = None
}

pub enum ProcessingJobStatus: Str {
  InProgress = "InProgress"
  Completed = "Completed"
  Failed = "Failed"
  Stopping = "Stopping"
  Stopped = "Stopped"
  Unknown(value: Str)
}

/// Metadata for a processing job step.
pub struct ProcessingJobStepMetadata {
  /// The Amazon Resource Name (ARN) of the processing job.
  pub arn: Str? = None
}

/// Summary of information about a processing job.
pub struct ProcessingJobSummary {
  /// The name of the processing job.
  pub processing_job_name: Str? = None
  /// The Amazon Resource Name (ARN) of the processing job..
  pub processing_job_arn: Str? = None
  /// The time at which the processing job was created.
  pub creation_time: Time? = None
  /// The time at which the processing job completed.
  pub processing_end_time: Time? = None
  /// A timestamp that indicates the last time the processing job was
  /// modified.
  pub last_modified_time: Time? = None
  /// The status of the processing job.
  pub processing_job_status: ProcessingJobStatus? = None
  /// A string, up to one KB in size, that contains the reason a processing
  /// job failed, if it failed.
  pub failure_reason: Str? = None
  /// An optional string, up to one KB in size, that contains metadata from
  /// the processing container when the processing job exits.
  pub exit_message: Str? = None
}

/// Describes the results of a processing job. The processing output must
/// specify exactly one of either S3Output or FeatureStoreOutput types.
pub struct ProcessingOutput {
  /// The name for the processing job output.
  pub output_name: Str? = None
  /// Configuration for processing job outputs in Amazon S3.
  pub s3_output: ProcessingS3Output? = None
  /// Configuration for processing job outputs in Amazon SageMaker Feature
  /// Store. This processing output type is only supported when AppManaged is
  /// specified.
  pub feature_store_output: ProcessingFeatureStoreOutput? = None
  /// When True , output operations such as data upload are managed natively
  /// by the processing job application. When False (default), output
  /// operations are managed by Amazon SageMaker.
  pub app_managed: Bool? = None
}

/// Configuration for uploading output from the processing container.
pub struct ProcessingOutputConfig {
  /// An array of outputs configuring the data to upload from the processing
  /// container.
  pub outputs: List[ProcessingOutput]? = None
  /// The Amazon Web Services Key Management Service (Amazon Web Services KMS)
  /// key that Amazon SageMaker uses to encrypt the processing job output.
  /// KmsKeyId can be an ID of a KMS key, ARN of a KMS key, or alias of a KMS
  /// key. The KmsKeyId is applied to all outputs.
  pub kms_key_id: Str? = None
}

/// Identifies the resources, ML compute instances, and ML storage volumes
/// to deploy for a processing job. In distributed training, you specify
/// more than one instance.
pub struct ProcessingResources {
  /// The configuration for the resources in a cluster used to run the
  /// processing job.
  pub cluster_config: ProcessingClusterConfig? = None
}

pub enum ProcessingS3CompressionType: Str {
  None = "None"
  Gzip = "Gzip"
  Unknown(value: Str)
}

pub enum ProcessingS3DataDistributionType: Str {
  Fullyreplicated = "FullyReplicated"
  Shardedbys3Key = "ShardedByS3Key"
  Unknown(value: Str)
}

pub enum ProcessingS3DataType: Str {
  ManifestFile = "ManifestFile"
  S3Prefix = "S3Prefix"
  Unknown(value: Str)
}

/// Configuration for downloading input data from Amazon S3 into the
/// processing container.
pub struct ProcessingS3Input {
  /// The URI of the Amazon S3 prefix Amazon SageMaker downloads data required
  /// to run a processing job.
  pub s3_uri: Str? = None
  /// The local path in your container where you want Amazon SageMaker to
  /// write input data to. LocalPath is an absolute path to the input data and
  /// must begin with /opt/ml/processing/ . LocalPath is a required parameter
  /// when AppManaged is False (default).
  pub local_path: Str? = None
  /// Whether you use an S3Prefix or a ManifestFile for the data type. If you
  /// choose S3Prefix , S3Uri identifies a key name prefix. Amazon SageMaker
  /// uses all objects with the specified key name prefix for the processing
  /// job. If you choose ManifestFile , S3Uri identifies an object that is a
  /// manifest file containing a list of object keys that you want Amazon
  /// SageMaker to use for the processing job.
  pub s3_data_type: ProcessingS3DataType? = None
  /// Whether to use File or Pipe input mode. In File mode, Amazon SageMaker
  /// copies the data from the input source onto the local ML storage volume
  /// before starting your processing container. This is the most commonly
  /// used input mode. In Pipe mode, Amazon SageMaker streams input data from
  /// the source directly to your processing container into named pipes
  /// without using the ML storage volume.
  pub s3_input_mode: ProcessingS3InputMode? = None
  /// Whether to distribute the data from Amazon S3 to all processing
  /// instances with FullyReplicated , or whether the data from Amazon S3 is
  /// sharded by Amazon S3 key, downloading one shard of data to each
  /// processing instance.
  pub s3_data_distribution_type: ProcessingS3DataDistributionType? = None
  /// Whether to GZIP-decompress the data in Amazon S3 as it is streamed into
  /// the processing container. Gzip can only be used when Pipe mode is
  /// specified as the S3InputMode . In Pipe mode, Amazon SageMaker streams
  /// input data from the source directly to your container without using the
  /// EBS volume.
  pub s3_compression_type: ProcessingS3CompressionType? = None
}

pub enum ProcessingS3InputMode: Str {
  Pipe = "Pipe"
  File = "File"
  Unknown(value: Str)
}

/// Configuration for uploading output data to Amazon S3 from the processing
/// container.
pub struct ProcessingS3Output {
  /// A URI that identifies the Amazon S3 bucket where you want Amazon
  /// SageMaker to save the results of a processing job.
  pub s3_uri: Str? = None
  /// The local path of a directory where you want Amazon SageMaker to upload
  /// its contents to Amazon S3. LocalPath is an absolute path to a directory
  /// containing output files. This directory will be created by the platform
  /// and exist when your container's entrypoint is invoked.
  pub local_path: Str? = None
  /// Whether to upload the results of the processing job continuously or
  /// after the job completes.
  pub s3_upload_mode: ProcessingS3UploadMode? = None
}

pub enum ProcessingS3UploadMode: Str {
  Continuous = "Continuous"
  EndOfJob = "EndOfJob"
  Unknown(value: Str)
}

/// Configures conditions under which the processing job should be stopped,
/// such as how long the processing job has been running. After the
/// condition is met, the processing job is stopped.
pub struct ProcessingStoppingCondition {
  /// Specifies the maximum runtime in seconds.
  pub max_runtime_in_seconds: Int? = None
}

pub enum Processor: Str {
  Cpu = "CPU"
  Gpu = "GPU"
  Unknown(value: Str)
}

/// Identifies a model that you want to host and the resources chosen to
/// deploy for hosting it. If you are deploying multiple models, tell
/// SageMaker how to distribute traffic among the models by specifying
/// variant weights. For more information on production variants, check
/// Production variants .
pub struct ProductionVariant {
  /// The name of the production variant.
  pub variant_name: Str? = None
  /// The name of the model that you want to host. This is the name that you
  /// specified when creating the model.
  pub model_name: Str? = None
  /// Number of instances to launch initially.
  pub initial_instance_count: Int? = None
  /// The ML compute instance type.
  pub instance_type: ProductionVariantInstanceType? = None
  /// A list of instance pools for the production variant. Each instance pool
  /// specifies an instance type and its priority for provisioning. Use
  /// instance pools to configure heterogeneous endpoints that deploy models
  /// across multiple instance types.
  pub instance_pools: List[InstancePool]? = None
  /// The timeout value, in seconds, for provisioning instances for the
  /// production variant. When SageMaker encounters an insufficient capacity
  /// error while provisioning instances, it retries with the next instance
  /// pool (if configured) or waits until the timeout expires. This timeout
  /// applies only to capacity provisioning and does not include the time for
  /// model download or container startup. Valid values: 300 to 3600.
  pub variant_instance_provision_timeout_in_seconds: Int? = None
  /// Determines initial traffic distribution among all of the models that you
  /// specify in the endpoint configuration. The traffic to a production
  /// variant is determined by the ratio of the VariantWeight to the sum of
  /// all VariantWeight values across all ProductionVariants. If unspecified,
  /// it defaults to 1.0.
  pub initial_variant_weight: Float32? = None
  /// This parameter is no longer supported. Elastic Inference (EI) is no
  /// longer available. This parameter was used to specify the size of the EI
  /// instance to use for the production variant.
  pub accelerator_type: ProductionVariantAcceleratorType? = None
  /// Specifies configuration for a core dump from the model container when
  /// the process crashes.
  pub core_dump_config: ProductionVariantCoreDumpConfig? = None
  /// The serverless configuration for an endpoint. Specifies a serverless
  /// endpoint configuration instead of an instance-based endpoint
  /// configuration.
  pub serverless_config: ProductionVariantServerlessConfig? = None
  /// The size, in GB, of the ML storage volume attached to individual
  /// inference instance associated with the production variant. Currently
  /// only Amazon EBS gp2 storage volumes are supported.
  pub volume_size_in_gb: Int? = None
  /// The timeout value, in seconds, to download and extract the model that
  /// you want to host from Amazon S3 to the individual inference instance
  /// associated with this production variant.
  pub model_data_download_timeout_in_seconds: Int? = None
  /// The timeout value, in seconds, for your inference container to pass
  /// health check by SageMaker Hosting. For more information about health
  /// check, see How Your Container Should Respond to Health Check (Ping)
  /// Requests .
  pub container_startup_health_check_timeout_in_seconds: Int? = None
  /// You can use this parameter to turn on native Amazon Web Services Systems
  /// Manager (SSM) access for a production variant behind an endpoint. By
  /// default, SSM access is disabled for all production variants behind an
  /// endpoint. You can turn on or turn off SSM access for a production
  /// variant behind an existing endpoint by creating a new endpoint
  /// configuration and calling UpdateEndpoint .
  pub enable_ssm_access: Bool? = None
  /// Settings that control the range in the number of instances that the
  /// endpoint provisions as it scales up or down to accommodate traffic.
  pub managed_instance_scaling: ProductionVariantManagedInstanceScaling? = None
  /// Settings that control how the endpoint routes incoming traffic to the
  /// instances that the endpoint hosts.
  pub routing_config: ProductionVariantRoutingConfig? = None
  /// Specifies an option from a collection of preconfigured Amazon Machine
  /// Image (AMI) images. Each image is configured by Amazon Web Services with
  /// a set of software and driver versions. Amazon Web Services optimizes
  /// these configurations for different machine learning workloads. By
  /// selecting an AMI version, you can ensure that your inference environment
  /// is compatible with specific software requirements, such as CUDA driver
  /// versions, Linux kernel versions, or Amazon Web Services Neuron driver
  /// versions. The AMI version names, and their configurations, are the
  /// following: al2-ami-sagemaker-inference-gpu-2 Accelerator: GPU NVIDIA
  /// driver version: 535 CUDA version: 12.2
  /// al2-ami-sagemaker-inference-gpu-2-1 Accelerator: GPU NVIDIA driver
  /// version: 535 CUDA version: 12.2 NVIDIA Container Toolkit with disabled
  /// CUDA-compat mounting al2-ami-sagemaker-inference-gpu-3-1 Accelerator:
  /// GPU NVIDIA driver version: 550 CUDA version: 12.4 NVIDIA Container
  /// Toolkit with disabled CUDA-compat mounting
  /// al2023-ami-sagemaker-inference-gpu-4-1 Accelerator: GPU NVIDIA driver
  /// version: 580 CUDA version: 13.0 NVIDIA Container Toolkit with disabled
  /// CUDA-compat mounting al2-ami-sagemaker-inference-neuron-2 Accelerator:
  /// Inferentia2 and Trainium Neuron driver version: 2.19
  pub inference_ami_version: ProductionVariantInferenceAmiVersion? = None
  /// Settings for the capacity reservation for the compute instances that
  /// SageMaker AI reserves for an endpoint.
  pub capacity_reservation_config: ProductionVariantCapacityReservationConfig? = None
  /// The accelerator partition layout for the accelerators backing this
  /// production variant. A layout lists the partition profiles to carve on
  /// the accelerators it applies to; on NVIDIA GPUs these are Multi-Instance
  /// GPU (MIG) profiles such as mig-3g.40gb . Specify a single layout:
  /// SageMaker applies it uniformly to every accelerator on the variant's
  /// instance type, and you place one inference component on each partition.
  /// Omit this field to use whole, unpartitioned accelerators.
  pub accelerator_partition_layouts: List[AcceleratorPartitionLayout]? = None
}

pub enum ProductionVariantAcceleratorType: Str {
  MlEia1Medium = "ml.eia1.medium"
  MlEia1Large = "ml.eia1.large"
  MlEia1Xlarge = "ml.eia1.xlarge"
  MlEia2Medium = "ml.eia2.medium"
  MlEia2Large = "ml.eia2.large"
  MlEia2Xlarge = "ml.eia2.xlarge"
  Unknown(value: Str)
}

/// Settings for the capacity reservation for the compute instances that
/// SageMaker AI reserves for an endpoint.
pub struct ProductionVariantCapacityReservationConfig {
  /// Options that you can choose for the capacity reservation. SageMaker AI
  /// supports the following options: capacity-reservations-only SageMaker AI
  /// launches instances only into an ML capacity reservation. If no capacity
  /// is available, the instances fail to launch.
  pub capacity_reservation_preference: CapacityReservationPreference? = None
  /// The Amazon Resource Name (ARN) that uniquely identifies the ML capacity
  /// reservation that SageMaker AI applies when it deploys the endpoint.
  pub ml_reservation_arn: Str? = None
}

/// Details about an ML capacity reservation.
pub struct ProductionVariantCapacityReservationSummary {
  /// The Amazon Resource Name (ARN) that uniquely identifies the ML capacity
  /// reservation that SageMaker AI applies when it deploys the endpoint.
  pub ml_reservation_arn: Str? = None
  /// The option that you chose for the capacity reservation. SageMaker AI
  /// supports the following options: capacity-reservations-only SageMaker AI
  /// launches instances only into an ML capacity reservation. If no capacity
  /// is available, the instances fail to launch.
  pub capacity_reservation_preference: CapacityReservationPreference? = None
  /// The number of instances that you allocated to the ML capacity
  /// reservation.
  pub total_instance_count: Int? = None
  /// The number of instances that are currently available in the ML capacity
  /// reservation.
  pub available_instance_count: Int? = None
  /// The number of instances from the ML capacity reservation that are being
  /// used by the endpoint.
  pub used_by_current_endpoint: Int? = None
  /// The EC2 capacity reservations that are shared to this ML capacity
  /// reservation, if any.
  pub ec2_capacity_reservations: List[Ec2CapacityReservation]? = None
}

/// Specifies configuration for a core dump from the model container when
/// the process crashes.
pub struct ProductionVariantCoreDumpConfig {
  /// The Amazon S3 bucket to send the core dump to.
  pub destination_s3_uri: Str? = None
  /// The Amazon Web Services Key Management Service (Amazon Web Services KMS)
  /// key that SageMaker uses to encrypt the core dump data at rest using
  /// Amazon S3 server-side encryption. The KmsKeyId can be any of the
  /// following formats: // KMS Key ID "1234abcd-12ab-34cd-56ef-1234567890ab"
  /// // Amazon Resource Name (ARN) of a KMS Key
  /// "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
  /// // KMS Key Alias "alias/ExampleAlias" // Amazon Resource Name (ARN) of a
  /// KMS Key Alias "arn:aws:kms:us-west-2:111122223333:alias/ExampleAlias" If
  /// you use a KMS key ID or an alias of your KMS key, the SageMaker
  /// execution role must include permissions to call kms:Encrypt . If you
  /// don't provide a KMS key ID, SageMaker uses the default KMS key for
  /// Amazon S3 for your role's account. SageMaker uses server-side encryption
  /// with KMS-managed keys for OutputDataConfig . If you use a bucket policy
  /// with an s3:PutObject permission that only allows objects with
  /// server-side encryption, set the condition key of
  /// s3:x-amz-server-side-encryption to "aws:kms" . For more information, see
  /// KMS-Managed Encryption Keys in the Amazon Simple Storage Service
  /// Developer Guide. The KMS key policy must grant permission to the IAM
  /// role that you specify in your CreateEndpoint and UpdateEndpoint
  /// requests. For more information, see Using Key Policies in Amazon Web
  /// Services KMS in the Amazon Web Services Key Management Service Developer
  /// Guide .
  pub kms_key_id: Str? = None
}

