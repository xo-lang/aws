}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: DownloadDBLogFilePortionPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: DownloadDBLogFilePortionPaginator) next_page() -> DownloadDBLogFilePortionDetails ! DownloadDBLogFilePortionErr uses (net.dial, clock, rand) {
  let prev = p.input.marker
  let out = p.client.download_db_log_file_portion(p.input)?
  p.first = false
  var next: Str? = None
  next = out.marker
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.marker = next
  Ok(out)
}
