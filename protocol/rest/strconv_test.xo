// go_parse_bool, go_parse_int and go_parse_float against Go's strconv
// (strconvvectors_test.xo): every value, and every error's text.

/// Go's %016x of a float64's bits.
fn bits_hex(x: Float) -> Str {
  let b = x.to_bits()
  let hi = (b >> 60) & 0xf
  "${hi.to_str_base(16)}${(b & ((1 << 60) - 1)).to_str_width(15, base: 16, zero: true)}"
}

test "ParseBool, ParseInt and ParseFloat values and errors are Go's" {
  var out: List[Str] = []
  for s in STRCONV_BOOLS {
    out.push(match go_parse_bool(s) {
      Ok(v) => "bool ${go_quote(s)} = ${v}"
      Err(e) => "bool ${go_quote(s)} err ${e}"
    })
  }
  for bits in [8, 16, 32, 64] {
    for s in STRCONV_INTS {
      out.push(match go_parse_int(s, bits) {
        Ok(v) => "int${bits} ${go_quote(s)} = ${v}"
        Err(e) => "int${bits} ${go_quote(s)} err ${e}"
      })
    }
  }
  for bits in [32, 64] {
    for s in STRCONV_FLOATS {
      out.push(match go_parse_float(s, bits) {
        Ok(v) => "float${bits} ${go_quote(s)} = ${bits_hex(v)}"
        Err(e) => "float${bits} ${go_quote(s)} err ${e}"
      })
    }
  }
  for (i, l) in out.indexed() {
    expect("${i} ${l}") == "${i} ${STRCONV_GO.get(i) ?? ""}"
  }
  expect(out.len()) == STRCONV_GO.len()
}
