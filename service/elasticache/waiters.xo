  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

fn jmes_of_node_group_list(v: List[NodeGroup]) -> json.Value {
  json.Value.List(v.map(fn(x: NodeGroup) -> json.Value { jmes_of_node_group(x) }))
}

fn jmes_of_node_group(v: NodeGroup) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.node_group_id {
    fs.push(("NodeGroupId", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x)))
  }
  if let Some(x) = v.primary_endpoint {
    fs.push(("PrimaryEndpoint", jmes_of_endpoint(x)))
  }
  if let Some(x) = v.reader_endpoint {
    fs.push(("ReaderEndpoint", jmes_of_endpoint(x)))
  }
  if let Some(x) = v.slots {
    fs.push(("Slots", json.Value.Str(x)))
  }
  if let Some(x) = v.node_group_members {
    fs.push(("NodeGroupMembers", jmes_of_node_group_member_list(x)))
  }
  json.Value.Object(fs)
}

fn jmes_of_node_group_member_list(v: List[NodeGroupMember]) -> json.Value {
  json.Value.List(v.map(fn(x: NodeGroupMember) -> json.Value { jmes_of_node_group_member(x) }))
}

fn jmes_of_node_group_member(v: NodeGroupMember) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.cache_cluster_id {
    fs.push(("CacheClusterId", json.Value.Str(x)))
  }
  if let Some(x) = v.cache_node_id {
    fs.push(("CacheNodeId", json.Value.Str(x)))
  }
  if let Some(x) = v.read_endpoint {
    fs.push(("ReadEndpoint", jmes_of_endpoint(x)))
  }
  if let Some(x) = v.preferred_availability_zone {
    fs.push(("PreferredAvailabilityZone", json.Value.Str(x)))
  }
  if let Some(x) = v.preferred_outpost_arn {
    fs.push(("PreferredOutpostArn", json.Value.Str(x)))
  }
  if let Some(x) = v.current_role {
    fs.push(("CurrentRole", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn jmes_of_replication_group_outpost_arn_list(v: List[Str]) -> json.Value {
  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

/// Wait until ElastiCache cluster is available.
///
/// Calls DescribeCacheClusters until the CacheClusterAvailable acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (15s) to `max_delay` (120s).
pub fn wait_until_cache_cluster_available(c: Client, input: DescribeCacheClustersMessage, max_wait: Duration, min_delay: Duration = 15s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeCacheClustersErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_cache_clusters(input) {
      Ok(out) => {
        let o = jmes_of_cache_cluster_message(out)
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "allStringEquals", "available") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "deleted") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "deleting") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "incompatible-network") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "restore-failed") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("CacheClusterAvailable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until ElastiCache cluster is deleted.
///
/// Calls DescribeCacheClusters until the CacheClusterDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (15s) to `max_delay` (120s).
pub fn wait_until_cache_cluster_deleted(c: Client, input: DescribeCacheClustersMessage, max_wait: Duration, min_delay: Duration = 15s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeCacheClustersErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_cache_clusters(input) {
      Ok(out) => {
        let o = jmes_of_cache_cluster_message(out)
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "allStringEquals", "deleted") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "available") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "creating") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "incompatible-network") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "modifying") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "restore-failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "CacheClusters[].CacheClusterStatus", "anyStringEquals", "snapshotting") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_cache_clusters(e)
        if state == "" && waiter.error_is(names, "CacheClusterNotFound") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("CacheClusterDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

