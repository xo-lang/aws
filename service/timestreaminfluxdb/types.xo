/// All the customer-modifiable InfluxDB v2 parameters in Timestream for
/// InfluxDB.
pub struct InfluxDBv2Parameters {
  /// Include option to show detailed logs for Flux queries. Default: false
  pub flux_log_enabled: Bool? = None
  /// Log output level. InfluxDB outputs log entries with severity levels
  /// greater than or equal to the level specified. Default: info
  pub log_level: LogLevel? = None
  /// Disable the task scheduler. If problematic tasks prevent InfluxDB from
  /// starting, use this option to start InfluxDB without scheduling or
  /// executing tasks. Default: false
  pub no_tasks: Bool? = None
  /// Number of queries allowed to execute concurrently. Setting to 0 allows
  /// an unlimited number of concurrent queries. Default: 0
  pub query_concurrency: Int? = None
  /// Maximum number of queries allowed in execution queue. When queue limit
  /// is reached, new queries are rejected. Setting to 0 allows an unlimited
  /// number of queries in the queue. Default: 0
  pub query_queue_size: Int? = None
  /// Enable tracing in InfluxDB and specifies the tracing type. Tracing is
  /// disabled by default.
  pub tracing_type: TracingType? = None
  /// Disable the HTTP /metrics endpoint which exposes internal InfluxDB
  /// metrics . Default: false
  pub metrics_disabled: Bool? = None
  /// Maximum duration the server should keep established connections alive
  /// while waiting for new requests. Set to 0 for no timeout. Default: 3
  /// minutes
  pub http_idle_timeout: DurationShape? = None
  /// Maximum duration the server should try to read HTTP headers for new
  /// requests. Set to 0 for no timeout. Default: 10 seconds
  pub http_read_header_timeout: DurationShape? = None
  /// Maximum duration the server should try to read the entirety of new
  /// requests. Set to 0 for no timeout. Default: 0
  pub http_read_timeout: DurationShape? = None
  /// Maximum duration the server should spend processing and responding to
  /// write requests. Set to 0 for no timeout. Default: 0
  pub http_write_timeout: DurationShape? = None
  /// Maximum number of group by time buckets a SELECT statement can create. 0
  /// allows an unlimited number of buckets. Default: 0
  pub influxql_max_select_buckets: Int? = None
  /// Maximum number of points a SELECT statement can process. 0 allows an
  /// unlimited number of points. InfluxDB checks the point count every second
  /// (so queries exceeding the maximum aren’t immediately aborted).
  /// Default: 0
  pub influxql_max_select_point: Int? = None
  /// Maximum number of series a SELECT statement can return. 0 allows an
  /// unlimited number of series. Default: 0
  pub influxql_max_select_series: Int? = None
  /// Disable the /debug/pprof HTTP endpoint. This endpoint provides runtime
  /// profiling data and can be helpful when debugging. Default: true
  pub pprof_disabled: Bool? = None
  /// Initial bytes of memory allocated for a query. Default: 0
  pub query_initial_memory_bytes: Int? = None
  /// Maximum total bytes of memory allowed for all running queries. When this
  /// limit is reached, new queries are rejected. Setting to 0 allows
  /// unlimited memory usage. Default: 0
  pub query_max_memory_bytes: Int? = None
  /// Maximum bytes of memory allowed for a single query. Must be greater or
  /// equal to queryInitialMemoryBytes. Default: 0
  pub query_memory_bytes: Int? = None
  /// Specifies the Time to Live (TTL) in minutes for newly created user
  /// sessions. Default: 60
  pub session_length: Int? = None
  /// Disables automatically extending a user’s session TTL on each request.
  /// By default, every request sets the session’s expiration time to five
  /// minutes from now. When disabled, sessions expire after the specified
  /// session length and the user is redirected to the login page, even if
  /// recently active. Default: false
  pub session_renew_disabled: Bool? = None
  /// Maximum size (in bytes) a shard’s cache can reach before it starts
  /// rejecting writes. Must be greater than storageCacheSnapShotMemorySize
  /// and lower than instance’s total memory capacity. We recommend setting
  /// it to below 15% of the total memory capacity. Default: 1073741824
  pub storage_cache_max_memory_size: Int? = None
  /// Size (in bytes) at which the storage engine will snapshot the cache and
  /// write it to a TSM file to make more memory available. Must not be
  /// greater than storageCacheMaxMemorySize. Default: 26214400
  pub storage_cache_snapshot_memory_size: Int? = None
  /// Duration at which the storage engine will snapshot the cache and write
  /// it to a new TSM file if the shard hasn’t received writes or deletes.
  /// Default: 10 minutes
  pub storage_cache_snapshot_write_cold_duration: DurationShape? = None
  /// Duration at which the storage engine will compact all TSM files in a
  /// shard if it hasn't received writes or deletes. Default: 4 hours
  pub storage_compact_full_write_cold_duration: DurationShape? = None
  /// Rate limit (in bytes per second) that TSM compactions can write to disk.
  /// Default: 50331648
  pub storage_compact_throughput_burst: Int? = None
  /// Maximum number of full and level compactions that can run concurrently.
  /// A value of 0 results in 50% of runtime.GOMAXPROCS(0) used at runtime.
  /// Any number greater than zero limits compactions to that value. This
  /// setting does not apply to cache snapshotting. Default: 0
  pub storage_max_concurrent_compactions: Int? = None
  /// Size (in bytes) at which an index write-ahead log (WAL) file will
  /// compact into an index file. Lower sizes will cause log files to be
  /// compacted more quickly and result in lower heap usage at the expense of
  /// write throughput. Default: 1048576
  pub storage_max_index_log_file_size: Int? = None
  /// Skip field size validation on incoming write requests. Default: false
  pub storage_no_validate_field_size: Bool? = None
  /// Interval of retention policy enforcement checks. Must be greater than 0.
  /// Default: 30 minutes
  pub storage_retention_check_interval: DurationShape? = None
  /// Maximum number of snapshot compactions that can run concurrently across
  /// all series partitions in a database. Default: 0
  pub storage_series_file_max_concurrent_snapshot_compactions: Int? = None
  /// Size of the internal cache used in the TSI index to store previously
  /// calculated series results. Cached results are returned quickly rather
  /// than needing to be recalculated when a subsequent query with the same
  /// tag key/value predicate is executed. Setting this value to 0 will
  /// disable the cache and may decrease query performance. Default: 100
  pub storage_series_id_set_cache_size: Int? = None
  /// Maximum number writes to the WAL directory to attempt at the same time.
  /// Setting this value to 0 results in number of processing units available
  /// x2. Default: 0
  pub storage_wal_max_concurrent_writes: Int? = None
  /// Maximum amount of time a write request to the WAL directory will wait
  /// when the maximum number of concurrent active writes to the WAL directory
  /// has been met . Set to 0 to disable the timeout. Default: 10 minutes
  pub storage_wal_max_write_delay: DurationShape? = None
