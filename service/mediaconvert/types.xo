pub enum H264ScanTypeConversionMode: Str {
  Interlaced = "INTERLACED"
  InterlacedOptimize = "INTERLACED_OPTIMIZE"
  Unknown(value: Str)
}

/// Enable this setting to insert I-frames at scene changes that the service
