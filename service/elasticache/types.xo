  /// (cluster mode enabled) replication groups. Default: false
  pub automatic_failover_enabled: Bool? = None
  /// A flag indicating if you have Multi-AZ enabled to enhance fault
  /// tolerance. For more information, see Minimizing Downtime: Multi-AZ .
  pub multi_az_enabled: Bool? = None
  /// The number of clusters this replication group initially has. This
  /// parameter is not used if there is more than one node group (shard). You
