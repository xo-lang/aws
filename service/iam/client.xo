fn xml_write_policy(var w: xmlv.Writer, v: Policy, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.policy_name {
    xmlv.elem(w, "PolicyName", x, [])
  }
  if let Some(x) = v.policy_id {
    xmlv.elem(w, "PolicyId", x, [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "Arn", x, [])
  }
  if let Some(x) = v.path {
    xmlv.elem(w, "Path", x, [])
  }
  if let Some(x) = v.default_version_id {
    xmlv.elem(w, "DefaultVersionId", x, [])
  }
  if let Some(x) = v.attachment_count {
    xmlv.elem(w, "AttachmentCount", "${x}", [])
  }
  if let Some(x) = v.permissions_boundary_usage_count {
    xmlv.elem(w, "PermissionsBoundaryUsageCount", "${x}", [])
  }
  if let Some(x) = v.is_attachable {
    xmlv.elem(w, "IsAttachable", "${x}", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.create_date {
    xmlv.elem(w, "CreateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.update_date {
    xmlv.elem(w, "UpdateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list_type(w, x, "Tags", [])
  }
  xmlv.end(w, name)
}

fn xml_read_policy(e: xml.Element) -> Policy ! Str {
  var out = Policy{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "PolicyName" => out.policy_name = c.text()
      "PolicyId" => out.policy_id = c.text()
      "Arn" => out.arn = c.text()
      "Path" => out.path = c.text()
      "DefaultVersionId" => out.default_version_id = c.text()
      "AttachmentCount" => out.attachment_count = xmlv.read_int(c.text())?
      "PermissionsBoundaryUsageCount" => out.permissions_boundary_usage_count = xmlv.read_int(c.text())?
      "IsAttachable" => out.is_attachable = xmlv.read_bool(c.text())?
      "Description" => out.description = c.text()
      "CreateDate" => out.create_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UpdateDate" => out.update_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Tags" => out.tags = xml_read_tag_list_type(c)?
      _ => {}
    }
  }
  Ok(out)
}

