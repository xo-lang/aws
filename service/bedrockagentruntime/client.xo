  }
  if let Some(x) = v.prompt_state {
    fs.push(("promptState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.base_prompt_template {
    fs.push(("basePromptTemplate", json.Value.Str(x)))
  }
  if let Some(x) = v.inference_configuration {
    fs.push(("inferenceConfiguration", json_of_inference_configuration(x)))
  }
  if let Some(x) = v.parser_mode {
    fs.push(("parserMode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.foundation_model {
    fs.push(("foundationModel", json.Value.Str(x)))
  }
  if let Some(x) = v.additional_model_request_fields {
    fs.push(("additionalModelRequestFields", x))
  }
  json.Value.Object(fs)
}

fn from_json_prompt_configuration(v: json.Value) -> PromptConfiguration ! Str {
  var out = PromptConfiguration{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "promptType" => out.prompt_type = PromptType.from(jsonv.read_str(fv)?)
      "promptCreationMode" => out.prompt_creation_mode = CreationMode.from(jsonv.read_str(fv)?)
      "promptState" => out.prompt_state = PromptState.from(jsonv.read_str(fv)?)
      "basePromptTemplate" => out.base_prompt_template = jsonv.read_str(fv)?
      "inferenceConfiguration" => out.inference_configuration = from_json_inference_configuration(fv)?
      "parserMode" => out.parser_mode = CreationMode.from(jsonv.read_str(fv)?)
      "foundationModel" => out.foundation_model = jsonv.read_str(fv)?
      "additionalModelRequestFields" => out.additional_model_request_fields = fv
      _ => {}
    }
  }
  Ok(out)
}

