}

/// Describes the instance type.
pub struct InstanceTypeInfo {
  /// The instance type. For more information, see Instance types in the
  /// Amazon EC2 User Guide .
  pub instance_type: InstanceType? = None
  /// Indicates whether the instance type is current generation.
  pub current_generation: Bool? = None
  /// Indicates whether the instance type is eligible for the free tier.
  pub free_tier_eligible: Bool? = None
  /// Indicates whether the instance type is offered for spot, On-Demand, or
  /// Capacity Blocks.
  pub supported_usage_classes: List[UsageClassType]? = None
  /// The supported root device types.
  pub supported_root_device_types: List[RootDeviceType]? = None
  /// The supported virtualization types.
  pub supported_virtualization_types: List[VirtualizationType]? = None
  /// Indicates whether the instance is a bare metal instance type.
  pub bare_metal: Bool? = None
  /// The hypervisor for the instance type.
  pub hypervisor: InstanceTypeHypervisor? = None
  /// Describes the processor.
  pub processor_info: ProcessorInfo? = None
  /// Describes the vCPU configurations for the instance type.
  pub v_cpu_info: VCpuInfo? = None
  /// Describes the memory for the instance type.
  pub memory_info: MemoryInfo? = None
  /// Indicates whether instance storage is supported.
  pub instance_storage_supported: Bool? = None
  /// Describes the instance storage for the instance type.
  pub instance_storage_info: InstanceStorageInfo? = None
  /// Describes the Amazon EBS settings for the instance type.
  pub ebs_info: EbsInfo? = None
  /// Describes the network settings for the instance type.
  pub network_info: NetworkInfo? = None
  /// Describes the GPU accelerator settings for the instance type.
  pub gpu_info: GpuInfo? = None
  /// Describes the FPGA accelerator settings for the instance type.
  pub fpga_info: FpgaInfo? = None
  /// Describes the placement group settings for the instance type.
  pub placement_group_info: PlacementGroupInfo? = None
  /// Describes the Inference accelerator settings for the instance type.
  pub inference_accelerator_info: InferenceAcceleratorInfo? = None
  /// Indicates whether On-Demand hibernation is supported.
  pub hibernation_supported: Bool? = None
  /// Indicates whether the instance type is a burstable performance T
  /// instance type. For more information, see Burstable performance instances
  /// .
  pub burstable_performance_supported: Bool? = None
  /// Indicates whether Dedicated Hosts are supported on the instance type.
  pub dedicated_hosts_supported: Bool? = None
  /// Indicates whether Amazon CloudWatch action based recovery is supported.
  pub auto_recovery_supported: Bool? = None
  /// The supported boot modes. For more information, see Boot modes in the
  /// Amazon EC2 User Guide .
  pub supported_boot_modes: List[BootModeType]? = None
  /// Indicates whether Nitro Enclaves is supported.
  pub nitro_enclaves_support: NitroEnclavesSupport? = None
  /// Indicates whether NitroTPM is supported.
  pub nitro_tpm_support: NitroTpmSupport? = None
  /// Describes the supported NitroTPM versions for the instance type.
  pub nitro_tpm_info: NitroTpmInfo? = None
  /// Describes the media accelerator settings for the instance type.
  pub media_accelerator_info: MediaAcceleratorInfo? = None
  /// Describes the Neuron accelerator settings for the instance type.
  pub neuron_info: NeuronInfo? = None
  /// Indicates whether a local Precision Time Protocol (PTP) hardware clock
  /// (PHC) is supported.
  pub phc_support: PhcSupport? = None
  /// Indicates whether reboot migration during a user-initiated reboot is
  /// supported for instances that have a scheduled system-reboot event. For
  /// more information, see Enable or disable reboot migration in the Amazon
  /// EC2 User Guide .
  pub reboot_migration_support: RebootMigrationSupport? = None
  /// Indicates whether the instance type is supported in the current Region.
  pub supported_in_region: Bool? = None
}