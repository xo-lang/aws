fn xml_read_run_instances_request(e: xml.Element) -> RunInstancesRequest ! Str {
  var out = RunInstancesRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "BlockDeviceMapping" => out.block_device_mappings = xml_read_block_device_mapping_request_list(c)?
      "ImageId" => out.image_id = c.text()
      "InstanceType" => out.instance_type = InstanceType.from(c.text())
      "Ipv6AddressCount" => out.ipv6_address_count = xmlv.read_int(c.text())?
      "Ipv6Address" => out.ipv6_addresses = xml_read_instance_ipv6_address_list(c)?
      "KernelId" => out.kernel_id = c.text()
      "KeyName" => out.key_name = c.text()
      "MaxCount" => out.max_count = xmlv.read_int(c.text())?
      "MinCount" => out.min_count = xmlv.read_int(c.text())?
      "Monitoring" => out.monitoring = xml_read_run_instances_monitoring_enabled(c)?
      "Placement" => out.placement = xml_read_placement(c)?
      "RamdiskId" => out.ramdisk_id = c.text()
      "SecurityGroupId" => out.security_group_ids = xml_read_security_group_id_string_list(c)?
      "SecurityGroup" => out.security_groups = xml_read_security_group_string_list(c)?
      "SubnetId" => out.subnet_id = c.text()
      "UserData" => out.user_data = c.text()
      "ElasticGpuSpecification" => out.elastic_gpu_specification = xml_read_elastic_gpu_specifications(c)?
      "ElasticInferenceAccelerator" => out.elastic_inference_accelerators = xml_read_elastic_inference_accelerators(c)?
      "TagSpecification" => out.tag_specifications = xml_read_tag_specification_list(c)?
      "LaunchTemplate" => out.launch_template = xml_read_launch_template_specification(c)?
      "InstanceMarketOptions" => out.instance_market_options = xml_read_instance_market_options_request(c)?
      "CreditSpecification" => out.credit_specification = xml_read_credit_specification_request(c)?
      "CpuOptions" => out.cpu_options = xml_read_cpu_options_request(c)?
      "CapacityReservationSpecification" => out.capacity_reservation_specification = xml_read_capacity_reservation_specification(c)?
      "HibernationOptions" => out.hibernation_options = xml_read_hibernation_options_request(c)?
      "LicenseSpecification" => out.license_specifications = xml_read_license_specification_list_request(c)?
      "MetadataOptions" => out.metadata_options = xml_read_instance_metadata_options_request(c)?
      "EnclaveOptions" => out.enclave_options = xml_read_enclave_options_request(c)?
      "PrivateDnsNameOptions" => out.private_dns_name_options = xml_read_private_dns_name_options_request(c)?
      "MaintenanceOptions" => out.maintenance_options = xml_read_instance_maintenance_options_request(c)?
      "DisableApiStop" => out.disable_api_stop = xmlv.read_bool(c.text())?
      "EnablePrimaryIpv6" => out.enable_primary_ipv6 = xmlv.read_bool(c.text())?
      "NetworkPerformanceOptions" => out.network_performance_options = xml_read_instance_network_performance_options_request(c)?
      "Operator" => out.operator = xml_read_operator_request(c)?
      "SecondaryInterface" => out.secondary_interfaces = xml_read_instance_secondary_interface_specification_list_request(c)?
      "dryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "disableApiTermination" => out.disable_api_termination = xmlv.read_bool(c.text())?
      "instanceInitiatedShutdownBehavior" => out.instance_initiated_shutdown_behavior = ShutdownBehavior.from(c.text())
      "privateIpAddress" => out.private_ip_address = c.text()
      "clientToken" => out.client_token = c.text()
      "additionalInfo" => out.additional_info = c.text()
      "networkInterface" => out.network_interfaces = xml_read_instance_network_interface_specification_list(c)?
      "iamInstanceProfile" => out.iam_instance_profile = xml_read_iam_instance_profile_specification(c)?
      "ebsOptimized" => out.ebs_optimized = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

