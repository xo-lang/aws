  pub wal_replay_concurrency_limit: Int? = None
  /// Specifies the maximum number of entries in the table index cache.
  /// Default: 1000
  pub table_index_cache_max_entries: Int? = None
  /// Limits the concurrency level for table index cache operations. Default:
  /// 8
  pub table_index_cache_concurrency_limit: Int? = None
  /// Specifies how far back to look when creating generation 1 Parquet files.
  /// Default: 24h
  pub gen1_lookback_duration: DurationShape? = None
  /// The interval at which retention policies are checked and enforced. Enter
  /// as a human-readable time–for example: 30m or 1h. Default: 30m
  pub retention_check_interval: DurationShape? = None
  /// Specifies the grace period before permanently deleting data. Default:
  /// 24h
  pub delete_grace_period: DurationShape? = None
  /// Sets the default duration for hard deletion of data. Default: 90d
  pub hard_delete_default_duration: DurationShape? = None
  /// Specifies the URL of the repository that InfluxDB downloads plugins
