fn xml_read_describe_type_output(e: xml.Element) -> DescribeTypeOutput ! Str {
  var out = DescribeTypeOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Arn" => out.arn = c.text()
      "Type" => out.type_value = RegistryType.from(c.text())
      "TypeName" => out.type_name = c.text()
      "DefaultVersionId" => out.default_version_id = c.text()
      "IsDefaultVersion" => out.is_default_version = xmlv.read_bool(c.text())?
      "TypeTestsStatus" => out.type_tests_status = TypeTestsStatus.from(c.text())
      "TypeTestsStatusDescription" => out.type_tests_status_description = c.text()
      "Description" => out.description = c.text()
      "Schema" => out.schema = c.text()
      "ProvisioningType" => out.provisioning_type = ProvisioningType.from(c.text())
      "DeprecatedStatus" => out.deprecated_status = DeprecatedStatus.from(c.text())
      "LoggingConfig" => out.logging_config = xml_read_logging_config(c)?
      "RequiredActivatedTypes" => out.required_activated_types = xml_read_required_activated_types(c)?
      "ExecutionRoleArn" => out.execution_role_arn = c.text()
      "Visibility" => out.visibility = Visibility.from(c.text())
      "SourceUrl" => out.source_url = c.text()
      "DocumentationUrl" => out.documentation_url = c.text()
      "LastUpdated" => out.last_updated = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "TimeCreated" => out.time_created = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ConfigurationSchema" => out.configuration_schema = c.text()
      "PublisherId" => out.publisher_id = c.text()
      "OriginalTypeName" => out.original_type_name = c.text()
      "OriginalTypeArn" => out.original_type_arn = c.text()
      "PublicVersionNumber" => out.public_version_number = c.text()
      "LatestPublicVersion" => out.latest_public_version = c.text()
      "IsActivated" => out.is_activated = xmlv.read_bool(c.text())?
      "AutoUpdate" => out.auto_update = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

