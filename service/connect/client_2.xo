  var out = Evaluation{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "EvaluationId" => out.evaluation_id = jsonv.read_str(fv)?
      "EvaluationArn" => out.evaluation_arn = jsonv.read_str(fv)?
      "Metadata" => out.metadata = from_json_evaluation_metadata(fv)?
