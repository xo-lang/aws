    xmlv.elem(w, "UefiData", x, [])
  }
  if let Some(x) = v.imds_support {
    xmlv.elem(w, "ImdsSupport", x.value(), [])
  }
  if let Some(x) = v.tag_specifications {
    xml_write_tag_specification_list(w, x, "TagSpecification", [])
  }
  if let Some(x) = v.dry_run {
    xmlv.elem(w, "dryRun", "${x}", [])
  }
  if let Some(x) = v.name {
    xmlv.elem(w, "name", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "description", x, [])
  }
  if let Some(x) = v.architecture {
    xmlv.elem(w, "architecture", x.value(), [])
  }
  if let Some(x) = v.kernel_id {
    xmlv.elem(w, "kernelId", x, [])
  }
  if let Some(x) = v.ramdisk_id {
    xmlv.elem(w, "ramdiskId", x, [])
  }
  if let Some(x) = v.root_device_name {
    xmlv.elem(w, "rootDeviceName", x, [])
  }
  if let Some(x) = v.block_device_mappings {
    xml_write_block_device_mapping_request_list(w, x, "BlockDeviceMapping", [])
  }
  if let Some(x) = v.virtualization_type {
    xmlv.elem(w, "virtualizationType", x, [])
  }
  if let Some(x) = v.sriov_net_support {
    xmlv.elem(w, "sriovNetSupport", x, [])
  }
  if let Some(x) = v.ena_support {
    xmlv.elem(w, "enaSupport", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_register_image_request(e: xml.Element) -> RegisterImageRequest ! Str {
  var out = RegisterImageRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ImageLocation" => out.image_location = c.text()
      "BillingProduct" => out.billing_products = xml_read_billing_product_list(c)?
      "BootMode" => out.boot_mode = BootModeValues.from(c.text())
      "TpmSupport" => out.tpm_support = TpmSupportValues.from(c.text())
      "UefiData" => out.uefi_data = c.text()
      "ImdsSupport" => out.imds_support = ImdsSupportValues.from(c.text())
      "TagSpecification" => out.tag_specifications = xml_read_tag_specification_list(c)?
      "dryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "name" => out.name = c.text()
      "description" => out.description = c.text()
      "architecture" => out.architecture = ArchitectureValues.from(c.text())
      "kernelId" => out.kernel_id = c.text()
      "ramdiskId" => out.ramdisk_id = c.text()
      "rootDeviceName" => out.root_device_name = c.text()
      "BlockDeviceMapping" => out.block_device_mappings = xml_read_block_device_mapping_request_list(c)?
      "virtualizationType" => out.virtualization_type = c.text()
      "sriovNetSupport" => out.sriov_net_support = c.text()
      "enaSupport" => out.ena_support = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

