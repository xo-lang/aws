fn json_of_document_attribute_boosting_configuration(v: DocumentAttributeBoostingConfiguration) -> json.Value {
  match v {
    NumberConfiguration(x) => json.Value.Object([("numberConfiguration", json_of_number_attribute_boosting_configuration(x))])
    StringConfiguration(x) => json.Value.Object([("stringConfiguration", json_of_string_attribute_boosting_configuration(x))])
    DateConfiguration(x) => json.Value.Object([("dateConfiguration", json_of_date_attribute_boosting_configuration(x))])
    StringListConfiguration(x) => json.Value.Object([("stringListConfiguration", json_of_string_list_attribute_boosting_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_document_attribute_boosting_configuration(v: json.Value) -> DocumentAttributeBoostingConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "numberConfiguration" => Ok(DocumentAttributeBoostingConfiguration.NumberConfiguration(from_json_number_attribute_boosting_configuration(fv)?))
      "stringConfiguration" => Ok(DocumentAttributeBoostingConfiguration.StringConfiguration(from_json_string_attribute_boosting_configuration(fv)?))
      "dateConfiguration" => Ok(DocumentAttributeBoostingConfiguration.DateConfiguration(from_json_date_attribute_boosting_configuration(fv)?))
      "stringListConfiguration" => Ok(DocumentAttributeBoostingConfiguration.StringListConfiguration(from_json_string_list_attribute_boosting_configuration(fv)?))
      _ => Ok(DocumentAttributeBoostingConfiguration.Unknown(k))
    }
  }
  Err("DocumentAttributeBoostingConfiguration: no member set")
}

