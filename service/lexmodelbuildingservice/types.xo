  /// True if a new version of the intent was created. If the createVersion
  /// field was not specified in the request, the createVersion field is set
  /// to false in the response.
  pub create_version: Bool? = None
  /// Configuration information, if any, required to connect to an Amazon
  /// Kendra index and use the AMAZON.KendraSearchIntent intent.
