    fs.push(("RoutingProfileId", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.media_concurrencies {
    fs.push(("MediaConcurrencies", json_of_media_concurrencies(x)))
  }
  if let Some(x) = v.default_outbound_queue_id {
    fs.push(("DefaultOutboundQueueId", json.Value.Str(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_map(x)))
  }
  if let Some(x) = v.number_of_associated_queues {
    fs.push(("NumberOfAssociatedQueues", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_associated_manual_assignment_queues {
    fs.push(("NumberOfAssociatedManualAssignmentQueues", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_associated_users {
    fs.push(("NumberOfAssociatedUsers", json.Value.Int(x)))
  }
  if let Some(x) = v.agent_availability_timer {
    fs.push(("AgentAvailabilityTimer", json.Value.Str(x.value())))
  }
  if let Some(x) = v.last_modified_time {
    fs.push(("LastModifiedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_modified_region {
    fs.push(("LastModifiedRegion", json.Value.Str(x)))
  }
  if let Some(x) = v.is_default {
    fs.push(("IsDefault", json.Value.Bool(x)))
  }
  if let Some(x) = v.associated_queue_ids {
    fs.push(("AssociatedQueueIds", json_of_associated_queue_id_list(x)))
  }
  if let Some(x) = v.associated_manual_assignment_queue_ids {
    fs.push(("AssociatedManualAssignmentQueueIds", json_of_associated_queue_id_list(x)))
  }
  json.Value.Object(fs)
}

