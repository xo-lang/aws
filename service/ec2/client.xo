fn xml_read_instance_type_info(e: xml.Element) -> InstanceTypeInfo ! Str {
  var out = InstanceTypeInfo{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "instanceType" => out.instance_type = InstanceType.from(c.text())
      "currentGeneration" => out.current_generation = xmlv.read_bool(c.text())?
      "freeTierEligible" => out.free_tier_eligible = xmlv.read_bool(c.text())?
      "supportedUsageClasses" => out.supported_usage_classes = xml_read_usage_class_type_list(c)?
      "supportedRootDeviceTypes" => out.supported_root_device_types = xml_read_root_device_type_list(c)?
      "supportedVirtualizationTypes" => out.supported_virtualization_types = xml_read_virtualization_type_list(c)?
      "bareMetal" => out.bare_metal = xmlv.read_bool(c.text())?
      "hypervisor" => out.hypervisor = InstanceTypeHypervisor.from(c.text())
      "processorInfo" => out.processor_info = xml_read_processor_info(c)?
      "vCpuInfo" => out.v_cpu_info = xml_read_v_cpu_info(c)?
      "memoryInfo" => out.memory_info = xml_read_memory_info(c)?
      "instanceStorageSupported" => out.instance_storage_supported = xmlv.read_bool(c.text())?
      "instanceStorageInfo" => out.instance_storage_info = xml_read_instance_storage_info(c)?
      "ebsInfo" => out.ebs_info = xml_read_ebs_info(c)?
      "networkInfo" => out.network_info = xml_read_network_info(c)?
      "gpuInfo" => out.gpu_info = xml_read_gpu_info(c)?
      "fpgaInfo" => out.fpga_info = xml_read_fpga_info(c)?
      "placementGroupInfo" => out.placement_group_info = xml_read_placement_group_info(c)?
      "inferenceAcceleratorInfo" => out.inference_accelerator_info = xml_read_inference_accelerator_info(c)?
      "hibernationSupported" => out.hibernation_supported = xmlv.read_bool(c.text())?
      "burstablePerformanceSupported" => out.burstable_performance_supported = xmlv.read_bool(c.text())?
      "dedicatedHostsSupported" => out.dedicated_hosts_supported = xmlv.read_bool(c.text())?
      "autoRecoverySupported" => out.auto_recovery_supported = xmlv.read_bool(c.text())?
      "supportedBootModes" => out.supported_boot_modes = xml_read_boot_mode_type_list(c)?
      "nitroEnclavesSupport" => out.nitro_enclaves_support = NitroEnclavesSupport.from(c.text())
      "nitroTpmSupport" => out.nitro_tpm_support = NitroTpmSupport.from(c.text())
      "nitroTpmInfo" => out.nitro_tpm_info = xml_read_nitro_tpm_info(c)?
      "mediaAcceleratorInfo" => out.media_accelerator_info = xml_read_media_accelerator_info(c)?
      "neuronInfo" => out.neuron_info = xml_read_neuron_info(c)?
      "phcSupport" => out.phc_support = PhcSupport.from(c.text())
      "rebootMigrationSupport" => out.reboot_migration_support = RebootMigrationSupport.from(c.text())
      "supportedInRegion" => out.supported_in_region = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

