/// Stops an ongoing data sync between the source and the serverless cache.
/// The migration remains open and the data sync can be restarted. This
/// operation is valid only while the migration is syncing; during cutover
/// it returns InvalidServerlessCacheStateFault .
pub fn (c: Client) stop_migration(input: StopMigrationRequest) -> StopMigrationResponse ! StopMigrationErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_stop_migration(c.params, input)) ?? e => return Err(StopMigrationErr.InvalidInput(e))
  var req = serialize_stop_migration(ep, input, "") ?? e => return Err(StopMigrationErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(StopMigrationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_stop_migration_error(resp))
  }
  deserialize_stop_migration(resp) ?? e => Err(StopMigrationErr.Deserialize(e))
}

