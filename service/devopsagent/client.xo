fn json_of_goal_list(v: List[Goal]) -> json.Value {
  json.Value.List(v.map(fn(x: Goal) -> json.Value { json_of_goal(x) }))
}

fn from_json_goal_list(v: json.Value) -> List[Goal] ! Str {
  var out: List[Goal] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_goal(fv)?)
  }
  Ok(out)
}

