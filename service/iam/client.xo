fn xml_write_role(var w: xmlv.Writer, v: Role, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.path {
    xmlv.elem(w, "Path", x, [])
  }
  if let Some(x) = v.role_name {
    xmlv.elem(w, "RoleName", x, [])
  }
  if let Some(x) = v.role_id {
    xmlv.elem(w, "RoleId", x, [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "Arn", x, [])
  }
  if let Some(x) = v.create_date {
    xmlv.elem(w, "CreateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.assume_role_policy_document {
    xmlv.elem(w, "AssumeRolePolicyDocument", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.max_session_duration {
    xmlv.elem(w, "MaxSessionDuration", "${x}", [])
  }
  if let Some(x) = v.permissions_boundary {
    xml_write_attached_permissions_boundary(w, x, "PermissionsBoundary", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list_type(w, x, "Tags", [])
  }
  if let Some(x) = v.role_last_used {
    xml_write_role_last_used(w, x, "RoleLastUsed", [])
  }
  if let Some(x) = v.source_role_template {
    xml_write_source_role_template(w, x, "SourceRoleTemplate", [])
  }
  xmlv.end(w, name)
}

fn xml_read_role(e: xml.Element) -> Role ! Str {
  var out = Role{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Path" => out.path = c.text()
      "RoleName" => out.role_name = c.text()
      "RoleId" => out.role_id = c.text()
      "Arn" => out.arn = c.text()
      "CreateDate" => out.create_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "AssumeRolePolicyDocument" => out.assume_role_policy_document = c.text()
      "Description" => out.description = c.text()
      "MaxSessionDuration" => out.max_session_duration = xmlv.read_int(c.text())?
      "PermissionsBoundary" => out.permissions_boundary = xml_read_attached_permissions_boundary(c)?
      "Tags" => out.tags = xml_read_tag_list_type(c)?
      "RoleLastUsed" => out.role_last_used = xml_read_role_last_used(c)?
      "SourceRoleTemplate" => out.source_role_template = xml_read_source_role_template(c)?
      _ => {}
    }
  }
  Ok(out)
}

