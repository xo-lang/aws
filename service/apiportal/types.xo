/// Values are compared to the attribute as literals: exact and
/// case-sensitive, no wildcards.
pub struct RuleFilter {
  pub key: RuleFilterKey? = None
  /// The values to match. The filter matches when the attribute equals any of
  /// them.
  pub values: List[Str]? = None
}

/// The Managed API attribute a RuleFilter compares against. RESOURCE_ARN -
/// apiSignature.resourceArn HOST - apiSignature.hostname METHOD -
/// apiSignature.method, so values must be HttpMethod names PATH -
/// apiSignature.path PORT - apiSignature.port, compared as its decimal
/// string, so values must be 0-65535 with no leading zeros ACCOUNT - the
/// account hosting the API, which for an ORGANIZATION-scoped Managed API is
/// the member account rather than the account that created it
pub enum RuleFilterKey: Str {
  ResourceArn = "RESOURCE_ARN"
  Host = "HOST"
  Method = "METHOD"
  Path = "PATH"
  Port = "PORT"
  Account = "ACCOUNT"
  Unknown(value: Str)
}

/// A named group of API pages in the portal navigation.
pub struct Section {
  /// Shown in the portal navigation. Same bound as page titles and operation
  /// names, and no control characters (the service rejects a blank name).
  pub section_name: Str? = None
  pub product_api_page_arns: List[Str]? = None
}

pub struct StartDiscoveryRequest {
  /// Identifier of the discovery configuration to start. Required. Today this
  /// is the configuration ARN, which carries the owner account id so a
  /// delegated admin or org admin can start an org-scoped configuration that
  /// lives in a different account.
  pub id: Str? = None
}

pub enum Status: Str {
  Available = "AVAILABLE"
  InProgress = "IN_PROGRESS"
  Failed = "FAILED"
  Unknown(value: Str)
}

pub struct StopDiscoveryRequest {
  /// Identifier of the discovery configuration to stop. Required. Today this
  /// is the configuration ARN, which carries the owner account id so a
  /// delegated admin or org admin can stop an org-scoped configuration that
  /// lives in a different account.
  pub id: Str? = None
}

pub struct TagResourceRequest {
  /// The ARN of the resource.
  pub resource_arn: Str? = None
  pub tags: Map[Str, Str]? = None
}

pub struct TagResourceResponse {
}

pub enum TryItState: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

pub struct UntagResourceRequest {
  /// The ARN of the resource.
  pub resource_arn: Str? = None
  /// The keys of the tags to remove, up to 50.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

pub struct UpdatePortalPublishStatusRequest {
  /// The identifier of the portal.
  pub portal_id: Str? = None
  pub status: DesiredPublishStatus? = None
  /// A description of this publish request, up to 1024 characters.
  pub description: Str? = None
}

pub struct UpdatePortalRequest {
  /// The identifier of the portal.
  pub portal_id: Str? = None
  /// The new display name, description, and theme. Omit it to keep the
  /// current values.
  pub portal_content: PortalContent? = None
  pub endpoint_configuration: EndpointConfigurationRequest? = None
  /// The new authorization settings. Omit it to keep the current settings.
  pub authorization: Authorization? = None
  /// The new CloudWatch RUM app monitor name. Omit it to keep the current
  /// value.
  pub rum_app_monitor_name: Str? = None
  /// The new list of product ARNs, up to 200. It replaces the current list.
  /// Omit it to keep the current list.
  pub included_product_arns: List[Str]? = None
  /// The new S3 location of the portal logo, in the form `s3://bucket/key`.
  /// An empty string removes the logo. Omit it to keep the current logo.
  pub logo_uri: Str? = None
}

pub struct UpdatePortalResponse {
  /// The identifier of the portal.
  pub portal_id: Str? = None
  /// The ARN of the portal.
  pub portal_arn: Str? = None
  /// The domain configuration of the portal.
  pub endpoint_configuration: EndpointConfigurationResponse? = None
  /// How readers sign in to the portal, and whether fine-grained access
  /// control is on.
  pub authorization: Authorization? = None
  /// The portal's display name, description, and theme.
  pub portal_content: PortalContent? = None
  /// The ARNs of the products the portal includes.
  pub included_product_arns: List[Str]? = None
  /// The publish status of the portal. Absent if the portal has never been
  /// published.
  pub publish_status: PublishStatus? = None
  pub status_exception: PortalStatusException? = None
  /// When the resource was last updated.
  pub updated_at: Time? = None
  /// When the portal was last published.
  pub published_at: Time? = None
  /// The description supplied with the most recent publish request.
  pub publish_description: Str? = None
  /// The name of the CloudWatch RUM app monitor that collects reader
  /// telemetry for the portal.
  pub rum_app_monitor_name: Str? = None
  /// The most recent preview of the portal. Absent if no preview has been
  /// created.
  pub preview: Preview? = None
}

pub struct UpdateProductApiPageRequest {
  /// The identifier of the product.
  pub product_id: Str? = None
  /// The identifier of the API page.
  pub product_api_page_id: Str? = None
  pub display_content: ApiPageDisplayContent? = None
  /// The new Try-It setting. Omit it to keep the current setting. To enable
  /// it, the page's API URL must use HTTPS on a domain that supports Try-It.
  pub try_it_state: TryItState? = None
}

pub struct UpdateProductApiPageResponse {
  /// The identifier of the API page.
  pub product_api_page_id: Str? = None
  /// The ARN of the API page.
  pub product_api_page_arn: Str? = None
  /// The API the page documents.
  pub api_id: ApiId? = None
  /// The content shown on the page.
  pub display_content: ApiPageDisplayContentResponse? = None
  /// Whether Try-It is enabled on the page.
  pub try_it_state: TryItState? = None
  /// When the resource was last updated.
  pub updated_at: Time? = None
  /// The status of the page content: `IN_PROGRESS` while it is generated,
  /// then `AVAILABLE` or `FAILED`.
  pub status: Status? = None
  pub status_exception: ProductApiPageStatusException? = None
}

pub struct UpdateProductPageRequest {
  /// The identifier of the product.
  pub product_id: Str? = None
  /// The identifier of the product page.
  pub product_page_id: Str? = None
  /// The new title and body of the page. Omit it to keep the current content.
  pub display_content: DisplayContent? = None
}

pub struct UpdateProductPageResponse {
  /// The identifier of the product page.
  pub product_page_id: Str? = None
  /// The ARN of the product page.
  pub product_page_arn: Str? = None
  /// The title and body of the page.
  pub display_content: DisplayContent? = None
  /// When the resource was last updated.
  pub updated_at: Time? = None
}

pub struct UpdateProductRequest {
  /// The identifier of the product.
  pub product_id: Str? = None
  /// The new name of the product. Omit it to keep the current name.
  pub display_name: Str? = None
  /// The new description of the product. Omit it to keep the current
  /// description.
  pub description: Str? = None
  /// The new page order. Omit it to keep the current order.
  pub display_order: DisplayOrder? = None
  /// The new API selection settings. The selection mode must match the mode
  /// the product was created with. Omit it to keep the current settings.
  pub api_selection_configuration: ApiSelectionConfiguration? = None
}

pub struct UpdateProductResponse {
  /// The identifier of the product.
  pub product_id: Str? = None
  /// The ARN of the product.
  pub product_arn: Str? = None
  /// The name of the product, from 1 to 255 characters.
  pub display_name: Str? = None
  /// The order of the product's pages and API page sections in the portal
  /// navigation.
  pub display_order: DisplayOrder? = None
  /// A description of the product, up to 1024 characters.
  pub description: Str? = None
  /// When the resource was last updated.
  pub updated_at: Time? = None
  /// How Managed APIs are selected for the product.
  pub api_selection_configuration: ApiSelectionConfiguration? = None
  pub status: ProductStatus? = None
  pub failure_reason: ProductFailureReason? = None
}

/// Whether a discovered API is reachable publicly or only from within a
/// private network.
pub enum Visibility: Str {
  Public = "PUBLIC"
  Private = "PRIVATE"
  Unknown(value: Str)
}

/// Detail specific to a WAF API-security event.
pub struct WafApiSecurityEventDetail {
  /// Detection label (attack type + confidence tier).
  pub label: Str? = None
  /// OWASP class — the primary display value (e.g. "API2:2023").
  pub category: Str? = None
  /// Confidence tier of the detection.
  pub confidence: Confidence? = None
  /// WebACL that produced the event.
  pub web_acl_arn: Str? = None
}

/// Whether a WAF web ACL is attached to the API's front-door service.
pub enum WafStatus: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// An AI protocol seen in an API's traffic, detected by the front door from
/// request or response headers (and, for A2A, a query parameter). MCP -
/// Model Context Protocol. LLM - traffic to or from an LLM inference server
/// or gateway. A2A - Agent2Agent protocol.
pub enum Workload: Str {
  Mcp = "MCP"
  Llm = "LLM"
  A2A = "A2A"
  Unknown(value: Str)
}
