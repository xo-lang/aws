    query.add(f, query.key(prefix, "Name"), x)
  }
  if let Some(x) = v.enabled {
    query.add(f, query.key(prefix, "Enabled"), "${x}")
  }
  if let Some(x) = v.matching_event_types {
    query_put_event_types(f, query.key(prefix, "MatchingEventTypes"), x, false)
  }
  if let Some(x) = v.kinesis_firehose_destination {
    query_put_kinesis_firehose_destination(f, query.key(prefix, "KinesisFirehoseDestination"), x)
  }
  if let Some(x) = v.cloud_watch_destination {
    query_put_cloud_watch_destination(f, query.key(prefix, "CloudWatchDestination"), x)
  }
  if let Some(x) = v.sns_destination {
    query_put_sns_destination(f, query.key(prefix, "SNSDestination"), x)
  }
}

