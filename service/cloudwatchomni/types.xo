  /// The ID of the domain, when returning credentials for a target account
  /// that does not yet have a space.
  pub domain_id: Str? = None
  /// The ID of the target member account. Required when domainId is set.
  pub target_account_id: Str? = None
}

/// Status of a space.
pub enum SpaceStatus: Str {
  Active = "ACTIVE"
  Suspended = "SUSPENDED"
  Moving = "MOVING"
  Unknown(value: Str)
}

/// Summary of a space. Call GetSpace for the full space.
pub struct SpaceSummary {
  /// The unique ID of the space.
  pub space_id: Str? = None
  /// A name that identifies the space.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the space.
  pub space_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the domain the space belongs to.
  /// Absent when the space is not associated with a domain, so callers must
  /// tolerate its absence.
  pub domain_arn: Str? = None
  /// The region where this space was created.
  pub region: Str? = None
  /// AWS account ID that owns this space.
  pub owner_account_id: Str? = None
  /// The status of the space.
  pub status: SpaceStatus? = None
  /// Reason for the current space status.
  pub status_reason: Str? = None
  /// The timestamp when the space was created.
  pub created_at: Time? = None
  /// The timestamp when the space was last updated.
  pub updated_at: Time? = None
}

