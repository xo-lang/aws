fn xml_write_select_object_content_event_stream(var w: xmlv.Writer, v: SelectObjectContentEventStream, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    Records(x) => {
      xml_write_records_event(w, x, "Records", [])
    }
    Stats(x) => {
      xml_write_stats_event(w, x, "Stats", [])
    }
    Progress(x) => {
      xml_write_progress_event(w, x, "Progress", [])
    }
    Cont(x) => {
      xml_write_continuation_event(w, x, "Cont", [])
    }
    End(x) => {
      xml_write_end_event(w, x, "End", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_select_object_content_event_stream(e: xml.Element) -> SelectObjectContentEventStream ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "Records" => Ok(SelectObjectContentEventStream.Records(xml_read_records_event(c)?))
      "Stats" => Ok(SelectObjectContentEventStream.Stats(xml_read_stats_event(c)?))
      "Progress" => Ok(SelectObjectContentEventStream.Progress(xml_read_progress_event(c)?))
      "Cont" => Ok(SelectObjectContentEventStream.Cont(xml_read_continuation_event(c)?))
      "End" => Ok(SelectObjectContentEventStream.End(xml_read_end_event(c)?))
      _ => Ok(SelectObjectContentEventStream.Unknown(c.name.local))
    }
  }
  Err("SelectObjectContentEventStream: no member set")
}

