/// Details about a customer endpoint that was compared in an Inference
/// Recommender job.
pub struct EndpointInfo {
  /// The name of a customer's endpoint.
  pub endpoint_name: Str? = None
}

/// Input object for the endpoint
pub struct EndpointInput {
  /// An endpoint in customer's account which has enabled DataCaptureConfig
  /// enabled.
  pub endpoint_name: Str? = None
  /// Path to the filesystem where the endpoint data is available to the
  /// container.
  pub local_path: Str? = None
  /// Whether the Pipe or File is used as the input mode for transferring data
  /// for the monitoring job. Pipe mode is recommended for large datasets.
  /// File mode is useful for small files that fit in memory. Defaults to File
  /// .
  pub s3_input_mode: ProcessingS3InputMode? = None
  /// Whether input data distributed in Amazon S3 is fully replicated or
  /// sharded by an Amazon S3 key. Defaults to FullyReplicated
  pub s3_data_distribution_type: ProcessingS3DataDistributionType? = None
  /// The attributes of the input data that are the input features.
  pub features_attribute: Str? = None
  /// The attribute of the input data that represents the ground truth label.
  pub inference_attribute: Str? = None
  /// In a classification problem, the attribute that represents the class
  /// probability.
  pub probability_attribute: Str? = None
  /// The threshold for the class probability to be evaluated as a positive
  /// result.
  pub probability_threshold_attribute: Float? = None
  /// If specified, monitoring jobs substract this time from the start time.
  /// For information about using offsets for scheduling monitoring jobs, see
  /// Schedule Model Quality Monitoring Jobs .
  pub start_time_offset: Str? = None
  /// If specified, monitoring jobs substract this time from the end time. For
  /// information about using offsets for scheduling monitoring jobs, see
  /// Schedule Model Quality Monitoring Jobs .
  pub end_time_offset: Str? = None
  /// The attributes of the input data to exclude from the analysis.
  pub exclude_features_attribute: Str? = None
}

