    fs.push(("roleArn", json.Value.Str(x)))
  }
  if let Some(x) = v.integration_attributes {
    fs.push(("integrationAttributes", json_of_string_map(x)))
  }
  if let Some(x) = v.authorization_url {
    fs.push(("authorizationUrl", json.Value.Str(x)))
  }
  if let Some(x) = v.error_message {
    fs.push(("errorMessage", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("updatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.scope {
    fs.push(("scope", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_integration(v: json.Value) -> Integration ! Str {
  var out = Integration{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "integrationId" => out.integration_id = jsonv.read_str(fv)?
      "integrationArn" => out.integration_arn = jsonv.read_str(fv)?
      "integrationType" => out.integration_type = IntegrationType.from(jsonv.read_str(fv)?)
      "name" => out.name = jsonv.read_str(fv)?
      "status" => out.status = IntegrationStatus.from(jsonv.read_str(fv)?)
      "authType" => out.auth_type = AuthType.from(jsonv.read_str(fv)?)
      "credentialArn" => out.credential_arn = jsonv.read_str(fv)?
      "roleArn" => out.role_arn = jsonv.read_str(fv)?
      "integrationAttributes" => out.integration_attributes = from_json_string_map(fv)?
      "authorizationUrl" => out.authorization_url = jsonv.read_str(fv)?
      "errorMessage" => out.error_message = jsonv.read_str(fv)?
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "updatedAt" => out.updated_at = jsonv.read_time(fv, "epoch-seconds")?
      "scope" => out.scope = Scope.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_integration_credential(v: IntegrationCredential) -> json.Value {
  match v {
    OauthCodeCredential(x) => json.Value.Object([("oauthCodeCredential", json_of_o_auth_code_credential(x))])
    OauthClientCredential(x) => json.Value.Object([("oauthClientCredential", json_of_o_auth_client_credential(x))])
    ApiKeyCredential(x) => json.Value.Object([("apiKeyCredential", json_of_api_key_credential(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_integration_credential(v: json.Value) -> IntegrationCredential ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "oauthCodeCredential" => Ok(IntegrationCredential.OauthCodeCredential(from_json_o_auth_code_credential(fv)?))
      "oauthClientCredential" => Ok(IntegrationCredential.OauthClientCredential(from_json_o_auth_client_credential(fv)?))
      "apiKeyCredential" => Ok(IntegrationCredential.ApiKeyCredential(from_json_api_key_credential(fv)?))
      _ => Ok(IntegrationCredential.Unknown(k))
    }
  }
  Err("IntegrationCredential: no member set")
}

fn json_of_integration_identifier(v: IntegrationIdentifier) -> json.Value {
  match v {
    IntegrationId(x) => json.Value.Object([("integrationId", json.Value.Str(x))])
    IntegrationArn(x) => json.Value.Object([("integrationArn", json.Value.Str(x))])
    IntegrationName(x) => json.Value.Object([("integrationName", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_integration_identifier(v: json.Value) -> IntegrationIdentifier ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "integrationId" => Ok(IntegrationIdentifier.IntegrationId(jsonv.read_str(fv)?))
      "integrationArn" => Ok(IntegrationIdentifier.IntegrationArn(jsonv.read_str(fv)?))
      "integrationName" => Ok(IntegrationIdentifier.IntegrationName(jsonv.read_str(fv)?))
      _ => Ok(IntegrationIdentifier.Unknown(k))
    }
  }
  Err("IntegrationIdentifier: no member set")
}

