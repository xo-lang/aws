  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: ValidatePipelineErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    DisabledOperationException(x) => "DisabledOperationException: ${x:?}"
    InternalException(x) => "InternalException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_validate_pipeline_error(resp: http.Response) -> ValidatePipelineErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return ValidatePipelineErr.AccessDeniedException(x)
      Err(msg) => return ValidatePipelineErr.Deserialize(msg)
    }
    "DisabledOperationException" => match read_error_disabled_operation_exception(resp, body) {
      Ok(x) => return ValidatePipelineErr.DisabledOperationException(x)
      Err(msg) => return ValidatePipelineErr.Deserialize(msg)
    }
    "InternalException" => match read_error_internal_exception(resp, body) {
      Ok(x) => return ValidatePipelineErr.InternalException(x)
      Err(msg) => return ValidatePipelineErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return ValidatePipelineErr.ValidationException(x)
      Err(msg) => return ValidatePipelineErr.Deserialize(msg)
    }
    _ => {}
  }
  ValidatePipelineErr.Api(restjson.api_error(resp, body))
}

/// Checks whether an OpenSearch Ingestion pipeline configuration is valid
/// prior to creation. For more information, see Creating Amazon OpenSearch
/// Ingestion pipelines .
pub fn (c: Client) validate_pipeline(input: ValidatePipelineRequest) -> ValidatePipelineResponse ! ValidatePipelineErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_validate_pipeline(c.params, input)) ?? e => return Err(ValidatePipelineErr.InvalidInput(e))
  var req = serialize_validate_pipeline(ep, input, "") ?? e => return Err(ValidatePipelineErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(ValidatePipelineErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_validate_pipeline_error(resp))
  }
  deserialize_validate_pipeline(resp) ?? e => Err(ValidatePipelineErr.Deserialize(e))
}
