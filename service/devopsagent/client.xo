fn json_of_goal(v: Goal) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.agent_space_arn {
    fs.push(("agentSpaceArn", json.Value.Str(x)))
  }
  if let Some(x) = v.goal_id {
    fs.push(("goalId", json.Value.Str(x)))
  }
  if let Some(x) = v.title {
    fs.push(("title", json.Value.Str(x)))
  }
  if let Some(x) = v.content {
    fs.push(("content", json_of_goal_content(x)))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.goal_type {
    fs.push(("goalType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("updatedAt", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.last_evaluated_at {
    fs.push(("lastEvaluatedAt", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.last_task_id {
    fs.push(("lastTaskId", json.Value.Str(x)))
  }
  if let Some(x) = v.last_successful_task_id {
    fs.push(("lastSuccessfulTaskId", json.Value.Str(x)))
  }
  if let Some(x) = v.version {
    fs.push(("version", json.Value.Int(x)))
  }
  if let Some(x) = v.evaluation_schedule {
    fs.push(("evaluationSchedule", json_of_goal_schedule(x)))
  }
  json.Value.Object(fs)
}

fn from_json_goal(v: json.Value) -> Goal ! Str {
  var out = Goal{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "agentSpaceArn" => out.agent_space_arn = jsonv.read_str(fv)?
      "goalId" => out.goal_id = jsonv.read_str(fv)?
      "title" => out.title = jsonv.read_str(fv)?
      "content" => out.content = from_json_goal_content(fv)?
      "status" => out.status = GoalStatus.from(jsonv.read_str(fv)?)
      "goalType" => out.goal_type = GoalType.from(jsonv.read_str(fv)?)
      "createdAt" => out.created_at = jsonv.read_time(fv, "date-time")?
      "updatedAt" => out.updated_at = jsonv.read_time(fv, "date-time")?
      "lastEvaluatedAt" => out.last_evaluated_at = jsonv.read_time(fv, "date-time")?
      "lastTaskId" => out.last_task_id = jsonv.read_str(fv)?
      "lastSuccessfulTaskId" => out.last_successful_task_id = jsonv.read_str(fv)?
      "version" => out.version = jsonv.read_int(fv)?
      "evaluationSchedule" => out.evaluation_schedule = from_json_goal_schedule(fv)?
      _ => {}
    }
  }
  Ok(out)
}

