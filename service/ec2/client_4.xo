fn xml_write_explanation(var w: xmlv.Writer, v: Explanation, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.acl {
    xml_write_analysis_component(w, x, "acl", [])
  }
  if let Some(x) = v.acl_rule {
    xml_write_analysis_acl_rule(w, x, "aclRule", [])
  }
  if let Some(x) = v.address {
    xmlv.elem(w, "address", x, [])
  }
  if let Some(x) = v.addresses {
    xml_write_ip_address_list(w, x, "addressSet", [])
  }
  if let Some(x) = v.attached_to {
    xml_write_analysis_component(w, x, "attachedTo", [])
  }
  if let Some(x) = v.availability_zones {
    xml_write_value_string_list(w, x, "availabilityZoneSet", [])
  }
  if let Some(x) = v.availability_zone_ids {
    xml_write_value_string_list(w, x, "availabilityZoneIdSet", [])
  }
  if let Some(x) = v.cidrs {
    xml_write_value_string_list(w, x, "cidrSet", [])
  }
  if let Some(x) = v.component {
    xml_write_analysis_component(w, x, "component", [])
  }
  if let Some(x) = v.customer_gateway {
    xml_write_analysis_component(w, x, "customerGateway", [])
  }
  if let Some(x) = v.destination {
    xml_write_analysis_component(w, x, "destination", [])
  }
  if let Some(x) = v.destination_vpc {
    xml_write_analysis_component(w, x, "destinationVpc", [])
  }
  if let Some(x) = v.direction {
    xmlv.elem(w, "direction", x, [])
  }
  if let Some(x) = v.explanation_code {
    xmlv.elem(w, "explanationCode", x, [])
  }
  if let Some(x) = v.ingress_route_table {
    xml_write_analysis_component(w, x, "ingressRouteTable", [])
  }
  if let Some(x) = v.internet_gateway {
    xml_write_analysis_component(w, x, "internetGateway", [])
  }
  if let Some(x) = v.load_balancer_arn {
    xmlv.elem(w, "loadBalancerArn", x, [])
  }
  if let Some(x) = v.classic_load_balancer_listener {
    xml_write_analysis_load_balancer_listener(w, x, "classicLoadBalancerListener", [])
  }
  if let Some(x) = v.load_balancer_listener_port {
    xmlv.elem(w, "loadBalancerListenerPort", "${x}", [])
  }
  if let Some(x) = v.load_balancer_target {
    xml_write_analysis_load_balancer_target(w, x, "loadBalancerTarget", [])
  }
  if let Some(x) = v.load_balancer_target_group {
    xml_write_analysis_component(w, x, "loadBalancerTargetGroup", [])
  }
  if let Some(x) = v.load_balancer_target_groups {
    xml_write_analysis_component_list(w, x, "loadBalancerTargetGroupSet", [])
  }
  if let Some(x) = v.load_balancer_target_port {
    xmlv.elem(w, "loadBalancerTargetPort", "${x}", [])
  }
  if let Some(x) = v.elastic_load_balancer_listener {
    xml_write_analysis_component(w, x, "elasticLoadBalancerListener", [])
  }
  if let Some(x) = v.missing_component {
    xmlv.elem(w, "missingComponent", x, [])
  }
  if let Some(x) = v.nat_gateway {
    xml_write_analysis_component(w, x, "natGateway", [])
  }
  if let Some(x) = v.network_interface {
    xml_write_analysis_component(w, x, "networkInterface", [])
  }
  if let Some(x) = v.packet_field {
    xmlv.elem(w, "packetField", x, [])
  }
  if let Some(x) = v.vpc_peering_connection {
    xml_write_analysis_component(w, x, "vpcPeeringConnection", [])
  }
  if let Some(x) = v.port {
    xmlv.elem(w, "port", "${x}", [])
  }
  if let Some(x) = v.port_ranges {
    xml_write_port_range_list(w, x, "portRangeSet", [])
  }
  if let Some(x) = v.prefix_list {
    xml_write_analysis_component(w, x, "prefixList", [])
  }
  if let Some(x) = v.protocols {
    xml_write_string_list(w, x, "protocolSet", [])
  }
  if let Some(x) = v.route_table_route {
    xml_write_analysis_route_table_route(w, x, "routeTableRoute", [])
  }
  if let Some(x) = v.route_table {
    xml_write_analysis_component(w, x, "routeTable", [])
  }
  if let Some(x) = v.security_group {
    xml_write_analysis_component(w, x, "securityGroup", [])
  }
  if let Some(x) = v.security_group_rule {
    xml_write_analysis_security_group_rule(w, x, "securityGroupRule", [])
  }
  if let Some(x) = v.security_groups {
    xml_write_analysis_component_list(w, x, "securityGroupSet", [])
  }
  if let Some(x) = v.source_vpc {
    xml_write_analysis_component(w, x, "sourceVpc", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x, [])
  }
  if let Some(x) = v.subnet {
    xml_write_analysis_component(w, x, "subnet", [])
  }
  if let Some(x) = v.subnet_route_table {
    xml_write_analysis_component(w, x, "subnetRouteTable", [])
  }
  if let Some(x) = v.vpc {
    xml_write_analysis_component(w, x, "vpc", [])
  }
  if let Some(x) = v.vpc_endpoint {
    xml_write_analysis_component(w, x, "vpcEndpoint", [])
  }
  if let Some(x) = v.vpn_connection {
    xml_write_analysis_component(w, x, "vpnConnection", [])
  }
  if let Some(x) = v.vpn_gateway {
    xml_write_analysis_component(w, x, "vpnGateway", [])
  }
  if let Some(x) = v.transit_gateway {
    xml_write_analysis_component(w, x, "transitGateway", [])
  }
  if let Some(x) = v.transit_gateway_route_table {
    xml_write_analysis_component(w, x, "transitGatewayRouteTable", [])
  }
  if let Some(x) = v.transit_gateway_route_table_route {
    xml_write_transit_gateway_route_table_route(w, x, "transitGatewayRouteTableRoute", [])
  }
  if let Some(x) = v.transit_gateway_policy_table {
    xml_write_analysis_component(w, x, "transitGatewayPolicyTable", [])
  }
  if let Some(x) = v.transit_gateway_policy_table_entry {
    xml_write_analysis_transit_gateway_policy_table_entry(w, x, "transitGatewayPolicyTableEntry", [])
  }
  if let Some(x) = v.transit_gateway_attachment {
    xml_write_analysis_component(w, x, "transitGatewayAttachment", [])
  }
  if let Some(x) = v.component_account {
    xmlv.elem(w, "componentAccount", x, [])
  }
  if let Some(x) = v.component_region {
    xmlv.elem(w, "componentRegion", x, [])
  }
  if let Some(x) = v.firewall_stateless_rule {
    xml_write_firewall_stateless_rule(w, x, "firewallStatelessRule", [])
  }
  if let Some(x) = v.firewall_stateful_rule {
    xml_write_firewall_stateful_rule(w, x, "firewallStatefulRule", [])
  }
  xmlv.end(w, name)
}

fn xml_read_explanation(e: xml.Element) -> Explanation ! Str {
  var out = Explanation{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "acl" => out.acl = xml_read_analysis_component(c)?
      "aclRule" => out.acl_rule = xml_read_analysis_acl_rule(c)?
      "address" => out.address = c.text()
      "addressSet" => out.addresses = xml_read_ip_address_list(c)?
      "attachedTo" => out.attached_to = xml_read_analysis_component(c)?
      "availabilityZoneSet" => out.availability_zones = xml_read_value_string_list(c)?
      "availabilityZoneIdSet" => out.availability_zone_ids = xml_read_value_string_list(c)?
      "cidrSet" => out.cidrs = xml_read_value_string_list(c)?
      "component" => out.component = xml_read_analysis_component(c)?
      "customerGateway" => out.customer_gateway = xml_read_analysis_component(c)?
      "destination" => out.destination = xml_read_analysis_component(c)?
      "destinationVpc" => out.destination_vpc = xml_read_analysis_component(c)?
      "direction" => out.direction = c.text()
      "explanationCode" => out.explanation_code = c.text()
      "ingressRouteTable" => out.ingress_route_table = xml_read_analysis_component(c)?
      "internetGateway" => out.internet_gateway = xml_read_analysis_component(c)?
      "loadBalancerArn" => out.load_balancer_arn = c.text()
      "classicLoadBalancerListener" => out.classic_load_balancer_listener = xml_read_analysis_load_balancer_listener(c)?
      "loadBalancerListenerPort" => out.load_balancer_listener_port = xmlv.read_int(c.text())?
      "loadBalancerTarget" => out.load_balancer_target = xml_read_analysis_load_balancer_target(c)?
      "loadBalancerTargetGroup" => out.load_balancer_target_group = xml_read_analysis_component(c)?
      "loadBalancerTargetGroupSet" => out.load_balancer_target_groups = xml_read_analysis_component_list(c)?
      "loadBalancerTargetPort" => out.load_balancer_target_port = xmlv.read_int(c.text())?
      "elasticLoadBalancerListener" => out.elastic_load_balancer_listener = xml_read_analysis_component(c)?
      "missingComponent" => out.missing_component = c.text()
      "natGateway" => out.nat_gateway = xml_read_analysis_component(c)?
      "networkInterface" => out.network_interface = xml_read_analysis_component(c)?
      "packetField" => out.packet_field = c.text()
      "vpcPeeringConnection" => out.vpc_peering_connection = xml_read_analysis_component(c)?
      "port" => out.port = xmlv.read_int(c.text())?
      "portRangeSet" => out.port_ranges = xml_read_port_range_list(c)?
      "prefixList" => out.prefix_list = xml_read_analysis_component(c)?
      "protocolSet" => out.protocols = xml_read_string_list(c)?
      "routeTableRoute" => out.route_table_route = xml_read_analysis_route_table_route(c)?
      "routeTable" => out.route_table = xml_read_analysis_component(c)?
      "securityGroup" => out.security_group = xml_read_analysis_component(c)?
      "securityGroupRule" => out.security_group_rule = xml_read_analysis_security_group_rule(c)?
      "securityGroupSet" => out.security_groups = xml_read_analysis_component_list(c)?
      "sourceVpc" => out.source_vpc = xml_read_analysis_component(c)?
      "state" => out.state = c.text()
      "subnet" => out.subnet = xml_read_analysis_component(c)?
      "subnetRouteTable" => out.subnet_route_table = xml_read_analysis_component(c)?
      "vpc" => out.vpc = xml_read_analysis_component(c)?
      "vpcEndpoint" => out.vpc_endpoint = xml_read_analysis_component(c)?
      "vpnConnection" => out.vpn_connection = xml_read_analysis_component(c)?
      "vpnGateway" => out.vpn_gateway = xml_read_analysis_component(c)?
      "transitGateway" => out.transit_gateway = xml_read_analysis_component(c)?
      "transitGatewayRouteTable" => out.transit_gateway_route_table = xml_read_analysis_component(c)?
      "transitGatewayRouteTableRoute" => out.transit_gateway_route_table_route = xml_read_transit_gateway_route_table_route(c)?
      "transitGatewayPolicyTable" => out.transit_gateway_policy_table = xml_read_analysis_component(c)?
      "transitGatewayPolicyTableEntry" => out.transit_gateway_policy_table_entry = xml_read_analysis_transit_gateway_policy_table_entry(c)?
      "transitGatewayAttachment" => out.transit_gateway_attachment = xml_read_analysis_component(c)?
      "componentAccount" => out.component_account = c.text()
      "componentRegion" => out.component_region = c.text()
      "firewallStatelessRule" => out.firewall_stateless_rule = xml_read_firewall_stateless_rule(c)?
      "firewallStatefulRule" => out.firewall_stateful_rule = xml_read_firewall_stateful_rule(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_explanation_list(var w: xmlv.Writer, v: List[Explanation], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_explanation(w, item, "item", [])
  }
  xmlv.end(w, name)
}

fn xml_read_explanation_list(e: xml.Element) -> List[Explanation] ! Str {
  var out: List[Explanation] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_explanation(c)?)
  }
  Ok(out)
}

