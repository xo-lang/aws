fn json_of_delete_integration_response(v: DeleteIntegrationResponse) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.source_arn {
    fs.push(("SourceArn", json.Value.Str(x)))
  }
  if let Some(x) = v.target_arn {
    fs.push(("TargetArn", json.Value.Str(x)))
  }
  if let Some(x) = v.integration_name {
    fs.push(("IntegrationName", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.integration_arn {
    fs.push(("IntegrationArn", json.Value.Str(x)))
  }
  if let Some(x) = v.kms_key_id {
    fs.push(("KmsKeyId", json.Value.Str(x)))
  }
  if let Some(x) = v.additional_encryption_context {
    fs.push(("AdditionalEncryptionContext", json_of_integration_additional_encryption_context_map(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_integration_tags_list(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.create_time {
    fs.push(("CreateTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.errors {
    fs.push(("Errors", json_of_integration_error_list(x)))
  }
  if let Some(x) = v.data_filter {
    fs.push(("DataFilter", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_delete_integration_response(v: json.Value) -> DeleteIntegrationResponse ! Str {
  var out = DeleteIntegrationResponse{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "SourceArn" => out.source_arn = jsonv.read_str(fv)?
      "TargetArn" => out.target_arn = jsonv.read_str(fv)?
      "IntegrationName" => out.integration_name = jsonv.read_str(fv)?
      "Description" => out.description = jsonv.read_str(fv)?
      "IntegrationArn" => out.integration_arn = jsonv.read_str(fv)?
      "KmsKeyId" => out.kms_key_id = jsonv.read_str(fv)?
      "AdditionalEncryptionContext" => out.additional_encryption_context = from_json_integration_additional_encryption_context_map(fv)?
      "Tags" => out.tags = from_json_integration_tags_list(fv)?
      "Status" => out.status = IntegrationStatus.from(jsonv.read_str(fv)?)
      "CreateTime" => out.create_time = jsonv.read_time(fv, "epoch-seconds")?
      "Errors" => out.errors = from_json_integration_error_list(fv)?
      "DataFilter" => out.data_filter = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

