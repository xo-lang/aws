  var out = Upload{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "arn" => out.arn = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "created" => out.created = jsonv.read_time(fv, "epoch-seconds")?
      "type" => out.type_value = UploadType.from(jsonv.read_str(fv)?)
      "status" => out.status = UploadStatus.from(jsonv.read_str(fv)?)
      "url" => out.url = jsonv.read_str(fv)?
      "metadata" => out.metadata = jsonv.read_str(fv)?
      "contentType" => out.content_type = jsonv.read_str(fv)?
      "message" => out.message = jsonv.read_str(fv)?
      "category" => out.category = UploadCategory.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

