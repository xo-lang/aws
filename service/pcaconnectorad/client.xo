fn json_of_template(v: Template) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.connector_arn {
    fs.push(("ConnectorArn", json.Value.Str(x)))
  }
  if let Some(x) = v.definition {
    fs.push(("Definition", json_of_template_definition(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.object_identifier {
    fs.push(("ObjectIdentifier", json.Value.Str(x)))
  }
  if let Some(x) = v.policy_schema {
    fs.push(("PolicySchema", json.Value.Int(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.revision {
    fs.push(("Revision", json_of_template_revision(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("UpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_template(v: json.Value) -> Template ! Str {
  var out = Template{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Arn" => out.arn = jsonv.read_str(fv)?
      "ConnectorArn" => out.connector_arn = jsonv.read_str(fv)?
      "Definition" => out.definition = from_json_template_definition(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "ObjectIdentifier" => out.object_identifier = jsonv.read_str(fv)?
      "PolicySchema" => out.policy_schema = jsonv.read_int(fv)?
      "Status" => out.status = TemplateStatus.from(jsonv.read_str(fv)?)
      "Revision" => out.revision = from_json_template_revision(fv)?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
