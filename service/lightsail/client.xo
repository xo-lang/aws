fn from_json_instance(v: json.Value) -> Instance ! Str {
  var out = Instance{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "name" => out.name = jsonv.read_str(fv)?
      "arn" => out.arn = jsonv.read_str(fv)?
      "supportCode" => out.support_code = jsonv.read_str(fv)?
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "location" => out.location = from_json_resource_location(fv)?
      "resourceType" => out.resource_type = ResourceType.from(jsonv.read_str(fv)?)
      "tags" => out.tags = from_json_tag_list(fv)?
      "blueprintId" => out.blueprint_id = jsonv.read_str(fv)?
      "blueprintName" => out.blueprint_name = jsonv.read_str(fv)?
      "bundleId" => out.bundle_id = jsonv.read_str(fv)?
      "addOns" => out.add_ons = from_json_add_on_list(fv)?
      "isStaticIp" => out.is_static_ip = jsonv.read_bool(fv)?
      "privateIpAddress" => out.private_ip_address = jsonv.read_str(fv)?
      "publicIpAddress" => out.public_ip_address = jsonv.read_str(fv)?
      "ipv6Addresses" => out.ipv6_addresses = from_json_ipv6_address_list(fv)?
      "ipAddressType" => out.ip_address_type = IpAddressType.from(jsonv.read_str(fv)?)
      "hardware" => out.hardware = from_json_instance_hardware(fv)?
      "networking" => out.networking = from_json_instance_networking(fv)?
      "state" => out.state = from_json_instance_state(fv)?
      "username" => out.username = jsonv.read_str(fv)?
      "sshKeyName" => out.ssh_key_name = jsonv.read_str(fv)?
      "metadataOptions" => out.metadata_options = from_json_instance_metadata_options(fv)?
      "instanceStatus" => out.instance_status = from_json_instance_health_status(fv)?
      "systemStatus" => out.system_status = from_json_instance_health_status(fv)?
      _ => {}
    }
  }
  Ok(out)
}

