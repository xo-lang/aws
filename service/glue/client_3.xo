      "NumberOfWorkers" => out.number_of_workers = jsonv.read_int(fv)?
      "WorkerType" => out.worker_type = WorkerType.from(jsonv.read_str(fv)?)
      "CompletedOn" => out.completed_on = jsonv.read_time(fv, "epoch-seconds")?
      "ExecutionTime" => out.execution_time = jsonv.read_float(fv)?
      "DPUSeconds" => out.dpu_seconds = jsonv.read_float(fv)?
      "IdleTimeout" => out.idle_timeout = jsonv.read_int(fv)?
      "ProfileName" => out.profile_name = jsonv.read_str(fv)?
      "SessionType" => out.session_type = SessionType.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
