fn xml_write_network_interface_attachment(var w: xmlv.Writer, v: NetworkInterfaceAttachment, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.attach_time {
    xmlv.elem(w, "attachTime", rest.date_time(x), [])
  }
  if let Some(x) = v.attachment_id {
    xmlv.elem(w, "attachmentId", x, [])
  }
  if let Some(x) = v.delete_on_termination {
    xmlv.elem(w, "deleteOnTermination", "${x}", [])
  }
  if let Some(x) = v.device_index {
    xmlv.elem(w, "deviceIndex", "${x}", [])
  }
  if let Some(x) = v.network_card_index {
    xmlv.elem(w, "networkCardIndex", "${x}", [])
  }
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.instance_owner_id {
    xmlv.elem(w, "instanceOwnerId", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.ena_srd_specification {
    xml_write_attachment_ena_srd_specification(w, x, "enaSrdSpecification", [])
  }
  if let Some(x) = v.ena_queue_count {
    xmlv.elem(w, "enaQueueCount", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_network_interface_attachment(e: xml.Element) -> NetworkInterfaceAttachment ! Str {
  var out = NetworkInterfaceAttachment{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "attachTime" => out.attach_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "attachmentId" => out.attachment_id = c.text()
      "deleteOnTermination" => out.delete_on_termination = xmlv.read_bool(c.text())?
      "deviceIndex" => out.device_index = xmlv.read_int(c.text())?
      "networkCardIndex" => out.network_card_index = xmlv.read_int(c.text())?
      "instanceId" => out.instance_id = c.text()
      "instanceOwnerId" => out.instance_owner_id = c.text()
      "status" => out.status = AttachmentStatus.from(c.text())
      "enaSrdSpecification" => out.ena_srd_specification = xml_read_attachment_ena_srd_specification(c)?
      "enaQueueCount" => out.ena_queue_count = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

