use std/http
use std/testing
use github.com/xo-lang/aws

const CONFIG: Str = r"""
# comment
; another comment
[default]
region = us-west-2
output = json   # inline comment

[profile dev]
region=eu-west-1
s3 =
  max_concurrent_requests = 20
  addressing_style = path
role_arn = arn:aws:iam::123456789012:role/Dev
source_profile = default

[profile multi]
note = first line
  second line

[dev]
region = ignored-no-profile-prefix

[sso-session corp]
sso_start_url = https://example.awsapps.test/start
sso_region = us-east-1

[services local]
s3 =
  endpoint_url = http://127.0.0.1:9000
"""

const CREDS: Str = r"""
[default]
aws_access_key_id = AKIDTEST0000000000
aws_secret_access_key = invented-secret

[dev]
aws_access_key_id = AKIDTEST0000000001
aws_secret_access_key = invented-secret-2
aws_session_token = invented-token
region = from-credentials-file

[profile ignored]
aws_access_key_id = AKIDTEST0000000002
"""

test "config file sections and properties" {
  let p = parse(CONFIG, FileKind.Config)
  let d = p.profiles.get("default")?
  expect(d.props.get("region")) == Some("us-west-2")
  expect(d.props.get("output")) == Some("json")
  let dev = p.profiles.get("dev")?
  expect(dev.props.get("region")) == Some("eu-west-1")
  expect(dev.props.get("role_arn")) == Some("arn:aws:iam::123456789012:role/Dev")
  expect(dev.sub.get("s3")?.get("max_concurrent_requests")) == Some("20")
  expect(dev.sub.get("s3")?.get("addressing_style")) == Some("path")
  expect(p.profiles.get("multi")?.props.get("note")) == Some("first line\nsecond line")
  expect(p.sso_sessions.get("corp")?.props.get("sso_region")) == Some("us-east-1")
  expect(p.services.get("local")?.sub.get("s3")?.get("endpoint_url")) == Some("http://127.0.0.1:9000")
  expect(p.profiles.len()) == 3
}

test "profile default wins over default in the config file" {
  let text = "[profile default]\nregion = a\n[default]\nregion = b\n"
  expect(parse(text, FileKind.Config).profiles.get("default")?.props.get("region")) == Some("a")
  let text2 = "[default]\nregion = b\noutput = text\n[profile default]\nregion = a\n"
  let d = parse(text2, FileKind.Config).profiles.get("default")?
  expect(d.props.get("region")) == Some("a")
  expect(d.props.get("output")) == None
}

test "credentials file names profiles without a prefix" {
  let p = parse(CREDS, FileKind.Credentials)
  expect(p.profiles.get("dev")?.props.get("aws_session_token")) == Some("invented-token")
  expect(p.profiles.contains("ignored")) == false
  expect(p.profiles.contains("profile ignored")) == false
}

test "load and merge both files" {
  os.env.set("AWS_CONFIG_FILE", "/cfg/config")
  os.env.set("AWS_SHARED_CREDENTIALS_FILE", "/cfg/credentials")
  os.fs.write("/cfg/config", CONFIG.bytes())?
  os.fs.write("/cfg/credentials", CREDS.bytes())?
  let sc = load_shared(os.env, os.fs)?
  expect(sc.files) == ["/cfg/config", "/cfg/credentials"]
  let dev = sc.profiles.get("dev")?
  expect(dev.props.get("region")) == Some("from-credentials-file")
  expect(dev.props.get("role_arn")) == Some("arn:aws:iam::123456789012:role/Dev")
  let c = profile_static_credentials(sc, "dev")?
  expect(c.access_key_id) == "AKIDTEST0000000001"
  expect(c.session_token.map(fn(t) { t.reveal() })) == Some("invented-token")
  expect(c.source) == "SharedConfigCredentials: dev"
}

test "missing files are empty" {
  os.env.set("AWS_CONFIG_FILE", "/none/config")
  os.env.set("AWS_SHARED_CREDENTIALS_FILE", "/none/credentials")
  let sc = load_shared(os.env, os.fs)?
  expect(sc.profiles.len()) == 0
  expect(profile_static_credentials(sc, "default") is Err(aws.CredentialsErr.NotFound(_))) == true
}

test "home expansion" {
  os.env.set("HOME", "/h")
  let (cfg, creds) = file_paths(os.env)?
  expect(cfg) == "/h/.aws/config"
  expect(creds) == "/h/.aws/credentials"
}

test "profile name" {
  expect(profile_name(os.env)) == "default"
  os.env.set("AWS_PROFILE", "dev")
  expect(profile_name(os.env)) == "dev"
}

test "one key only is invalid" {
  let sc = SharedConfig{profiles: {"p": Section{props: {"aws_access_key_id": "AKIDTEST0000000000"}}}}
  expect(profile_static_credentials(sc, "p") is Err(aws.CredentialsErr.Invalid(_))) == true
}

test "default config from environment and files" {
  os.env.set("AWS_CONFIG_FILE", "/cfg/config")
  os.env.set("AWS_SHARED_CREDENTIALS_FILE", "/cfg/credentials")
  os.fs.write("/cfg/config", CONFIG.bytes())?
  os.fs.write("/cfg/credentials", CREDS.bytes())?
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(cfg.region) == Some("us-west-2")
  expect(cfg.profile) == "default"
  expect(cfg.max_attempts) == 3
  let creds = cfg.credentials?.retrieve()?
  expect(creds.access_key_id) == "AKIDTEST0000000000"
  expect(creds.source) == "SharedConfigCredentials: default"
}

test "environment wins over the profile" {
  os.env.set("AWS_CONFIG_FILE", "/cfg/config")
  os.env.set("AWS_SHARED_CREDENTIALS_FILE", "/cfg/credentials")
  os.fs.write("/cfg/config", CONFIG.bytes())?
  os.fs.write("/cfg/credentials", CREDS.bytes())?
  os.env.set("AWS_REGION", "ap-south-1")
  os.env.set("AWS_ACCESS_KEY_ID", "AKIDTEST0000000009")
  os.env.set("AWS_SECRET_ACCESS_KEY", "invented-secret-9")
  os.env.set("AWS_MAX_ATTEMPTS", "5")
  os.env.set("AWS_RETRY_MODE", "adaptive")
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(cfg.region) == Some("ap-south-1")
  expect(cfg.max_attempts) == 5
  expect(cfg.retry_mode) == aws.RetryMode.Adaptive
  expect(cfg.credentials?.retrieve()?.source) == "EnvironmentVariables"
}

test "explicit profile must exist" {
  os.env.set("AWS_CONFIG_FILE", "/cfg/config")
  os.env.set("AWS_SHARED_CREDENTIALS_FILE", "/cfg/credentials")
  os.env.set("AWS_PROFILE", "nope")
  expect(load_default_config(os.env, os.fs, os.net, os.clock, os.rand) is Err(ConfigErr.ProfileNotFound(..))) == true
}

test "bad settings are errors" {
  os.env.set("AWS_CONFIG_FILE", "/cfg/config")
  os.env.set("AWS_SHARED_CREDENTIALS_FILE", "/cfg/credentials")
  os.env.set("AWS_MAX_ATTEMPTS", "zero")
  expect(load_default_config(os.env, os.fs, os.net, os.clock, os.rand) is Err(ConfigErr.Invalid(..))) == true
}

test "configured endpoint precedence" {
  os.env.set("AWS_CONFIG_FILE", "/cfg/config")
  os.env.set("AWS_SHARED_CREDENTIALS_FILE", "/cfg/credentials")
  os.fs.write("/cfg/config", "[default]\nservices = local\nendpoint_url = http://127.0.0.1:4000\n[services local]\ns3 =\n  endpoint_url = http://127.0.0.1:9000\n".bytes())?
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(aws.endpoint_for(cfg.endpoints, "S3")) == Some("http://127.0.0.1:9000")
  expect(aws.endpoint_for(cfg.endpoints, "SQS")) == Some("http://127.0.0.1:4000")
  os.env.set("AWS_ENDPOINT_URL", "http://127.0.0.1:4566")
  os.env.set("AWS_ENDPOINT_URL_SQS", "http://127.0.0.1:4567")
  let cfg2 = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(aws.endpoint_for(cfg2.endpoints, "S3")) == Some("http://127.0.0.1:4566")
  expect(aws.endpoint_for(cfg2.endpoints, "SQS")) == Some("http://127.0.0.1:4567")
  os.env.set("AWS_IGNORE_CONFIGURED_ENDPOINT_URLS", "true")
  let cfg3 = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(aws.endpoint_for(cfg3.endpoints, "S3")) == None
}

const ROLE_OK: Str = "<AssumeRoleResponse><AssumeRoleResult><Credentials><AccessKeyId>ROLEKEYEXAMPLE00001</AccessKeyId><SecretAccessKey>invented-role-secret</SecretAccessKey><SessionToken>invented-role-token</SessionToken><Expiration>2026-01-01T01:00:00Z</Expiration></Credentials></AssumeRoleResult></AssumeRoleResponse>"

const ROLE_CONFIG: Str = r"""[profile base]
region = us-west-2
aws_access_key_id = AKIDTEST0000000001
aws_secret_access_key = invented-secret-1

[profile role]
region = us-west-2
role_arn = arn:aws:iam::123456789012:role/Demo
source_profile = base
role_session_name = tester
external_id = ext-1

[profile chained]
region = us-west-2
role_arn = arn:aws:iam::123456789012:role/Second
source_profile = role
role_session_name = second

[profile self]
role_arn = arn:aws:iam::123456789012:role/Self
source_profile = self
aws_access_key_id = AKIDTEST0000000002
aws_secret_access_key = invented-secret-2
role_session_name = s

[profile loop_a]
role_arn = arn:aws:iam::123456789012:role/A
source_profile = loop_b

[profile loop_b]
role_arn = arn:aws:iam::123456789012:role/B
source_profile = loop_a

[profile from_env]
role_arn = arn:aws:iam::123456789012:role/Env
credential_source = Environment
role_session_name = e

[profile local]
role_arn = arn:aws:iam::123456789012:role/Local
source_profile = base
role_session_name = l
services = emulator

[services emulator]
sts =
  endpoint_url = http://localhost:4566
"""

fn role_files(fs: testing.MemFs, env: testing.FakeEnv, profile: Str) {
  env.set("AWS_CONFIG_FILE", "/cfg/config")
  env.set("AWS_SHARED_CREDENTIALS_FILE", "/cfg/credentials")
  env.set("AWS_PROFILE", profile)
  expect(fs.write("/cfg/config", ROLE_CONFIG.bytes()).is_ok()) == true
}

test "a role profile assumes the role with its source profile's keys" {
  role_files(os.fs, os.env, "role")
  let auths = Mutex[List[Str]].new([])
  os.net.handle("POST https://sts.us-west-2.amazonaws.com/", fn(req: http.Request) -> http.Response {
    auths.with(fn(var xs: List[Str]) { xs.push("${req.header("Authorization") ?? ""} ${req.body.to_str() ?? ""}") })
    http.text(200, ROLE_OK)
  })
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  let creds = cfg.credentials?.retrieve()?
  expect(creds.access_key_id) == "ROLEKEYEXAMPLE00001"
  expect(creds.source) == "AssumeRoleProvider"
  // cached: a second retrieve sends nothing
  cfg.credentials?.retrieve()?
  let sent = auths.with_read(fn(xs: List[Str]) -> List[Str] { xs })
  expect(sent.len()) == 1
  expect(sent[0].contains("Credential=AKIDTEST0000000001/")) == true
  expect(sent[0].contains("RoleSessionName=tester&ExternalId=ext-1")) == true
}

test "chained roles sign with the previous role's credentials" {
  role_files(os.fs, os.env, "chained")
  let auths = Mutex[List[Str]].new([])
  os.net.handle("POST https://sts.us-west-2.amazonaws.com/", fn(req: http.Request) -> http.Response {
    auths.with(fn(var xs: List[Str]) { xs.push(req.header("Authorization") ?? "") })
    http.text(200, ROLE_OK)
  })
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  cfg.credentials?.retrieve()?
  let sent = auths.with_read(fn(xs: List[Str]) -> List[Str] { xs })
  expect(sent.len()) == 2
  expect(sent[0].contains("Credential=AKIDTEST0000000001/")) == true
  expect(sent[1].contains("Credential=ROLEKEYEXAMPLE00001/")) == true
}

test "a profile may source itself when it has static keys" {
  role_files(os.fs, os.env, "self")
  os.env.set("AWS_REGION", "eu-west-1")
  os.net.handle("POST https://sts.eu-west-1.amazonaws.com/", fn(req: http.Request) -> http.Response {
    if (req.header("Authorization") ?? "").contains("AKIDTEST0000000002") { http.text(200, ROLE_OK) } else { http.empty(403) }
  })
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(cfg.credentials?.retrieve()?.access_key_id) == "ROLEKEYEXAMPLE00001"
}

test "role loops and bad sources are config errors" {
  role_files(os.fs, os.env, "loop_a")
  os.env.set("AWS_REGION", "us-east-1")
  expect(load_default_config(os.env, os.fs, os.net, os.clock, os.rand) is Err(ConfigErr.Invalid(..))) == true
}

test "credential_source Environment and a configured STS endpoint" {
  role_files(os.fs, os.env, "from_env")
  os.env.set("AWS_REGION", "us-east-1")
  os.env.set("AWS_ACCESS_KEY_ID", "AKIDTEST0000000003")
  os.env.set("AWS_SECRET_ACCESS_KEY", "invented-secret-3")
  // the environment's keys come first in the chain, as in the other SDKs
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(cfg.credentials?.retrieve()?.source) == "EnvironmentVariables"
  os.env.set("AWS_ACCESS_KEY_ID", "")
  os.env.set("AWS_SECRET_ACCESS_KEY", "")
  os.env.set("AWS_PROFILE", "local")
  os.net.handle("POST http://localhost:4566/", fn(_req: http.Request) -> http.Response { http.text(200, ROLE_OK) })
  let local = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(local.credentials?.retrieve()?.access_key_id) == "ROLEKEYEXAMPLE00001"
}

test "bearer tokens and the Lambda trace id come from the environment" {
  os.env.set("HOME", "/h")
  os.env.set("AWS_REGION", "us-west-2")
  os.env.set("AWS_ACCESS_KEY_ID", "AKIDTEST0000000000")
  os.env.set("AWS_SECRET_ACCESS_KEY", "invented-secret")
  os.env.set("AWS_BEARER_TOKEN_BEDROCK", "invented-bedrock-key")
  os.env.set("_X_AMZN_TRACE_ID", "Root=1-00000000-000000000000000000000000")
  let outside = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(outside.bearer_tokens.get("BEDROCK")) == Some("invented-bedrock-key")
  // only inside Lambda is the trace id taken
  expect(outside.trace_id) == None
  os.env.set("AWS_LAMBDA_FUNCTION_NAME", "f")
  let inside = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(inside.trace_id) == Some("Root=1-00000000-000000000000000000000000")
}

test "the account comes from AWS_ACCOUNT_ID and the endpoint mode from the environment" {
  os.env.set("HOME", "/h")
  os.env.set("AWS_REGION", "us-west-2")
  os.env.set("AWS_ACCESS_KEY_ID", "AKIDTEST0000000000")
  os.env.set("AWS_SECRET_ACCESS_KEY", "invented-secret")
  os.env.set("AWS_ACCOUNT_ID", "123456789012")
  os.env.set("AWS_ACCOUNT_ID_ENDPOINT_MODE", "required")
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(cfg.account_id_endpoint_mode) == Some("required")
  let cr = (cfg.credentials ?? return Err("no credentials")).retrieve()?
  expect(cr.account_id) == Some("123456789012")
}

test "checksum settings come from the environment, else the profile, and reject other values" {
  os.env.set("HOME", "/h")
  os.env.set("AWS_REGION", "us-west-2")
  os.env.set("AWS_ACCESS_KEY_ID", "AKIDTEST0000000000")
  os.env.set("AWS_SECRET_ACCESS_KEY", "invented-secret")
  os.fs.write("/h/.aws/config", b"[default]\nrequest_checksum_calculation = when_required\nresponse_checksum_validation = WHEN_REQUIRED\n")?
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(cfg.request_checksum_calculation) == Some("when_required")
  expect(cfg.response_checksum_validation) == Some("when_required")
  os.env.set("AWS_REQUEST_CHECKSUM_CALCULATION", "when_supported")
  let env_first = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  expect(env_first.request_checksum_calculation) == Some("when_supported")
  os.env.set("AWS_RESPONSE_CHECKSUM_VALIDATION", "sometimes")
  match load_default_config(os.env, os.fs, os.net, os.clock, os.rand) {
    Err(ConfigErr.Invalid(s, v, _)) => expect("${s}=${v}") == "AWS_RESPONSE_CHECKSUM_VALIDATION=sometimes"
    other => expect("${other:?}") == "Invalid"
  }
}

test "with no keys anywhere the chain ends at EC2 instance metadata, unless it is turned off" {
  os.env.set("HOME", "/h")
  os.env.set("AWS_REGION", "us-west-2")
  os.env.set("AWS_EC2_METADATA_SERVICE_ENDPOINT", "http://127.0.0.1:1338")
  os.net.handle("PUT http://127.0.0.1:1338/latest/api/token", fn(req: http.Request) -> http.Response { http.text(200, "tok") })
  os.net.handle("GET http://127.0.0.1:1338/latest/meta-data/iam/security-credentials/", fn(req: http.Request) -> http.Response { http.text(200, "role") })
  os.net.handle("GET http://127.0.0.1:1338/latest/meta-data/iam/security-credentials/role", fn(req: http.Request) -> http.Response {
    http.text(200, "{\"Code\":\"Success\",\"AccessKeyId\":\"ASIATEST0000000000\",\"SecretAccessKey\":\"s\",\"Token\":\"t\",\"Expiration\":\"2026-01-01T06:00:00Z\"}")
  })
  let cfg = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  let c = (cfg.credentials ?? return Err("no provider")).retrieve()?
  expect(c.source) == "EC2RoleProvider"
  os.env.set("AWS_EC2_METADATA_DISABLED", "true")
  let off = load_default_config(os.env, os.fs, os.net, os.clock, os.rand)?
  match (off.credentials ?? return Err("no provider")).retrieve() {
    Err(aws.CredentialsErr.NotFound(_)) => {}
    other => expect("${other:?}") == "NotFound"
  }
}
