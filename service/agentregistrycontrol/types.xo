pub enum ValidationExceptionReason: Str {
  CannotParse = "CannotParse"
  FieldValidationFailed = "FieldValidationFailed"
  IdempotentParameterMismatchException = "IdempotentParameterMismatchException"
  RootEventInOtherSession = "EventInOtherSession"
  ResourceConflict = "ResourceConflict"
  Unknown(value: Str)
}

/// The workload identity details associated with a source resource. Present
/// on the source details of a provenance entry when the upstream resource
/// has a workload identity configured.
pub struct WorkloadIdentityDetails {
  /// The Amazon Resource Name (ARN) of the workload identity associated with
  /// the source resource.
  pub workload_identity_arn: Str? = None
}
