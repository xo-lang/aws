/// Accepts the invitation to be a member account and get monitored by a
/// GuardDuty administrator account that sent the invitation.
pub fn (c: Client) accept_administrator_invitation(input: AcceptAdministratorInvitationRequest) -> AcceptAdministratorInvitationResponse ! AcceptAdministratorInvitationErr uses (net.dial, clock, rand) {
