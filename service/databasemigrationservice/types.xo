  pub network_type: Str? = None
}

/// This object provides a collection of statistics about a serverless
/// replication.
pub struct ReplicationStats {
  /// The percent complete for the full load serverless replication.
  pub full_load_progress_percent: Int? = None
  /// The elapsed time of the replication, in milliseconds.
  pub elapsed_time_millis: Int? = None
  /// The number of tables loaded for this replication.
  pub tables_loaded: Int? = None
  /// The number of tables currently loading for this replication.
  pub tables_loading: Int? = None
  /// The number of tables queued for this replication.
  pub tables_queued: Int? = None
  /// The number of errors that have occured for this replication.
  pub tables_errored: Int? = None
  /// The date the replication was started either with a fresh start or a
  /// target reload.
  pub fresh_start_date: Time? = None
  /// The date the replication is scheduled to start.
  pub start_date: Time? = None
  /// The date the replication was stopped.
  pub stop_date: Time? = None
  /// The date the replication full load was started.
  pub full_load_start_date: Time? = None
