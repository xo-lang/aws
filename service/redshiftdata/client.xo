fn json_of_query_records(v: QueryRecords) -> json.Value {
  match v {
    CsvRecords(x) => json.Value.Object([("CSVRecords", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_query_records(v: json.Value) -> QueryRecords ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "CSVRecords" => Ok(QueryRecords.CsvRecords(jsonv.read_str(fv)?))
      _ => Ok(QueryRecords.Unknown(k))
    }
  }
  Err("QueryRecords: no member set")
}

