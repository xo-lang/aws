/// Calls GetRunTask until the TaskRunning acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (600s).
pub fn wait_until_task_running(c: Client, input: GetRunTaskRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 600s) -> () ! waiter.WaitErr[GetRunTaskErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_run_task(input) {
      Ok(out) => {
        let o = jmes_of_get_run_task_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "RUNNING") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "PENDING") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "STARTING") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "CANCELLED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("TaskRunning: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until variant import is completed
///
/// Calls GetVariantImportJob until the VariantImportJobCreated acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (600s).
pub fn wait_until_variant_import_job_created(c: Client, input: GetVariantImportRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 600s) -> () ! waiter.WaitErr[GetVariantImportJobErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_variant_import_job(input) {
      Ok(out) => {
        let o = jmes_of_get_variant_import_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "SUBMITTED") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "IN_PROGRESS") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "CANCELLED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "COMPLETED") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("VariantImportJobCreated: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

