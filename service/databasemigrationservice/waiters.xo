/// Wait until testing connection succeeds.
///
/// Calls DescribeConnections until the TestConnectionSucceeds acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (120s).
pub fn wait_until_test_connection_succeeds(c: Client, input: DescribeConnectionsMessage, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeConnectionsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_connections(input) {
      Ok(out) => {
        let o = jmes_of_describe_connections_response(out)
        if state == "" && waiter.path_matches(o, "Connections[].Status", "allStringEquals", "successful") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Connections[].Status", "anyStringEquals", "failed") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("TestConnectionSucceeds: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
