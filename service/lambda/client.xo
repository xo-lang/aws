/// The events of InvokeWithResponseStream, read as they arrive. `output` has the
/// response's other members; close the stream when done with it.
pub struct InvokeWithResponseStreamEvents {
  pub output: InvokeWithResponseStreamResponse
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
}

/// The next event, None at the end of the stream.
pub fn (var s: InvokeWithResponseStreamEvents) next() -> InvokeWithResponseStreamResponseEvent? ! InvokeWithResponseStreamResponseEventErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(InvokeWithResponseStreamResponseEventErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              continue
            }
            return match event_invoke_with_response_stream_response_event(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(InvokeWithResponseStreamResponseEventErr.Read(msg))
            }
          }
          "exception" => return Err(exception_invoke_with_response_stream_response_event(m))
          _ => return Err(InvokeWithResponseStreamResponseEventErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
