fn json_of_row(v: Row) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.archived_message_id {
    fs.push(("ArchivedMessageId", json.Value.Str(x)))
  }
  if let Some(x) = v.received_timestamp {
    fs.push(("ReceivedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.date {
    fs.push(("Date", json.Value.Str(x)))
  }
  if let Some(x) = v.to {
    fs.push(("To", json.Value.Str(x)))
  }
  if let Some(x) = v.from_value {
    fs.push(("From", json.Value.Str(x)))
  }
  if let Some(x) = v.cc {
    fs.push(("Cc", json.Value.Str(x)))
  }
  if let Some(x) = v.subject {
    fs.push(("Subject", json.Value.Str(x)))
  }
  if let Some(x) = v.message_id {
    fs.push(("MessageId", json.Value.Str(x)))
  }
  if let Some(x) = v.has_attachments {
    fs.push(("HasAttachments", json.Value.Bool(x)))
  }
  if let Some(x) = v.received_headers {
    fs.push(("ReceivedHeaders", json_of_email_received_headers_list(x)))
  }
  if let Some(x) = v.in_reply_to {
    fs.push(("InReplyTo", json.Value.Str(x)))
  }
  if let Some(x) = v.x_mailer {
    fs.push(("XMailer", json.Value.Str(x)))
  }
  if let Some(x) = v.x_original_mailer {
    fs.push(("XOriginalMailer", json.Value.Str(x)))
  }
  if let Some(x) = v.x_priority {
    fs.push(("XPriority", json.Value.Str(x)))
  }
  if let Some(x) = v.ingress_point_id {
    fs.push(("IngressPointId", json.Value.Str(x)))
  }
  if let Some(x) = v.sender_hostname {
    fs.push(("SenderHostname", json.Value.Str(x)))
  }
  if let Some(x) = v.sender_ip_address {
    fs.push(("SenderIpAddress", json.Value.Str(x)))
  }
  if let Some(x) = v.envelope {
    fs.push(("Envelope", json_of_envelope(x)))
  }
  if let Some(x) = v.source_arn {
    fs.push(("SourceArn", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

