fn json_of_port_specification(v: PortSpecification) -> json.Value {
  match v {
    Port(x) => json.Value.Object([("port", json.Value.Int(x))])
    Range(x) => json.Value.Object([("range", json_of_port_range(x))])
    AllPorts => json.Value.Object([("allPorts", json.Value.Object([]))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_port_specification(v: json.Value) -> PortSpecification ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "port" => Ok(PortSpecification.Port(jsonv.read_int(fv)?))
      "range" => Ok(PortSpecification.Range(from_json_port_range(fv)?))
      "allPorts" => Ok(PortSpecification.AllPorts)
      _ => Ok(PortSpecification.Unknown(k))
    }
  }
  Err("PortSpecification: no member set")
}

