fn xml_write_key_signing_key(var w: xmlv.Writer, v: KeySigningKey, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.kms_arn {
    xmlv.elem(w, "KmsArn", x, [])
  }
  if let Some(x) = v.flag {
    xmlv.elem(w, "Flag", "${x}", [])
  }
  if let Some(x) = v.signing_algorithm_mnemonic {
    xmlv.elem(w, "SigningAlgorithmMnemonic", x, [])
  }
  if let Some(x) = v.signing_algorithm_type {
    xmlv.elem(w, "SigningAlgorithmType", "${x}", [])
  }
  if let Some(x) = v.digest_algorithm_mnemonic {
    xmlv.elem(w, "DigestAlgorithmMnemonic", x, [])
  }
  if let Some(x) = v.digest_algorithm_type {
    xmlv.elem(w, "DigestAlgorithmType", "${x}", [])
  }
  if let Some(x) = v.key_tag {
    xmlv.elem(w, "KeyTag", "${x}", [])
  }
  if let Some(x) = v.digest_value {
    xmlv.elem(w, "DigestValue", x, [])
  }
  if let Some(x) = v.public_key {
    xmlv.elem(w, "PublicKey", x, [])
  }
  if let Some(x) = v.ds_record {
    xmlv.elem(w, "DSRecord", x, [])
  }
  if let Some(x) = v.dnskey_record {
    xmlv.elem(w, "DNSKEYRecord", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.status_message {
    xmlv.elem(w, "StatusMessage", x, [])
  }
  if let Some(x) = v.created_date {
    xmlv.elem(w, "CreatedDate", rest.date_time(x), [])
  }
  if let Some(x) = v.last_modified_date {
    xmlv.elem(w, "LastModifiedDate", rest.date_time(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_key_signing_key(e: xml.Element) -> KeySigningKey ! Str {
  var out = KeySigningKey{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Name" => out.name = c.text()
      "KmsArn" => out.kms_arn = c.text()
      "Flag" => out.flag = xmlv.read_int(c.text())?
      "SigningAlgorithmMnemonic" => out.signing_algorithm_mnemonic = c.text()
      "SigningAlgorithmType" => out.signing_algorithm_type = xmlv.read_int(c.text())?
      "DigestAlgorithmMnemonic" => out.digest_algorithm_mnemonic = c.text()
      "DigestAlgorithmType" => out.digest_algorithm_type = xmlv.read_int(c.text())?
      "KeyTag" => out.key_tag = xmlv.read_int(c.text())?
      "DigestValue" => out.digest_value = c.text()
      "PublicKey" => out.public_key = c.text()
      "DSRecord" => out.ds_record = c.text()
      "DNSKEYRecord" => out.dnskey_record = c.text()
      "Status" => out.status = c.text()
      "StatusMessage" => out.status_message = c.text()
      "CreatedDate" => out.created_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "LastModifiedDate" => out.last_modified_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

