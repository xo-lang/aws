fn xml_write_multi_region_access_point_report(var w: xmlv.Writer, v: MultiRegionAccessPointReport, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.alias {
    xmlv.elem(w, "Alias", x, [])
  }
  if let Some(x) = v.created_at {
    xmlv.elem(w, "CreatedAt", rest.date_time(x), [])
  }
  if let Some(x) = v.public_access_block {
    xml_write_public_access_block_configuration(w, x, "PublicAccessBlock", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.regions {
    xml_write_region_report_list(w, x, "Regions", [])
  }
  xmlv.end(w, name)
}

fn xml_read_multi_region_access_point_report(e: xml.Element) -> MultiRegionAccessPointReport ! Str {
  var out = MultiRegionAccessPointReport{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Name" => out.name = c.text()
      "Alias" => out.alias = c.text()
      "CreatedAt" => out.created_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PublicAccessBlock" => out.public_access_block = xml_read_public_access_block_configuration(c)?
      "Status" => out.status = MultiRegionAccessPointStatus.from(c.text())
      "Regions" => out.regions = xml_read_region_report_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

