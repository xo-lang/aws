fn json_of_service(v: Service) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.service_arn {
    fs.push(("serviceArn", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.associated_systems {
    fs.push(("associatedSystems", json_of_associated_system_list(x)))
  }
  if let Some(x) = v.policy_arn {
    fs.push(("policyArn", json.Value.Str(x)))
  }
  if let Some(x) = v.regions {
    fs.push(("regions", json_of_region_list(x)))
  }
  if let Some(x) = v.permission_model {
    fs.push(("permissionModel", json_of_permission_model(x)))
  }
  if let Some(x) = v.dependency_discovery {
    fs.push(("dependencyDiscovery", json_of_dependency_discovery_config(x)))
  }
  if let Some(x) = v.effective_policy_values {
    fs.push(("effectivePolicyValues", json_of_effective_policy_values(x)))
  }
  if let Some(x) = v.achievability {
    fs.push(("achievability", json_of_achievability(x)))
  }
  if let Some(x) = v.report_configuration {
    fs.push(("reportConfiguration", json_of_service_report_configuration(x)))
  }
  if let Some(x) = v.kms_key_id {
    fs.push(("kmsKeyId", json.Value.Str(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tag_map(x)))
  }
  if let Some(x) = v.estimated_assessment_cost {
    fs.push(("estimatedAssessmentCost", json_of_assessment_cost(x)))
  }
  if let Some(x) = v.resource_discovery {
    fs.push(("resourceDiscovery", json_of_resource_discovery_status(x)))
  }
  if let Some(x) = v.assessment_status {
    fs.push(("assessmentStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.rerun_assessment {
    fs.push(("rerunAssessment", json.Value.Bool(x)))
  }
  if let Some(x) = v.open_findings_count {
    fs.push(("openFindingsCount", json.Value.Int(x)))
  }
  if let Some(x) = v.resolved_findings_count {
    fs.push(("resolvedFindingsCount", json.Value.Int(x)))
  }
  if let Some(x) = v.organization_id {
    fs.push(("organizationId", json.Value.Str(x)))
  }
  if let Some(x) = v.ou_id {
    fs.push(("ouId", json.Value.Str(x)))
  }
  if let Some(x) = v.account_id {
    fs.push(("accountId", json.Value.Str(x)))
  }
  if let Some(x) = v.dev_ops_agent_configuration {
    fs.push(("devOpsAgentConfiguration", json_of_dev_ops_agent_configuration_view(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("updatedAt", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_service(v: json.Value) -> Service ! Str {
  var out = Service{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "serviceArn" => out.service_arn = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "associatedSystems" => out.associated_systems = from_json_associated_system_list(fv)?
      "policyArn" => out.policy_arn = jsonv.read_str(fv)?
      "regions" => out.regions = from_json_region_list(fv)?
      "permissionModel" => out.permission_model = from_json_permission_model(fv)?
      "dependencyDiscovery" => out.dependency_discovery = from_json_dependency_discovery_config(fv)?
      "effectivePolicyValues" => out.effective_policy_values = from_json_effective_policy_values(fv)?
      "achievability" => out.achievability = from_json_achievability(fv)?
      "reportConfiguration" => out.report_configuration = from_json_service_report_configuration(fv)?
      "kmsKeyId" => out.kms_key_id = jsonv.read_str(fv)?
      "tags" => out.tags = from_json_tag_map(fv)?
      "estimatedAssessmentCost" => out.estimated_assessment_cost = from_json_assessment_cost(fv)?
      "resourceDiscovery" => out.resource_discovery = from_json_resource_discovery_status(fv)?
      "assessmentStatus" => out.assessment_status = AssessmentStatus.from(jsonv.read_str(fv)?)
      "rerunAssessment" => out.rerun_assessment = jsonv.read_bool(fv)?
      "openFindingsCount" => out.open_findings_count = jsonv.read_int(fv)?
      "resolvedFindingsCount" => out.resolved_findings_count = jsonv.read_int(fv)?
      "organizationId" => out.organization_id = jsonv.read_str(fv)?
      "ouId" => out.ou_id = jsonv.read_str(fv)?
      "accountId" => out.account_id = jsonv.read_str(fv)?
      "devOpsAgentConfiguration" => out.dev_ops_agent_configuration = from_json_dev_ops_agent_configuration_view(fv)?
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "updatedAt" => out.updated_at = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
}

