  var qs: List[(Str, Str)] = []
  let label_id = match input.id {
    Some(v) => v
    None => return Err("input member id is required")
  }
  if label_id == "" {
    return Err("input member id must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = input.access_role_arn {
    fs.push(("accessRoleArn", json.Value.Str(x)))
  }
  if let Some(x) = input.outputs {
    fs.push(("outputs", json_of_update_output_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PUT",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/v1/feed/${rest.escape(label_id, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_update_feed(resp: http.Response) -> UpdateFeedResponse ! Str {
  var out = UpdateFeedResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "arn" => out.arn = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "id" => out.id = jsonv.read_str(fv)?
      "dataEndpoints" => out.data_endpoints = from_json_string_list(fv)?
      "outputs" => out.outputs = from_json_get_output_list(fv)?
      "accessRoleArn" => out.access_role_arn = jsonv.read_str(fv)?
      "status" => out.status = FeedStatus.from(jsonv.read_str(fv)?)
      "association" => out.association = from_json_feed_association(fv)?
      "tags" => out.tags = from_json_tag_map(fv)?
