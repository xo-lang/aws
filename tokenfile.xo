// A token kept in a file that something else rotates: the EKS service
// account token of IRSA (AWS_WEB_IDENTITY_TOKEN_FILE) and of EKS Pod
// Identity (AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE), and the SSO token
// cache (~/.aws/sso/cache), which the SDK itself refreshes and writes
// back.
//
// aws-sdk-go-v2 reads the file at every credentials refresh. Here a
// provider's `retrieve` has no file effect, so the file is read when it
// is loaded and read again (or written back after `set`) by a watch on
// a background task. The type lives in the root, which reaches no files
// (decision 0011); the credentials module reads and watches the file
// (`credentials.load_token_file`, `credentials.watch`), and
// `config.watch_token_files(cfg, os.tasks, os.fs, os.clock)` starts the
// watches of the files `config.load_default_config` read.

/// A token from a file; copies share the token.
pub struct TokenFile {
  pub path: Str
  token: Mutex[Secret[Str]]
  /// Set by `set`: the watch writes the file instead of reading it.
  dirty: Atomic[Bool]
}

/// The token file at `path` holding `token`, as read from it (the
/// credentials module reads it).
pub fn token_file(path: Str, token: Secret[Str]) -> TokenFile {
  TokenFile{path: path, token: Mutex.new(token), dirty: Atomic.new(false)}
}

/// A token file holding `token`, for tests and for tokens from elsewhere.
pub fn fixed_token(token: Str) -> TokenFile {
  token_file("", Secret.new(token))
}

/// The token as last read.
pub fn (t: TokenFile) get() -> Secret[Str] {
  t.token.with_read(fn(s: Secret[Str]) -> Secret[Str] { s })
}

/// Replaces the token (a refreshed SSO token); the watch writes it to
/// the file.
pub fn (t: TokenFile) set(token: Str) {
  t.token.reset(Secret.new(token))
  t.dirty.set(true)
}

/// Replaces the token with one read from the file (not to be written
/// back).
pub fn (t: TokenFile) loaded(token: Secret[Str]) {
  t.token.reset(token)
}

/// Whether `set` changed the token since the file was last written, and
/// clears the mark; a failed write puts it back with `mark_dirty`.
pub fn (t: TokenFile) take_dirty() -> Bool {
  t.dirty.swap(false)
}

pub fn (t: TokenFile) mark_dirty() {
  t.dirty.set(true)
}

/// Whether the token waits to be written to the file.
pub fn (t: TokenFile) is_dirty() -> Bool {
  t.dirty.get()
}
