}

pub enum Separator: Str {
  Comma = "comma"
  Ctrla = "ctrla"
  Pipe = "pipe"
  Semicolon = "semicolon"
  Tab = "tab"
  Unknown(value: Str)
}

/// Information about a serialization/deserialization program (SerDe) that
