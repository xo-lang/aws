/// Input for UpdateCampaignAsset operation.
pub struct UpdateCampaignAssetRequest {
  /// The catalog (AWS or Sandbox).
  pub catalog: Catalog? = None
  /// The campaign identifier.
  pub campaign_identifier: Str? = None
  /// The asset identifier.
  pub campaign_asset_identifier: Str? = None
  /// Value-only updates to the asset's pinned template fields, keyed by
  /// FieldId. The field schema (labels, descriptions, constraints,
  /// placeholders, image defaults) is service-owned and pinned at
  /// instantiation, so clients send only the values they are changing. Fields
  /// omitted keep their stored values; send the entry with `Value` omitted to
  /// clear one. Named `FieldValues` to match the member it edits on
  /// `CampaignAsset`, which is the same concept read back. It was
  /// `templateFieldUpdates`; the two names for one concept were the defect,
  /// not the length.
  pub field_values: List[FieldValueInput]? = None
  /// Selects a multi-layout asset's layout: one of the values in
  /// `CampaignAsset.layout.options`. PATCH: omitted leaves the selection
  /// unchanged, and there is no way to clear it. A value that is not one of
  /// the asset's options — or any value on a single-layout asset — is a
  /// plain `ValidationException`, and nothing in the call is applied. Every
  /// pinned field stays writable whichever layout is selected.
  pub layout: Str? = None
  /// When a **sendable** asset (`EMAIL`, `SOCIAL_POST`) sends: on activation,
  /// or at `ScheduledSendAt`. A mode beside a value rather than a union, on
  /// purpose: `ScheduledSendAt` stays a plain `Timestamp`, and the precedent
  /// is EventBridge Scheduler's `FlexibleTimeWindow { Mode,
  /// MaximumWindowInMinutes }`. The pair is checked as one, and a request
  /// where they disagree is refused with `ValidationException`
  /// (`INVALID_VALUE`, naming the member) and applies nothing: - `SCHEDULED`
  /// requires `ScheduledSendAt`; a reschedule resends `SCHEDULED` with the
  /// new time; - `ON_ACTIVATION` forbids `ScheduledSendAt`, and drops any
  /// time already stored; - `ScheduledSendAt` without `SendMode` is refused.
  /// PATCH: omitted leaves both unchanged. Until a mode is chosen the asset
  /// reports `SEND_MODE_MISSING` and does not activate: no default, because
  /// an unchosen send mails the real audience. Rejected with
  /// `ValidationException` (`NOT_SUPPORTED_FOR_CATEGORY`) for a category that
  /// has no send (`LANDING_PAGE`, `DOCUMENT`, `BANNER_AD`). Like every other
  /// edit, it reaches the delivery platform at the asset's next activation,
  /// and a live email or social post refuses it (`ASSET_ALREADY_ACTIVE`):
  /// deactivate first.
  pub send_mode: SendMode? = None
  /// The send time, with `SendMode: SCHEDULED` and only then. See `SendMode`.
  /// Must be at least an hour out (`SEND_WINDOW_TOO_SOON`), unless it is the
  /// time already stored: resending the stored mode and time changes nothing
  /// and is accepted, so a form that always resubmits does not trip the
  /// window. Must also fall on or before the campaign's `EndOn` (by the end
  /// of that UTC day): refused with `ValidationException` (`INVALID_VALUE`)
  /// otherwise, so nothing is scheduled to send after the campaign completes.
  /// Was `scheduleDate`, a `YYYY-MM-DD` string. Retyped because a date alone
  /// cannot express a send *time*, which is the whole point of a schedule —
  /// and because the resource already spelled the same concept
  /// `ScheduledSendAt` on the activation responses. Two spellings of one
  /// concept on one resource was the defect.
  pub scheduled_send_at: Time? = None
  /// Idempotency token. Retry-safety only — this is **not** a concurrency
  /// token, and sequential edits to one field are last-writer-wins.
  pub client_token: Str? = None
}

/// Output for UpdateCampaignAsset. A minimal acknowledgment, not an echo.
/// Read GetCampaignAsset for the applied values (`FieldValues`).
pub struct UpdateCampaignAssetResponse {
  /// The asset identifier.
  pub id: Str? = None
  /// The asset's state, **unchanged**. An update never moves it, so a live
  /// asset stays ACTIVE while its edited values take effect for the next
  /// activation. There is no edit-outcome member: a 200 means every submitted
  /// value applied, and every failure is a refusal on the call itself (DG-040
  /// Decision 11).
  pub state: CampaignAssetState? = None
  /// What must be fixed on this asset before it can be activated. Empty when
  /// the asset is ready. Issues don't block saving: an asset can be saved
  /// incomplete and fixed over several updates.
  /// `StartCampaignAssetActivationTask` refuses an asset that still has
  /// issues: an issue blocks activation when only an edit to the asset can
  /// change the outcome. Most issues name the field to fix in `FieldId`. Fix
  /// it with `UpdateCampaignAsset`, then read this list again. Besides the
  /// issues computed from the asset's content, the list carries what the last
  /// activation found: `CONTENT_REJECTED` and `PARTNER_IMAGE_REJECTED` when
  /// moderation refused a field. Editing that field removes its issue. A
  /// `CONTENT_REJECTED` without a `FieldId` means the text was refused as a
  /// whole; editing any text field removes it. Problems with the campaign's
  /// own settings, such as a missing recipient list, and with the partner's
  /// profile, such as a missing logo, are reported on
  /// `Campaign.ActivationIssues`, not here.
  pub activation_issues: List[ActivationIssue]? = None
}

/// Input for UpdateCampaign operation.
pub struct UpdateCampaignRequest {
  /// The catalog (AWS or Sandbox).
  pub catalog: Catalog? = None
  /// The campaign identifier.
  pub campaign_identifier: Str? = None
  /// The display name.
  pub name: Str? = None
  /// Sets or replaces the address the campaign's emails are sent from.
  /// Checked by the same three rules as on `CreateCampaign`, with the same
  /// codes, but only when it differs, ignoring case, from the stored sender:
  /// re-sending the stored one is not checked, and
  /// `StartCampaignAssetActivationTask` re-checks it before an email
  /// activates. Replaces, never clears: like every member of this operation,
  /// an omitted value leaves the sender as it was, and there is no way to
  /// remove one once set.
  pub sender_email: Str? = None
  /// Sets or replaces the URL of the partner's privacy policy. Replaces,
  /// never clears.
  pub privacy_policy_url: Str? = None
  /// Sets or replaces the partner's postal address. Replaces, never clears.
  pub partner_address: Str? = None
  /// Sets or replaces the partner's badge, checked exactly as on
  /// `CreateCampaign`. Replaces, never clears: upload the Standalone AWS
  /// Partner badge to show it again. The badge an asset already published
  /// keeps showing on it until that asset is activated again.
  pub partner_badge: FileRef? = None
  /// Replaces the campaign's attached recipient list. The referenced object
  /// is copied and pinned again on every call that supplies it, so the pinned
  /// copy always reflects the *last* `UpdateCampaign` that named one. Editing
  /// the source object in your own bucket without calling this operation
  /// again has no effect. Replaces, never detaches: a partner can swap the
  /// list but cannot remove it.
  pub email_target: FileRef? = None
  /// Engagement groups whose contacts the campaign's emails will also go to
  /// (see `CreateCampaign`). Replaces the stored list; never clears it. As on
  /// `CreateCampaign`: each group once (`INVALID_VALUE` otherwise), not
  /// checked against your groups when saved, and resolved at Start where the
  /// stage can (`ENGAGEMENT_GROUPS_UNAVAILABLE` where it can't).
  pub email_target_engagement_group_ids: List[Str]? = None
  /// Sets the account the campaign's social posts publish from, per platform.
  /// Each platform named replaces that platform's choice; a platform not
  /// named keeps its own. Replaces, never clears. Not checked against your
  /// connections here: a connection can be deleted at any time, so the
  /// activation checks the choice. See `Campaign$SocialConnections`.
  pub social_connections: Map[Str, List[Str]]? = None
  /// What the partner expects the campaign to cost.
  pub estimated_budget: MonetaryValue? = None
  /// The campaign's total budget.
  pub total_budget: MonetaryValue? = None
  /// Target audience configuration.
  pub target_audience: TargetAudience? = None
  /// Idempotency token. Accepted and not stored: this is a change-only
  /// partial update with last-writer-wins, so re-applying the same call
  /// produces the same result and the same response. There is nothing a
  /// replay cache would protect.
  pub client_token: Str? = None
  /// The first day of the campaign's run window. Not after `EndOn`
  /// (`ValidationException`, `INVALID_VALUE`).
  pub start_on: Str? = None
  /// The last day of the campaign's run window, inclusive and in UTC.
  /// Editable only while the campaign is open, like everything else here:
  /// once the stored `EndOn` has passed the campaign is completed and this
  /// update is refused (`CAMPAIGN_COMPLETED`). Refused with
  /// `ValidationException` (`INVALID_VALUE`) when it is in the past, or
  /// earlier than the day of a scheduled send on one of the campaign's
  /// assets: move or cancel that send first. Setting it to today ends the
  /// campaign at the next UTC midnight.
  pub end_on: Str? = None
}

/// Output for UpdateCampaign.
pub struct UpdateCampaignResponse {
  /// The campaign identifier.
  pub id: Str? = None
}

/// The input fails to satisfy the constraints specified by the service. A
/// caller branches on `Reason`, and where the rejection is attributable to
/// particular fields it reads `FieldList` rather than parsing `Message`,
/// which is prose and may change.
pub struct ValidationException {
  /// Error message.
  pub message: Str? = None
  /// The single coarse reason the request was rejected, for a caller that
  /// does not care which field.
  pub reason: ValidationExceptionReason? = None
  /// Every field that failed, not just the first. ⚠️ **Every field,
  /// deliberately.** The convention comment carried by most internal models
  /// — *"if more than one field caused the error, pick one and elaborate in
  /// the message"* — is the reading this service does NOT take: a partner
  /// editing a form would then discover their errors one request at a time.
  /// The whole request is validated and the full set reported, so one round
  /// of fixes is one call. Each entry names a member of the request just sent
  /// , and only that: the value to change and send again. A template field
  /// value is `Name` `FieldValues` with the template field in `FieldId`, one
  /// entry per failing field. When it is present. Only when the refusal
  /// points at something the partner fixes in a form, and then every such
  /// refusal carries it: - `UpdateCampaignAsset`: `FieldValues` (including a
  /// file the content scan declined, which is why a partner handles image
  /// failures and text failures the same way, through this list), `Layout`,
  /// `SendMode` and `ScheduledSendAt`; - `CreateCampaign` and
  /// `UpdateCampaign`: campaign settings and files; - `GetCampaignTemplate`:
  /// `Identifier`. Every other `ValidationException` carries `Message` only
  /// — tags, ARNs, social connections, exports, and `CAMPAIGN_INCOMPLETE`,
  /// whose missing settings are not members of the request it refuses.
  pub field_list: List[ValidationExceptionField]? = None
}

/// A field that failed validation.
pub struct ValidationExceptionField {
  /// The member of the request that failed, as the request names it:
  /// `FieldValues` for a template field value, `Layout`, `EmailTarget`,
  /// `Identifier`, and so on. It is never a template field id: a template
  /// field is always `FieldValues`, with the field in `FieldId`.
  pub name: Str? = None
  /// The template field that failed, when `Name` is `FieldValues`; absent
  /// otherwise.
  pub field_id: Str? = None
  /// Why this field failed, in prose a partner can be shown directly.
  pub message: Str? = None
  /// Why this field failed, as a value a client branches on. Read this rather
  /// than `Message`.
  pub code: ValidationExceptionFieldCode? = None
}

/// Why one field was refused. A modeled enum rather than a free string
/// because a client branches on it — a partner UI highlights the field
/// and picks its own wording, which it cannot do from prose.
/// `partnercentralbenefits` models its `ValidationExceptionField$Code` the
/// same way.
pub enum ValidationExceptionFieldCode: Str {
  ValueTooShort = "VALUE_TOO_SHORT"
  ValueTooLong = "VALUE_TOO_LONG"
  PatternMismatch = "PATTERN_MISMATCH"
  DisallowedHtmlTag = "DISALLOWED_HTML_TAG"
  WrongValueType = "WRONG_VALUE_TYPE"
  FileReferenceInvalid = "FILE_REFERENCE_INVALID"
  FileReferenceNotOwned = "FILE_REFERENCE_NOT_OWNED"
  ImageFormatNotSupported = "IMAGE_FORMAT_NOT_SUPPORTED"
  ImageFormatNotAllowed = "IMAGE_FORMAT_NOT_ALLOWED"
  ImageTooLarge = "IMAGE_TOO_LARGE"
  FileTooLarge = "FILE_TOO_LARGE"
  ScanRejected = "SCAN_REJECTED"
  UnknownField = "UNKNOWN_FIELD"
  ImageAspectRatioMismatch = "IMAGE_ASPECT_RATIO_MISMATCH"
  FieldSetOnCampaign = "FIELD_SET_ON_CAMPAIGN"
  EmailColumnMissing = "EMAIL_COLUMN_MISSING"
  RecipientListTooLarge = "RECIPIENT_LIST_TOO_LARGE"
  RecipientListEmpty = "RECIPIENT_LIST_EMPTY"
  InvalidValue = "INVALID_VALUE"
  NotSupportedForCategory = "NOT_SUPPORTED_FOR_CATEGORY"
  RecipientListNotUtf8 = "RECIPIENT_LIST_NOT_UTF8"
  FieldFromPartnerProfile = "FIELD_FROM_PARTNER_PROFILE"
  CopySourceInvalid = "COPY_SOURCE_INVALID"
  SenderDomainNotAllianceLead = "SENDER_DOMAIN_NOT_ALLIANCE_LEAD"
  SenderDomainDkimMissing = "SENDER_DOMAIN_DKIM_MISSING"
  SenderDomainDmarcMissing = "SENDER_DOMAIN_DMARC_MISSING"
  PartnerBadgeNotEligible = "PARTNER_BADGE_NOT_ELIGIBLE"
  Unknown(value: Str)
}

/// Why the request failed validation, coarsely. Matches the shape
/// `partnercentralbenefits` ships (`ValidationException$Reason`) so a
/// client that already reads one Partner Central API's validation errors
/// reads this one the same way.
pub enum ValidationExceptionReason: Str {
  FieldValidationFailed = "FIELD_VALIDATION_FAILED"
  CannotParse = "CANNOT_PARSE"
  Other = "OTHER"
  CampaignIncomplete = "CAMPAIGN_INCOMPLETE"
  Unknown(value: Str)
}
