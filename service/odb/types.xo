/// The source of the password for an Autonomous Database wallet.
pub enum WalletPasswordSource: Str {
  CustomerManagedAwsSecret = "CUSTOMER_MANAGED_AWS_SECRET"
  ApiRequestParameter = "API_REQUEST_PARAMETER"
  Unknown(value: Str)
}

/// The configuration of the wallet password source. This is a union, so
/// only one of the following members can be specified.
pub enum WalletPasswordSourceConfiguration {
  CustomerManagedAwsSecret(value: CustomerManagedAwsSecretConfiguration)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// The input configuration for the wallet password source. This is a union,
/// so only one of the following members can be specified.
pub enum WalletPasswordSourceConfigurationInput {
  CustomerManagedAwsSecret(value: CustomerManagedAwsSecretConfigurationInput)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// A summary of the password source configuration for an Autonomous
/// Database wallet.
pub struct WalletPasswordSourceSummary {
  /// The source of the password for the Autonomous Database wallet.
  pub password_source: WalletPasswordSource? = None
  /// The configuration of the password source for the Autonomous Database
  /// wallet.
  pub password_source_configuration: WalletPasswordSourceConfiguration? = None
}

pub enum WalletType: Str {
  Regional = "REGIONAL"
  Instance = "INSTANCE"
  Unknown(value: Str)
}

/// The configuration for Zero-ETL access from the ODB network.
pub struct ZeroEtlAccess {
  /// The status of the Zero-ETL access.
  pub status: ManagedResourceStatus? = None
  /// The CIDR block for the Zero-ETL access.
  pub cidr: Str? = None
}

pub enum CharacterSetType: Str {
  Database = "DATABASE"
  National = "NATIONAL"
  Unknown(value: Str)
}
