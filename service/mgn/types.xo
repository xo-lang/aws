  pub source_server_id: Str? = None
  /// Replication type to which to update source server.
  pub replication_type: Str? = None
  /// Account ID on which to update replication type.
  pub account_id: Str? = None
}

pub struct UpdateSourceServerRequest {
  /// Update Source Server request account ID.
  pub account_id: Str? = None
  /// Update Source Server request source server ID.
  pub source_server_id: Str? = None
  /// Update Source Server request connector action.
  pub connector_action: SourceServerConnectorAction? = None
  /// Update Source Server request user provided ID.
  pub user_provided_id: Str? = None
  /// Update Source Server request FQDN for action framework.
  pub fqdn_for_action_framework: Str? = None
  /// Update Source Server request platform operating system.
  pub platform: Str? = None
}

pub struct UpdateWaveRequest {
  /// Wave ID.
  pub wave_id: Str? = None
  /// Wave name.
  pub name: Str? = None
  /// Wave description.
  pub description: Str? = None
  /// Account ID.
  pub account_id: Str? = None
}

/// Validate exception.
pub struct ValidationException {
  pub message: Str? = None
  pub code: Str? = None
  /// Validate exception reason.
  pub reason: Str? = None
  /// Validate exception field list.
  pub field_list: List[ValidationExceptionField]? = None
}

/// Validate exception field.
pub struct ValidationExceptionField {
  /// Validate exception field name.
  pub name: Str? = None
  /// Validate exception field message.
  pub message: Str? = None
}

/// vCenter client.
pub struct VcenterClient {
  /// ID of vCenter client.
  pub vcenter_client_id: Str? = None
  /// Arn of vCenter client.
  pub arn: Str? = None
  /// Hostname of vCenter client .
  pub hostname: Str? = None
  /// Vcenter UUID of vCenter client.
  pub vcenter_uuid: Str? = None
  /// Datacenter name of vCenter client.
  pub datacenter_name: Str? = None
  /// Last seen time of vCenter client.
  pub last_seen_datetime: Str? = None
  /// Tags for Source Server of vCenter client.
  pub source_server_tags: Map[Str, Str]? = None
  /// Tags for vCenter client.
  pub tags: Map[Str, Str]? = None
}

pub struct Wave {
  /// Wave ID.
  pub wave_id: Str? = None
  /// Wave ARN.
  pub arn: Str? = None
  /// Wave name.
  pub name: Str? = None
  /// Wave description.
  pub description: Str? = None
  /// Wave archival status.
  pub is_archived: Bool? = None
  /// Wave aggregated status.
  pub wave_aggregated_status: WaveAggregatedStatus? = None
  /// Wave creation dateTime.
  pub creation_date_time: Str? = None
  /// Wave last modified dateTime.
  pub last_modified_date_time: Str? = None
  /// Wave tags.
  pub tags: Map[Str, Str]? = None
}

/// Wave aggregated status.
pub struct WaveAggregatedStatus {
  /// Wave aggregated status last update dateTime.
  pub last_update_date_time: Str? = None
  /// DateTime marking when the first source server in the wave started
  /// replication.
  pub replication_started_date_time: Str? = None
  /// Wave aggregated status health status.
  pub health_status: Str? = None
  /// Wave aggregated status progress status.
  pub progress_status: Str? = None
  /// Wave aggregated status total applications amount.
  pub total_applications: Int? = None
}
