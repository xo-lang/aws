  var out = Row{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ArchivedMessageId" => out.archived_message_id = jsonv.read_str(fv)?
      "ReceivedTimestamp" => out.received_timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "Date" => out.date = jsonv.read_str(fv)?
      "To" => out.to = jsonv.read_str(fv)?
      "From" => out.from_value = jsonv.read_str(fv)?
      "Cc" => out.cc = jsonv.read_str(fv)?
      "Subject" => out.subject = jsonv.read_str(fv)?
      "MessageId" => out.message_id = jsonv.read_str(fv)?
      "HasAttachments" => out.has_attachments = jsonv.read_bool(fv)?
      "ReceivedHeaders" => out.received_headers = from_json_email_received_headers_list(fv)?
      "InReplyTo" => out.in_reply_to = jsonv.read_str(fv)?
      "XMailer" => out.x_mailer = jsonv.read_str(fv)?
      "XOriginalMailer" => out.x_original_mailer = jsonv.read_str(fv)?
      "XPriority" => out.x_priority = jsonv.read_str(fv)?
      "IngressPointId" => out.ingress_point_id = jsonv.read_str(fv)?
      "SenderHostname" => out.sender_hostname = jsonv.read_str(fv)?
      "SenderIpAddress" => out.sender_ip_address = jsonv.read_str(fv)?
      "Envelope" => out.envelope = from_json_envelope(fv)?
