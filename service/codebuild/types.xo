/// Information about a test case created using a framework such as NUnit or
/// Cucumber. A test case might be a unit test or a configuration test.
pub struct TestCase {
  /// The ARN of the report to which the test case belongs.
  pub report_arn: Str? = None
  /// The path to the raw data file that contains the test result.
  pub test_raw_data_path: Str? = None
  /// A string that is applied to a series of related test cases. CodeBuild
  /// generates the prefix. The prefix depends on the framework used to
  /// generate the tests.
  pub prefix: Str? = None
  /// The name of the test case.
  pub name: Str? = None
  /// The status returned by the test case after it was run. Valid statuses
  /// are SUCCEEDED , FAILED , ERROR , SKIPPED , and UNKNOWN .
  pub status: Str? = None
  /// The number of nanoseconds it took to run this test case.
  pub duration_in_nano_seconds: Int? = None
  /// A message associated with a test case. For example, an error message or
  /// stack trace.
  pub message: Str? = None
  /// The date and time a test case expires. A test case expires 30 days after
  /// it is created. An expired test case is not available to view in
  /// CodeBuild.
  pub expired: Time? = None
  /// The name of the test suite that the test case is a part of.
  pub test_suite_name: Str? = None
}

/// A filter used to return specific types of test cases. In order to pass
/// the filter, the report must meet all of the filter properties.
pub struct TestCaseFilter {
  /// The status used to filter test cases. A TestCaseFilter can have one
  /// status. Valid values are: SUCCEEDED FAILED ERROR SKIPPED UNKNOWN
  pub status: Str? = None
  /// A keyword that is used to filter on the name or the prefix of the test
  /// cases. Only test cases where the keyword is a substring of the name or
  /// the prefix will be returned.
  pub keyword: Str? = None
}

/// Information about a test report.
pub struct TestReportSummary {
  /// The number of test cases in this TestReportSummary . The total includes
  /// truncated test cases.
  pub total: Int? = None
  /// A map that contains the number of each type of status returned by the
  /// test results in this TestReportSummary .
  pub status_counts: Map[Str, Int]? = None
  /// The number of nanoseconds it took to run all of the test cases in this
  /// report.
  pub duration_in_nano_seconds: Int? = None
}

