  xmlv.start(w, name, attrs)
  if let Some(x) = v.record_expiration {
    xml_write_record_expiration(w, x, "RecordExpiration", [])
  }
  if let Some(x) = v.encryption_configuration {
    xml_write_metadata_table_encryption_configuration(w, x, "EncryptionConfiguration", [])
  }
  xmlv.end(w, name)
}

fn xml_read_journal_table_configuration(e: xml.Element) -> JournalTableConfiguration ! Str {
  var out = JournalTableConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "RecordExpiration" => out.record_expiration = xml_read_record_expiration(c)?
      "EncryptionConfiguration" => out.encryption_configuration = xml_read_metadata_table_encryption_configuration(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_journal_table_configuration_result(var w: xmlv.Writer, v: JournalTableConfigurationResult, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.table_status {
    xmlv.elem(w, "TableStatus", x, [])
