  pub dt: Float? = None
  /// Azimuth angle at the specified time. Valid ranges by unit: DEGREE_ANGLE
  /// : -180 to 360 degrees, measured clockwise from true north RADIAN : -π
  /// to 2π radians, measured clockwise from true north
  pub az: Float? = None
  /// Elevation angle at the specified time. Valid ranges by unit:
  /// DEGREE_ANGLE : -90 to 90 degrees, where 0 is the horizon, 90 is zenith,
  /// and negative values are below the horizon RADIAN : -π/2 to π/2
  /// radians, where 0 is the horizon, π/2 is zenith, and negative values are
  /// below the horizon
  pub el: Float? = None
}

