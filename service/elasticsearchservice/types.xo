  /// This flag, when set to True, indicates that an Upgrade Eligibility Check
  /// needs to be performed. This will not actually perform the Upgrade.
  pub perform_check_only: Bool? = None
  /// The deployment strategy override used for the upgrade.
  pub deployment_strategy_options: DeploymentStrategyOverrideOptions? = None
  pub change_progress_details: ChangeProgressDetails? = None
}

/// History of the last 10 Upgrades and Upgrade Eligibility Checks.
pub struct UpgradeHistory {
  /// A string that describes the update briefly
  pub upgrade_name: Str? = None
  /// UTC Timestamp at which the Upgrade API call was made in
  /// "yyyy-MM-ddTHH:mm:ssZ" format.
  pub start_timestamp: Time? = None
  /// The overall status of the update. The status can take one of the
  /// following values: In Progress Succeeded Succeeded with Issues Failed
  pub upgrade_status: UpgradeStatus? = None
  /// A list of UpgradeStepItem s representing information about each step
  /// performed as pard of a specific Upgrade or Upgrade Eligibility Check.
  pub steps_list: List[UpgradeStepItem]? = None
}

pub enum UpgradeStatus: Str {
  InProgress = "IN_PROGRESS"
  Succeeded = "SUCCEEDED"
  SucceededWithIssues = "SUCCEEDED_WITH_ISSUES"
  Failed = "FAILED"
  Unknown(value: Str)
}

pub enum UpgradeStep: Str {
  PreUpgradeCheck = "PRE_UPGRADE_CHECK"
  Snapshot = "SNAPSHOT"
  Upgrade = "UPGRADE"
  Unknown(value: Str)
}

/// Represents a single step of the Upgrade or Upgrade Eligibility Check
/// workflow.
pub struct UpgradeStepItem {
  /// Represents one of 3 steps that an Upgrade or Upgrade Eligibility Check
  /// does through: PreUpgradeCheck Snapshot Upgrade
  pub upgrade_step: UpgradeStep? = None
  /// The status of a particular step during an upgrade. The status can take
  /// one of the following values: In Progress Succeeded Succeeded with Issues
  /// Failed
  pub upgrade_step_status: UpgradeStatus? = None
  /// A list of strings containing detailed information about the errors
  /// encountered in a particular step.
  pub issues: List[Str]? = None
  /// The Floating point value representing progress percentage of a
  /// particular step.
  pub progress_percent: Float? = None
}

/// The status of the use case for the domain.
pub struct UseCaseStatus {
  /// The use case configured for the domain.
  pub options: DomainUseCase? = None
  /// The current status of the use case for the domain.
  pub status: OptionStatus? = None
}

/// Options to specify the subnets and security groups for VPC endpoint. For
/// more information, see VPC Endpoints for Amazon Elasticsearch Service
/// Domains .
pub struct VPCDerivedInfo {
  /// The VPC Id for the Elasticsearch domain. Exists only if the domain was
  /// created with VPCOptions.
  pub vpc_id: Str? = None
  /// Specifies the subnets for VPC endpoint.
  pub subnet_ids: List[Str]? = None
  /// The availability zones for the Elasticsearch domain. Exists only if the
  /// domain was created with VPCOptions.
  pub availability_zones: List[Str]? = None
  /// Specifies the security groups for VPC endpoint.
  pub security_group_ids: List[Str]? = None
}

/// Status of the VPC options for the specified Elasticsearch domain.
pub struct VPCDerivedInfoStatus {
  /// Specifies the VPC options for the specified Elasticsearch domain.
  pub options: VPCDerivedInfo? = None
  /// Specifies the status of the VPC options for the specified Elasticsearch
  /// domain.
  pub status: OptionStatus? = None
}

/// Options to specify the subnets and security groups for VPC endpoint. For
/// more information, see VPC Endpoints for Amazon Elasticsearch Service
/// Domains .
pub struct VPCOptions {
  /// Specifies the subnets for VPC endpoint.
  pub subnet_ids: List[Str]? = None
  /// Specifies the security groups for VPC endpoint.
  pub security_group_ids: List[Str]? = None
}

/// An exception for missing / invalid input fields. Gives http status code
/// of 400.
pub struct ValidationException {
  /// A description of the error.
  pub message: Str? = None
}

/// The type of EBS volume, standard, gp2, gp3 or io1. See Configuring
/// EBS-based Storage for more information.
pub enum VolumeType: Str {
  Standard = "standard"
  Gp2 = "gp2"
  Io1 = "io1"
  Gp3 = "gp3"
  Unknown(value: Str)
}

/// The connection endpoint for connecting to an Amazon OpenSearch Service
/// domain through a proxy.
pub struct VpcEndpoint {
  /// The unique identifier of the endpoint.
  pub vpc_endpoint_id: Str? = None
  /// The creator of the endpoint.
  pub vpc_endpoint_owner: Str? = None
  /// The Amazon Resource Name (ARN) of the domain associated with the
  /// endpoint.
  pub domain_arn: Str? = None
  /// Options to specify the subnets and security groups for an Amazon
  /// OpenSearch Service VPC endpoint.
  pub vpc_options: VPCDerivedInfo? = None
  /// The current status of the endpoint.
  pub status: VpcEndpointStatus? = None
  /// The connection endpoint ID for connecting to the domain.
  pub endpoint: Str? = None
}

/// Error information when attempting to describe an Amazon OpenSearch
/// Service-managed VPC endpoint.
pub struct VpcEndpointError {
  /// The unique identifier of the endpoint.
  pub vpc_endpoint_id: Str? = None
  /// The code associated with the error.
  pub error_code: VpcEndpointErrorCode? = None
  /// A message describing the error.
  pub error_message: Str? = None
}

/// Specifies the error code of the failure encountered while describing the
/// VPC endpoint: ENDPOINT_NOT_FOUND: Indicates that the requested VPC
/// endpoint does not exist. SERVER_ERROR: Indicates the describe endpoint
/// operation failed due to an internal server error.
pub enum VpcEndpointErrorCode: Str {
  EndpointNotFound = "ENDPOINT_NOT_FOUND"
  ServerError = "SERVER_ERROR"
  Unknown(value: Str)
}

/// Specifies the current status of the VPC endpoint: CREATING: Indicates
/// that the VPC endpoint is currently being created. CREATE_FAILED:
/// Indicates that the VPC endpoint creation failed. ACTIVE: Indicates that
/// the VPC endpoint is currently active. UPDATING: Indicates that the VPC
/// endpoint is currently being updated. UPDATE_FAILED: Indicates that the
/// VPC endpoint update failed. DELETING: Indicates that the VPC endpoint is
/// currently being deleted. DELETE_FAILED: Indicates that the VPC endpoint
/// deletion failed.
pub enum VpcEndpointStatus: Str {
  Creating = "CREATING"
  CreateFailed = "CREATE_FAILED"
  Active = "ACTIVE"
  Updating = "UPDATING"
  UpdateFailed = "UPDATE_FAILED"
  Deleting = "DELETING"
  DeleteFailed = "DELETE_FAILED"
  Unknown(value: Str)
}

/// Summary information for an Amazon OpenSearch Service-managed VPC
/// endpoint.
pub struct VpcEndpointSummary {
  /// The unique identifier of the endpoint.
  pub vpc_endpoint_id: Str? = None
  /// The creator of the endpoint.
  pub vpc_endpoint_owner: Str? = None
  /// The Amazon Resource Name (ARN) of the domain associated with the
  /// endpoint.
  pub domain_arn: Str? = None
  /// The current status of the endpoint.
  pub status: VpcEndpointStatus? = None
}

/// Specifies the zone awareness configuration for the domain cluster, such
/// as the number of availability zones.
pub struct ZoneAwarenessConfig {
  /// An integer value to indicate the number of availability zones for a
  /// domain when zone awareness is enabled. This should be equal to number of
  /// subnets if VPC endpoints is enabled
  pub availability_zone_count: Int? = None
}
