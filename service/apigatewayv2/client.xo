/// The HTTP request of CreateApi.
pub fn serialize_create_api(ep: rest.Endpoint, input: CreateApiRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.api_key_selection_expression {
    fs.push(("apiKeySelectionExpression", json.Value.Str(x)))
  }
  if let Some(x) = input.cors_configuration {
    fs.push(("corsConfiguration", json_of_cors(x)))
  }
  if let Some(x) = input.credentials_arn {
    fs.push(("credentialsArn", json.Value.Str(x)))
  }
  if let Some(x) = input.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = input.disable_schema_validation {
    fs.push(("disableSchemaValidation", json.Value.Bool(x)))
  }
  if let Some(x) = input.disable_execute_api_endpoint {
