/// Input for DeleteSocialConnection.
pub struct DeleteSocialConnectionRequest {
  /// Catalog the connection belongs to.
  pub catalog: Catalog? = None
  /// Identifier or ARN of the social connection to delete.
  pub identifier: Str? = None
  /// Idempotency token.
  pub client_token: Str? = None
}

/// What the delivery platform did with an artifact it accepted. Distinct
/// from `LastActivationStatus`, which reports the hand-over *to* the
/// platform. Once DG has the mailing armed, the hand-over `SUCCEEDED`;
/// whether the platform then delivered is this member's business, and the
/// two genuinely diverge — `LastActivationStatus = SUCCEEDED` with
/// `DeliveryStatus = FAILED` is an ordinary combination, not a
/// contradiction. **EMAIL and SOCIAL_POST only.** Landing pages and
/// documents have no delivery event at all. `PENDING` until the platform
/// shows the outcome. An email is `DELIVERED` once the platform reports it
/// sent, and `FAILED` when the platform reports the send failed. A social
/// post is `DELIVERED` once the platform has published it. A social post is
/// never reported `FAILED` by an observation alone, because the platform
/// retries a failed post. A send that has not resolved a day after its
/// scheduled time stays `PENDING` while it is investigated, and is reported
/// `FAILED` only if it will not go out. A `FAILED` asset can be deactivated
/// and activated again to retry. See campaign-asset-design.md section 6.4.
pub enum DeliveryStatus: Str {
  Pending = "PENDING"
  Delivered = "DELIVERED"
  Failed = "FAILED"
  Unknown(value: Str)
}

/// The campaign's attached recipient list, as read — metadata only. No
/// URL and no `S3Uri`, presigned or otherwise. The file is a list of email
/// addresses belonging to people who are not the partner, so there is no
/// read path for the bytes at all; what a caller needs is whether the list
/// was accepted and how many recipients it resolved to. The three counts
/// describe the file as it was read when attached. They are absent for a
/// list attached before the service began reading lists at upload.
pub struct EmailTargetDetail {
  /// The scan verdict for the attached list.
  pub scan_status: ScanStatus? = None
  /// When the list was attached.
  pub attached_at: Time? = None
  /// Distinct usable addresses — the recipients an email activation sends
  /// to.
  pub valid_count: Int? = None
  /// Rows skipped because their email cell is not a usable address.
  pub rejected_count: Int? = None
  /// Rows repeating an address already counted. Not an error: each address is
  /// sent to once.
  pub duplicate_count: Int? = None
  /// The display name of the uploaded file, as the partner named it, with no
  /// path: for example `Q4 leads.csv`. Absent for a list attached before the
  /// service kept the name. There is no link to the file: the list is never
  /// downloadable from the campaign.
  pub file_name: Str? = None
}

/// The kind of a template field, carrying that kind's constraints,
/// placeholder or default. One discriminator instead of a separate kind
/// enum, constraints blob and preset value, so kind and constraints cannot
/// disagree. Read-only — templates are AWS-authored; the service
/// validates each partner value against it. A URL the partner types is not
/// a distinct kind: it is text with a URL pattern, and its link role is
/// carried by the layout placeholder. The same holds for a colour, which is
/// text with a hex-colour pattern. A link to another of the campaign's
/// assets, whose URL DG writes at activation, is `AssetLink`.
pub enum FieldType {
  Text(value: TextFieldType)
  RichText(value: RichTextFieldType)
  Image(value: ImageFieldType)
  AssetLink(value: AssetLinkFieldType)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// A value-only update to one email template field. The write counterpart
/// of CampaignAssetFieldValue: it carries just the addressing key and the
/// new value, never the service-owned schema.
pub struct FieldValueInput {
  /// The field to update; must match a FieldId in the asset's stored schema.
  pub field_id: Str? = None
  /// The new value. Omit to clear the field.
  pub value: TemplateFieldValue? = None
}

/// Concrete file format of a rendered or downloadable artifact. DG-030
/// added `HTML` and `IMAGE` so one enum covers both the download-only
/// office formats and the formats the service renders itself. Before that,
/// an asset carried an ad-hoc `HTML | PDF` and a template entry an ad-hoc
/// `HTML | PDF | IMAGE`, and the two disagreed with each other.
pub enum FileFormat: Str {
  Pdf = "PDF"
  Docx = "DOCX"
  Pptx = "PPTX"
  Html = "HTML"
  Image = "IMAGE"
  Unknown(value: Str)
}

/// A reference to a partner-supplied file in the Partner Central file
/// staging bucket. The URI must be
/// `s3://{stagingBucket}/{callerAccountId}/…`, where the account id
/// segment equals the caller's session-derived account — never an account
/// named in the request body. A mismatch is refused
/// `FILE_REFERENCE_NOT_OWNED`; any other bucket, `FILE_REFERENCE_INVALID`.
/// `VersionId` is required: the staging bucket is versioned, and the
/// service takes exactly the version the upload returned, so a later upload
/// to the same key cannot change what was referenced. The service copies
/// that version into storage it controls and pins the copy for scanning and
/// processing.
pub struct FileRef {
  /// The `s3://` location of the file.
  pub s3_uri: Str? = None
  /// The version of the object to take: the `VersionId` the staging upload
  /// returned.
  pub version_id: Str? = None
}

/// Input for GetCampaignAssetActivationTask.
pub struct GetCampaignAssetActivationTaskRequest {
  /// The catalog (AWS or Sandbox).
  pub catalog: Catalog? = None
  /// The campaign whose current task to read. This addresses the task, and
  /// also authorizes the call.
  pub campaign_identifier: Str? = None
}

/// Output for GetCampaignAssetActivationTask: the campaign's most recent
/// task.
pub struct GetCampaignAssetActivationTaskResponse {
  /// The campaign's id. Canonical: because `CampaignIdentifier` accepts an id
  /// or an ARN, echoing this tells a caller who passed an ARN what the id is.
  /// The task's own id is `TaskId`.
  pub campaign_id: Str? = None
  /// Opaque correlation value for the task. Echoed so a caller can tell the
  /// task it started from a later one that superseded it. Never an input: the
  /// campaign is what addresses a task, because a campaign has at most one.
  pub task_id: Str? = None
  /// The task's status over every asset it names, refused ones included: one
  /// refused and one succeeded is PARTIAL_FAILURE.
  pub task_status: CampaignAssetActivationTaskStatus? = None
  /// When the task was created.
  pub started_at: Time? = None
  /// When the task reached a terminal status. Absent while IN_PROGRESS.
  pub ended_at: Time? = None
  /// One entry per asset the request named, in the order named. An asset
  /// refused up front is FAILED from the first response, with its reason.
  pub assets: List[CampaignAssetActivationOutcome]? = None
}

/// Input for GetCampaignAssetExportTask. Takes the catalog, the owning
/// campaign, and the export task identifier. The campaign identifier is
/// required so the operation can be authorized on the task's owning
/// campaign/{CampaignId}: the task is addressable by its id within the
/// caller's partition, but the campaign is not derivable from the task id
/// alone at authorization time.
pub struct GetCampaignAssetExportTaskRequest {
  /// The catalog (AWS or Sandbox).
  pub catalog: Catalog? = None
  /// The campaign that owns the export task. Accepts the campaign id or ARN.
  /// Required so the read is authorized on campaign/{CampaignId}; the task
  /// must belong to this campaign or the request resolves to not-found.
  pub campaign_identifier: Str? = None
  /// The export task to retrieve: the `Id` StartCampaignAssetExportTask
  /// returned (`etsk-…`). An id only. An export task has no ARN: none is
  /// returned, recorded or authorized on (the read authorizes on its
  /// campaign), so there is no ARN to accept (DG-063 D-35).
  pub campaign_asset_export_task_identifier: Str? = None
}

/// Output for GetCampaignAssetExportTask.
pub struct GetCampaignAssetExportTaskResponse {
  /// The export task identifier.
  pub id: Str? = None
  /// The task's state.
  pub status: CampaignAssetExportTaskStatus? = None
  /// When the task was created.
  pub created_at: Time? = None
  /// Presigned GET URL for the ZIP archive. Present only when status is
  /// COMPLETED. Freshly minted on each call and short-lived (
  pub download_url: Str? = None
  /// When DownloadUrl expires. Present only when status is COMPLETED.
  pub expires_at: Time? = None
  /// Why the task failed. Present only when status is FAILED.
  pub failure_reason: CampaignAssetExportFailureReason? = None
}

