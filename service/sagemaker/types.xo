/// Details about a specific instance type within a flexible instance group,
/// including the count and configuration.
pub struct ClusterInstanceTypeDetail {
  /// The instance type.
  pub instance_type: ClusterInstanceType? = None
  /// The number of instances of this type currently running in the instance
  /// group.
  pub current_count: Int? = None
  /// The number of threads per CPU core for this instance type.
  pub threads_per_core: Int? = None
}

pub enum ClusterInterfaceType: Str {
  Efa = "efa"
  EfaOnly = "efa-only"
  Unknown(value: Str)
}

/// Kubernetes configuration that specifies labels and taints to be applied
/// to cluster nodes in an instance group.
pub struct ClusterKubernetesConfig {
  /// Key-value pairs of labels to be applied to cluster nodes.
  pub labels: Map[Str, Str]? = None
  /// List of taints to be applied to cluster nodes.
  pub taints: List[ClusterKubernetesTaint]? = None
}

/// Detailed Kubernetes configuration showing both the current and desired
/// state of labels and taints for cluster nodes.
pub struct ClusterKubernetesConfigDetails {
  /// The current labels applied to cluster nodes of an instance group.
  pub current_labels: Map[Str, Str]? = None
  /// The desired labels to be applied to cluster nodes of an instance group.
  pub desired_labels: Map[Str, Str]? = None
  /// The current taints applied to cluster nodes of an instance group.
  pub current_taints: List[ClusterKubernetesTaint]? = None
  /// The desired taints to be applied to cluster nodes of an instance group.
  pub desired_taints: List[ClusterKubernetesTaint]? = None
}

/// Node-specific Kubernetes configuration showing both current and desired
/// state of labels and taints for an individual cluster node.
pub struct ClusterKubernetesConfigNodeDetails {
  /// The current labels applied to the cluster node.
  pub current_labels: Map[Str, Str]? = None
  /// The desired labels to be applied to the cluster node.
  pub desired_labels: Map[Str, Str]? = None
  /// The current taints applied to the cluster node.
  pub current_taints: List[ClusterKubernetesTaint]? = None
  /// The desired taints to be applied to the cluster node.
  pub desired_taints: List[ClusterKubernetesTaint]? = None
}

/// A Kubernetes taint that can be applied to cluster nodes.
pub struct ClusterKubernetesTaint {
  /// The key of the taint.
  pub key: Str? = None
  /// The value of the taint.
  pub value: Str? = None
