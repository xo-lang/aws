fn from_json_deployment_info(v: json.Value) -> DeploymentInfo ! Str {
  var out = DeploymentInfo{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "applicationName" => out.application_name = jsonv.read_str(fv)?
      "deploymentGroupName" => out.deployment_group_name = jsonv.read_str(fv)?
      "deploymentConfigName" => out.deployment_config_name = jsonv.read_str(fv)?
      "deploymentId" => out.deployment_id = jsonv.read_str(fv)?
      "previousRevision" => out.previous_revision = from_json_revision_location(fv)?
      "revision" => out.revision = from_json_revision_location(fv)?
      "status" => out.status = DeploymentStatus.from(jsonv.read_str(fv)?)
      "errorInformation" => out.error_information = from_json_error_information(fv)?
      "createTime" => out.create_time = jsonv.read_time(fv, "epoch-seconds")?
      "startTime" => out.start_time = jsonv.read_time(fv, "epoch-seconds")?
      "completeTime" => out.complete_time = jsonv.read_time(fv, "epoch-seconds")?
      "deploymentOverview" => out.deployment_overview = from_json_deployment_overview(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "creator" => out.creator = DeploymentCreator.from(jsonv.read_str(fv)?)
      "ignoreApplicationStopFailures" => out.ignore_application_stop_failures = jsonv.read_bool(fv)?
      "autoRollbackConfiguration" => out.auto_rollback_configuration = from_json_auto_rollback_configuration(fv)?
      "updateOutdatedInstancesOnly" => out.update_outdated_instances_only = jsonv.read_bool(fv)?
      "rollbackInfo" => out.rollback_info = from_json_rollback_info(fv)?
      "deploymentStyle" => out.deployment_style = from_json_deployment_style(fv)?
      "targetInstances" => out.target_instances = from_json_target_instances(fv)?
      "instanceTerminationWaitTimeStarted" => out.instance_termination_wait_time_started = jsonv.read_bool(fv)?
      "blueGreenDeploymentConfiguration" => out.blue_green_deployment_configuration = from_json_blue_green_deployment_configuration(fv)?
      "loadBalancerInfo" => out.load_balancer_info = from_json_load_balancer_info(fv)?
      "additionalDeploymentStatusInfo" => out.additional_deployment_status_info = jsonv.read_str(fv)?
      "fileExistsBehavior" => out.file_exists_behavior = FileExistsBehavior.from(jsonv.read_str(fv)?)
      "deploymentMode" => out.deployment_mode = DeploymentMode.from(jsonv.read_str(fv)?)
      "deploymentStatusMessages" => out.deployment_status_messages = from_json_deployment_status_message_list(fv)?
      "computePlatform" => out.compute_platform = ComputePlatform.from(jsonv.read_str(fv)?)
      "externalId" => out.external_id = jsonv.read_str(fv)?
      "relatedDeployments" => out.related_deployments = from_json_related_deployments(fv)?
      "overrideAlarmConfiguration" => out.override_alarm_configuration = from_json_alarm_configuration(fv)?
      "ec2DeploymentOptions" => out.ec2_deployment_options = from_json_ec2_deployment_options(fv)?
      _ => {}
    }
  }
  Ok(out)
}

