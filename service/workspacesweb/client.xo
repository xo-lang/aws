/// The HTTP request of GetTrustStoreCertificate.
pub fn serialize_get_trust_store_certificate(ep: rest.Endpoint, input: GetTrustStoreCertificateRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_trust_store_arn = match input.trust_store_arn {
    Some(v) => v
    None => return Err("input member trustStoreArn is required")
  }
  if label_trust_store_arn == "" {
    return Err("input member trustStoreArn must not be empty")
  }
  if let Some(v) = input.thumbprint {
    qs.push(("thumbprint", v))
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "GET",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/trustStores/${rest.escape(label_trust_store_arn, true)}/certificate"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}