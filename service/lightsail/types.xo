/// Describes the configuration of the account creation fraud prevention Web
/// Application Firewall (WAF) rule group. The rule group inspects account
/// creation requests to your application.
pub struct WafAcfpConfig {
  /// The content type of the request body of account creation requests. The
  /// following content types are possible: JSON – The request body is in
  /// JSON format. FORM_ENCODED – The request body is form encoded.
  pub payload_type: WafPayloadTypeEnum? = None
  /// The path of the endpoint that accepts completed account creation forms
  /// (for example, /signup/submit ). This endpoint must accept POST requests.
  /// Constraints: Must start with a forward slash ( / ). Must contain from 1
  /// to 256 characters.
  pub creation_path: Str? = None
  /// The path of the page that displays the account creation form (for
  /// example, /signup ). Constraints: Must start with a forward slash ( / ).
  /// Must contain from 1 to 256 characters.
  pub registration_page_path: Str? = None
  /// An object that describes the HTTP status codes that your application
  /// returns for successful and failed account creation attempts.
  pub response_inspection: WafResponseInspection? = None
}

/// Describes the configuration of the account takeover prevention Web
/// Application Firewall (WAF) rule group. The rule group inspects login
/// requests to the login path of your application.
pub struct WafAtpConfig {
  /// The path of the login endpoint of your application (for example, /login
  /// ). Login paths that start with the path that you specify are a match.
  /// Constraints: Must start with a forward slash ( / ). Must contain from 1
  /// to 256 characters.
  pub login_path: Str? = None
  /// The content type of the request body of login requests. The following
  /// content types are possible: JSON – The request body is in JSON format.
  /// FORM_ENCODED – The request body is form encoded.
  pub payload_type: WafPayloadTypeEnum? = None
  /// The name of the field in the request body that contains the username
  /// (for example, /username for JSON or username for FORM_ENCODED ).
  /// Constraints: For a JSON payload, must be a JSON pointer that starts with
  /// a forward slash ( / ). Must contain from 1 to 512 characters.
  pub username_field: Str? = None
  /// The name of the field in the request body that contains the password
  /// (for example, /password for JSON or password for FORM_ENCODED ).
  /// Constraints: For a JSON payload, must be a JSON pointer that starts with
  /// a forward slash ( / ). Must contain from 1 to 512 characters.
  pub password_field: Str? = None
  /// An object that describes the HTTP status codes that your application
  /// returns for successful and failed login attempts.
  pub response_inspection: WafResponseInspection? = None
}

/// Describes the configuration of the bot control Web Application Firewall
/// (WAF) rule group.
pub struct WafBotControlConfig {
  /// The inspection level of the bot control rule group. The following
  /// inspection levels are possible: COMMON – Detects a variety of bots
  /// that identify themselves, such as web scraping frameworks, search
  /// engines, and automated browsers. TARGETED – Includes the COMMON
  /// protections, and adds detection for sophisticated bots that don't
  /// identify themselves. This level uses rate limiting, CAPTCHA, and
  /// background browser challenges.
  pub inspection_level: WafInspectionLevelEnum? = None
}

/// Describes the Web Application Firewall (WAF) configuration of a
/// Lightsail distribution.
pub struct WafConfig {
  /// Specifies whether WAF is enabled for the distribution.
  pub is_waf_enabled: Bool? = None
  /// An array of objects that describe the WAF rule groups enabled for the
  /// distribution.
  pub waf_rules: List[WafRule]? = None
}

pub enum WafInspectionLevelEnum: Str {
  Common = "COMMON"
  Targeted = "TARGETED"
  Unknown(value: Str)
}

pub enum WafPayloadTypeEnum: Str {
  Json = "JSON"
  FormEncoded = "FORM_ENCODED"
  Unknown(value: Str)
}

/// Describes the HTTP status codes that your application returns to
/// indicate successful and failed attempts. The Web Application Firewall
/// (WAF) rule group uses these status codes to track successful and failed
/// attempts.
pub struct WafResponseInspection {
  /// The HTTP status codes that indicate a successful attempt (for example,
  /// 200 ). Constraints: Must contain from 1 to 10 status codes. Each status
  /// code must be from 0 to 999 . Can't contain a status code that is also in
  /// failureCodes .
  pub success_codes: List[Int]? = None
  /// The HTTP status codes that indicate a failed attempt (for example, 401
  /// ). Constraints: Must contain from 1 to 10 status codes. Each status code
  /// must be from 0 to 999 . Can't contain a status code that is also in
  /// successCodes .
  pub failure_codes: List[Int]? = None
}

/// Describes a Web Application Firewall (WAF) rule group for a Lightsail
/// distribution. A WAF rule group is a set of rules managed by AWS. The
/// rules inspect viewer requests and block requests that match them.
pub struct WafRule {
  /// The name of the WAF rule group (for example,
  /// AWSManagedRulesCommonRuleSet ). For the WAF rule groups that you can
  /// specify for each bundle, see the wafRules parameter of the
  /// CreateDistribution action.
  pub name: Str? = None
  /// An object that describes the configuration of the account takeover
  /// prevention rule group. Constraints: Define this parameter only when the
  /// name is AWSManagedRulesATPRuleSet . This parameter is required when the
  /// name is AWSManagedRulesATPRuleSet .
  pub atp_config: WafAtpConfig? = None
  /// An object that describes the configuration of the account creation fraud
  /// prevention rule group. Constraints: Define this parameter only when the
  /// name is AWSManagedRulesACFPRuleSet . This parameter is required when the
  /// name is AWSManagedRulesACFPRuleSet .
  pub acfp_config: WafAcfpConfig? = None
  /// An object that describes the configuration of the bot control rule
  /// group. Constraints: Define this parameter only when the name is
  /// AWSManagedRulesBotControlRuleSet . This parameter is required when the
  /// name is AWSManagedRulesBotControlRuleSet .
  pub bot_control_config: WafBotControlConfig? = None
}
