    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ImportTaskCancelled: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until Import Task is Successful
///
/// Calls GetImportTask until the ImportTaskSuccessful acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (60s) to `max_delay` (28800s).
pub fn wait_until_import_task_successful(c: Client, input: GetImportTaskInput, max_wait: Duration, min_delay: Duration = 60s, max_delay: Duration = 28800s) -> () ! waiter.WaitErr[GetImportTaskErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).get_import_task(input) {
      Ok(out) => {
        let o = jmes_of_get_import_task_output(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "CANCELLING") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "CANCELLED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "ROLLING_BACK") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "SUCCEEDED") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ImportTaskSuccessful: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

