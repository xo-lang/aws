  if let Some(x) = v.last_status_change {
    xmlv.elem(w, "lastStatusChange", rest.date_time(x), [])
  }
  if let Some(x) = v.outside_ip_address {
    xmlv.elem(w, "outsideIpAddress", x, [])
  }
  if let Some(x) = v.status {
