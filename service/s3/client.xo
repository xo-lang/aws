fn xml_write_object_encryption(var w: xmlv.Writer, v: ObjectEncryption, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    SseKms(x) => {
      xml_write_sse_kms_encryption(w, x, "SSE-KMS", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_object_encryption(e: xml.Element) -> ObjectEncryption ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "SSE-KMS" => Ok(ObjectEncryption.SseKms(xml_read_sse_kms_encryption(c)?))
      _ => Ok(ObjectEncryption.Unknown(c.name.local))
    }
  }
  Err("ObjectEncryption: no member set")
}

