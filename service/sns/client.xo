  }
  if let Some(x) = v.message {
    query.add(f, query.key(prefix, "Message"), x)
  }
  if let Some(x) = v.sender_fault {
    query.add(f, query.key(prefix, "SenderFault"), "${x}")
  }
}

fn query_put_batch_result_error_entry_list(var f: query.Form, prefix: Str, v: List[BatchResultErrorEntry], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_batch_result_error_entry(f, k, x)
  }
