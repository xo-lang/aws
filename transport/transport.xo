// Package transport sends one signed AWS request with retries (decision
// 0003): credentials, SigV4, the standard retry loop, clock skew
// correction, and the SDK headers, over std/http. Protocol packages
// build the request and read the response; generated clients call them.

use std/http
use std/time
use github.com/xo-lang/aws
use github.com/xo-lang/aws/eventstream
use github.com/xo-lang/aws/retry
use github.com/xo-lang/aws/sigv4
use github.com/xo-lang/aws/sigv4a

/// An HTTP request as the SDK builds it, before signing.
pub struct Request {
  pub method: Str = "GET"
  pub scheme: Str = "https"
  pub host: Str
  pub port: Int? = None
  /// The path as sent: already escaped by the protocol serializer.
  pub path: Str = "/"
  /// The raw query as sent ("" for none).
  pub query: Str = ""
  pub headers: List[(Str, Str)] = []
  pub body: Bytes = b""
  /// S3's rule for operations with a structured XML response: a 2xx
  /// whose root element is `<Error>` is a failure (treated as a 500, so
  /// it is retried and then returned as the error it names), as in
  /// aws-sdk-go-v2's HandleResponseErrorWith200Status.
  pub error_in_2xx: Bool = false
}

/// Whether `body`'s XML root element is `Error`: after an optional XML
/// declaration and whitespace.
pub fn xml_root_is_error(body: Bytes) -> Bool {
  let text = (if body.len() > 512 { body[0..512] } else { body }).to_str_lossy()
  var rest = text.trim_start()
  if rest.starts_with("<?xml") {
    let end = rest.find("?>") ?? return false
    rest = rest[end + 2..rest.len()].trim_start()
  }
  rest.starts_with("<Error>") || rest.starts_with("<Error ")
}

/// The `Host` value: the host, with the port when it is not the scheme's.
pub fn host_header(r: Request) -> Str {
  match r.port {
    Some(p) => {
      let default = (r.scheme == "https" && p == 443) || (r.scheme == "http" && p == 80)
      if default { r.host } else { "${r.host}:${p}" }
    }
    None => r.host
  }
}

/// The request's URL, with the path and query exactly as given
/// (std/http sends a request's raw path unchanged).
pub fn url_of(r: Request) -> Str {
  let q = if r.query == "" { "" } else { "?${r.query}" }
  "${r.scheme}://${host_header(r)}${r.path}${q}"
}

/// How to sign for one service.
pub struct Signing {
  pub service: Str
  pub region: Str
  /// S3's rules: the path escaped once and not normalized, and
  /// `X-Amz-Content-Sha256` sent.
  pub s3: Bool = false
  /// Send `UNSIGNED-PAYLOAD` instead of the body's hash.
  pub unsigned_payload: Bool = false
  /// Sign with SigV4a for these regions (the endpoint chose `sigv4a`).
  pub region_set: List[Str]? = None
  /// Whether the operation is signed (Smithy's auth traits).
  pub auth: Auth = Auth.Required
}

/// How an operation authenticates: `smithy.api#auth` with no schemes is
/// None (sent unsigned, as STS AssumeRoleWithWebIdentity and Cognito's
/// GetId are), `smithy.api#optionalAuth` is Optional (signed when
/// credentials resolve, unsigned when they do not), anything else
/// Required.
pub enum Auth {
  Required
  Optional
  None
  /// `Authorization: Bearer <token>` with the client's token
  /// (`smithy.api#httpBearerAuth`), not SigV4.
  Bearer
}

pub enum SendErr {
  Credentials(e: aws.CredentialsErr)
  Http(e: http.ClientErr)
  /// The retry quota stopped a retry; `last` is the last failure's text.
  QuotaExceeded(last: Str, attempts: Int)
}

pub fn (e: SendErr) display() -> Str {
  match e {
    Credentials(ce) => ce.display()
    Http(he) => "http: ${he.display()}"
    QuotaExceeded(last, n) => "retry quota exceeded after ${n} attempts: ${last}"
  }
}

enum AttemptErr {
  Creds(e: aws.CredentialsErr)
  Net(e: http.ClientErr)
  Status(resp: http.Response, f: retry.Failure)
}

/// A client's transport: one per service client, shared by its calls
/// (its retry quota and clock offset are shared too).
pub struct Client {
  pub http: http.Client
  pub clock: Clock
  pub rand: Rand
  pub retryer: retry.Standard
  pub credentials: aws.CredentialsProvider
  pub user_agent: Str = "xo-lang-aws/0.1"
  /// The token of bearer auth (`Auth.Bearer`), such as a Bedrock API key.
  pub token: Secret[Str]? = None
  /// Sent as `X-Amzn-Trace-Id` when the request has none (inside Lambda).
  pub trace_id: Str? = None
  /// Local clock correction, from a skewed response's `Date`.
  skew_ms: Atomic[Int]
}

pub fn new_client(net: Net, clock: Clock, rand: Rand, credentials: aws.CredentialsProvider, retryer: retry.Standard, timeout: Duration = 60s) -> Client {
  Client{
    http: http.client(net, timeout),
    clock: clock,
    rand: rand,
    retryer: retryer,
    credentials: credentials,
    skew_ms: Atomic.new(0),
  }
}

/// The clock offset in use (tests and diagnostics).
pub fn skew(c: Client) -> Duration {
  Duration.from_millis(c.skew_ms.get())
}

/// Sends `req` with retries. A response is `Ok` whatever its status
/// once it is final (a success, a non retryable error, or the last
/// attempt), so the protocol layer turns it into the modeled error.
/// `classify` reads an error response (status >= 300) into a retry
/// decision; it is the protocol's, since error codes live in the body.
pub fn send(c: Client, req: Request, signing: Signing, classify: fn(http.Response) -> retry.Failure) -> http.Response ! SendErr uses (net.dial, clock, rand) {
  let max = c.retryer.max_attempts
  let r = retry.run(c.retryer, c.clock, c.rand, fn(attempt: Int) -> http.Response ! AttemptErr uses (net.dial, clock, rand) {
    attempt_once(c, req, signing, classify, attempt, max)
  }, fn(e: AttemptErr) -> retry.Failure {
    match e {
      Creds(_) => retry.Failure.Permanent
      Net(he) => match he {
        Connect(_) => retry.Failure.Transient
        Timeout => retry.Failure.Timeout
        Protocol(_) => retry.Failure.Transient
        InvalidUrl(_) | Canceled => retry.Failure.Permanent
      }
      Status(_, f) => f
    }
  })
  match r {
    Ok(resp) => Ok(resp)
    Err(a) => match a.err {
      Status(resp, _) => if a.quota_exceeded { Err(SendErr.QuotaExceeded(last: "HTTP ${resp.status}", attempts: a.attempts)) } else { Ok(resp) }
      Creds(ce) => Err(SendErr.Credentials(ce))
      Net(he) => if a.quota_exceeded { Err(SendErr.QuotaExceeded(last: he.display(), attempts: a.attempts)) } else { Err(SendErr.Http(he)) }
    }
  }
}

/// The signed std/http request of one attempt.
fn signed_request(c: Client, req: Request, signing: Signing, attempt: Int, max: Int) -> http.Request ! AttemptErr uses (net.dial, clock, rand) {
  let (hreq, _, _, _) = sign_attempt(c, req, signing, attempt, max, None)?
  Ok(hreq)
}

/// One attempt's signed std/http request, with the signature, the
/// credentials and the signing time (an event stream's signer needs
/// them). `payload` overrides the payload hash.
fn sign_attempt(c: Client, req: Request, signing: Signing, attempt: Int, max: Int, payload_override: Str?) -> (http.Request, Str, sigv4.Credentials, Time) ! AttemptErr uses (net.dial, clock, rand) {
  let now = Time.from_unix_millis(c.clock.now().unix_millis() + c.skew_ms.get())
  var headers = req.headers
  headers.push(("Host", host_header(req)))
  headers.push(("Amz-Sdk-Request", "attempt=${attempt}; max=${max}"))
  if let Some(t) = c.trace_id {
    if !headers.any(fn(h: (Str, Str)) -> Bool { h.0.to_lower() == "x-amzn-trace-id" }) {
      headers.push(("X-Amzn-Trace-Id", t))
    }
  }
  if signing.auth is Auth.Bearer {
    let token = c.token ?? return Err(AttemptErr.Creds(aws.CredentialsErr.NotFound("no bearer token: set the client's bearer_token")))
    headers.push(("Authorization", "Bearer ${token.reveal()}"))
    return Ok((unsigned_request(c, req, headers), "", sigv4.Credentials{access_key_id: "", secret_access_key: Secret.new("")}, now))
  }
  let found = match signing.auth {
    Auth.Bearer => None
    Auth.None => None
    Auth.Optional => c.credentials.retrieve().ok()
    Auth.Required => match c.credentials.retrieve() {
      Ok(v) => Some(v)
      Err(e) => return Err(AttemptErr.Creds(e))
    }
  }
  let creds = match found {
    Some(v) => v
    None => return Ok((unsigned_request(c, req, headers), "", sigv4.Credentials{access_key_id: "", secret_access_key: Secret.new("")}, now))
  }
  let payload = payload_override ?? if signing.unsigned_payload { sigv4.UNSIGNED_PAYLOAD } else { sigv4.payload_hash(req.body) }
  let screds = sigv4.Credentials{access_key_id: creds.access_key_id, secret_access_key: creds.secret_access_key, session_token: creds.session_token}
  let sreq = sigv4.Request{method: req.method, path: req.path, query: req.query, headers: headers}
  let signed = match signing.region_set {
    Some(set) => {
      let opts = sigv4a.Options{
        service: signing.service,
        region_set: set,
        payload_hash: payload,
        normalize_path: !signing.s3,
        double_escape_path: !signing.s3,
        add_content_sha256_header: signing.s3 || payload_override.is_some(),
      }
      sigv4a.sign_header(c.rand, sreq, screds, opts, now) ?? e => return Err(AttemptErr.Creds(aws.CredentialsErr.Invalid(e.display())))
    }
    None => sigv4.sign_header(
      sreq,
      screds,
      sigv4.Options{
        service: signing.service,
        region: signing.region,
        payload_hash: payload,
        normalize_path: !signing.s3,
        double_escape_path: !signing.s3,
        add_content_sha256_header: signing.s3 || payload_override.is_some(),
      },
      now,
    )
  }
  var hreq = http.new_request(req.method, url_of(req), {}, req.body)
  for (name, value) in signed.headers {
    // std/http writes Host and Content-Length itself (the same values)
    if name != "Host" && name.to_lower() != "content-length" {
      hreq = hreq.add_header(name, value)
    }
  }
  hreq = hreq.with_header("User-Agent", c.user_agent)
  // The SDK reads bodies as stored (an S3 object saved gzip must come
  // back gzip); setting the header turns off std/http's decoding.
  if hreq.header("Accept-Encoding").is_none() {
    hreq = hreq.with_header("Accept-Encoding", "identity")
  }
  Ok((hreq, signed.signature, screds, now))
}

/// `req` with `headers` and no signature, for an operation without auth.
fn unsigned_request(c: Client, req: Request, headers: List[(Str, Str)]) -> http.Request {
  var hreq = http.new_request(req.method, url_of(req), {}, req.body)
  for (name, value) in headers {
    if name != "Host" && name.to_lower() != "content-length" {
      hreq = hreq.add_header(name, value)
    }
  }
  hreq = hreq.with_header("User-Agent", c.user_agent)
  if hreq.header("Accept-Encoding").is_none() {
    hreq = hreq.with_header("Accept-Encoding", "identity")
  }
  hreq
}

fn attempt_once(c: Client, req: Request, signing: Signing, classify: fn(http.Response) -> retry.Failure, attempt: Int, max: Int) -> http.Response ! AttemptErr uses (net.dial, clock, rand) {
  let hreq = signed_request(c, req, signing, attempt, max)?
  let sent = match c.http.send(hreq) {
    Ok(r) => r
    Err(e) => return Err(AttemptErr.Net(e))
  }
  let resp = if req.error_in_2xx && sent.status < 300 && xml_root_is_error(sent.body) { sent with {status: 500} } else { sent }
  if resp.status < 300 {
    return Ok(resp)
  }
  if note_skew(c, resp) {
    return Err(AttemptErr.Status(resp: resp, f: retry.Failure.Transient))
  }
  let f = classify(resp)
  if f is retry.Failure.Permanent {
    return Ok(resp)
  }
  Err(AttemptErr.Status(resp: resp, f: f))
}

/// When an error response's `Date` is more than 4 minutes from the
/// local clock, records the offset and answers true (retry with it).
fn note_skew(c: Client, resp: http.Response) -> Bool uses clock {
  if resp.status != 400 && resp.status != 403 {
    return false
  }
  let date = resp.header("Date") ?? return false
  let server = match time.parse(date, time.RFC1123, time.utc()) {
    Ok(t) => t
    Err(_) => return false
  }
  let offset = server.unix_millis() - c.clock.now().unix_millis()
  let previous = c.skew_ms.get()
  let diff = offset - previous
  if diff > 240000 || diff < -240000 {
    c.skew_ms.set(offset)
    return true
  }
  false
}

/// What `open` returns: a 2xx response whose body is read as it arrives,
/// or any other response read whole (an error to deserialize).
pub enum Opened {
  Stream(head: http.ResponseHead, body: http.ClientStream)
  Done(resp: http.Response)
}

/// Like `send`, but a successful response's body is left to read as it
/// arrives (an event stream). Retries happen only before the response's
/// head: a body read error is the caller's.
pub fn open(c: Client, req: Request, signing: Signing, classify: fn(http.Response) -> retry.Failure) -> Opened ! SendErr uses (net.dial, clock, rand) {
  let max = c.retryer.max_attempts
  let r = retry.run(c.retryer, c.clock, c.rand, fn(attempt: Int) -> Opened ! AttemptErr uses (net.dial, clock, rand) {
    let hreq = signed_request(c, req, signing, attempt, max)?
    let st = match c.http.open(hreq) {
      Ok(x) => x
      Err(e) => return Err(AttemptErr.Net(e))
    }
    let head = st.head()
    if head.status < 300 {
      return Ok(Opened.Stream(head: head, body: st))
    }
    let body = match st.read_all() {
      Ok(b) => b
      Err(e) => {
        st.close()
        return Err(AttemptErr.Net(e))
      }
    }
    st.close()
    let resp = http.Response{status: head.status, headers: head.headers, body: body}
    if note_skew(c, resp) {
      return Err(AttemptErr.Status(resp: resp, f: retry.Failure.Transient))
    }
    let f = classify(resp)
    if f is retry.Failure.Permanent {
      return Ok(Opened.Done(resp: resp))
    }
    Err(AttemptErr.Status(resp: resp, f: f))
  }, fn(e: AttemptErr) -> retry.Failure {
    match e {
      Creds(_) => retry.Failure.Permanent
      Net(he) => match he {
        Connect(_) => retry.Failure.Transient
        Timeout => retry.Failure.Timeout
        Protocol(_) => retry.Failure.Transient
        InvalidUrl(_) | Canceled => retry.Failure.Permanent
      }
      Status(_, f) => f
    }
  })
  match r {
    Ok(o) => Ok(o)
    Err(a) => match a.err {
      Status(resp, _) => if a.quota_exceeded { Err(SendErr.QuotaExceeded(last: "HTTP ${resp.status}", attempts: a.attempts)) } else { Ok(Opened.Done(resp: resp)) }
      Creds(ce) => Err(SendErr.Credentials(ce))
      Net(he) => if a.quota_exceeded { Err(SendErr.QuotaExceeded(last: he.display(), attempts: a.attempts)) } else { Err(SendErr.Http(he)) }
    }
  }
}

/// An input event stream's start: the response (as `open` gives it) and
/// the signer of the request body's messages, seeded with the request's
/// signature.
pub struct StreamStart {
  pub opened: Opened
  pub signer: sigv4.StreamSigner
}

/// Sends a request whose body is an event stream read from `body` (the
/// reading end of an http.pipe whose `writer` the caller keeps writing
/// signed messages to), signed with the streaming payload hash. The
/// encoded messages `first` are signed and written before the request is
/// sent. One attempt: a body being streamed cannot be sent again.
pub fn open_stream(c: Client, req: Request, signing: Signing, body: http.BodyReader, first: List[Bytes], writer: http.PipeWriter) -> StreamStart ! SendErr uses (net.dial, clock, rand) {
  let (hreq, sig, creds, _) = match sign_attempt(c, req, signing, 1, 1, Some(sigv4.STREAMING_EVENTS_PAYLOAD)) {
    Ok(x) => x
    Err(Creds(ce)) => return Err(SendErr.Credentials(ce))
    Err(Net(he)) => return Err(SendErr.Http(he))
    Err(Status(resp, _)) => return Err(SendErr.QuotaExceeded(last: "HTTP ${resp.status}", attempts: 1))
  }
  var signer = sigv4.StreamSigner{creds: creds, region: signing.region, service: signing.service, prev: Bytes.from_hex(sig) ?? b""}
  // the pipe holds these until the client reads the body (64 KiB)
  for m in first {
    let now = Time.from_unix_millis(c.clock.now().unix_millis() + c.skew_ms.get())
    writer.write(eventstream.signed(signer, m, now)) ?? e => return Err(SendErr.Http(http.ClientErr.Protocol(e.display())))
  }
  let st = c.http.open(hreq.with_body_reader(body)) ?? e => return Err(SendErr.Http(e))
  let head = st.head()
  if head.status < 300 {
    return Ok(StreamStart{opened: Opened.Stream(head: head, body: st), signer: signer})
  }
  let rest = st.read_all() ?? e => {
    st.close()
    return Err(SendErr.Http(e))
  }
  st.close()
  Ok(StreamStart{opened: Opened.Done(resp: http.Response{status: head.status, headers: head.headers, body: rest}), signer: signer})
}

/// A presigned request: anyone holding it can send it until it expires,
/// with no credentials. `headers` are the ones that were signed besides
/// Host and must be sent as they are.
pub struct Presigned {
  pub method: Str
  pub url: Str
  pub headers: List[(Str, Str)]
}

/// The longest a SigV4 presigned URL may be valid (7 days).
pub const MAX_PRESIGN: Duration = 168h

/// Presigns `req` in its query (SigV4, or SigV4a when the endpoint asked
/// for a region set), valid for `expires` from now. S3 signs
/// `UNSIGNED-PAYLOAD`; other services sign the body's hash.
pub fn presign(c: Client, req: Request, signing: Signing, expires: Duration) -> Presigned ! SendErr uses (net.dial, clock, rand) {
  let creds = match c.credentials.retrieve() {
    Ok(v) => v
    Err(e) => return Err(SendErr.Credentials(e))
  }
  let ttl = if expires > MAX_PRESIGN { MAX_PRESIGN } else { expires }
  let now = Time.from_unix_millis(c.clock.now().unix_millis() + c.skew_ms.get())
  // the holder of the URL chooses the body, so its length is not signed
  let kept = req.headers.filter(fn(h: (Str, Str)) -> Bool { h.0.to_lower() != "content-length" })
  var headers = kept
  headers.push(("Host", host_header(req)))
  let payload = if signing.s3 || signing.unsigned_payload { sigv4.UNSIGNED_PAYLOAD } else { sigv4.payload_hash(req.body) }
  let screds = sigv4.Credentials{access_key_id: creds.access_key_id, secret_access_key: creds.secret_access_key, session_token: creds.session_token}
  let sreq = sigv4.Request{method: req.method, path: req.path, query: req.query, headers: headers}
  let signed = match signing.region_set {
    Some(set) => {
      let opts = sigv4a.Options{
        service: signing.service,
        region_set: set,
        payload_hash: payload,
        normalize_path: !signing.s3,
        double_escape_path: !signing.s3,
      }
      sigv4a.sign_query(c.rand, sreq, screds, opts, now, ttl) ?? e => return Err(SendErr.Credentials(aws.CredentialsErr.Invalid(e.display())))
    }
    None => sigv4.sign_query(sreq, screds, sigv4.Options{
      service: signing.service,
      region: signing.region,
      payload_hash: payload,
      normalize_path: !signing.s3,
      double_escape_path: !signing.s3,
    }, now, ttl)
  }
  let url = url_of(req with {query: signed.query})
  Ok(Presigned{method: req.method, url: url, headers: kept})
}
