fn read_error_complex_error(resp: http.Response, body: xml.Element) -> ComplexError ! Str {
  let _ = (resp, body)
  var out = ComplexError{}
  for c in xmlv.elements(body) {
    match c.name.local.to_lower() {
      "toplevel" => out.top_level = c.text()
      "nested" => out.nested = xml_read_complex_nested_error_data(c)?
      _ => {}
    }
  }
  Ok(out)
}

