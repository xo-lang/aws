  }
  if let Some(x) = v.subnet_id {
    xmlv.elem(w, "SubnetId", x, [])
  }
  if let Some(x) = v.user_data {
    xmlv.elem(w, "UserData", x, [])
  }
  if let Some(x) = v.elastic_gpu_specification {
    xml_write_elastic_gpu_specifications(w, x, "ElasticGpuSpecification", [])
  }
  if let Some(x) = v.elastic_inference_accelerators {
    xml_write_elastic_inference_accelerators(w, x, "ElasticInferenceAccelerator", [])
  }
