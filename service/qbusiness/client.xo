fn json_of_document_attribute_target(v: DocumentAttributeTarget) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.key {
    fs.push(("key", json.Value.Str(x)))
  }
  if let Some(x) = v.value {
