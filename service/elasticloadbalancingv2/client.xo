fn read_error_alpn_policy_not_supported_exception(resp: http.Response, body: xml.Element) -> ALPNPolicyNotSupportedException ! Str {
  let _ = (resp, body)
  var out = ALPNPolicyNotSupportedException{}
  for c in xmlv.elements(body) {
    match c.name.local.to_lower() {
      "message" => out.message = c.text()
      _ => {}
    }
  }
  Ok(out)
}

