      Err(msg) => return AssociateFeedErr.Deserialize(msg)
    }
    "TooManyRequestException" => match read_error_too_many_request_exception(resp, body) {
      Ok(x) => return AssociateFeedErr.TooManyRequestException(x)
      Err(msg) => return AssociateFeedErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return AssociateFeedErr.ValidationException(x)
      Err(msg) => return AssociateFeedErr.Deserialize(msg)
    }
    _ => {}
