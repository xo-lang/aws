fn json_of_field(v: Field) -> json.Value {
  match v {
    IsNull(x) => json.Value.Object([("isNull", json.Value.Bool(x))])
    BooleanValue(x) => json.Value.Object([("booleanValue", json.Value.Bool(x))])
    LongValue(x) => json.Value.Object([("longValue", json.Value.Int(x))])
    DoubleValue(x) => json.Value.Object([("doubleValue", jsonv.float(x))])
    StringValue(x) => json.Value.Object([("stringValue", json.Value.Str(x))])
    BlobValue(x) => json.Value.Object([("blobValue", jsonv.blob(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_field(v: json.Value) -> Field ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "isNull" => Ok(Field.IsNull(jsonv.read_bool(fv)?))
      "booleanValue" => Ok(Field.BooleanValue(jsonv.read_bool(fv)?))
      "longValue" => Ok(Field.LongValue(jsonv.read_int(fv)?))
      "doubleValue" => Ok(Field.DoubleValue(jsonv.read_float(fv)?))
      "stringValue" => Ok(Field.StringValue(jsonv.read_str(fv)?))
      "blobValue" => Ok(Field.BlobValue(jsonv.read_blob(fv)?))
      _ => Ok(Field.Unknown(k))
    }
  }
  Err("Field: no member set")
}

fn json_of_field_list(v: List[Field]) -> json.Value {
  json.Value.List(v.map(fn(x: Field) -> json.Value { json_of_field(x) }))
}

fn from_json_field_list(v: json.Value) -> List[Field] ! Str {
  var out: List[Field] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_field(fv)?)
  }
  Ok(out)
}

fn json_of_formatted_sql_records(v: List[QueryRecords]) -> json.Value {
  json.Value.List(v.map(fn(x: QueryRecords) -> json.Value { json_of_query_records(x) }))
