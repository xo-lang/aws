fn json_of_header_match(v: HeaderMatch) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.match_value {
    fs.push(("match", json_of_header_match_type(x)))
  }
  if let Some(x) = v.case_sensitive {
    fs.push(("caseSensitive", json.Value.Bool(x)))
  }
  json.Value.Object(fs)
}

fn from_json_header_match(v: json.Value) -> HeaderMatch ! Str {
  var out = HeaderMatch{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "name" => out.name = jsonv.read_str(fv)?
      "match" => out.match_value = from_json_header_match_type(fv)?
      "caseSensitive" => out.case_sensitive = jsonv.read_bool(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_header_match_list(v: List[HeaderMatch]) -> json.Value {
  json.Value.List(v.map(fn(x: HeaderMatch) -> json.Value { json_of_header_match(x) }))
}

fn from_json_header_match_list(v: json.Value) -> List[HeaderMatch] ! Str {
  var out: List[HeaderMatch] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_header_match(fv)?)
  }
  Ok(out)
}

fn json_of_header_match_type(v: HeaderMatchType) -> json.Value {
  match v {
    Exact(x) => json.Value.Object([("exact", json.Value.Str(x))])
    Prefix(x) => json.Value.Object([("prefix", json.Value.Str(x))])
    Contains(x) => json.Value.Object([("contains", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_header_match_type(v: json.Value) -> HeaderMatchType ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "exact" => Ok(HeaderMatchType.Exact(jsonv.read_str(fv)?))
      "prefix" => Ok(HeaderMatchType.Prefix(jsonv.read_str(fv)?))
      "contains" => Ok(HeaderMatchType.Contains(jsonv.read_str(fv)?))
      _ => Ok(HeaderMatchType.Unknown(k))
    }
  }
  Err("HeaderMatchType: no member set")
}

