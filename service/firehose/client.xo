  }
  if let Some(x) = v.padding_tolerance {
    fs.push(("PaddingTolerance", jsonv.float(x)))
  }
  if let Some(x) = v.compression {
    fs.push(("Compression", json.Value.Str(x.value())))
  }
  if let Some(x) = v.bloom_filter_columns {
    fs.push(("BloomFilterColumns", json_of_list_of_non_empty_strings_without_whitespace(x)))
  }
  if let Some(x) = v.bloom_filter_false_positive_probability {
    fs.push(("BloomFilterFalsePositiveProbability", jsonv.float(x)))
  }
  if let Some(x) = v.dictionary_key_threshold {
