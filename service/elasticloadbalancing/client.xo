pub fn endpoint_params_add_tags(base: EndpointParameters, input: AddTagsInput) -> EndpointParameters {
  let _ = input
  base
}

/// The HTTP request of AddTags.
pub fn serialize_add_tags(ep: rest.Endpoint, input: AddTagsInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var f = query.form("AddTags", "2012-06-01")
  if let Some(x) = input.load_balancer_names {
    query_put_load_balancer_names(f, query.key("", "LoadBalancerNames"), x, false)
  }
  if let Some(x) = input.tags {
    query_put_tag_list(f, query.key("", "Tags"), x, false)
  }
  body = query.encode(f).bytes()
  headers.push(("Content-Type", "application/x-www-form-urlencoded"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_add_tags(resp: http.Response) -> AddTagsOutput ! Str {
  var out = AddTagsOutput{}
  Ok(out)
}

/// The errors of AddTags.
pub enum AddTagsErr {
  AccessPointNotFoundException(e: AccessPointNotFoundException)
  DuplicateTagKeysException(e: DuplicateTagKeysException)
  TooManyTagsException(e: TooManyTagsException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: AddTagsErr) display() -> Str {
  match e {
    AccessPointNotFoundException(x) => "AccessPointNotFoundException: ${x:?}"
    DuplicateTagKeysException(x) => "DuplicateTagKeysException: ${x:?}"
    TooManyTagsException(x) => "TooManyTagsException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_add_tags_error(resp: http.Response) -> AddTagsErr {
  let body = restxml.error_element(resp.body) ?? xmlv.empty()
  match restxml.error_code(resp) {
    "LoadBalancerNotFound" => match read_error_access_point_not_found_exception(resp, body) {
      Ok(x) => return AddTagsErr.AccessPointNotFoundException(x)
      Err(msg) => return AddTagsErr.Deserialize(msg)
    }
    "DuplicateTagKeys" => match read_error_duplicate_tag_keys_exception(resp, body) {
      Ok(x) => return AddTagsErr.DuplicateTagKeysException(x)
      Err(msg) => return AddTagsErr.Deserialize(msg)
    }
    "TooManyTags" => match read_error_too_many_tags_exception(resp, body) {
      Ok(x) => return AddTagsErr.TooManyTagsException(x)
      Err(msg) => return AddTagsErr.Deserialize(msg)
    }
    _ => {}
  }

  AddTagsErr.Api(restxml.api_error(resp))
}

/// Adds the specified tags to the specified load balancer. Each load
/// balancer can have a maximum of 10 tags. Each tag consists of a key and
/// an optional value. If a tag with the same key is already associated with
/// the load balancer, AddTags updates its value. For more information, see
/// Tag Your Classic Load Balancer in the Classic Load Balancers Guide .
