fn json_of_connection_summary(v: ConnectionSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.configurations {
    fs.push(("configurations", json_of_configurations(x)))
  }
  if let Some(x) = v.connection_id {
    fs.push(("connectionId", json.Value.Str(x)))
  }
  if let Some(x) = v.domain_id {
    fs.push(("domainId", json.Value.Str(x)))
  }
  if let Some(x) = v.domain_unit_id {
    fs.push(("domainUnitId", json.Value.Str(x)))
  }
  if let Some(x) = v.environment_id {
    fs.push(("environmentId", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.physical_endpoints {
    fs.push(("physicalEndpoints", json_of_physical_endpoints(x)))
  }
  if let Some(x) = v.project_id {
    fs.push(("projectId", json.Value.Str(x)))
  }
  if let Some(x) = v.props {
    fs.push(("props", json_of_connection_properties_output(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.scope {
    fs.push(("scope", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_connection_summary(v: json.Value) -> ConnectionSummary ! Str {
  var out = ConnectionSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "configurations" => out.configurations = from_json_configurations(fv)?
      "connectionId" => out.connection_id = jsonv.read_str(fv)?
      "domainId" => out.domain_id = jsonv.read_str(fv)?
      "domainUnitId" => out.domain_unit_id = jsonv.read_str(fv)?
      "environmentId" => out.environment_id = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "physicalEndpoints" => out.physical_endpoints = from_json_physical_endpoints(fv)?
      "projectId" => out.project_id = jsonv.read_str(fv)?
      "props" => out.props = from_json_connection_properties_output(fv)?
      "type" => out.type_value = ConnectionType.from(jsonv.read_str(fv)?)
      "scope" => out.scope = ConnectionScope.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_connectivity_properties(v: ConnectivityProperties) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.connection_properties {
    fs.push(("connectionProperties", json_of_connection_properties(x)))
  }
  if let Some(x) = v.physical_connection_requirements {
    fs.push(("physicalConnectionRequirements", json_of_physical_connection_requirements(x)))
