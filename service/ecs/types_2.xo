/// There's already a current Amazon ECS container agent update in progress
/// on the container instance that's specified. If the container agent
/// becomes disconnected while it's in a transitional stage, such as PENDING
/// or STAGING , the update process can get stuck in that state. However,
/// when the agent reconnects, it resumes where it stopped previously.
pub struct UpdateInProgressException {
  /// Message that describes the cause of the exception.
  pub message: Str? = None
}

