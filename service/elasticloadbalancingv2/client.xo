fn xml_write_modify_rule_input(var w: xmlv.Writer, v: ModifyRuleInput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.rule_arn {
    xmlv.elem(w, "RuleArn", x, [])
  }
  if let Some(x) = v.conditions {
    xml_write_rule_condition_list(w, x, "Conditions", [])
  }
  if let Some(x) = v.actions {
    xml_write_actions(w, x, "Actions", [])
  }
  if let Some(x) = v.transforms {
    xml_write_rule_transform_list(w, x, "Transforms", [])
