  if let Some(x) = v.size_in_bytes {
    fs.push(("sizeInBytes", json.Value.Int(x)))
  }
  if let Some(x) = v.size_in_bytes_compressed {
    fs.push(("sizeInBytesCompressed", json.Value.Int(x)))
