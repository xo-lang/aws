  var out = VerifiedAccessEndpoint{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "verifiedAccessInstanceId" => out.verified_access_instance_id = c.text()
      "verifiedAccessGroupId" => out.verified_access_group_id = c.text()
      "verifiedAccessEndpointId" => out.verified_access_endpoint_id = c.text()
      "applicationDomain" => out.application_domain = c.text()
      "endpointType" => out.endpoint_type = VerifiedAccessEndpointType.from(c.text())
      "attachmentType" => out.attachment_type = VerifiedAccessEndpointAttachmentType.from(c.text())
      "domainCertificateArn" => out.domain_certificate_arn = c.text()
      "endpointDomain" => out.endpoint_domain = c.text()
      "deviceValidationDomain" => out.device_validation_domain = c.text()
      "securityGroupIdSet" => out.security_group_ids = xml_read_security_group_id_list(c)?
      "loadBalancerOptions" => out.load_balancer_options = xml_read_verified_access_endpoint_load_balancer_options(c)?
      "networkInterfaceOptions" => out.network_interface_options = xml_read_verified_access_endpoint_eni_options(c)?
      "status" => out.status = xml_read_verified_access_endpoint_status(c)?
      "description" => out.description = c.text()
      "creationTime" => out.creation_time = c.text()
      "lastUpdatedTime" => out.last_updated_time = c.text()
      "deletionTime" => out.deletion_time = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "sseSpecification" => out.sse_specification = xml_read_verified_access_sse_specification_response(c)?
      "rdsOptions" => out.rds_options = xml_read_verified_access_endpoint_rds_options(c)?
      "cidrOptions" => out.cidr_options = xml_read_verified_access_endpoint_cidr_options(c)?
      _ => {}
    }
  }
  Ok(out)
}

