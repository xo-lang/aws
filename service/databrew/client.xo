fn json_of_output(v: Output) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.compression_format {
    fs.push(("CompressionFormat", json.Value.Str(x.value())))
  }
  if let Some(x) = v.format {
    fs.push(("Format", json.Value.Str(x.value())))
  }
  if let Some(x) = v.partition_columns {
    fs.push(("PartitionColumns", json_of_column_name_list(x)))
  }
  if let Some(x) = v.location {
    fs.push(("Location", json_of_s3_location(x)))
  }
  if let Some(x) = v.overwrite {
    fs.push(("Overwrite", json.Value.Bool(x)))
  }
  if let Some(x) = v.format_options {
    fs.push(("FormatOptions", json_of_output_format_options(x)))
  }
  if let Some(x) = v.max_output_files {
    fs.push(("MaxOutputFiles", json.Value.Int(x)))
  }
  json.Value.Object(fs)
}

fn from_json_output(v: json.Value) -> Output ! Str {
  var out = Output{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
