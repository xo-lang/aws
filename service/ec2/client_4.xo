fn xml_write_fleet_data(var w: xmlv.Writer, v: FleetData, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.activity_status {
    xmlv.elem(w, "activityStatus", x.value(), [])
  }
  if let Some(x) = v.create_time {
    xmlv.elem(w, "createTime", rest.date_time(x), [])
  }
  if let Some(x) = v.fleet_id {
    xmlv.elem(w, "fleetId", x, [])
  }
  if let Some(x) = v.fleet_state {
    xmlv.elem(w, "fleetState", x.value(), [])
  }
  if let Some(x) = v.client_token {
    xmlv.elem(w, "clientToken", x, [])
  }
  if let Some(x) = v.excess_capacity_termination_policy {
    xmlv.elem(w, "excessCapacityTerminationPolicy", x.value(), [])
  }
  if let Some(x) = v.fulfilled_capacity {
    xmlv.elem(w, "fulfilledCapacity", rest.float_text(x), [])
  }
  if let Some(x) = v.fulfilled_on_demand_capacity {
    xmlv.elem(w, "fulfilledOnDemandCapacity", rest.float_text(x), [])
  }
  if let Some(x) = v.launch_template_configs {
    xml_write_fleet_launch_template_config_list(w, x, "launchTemplateConfigs", [])
  }
  if let Some(x) = v.target_capacity_specification {
    xml_write_target_capacity_specification(w, x, "targetCapacitySpecification", [])
  }
  if let Some(x) = v.terminate_instances_with_expiration {
    xmlv.elem(w, "terminateInstancesWithExpiration", "${x}", [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "type", x.value(), [])
  }
  if let Some(x) = v.valid_from {
    xmlv.elem(w, "validFrom", rest.date_time(x), [])
  }
  if let Some(x) = v.valid_until {
    xmlv.elem(w, "validUntil", rest.date_time(x), [])
  }
  if let Some(x) = v.replace_unhealthy_instances {
    xmlv.elem(w, "replaceUnhealthyInstances", "${x}", [])
  }
  if let Some(x) = v.spot_options {
    xml_write_spot_options(w, x, "spotOptions", [])
  }
  if let Some(x) = v.on_demand_options {
    xml_write_on_demand_options(w, x, "onDemandOptions", [])
  }
  if let Some(x) = v.reserved_capacity_options {
    xml_write_reserved_capacity_options(w, x, "reservedCapacityOptions", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.errors {
    xml_write_describe_fleets_error_set(w, x, "errorSet", [])
  }
  if let Some(x) = v.instances {
    xml_write_describe_fleets_instances_set(w, x, "fleetInstanceSet", [])
  }
  if let Some(x) = v.context {
    xmlv.elem(w, "context", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_fleet_data(e: xml.Element) -> FleetData ! Str {
  var out = FleetData{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "activityStatus" => out.activity_status = FleetActivityStatus.from(c.text())
      "createTime" => out.create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "fleetId" => out.fleet_id = c.text()
      "fleetState" => out.fleet_state = FleetStateCode.from(c.text())
      "clientToken" => out.client_token = c.text()
      "excessCapacityTerminationPolicy" => out.excess_capacity_termination_policy = FleetExcessCapacityTerminationPolicy.from(c.text())
      "fulfilledCapacity" => out.fulfilled_capacity = xmlv.read_float(c.text())?
      "fulfilledOnDemandCapacity" => out.fulfilled_on_demand_capacity = xmlv.read_float(c.text())?
      "launchTemplateConfigs" => out.launch_template_configs = xml_read_fleet_launch_template_config_list(c)?
      "targetCapacitySpecification" => out.target_capacity_specification = xml_read_target_capacity_specification(c)?
      "terminateInstancesWithExpiration" => out.terminate_instances_with_expiration = xmlv.read_bool(c.text())?
      "type" => out.type_value = FleetType.from(c.text())
      "validFrom" => out.valid_from = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "validUntil" => out.valid_until = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "replaceUnhealthyInstances" => out.replace_unhealthy_instances = xmlv.read_bool(c.text())?
      "spotOptions" => out.spot_options = xml_read_spot_options(c)?
      "onDemandOptions" => out.on_demand_options = xml_read_on_demand_options(c)?
      "reservedCapacityOptions" => out.reserved_capacity_options = xml_read_reserved_capacity_options(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "errorSet" => out.errors = xml_read_describe_fleets_error_set(c)?
      "fleetInstanceSet" => out.instances = xml_read_describe_fleets_instances_set(c)?
      "context" => out.context = c.text()
      _ => {}
    }
  }
  Ok(out)
}

