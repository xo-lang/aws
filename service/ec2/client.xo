fn query_put_accept_address_transfer_request(var f: query.Form, prefix: Str, v: AcceptAddressTransferRequest) {
  if let Some(x) = v.address {
    query.add(f, query.key(prefix, "Address"), x)
  }
  if let Some(x) = v.tag_specifications {
    query_put_tag_specification_list(f, query.key(prefix, "TagSpecification"), x, false)
  }
  if let Some(x) = v.dry_run {
    query.add(f, query.key(prefix, "DryRun"), "${x}")
  }
}

fn query_put_accept_address_transfer_result(var f: query.Form, prefix: Str, v: AcceptAddressTransferResult) {
  if let Some(x) = v.address_transfer {
    query_put_address_transfer(f, query.key(prefix, "AddressTransfer"), x)
  }
}

