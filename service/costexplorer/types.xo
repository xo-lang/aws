  pub max_impact: Float? = None
  /// The cumulative dollar difference between the total actual spend and
  /// total expected spend. It is calculated as TotalActualSpend -
  /// TotalExpectedSpend .
  pub total_impact: Float? = None
  /// The cumulative dollar amount that was actually spent during the anomaly.
  pub total_actual_spend: Float? = None
  /// The cumulative dollar amount that was expected to be spent during the
  /// anomaly. It is calculated using advanced machine learning models to
  /// determine the typical spending pattern based on historical data for a
  /// customer.
  pub total_expected_spend: Float? = None
  /// The cumulative percentage difference between the total actual spend and
  /// total expected spend. It is calculated as (TotalImpact /
  /// TotalExpectedSpend) * 100 . When TotalExpectedSpend is zero, this field
  /// is omitted. Expected spend can be zero in situations such as when you
  /// start to use a service for the first time.
  pub total_impact_percentage: Float? = None
}

