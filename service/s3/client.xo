  }
  if let Some(x) = v.request_payer {
    xmlv.elem(w, "RequestPayer", x.value(), [])
  }
  if let Some(x) = v.bypass_governance_retention {
    xmlv.elem(w, "BypassGovernanceRetention", "${x}", [])
  }
  if let Some(x) = v.expected_bucket_owner {
    xmlv.elem(w, "ExpectedBucketOwner", x, [])
  }
  if let Some(x) = v.if_match {
    xmlv.elem(w, "IfMatch", x, [])
  }
  if let Some(x) = v.if_match_last_modified_time {
    xmlv.elem(w, "IfMatchLastModifiedTime", rest.http_date(x), [])
  }
  if let Some(x) = v.if_match_size {
    xmlv.elem(w, "IfMatchSize", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_delete_object_request(e: xml.Element) -> DeleteObjectRequest ! Str {
  var out = DeleteObjectRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Bucket" => out.bucket = c.text()
      "Key" => out.key = c.text()
      "MFA" => out.mfa = c.text()
      "VersionId" => out.version_id = c.text()
      "RequestPayer" => out.request_payer = RequestPayer.from(c.text())
      "BypassGovernanceRetention" => out.bypass_governance_retention = xmlv.read_bool(c.text())?
      "ExpectedBucketOwner" => out.expected_bucket_owner = c.text()
      "IfMatch" => out.if_match = c.text()
      "IfMatchLastModifiedTime" => out.if_match_last_modified_time = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      "IfMatchSize" => out.if_match_size = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

