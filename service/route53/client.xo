fn xml_write_hosted_zone(var w: xmlv.Writer, v: HostedZone, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.id {
    xmlv.elem(w, "Id", x, [])
  }
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.caller_reference {
    xmlv.elem(w, "CallerReference", x, [])
  }
  if let Some(x) = v.config {
    xml_write_hosted_zone_config(w, x, "Config", [])
  }
  if let Some(x) = v.resource_record_set_count {
    xmlv.elem(w, "ResourceRecordSetCount", "${x}", [])
  }
  if let Some(x) = v.linked_service {
    xml_write_linked_service(w, x, "LinkedService", [])
  }
  if let Some(x) = v.features {
    xml_write_hosted_zone_features(w, x, "Features", [])
  }
  xmlv.end(w, name)
}

fn xml_read_hosted_zone(e: xml.Element) -> HostedZone ! Str {
  var out = HostedZone{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Id" => out.id = c.text()
      "Name" => out.name = c.text()
      "CallerReference" => out.caller_reference = c.text()
      "Config" => out.config = xml_read_hosted_zone_config(c)?
      "ResourceRecordSetCount" => out.resource_record_set_count = xmlv.read_int(c.text())?
      "LinkedService" => out.linked_service = xml_read_linked_service(c)?
      "Features" => out.features = xml_read_hosted_zone_features(c)?
      _ => {}
    }
  }
  Ok(out)
}

