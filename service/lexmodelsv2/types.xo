/// An object containing information about a specific utterance.
pub struct UtteranceSpecification {
  /// The identifier of the alias of the bot that the utterance was made to.
  pub bot_alias_id: Str? = None
  /// The version of the bot that the utterance was made to.
  pub bot_version: Str? = None
  /// The locale of the bot that the utterance was made to.
  pub locale_id: Str? = None
  /// The identifier of the session that the utterance was made in.
  pub session_id: Str? = None
  /// The channel that is integrated with the bot that the utterance was made
  /// to.
  pub channel: Str? = None
  /// The mode of the session. The possible values are as follows: Speech –
  /// The session consisted of spoken dialogue. Text – The session consisted
  /// of written dialogue. DTMF – The session consisted of touch-tone keypad
  /// (Dual Tone Multi-Frequency) key presses. MultiMode – The session
  /// consisted of multiple modes.
  pub mode: AnalyticsModality? = None
  /// The date and time when the conversation in which the utterance took
  /// place began. A conversation is defined as a unique combination of a
  /// sessionId and an originatingRequestId .
  pub conversation_start_time: Time? = None
  /// The date and time when the conversation in which the utterance took
  /// place ended. A conversation is defined as a unique combination of a
  /// sessionId and an originatingRequestId .
  pub conversation_end_time: Time? = None
  /// The text of the utterance.
  pub utterance: Str? = None
  /// The date and time when the utterance took place.
  pub utterance_timestamp: Time? = None
  /// The duration in milliseconds of the audio associated with the utterance.
  pub audio_voice_duration_millis: Int? = None
  /// Specifies whether the bot understood the utterance or not.
  pub utterance_understood: Bool? = None
  /// The input type of the utterance. The possible values are as follows: PCM
  /// format: audio data must be in little-endian byte order. audio/l16;
  /// rate=16000; channels=1 audio/x-l16; sample-rate=16000; channel-count=1
  /// audio/lpcm; sample-rate=8000; sample-size-bits=16; channel-count=1;
  /// is-big-endian=false Opus format
  /// audio/x-cbr-opus-with-preamble;preamble-size=0;bit-rate=256000;frame-size-milliseconds=4
  /// Text format text/plain; charset=utf-8
  pub input_type: Str? = None
  /// The output type of the utterance. The possible values are as follows:
  /// audio/mpeg audio/ogg audio/pcm (16 KHz) audio/ (defaults to mpeg )
  /// text/plain; charset=utf-8
  pub output_type: Str? = None
  /// The name of the intent that the utterance is associated to.
  pub associated_intent_name: Str? = None
  /// The name of the slot that the utterance is associated to.
  pub associated_slot_name: Str? = None
  /// The state of the intent that the utterance is associated to.
  pub intent_state: IntentState? = None
  /// The type of dialog action that the utterance is associated to. See the
  /// type field in DialogAction for more information.
  pub dialog_action_type: Str? = None
  /// The identifier for the audio of the bot response.
  pub bot_response_audio_voice_id: Str? = None
  /// The slots that have been filled in the session by the time of the
  /// utterance.
  pub slots_filled_in_session: Str? = None
  /// The identifier of the request associated with the utterance.
  pub utterance_request_id: Str? = None
  /// A list of objects containing information about the bot response to the
  /// utterance.
  pub bot_responses: List[UtteranceBotResponse]? = None
}

