fn json_of_scaling_policy(v: ScalingPolicy) -> json.Value {
  match v {
    TargetTracking(x) => json.Value.Object([("TargetTracking", json_of_target_tracking_scaling_policy_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_scaling_policy(v: json.Value) -> ScalingPolicy ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "TargetTracking" => Ok(ScalingPolicy.TargetTracking(from_json_target_tracking_scaling_policy_configuration(fv)?))
      _ => Ok(ScalingPolicy.Unknown(k))
    }
  }
  Err("ScalingPolicy: no member set")
}

