    fs.push(("OutputColumns", json_of_output_column_list(x)))
  }
  if let Some(x) = v.import_mode {
    fs.push(("ImportMode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.consumed_spice_capacity_in_bytes {
    fs.push(("ConsumedSpiceCapacityInBytes", json.Value.Int(x)))
  }
  if let Some(x) = v.column_groups {
    fs.push(("ColumnGroups", json_of_column_group_list(x)))
  }
  if let Some(x) = v.field_folders {
    fs.push(("FieldFolders", json_of_field_folder_map(x)))
  }
  if let Some(x) = v.row_level_permission_data_set {
    fs.push(("RowLevelPermissionDataSet", json_of_row_level_permission_data_set(x)))
  }
  if let Some(x) = v.row_level_permission_tag_configuration {
    fs.push(("RowLevelPermissionTagConfiguration", json_of_row_level_permission_tag_configuration(x)))
  }
  if let Some(x) = v.column_level_permission_rules {
    fs.push(("ColumnLevelPermissionRules", json_of_column_level_permission_rule_list(x)))
  }
  if let Some(x) = v.data_set_usage_configuration {
    fs.push(("DataSetUsageConfiguration", json_of_data_set_usage_configuration(x)))
  }
  if let Some(x) = v.dataset_parameters {
    fs.push(("DatasetParameters", json_of_dataset_parameter_list(x)))
  }
  if let Some(x) = v.performance_configuration {
    fs.push(("PerformanceConfiguration", json_of_performance_configuration(x)))
  }
  if let Some(x) = v.use_as {
    fs.push(("UseAs", json.Value.Str(x.value())))
  }
  if let Some(x) = v.data_prep_configuration {
    fs.push(("DataPrepConfiguration", json_of_data_prep_configuration(x)))
  }
  if let Some(x) = v.semantic_model_configuration {
    fs.push(("SemanticModelConfiguration", json_of_semantic_model_configuration(x)))
  }
  json.Value.Object(fs)
}

fn from_json_data_set(v: json.Value) -> DataSet ! Str {
  var out = DataSet{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Arn" => out.arn = jsonv.read_str(fv)?
      "DataSetId" => out.data_set_id = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "CreatedTime" => out.created_time = jsonv.read_time(fv, "epoch-seconds")?
      "LastUpdatedTime" => out.last_updated_time = jsonv.read_time(fv, "epoch-seconds")?
      "PhysicalTableMap" => out.physical_table_map = from_json_physical_table_map(fv)?
      "LogicalTableMap" => out.logical_table_map = from_json_logical_table_map(fv)?
      "OutputColumns" => out.output_columns = from_json_output_column_list(fv)?
      "ImportMode" => out.import_mode = DataSetImportMode.from(jsonv.read_str(fv)?)
      "ConsumedSpiceCapacityInBytes" => out.consumed_spice_capacity_in_bytes = jsonv.read_int(fv)?
      "ColumnGroups" => out.column_groups = from_json_column_group_list(fv)?
      "FieldFolders" => out.field_folders = from_json_field_folder_map(fv)?
      "RowLevelPermissionDataSet" => out.row_level_permission_data_set = from_json_row_level_permission_data_set(fv)?
      "RowLevelPermissionTagConfiguration" => out.row_level_permission_tag_configuration = from_json_row_level_permission_tag_configuration(fv)?
      "ColumnLevelPermissionRules" => out.column_level_permission_rules = from_json_column_level_permission_rule_list(fv)?
      "DataSetUsageConfiguration" => out.data_set_usage_configuration = from_json_data_set_usage_configuration(fv)?
      "DatasetParameters" => out.dataset_parameters = from_json_dataset_parameter_list(fv)?
      "PerformanceConfiguration" => out.performance_configuration = from_json_performance_configuration(fv)?
      "UseAs" => out.use_as = DataSetUseAs.from(jsonv.read_str(fv)?)
      "DataPrepConfiguration" => out.data_prep_configuration = from_json_data_prep_configuration(fv)?
      "SemanticModelConfiguration" => out.semantic_model_configuration = from_json_semantic_model_configuration(fv)?
      _ => {}
    }
  }
  Ok(out)
}

