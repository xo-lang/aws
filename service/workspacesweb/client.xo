fn json_of_encryption_context_map(v: Map[Str, Str]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, Str)) -> (Str, json.Value) { (e.0, json.Value.Str(e.1)) }))
}

fn from_json_encryption_context_map(v: json.Value) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, jsonv.read_str(fv)?)
  }
  Ok(out)
}

fn json_of_event_filter(v: EventFilter) -> json.Value {
  match v {
    All => json.Value.Object([("all", json.Value.Object([]))])
    Include(x) => json.Value.Object([("include", json_of_events(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_event_filter(v: json.Value) -> EventFilter ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "all" => Ok(EventFilter.All)
      "include" => Ok(EventFilter.Include(from_json_events(fv)?))
      _ => Ok(EventFilter.Unknown(k))
    }
  }
  Err("EventFilter: no member set")
}

fn json_of_events(v: List[Event]) -> json.Value {
  json.Value.List(v.map(fn(x: Event) -> json.Value { json.Value.Str(x.value()) }))
}

fn from_json_events(v: json.Value) -> List[Event] ! Str {
  var out: List[Event] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(Event.from(jsonv.read_str(fv)?))
  }
  Ok(out)
}

