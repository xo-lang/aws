fn json_of_firewall_sync_reason(v: FirewallSyncReason) -> json.Value {
  match v {
    MissingFirewall(x) => json.Value.Object([("missingFirewall", json.Value.Str(x))])
    InvalidFirewall(x) => json.Value.Object([("invalidFirewall", json_of_invalid_firewall_reasons(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_firewall_sync_reason(v: json.Value) -> FirewallSyncReason ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "missingFirewall" => Ok(FirewallSyncReason.MissingFirewall(jsonv.read_str(fv)?))
      "invalidFirewall" => Ok(FirewallSyncReason.InvalidFirewall(from_json_invalid_firewall_reasons(fv)?))
      _ => Ok(FirewallSyncReason.Unknown(k))
    }
  }
  Err("FirewallSyncReason: no member set")
}

