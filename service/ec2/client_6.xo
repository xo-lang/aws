fn xml_read_response_launch_template_data(e: xml.Element) -> ResponseLaunchTemplateData ! Str {
  var out = ResponseLaunchTemplateData{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "kernelId" => out.kernel_id = c.text()
      "ebsOptimized" => out.ebs_optimized = xmlv.read_bool(c.text())?
      "iamInstanceProfile" => out.iam_instance_profile = xml_read_launch_template_iam_instance_profile_specification(c)?
      "blockDeviceMappingSet" => out.block_device_mappings = xml_read_launch_template_block_device_mapping_list(c)?
      "networkInterfaceSet" => out.network_interfaces = xml_read_launch_template_instance_network_interface_specification_list(c)?
      "imageId" => out.image_id = c.text()
      "instanceType" => out.instance_type = InstanceType.from(c.text())
      "keyName" => out.key_name = c.text()
      "monitoring" => out.monitoring = xml_read_launch_templates_monitoring(c)?
      "placement" => out.placement = xml_read_launch_template_placement(c)?
      "ramDiskId" => out.ram_disk_id = c.text()
      "disableApiTermination" => out.disable_api_termination = xmlv.read_bool(c.text())?
      "instanceInitiatedShutdownBehavior" => out.instance_initiated_shutdown_behavior = ShutdownBehavior.from(c.text())
      "userData" => out.user_data = c.text()
      "tagSpecificationSet" => out.tag_specifications = xml_read_launch_template_tag_specification_list(c)?
      "elasticGpuSpecificationSet" => out.elastic_gpu_specifications = xml_read_elastic_gpu_specification_response_list(c)?
      "elasticInferenceAcceleratorSet" => out.elastic_inference_accelerators = xml_read_launch_template_elastic_inference_accelerator_response_list(c)?
      "securityGroupIdSet" => out.security_group_ids = xml_read_value_string_list(c)?
      "securityGroupSet" => out.security_groups = xml_read_value_string_list(c)?
      "instanceMarketOptions" => out.instance_market_options = xml_read_launch_template_instance_market_options(c)?
      "creditSpecification" => out.credit_specification = xml_read_credit_specification(c)?
      "cpuOptions" => out.cpu_options = xml_read_launch_template_cpu_options(c)?
      "capacityReservationSpecification" => out.capacity_reservation_specification = xml_read_launch_template_capacity_reservation_specification_response(c)?
      "licenseSet" => out.license_specifications = xml_read_launch_template_license_list(c)?
      "hibernationOptions" => out.hibernation_options = xml_read_launch_template_hibernation_options(c)?
      "metadataOptions" => out.metadata_options = xml_read_launch_template_instance_metadata_options(c)?
      "enclaveOptions" => out.enclave_options = xml_read_launch_template_enclave_options(c)?
      "instanceRequirements" => out.instance_requirements = xml_read_instance_requirements(c)?
      "privateDnsNameOptions" => out.private_dns_name_options = xml_read_launch_template_private_dns_name_options(c)?
      "maintenanceOptions" => out.maintenance_options = xml_read_launch_template_instance_maintenance_options(c)?
      "disableApiStop" => out.disable_api_stop = xmlv.read_bool(c.text())?
      "operator" => out.operator = xml_read_operator_response(c)?
      "networkPerformanceOptions" => out.network_performance_options = xml_read_launch_template_network_performance_options(c)?
      "secondaryInterfaceSet" => out.secondary_interfaces = xml_read_launch_template_instance_secondary_interface_specification_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

