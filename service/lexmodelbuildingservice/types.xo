pub struct StartImportRequest {
  /// A zip archive in binary format. The archive should contain one file, a
  /// JSON file containing the resource to import. The resource should match
  /// the type specified in the resourceType field.
  pub payload: Bytes? = None
  /// Specifies the type of resource to export. Each resource also exports any
  /// resources that it depends on. A bot exports dependent intents. An intent
  /// exports dependent slot types.
  pub resource_type: ResourceType? = None
  /// Specifies the action that the StartImport operation should take when
  /// there is an existing resource with the same name. FAIL_ON_CONFLICT - The
  /// import operation is stopped on the first conflict between a resource in
  /// the import file and an existing resource. The name of the resource
  /// causing the conflict is in the failureReason field of the response to
  /// the GetImport operation. OVERWRITE_LATEST - The import operation
  /// proceeds even if there is a conflict with an existing resource. The
  /// $LASTEST version of the existing resource is overwritten with the data
  /// from the import file.
  pub merge_strategy: MergeStrategy? = None
  /// A list of tags to add to the imported bot. You can only add tags when
  /// you import a bot, you can't add tags to an intent or slot type.
  pub tags: List[Tag]? = None
}

pub struct StartImportResponse {
  /// The name given to the import job.
  pub name: Str? = None
  /// The type of resource to import.
  pub resource_type: ResourceType? = None
  /// The action to take when there is a merge conflict.
  pub merge_strategy: MergeStrategy? = None
  /// The identifier for the specific import job.
  pub import_id: Str? = None
  /// The status of the import job. If the status is FAILED , you can get the
  /// reason for the failure using the GetImport operation.
  pub import_status: ImportStatus? = None
  /// A list of tags added to the imported bot.
  pub tags: List[Tag]? = None
  /// A timestamp for the date and time that the import job was requested.
  pub created_date: Time? = None
}

pub struct StartMigrationRequest {
  /// The name of the Amazon Lex V1 bot that you are migrating to Amazon Lex
  /// V2.
  pub v1_bot_name: Str? = None
  /// The version of the bot to migrate to Amazon Lex V2. You can migrate the
  /// $LATEST version as well as any numbered version.
  pub v1_bot_version: Str? = None
  /// The name of the Amazon Lex V2 bot that you are migrating the Amazon Lex
  /// V1 bot to. If the Amazon Lex V2 bot doesn't exist, you must use the
  /// CREATE_NEW migration strategy. If the Amazon Lex V2 bot exists, you must
  /// use the UPDATE_EXISTING migration strategy to change the contents of the
  /// Amazon Lex V2 bot.
  pub v2_bot_name: Str? = None
  /// The IAM role that Amazon Lex uses to run the Amazon Lex V2 bot.
  pub v2_bot_role: Str? = None
  /// The strategy used to conduct the migration. CREATE_NEW - Creates a new
  /// Amazon Lex V2 bot and migrates the Amazon Lex V1 bot to the new bot.
  /// UPDATE_EXISTING - Overwrites the existing Amazon Lex V2 bot metadata and
  /// the locale being migrated. It doesn't change any other locales in the
  /// Amazon Lex V2 bot. If the locale doesn't exist, a new locale is created
  /// in the Amazon Lex V2 bot.
  pub migration_strategy: MigrationStrategy? = None
}

pub struct StartMigrationResponse {
  /// The name of the Amazon Lex V1 bot that you are migrating to Amazon Lex
  /// V2.
  pub v1_bot_name: Str? = None
  /// The version of the bot to migrate to Amazon Lex V2.
  pub v1_bot_version: Str? = None
  /// The locale used for the Amazon Lex V1 bot.
  pub v1_bot_locale: Locale? = None
  /// The unique identifier for the Amazon Lex V2 bot.
  pub v2_bot_id: Str? = None
  /// The IAM role that Amazon Lex uses to run the Amazon Lex V2 bot.
  pub v2_bot_role: Str? = None
  /// The unique identifier that Amazon Lex assigned to the migration.
  pub migration_id: Str? = None
  /// The strategy used to conduct the migration.
  pub migration_strategy: MigrationStrategy? = None
  /// The date and time that the migration started.
