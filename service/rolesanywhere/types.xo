  /// It can contain only letters (A-Z and a-z), numbers (0-9), underscores
  /// (_), hyphens (-), and forward slashes (/). A forward slash can appear
  /// only between two other characters, so an alias name can't end with a
  /// forward slash or contain two in a row. Alias names that begin with aws/
  /// , in any combination of uppercase and lowercase letters, are reserved.
  /// Alias names are case sensitive. The alias name must be unique among
  /// resources of the same type in your account and Region. If another
  /// resource of the same type already has the alias, the request fails with
  /// a ValidationException . An invalid or reserved alias name also causes a
  /// ValidationException .
  pub alias_name: Str? = None
}

/// Validation exception error.
pub struct ValidationException {
  pub message: Str? = None
}
