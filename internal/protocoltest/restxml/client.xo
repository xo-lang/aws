  for c in xmlv.elements(body) {
    match c.name.local {
      "stringList" => out.string_list = xml_read_string_list(c)?
      "stringSet" => out.string_set = xml_read_string_set(c)?
      "integerList" => out.integer_list = xml_read_integer_list(c)?
      "booleanList" => out.boolean_list = xml_read_boolean_list(c)?
      "timestampList" => out.timestamp_list = xml_read_timestamp_list(c)?
      "enumList" => out.enum_list = xml_read_foo_enum_list(c)?
      "intEnumList" => out.int_enum_list = xml_read_integer_enum_list(c)?
      "nestedStringList" => out.nested_string_list = xml_read_nested_string_list(c)?
      "renamed" => out.renamed_list_members = xml_read_renamed_list_members(c)?
