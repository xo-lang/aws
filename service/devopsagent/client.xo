/// The events of SendMessage, read as they arrive. `output` has the
/// response's other members; close the stream when done with it.
pub struct SendMessageEventsReader {
  pub output: SendMessageResponse
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
}

/// The next event, None at the end of the stream.
pub fn (var s: SendMessageEventsReader) next() -> SendMessageEvents? ! SendMessageEventsErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(SendMessageEventsErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              continue
            }
            return match event_send_message_events(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(SendMessageEventsErr.Read(msg))
            }
          }
          "exception" => return Err(exception_send_message_events(m))
          _ => return Err(SendMessageEventsErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(SendMessageEventsErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(SendMessageEventsErr.Read(e.display()))
          }
        }
      }
    }
  }
  Ok(None)
}

/// Stops reading the stream.
pub fn (var s: SendMessageEventsReader) close() {
  if !s.done {
    s.done = true
    s.body.close()
  }
}

/// Why reading a SendMessageEvents stream stopped.
pub enum SendMessageEventsErr {
  /// An error message, or an exception the model does not list.
  Api(e: aws.ApiError)
  /// The body could not be read or is not event stream messages.
  Read(msg: Str)
}

pub fn (e: SendMessageEventsErr) display() -> Str {
  match e {
    Api(x) => x.display()
    Read(msg) => "event stream: ${msg}"
  }
}

fn event_send_message_events(t: Str, m: eventstream.Message) -> SendMessageEvents ! Str {
  match t {
    "responseCreated" => Ok(SendMessageEvents.ResponseCreated(event_read_send_message_response_created_event(m)?))
    "responseInProgress" => Ok(SendMessageEvents.ResponseInProgress(event_read_send_message_response_in_progress_event(m)?))
    "responseCompleted" => Ok(SendMessageEvents.ResponseCompleted(event_read_send_message_response_completed_event(m)?))
    "responseFailed" => Ok(SendMessageEvents.ResponseFailed(event_read_send_message_response_failed_event(m)?))
    "summary" => Ok(SendMessageEvents.Summary(event_read_send_message_summary_event(m)?))
    "heartbeat" => Ok(SendMessageEvents.Heartbeat(event_read_send_message_heartbeat_event(m)?))
    "contentBlockStart" => Ok(SendMessageEvents.ContentBlockStart(event_read_send_message_content_block_start_event(m)?))
    "contentBlockDelta" => Ok(SendMessageEvents.ContentBlockDelta(event_read_send_message_content_block_delta_event(m)?))
    "contentBlockStop" => Ok(SendMessageEvents.ContentBlockStop(event_read_send_message_content_block_stop_event(m)?))
    _ => Ok(SendMessageEvents.Unknown(t))
  }
}

fn exception_send_message_events(m: eventstream.Message) -> SendMessageEventsErr {
  let t = m.header_str(":exception-type")
  match t {
    _ => SendMessageEventsErr.Api(aws.ApiError{code: t, message: m.payload.to_str() ?? ""})
  }
}

fn event_read_send_message_response_created_event(m: eventstream.Message) -> SendMessageResponseCreatedEvent ! Str {
  var out = if m.payload.is_empty() { SendMessageResponseCreatedEvent{} } else { from_json_send_message_response_created_event(jsonv.parse_body(m.payload)?)? }
  Ok(out)
}

