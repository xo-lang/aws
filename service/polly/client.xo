/// The HTTP request of UntagResource.
pub fn serialize_untag_resource(ep: rest.Endpoint, input: UntagResourceInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
