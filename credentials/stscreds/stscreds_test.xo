use std/http
use github.com/xo-lang/aws
use github.com/xo-lang/aws/credentials
use github.com/xo-lang/aws/service/sts

const ASSUME_OK: Str = r"""<AssumeRoleResponse xmlns="https://sts.amazonaws.com/doc/2011-06-15/">
  <AssumeRoleResult>
    <AssumedRoleUser>
      <Arn>arn:aws:sts::123456789012:assumed-role/Demo/session</Arn>
      <AssumedRoleId>AROATEST000000000000:session</AssumedRoleId>
    </AssumedRoleUser>
    <Credentials>
      <AccessKeyId>ROLEKEYEXAMPLE00000</AccessKeyId>
      <SecretAccessKey>invented-role-secret</SecretAccessKey>
      <SessionToken>invented-role-token</SessionToken>
      <Expiration>2026-01-01T01:00:00Z</Expiration>
    </Credentials>
  </AssumeRoleResult>
  <ResponseMetadata><RequestId>example-request-id-1</RequestId></ResponseMetadata>
</AssumeRoleResponse>"""

fn sts_client(net: Net, clock: Clock, rand: Rand) -> sts.Client ! Str {
  sts.new(net, clock, rand, sts.Options{region: "us-west-2", credentials: credentials.static_provider("AKIDTEST0000000000", "invented-secret")})
}

test "assume role" {
  let bodies = Mutex[List[Str]].new([])
  os.net.handle("POST https://sts.us-west-2.amazonaws.com/", fn(req: http.Request) -> http.Response {
    bodies.with(fn(var xs: List[Str]) { xs.push(req.body.to_str() ?? "") })
    http.text(200, ASSUME_OK)
  })
  let p = AssumeRoleProvider{client: sts_client(os.net, os.clock, os.rand)?, input: sts.AssumeRoleRequest{role_arn: "arn:aws:iam::123456789012:role/Demo", role_session_name: "session", duration_seconds: 900}}
  let creds = p.retrieve()?
  expect(creds.access_key_id) == "ROLEKEYEXAMPLE00000"
  expect(creds.secret_access_key.reveal()) == "invented-role-secret"
  expect(creds.expires) == Time.parse_rfc3339("2026-01-01T01:00:00Z")
  let sent = bodies.with_read(fn(xs: List[Str]) -> List[Str] { xs })
  expect(sent) == ["Action=AssumeRole&Version=2011-06-15&RoleArn=arn%3Aaws%3Aiam%3A%3A123456789012%3Arole%2FDemo&RoleSessionName=session&DurationSeconds=900"]
}

test "assume role provider maps errors" {
  os.net.handle("POST https://sts.us-west-2.amazonaws.com/", fn(_req: http.Request) -> http.Response {
    http.text(403, "<ErrorResponse><Error><Type>Sender</Type><Code>AccessDenied</Code><Message>no</Message></Error></ErrorResponse>")
  })
  let p = AssumeRoleProvider{client: sts_client(os.net, os.clock, os.rand)?, input: sts.AssumeRoleRequest{role_arn: "arn:aws:iam::123456789012:role/Demo", role_session_name: "s"}}
  match p.retrieve() {
    Err(aws.CredentialsErr.Fetch(msg)) => expect(msg.contains("AccessDenied")) == true
    other => expect("${other:?}") == "Fetch"
  }
}

test "caller identity" {
  os.net.handle("POST https://sts.us-west-2.amazonaws.com/", fn(_req: http.Request) -> http.Response {
    http.text(200, "<GetCallerIdentityResponse><GetCallerIdentityResult><Account>123456789012</Account><Arn>arn:aws:iam::123456789012:user/tester</Arn><UserId>AIDATEST000000000000</UserId></GetCallerIdentityResult></GetCallerIdentityResponse>")
  })
  let id = sts_client(os.net, os.clock, os.rand)?.get_caller_identity(sts.GetCallerIdentityRequest{})?
  expect(id.account) == Some("123456789012")
  expect(id.user_id) == Some("AIDATEST000000000000")
}
