fn json_of_session_specification(v: SessionSpecification) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.bot_alias_id {
    fs.push(("botAliasId", json.Value.Str(x)))
  }
  if let Some(x) = v.bot_version {
    fs.push(("botVersion", json.Value.Str(x)))
  }
  if let Some(x) = v.locale_id {
    fs.push(("localeId", json.Value.Str(x)))
  }
  if let Some(x) = v.channel {
    fs.push(("channel", json.Value.Str(x)))
  }
  if let Some(x) = v.session_id {
    fs.push(("sessionId", json.Value.Str(x)))
  }
  if let Some(x) = v.conversation_start_time {
    fs.push(("conversationStartTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.conversation_end_time {
    fs.push(("conversationEndTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.conversation_duration_seconds {
    fs.push(("conversationDurationSeconds", json.Value.Int(x)))
  }
  if let Some(x) = v.conversation_end_state {
    fs.push(("conversationEndState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.mode {
    fs.push(("mode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.number_of_turns {
    fs.push(("numberOfTurns", json.Value.Int(x)))
  }
  if let Some(x) = v.invoked_intent_samples {
    fs.push(("invokedIntentSamples", json_of_invoked_intent_samples(x)))
  }
  if let Some(x) = v.originating_request_id {
    fs.push(("originatingRequestId", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_session_specification(v: json.Value) -> SessionSpecification ! Str {
  var out = SessionSpecification{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "botAliasId" => out.bot_alias_id = jsonv.read_str(fv)?
      "botVersion" => out.bot_version = jsonv.read_str(fv)?
      "localeId" => out.locale_id = jsonv.read_str(fv)?
      "channel" => out.channel = jsonv.read_str(fv)?
      "sessionId" => out.session_id = jsonv.read_str(fv)?
      "conversationStartTime" => out.conversation_start_time = jsonv.read_time(fv, "epoch-seconds")?
      "conversationEndTime" => out.conversation_end_time = jsonv.read_time(fv, "epoch-seconds")?
      "conversationDurationSeconds" => out.conversation_duration_seconds = jsonv.read_int(fv)?
      "conversationEndState" => out.conversation_end_state = ConversationEndState.from(jsonv.read_str(fv)?)
      "mode" => out.mode = AnalyticsModality.from(jsonv.read_str(fv)?)
      "numberOfTurns" => out.number_of_turns = jsonv.read_int(fv)?
      "invokedIntentSamples" => out.invoked_intent_samples = from_json_invoked_intent_samples(fv)?
      "originatingRequestId" => out.originating_request_id = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

