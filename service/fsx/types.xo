  /// 4096 MB/s.
  pub throughput_capacity: Int? = None
  pub weekly_maintenance_start_time: Str? = None
  pub disk_iops_configuration: DiskIopsConfiguration? = None
  /// (Multi-AZ only) A list of IDs of new virtual private cloud (VPC) route
