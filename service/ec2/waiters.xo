/// Calls DescribeBundleTasks until the BundleTaskComplete acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (15s) to `max_delay` (120s).
pub fn wait_until_bundle_task_complete(c: Client, input: DescribeBundleTasksRequest, max_wait: Duration, min_delay: Duration = 15s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeBundleTasksErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_bundle_tasks(input) {
      Ok(out) => {
        let o = jmes_of_describe_bundle_tasks_result(out)
        if state == "" && waiter.path_matches(o, "BundleTasks[].State", "allStringEquals", "complete") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "BundleTasks[].State", "anyStringEquals", "failed") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("BundleTaskComplete: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

