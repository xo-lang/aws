}

/// The HTTP request of AddPermission.
pub fn serialize_add_permission(ep: rest.Endpoint, input: AddPermissionInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var f = query.form("AddPermission", "2010-03-31")
  if let Some(x) = input.topic_arn {
    query.add(f, query.key("", "TopicArn"), x)
  }
  if let Some(x) = input.label {
    query.add(f, query.key("", "Label"), x)
  }
  if let Some(x) = input.aws_account_id {
    query_put_delegates_list(f, query.key("", "AWSAccountId"), x, false)
  }
  if let Some(x) = input.action_name {
    query_put_actions_list(f, query.key("", "ActionName"), x, false)
  }
  body = query.encode(f).bytes()
  headers.push(("Content-Type", "application/x-www-form-urlencoded"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
