      "routerOutput" => Ok(SourceEndpointAssociatedResourceDetails.RouterOutput(from_json_router_output_source_endpoint_associated_resource_details(fv)?))
      _ => Ok(SourceEndpointAssociatedResourceDetails.Unknown(k))
    }
  }
  Err("SourceEndpointAssociatedResourceDetails: no member set")
}

