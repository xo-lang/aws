    KmsAliasArn(x) => json.Value.Object([("kmsAliasArn", json.Value.Str(x))])
    KmsAliasName(x) => json.Value.Object([("kmsAliasName", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_kms_key(v: json.Value) -> KmsKey ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "kmsKeyArn" => Ok(KmsKey.KmsKeyArn(jsonv.read_str(fv)?))
      "kmsAliasArn" => Ok(KmsKey.KmsAliasArn(jsonv.read_str(fv)?))
      "kmsAliasName" => Ok(KmsKey.KmsAliasName(jsonv.read_str(fv)?))
      _ => Ok(KmsKey.Unknown(k))
    }
  }
  Err("KmsKey: no member set")
}

