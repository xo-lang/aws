    xml_write_integer_list(w, x, "integerList", [])
  }
  if let Some(x) = input.boolean_list {
    xml_write_boolean_list(w, x, "booleanList", [])
  }
  if let Some(x) = input.timestamp_list {
    xml_write_timestamp_list(w, x, "timestampList", [])
  }
  if let Some(x) = input.enum_list {
    xml_write_foo_enum_list(w, x, "enumList", [])
  }
  if let Some(x) = input.int_enum_list {
    xml_write_integer_enum_list(w, x, "intEnumList", [])
  }
  if let Some(x) = input.nested_string_list {
    xml_write_nested_string_list(w, x, "nestedStringList", [])
  }
  if let Some(x) = input.renamed_list_members {
    xml_write_renamed_list_members(w, x, "renamed", [])
  }
  if let Some(x) = input.flattened_list {
    for item in x {
      xmlv.elem(w, "flattenedList", item, [])
    }
  }
  if let Some(x) = input.flattened_list2 {
    for item in x {
      xmlv.elem(w, "customName", item, [])
    }
  }
  if let Some(x) = input.flattened_list_with_member_namespace {
    for item in x {
      xmlv.elem(w, "flattenedListWithMemberNamespace", item, [("xmlns", "https://xml-member.example.com")])
    }
  }
  if let Some(x) = input.flattened_list_with_namespace {
    for item in x {
      xmlv.elem(w, "flattenedListWithNamespace", item, [])
    }
  }
  if let Some(x) = input.structure_list {
    xml_write_structure_list(w, x, "myStructureList", [])
  }
  if let Some(x) = input.flattened_structure_list {
    for item in x {
      xml_write_structure_list_member(w, item, "flattenedStructureList", [])
    }
  }
  xmlv.end(w, "XmlEmptyListsRequest")
  body = xmlv.finish(w)
  headers.push(("Content-Type", "application/xml"))
  if !body.is_empty() {
