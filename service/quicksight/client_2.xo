fn json_of_custom_prompt_input(v: CustomPromptInput) -> json.Value {
  match v {
    ExistingPrompt(x) => json.Value.Object([("ExistingPrompt", json_of_custom_prompt_profile(x))])
    NewPrompt(x) => json.Value.Object([("NewPrompt", json_of_custom_prompt_input_parameters(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_custom_prompt_input(v: json.Value) -> CustomPromptInput ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "ExistingPrompt" => Ok(CustomPromptInput.ExistingPrompt(from_json_custom_prompt_profile(fv)?))
      "NewPrompt" => Ok(CustomPromptInput.NewPrompt(from_json_custom_prompt_input_parameters(fv)?))
      _ => Ok(CustomPromptInput.Unknown(k))
    }
  }
  Err("CustomPromptInput: no member set")
}

