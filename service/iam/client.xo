fn query_put_eval_decision_details_type(var f: query.Form, prefix: Str, v: Map[Str, PolicyEvaluationDecisionType], flat: Bool) {
  // sorted keys, as aws-sdk-go-v2 writes them
  for (i, k) in v.keys().sort().indexed() {
    let e = if flat { "${prefix}.${i + 1}" } else { "${prefix}.entry.${i + 1}" }
    query.add(f, "${e}.key", k)
    if let Some(x) = v.get(k) {
      query.add(f, "${e}.value", x.value())
    }
  }
}

fn query_put_evaluation_result(var f: query.Form, prefix: Str, v: EvaluationResult) {
  if let Some(x) = v.eval_action_name {
    query.add(f, query.key(prefix, "EvalActionName"), x)
  }
  if let Some(x) = v.eval_resource_name {
    query.add(f, query.key(prefix, "EvalResourceName"), x)
  }
  if let Some(x) = v.eval_decision {
    query.add(f, query.key(prefix, "EvalDecision"), x.value())
  }
  if let Some(x) = v.matched_statements {
    query_put_statement_list_type(f, query.key(prefix, "MatchedStatements"), x, false)
  }
  if let Some(x) = v.missing_context_values {
    query_put_context_key_names_result_list_type(f, query.key(prefix, "MissingContextValues"), x, false)
  }
  if let Some(x) = v.organizations_decision_detail {
    query_put_organizations_decision_detail(f, query.key(prefix, "OrganizationsDecisionDetail"), x)
  }
  if let Some(x) = v.permissions_boundary_decision_detail {
    query_put_permissions_boundary_decision_detail(f, query.key(prefix, "PermissionsBoundaryDecisionDetail"), x)
  }
  if let Some(x) = v.eval_decision_details {
    query_put_eval_decision_details_type(f, query.key(prefix, "EvalDecisionDetails"), x, false)
  }
  if let Some(x) = v.resource_specific_results {
    query_put_resource_specific_result_list_type(f, query.key(prefix, "ResourceSpecificResults"), x, false)
  }
}

fn query_put_evaluation_results_list_type(var f: query.Form, prefix: Str, v: List[EvaluationResult], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_evaluation_result(f, k, x)
  }
}

