fn from_json_layout_content(v: json.Value) -> LayoutContent ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "basic" => Ok(LayoutContent.Basic(from_json_basic_layout(fv)?))
      _ => Ok(LayoutContent.Unknown(k))
    }
  }
  Err("LayoutContent: no member set")
}

