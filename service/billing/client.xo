fn json_of_contract_details(v: ContractDetails) -> json.Value {
  match v {
    PrivatePricingAddendum(x) => json.Value.Object([("privatePricingAddendum", json_of_private_pricing_addendum(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_contract_details(v: json.Value) -> ContractDetails ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "privatePricingAddendum" => Ok(ContractDetails.PrivatePricingAddendum(from_json_private_pricing_addendum(fv)?))
      _ => Ok(ContractDetails.Unknown(k))
    }
  }
  Err("ContractDetails: no member set")
}

