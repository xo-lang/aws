fn xml_write_object_encryption_filter(var w: xmlv.Writer, v: ObjectEncryptionFilter, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    Sses3(x) => {
      xml_write_sses3_filter(w, x, "SSE-S3", [])
    }
    SseKms(x) => {
      xml_write_sse_kms_filter(w, x, "SSE-KMS", [])
    }
    DsseKms(x) => {
      xml_write_dsse_kms_filter(w, x, "DSSE-KMS", [])
    }
    Ssec(x) => {
      xml_write_ssec_filter(w, x, "SSE-C", [])
    }
    Notsse(x) => {
      xml_write_not_sse_filter(w, x, "NOT-SSE", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_object_encryption_filter(e: xml.Element) -> ObjectEncryptionFilter ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "SSE-S3" => Ok(ObjectEncryptionFilter.Sses3(xml_read_sses3_filter(c)?))
      "SSE-KMS" => Ok(ObjectEncryptionFilter.SseKms(xml_read_sse_kms_filter(c)?))
      "DSSE-KMS" => Ok(ObjectEncryptionFilter.DsseKms(xml_read_dsse_kms_filter(c)?))
      "SSE-C" => Ok(ObjectEncryptionFilter.Ssec(xml_read_ssec_filter(c)?))
      "NOT-SSE" => Ok(ObjectEncryptionFilter.Notsse(xml_read_not_sse_filter(c)?))
      _ => Ok(ObjectEncryptionFilter.Unknown(c.name.local))
    }
  }
  Err("ObjectEncryptionFilter: no member set")
}

