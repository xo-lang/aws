  pub inference_specification_name: Str? = None
  /// Defines the environment parameters that includes key, value types, and
  /// values.
  pub environment_parameters: List[EnvironmentParameter]? = None
  /// The name of the compilation job used to create the recommended model
  /// artifacts.
  pub compilation_job_name: Str? = None
}

/// An endpoint that hosts a model displayed in the Amazon SageMaker Model
/// Dashboard.
pub struct ModelDashboardEndpoint {
  /// The endpoint name.
  pub endpoint_name: Str? = None
  /// The Amazon Resource Name (ARN) of the endpoint.
  pub endpoint_arn: Str? = None
  /// A timestamp that indicates when the endpoint was created.
  pub creation_time: Time? = None
  /// The last time the endpoint was modified.
  pub last_modified_time: Time? = None
  /// The endpoint status.
  pub endpoint_status: EndpointStatus? = None
}

/// An alert action taken to light up an icon on the Amazon SageMaker Model
/// Dashboard when an alert goes into InAlert status.
pub struct ModelDashboardIndicatorAction {
  /// Indicates whether the alert action is turned on.
  pub enabled: Bool? = None
}

/// A model displayed in the Amazon SageMaker Model Dashboard.
pub struct ModelDashboardModel {
  /// A model displayed in the Model Dashboard.
  pub model: Model? = None
  /// The endpoints that host a model.
  pub endpoints: List[ModelDashboardEndpoint]? = None
  pub last_batch_transform_job: TransformJob? = None
  /// The monitoring schedules for a model.
  pub monitoring_schedules: List[ModelDashboardMonitoringSchedule]? = None
  /// The model card for a model.
  pub model_card: ModelDashboardModelCard? = None
}

/// The model card for a model displayed in the Amazon SageMaker Model
/// Dashboard.
pub struct ModelDashboardModelCard {
  /// The Amazon Resource Name (ARN) for a model card.
  pub model_card_arn: Str? = None
  /// The name of a model card.
  pub model_card_name: Str? = None
  /// The model card version.
  pub model_card_version: Int? = None
  /// The model card status.
  pub model_card_status: ModelCardStatus? = None
  /// The KMS Key ID ( KMSKeyId ) for encryption of model card information.
  pub security_config: ModelCardSecurityConfig? = None
  /// A timestamp that indicates when the model card was created.
  pub creation_time: Time? = None
  pub created_by: UserContext? = None
  /// A timestamp that indicates when the model card was last updated.
  pub last_modified_time: Time? = None
  pub last_modified_by: UserContext? = None
  /// The tags associated with a model card.
  pub tags: List[Tag]? = None
  /// For models created in SageMaker, this is the model ARN. For models
  /// created outside of SageMaker, this is a user-customized string.
  pub model_id: Str? = None
  /// A model card's risk rating. Can be low, medium, or high.
  pub risk_rating: Str? = None
}

/// A monitoring schedule for a model displayed in the Amazon SageMaker
/// Model Dashboard.
pub struct ModelDashboardMonitoringSchedule {
  /// The Amazon Resource Name (ARN) of a monitoring schedule.
  pub monitoring_schedule_arn: Str? = None
  /// The name of a monitoring schedule.
  pub monitoring_schedule_name: Str? = None
  /// The status of the monitoring schedule.
  pub monitoring_schedule_status: ScheduleStatus? = None
  /// The monitor type of a model monitor.
  pub monitoring_type: MonitoringType? = None
  /// If a monitoring job failed, provides the reason.
  pub failure_reason: Str? = None
  /// A timestamp that indicates when the monitoring schedule was created.
  pub creation_time: Time? = None
  /// A timestamp that indicates when the monitoring schedule was last
  /// updated.
  pub last_modified_time: Time? = None
  pub monitoring_schedule_config: MonitoringScheduleConfig? = None
  /// The endpoint which is monitored.
  pub endpoint_name: Str? = None
  /// A JSON array where each element is a summary for a monitoring alert.
  pub monitoring_alert_summaries: List[MonitoringAlertSummary]? = None
  pub last_monitoring_execution_summary: MonitoringExecutionSummary? = None
  pub batch_transform_input: BatchTransformInput? = None
}

/// Data quality constraints and statistics for a model.
pub struct ModelDataQuality {
  /// Data quality statistics for a model.
  pub statistics: MetricsSource? = None
  /// Data quality constraints for a model.
  pub constraints: MetricsSource? = None
}

/// Specifies the location of ML model data to deploy. If specified, you
/// must specify one and only one of the available data sources.
pub struct ModelDataSource {
  /// Specifies the S3 location of ML model data to deploy.
  pub s3_data_source: S3ModelDataSource? = None
}

/// Specifies how to generate the endpoint name for an automatic one-click
/// Autopilot model deployment.
pub struct ModelDeployConfig {
  /// Set to True to automatically generate an endpoint name for a one-click
  /// Autopilot model deployment; set to False otherwise. The default value is
  /// False . If you set AutoGenerateEndpointName to True , do not specify the
  /// EndpointName ; otherwise a 400 error is thrown.
  pub auto_generate_endpoint_name: Bool? = None
  /// Specifies the endpoint name to use for a one-click Autopilot model
  /// deployment if the endpoint name is not generated automatically. Specify
  /// the EndpointName if and only if you set AutoGenerateEndpointName to
  /// False ; otherwise a 400 error is thrown.
  pub endpoint_name: Str? = None
}

/// Provides information about the endpoint of the model deployment.
pub struct ModelDeployResult {
  /// The name of the endpoint to which the model has been deployed. If model
  /// deployment fails, this field is omitted from the response.
  pub endpoint_name: Str? = None
}

/// Provides information to verify the integrity of stored model artifacts.
pub struct ModelDigests {
  /// Provides a hash value that uniquely identifies the stored model
  /// artifacts.
  pub artifact_digest: Str? = None
}

/// Docker container image configuration object for the model explainability
/// job.
pub struct ModelExplainabilityAppSpecification {
  /// The container image to be run by the model explainability job.
  pub image_uri: Str? = None
  /// JSON formatted Amazon S3 file that defines explainability parameters.
  /// For more information on this JSON configuration file, see Configure
  /// model explainability parameters .
  pub config_uri: Str? = None
  /// Sets the environment variables in the Docker container.
  pub environment: Map[Str, Str]? = None
}

/// The configuration for a baseline model explainability job.
pub struct ModelExplainabilityBaselineConfig {
  /// The name of the baseline model explainability job.
  pub baselining_job_name: Str? = None
  pub constraints_resource: MonitoringConstraintsResource? = None
}

/// Inputs for the model explainability job.
pub struct ModelExplainabilityJobInput {
  pub endpoint_input: EndpointInput? = None
  /// Input object for the batch transform job.
  pub batch_transform_input: BatchTransformInput? = None
}

/// The configuration for the infrastructure that the model will be deployed
/// to.
pub struct ModelInfrastructureConfig {
  /// The inference option to which to deploy your model. Possible values are
  /// the following: RealTime : Deploy to real-time inference.
  pub infrastructure_type: ModelInfrastructureType? = None
  /// The infrastructure configuration for deploying the model to real-time
  /// inference.
  pub real_time_inference_config: RealTimeInferenceConfig? = None
}

pub enum ModelInfrastructureType: Str {
  RealTimeInference = "RealTimeInference"
  Unknown(value: Str)
}

/// Input object for the model.
pub struct ModelInput {
  /// The input configuration object for the model.
  pub data_input_config: Str? = None
}

/// The model latency threshold.
pub struct ModelLatencyThreshold {
  /// The model latency percentile threshold. Acceptable values are P95 and
  /// P99 . For custom load tests, specify the value as P95 .
  pub percentile: Str? = None
  /// The model latency percentile value in milliseconds.
  pub value_in_milliseconds: Int? = None
}

/// A structure describing the current state of the model in its life cycle.
pub struct ModelLifeCycle {
  /// The current stage in the model life cycle.
  pub stage: Str? = None
  /// The current status of a stage in model life cycle.
  pub stage_status: Str? = None
  /// Describes the stage related details.
  pub stage_description: Str? = None
}

/// Part of the search expression. You can specify the name and value
/// (domain, task, framework, framework version, task, and model).
pub struct ModelMetadataFilter {
  /// The name of the of the model to filter by.
  pub name: ModelMetadataFilterType? = None
  /// The value to filter the model metadata.
  pub value: Str? = None
}

pub enum ModelMetadataFilterType: Str {
  Domain = "Domain"
  Framework = "Framework"
  Task = "Task"
  Frameworkversion = "FrameworkVersion"
  Unknown(value: Str)
}

/// One or more filters that searches for the specified resource or
/// resources in a search. All resource objects that satisfy the
/// expression's condition are included in the search results
pub struct ModelMetadataSearchExpression {
  /// A list of filter objects.
  pub filters: List[ModelMetadataFilter]? = None
}

/// A summary of the model metadata.
pub struct ModelMetadataSummary {
  /// The machine learning domain of the model.
  pub domain: Str? = None
  /// The machine learning framework of the model.
  pub framework: Str? = None
  /// The machine learning task of the model.
  pub task: Str? = None
  /// The name of the model.
  pub model: Str? = None
  /// The framework version of the model.
  pub framework_version: Str? = None
}

/// Contains metrics captured from a model.
pub struct ModelMetrics {
  /// Metrics that measure the quality of a model.
  pub model_quality: ModelQuality? = None
  /// Metrics that measure the quality of the input data for a model.
  pub model_data_quality: ModelDataQuality? = None
  /// Metrics that measure bias in a model.
  pub bias: Bias? = None
  /// Metrics that help explain a model.
  pub explainability: Explainability? = None
}

/// A container for your trained model that can be deployed for SageMaker
/// inference. This can include inference code, artifacts, and metadata. The
/// model package type can be one of the following. Versioned model: A part
/// of a model package group in Model Registry. Unversioned model: Not part
/// of a model package group and used in Amazon Web Services Marketplace.
/// For more information, see CreateModelPackage .
pub struct ModelPackage {
  /// The name of the model package. The name can be as follows: For a
  /// versioned model, the name is automatically generated by SageMaker Model
  /// Registry and follows the format '
  /// ModelPackageGroupName/ModelPackageVersion '. For an unversioned model,
  /// you must provide the name.
  pub model_package_name: Str? = None
  /// The model group to which the model belongs.
  pub model_package_group_name: Str? = None
  /// The version number of a versioned model.
  pub model_package_version: Int? = None
  /// The package registration type of the model package.
  pub model_package_registration_type: ModelPackageRegistrationType? = None
  /// The Amazon Resource Name (ARN) of the model package.
  pub model_package_arn: Str? = None
  /// The description of the model package.
  pub model_package_description: Str? = None
  /// The time that the model package was created.
  pub creation_time: Time? = None
  /// Defines how to perform inference generation after a training job is run.
  pub inference_specification: InferenceSpecification? = None
  /// A list of algorithms that were used to create a model package.
  pub source_algorithm_specification: SourceAlgorithmSpecification? = None
  /// Specifies batch transform jobs that SageMaker runs to validate your
  /// model package.
  pub validation_specification: ModelPackageValidationSpecification? = None
  /// The status of the model package. This can be one of the following
  /// values. PENDING - The model package is pending being created.
  /// IN_PROGRESS - The model package is in the process of being created.
  /// COMPLETED - The model package was successfully created. FAILED - The
  /// model package failed. DELETING - The model package is in the process of
  /// being deleted.
  pub model_package_status: ModelPackageStatus? = None
  /// Specifies the validation and image scan statuses of the model package.
  pub model_package_status_details: ModelPackageStatusDetails? = None
  /// Whether the model package is to be certified to be listed on Amazon Web
  /// Services Marketplace. For information about listing model packages on
  /// Amazon Web Services Marketplace, see List Your Algorithm or Model
  /// Package on Amazon Web Services Marketplace .
  pub certify_for_marketplace: Bool? = None
  /// The approval status of the model. This can be one of the following
  /// values. APPROVED - The model is approved REJECTED - The model is
  /// rejected. PENDING_MANUAL_APPROVAL - The model is waiting for manual
  /// approval.
  pub model_approval_status: ModelApprovalStatus? = None
  /// Information about the user who created or modified an experiment, trial,
  /// trial component, lineage group, or project.
  pub created_by: UserContext? = None
  /// Metadata properties of the tracking entity, trial, or trial component.
  pub metadata_properties: MetadataProperties? = None
  /// Metrics for the model.
  pub model_metrics: ModelMetrics? = None
  /// The last time the model package was modified.
  pub last_modified_time: Time? = None
  /// Information about the user who created or modified an experiment, trial,
  /// trial component, lineage group, or project.
  pub last_modified_by: UserContext? = None
  /// A description provided when the model approval is set.
  pub approval_description: Str? = None
  /// The machine learning domain of your model package and its components.
  /// Common machine learning domains include computer vision and natural
  /// language processing.
  pub domain: Str? = None
  /// The machine learning task your model package accomplishes. Common
  /// machine learning tasks include object detection and image
  /// classification.
  pub task: Str? = None
  /// The Amazon Simple Storage Service path where the sample payload are
  /// stored. This path must point to a single gzip compressed tar archive
  /// (.tar.gz suffix).
  pub sample_payload_url: Str? = None
  /// An array of additional Inference Specification objects.
  pub additional_inference_specifications: List[AdditionalInferenceSpecificationDefinition]? = None
  /// The URI of the source for the model package.
  pub source_uri: Str? = None
  pub security_config: ModelPackageSecurityConfig? = None
  pub model_card: ModelPackageModelCard? = None
  /// A structure describing the current state of the model in its life cycle.
  pub model_life_cycle: ModelLifeCycle? = None
  /// A list of the tags associated with the model package. For more
  /// information, see Tagging Amazon Web Services resources in the Amazon Web
  /// Services General Reference Guide .
  pub tags: List[Tag]? = None
  /// The metadata properties for the model package.
  pub customer_metadata_properties: Map[Str, Str]? = None
  /// Represents the drift check baselines that can be used when the model
  /// monitor is set using the model package.
  pub drift_check_baselines: DriftCheckBaselines? = None
  /// Indicates if you want to skip model validation.
  pub skip_model_validation: SkipModelValidation? = None
}

/// The configuration for the Model package.
pub struct ModelPackageConfig {
  /// The Amazon Resource Name (ARN) of the model package group of output
  /// model package.
  pub model_package_group_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the source model package used for
  /// continued fine-tuning and custom model evaluation.
  pub source_model_package_arn: Str? = None
}

/// Describes the Docker container for the model package.
pub struct ModelPackageContainerDefinition {
  /// The DNS host name for the Docker container.
  pub container_hostname: Str? = None
  /// The Amazon Elastic Container Registry (Amazon ECR) path where inference
  /// code is stored. If you are using your own custom algorithm instead of an
  /// algorithm provided by SageMaker, the inference code must meet SageMaker
  /// requirements. SageMaker supports both registry/repository[:tag] and
  /// registry/repository[@digest] image path formats. For more information,
  /// see Using Your Own Algorithms with Amazon SageMaker .
  pub image: Str? = None
  /// An MD5 hash of the training algorithm that identifies the Docker image
  /// used for training.
  pub image_digest: Str? = None
  /// The Amazon S3 path where the model artifacts, which result from model
  /// training, are stored. This path must point to a single gzip compressed
  /// tar archive ( .tar.gz suffix). The model artifacts must be in an S3
  /// bucket that is in the same region as the model package.
  pub model_data_url: Str? = None
  /// Specifies the location of ML model data to deploy during endpoint
  /// creation.
  pub model_data_source: ModelDataSource? = None
  /// The Amazon Web Services Marketplace product ID of the model package.
  pub product_id: Str? = None
  /// The environment variables to set in the Docker container. Each key and
  /// value in the Environment string to string map can have length of up to
  /// 1024. We support up to 16 entries in the map.
  pub environment: Map[Str, Str]? = None
  /// A structure with Model Input details.
  pub model_input: ModelInput? = None
  /// The machine learning framework of the model package container image.
  pub framework: Str? = None
  /// The framework version of the Model Package Container Image.
  pub framework_version: Str? = None
  /// The name of a pre-trained machine learning benchmarked by Amazon
  /// SageMaker Inference Recommender model that matches your model. You can
  /// find a list of benchmarked models by calling ListModelMetadata .
  pub nearest_model_name: Str? = None
  /// Data sources that are available to your model in addition to the one
  /// that you specify for ModelDataSource when you use the CreateModelPackage
  /// action.
  pub additional_model_data_sources: List[AdditionalModelDataSource]? = None
  /// The additional data source that is used during inference in the Docker
  /// container for your model package.
  pub additional_s3_data_source: AdditionalS3DataSource? = None
  /// The ETag associated with Model Data URL.
  pub model_data_e_tag: Str? = None
  /// Specifies whether the model data is a training checkpoint.
  pub is_checkpoint: Bool? = None
  /// Identifies the foundation model that was used as the starting point for
  /// model customization.
  pub base_model: BaseModel? = None
}

/// A group of versioned models in the Model Registry.
pub struct ModelPackageGroup {
  /// The name of the model group.
  pub model_package_group_name: Str? = None
  /// The Amazon Resource Name (ARN) of the model group.
  pub model_package_group_arn: Str? = None
  /// The description for the model group.
  pub model_package_group_description: Str? = None
  /// The time that the model group was created.
  pub creation_time: Time? = None
  pub created_by: UserContext? = None
  /// The status of the model group. This can be one of the following values.
  /// PENDING - The model group is pending being created. IN_PROGRESS - The
  /// model group is in the process of being created. COMPLETED - The model
  /// group was successfully created. FAILED - The model group failed.
  /// DELETING - The model group is in the process of being deleted.
  /// DELETE_FAILED - SageMaker failed to delete the model group.
  pub model_package_group_status: ModelPackageGroupStatus? = None
  /// A list of the tags associated with the model group. For more
  /// information, see Tagging Amazon Web Services resources in the Amazon Web
  /// Services General Reference Guide .
  pub tags: List[Tag]? = None
}

pub enum ModelPackageGroupSortBy: Str {
  Name = "Name"
  CreationTime = "CreationTime"
  Unknown(value: Str)
}

pub enum ModelPackageGroupStatus: Str {
  Pending = "Pending"
  InProgress = "InProgress"
  Completed = "Completed"
  Failed = "Failed"
  Deleting = "Deleting"
  DeleteFailed = "DeleteFailed"
  Unknown(value: Str)
}

/// Summary information about a model group.
pub struct ModelPackageGroupSummary {
  /// The name of the model group.
  pub model_package_group_name: Str? = None
  /// The Amazon Resource Name (ARN) of the model group.
  pub model_package_group_arn: Str? = None
  /// A description of the model group.
  pub model_package_group_description: Str? = None
  /// The time that the model group was created.
  pub creation_time: Time? = None
  /// The status of the model group.
  pub model_package_group_status: ModelPackageGroupStatus? = None
  /// The managed configuration of the model package group.
  pub managed_configuration: ManagedConfiguration? = None
}

/// The model card associated with the model package. Since
/// ModelPackageModelCard is tied to a model package, it is a specific usage
/// of a model card and its schema is simplified compared to the schema of
/// ModelCard . The ModelPackageModelCard schema does not include
/// model_package_details , and model_overview is composed of the
/// model_creator and model_artifact properties. For more information about
/// the model package model card schema, see Model package model card schema
/// . For more information about the model card associated with the model
/// package, see View the Details of a Model Version .
pub struct ModelPackageModelCard {
  /// The content of the model card. The content must follow the schema
  /// described in Model Package Model Card Schema .
  pub model_card_content: Str? = None
  /// The approval status of the model card within your organization.
  /// Different organizations might have different criteria for model card
  /// review and approval. Draft : The model card is a work in progress.
  /// PendingReview : The model card is pending review. Approved : The model
  /// card is approved. Archived : The model card is archived. No more updates
  /// can be made to the model card content. If you try to update the model
  /// card content, you will receive the message Model Card is in Archived
  /// state .
  pub model_card_status: ModelCardStatus? = None
}

pub enum ModelPackageRegistrationType: Str {
  Logged = "Logged"
  Registered = "Registered"
  Unknown(value: Str)
}

/// An optional Key Management Service key to encrypt, decrypt, and
/// re-encrypt model package information for regulated workloads with highly
/// sensitive data.
pub struct ModelPackageSecurityConfig {
  /// The KMS Key ID ( KMSKeyId ) used for encryption of model package
  /// information.
  pub kms_key_id: Str? = None
}

pub enum ModelPackageSortBy: Str {
  Name = "Name"
  CreationTime = "CreationTime"
  Unknown(value: Str)
}

pub enum ModelPackageStatus: Str {
  Pending = "Pending"
  InProgress = "InProgress"
  Completed = "Completed"
  Failed = "Failed"
  Deleting = "Deleting"
  Unknown(value: Str)
}

/// Specifies the validation and image scan statuses of the model package.
pub struct ModelPackageStatusDetails {
  /// The validation status of the model package.
  pub validation_statuses: List[ModelPackageStatusItem]? = None
  /// The status of the scan of the Docker image container for the model
  /// package.
  pub image_scan_statuses: List[ModelPackageStatusItem]? = None
}

/// Represents the overall status of a model package.
pub struct ModelPackageStatusItem {
  /// The name of the model package for which the overall status is being
  /// reported.
  pub name: Str? = None
  /// The current status.
  pub status: DetailedModelPackageStatus? = None
  /// if the overall status is Failed , the reason for the failure.
  pub failure_reason: Str? = None
}

/// Provides summary information about a model package.
pub struct ModelPackageSummary {
  /// The name of the model package.
  pub model_package_name: Str? = None
  /// If the model package is a versioned model, the model group that the
  /// versioned model belongs to.
  pub model_package_group_name: Str? = None
  /// If the model package is a versioned model, the version of the model.
  pub model_package_version: Int? = None
  /// The Amazon Resource Name (ARN) of the model package.
  pub model_package_arn: Str? = None
  /// A brief description of the model package.
  pub model_package_description: Str? = None
  /// A timestamp that shows when the model package was created.
  pub creation_time: Time? = None
  /// The overall status of the model package.
  pub model_package_status: ModelPackageStatus? = None
  /// The approval status of the model. This can be one of the following
  /// values. APPROVED - The model is approved REJECTED - The model is
  /// rejected. PENDING_MANUAL_APPROVAL - The model is waiting for manual
  /// approval.
  pub model_approval_status: ModelApprovalStatus? = None
  pub model_life_cycle: ModelLifeCycle? = None
  /// The package registration type of the model package summary.
  pub model_package_registration_type: ModelPackageRegistrationType? = None
}

pub enum ModelPackageType: Str {
  Versioned = "Versioned"
  Unversioned = "Unversioned"
  Both = "Both"
  Unknown(value: Str)
}

/// Contains data, such as the inputs and targeted instance types that are
