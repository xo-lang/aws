pub struct UpdateAutomationRuleResponse {
  /// The ARN of the updated rule.
  pub rule_arn: Str? = None
  /// The new revision number of the updated rule.
  pub rule_revision: Int? = None
  /// The updated name of the automation rule.
  pub name: Str? = None
  /// The updated description of the automation rule.
  pub description: Str? = None
  /// The updated type of automation rule.
  pub rule_type: RuleType? = None
  /// The updated organization configuration settings.
  pub organization_configuration: OrganizationConfiguration? = None
  /// The updated priority level of the automation rule.
  pub priority: Str? = None
  /// The updated list of recommended action types.
  pub recommended_action_types: List[RecommendedActionType]? = None
  pub criteria: Criteria? = None
  /// The updated schedule configuration.
  pub schedule: Schedule? = None
  /// The updated status of the automation rule.
  pub status: RuleStatus? = None
  /// The timestamp when the automation rule was originally created.
  pub created_timestamp: Time? = None
  /// The timestamp when the automation rule was last updated.
  pub last_updated_timestamp: Time? = None
}

pub struct UpdateEnrollmentConfigurationRequest {
  /// The desired enrollment status. Active - Enables the Automation feature
  /// for your account. Inactive - Disables the Automation feature for your
  /// account and stops all of your automation rules. If you opt in again
  /// later, all rules will be inactive, and you must enable the rules you
  /// want to run. You must wait at least 24 hours after opting out to opt in
  /// again. The Pending and Failed options can't be used to update the
  /// enrollment status of an account. They are returned in the response of a
  /// request to update the enrollment status of an account. If you are a
  /// member account, you can't disable Automation while an organization
  /// enrollment configuration applies. If no organization enrollment
  /// configuration applies, you also can't disable Automation while your
  /// organization rule mode is AnyAllowed . Ask your administrator to delete
  /// the organization enrollment configuration or disassociate your account,
  /// as applicable.
  pub status: EnrollmentStatus? = None
  /// A unique, case-sensitive identifier that you provide to ensure the
  /// idempotency of the request. Must be 1-64 characters long and contain
  /// only alphanumeric characters, underscores, and hyphens.
  pub client_token: Str? = None
}

pub struct UpdateEnrollmentConfigurationResponse {
  /// The updated enrollment status.
  pub status: EnrollmentStatus? = None
  /// The reason for the updated enrollment status.
  pub status_reason: Str? = None
  /// The timestamp when the enrollment configuration was last updated.
  pub last_updated_timestamp: Time? = None
}
