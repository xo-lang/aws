    xml_write_group_identifier_list(w, x, "groupSet", [])
  }
  if let Some(x) = v.interface_type {
    xmlv.elem(w, "interfaceType", x.value(), [])
  }
  if let Some(x) = v.ipv6_addresses {
    xml_write_network_interface_ipv6_addresses_list(w, x, "ipv6AddressesSet", [])
  }
  if let Some(x) = v.mac_address {
    xmlv.elem(w, "macAddress", x, [])
  }
  if let Some(x) = v.network_interface_id {
    xmlv.elem(w, "networkInterfaceId", x, [])
  }
  if let Some(x) = v.outpost_arn {
    xmlv.elem(w, "outpostArn", x, [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.private_dns_name {
    xmlv.elem(w, "privateDnsName", x, [])
  }
  if let Some(x) = v.public_dns_name {
    xmlv.elem(w, "publicDnsName", x, [])
  }
  if let Some(x) = v.public_ip_dns_name_options {
    xml_write_public_ip_dns_name_options(w, x, "publicIpDnsNameOptions", [])
  }
  if let Some(x) = v.private_ip_address {
    xmlv.elem(w, "privateIpAddress", x, [])
  }
  if let Some(x) = v.private_ip_addresses {
    xml_write_network_interface_private_ip_address_list(w, x, "privateIpAddressesSet", [])
  }
  if let Some(x) = v.ipv4_prefixes {
    xml_write_ipv4_prefixes_list(w, x, "ipv4PrefixSet", [])
  }
  if let Some(x) = v.ipv6_prefixes {
    xml_write_ipv6_prefixes_list(w, x, "ipv6PrefixSet", [])
  }
  if let Some(x) = v.requester_id {
    xmlv.elem(w, "requesterId", x, [])
  }
  if let Some(x) = v.requester_managed {
    xmlv.elem(w, "requesterManaged", "${x}", [])
  }
  if let Some(x) = v.source_dest_check {
    xmlv.elem(w, "sourceDestCheck", "${x}", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.subnet_id {
    xmlv.elem(w, "subnetId", x, [])
  }
  if let Some(x) = v.tag_set {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "vpcId", x, [])
  }
  if let Some(x) = v.deny_all_igw_traffic {
    xmlv.elem(w, "denyAllIgwTraffic", "${x}", [])
  }
  if let Some(x) = v.ipv6_native {
    xmlv.elem(w, "ipv6Native", "${x}", [])
  }
  if let Some(x) = v.ipv6_address {
    xmlv.elem(w, "ipv6Address", x, [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_response(w, x, "operator", [])
  }
  if let Some(x) = v.associated_subnets {
    xml_write_associated_subnet_list(w, x, "associatedSubnetSet", [])
  }
  if let Some(x) = v.availability_zone_id {
    xmlv.elem(w, "availabilityZoneId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_network_interface(e: xml.Element) -> NetworkInterface ! Str {
  var out = NetworkInterface{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "association" => out.association = xml_read_network_interface_association(c)?
      "attachment" => out.attachment = xml_read_network_interface_attachment(c)?
      "availabilityZone" => out.availability_zone = c.text()
      "connectionTrackingConfiguration" => out.connection_tracking_configuration = xml_read_connection_tracking_configuration(c)?
      "description" => out.description = c.text()
      "groupSet" => out.groups = xml_read_group_identifier_list(c)?
      "interfaceType" => out.interface_type = NetworkInterfaceType.from(c.text())
      "ipv6AddressesSet" => out.ipv6_addresses = xml_read_network_interface_ipv6_addresses_list(c)?
      "macAddress" => out.mac_address = c.text()
      "networkInterfaceId" => out.network_interface_id = c.text()
      "outpostArn" => out.outpost_arn = c.text()
      "ownerId" => out.owner_id = c.text()
      "privateDnsName" => out.private_dns_name = c.text()
      "publicDnsName" => out.public_dns_name = c.text()
      "publicIpDnsNameOptions" => out.public_ip_dns_name_options = xml_read_public_ip_dns_name_options(c)?
      "privateIpAddress" => out.private_ip_address = c.text()
      "privateIpAddressesSet" => out.private_ip_addresses = xml_read_network_interface_private_ip_address_list(c)?
      "ipv4PrefixSet" => out.ipv4_prefixes = xml_read_ipv4_prefixes_list(c)?
      "ipv6PrefixSet" => out.ipv6_prefixes = xml_read_ipv6_prefixes_list(c)?
      "requesterId" => out.requester_id = c.text()
      "requesterManaged" => out.requester_managed = xmlv.read_bool(c.text())?
      "sourceDestCheck" => out.source_dest_check = xmlv.read_bool(c.text())?
      "status" => out.status = NetworkInterfaceStatus.from(c.text())
      "subnetId" => out.subnet_id = c.text()
      "tagSet" => out.tag_set = xml_read_tag_list(c)?
      "vpcId" => out.vpc_id = c.text()
      "denyAllIgwTraffic" => out.deny_all_igw_traffic = xmlv.read_bool(c.text())?
      "ipv6Native" => out.ipv6_native = xmlv.read_bool(c.text())?
      "ipv6Address" => out.ipv6_address = c.text()
      "operator" => out.operator = xml_read_operator_response(c)?
      "associatedSubnetSet" => out.associated_subnets = xml_read_associated_subnet_list(c)?
      "availabilityZoneId" => out.availability_zone_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

