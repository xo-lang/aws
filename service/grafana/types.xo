pub struct UpdateInstruction {
  /// Specifies whether this update is to add or revoke role permissions.
  pub action: Str? = None
  /// The role to add or revoke for the user or the group specified in users .
  pub role: Str? = None
  /// A structure that specifies the user or group to add or revoke the role
  /// for.
  pub users: List[User]? = None
}

pub struct UpdatePermissionsRequest {
  /// An array of structures that contain the permission updates to make.
  pub update_instruction_batch: List[UpdateInstruction]? = None
  /// The ID of the workspace to update.
  pub workspace_id: Str? = None
}

pub struct UpdatePermissionsResponse {
  /// An array of structures that contain the errors from the operation, if
  /// any.
  pub errors: List[UpdateError]? = None
}

pub struct UpdateWorkspaceAuthenticationRequest {
  /// The ID of the workspace to update the authentication for.
  pub workspace_id: Str? = None
  /// Specifies whether this workspace uses SAML 2.0, IAM Identity Center, or
  /// both to authenticate users for using the Grafana console within a
  /// workspace. For more information, see User authentication in Amazon
  /// Managed Grafana .
  pub authentication_providers: List[Str]? = None
  /// If the workspace uses SAML, use this structure to map SAML assertion
  /// attributes to workspace user information and define which groups in the
  /// assertion attribute are to have the Admin and Editor roles in the
  /// workspace.
  pub saml_configuration: SamlConfiguration? = None
}

pub struct UpdateWorkspaceAuthenticationResponse {
  /// A structure that describes the user authentication for this workspace
  /// after the update is made.
  pub authentication: AuthenticationDescription? = None
}

pub struct UpdateWorkspaceConfigurationRequest {
  /// The new configuration string for the workspace. For more information
  /// about the format and configuration options available, see Working in
  /// your Grafana workspace .
  pub configuration: Str? = None
  /// The ID of the workspace to update.
  pub workspace_id: Str? = None
  /// Specifies the version of Grafana to support in the workspace. If not
  /// specified, keeps the current version of the workspace. Can only be used
  /// to upgrade (for example, from 8.4 to 9.4), not downgrade (for example,
  /// from 9.4 to 8.4). To know what versions are available to upgrade to for
  /// a specific workspace, see the ListVersions operation.
  pub grafana_version: Str? = None
}

pub struct UpdateWorkspaceConfigurationResponse {
}

pub struct UpdateWorkspaceRequest {
  /// Specifies whether the workspace can access Amazon Web Services resources
  /// in this Amazon Web Services account only, or whether it can also access
  /// Amazon Web Services resources in other accounts in the same
  /// organization. If you specify ORGANIZATION , you must specify which
  /// organizational units the workspace can access in the
  /// workspaceOrganizationalUnits parameter.
  pub account_access_type: Str? = None
  /// The name of an IAM role that already exists to use to access resources
  /// through Organizations. This can only be used with a workspace that has
  /// the permissionType set to CUSTOMER_MANAGED .
  pub organization_role_name: Str? = None
  /// Use this parameter if you want to change a workspace from
  /// SERVICE_MANAGED to CUSTOMER_MANAGED . This allows you to manage the
  /// permissions that the workspace uses to access datasources and
  /// notification channels. If the workspace is in a member Amazon Web
  /// Services account of an organization, and that account is not a delegated
  /// administrator account, and you want the workspace to access data sources
  /// in other Amazon Web Services accounts in the organization, you must
  /// choose CUSTOMER_MANAGED . If you specify this as CUSTOMER_MANAGED , you
  /// must also specify a workspaceRoleArn that the workspace will use for
  /// accessing Amazon Web Services resources. For more information on the
  /// role and permissions needed, see Amazon Managed Grafana permissions and
  /// policies for Amazon Web Services data sources and notification channels
  /// Do not use this to convert a CUSTOMER_MANAGED workspace to
  /// SERVICE_MANAGED . Do not include this parameter if you want to leave the
  /// workspace as SERVICE_MANAGED . You can convert a CUSTOMER_MANAGED
  /// workspace to SERVICE_MANAGED using the Amazon Managed Grafana console.
  /// For more information, see Managing permissions for data sources and
  /// notification channels .
  pub permission_type: Str? = None
  /// The name of the CloudFormation stack set to use to generate IAM roles to
  /// be used for this workspace.
  pub stack_set_name: Str? = None
  /// This parameter is for internal use only, and should not be used.
  pub workspace_data_sources: List[Str]? = None
  /// A description for the workspace. This is used only to help you identify
  /// this workspace.
  pub workspace_description: Str? = None
  /// The ID of the workspace to update.
  pub workspace_id: Str? = None
  /// A new name for the workspace to update.
  pub workspace_name: Str? = None
  /// Specify the Amazon Web Services notification channels that you plan to
  /// use in this workspace. Specifying these data sources here enables Amazon
  /// Managed Grafana to create IAM roles and permissions that allow Amazon
  /// Managed Grafana to use these channels.
  pub workspace_notification_destinations: List[Str]? = None
  /// Specifies the organizational units that this workspace is allowed to use
  /// data sources from, if this workspace is in an account that is part of an
  /// organization.
  pub workspace_organizational_units: List[Str]? = None
  /// Specifies an IAM role that grants permissions to Amazon Web Services
  /// resources that the workspace accesses, such as data sources and
  /// notification channels. If this workspace has permissionType
  /// CUSTOMER_MANAGED , then this role is required.
  pub workspace_role_arn: Str? = None
  /// The configuration settings for an Amazon VPC that contains data sources
  /// for your Grafana workspace to connect to.
  pub vpc_configuration: VpcConfiguration? = None
  /// Whether to remove the VPC configuration from the workspace. Setting this
  /// to true and providing a vpcConfiguration to set will return an error.
  pub remove_vpc_configuration: Bool? = None
  /// The configuration settings for network access to your workspace. When
  /// this is configured, only listed IP addresses and VPC endpoints will be
  /// able to access your workspace. Standard Grafana authentication and
  /// authorization will still be required. If this is not configured, or is
  /// removed, then all IP addresses and VPC endpoints will be allowed.
  /// Standard Grafana authentication and authorization will still be
  /// required.
  pub network_access_control: NetworkAccessConfiguration? = None
  /// Whether to remove the network access configuration from the workspace.
  /// Setting this to true and providing a networkAccessControl to set will
  /// return an error. If you remove this configuration by setting this to
  /// true , then all IP addresses and VPC endpoints will be allowed. Standard
  /// Grafana authentication and authorization will still be required.
  pub remove_network_access_configuration: Bool? = None
  /// Specifies whether the workspace supports IPv4 only, or IPv4 and IPv6.
  /// Valid values are IPv4 and DualStack . For more information about IP
  /// address types, see Network access control .
  pub ip_address_type: Str? = None
}

pub struct UpdateWorkspaceResponse {
  /// A structure containing data about the workspace that was created.
  pub workspace: WorkspaceDescription? = None
}

/// A structure that specifies one user or group in the workspace.
pub struct User {
  /// The ID of the user or group. Pattern:
  /// ^([0-9a-fA-F]{10}-|)[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$
  pub id: Str? = None
  /// Specifies whether this is a single user or a group.
  pub type_value: Str? = None
}

/// The value of a parameter in the request caused an error.
pub struct ValidationException {
  /// A description of the error.
  pub message: Str? = None
  /// The reason that the operation failed.
  pub reason: Str? = None
  /// A list of fields that might be associated with the error.
  pub field_list: List[ValidationExceptionField]? = None
}

/// A structure that contains information about a request parameter that
/// caused an error.
pub struct ValidationExceptionField {
  /// The name of the field that caused the validation error.
  pub name: Str? = None
  /// A message describing why this field couldn't be validated.
  pub message: Str? = None
}

/// The configuration settings for an Amazon VPC that contains data sources
/// for your Grafana workspace to connect to. Provided securityGroupIds and
/// subnetIds must be part of the same VPC. Connecting to a private VPC is
/// not yet available in the Asia Pacific (Seoul) Region (ap-northeast-2).
pub struct VpcConfiguration {
  /// The list of Amazon EC2 security group IDs attached to the Amazon VPC for
  /// your Grafana workspace to connect. Duplicates not allowed.
  pub security_group_ids: List[Str]? = None
  /// The list of Amazon EC2 subnet IDs created in the Amazon VPC for your
  /// Grafana workspace to connect. Duplicates not allowed.
  pub subnet_ids: List[Str]? = None
}

/// A structure containing information about an Amazon Managed Grafana
/// workspace in your account.
pub struct WorkspaceDescription {
  /// Specifies whether the workspace can access Amazon Web Services resources
  /// in this Amazon Web Services account only, or whether it can also access
  /// Amazon Web Services resources in other accounts in the same
  /// organization. If this is ORGANIZATION , the workspaceOrganizationalUnits
  /// parameter specifies which organizational units the workspace can access.
  pub account_access_type: Str? = None
  /// The date that the workspace was created.
  pub created: Time? = None
  /// Specifies the Amazon Web Services data sources that have been configured
  /// to have IAM roles and permissions created to allow Amazon Managed
  /// Grafana to read data from these sources. This list is only used when the
  /// workspace was created through the Amazon Web Services console, and the
  /// permissionType is SERVICE_MANAGED .
  pub data_sources: List[Str]? = None
  /// The user-defined description of the workspace.
  pub description: Str? = None
  /// The URL that users can use to access the Grafana console in the
  /// workspace.
  pub endpoint: Str? = None
  /// The version of Grafana supported in this workspace.
  pub grafana_version: Str? = None
  /// The unique ID of this workspace.
  pub id: Str? = None
  /// The most recent date that the workspace was modified.
  pub modified: Time? = None
  /// The name of the workspace.
  pub name: Str? = None
  /// The name of the IAM role that is used to access resources through
  /// Organizations.
  pub organization_role_name: Str? = None
  /// The Amazon Web Services notification channels that Amazon Managed
  /// Grafana can automatically create IAM roles and permissions for, to allow
  /// Amazon Managed Grafana to use these channels.
  pub notification_destinations: List[Str]? = None
  /// Specifies the organizational units that this workspace is allowed to use
  /// data sources from, if this workspace is in an account that is part of an
  /// organization.
  pub organizational_units: List[Str]? = None
  /// If this is SERVICE_MANAGED , and the workplace was created through the
  /// Amazon Managed Grafana console, then Amazon Managed Grafana
  /// automatically creates the IAM roles and provisions the permissions that
  /// the workspace needs to use Amazon Web Services data sources and
  /// notification channels. If this is CUSTOMER_MANAGED , you must manage
  /// those roles and permissions yourself. If you are working with a
  /// workspace in a member account of an organization and that account is not
  /// a delegated administrator account, and you want the workspace to access
  /// data sources in other Amazon Web Services accounts in the organization,
  /// this parameter must be set to CUSTOMER_MANAGED . For more information
  /// about converting between customer and service managed, see Managing
  /// permissions for data sources and notification channels . For more
  /// information about the roles and permissions that must be managed for
  /// customer managed workspaces, see Amazon Managed Grafana permissions and
  /// policies for Amazon Web Services data sources and notification channels
  pub permission_type: Str? = None
  /// The name of the CloudFormation stack set that is used to generate IAM
  /// roles to be used for this workspace.
  pub stack_set_name: Str? = None
  /// The current status of the workspace.
  pub status: Str? = None
  /// The IAM role that grants permissions to the Amazon Web Services
  /// resources that the workspace will view data from. This role must already
  /// exist.
  pub workspace_role_arn: Str? = None
  /// Specifies whether this workspace has a full Grafana Enterprise license.
  /// Amazon Managed Grafana workspaces no longer support Grafana Enterprise
  /// free trials.
  pub license_type: Str? = None
  /// Specifies whether this workspace has already fully used its free trial
  /// for Grafana Enterprise. Amazon Managed Grafana workspaces no longer
  /// support Grafana Enterprise free trials.
  pub free_trial_consumed: Bool? = None
  /// If this workspace has a full Grafana Enterprise license purchased
  /// through Amazon Web Services Marketplace, this specifies when the license
  /// ends and will need to be renewed. Purchasing the Enterprise plugins
  /// option through Amazon Managed Grafana does not have an expiration. It is
  /// valid until the license is removed.
  pub license_expiration: Time? = None
  /// If this workspace is currently in the free trial period for Grafana
  /// Enterprise, this value specifies when that free trial ends. Amazon
  /// Managed Grafana workspaces no longer support Grafana Enterprise free
  /// trials.
  pub free_trial_expiration: Time? = None
  /// A structure that describes whether the workspace uses SAML, IAM Identity
  /// Center, or both methods for user authentication.
  pub authentication: AuthenticationSummary? = None
  /// The list of tags associated with the workspace.
  pub tags: Map[Str, Str]? = None
  /// The configuration for connecting to data sources in a private VPC
  /// (Amazon Virtual Private Cloud).
  pub vpc_configuration: VpcConfiguration? = None
  /// The configuration settings for network access to your workspace.
  pub network_access_control: NetworkAccessConfiguration? = None
  /// The token that ties this workspace to a Grafana Labs account. For more
  /// information, see Link your account with Grafana Labs .
  pub grafana_token: Str? = None
  /// The type of IP addresses supported for connection to the workspace.
  /// Valid values are IPv4 and DualStack .
  pub ip_address_type: Str? = None
  /// The ID or ARN of the Key Management Service key used for encrypting
  /// workspace data.
  pub kms_key_id: Str? = None
  /// If the workspace is in the DEGRADED status, this field describes the
  /// reason the workspace is degraded.
  pub degraded_workspace_reason: Str? = None
}

/// A structure that contains some information about one workspace in the
/// account.
pub struct WorkspaceSummary {
  /// The date that the workspace was created.
  pub created: Time? = None
  /// The customer-entered description of the workspace.
  pub description: Str? = None
  /// The URL endpoint to use to access the Grafana console in the workspace.
  pub endpoint: Str? = None
  /// The Grafana version that the workspace is running.
  pub grafana_version: Str? = None
  /// The unique ID of the workspace.
  pub id: Str? = None
  /// The most recent date that the workspace was modified.
  pub modified: Time? = None
  /// The name of the workspace.
  pub name: Str? = None
  /// The Amazon Web Services notification channels that Amazon Managed
  /// Grafana can automatically create IAM roles and permissions for, which
  /// allows Amazon Managed Grafana to use these channels.
  pub notification_destinations: List[Str]? = None
  /// The current status of the workspace.
  pub status: Str? = None
  /// A structure containing information about the authentication methods used
  /// in the workspace.
  pub authentication: AuthenticationSummary? = None
  /// The list of tags associated with the workspace.
  pub tags: Map[Str, Str]? = None
  /// Specifies whether this workspace has a full Grafana Enterprise license.
  /// Amazon Managed Grafana workspaces no longer support Grafana Enterprise
  /// free trials.
  pub license_type: Str? = None
  /// The token that ties this workspace to a Grafana Labs account. For more
  /// information, see Link your account with Grafana Labs .
  pub grafana_token: Str? = None
}
