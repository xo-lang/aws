  /// Amazon EFS quotas that you can increase in the Amazon EFS User Guide .
  pub provisioned_throughput_in_mibps: Float? = None
}

/// Returned if the Backup service is not available in the Amazon Web
/// Services Region in which the request was made.
pub struct ValidationException {
  pub error_code: Str? = None
  pub message: Str? = None
}
