  var req = serialize_test_failover(ep, input, "") ?? e => return Err(TestFailoverErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(TestFailoverErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_test_failover_error(resp))
  }
  deserialize_test_failover(resp) ?? e => Err(TestFailoverErr.Deserialize(e))
}

