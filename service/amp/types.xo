/// network access and placement for the collector.
pub struct VpcConfiguration {
  /// The security group IDs that control network access for the Prometheus
  /// collector. These security groups must allow the collector to communicate
  /// with your Amazon MSK cluster on the required ports.
  pub security_group_ids: List[Str]? = None
  /// The subnet IDs where the Prometheus collector will be deployed. The
  /// subnets must be in the same Amazon VPC as your Amazon MSK cluster and
  /// have network connectivity to the cluster.
  pub subnet_ids: List[Str]? = None
}

/// This structure contains the description of the workspace configuration.
pub struct WorkspaceConfigurationDescription {
  /// This structure displays the current status of the workspace
  /// configuration, and might also contain a reason for that status.
  pub status: WorkspaceConfigurationStatus? = None
  /// This is an array of structures, where each structure displays one label
  /// sets for the workspace and the limits for that label set.
  pub limits_per_label_set: List[LimitsPerLabelSet]? = None
  /// This field displays how many days that metrics are retained in the
  /// workspace.
  pub retention_period_in_days: Int? = None
  /// This field displays the out of order time window in seconds for
  /// accepting out of order samples.
  pub out_of_order_time_window_in_seconds: Int? = None
  /// This field displays the duration in seconds that rule evaluation queries
  /// are offset into the past.
  pub rule_query_offset_in_seconds: Int? = None
}

/// This structure displays the current status of the workspace
/// configuration, and might also contain a reason for that status.
pub struct WorkspaceConfigurationStatus {
  /// The current status of the workspace configuration.
  pub status_code: Str? = None
  /// The reason for the current status, if a reason is available.
  pub status_reason: Str? = None
}

/// The full details about one Amazon Managed Service for Prometheus
/// workspace in your account.
pub struct WorkspaceDescription {
  /// The unique ID for the workspace. For example,
  /// ws-example1-1234-abcd-5678-ef90abcd1234 .
  pub workspace_id: Str? = None
  /// The alias that is assigned to this workspace to help identify it. It
  /// does not need to be unique.
  pub alias: Str? = None
  /// The ARN of the workspace. For example,
  /// arn:aws:aps:&lt;region&gt;:123456789012:workspace/ws-example1-1234-abcd-5678-ef90abcd1234
  /// .
  pub arn: Str? = None
  /// The current status of the workspace.
  pub status: WorkspaceStatus? = None
  /// The Prometheus endpoint available for this workspace. For example,
  /// https://aps-workspaces.&lt;region&gt;.amazonaws.com/workspaces/ws-example1-1234-abcd-5678-ef90abcd1234/api/v1/
  /// .
  pub prometheus_endpoint: Str? = None
  /// The date and time that the workspace was created.
  pub created_at: Time? = None
  /// The list of tag keys and values that are associated with the workspace.
  pub tags: Map[Str, Str]? = None
  /// (optional) If the workspace was created with a customer managed KMS key,
  /// the ARN for the key used.
  pub kms_key_arn: Str? = None
}

/// The status of the workspace.
pub struct WorkspaceStatus {
  /// The current status of the workspace.
  pub status_code: Str? = None
}

/// The information about one Amazon Managed Service for Prometheus
/// workspace in your account.
pub struct WorkspaceSummary {
  /// The unique ID for the workspace.
  pub workspace_id: Str? = None
  /// The alias that is assigned to this workspace to help identify it. It
  /// does not need to be unique.
  pub alias: Str? = None
  /// The ARN of the workspace.
  pub arn: Str? = None
  /// The current status of the workspace.
  pub status: WorkspaceStatus? = None
  /// The date and time that the workspace was created.
  pub created_at: Time? = None
  /// The list of tag keys and values that are associated with the workspace.
  pub tags: Map[Str, Str]? = None
  /// (optional) If the workspace was created with a customer managed KMS key,
  /// the ARN for the key used.
  pub kms_key_arn: Str? = None
}
