fn json_of_predict_q_app_input_options(v: PredictQAppInputOptions) -> json.Value {
  match v {
    Conversation(x) => json.Value.Object([("conversation", json_of_message_list(x))])
    ProblemStatement(x) => json.Value.Object([("problemStatement", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_predict_q_app_input_options(v: json.Value) -> PredictQAppInputOptions ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "conversation" => Ok(PredictQAppInputOptions.Conversation(from_json_message_list(fv)?))
      "problemStatement" => Ok(PredictQAppInputOptions.ProblemStatement(jsonv.read_str(fv)?))
      _ => Ok(PredictQAppInputOptions.Unknown(k))
    }
  }
  Err("PredictQAppInputOptions: no member set")
}

