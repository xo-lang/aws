fn json_of_function_target(v: FunctionTarget) -> json.Value {
  match v {
    Bedrock(x) => json.Value.Object([("bedrock", json_of_bedrock_function_target(x))])
    Passthrough(x) => json.Value.Object([("passthrough", json_of_passthrough_function_target(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_function_target(v: json.Value) -> FunctionTarget ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "bedrock" => Ok(FunctionTarget.Bedrock(from_json_bedrock_function_target(fv)?))
      "passthrough" => Ok(FunctionTarget.Passthrough(from_json_passthrough_function_target(fv)?))
      _ => Ok(FunctionTarget.Unknown(k))
    }
  }
  Err("FunctionTarget: no member set")
}

