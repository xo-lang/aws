  }
  if let Some(x) = v.access_control_configuration {
    fs.push(("AccessControlConfiguration", json_of_access_control_configuration(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("UpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.is_email_notification_opted_for_ingestion_failures {
    fs.push(("IsEmailNotificationOptedForIngestionFailures", json.Value.Bool(x)))
  }
  if let Some(x) = v.first_completed_ingestion_summary {
    fs.push(("FirstCompletedIngestionSummary", json_of_knowledge_base_ingestion_summary(x)))
  }
  if let Some(x) = v.first_incomplete_ingestion_summary {
    fs.push(("FirstIncompleteIngestionSummary", json_of_knowledge_base_ingestion_summary(x)))
  }
  if let Some(x) = v.latest_ingestion_summary {
    fs.push(("LatestIngestionSummary", json_of_knowledge_base_ingestion_summary(x)))
  }
  if let Some(x) = v.knowledge_base_size_bytes {
    fs.push(("KnowledgeBaseSizeBytes", json.Value.Int(x)))
  }
  if let Some(x) = v.document_count {
    fs.push(("DocumentCount", json.Value.Int(x)))
  }
  if let Some(x) = v.primary_owner_arn {
    fs.push(("PrimaryOwnerArn", json.Value.Str(x)))
