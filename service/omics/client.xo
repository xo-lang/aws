}

fn from_json_filter(v: json.Value) -> Filter ! Str {
  var out = Filter{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "resourceArns" => out.resource_arns = from_json_arn_list(fv)?
      "status" => out.status = from_json_status_list(fv)?
      "type" => out.type_value = from_json_type_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_format_options(v: FormatOptions) -> json.Value {
  match v {
    TsvOptions(x) => json.Value.Object([("tsvOptions", json_of_tsv_options(x))])
    VcfOptions(x) => json.Value.Object([("vcfOptions", json_of_vcf_options(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_format_options(v: json.Value) -> FormatOptions ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "tsvOptions" => Ok(FormatOptions.TsvOptions(from_json_tsv_options(fv)?))
      "vcfOptions" => Ok(FormatOptions.VcfOptions(from_json_vcf_options(fv)?))
      _ => Ok(FormatOptions.Unknown(k))
    }
  }
  Err("FormatOptions: no member set")
}

fn json_of_format_to_header(v: Map[Str, Str]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, Str)) -> (Str, json.Value) { (e.0, json.Value.Str(e.1)) }))
}

fn from_json_format_to_header(v: json.Value) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, jsonv.read_str(fv)?)
  }
  Ok(out)
}

