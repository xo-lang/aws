fn xml_write_instance_network_interface(var w: xmlv.Writer, v: InstanceNetworkInterface, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.association {
    xml_write_instance_network_interface_association(w, x, "association", [])
  }
  if let Some(x) = v.attachment {
    xml_write_instance_network_interface_attachment(w, x, "attachment", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "description", x, [])
  }
  if let Some(x) = v.groups {
    xml_write_group_identifier_list(w, x, "groupSet", [])
  }
  if let Some(x) = v.ipv6_addresses {
    xml_write_instance_ipv6_address_list(w, x, "ipv6AddressesSet", [])
  }
  if let Some(x) = v.mac_address {
    xmlv.elem(w, "macAddress", x, [])
  }
  if let Some(x) = v.network_interface_id {
    xmlv.elem(w, "networkInterfaceId", x, [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.private_dns_name {
    xmlv.elem(w, "privateDnsName", x, [])
  }
  if let Some(x) = v.private_ip_address {
    xmlv.elem(w, "privateIpAddress", x, [])
  }
  if let Some(x) = v.private_ip_addresses {
    xml_write_instance_private_ip_address_list(w, x, "privateIpAddressesSet", [])
  }
  if let Some(x) = v.source_dest_check {
    xmlv.elem(w, "sourceDestCheck", "${x}", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.subnet_id {
    xmlv.elem(w, "subnetId", x, [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "vpcId", x, [])
  }
  if let Some(x) = v.interface_type {
    xmlv.elem(w, "interfaceType", x, [])
  }
  if let Some(x) = v.ipv4_prefixes {
    xml_write_instance_ipv4_prefix_list(w, x, "ipv4PrefixSet", [])
  }
  if let Some(x) = v.ipv6_prefixes {
    xml_write_instance_ipv6_prefix_list(w, x, "ipv6PrefixSet", [])
  }
  if let Some(x) = v.connection_tracking_configuration {
    xml_write_connection_tracking_specification_response(w, x, "connectionTrackingConfiguration", [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_response(w, x, "operator", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_network_interface(e: xml.Element) -> InstanceNetworkInterface ! Str {
  var out = InstanceNetworkInterface{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "association" => out.association = xml_read_instance_network_interface_association(c)?
      "attachment" => out.attachment = xml_read_instance_network_interface_attachment(c)?
      "description" => out.description = c.text()
      "groupSet" => out.groups = xml_read_group_identifier_list(c)?
      "ipv6AddressesSet" => out.ipv6_addresses = xml_read_instance_ipv6_address_list(c)?
      "macAddress" => out.mac_address = c.text()
      "networkInterfaceId" => out.network_interface_id = c.text()
      "ownerId" => out.owner_id = c.text()
      "privateDnsName" => out.private_dns_name = c.text()
      "privateIpAddress" => out.private_ip_address = c.text()
      "privateIpAddressesSet" => out.private_ip_addresses = xml_read_instance_private_ip_address_list(c)?
      "sourceDestCheck" => out.source_dest_check = xmlv.read_bool(c.text())?
      "status" => out.status = NetworkInterfaceStatus.from(c.text())
      "subnetId" => out.subnet_id = c.text()
      "vpcId" => out.vpc_id = c.text()
      "interfaceType" => out.interface_type = c.text()
      "ipv4PrefixSet" => out.ipv4_prefixes = xml_read_instance_ipv4_prefix_list(c)?
      "ipv6PrefixSet" => out.ipv6_prefixes = xml_read_instance_ipv6_prefix_list(c)?
      "connectionTrackingConfiguration" => out.connection_tracking_configuration = xml_read_connection_tracking_specification_response(c)?
      "operator" => out.operator = xml_read_operator_response(c)?
      _ => {}
    }
  }
  Ok(out)
}

