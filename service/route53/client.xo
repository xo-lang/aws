fn xml_write_resource_record_set(var w: xmlv.Writer, v: ResourceRecordSet, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "Type", x.value(), [])
  }
  if let Some(x) = v.set_identifier {
    xmlv.elem(w, "SetIdentifier", x, [])
  }
  if let Some(x) = v.weight {
    xmlv.elem(w, "Weight", "${x}", [])
  }
  if let Some(x) = v.region {
    xmlv.elem(w, "Region", x.value(), [])
  }
  if let Some(x) = v.geo_location {
    xml_write_geo_location(w, x, "GeoLocation", [])
  }
  if let Some(x) = v.failover {
    xmlv.elem(w, "Failover", x.value(), [])
  }
  if let Some(x) = v.multi_value_answer {
    xmlv.elem(w, "MultiValueAnswer", "${x}", [])
  }
  if let Some(x) = v.ttl {
    xmlv.elem(w, "TTL", "${x}", [])
  }
  if let Some(x) = v.resource_records {
    xml_write_resource_records(w, x, "ResourceRecords", [])
  }
  if let Some(x) = v.alias_target {
    xml_write_alias_target(w, x, "AliasTarget", [])
  }
  if let Some(x) = v.health_check_id {
    xmlv.elem(w, "HealthCheckId", x, [])
  }
  if let Some(x) = v.traffic_policy_instance_id {
    xmlv.elem(w, "TrafficPolicyInstanceId", x, [])
  }
  if let Some(x) = v.cidr_routing_config {
    xml_write_cidr_routing_config(w, x, "CidrRoutingConfig", [])
  }
  if let Some(x) = v.geo_proximity_location {
    xml_write_geo_proximity_location(w, x, "GeoProximityLocation", [])
  }
  xmlv.end(w, name)
}

fn xml_read_resource_record_set(e: xml.Element) -> ResourceRecordSet ! Str {
  var out = ResourceRecordSet{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Name" => out.name = c.text()
      "Type" => out.type_value = RRType.from(c.text())
      "SetIdentifier" => out.set_identifier = c.text()
      "Weight" => out.weight = xmlv.read_int(c.text())?
      "Region" => out.region = ResourceRecordSetRegion.from(c.text())
      "GeoLocation" => out.geo_location = xml_read_geo_location(c)?
      "Failover" => out.failover = ResourceRecordSetFailover.from(c.text())
      "MultiValueAnswer" => out.multi_value_answer = xmlv.read_bool(c.text())?
      "TTL" => out.ttl = xmlv.read_int(c.text())?
      "ResourceRecords" => out.resource_records = xml_read_resource_records(c)?
      "AliasTarget" => out.alias_target = xml_read_alias_target(c)?
      "HealthCheckId" => out.health_check_id = c.text()
      "TrafficPolicyInstanceId" => out.traffic_policy_instance_id = c.text()
      "CidrRoutingConfig" => out.cidr_routing_config = xml_read_cidr_routing_config(c)?
      "GeoProximityLocation" => out.geo_proximity_location = xml_read_geo_proximity_location(c)?
      _ => {}
    }
  }
  Ok(out)
}

