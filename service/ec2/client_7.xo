fn xml_write_transit_gateway_options(var w: xmlv.Writer, v: TransitGatewayOptions, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.amazon_side_asn {
    xmlv.elem(w, "amazonSideAsn", "${x}", [])
  }
  if let Some(x) = v.transit_gateway_cidr_blocks {
    xml_write_value_string_list(w, x, "transitGatewayCidrBlocks", [])
  }
  if let Some(x) = v.auto_accept_shared_attachments {
    xmlv.elem(w, "autoAcceptSharedAttachments", x.value(), [])
  }
  if let Some(x) = v.default_route_table_association {
    xmlv.elem(w, "defaultRouteTableAssociation", x.value(), [])
  }
  if let Some(x) = v.association_default_route_table_id {
    xmlv.elem(w, "associationDefaultRouteTableId", x, [])
  }
  if let Some(x) = v.default_route_table_propagation {
    xmlv.elem(w, "defaultRouteTablePropagation", x.value(), [])
  }
  if let Some(x) = v.propagation_default_route_table_id {
