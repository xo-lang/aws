fn json_of_credentials(v: Credentials) -> json.Value {
  match v {
    Token(x) => json.Value.Object([("token", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_credentials(v: json.Value) -> Credentials ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "token" => Ok(Credentials.Token(jsonv.read_str(fv)?))
      _ => Ok(Credentials.Unknown(k))
    }
  }
  Err("Credentials: no member set")
}

