fn xml_write_vpc_endpoint(var w: xmlv.Writer, v: VpcEndpoint, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.vpc_endpoint_id {
    xmlv.elem(w, "vpcEndpointId", x, [])
  }
  if let Some(x) = v.vpc_endpoint_type {
    xmlv.elem(w, "vpcEndpointType", x.value(), [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "vpcId", x, [])
  }
  if let Some(x) = v.service_name {
    xmlv.elem(w, "serviceName", x, [])
  }
