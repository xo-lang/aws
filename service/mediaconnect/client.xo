fn json_of_reservation(v: Reservation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.currency_code {
    fs.push(("currencyCode", json.Value.Str(x)))
  }
  if let Some(x) = v.duration {
    fs.push(("duration", json.Value.Int(x)))
  }
  if let Some(x) = v.duration_units {
    fs.push(("durationUnits", json.Value.Str(x.value())))
  }
  if let Some(x) = v.end {
    fs.push(("end", json.Value.Str(x)))
  }
  if let Some(x) = v.offering_arn {
    fs.push(("offeringArn", json.Value.Str(x)))
  }
