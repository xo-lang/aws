  if let Some(x) = v.manufacturer_legal_name {
    fs.push(("ManufacturerLegalName", json.Value.Str(x)))
  }
  if let Some(x) = v.reseller_account_id {
    fs.push(("ResellerAccountID", json.Value.Str(x)))
  }
  if let Some(x) = v.reseller_legal_name {
    fs.push(("ResellerLegalName", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.offer_extended_status {
    fs.push(("OfferExtendedStatus", json.Value.Str(x)))
  }
  if let Some(x) = v.created_date {
    fs.push(("CreatedDate", json.Value.Str(x)))
  }
  if let Some(x) = v.availability_end_date {
