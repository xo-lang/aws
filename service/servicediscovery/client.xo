fn json_of_service(v: Service) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.resource_owner {
    fs.push(("ResourceOwner", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.namespace_id {
    fs.push(("NamespaceId", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.instance_count {
    fs.push(("InstanceCount", json.Value.Int(x)))
  }
  if let Some(x) = v.dns_config {
    fs.push(("DnsConfig", json_of_dns_config(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.health_check_config {
    fs.push(("HealthCheckConfig", json_of_health_check_config(x)))
  }
  if let Some(x) = v.health_check_custom_config {
    fs.push(("HealthCheckCustomConfig", json_of_health_check_custom_config(x)))
  }
  if let Some(x) = v.create_date {
    fs.push(("CreateDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.creator_request_id {
    fs.push(("CreatorRequestId", json.Value.Str(x)))
  }
  if let Some(x) = v.created_by_account {
    fs.push(("CreatedByAccount", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_service(v: json.Value) -> Service ! Str {
  var out = Service{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Id" => out.id = jsonv.read_str(fv)?
      "Arn" => out.arn = jsonv.read_str(fv)?
      "ResourceOwner" => out.resource_owner = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "NamespaceId" => out.namespace_id = jsonv.read_str(fv)?
      "Description" => out.description = jsonv.read_str(fv)?
      "InstanceCount" => out.instance_count = jsonv.read_int(fv)?
      "DnsConfig" => out.dns_config = from_json_dns_config(fv)?
      "Type" => out.type_value = ServiceType.from(jsonv.read_str(fv)?)
      "HealthCheckConfig" => out.health_check_config = from_json_health_check_config(fv)?
      "HealthCheckCustomConfig" => out.health_check_custom_config = from_json_health_check_custom_config(fv)?
      "CreateDate" => out.create_date = jsonv.read_time(fv, "epoch-seconds")?
      "CreatorRequestId" => out.creator_request_id = jsonv.read_str(fv)?
      "CreatedByAccount" => out.created_by_account = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

