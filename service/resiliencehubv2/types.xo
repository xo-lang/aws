/// A single AWS resource that AWS Fault Injection Service (AWS FIS)
/// resolved as a target during a test run.
pub struct ResolvedTargetResource {
  /// The AWS FIS resource type the target belongs to, such as
  /// aws:ec2:instance, aws:ecs:task, or aws:eks:pod.
  pub resource_type: Str? = None
  /// The name of the target in the AWS FIS experiment template.
  pub target_name: Str? = None
  /// The raw target information map as returned by AWS FIS.
  pub target_information: Map[Str, Str]? = None
}

/// Represents an AWS resource discovered by Resilience Hub.
pub struct Resource {
  /// The identifier of the resource.
  pub identifier: Str? = None
  /// The AWS Region where the resource is located.
  pub aws_region: Str? = None
  /// The AWS account ID that owns the resource.
  pub aws_account_id: Str? = None
  /// The type of the resource.
  pub resource_type: Str? = None
  /// The Availability Zone ID of the Availability Zone that hosts the
  /// resource, such as use1-az1. The Availability Zone ID is consistent
  /// across Amazon Web Services (AWS) accounts, unlike the Availability Zone
  /// name.
  pub availability_zone_id: Str? = None
  /// The name of the Availability Zone that hosts the resource, such as
  /// us-west-2a.
  pub availability_zone_name: Str? = None
  /// The identifier of the single parent resource that contains this
  /// resource, used to represent containment relationships in the resource
  /// topology. A resource has at most one containment parent.
  pub containment_parent_id: Str? = None
  /// The identifier of the logical resource group that this resource belongs
  /// to. Resources that share this identifier are managed as a single unit.
  pub logical_resource_group_id: Str? = None
}

/// Resource configuration for an input source. Provide exactly one field.
pub enum ResourceConfiguration {
