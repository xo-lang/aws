fn json_of_management_preference(v: ManagementPreference) -> json.Value {
  match v {
    AwsManagedResources(x) => json.Value.Object([("awsManagedResources", json_of_aws_managed_resources(x))])
    SelfManageResources(x) => json.Value.Object([("selfManageResources", json_of_self_manage_resources(x))])
    NoPreference(x) => json.Value.Object([("noPreference", json_of_no_management_preference(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_management_preference(v: json.Value) -> ManagementPreference ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "awsManagedResources" => Ok(ManagementPreference.AwsManagedResources(from_json_aws_managed_resources(fv)?))
      "selfManageResources" => Ok(ManagementPreference.SelfManageResources(from_json_self_manage_resources(fv)?))
      "noPreference" => Ok(ManagementPreference.NoPreference(from_json_no_management_preference(fv)?))
      _ => Ok(ManagementPreference.Unknown(k))
    }
  }
  Err("ManagementPreference: no member set")
}

