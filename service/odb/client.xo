fn json_of_conflict_exception(v: ConflictException) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.message {
    fs.push(("message", json.Value.Str(x)))
  }
  if let Some(x) = v.resource_id {
    fs.push(("resourceId", json.Value.Str(x)))
  }
  if let Some(x) = v.resource_type {
    fs.push(("resourceType", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_conflict_exception(v: json.Value) -> ConflictException ! Str {
  var out = ConflictException{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "message" => out.message = jsonv.read_str(fv)?
      "resourceId" => out.resource_id = jsonv.read_str(fv)?
      "resourceType" => out.resource_type = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

