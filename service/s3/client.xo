fn xml_write_inventory_configuration(var w: xmlv.Writer, v: InventoryConfiguration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.destination {
    xml_write_inventory_destination(w, x, "Destination", [])
  }
  if let Some(x) = v.is_enabled {
    xmlv.elem(w, "IsEnabled", "${x}", [])
  }
  if let Some(x) = v.filter {
    xml_write_inventory_filter(w, x, "Filter", [])
  }
  if let Some(x) = v.id {
    xmlv.elem(w, "Id", x, [])
  }
  if let Some(x) = v.included_object_versions {
    xmlv.elem(w, "IncludedObjectVersions", x.value(), [])
  }
  if let Some(x) = v.optional_fields {
    xml_write_inventory_optional_fields(w, x, "OptionalFields", [])
  }
  if let Some(x) = v.schedule {
    xml_write_inventory_schedule(w, x, "Schedule", [])
  }
  xmlv.end(w, name)
}

fn xml_read_inventory_configuration(e: xml.Element) -> InventoryConfiguration ! Str {
  var out = InventoryConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Destination" => out.destination = xml_read_inventory_destination(c)?
      "IsEnabled" => out.is_enabled = xmlv.read_bool(c.text())?
      "Filter" => out.filter = xml_read_inventory_filter(c)?
      "Id" => out.id = c.text()
      "IncludedObjectVersions" => out.included_object_versions = InventoryIncludedObjectVersions.from(c.text())
      "OptionalFields" => out.optional_fields = xml_read_inventory_optional_fields(c)?
      "Schedule" => out.schedule = xml_read_inventory_schedule(c)?
      _ => {}
    }
  }
  Ok(out)
}

