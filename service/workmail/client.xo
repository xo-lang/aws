      continue
    }
    match k {
      "Id" => out.id = jsonv.read_str(fv)?
      "Email" => out.email = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "Type" => out.type_value = ResourceType.from(jsonv.read_str(fv)?)
      "State" => out.state = EntityState.from(jsonv.read_str(fv)?)
      "EnabledDate" => out.enabled_date = jsonv.read_time(fv, "epoch-seconds")?
      "DisabledDate" => out.disabled_date = jsonv.read_time(fv, "epoch-seconds")?
      "Description" => out.description = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

