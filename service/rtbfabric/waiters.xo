    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls GetRequesterGateway until the RequesterGatewayActive acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (120s).
pub fn wait_until_requester_gateway_active(c: Client, input: GetRequesterGatewayRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetRequesterGatewayErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_requester_gateway(input) {
      Ok(out) => {
        let o = jmes_of_get_requester_gateway_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "ACTIVE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "DELETED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "ERROR") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("RequesterGatewayActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

