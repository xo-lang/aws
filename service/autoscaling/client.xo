  var out = UpdateAutoScalingGroupType{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "AutoScalingGroupName" => out.auto_scaling_group_name = c.text()
      "LaunchConfigurationName" => out.launch_configuration_name = c.text()
      "LaunchTemplate" => out.launch_template = xml_read_launch_template_specification(c)?
