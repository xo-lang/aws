fn xml_write_list_buckets_request(var w: xmlv.Writer, v: ListBucketsRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.max_buckets {
    xmlv.elem(w, "MaxBuckets", "${x}", [])
  }
  if let Some(x) = v.continuation_token {
    xmlv.elem(w, "ContinuationToken", x, [])
  }
  if let Some(x) = v.prefix {
    xmlv.elem(w, "Prefix", x, [])
