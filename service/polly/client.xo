/// Synthesizes UTF-8 input, plain text, or SSML over a bidirectional
/// streaming connection. Specify synthesis parameters in HTTP/2 headers,
/// send text incrementally as events on the input stream, and receive
/// synthesized audio as it becomes available. This operation serves as a
/// bidirectional counterpart to SynthesizeSpeech : SynthesizeSpeech
pub fn (c: Client) start_speech_synthesis_stream(input: StartSpeechSynthesisStreamInput, first: List[StartSpeechSynthesisStreamActionStream] = []) -> StartSpeechSynthesisStreamStream ! StartSpeechSynthesisStreamErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_start_speech_synthesis_stream(c.params, input)) ?? e => return Err(StartSpeechSynthesisStreamErr.InvalidInput(e))
  var req = serialize_start_speech_synthesis_stream(ep, input, "") ?? e => return Err(StartSpeechSynthesisStreamErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  req.headers = req.headers.filter(fn(h: (Str, Str)) -> Bool { h.0.to_lower() != "content-type" })
  req.headers.push(("Content-Type", "application/vnd.amazon.eventstream"))
  req.body = b""
  let (w, r) = http.pipe()
  // the signer is seeded by the request's signature, known only once
  // it is signed: open_stream signs, then the first events follow
  let started = transport.open_stream(c.transport, req, signing, r, first.map(fn(e: StartSpeechSynthesisStreamActionStream) -> Bytes { eventstream.encode(event_message_start_speech_synthesis_stream_action_stream(e)) }), w) ?? e => return Err(StartSpeechSynthesisStreamErr.Send(e))
  match started.opened {
    Done(resp) => {
      w.close()
      Err(deserialize_start_speech_synthesis_stream_error(resp))
    }
    Stream(head, body) => {
      match deserialize_start_speech_synthesis_stream(http.Response{status: head.status, headers: head.headers, body: b""}) {
        Ok(o) => Ok(StartSpeechSynthesisStreamStream{output: o, writer: w, signer: started.signer, clock: c.transport.clock, body: body})
        Err(msg) => {
          body.close()
          w.close()
          Err(StartSpeechSynthesisStreamErr.Deserialize(msg))
        }
      }
    }
