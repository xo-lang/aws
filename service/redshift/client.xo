  if let Some(x) = v.logging_publish_status {
    xml_write_logging_publish_status(w, x, "LoggingPublishStatus", [])
  }
  xmlv.end(w, name)
}

fn xml_read_cluster(e: xml.Element) -> Cluster ! Str {
  var out = Cluster{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ClusterIdentifier" => out.cluster_identifier = c.text()
      "NodeType" => out.node_type = c.text()
      "ClusterStatus" => out.cluster_status = c.text()
      "ClusterAvailabilityStatus" => out.cluster_availability_status = c.text()
      "ModifyStatus" => out.modify_status = c.text()
      "MasterUsername" => out.master_username = c.text()
      "DBName" => out.db_name = c.text()
      "Endpoint" => out.endpoint = xml_read_endpoint(c)?
      "ClusterCreateTime" => out.cluster_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "AutomatedSnapshotRetentionPeriod" => out.automated_snapshot_retention_period = xmlv.read_int(c.text())?
      "ManualSnapshotRetentionPeriod" => out.manual_snapshot_retention_period = xmlv.read_int(c.text())?
      "ClusterSecurityGroups" => out.cluster_security_groups = xml_read_cluster_security_group_membership_list(c)?
      "VpcSecurityGroups" => out.vpc_security_groups = xml_read_vpc_security_group_membership_list(c)?
      "ClusterParameterGroups" => out.cluster_parameter_groups = xml_read_cluster_parameter_group_status_list(c)?
      "ClusterSubnetGroupName" => out.cluster_subnet_group_name = c.text()
      "VpcId" => out.vpc_id = c.text()
      "AvailabilityZone" => out.availability_zone = c.text()
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "PendingModifiedValues" => out.pending_modified_values = xml_read_pending_modified_values(c)?
      "ClusterVersion" => out.cluster_version = c.text()
      "AllowVersionUpgrade" => out.allow_version_upgrade = xmlv.read_bool(c.text())?
      "NumberOfNodes" => out.number_of_nodes = xmlv.read_int(c.text())?
      "PubliclyAccessible" => out.publicly_accessible = xmlv.read_bool(c.text())?
      "Encrypted" => out.encrypted = xmlv.read_bool(c.text())?
      "RestoreStatus" => out.restore_status = xml_read_restore_status(c)?
      "DataTransferProgress" => out.data_transfer_progress = xml_read_data_transfer_progress(c)?
      "HsmStatus" => out.hsm_status = xml_read_hsm_status(c)?
      "ClusterSnapshotCopyStatus" => out.cluster_snapshot_copy_status = xml_read_cluster_snapshot_copy_status(c)?
      "ClusterPublicKey" => out.cluster_public_key = c.text()
      "ClusterNodes" => out.cluster_nodes = xml_read_cluster_nodes_list(c)?
      "ElasticIpStatus" => out.elastic_ip_status = xml_read_elastic_ip_status(c)?
      "ClusterRevisionNumber" => out.cluster_revision_number = c.text()
      "Tags" => out.tags = xml_read_tag_list(c)?
      "KmsKeyId" => out.kms_key_id = c.text()
      "EnhancedVpcRouting" => out.enhanced_vpc_routing = xmlv.read_bool(c.text())?
      "IamRoles" => out.iam_roles = xml_read_cluster_iam_role_list(c)?
      "PendingActions" => out.pending_actions = xml_read_pending_actions_list(c)?
      "MaintenanceTrackName" => out.maintenance_track_name = c.text()
      "ElasticResizeNumberOfNodeOptions" => out.elastic_resize_number_of_node_options = c.text()
      "DeferredMaintenanceWindows" => out.deferred_maintenance_windows = xml_read_deferred_maintenance_windows_list(c)?
      "SnapshotScheduleIdentifier" => out.snapshot_schedule_identifier = c.text()
      "SnapshotScheduleState" => out.snapshot_schedule_state = ScheduleState.from(c.text())
      "ExpectedNextSnapshotScheduleTime" => out.expected_next_snapshot_schedule_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ExpectedNextSnapshotScheduleTimeStatus" => out.expected_next_snapshot_schedule_time_status = c.text()
      "NextMaintenanceWindowStartTime" => out.next_maintenance_window_start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ResizeInfo" => out.resize_info = xml_read_resize_info(c)?
      "AvailabilityZoneRelocationStatus" => out.availability_zone_relocation_status = c.text()
      "ClusterNamespaceArn" => out.cluster_namespace_arn = c.text()
      "TotalStorageCapacityInMegaBytes" => out.total_storage_capacity_in_mega_bytes = xmlv.read_int(c.text())?
      "AquaConfiguration" => out.aqua_configuration = xml_read_aqua_configuration(c)?
      "DefaultIamRoleArn" => out.default_iam_role_arn = c.text()
      "ReservedNodeExchangeStatus" => out.reserved_node_exchange_status = xml_read_reserved_node_exchange_status(c)?
      "CustomDomainName" => out.custom_domain_name = c.text()
      "CustomDomainCertificateArn" => out.custom_domain_certificate_arn = c.text()
      "CustomDomainCertificateExpiryDate" => out.custom_domain_certificate_expiry_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MasterPasswordSecretArn" => out.master_password_secret_arn = c.text()
      "MasterPasswordSecretKmsKeyId" => out.master_password_secret_kms_key_id = c.text()
      "IpAddressType" => out.ip_address_type = c.text()
      "MultiAZ" => out.multi_az = c.text()
      "MultiAZSecondary" => out.multi_az_secondary = xml_read_secondary_cluster_info(c)?
      "LakehouseRegistrationStatus" => out.lakehouse_registration_status = c.text()
      "CatalogArn" => out.catalog_arn = c.text()
      "ExtraComputeForAutomaticOptimization" => out.extra_compute_for_automatic_optimization = c.text()
      "LoggingPublishStatus" => out.logging_publish_status = xml_read_logging_publish_status(c)?
      _ => {}
    }
  }
  Ok(out)
}

