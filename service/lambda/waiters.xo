      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("FunctionUpdatedV2: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Waits for the function's State to be Active. This waiter uses
/// GetFunctionConfiguration API. This should be used after new function
/// creation.
///
/// Calls GetFunctionConfiguration until the FunctionActive acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (300s).
pub fn wait_until_function_active(c: Client, input: GetFunctionConfigurationRequest, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 300s) -> () ! waiter.WaitErr[GetFunctionConfigurationErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_function_configuration(input) {
      Ok(out) => {
        let o = jmes_of_function_configuration(out)
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "Active") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "Failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "Pending") {
          state = "retry"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("FunctionActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

