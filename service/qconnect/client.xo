fn json_of_custom_attributes(v: Map[Str, Str]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, Str)) -> (Str, json.Value) { (e.0, json.Value.Str(e.1)) }))
}

fn from_json_custom_attributes(v: json.Value) -> Map[Str, Str] ! Str {
  var out: Map[Str, Str] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, jsonv.read_str(fv)?)
  }
  Ok(out)
}

