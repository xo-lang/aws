    fs.push(("protocolConfiguration", jmes_of_agent_core_runtime_protocol_configuration(x)))
  }
  if let Some(x) = v.authorizer_configuration {
    fs.push(("authorizerConfiguration", jmes_of_authorizer_configuration(x)))
  }
  if let Some(x) = v.workload_identity_details {
    fs.push(("workloadIdentityDetails", jmes_of_workload_identity_details(x)))
  }
  json.Value.Object(fs)
}

fn jmes_of_agent_core_runtime_protocol_configuration(v: AgentCoreRuntimeProtocolConfiguration) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.server_protocol {
    fs.push(("serverProtocol", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn jmes_of_workload_identity_details(v: WorkloadIdentityDetails) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.workload_identity_arn {
    fs.push(("workloadIdentityArn", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn jmes_of_agent_core_gateway_source_details(v: AgentCoreGatewaySourceDetails) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.protocol_type {
    fs.push(("protocolType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.authorizer_type {
    fs.push(("authorizerType", json.Value.Str(x)))
  }
  if let Some(x) = v.authorizer_configuration {
    fs.push(("authorizerConfiguration", jmes_of_authorizer_configuration(x)))
  }
  if let Some(x) = v.workload_identity_details {
    fs.push(("workloadIdentityDetails", jmes_of_workload_identity_details(x)))
  }
  json.Value.Object(fs)
}

/// Calls GetRegistry until the RegistryReady acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (120s).
pub fn wait_until_registry_ready(c: Client, input: GetRegistryRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetRegistryErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_registry(input) {
      Ok(out) => {
        let o = jmes_of_get_registry_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "READY") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "CREATE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "UPDATE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "DELETE_FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("RegistryReady: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls GetRegistryRecord until the RegistryRecordApproved acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (120s).
pub fn wait_until_registry_record_approved(c: Client, input: GetRegistryRecordRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetRegistryRecordErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_registry_record(input) {
      Ok(out) => {
        let o = jmes_of_get_registry_record_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "APPROVED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "REJECTED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "CREATE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "UPDATE_FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("RegistryRecordApproved: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
