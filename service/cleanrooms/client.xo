    Aggregation(x) => json.Value.Object([("aggregation", json_of_consolidated_policy_aggregation(x))])
    Custom(x) => json.Value.Object([("custom", json_of_consolidated_policy_custom(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_consolidated_policy_v1(v: json.Value) -> ConsolidatedPolicyV1 ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "list" => Ok(ConsolidatedPolicyV1.List(from_json_consolidated_policy_list(fv)?))
      "aggregation" => Ok(ConsolidatedPolicyV1.Aggregation(from_json_consolidated_policy_aggregation(fv)?))
      "custom" => Ok(ConsolidatedPolicyV1.Custom(from_json_consolidated_policy_custom(fv)?))
      _ => Ok(ConsolidatedPolicyV1.Unknown(k))
    }
  }
  Err("ConsolidatedPolicyV1: no member set")
}

