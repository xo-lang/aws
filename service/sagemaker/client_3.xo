      "CreationTime" => out.creation_time = jsonv.read_time(fv, "epoch-seconds")?
      "LastModifiedTime" => out.last_modified_time = jsonv.read_time(fv, "epoch-seconds")?
      "EndTime" => out.end_time = jsonv.read_time(fv, "epoch-seconds")?
      "JobStatus" => out.job_status = JobStatus.from(jsonv.read_str(fv)?)
      "SecondaryStatus" => out.secondary_status = JobSecondaryStatus.from(jsonv.read_str(fv)?)
      "SecondaryStatusTransitions" => out.secondary_status_transitions = from_json_job_secondary_status_transitions(fv)?
      "FailureReason" => out.failure_reason = jsonv.read_str(fv)?
      "Tags" => out.tags = from_json_tag_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

