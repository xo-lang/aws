  pub yes_no: List[YesNoQuestion]? = None
  /// An array of questions that you ask about each of their options, to
  /// replace all the yesNoPerOption questions in DRAFT. You can specify up to
  /// 10 yesNoPerOption questions. If not specified, the yesNoPerOption
  /// questions are not changed. To remove all the yesNoPerOption questions,
  /// specify an empty array.
  pub yes_no_per_option: List[YesNoPerOptionQuestion]? = None
  /// An array of questions that Elemental Inference answers by choosing one
  /// of their options, to replace all the chooseOne questions in DRAFT. You
  /// can specify up to 10 chooseOne questions. If not specified, the
  /// chooseOne questions are not changed. To remove all the chooseOne
  /// questions, specify an empty array.
  pub choose_one: List[ChooseOneQuestion]? = None
  /// A new name for the question set. If not specified, the name is not
  /// changed.
  pub name: Str? = None
}

pub struct UpdateQuestionSetResponse {
  /// The yesNo questions in this version. Elemental Inference doesn't return
  /// this property if the version has no yesNo questions.
  pub yes_no: List[YesNoQuestion]? = None
  /// The yesNoPerOption questions in this version. Elemental Inference
  /// doesn't return this property if the version has no yesNoPerOption
  /// questions.
  pub yes_no_per_option: List[YesNoPerOptionQuestion]? = None
  /// The chooseOne questions in this version. Elemental Inference doesn't
  /// return this property if the version has no chooseOne questions.
  pub choose_one: List[ChooseOneQuestion]? = None
  /// The ARN of the question set.
  pub arn: Str? = None
  /// The ID of the question set.
  pub id: Str? = None
  /// The updated or original name of the question set.
  pub name: Str? = None
  /// The version that this response describes. For UpdateQuestionSet, the
  /// version is always DRAFT.
  pub version: Str? = None
  /// The description of the version. Elemental Inference doesn't return this
  /// property for UpdateQuestionSet, because the DRAFT version has no
  /// description.
  pub description: Str? = None
  /// The number of the highest version that you have published for this
  /// question set, even if you have since deleted that version. Elemental
  /// Inference doesn't return this property if you haven't published a
  /// version.
  pub latest_version: Str? = None
  /// The SHA-256 hash of the DRAFT version after the update, as 64 lowercase
  /// hexadecimal characters. The hash covers the name of the question set and
  /// its questions, so it changes when you rename the question set. You can
  /// specify this value in a CreateQuestionSetVersion request, so that
  /// Elemental Inference publishes DRAFT only if it hasn't changed since this
  /// update.
  pub sha256: Str? = None
  /// A list of feed IDs that reference the DRAFT version of the question set.
  pub references: List[Str]? = None
  /// Any tags associated with the question set.
  pub tags: Map[Str, Str]? = None
}

/// The input fails to satisfy the constraints specified by the service.
/// Check the error message for details about which parameter or field is
/// invalid and correct the request before retrying.
pub struct ValidationException {
  pub message: Str? = None
}

/// A question that you ask Elemental Inference separately about each of its
/// options. Elemental Inference answers yes or no for each option. Word the
/// question so that it fits any of the options. For example, ask Is this
/// overlay visible? with one option for each overlay. You specify it in the
/// yesNoPerOption array of a question set.
pub struct YesNoPerOptionQuestion {
  /// A name for the question. The name must be unique among all the questions
  /// in the version, across all question types. The name can be up to 64
  /// characters. It must start with a letter or an underscore, and can
  /// contain only the letters A-Z and a-z, the digits 0-9, and underscores.
  pub name: Str? = None
  /// The text of the question. The text can be up to 256 bytes, encoded in
  /// UTF-8. It can contain letters in any language, combining marks, digits,
  /// spaces, and the following characters: . , ? ! ' " ( ) - : ; / &amp; % ,
  /// plus the curly apostrophe and quotation marks (U+2019, U+201C, and
  /// U+201D).
  pub question: Str? = None
  /// The options that you ask the question about. You can specify from 1 to
  /// 50 options. Each option counts as one item toward the limit of 100
  /// scored items in a version.
  pub options: List[QuestionOption]? = None
}

/// A question that you ask Elemental Inference, which answers with yes or
/// no. You specify it in the yesNo array of a question set.
pub struct YesNoQuestion {
  /// A name for the question. The name must be unique among all the questions
  /// in the version, across all question types. The name can be up to 64
  /// characters. It must start with a letter or an underscore, and can
  /// contain only the letters A-Z and a-z, the digits 0-9, and underscores.
  pub name: Str? = None
  /// The text of the question. The text can be up to 256 bytes, encoded in
  /// UTF-8. It can contain letters in any language, combining marks, digits,
  /// spaces, and the following characters: . , ? ! ' " ( ) - : ; / &amp; % ,
  /// plus the curly apostrophe and quotation marks (U+2019, U+201C, and
  /// U+201D).
  pub question: Str? = None
}
