  var req = serialize_associate_accounts(ep, input, rest.uuid(c.rand)) ?? e => return Err(AssociateAccountsErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(AssociateAccountsErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_associate_accounts_error(resp))
  }
  deserialize_associate_accounts(resp) ?? e => Err(AssociateAccountsErr.Deserialize(e))
}

