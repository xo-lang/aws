}

/// A rich-text field's constraints and placeholder. Distinct from text
/// because the value is a markup fragment whose permitted tags are part of
/// the contract: a client needs the tag list to configure its editor, and
/// the service needs it to sanitize.
pub struct RichTextFieldType {
