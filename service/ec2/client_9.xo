fn query_put_disk_info(var f: query.Form, prefix: Str, v: DiskInfo) {
  if let Some(x) = v.size_in_gb {
    query.add(f, query.key(prefix, "SizeInGB"), "${x}")
  }
  if let Some(x) = v.count {
    query.add(f, query.key(prefix, "Count"), "${x}")
