  /// stream.graphics.g6f.xlarge stream.graphics.g6f.2xlarge
  /// stream.graphics.g6f.4xlarge stream.graphics.gr6f.4xlarge
  pub instance_type: Str? = None
  /// The operating system platform of the image builder.
