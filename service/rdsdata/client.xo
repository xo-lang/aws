pub fn (e: RollbackTransactionErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    BadRequestException(x) => "BadRequestException: ${x:?}"
    DatabaseErrorException(x) => "DatabaseErrorException: ${x:?}"
    DatabaseNotFoundException(x) => "DatabaseNotFoundException: ${x:?}"
    DatabaseUnavailableException(x) => "DatabaseUnavailableException: ${x:?}"
    ForbiddenException(x) => "ForbiddenException: ${x:?}"
    HttpEndpointNotEnabledException(x) => "HttpEndpointNotEnabledException: ${x:?}"
    InternalServerErrorException(x) => "InternalServerErrorException: ${x:?}"
    InvalidResourceStateException(x) => "InvalidResourceStateException: ${x:?}"
    InvalidSecretException(x) => "InvalidSecretException: ${x:?}"
    NotFoundException(x) => "NotFoundException: ${x:?}"
    SecretsErrorException(x) => "SecretsErrorException: ${x:?}"
    ServiceUnavailableError(x) => "ServiceUnavailableError: ${x:?}"
    StatementTimeoutException(x) => "StatementTimeoutException: ${x:?}"
    TransactionNotFoundException(x) => "TransactionNotFoundException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

