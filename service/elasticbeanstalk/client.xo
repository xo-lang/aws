  }
  if let Some(x) = v.solution_stack_name {
    xmlv.elem(w, "SolutionStackName", x, [])
  }
  if let Some(x) = v.platform_arn {
    xmlv.elem(w, "PlatformArn", x, [])
  }
  if let Some(x) = v.template_name {
    xmlv.elem(w, "TemplateName", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
