fn query_put_alpn_policy_not_supported_exception(var f: query.Form, prefix: Str, v: ALPNPolicyNotSupportedException) {
  if let Some(x) = v.message {
    query.add(f, query.key(prefix, "Message"), x)
  }
}

fn query_put_action(var f: query.Form, prefix: Str, v: Action) {
  if let Some(x) = v.type_value {
    query.add(f, query.key(prefix, "Type"), x.value())
  }
  if let Some(x) = v.target_group_arn {
    query.add(f, query.key(prefix, "TargetGroupArn"), x)
  }
  if let Some(x) = v.authenticate_oidc_config {
    query_put_authenticate_oidc_action_config(f, query.key(prefix, "AuthenticateOidcConfig"), x)
  }
  if let Some(x) = v.authenticate_cognito_config {
