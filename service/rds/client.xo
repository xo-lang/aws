fn xml_write_export_task(var w: xmlv.Writer, v: ExportTask, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.export_task_identifier {
    xmlv.elem(w, "ExportTaskIdentifier", x, [])
  }
  if let Some(x) = v.source_arn {
    xmlv.elem(w, "SourceArn", x, [])
  }
  if let Some(x) = v.export_only {
    xml_write_string_list(w, x, "ExportOnly", [])
  }
  if let Some(x) = v.snapshot_time {
    xmlv.elem(w, "SnapshotTime", rest.date_time(x), [])
  }
  if let Some(x) = v.task_start_time {
    xmlv.elem(w, "TaskStartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.task_end_time {
    xmlv.elem(w, "TaskEndTime", rest.date_time(x), [])
  }
  if let Some(x) = v.s3_bucket {
    xmlv.elem(w, "S3Bucket", x, [])
  }
  if let Some(x) = v.s3_prefix {
    xmlv.elem(w, "S3Prefix", x, [])
  }
  if let Some(x) = v.iam_role_arn {
    xmlv.elem(w, "IamRoleArn", x, [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KmsKeyId", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.percent_progress {
    xmlv.elem(w, "PercentProgress", "${x}", [])
  }
  if let Some(x) = v.total_extracted_data_in_gb {
    xmlv.elem(w, "TotalExtractedDataInGB", "${x}", [])
  }
  if let Some(x) = v.failure_cause {
    xmlv.elem(w, "FailureCause", x, [])
  }
  if let Some(x) = v.warning_message {
    xmlv.elem(w, "WarningMessage", x, [])
  }
  if let Some(x) = v.source_type {
    xmlv.elem(w, "SourceType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_export_task(e: xml.Element) -> ExportTask ! Str {
  var out = ExportTask{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ExportTaskIdentifier" => out.export_task_identifier = c.text()
      "SourceArn" => out.source_arn = c.text()
      "ExportOnly" => out.export_only = xml_read_string_list(c)?
      "SnapshotTime" => out.snapshot_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "TaskStartTime" => out.task_start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "TaskEndTime" => out.task_end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "S3Bucket" => out.s3_bucket = c.text()
      "S3Prefix" => out.s3_prefix = c.text()
      "IamRoleArn" => out.iam_role_arn = c.text()
      "KmsKeyId" => out.kms_key_id = c.text()
      "Status" => out.status = c.text()
      "PercentProgress" => out.percent_progress = xmlv.read_int(c.text())?
      "TotalExtractedDataInGB" => out.total_extracted_data_in_gb = xmlv.read_int(c.text())?
      "FailureCause" => out.failure_cause = c.text()
      "WarningMessage" => out.warning_message = c.text()
      "SourceType" => out.source_type = ExportSourceType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

