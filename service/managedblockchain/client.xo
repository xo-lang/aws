fn json_of_invitation(v: Invitation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.invitation_id {
    fs.push(("InvitationId", json.Value.Str(x)))
  }
  if let Some(x) = v.creation_date {
    fs.push(("CreationDate", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.expiration_date {
    fs.push(("ExpirationDate", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.network_summary {
    fs.push(("NetworkSummary", json_of_network_summary(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_invitation(v: json.Value) -> Invitation ! Str {
  var out = Invitation{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "InvitationId" => out.invitation_id = jsonv.read_str(fv)?
      "CreationDate" => out.creation_date = jsonv.read_time(fv, "date-time")?
      "ExpirationDate" => out.expiration_date = jsonv.read_time(fv, "date-time")?
      "Status" => out.status = InvitationStatus.from(jsonv.read_str(fv)?)
      "NetworkSummary" => out.network_summary = from_json_network_summary(fv)?
      "Arn" => out.arn = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

