fn json_of_day_of_month(v: DayOfMonth) -> json.Value {
  match v {
    DayNumber(x) => json.Value.Object([("dayNumber", json.Value.Int(x))])
    LastDayOfMonth(x) => json.Value.Object([("lastDayOfMonth", json_of_last_day_of_month(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_day_of_month(v: json.Value) -> DayOfMonth ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "dayNumber" => Ok(DayOfMonth.DayNumber(jsonv.read_int(fv)?))
      "lastDayOfMonth" => Ok(DayOfMonth.LastDayOfMonth(from_json_last_day_of_month(fv)?))
      _ => Ok(DayOfMonth.Unknown(k))
    }
  }
  Err("DayOfMonth: no member set")
}

