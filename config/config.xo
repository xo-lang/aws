// load_default_config: an aws.Config from the environment and the shared
// files, with the precedence of the AWS SDKs and Tools Reference Guide
// (decision 0003).

use github.com/xo-lang/aws
use github.com/xo-lang/aws/credentials

/// Settings given in code; each wins over the environment and files.
pub struct Options {
  pub profile: Str? = None
  pub region: Str? = None
  pub credentials: aws.CredentialsProvider? = None
  pub max_attempts: Int? = None
  pub retry_mode: aws.RetryMode? = None
  /// How early cached credentials are refreshed.
  pub refresh_window: Duration = 5m
}

pub enum ConfigErr {
  Load(e: LoadErr)
  /// `AWS_PROFILE` (or Options.profile) names a profile the files lack.
  ProfileNotFound(profile: Str, files: List[Str])
  /// A setting has a value the SDK cannot use.
  Invalid(setting: Str, value: Str, msg: Str)
}

fn (e: ConfigErr) display() -> Str {
  match e {
    Load(le) => le.display()
    ProfileNotFound(p, files) => "profile ${p} not found in ${files.join(", ")}"
    Invalid(setting, value, msg) => "${setting} = ${value}: ${msg}"
  }
}

/// The default configuration: region, the credentials chain (the
/// environment's keys, then the profile's static keys; roles, SSO, web
/// identity, containers and instance metadata are added by later
/// steps), retries, and configured endpoints.
pub fn load_default_config(env: Env, fs: Fs, clock: Clock, opts: Options = Options{}) -> aws.Config ! ConfigErr uses (env, fs.read) {
  let explicit = opts.profile.is_some() || (env.get("AWS_PROFILE") ?? "") != ""
  let profile = opts.profile ?? profile_name(env)
  let sc = match load_shared(env, fs) {
    Ok(v) => v
    Err(e) => return Err(ConfigErr.Load(e))
  }
  if explicit && !sc.profiles.contains(profile) {
    return Err(ConfigErr.ProfileNotFound(profile: profile, files: sc.files))
  }
  let p = sc.profiles.get(profile) ?? Section{}

  let region = opts.region ?? non_empty(env.get("AWS_REGION")) ?? non_empty(env.get("AWS_DEFAULT_REGION")) ?? non_empty(p.props.get("region"))

  let max_attempts = match opts.max_attempts {
    Some(n) => n
    None => match non_empty(env.get("AWS_MAX_ATTEMPTS")) ?? non_empty(p.props.get("max_attempts")) {
      Some(text) => match Int.parse(text) {
        Some(n) => if n >= 1 { n } else { return Err(ConfigErr.Invalid(setting: "max_attempts", value: text, msg: "must be at least 1")) }
        None => return Err(ConfigErr.Invalid(setting: "max_attempts", value: text, msg: "not an integer"))
      }
      None => 3
    }
  }
  let retry_mode = match opts.retry_mode {
    Some(m) => m
    None => match non_empty(env.get("AWS_RETRY_MODE")) ?? non_empty(p.props.get("retry_mode")) {
      Some(text) => match text.to_lower() {
        "standard" => aws.RetryMode.Standard
        "adaptive" => aws.RetryMode.Adaptive
        "legacy" => aws.RetryMode.Legacy
        _ => return Err(ConfigErr.Invalid(setting: "retry_mode", value: text, msg: "want standard, adaptive or legacy"))
      }
      None => aws.RetryMode.Standard
    }
  }

  let creds = opts.credentials ?? default_chain(env, sc, profile, clock, opts.refresh_window)

  Ok(aws.Config{
    region: region,
    credentials: creds,
    retry_mode: retry_mode,
    max_attempts: max_attempts,
    endpoints: configured_endpoints(env, sc, p),
    use_fips: bool_setting(env.get("AWS_USE_FIPS_ENDPOINT") ?? p.props.get("use_fips_endpoint")),
    use_dualstack: bool_setting(env.get("AWS_USE_DUALSTACK_ENDPOINT") ?? p.props.get("use_dualstack_endpoint")),
    app_id: non_empty(env.get("AWS_SDK_UA_APP_ID")) ?? non_empty(p.props.get("sdk_ua_app_id")),
    profile: profile,
  })
}

/// The default credentials chain, cached. (A function, not a match arm:
/// the native backends cannot yet convert a struct to an interface in a
/// match arm, see docs/reports/xo-issues.md.)
fn default_chain(env: Env, sc: SharedConfig, profile: Str, clock: Clock, window: Duration) -> aws.CredentialsProvider uses env {
  credentials.cache(credentials.Chain{providers: [
    credentials.env_provider(env),
    credentials.FixedResult{result: profile_static_credentials(sc, profile)},
  ]}, clock, window)
}

fn configured_endpoints(env: Env, sc: SharedConfig, p: Section) -> aws.ConfiguredEndpoints uses env {
  var env_service: Map[Str, Str] = {}
  for (name, value) in env.vars().entries() {
    if let Some(suffix) = name.cut_prefix("AWS_ENDPOINT_URL_") {
      if value != "" {
        env_service.put(suffix, value)
      }
    }
  }
  var profile_service: Map[Str, Str] = {}
  if let Some(services_name) = p.props.get("services") {
    if let Some(sec) = sc.services.get(services_name) {
      for (service, props) in sec.sub.entries() {
        if let Some(url) = props.get("endpoint_url") {
          profile_service.put(service.to_upper().replace("-", "_"), url)
        }
      }
    }
  }
  aws.ConfiguredEndpoints{
    env_global: non_empty(env.get("AWS_ENDPOINT_URL")),
    env_service: env_service,
    profile_global: non_empty(p.props.get("endpoint_url")),
    profile_service: profile_service,
    ignore: bool_setting(env.get("AWS_IGNORE_CONFIGURED_ENDPOINT_URLS") ?? p.props.get("ignore_configured_endpoint_urls")),
  }
}

fn bool_setting(v: Str?) -> Bool {
  (v ?? "").trim().to_lower() == "true"
}

fn non_empty(s: Str?) -> Str? {
  match s {
    Some(v) => if v == "" { None } else { Some(v) }
    None => None
  }
}
