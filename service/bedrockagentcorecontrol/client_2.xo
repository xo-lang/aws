fn json_of_target_configuration(v: TargetConfiguration) -> json.Value {
  match v {
    Mcp(x) => json.Value.Object([("mcp", json_of_mcp_target_configuration(x))])
    Http(x) => json.Value.Object([("http", json_of_http_target_configuration(x))])
    Inference(x) => json.Value.Object([("inference", json_of_inference_target_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_target_configuration(v: json.Value) -> TargetConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "mcp" => Ok(TargetConfiguration.Mcp(from_json_mcp_target_configuration(fv)?))
      "http" => Ok(TargetConfiguration.Http(from_json_http_target_configuration(fv)?))
      "inference" => Ok(TargetConfiguration.Inference(from_json_inference_target_configuration(fv)?))
      _ => Ok(TargetConfiguration.Unknown(k))
    }
  }
  Err("TargetConfiguration: no member set")
}

