fn json_of_evaluation_summary(v: EvaluationSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.job_arn {
    fs.push(("jobArn", json.Value.Str(x)))
  }
  if let Some(x) = v.job_name {
    fs.push(("jobName", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.creation_time {
    fs.push(("creationTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.job_type {
    fs.push(("jobType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.evaluation_task_types {
    fs.push(("evaluationTaskTypes", json_of_evaluation_task_types(x)))
  }
  if let Some(x) = v.model_identifiers {
    fs.push(("modelIdentifiers", json_of_evaluation_bedrock_model_identifiers(x)))
  }
  if let Some(x) = v.rag_identifiers {
    fs.push(("ragIdentifiers", json_of_evaluation_bedrock_knowledge_base_identifiers(x)))
  }
  if let Some(x) = v.evaluator_model_identifiers {
    fs.push(("evaluatorModelIdentifiers", json_of_evaluator_model_identifiers(x)))
  }
  if let Some(x) = v.custom_metrics_evaluator_model_identifiers {
    fs.push(("customMetricsEvaluatorModelIdentifiers", json_of_evaluator_model_identifiers(x)))
  }
  if let Some(x) = v.inference_config_summary {
    fs.push(("inferenceConfigSummary", json_of_evaluation_inference_config_summary(x)))
  }
  if let Some(x) = v.application_type {
    fs.push(("applicationType", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_evaluation_summary(v: json.Value) -> EvaluationSummary ! Str {
  var out = EvaluationSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "jobArn" => out.job_arn = jsonv.read_str(fv)?
      "jobName" => out.job_name = jsonv.read_str(fv)?
      "status" => out.status = EvaluationJobStatus.from(jsonv.read_str(fv)?)
      "creationTime" => out.creation_time = jsonv.read_time(fv, "date-time")?
      "jobType" => out.job_type = EvaluationJobType.from(jsonv.read_str(fv)?)
      "evaluationTaskTypes" => out.evaluation_task_types = from_json_evaluation_task_types(fv)?
      "modelIdentifiers" => out.model_identifiers = from_json_evaluation_bedrock_model_identifiers(fv)?
      "ragIdentifiers" => out.rag_identifiers = from_json_evaluation_bedrock_knowledge_base_identifiers(fv)?
      "evaluatorModelIdentifiers" => out.evaluator_model_identifiers = from_json_evaluator_model_identifiers(fv)?
      "customMetricsEvaluatorModelIdentifiers" => out.custom_metrics_evaluator_model_identifiers = from_json_evaluator_model_identifiers(fv)?
      "inferenceConfigSummary" => out.inference_config_summary = from_json_evaluation_inference_config_summary(fv)?
      "applicationType" => out.application_type = ApplicationType.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

