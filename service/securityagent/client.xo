fn json_of_member_metadata(v: MemberMetadata) -> json.Value {
  match v {
    User(x) => json.Value.Object([("user", json_of_user_metadata(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_member_metadata(v: json.Value) -> MemberMetadata ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "user" => Ok(MemberMetadata.User(from_json_user_metadata(fv)?))
      _ => Ok(MemberMetadata.Unknown(k))
    }
  }
  Err("MemberMetadata: no member set")
}

