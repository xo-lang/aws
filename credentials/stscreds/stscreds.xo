// The assume role credentials provider (decision 0003), over the
// generated STS client (service/sts), as aws-sdk-go-v2's
// credentials/stscreds is over its service/sts.

use github.com/xo-lang/aws
use github.com/xo-lang/aws/service/sts

/// Credentials from assuming `input.role_arn` with the credentials the
/// STS client signs with. Wrap it in `credentials.cache`.
pub struct AssumeRoleProvider {
  pub client: sts.Client
  pub input: sts.AssumeRoleRequest
}

pub fn (p: AssumeRoleProvider) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  var input = p.input
  if (input.role_session_name ?? "") == "" {
    // aws-sdk-go-v2 names a session after the time when none is set
    input.role_session_name = "xo-lang-aws-${p.client.transport.clock.now().unix_millis()}"
  }
  let role = input.role_arn ?? ""
  let fail = fn(msg: Str) -> aws.CredentialsErr { aws.CredentialsErr.Fetch("assume role ${role}: ${msg}") }
  let out = p.client.assume_role(input) ?? e => return Err(fail(e.display()))
  let c = out.credentials ?? return Err(fail("the response has no Credentials"))
  let id = c.access_key_id ?? ""
  if id == "" {
    return Err(fail("the response has no Credentials.AccessKeyId"))
  }
  let expires = c.expiration ?? return Err(fail("the response has no Credentials.Expiration"))
  Ok(aws.Credentials{
    access_key_id: id,
    secret_access_key: Secret.new(c.secret_access_key ?? ""),
    session_token: Secret.new(c.session_token ?? ""),
    expires: expires,
    source: "AssumeRoleProvider",
    account_id: account_of(out.assumed_role_user.map(fn(u: sts.AssumedRoleUser) -> Str { u.arn ?? "" }) ?? ""),
  })
}

/// The account in an ARN (`arn:aws:sts::<account>:assumed-role/...`).
fn account_of(arn: Str) -> Str? {
  let parts = arn.split(":")
  if parts.len() < 6 || parts[4] == "" {
    return None
  }
  Some(parts[4])
}
