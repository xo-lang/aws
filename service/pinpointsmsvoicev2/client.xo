fn from_json_rcs_suggested_action(v: json.Value) -> RcsSuggestedAction ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Reply" => Ok(RcsSuggestedAction.Reply(from_json_rcs_reply_action(fv)?))
      "OpenUrl" => Ok(RcsSuggestedAction.OpenUrl(from_json_rcs_open_url_action(fv)?))
      "DialPhone" => Ok(RcsSuggestedAction.DialPhone(from_json_rcs_dial_phone_action(fv)?))
