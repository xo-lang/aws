fn jmes_of_get_vocabulary_response(v: GetVocabularyResponse) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.vocabulary_name {
    fs.push(("VocabularyName", json.Value.Str(x)))
  }
  if let Some(x) = v.language_code {
    fs.push(("LanguageCode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.vocabulary_state {
    fs.push(("VocabularyState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.last_modified_time {
    fs.push(("LastModifiedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.failure_reason {
    fs.push(("FailureReason", json.Value.Str(x)))
  }
  if let Some(x) = v.download_uri {
    fs.push(("DownloadUri", json.Value.Str(x)))
  }
  if let Some(x) = v.data_access_role_arn {
    fs.push(("DataAccessRoleArn", json.Value.Str(x)))
  }
  if let Some(x) = v.encryption_configuration {
    fs.push(("EncryptionConfiguration", jmes_of_encryption_configuration(x)))
  }
  json.Value.Object(fs)
}

/// Calls DescribeLanguageModel until the LanguageModelCompleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (120s) to `max_delay` (120s).
pub fn wait_until_language_model_completed(c: Client, input: DescribeLanguageModelRequest, max_wait: Duration, min_delay: Duration = 120s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeLanguageModelErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_language_model(input) {
      Ok(out) => {
        let o = jmes_of_describe_language_model_response(out)
        if state == "" && waiter.path_matches(o, "LanguageModel.ModelStatus", "stringEquals", "COMPLETED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "LanguageModel.ModelStatus", "stringEquals", "FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("LanguageModelCompleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

