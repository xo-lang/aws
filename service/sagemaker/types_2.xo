  /// A list of security group IDs associated with the instance group.
  pub security_group_ids: List[Str]? = None
  /// If you use a custom Amazon Machine Image (AMI) for the instance group,
  /// this field shows the ID of the custom AMI.
  pub ami_override: Str? = None
}

/// Metadata information about scaling operations for an instance group.
