fn json_of_inquiries_list(v: List[InquirySummary]) -> json.Value {
  json.Value.List(v.map(fn(x: InquirySummary) -> json.Value { json_of_inquiry_summary(x) }))
}

fn from_json_inquiries_list(v: json.Value) -> List[InquirySummary] ! Str {
  var out: List[InquirySummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_inquiry_summary(fv)?)
  }
  Ok(out)
}

fn json_of_inquiry_content(v: InquiryContent) -> json.Value {
  match v {
    Query(x) => json.Value.Object([("query", json.Value.Str(x))])
    FileContent(x) => json.Value.Object([("fileContent", json_of_inquiry_file_content(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_inquiry_content(v: json.Value) -> InquiryContent ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "query" => Ok(InquiryContent.Query(jsonv.read_str(fv)?))
      "fileContent" => Ok(InquiryContent.FileContent(from_json_inquiry_file_content(fv)?))
      _ => Ok(InquiryContent.Unknown(k))
    }
  }
  Err("InquiryContent: no member set")
}

