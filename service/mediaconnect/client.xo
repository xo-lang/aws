fn from_json_router_input(v: json.Value) -> RouterInput ! Str {
  var out = RouterInput{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "name" => out.name = jsonv.read_str(fv)?
      "arn" => out.arn = jsonv.read_str(fv)?
      "id" => out.id = jsonv.read_str(fv)?
      "state" => out.state = RouterInputState.from(jsonv.read_str(fv)?)
      "inputType" => out.input_type = RouterInputType.from(jsonv.read_str(fv)?)
      "configuration" => out.configuration = from_json_router_input_configuration(fv)?
      "routedOutputs" => out.routed_outputs = jsonv.read_int(fv)?
      "maximumRoutedOutputs" => out.maximum_routed_outputs = jsonv.read_int(fv)?
      "regionName" => out.region_name = jsonv.read_str(fv)?
      "availabilityZone" => out.availability_zone = jsonv.read_str(fv)?
      "maximumBitrate" => out.maximum_bitrate = jsonv.read_int(fv)?
      "tier" => out.tier = RouterInputTier.from(jsonv.read_str(fv)?)
      "routingScope" => out.routing_scope = RoutingScope.from(jsonv.read_str(fv)?)
      "createdAt" => out.created_at = jsonv.read_time(fv, "date-time")?
      "updatedAt" => out.updated_at = jsonv.read_time(fv, "date-time")?
      "messages" => out.messages = from_json_router_input_messages(fv)?
      "transitEncryption" => out.transit_encryption = from_json_router_input_transit_encryption(fv)?
      "tags" => out.tags = from_json_map_of_string(fv)?
      "streamDetails" => out.stream_details = from_json_router_input_stream_details(fv)?
      "ipAddress" => out.ip_address = jsonv.read_str(fv)?
      "maintenanceType" => out.maintenance_type = MaintenanceType.from(jsonv.read_str(fv)?)
      "maintenanceConfiguration" => out.maintenance_configuration = from_json_maintenance_configuration(fv)?
      "maintenanceScheduleType" => out.maintenance_schedule_type = MaintenanceScheduleType.from(jsonv.read_str(fv)?)
      "maintenanceSchedule" => out.maintenance_schedule = from_json_maintenance_schedule(fv)?
      "contentQualityAnalysisType" => out.content_quality_analysis_type = RouterContentQualityAnalysisType.from(jsonv.read_str(fv)?)
      "contentQualityAnalysisConfiguration" => out.content_quality_analysis_configuration = from_json_router_content_quality_analysis_configuration(fv)?
      "associatedDestinationEndpointArns" => out.associated_destination_endpoint_arns = from_json_destination_endpoint_arn_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_router_input_arn_list(v: List[Str]) -> json.Value {
  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
