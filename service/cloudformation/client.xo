  if let Some(x) = v.template_body {
    xmlv.elem(w, "TemplateBody", x, [])
  }
  if let Some(x) = v.template_url {
    xmlv.elem(w, "TemplateURL", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_validate_template_input(e: xml.Element) -> ValidateTemplateInput ! Str {
  var out = ValidateTemplateInput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TemplateBody" => out.template_body = c.text()
      "TemplateURL" => out.template_url = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_validate_template_output(var w: xmlv.Writer, v: ValidateTemplateOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.parameters {
    xml_write_template_parameters(w, x, "Parameters", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.capabilities {
    xml_write_capabilities(w, x, "Capabilities", [])
  }
  if let Some(x) = v.capabilities_reason {
    xmlv.elem(w, "CapabilitiesReason", x, [])
  }
  if let Some(x) = v.declared_transforms {
    xml_write_transforms_list(w, x, "DeclaredTransforms", [])
  }
  xmlv.end(w, name)
}

fn xml_read_validate_template_output(e: xml.Element) -> ValidateTemplateOutput ! Str {
  var out = ValidateTemplateOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Parameters" => out.parameters = xml_read_template_parameters(c)?
      "Description" => out.description = c.text()
      "Capabilities" => out.capabilities = xml_read_capabilities(c)?
      "CapabilitiesReason" => out.capabilities_reason = c.text()
      "DeclaredTransforms" => out.declared_transforms = xml_read_transforms_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_warning_detail(var w: xmlv.Writer, v: WarningDetail, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.type_value {
    xmlv.elem(w, "Type", x.value(), [])
  }
  if let Some(x) = v.properties {
    xml_write_warning_properties(w, x, "Properties", [])
  }
  xmlv.end(w, name)
}

fn xml_read_warning_detail(e: xml.Element) -> WarningDetail ! Str {
  var out = WarningDetail{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Type" => out.type_value = WarningType.from(c.text())
      "Properties" => out.properties = xml_read_warning_properties(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_warning_details(var w: xmlv.Writer, v: List[WarningDetail], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_warning_detail(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_warning_details(e: xml.Element) -> List[WarningDetail] ! Str {
  var out: List[WarningDetail] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_warning_detail(c)?)
  }
  Ok(out)
}

fn xml_write_warning_properties(var w: xmlv.Writer, v: List[WarningProperty], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_warning_property(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_warning_properties(e: xml.Element) -> List[WarningProperty] ! Str {
  var out: List[WarningProperty] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_warning_property(c)?)
  }
  Ok(out)
}

fn xml_write_warning_property(var w: xmlv.Writer, v: WarningProperty, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.property_path {
    xmlv.elem(w, "PropertyPath", x, [])
  }
  if let Some(x) = v.required {
    xmlv.elem(w, "Required", "${x}", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_warning_property(e: xml.Element) -> WarningProperty ! Str {
  var out = WarningProperty{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "PropertyPath" => out.property_path = c.text()
      "Required" => out.required = xmlv.read_bool(c.text())?
      "Description" => out.description = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_warnings(var w: xmlv.Writer, v: Warnings, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.unrecognized_resource_types {
    xml_write_resource_types(w, x, "UnrecognizedResourceTypes", [])
  }
  xmlv.end(w, name)
}

fn xml_read_warnings(e: xml.Element) -> Warnings ! Str {
  var out = Warnings{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "UnrecognizedResourceTypes" => out.unrecognized_resource_types = xml_read_resource_types(c)?
      _ => {}
    }
  }
  Ok(out)
}

