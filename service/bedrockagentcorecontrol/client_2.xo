fn from_json_match_principal_entry(v: json.Value) -> MatchPrincipalEntry ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "iamPrincipal" => Ok(MatchPrincipalEntry.IamPrincipal(from_json_iam_principal(fv)?))
      _ => Ok(MatchPrincipalEntry.Unknown(k))
    }
  }
  Err("MatchPrincipalEntry: no member set")
}

