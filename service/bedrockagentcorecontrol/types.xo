/// The fallback configuration for a route to an inference target. Defines
/// an ordered list of fallback targets to try when a request to the route's
/// target fails, and the conditions that trigger a fallback. A fallback can
/// occur only before the gateway sends the first byte of the response to
/// the caller. After a streaming response starts, the gateway doesn't fall
/// back.
pub struct Fallback {
  /// The status codes and errors from the route's target that cause the
  /// gateway to send the request to the first fallback target. If you omit
  /// triggerOn , the gateway falls back on 5XX status codes and on the
  /// CONNECTION_ERROR , FIRST_BYTE_TIMEOUT , and UNROUTABLE errors. If you
  /// specify triggerOn , only the status codes and errors that you list
  /// trigger a fallback.
  pub trigger_on: FallbackTriggers? = None
  /// The maximum time, in milliseconds, from sending the request to the
  /// route's target until the first byte of the response body arrives. If the
  /// time expires, the gateway abandons the request and treats it as a
  /// FIRST_BYTE_TIMEOUT error. If you don't specify a value, no timeout is
  /// enforced.
  pub first_byte_timeout_milliseconds: Int? = None
  /// Specifies whether the gateway temporarily stops sending your requests to
  /// a failing target. The circuit breaker tracks each combination of target
  /// and model separately. With the circuit breaker enabled, the gateway
  /// skips one or more targets and models that fail repeatedly, and your
  /// requests go to the next target in the chain. The gateway always tries
  /// the last remaining target in the chain. The gateway enables the circuit
  /// breaker by default.
  pub circuit_breaker: CircuitBreakerConfiguration? = None
  /// The ordered list of fallback targets. The gateway tries each target in
  /// order until a response doesn't match that target's triggers, and returns
  /// that response to the caller. If every target fails, the gateway returns
  /// the last response. You can specify up to two fallback targets. Each
  /// combination of target and model, including the route's target, can
  /// appear only once.
  pub target_fallback: List[FallbackTarget]? = None
}

pub enum FallbackError: Str {
  ConnectionError = "CONNECTION_ERROR"
  FirstByteTimeout = "FIRST_BYTE_TIMEOUT"
  Unroutable = "UNROUTABLE"
  Unknown(value: Str)
}

/// Specifies a target to send the request to when the previous target in
/// the fallback chain fails. Includes the target name, the model to send,
/// and the conditions that trigger a fallback from this target to the next
/// one.
pub struct FallbackTarget {
  /// The name of the gateway target to fall back to. The target must be an
  /// inference target.
  pub target_name: Str? = None
  /// The model ID to send to this fallback target. If you don't specify a
  /// model, the gateway sends the model from the original request.
  pub model: Str? = None
  /// The status codes and errors from this target that cause the gateway to
  /// send the request to the next fallback target. This setting isn't
  /// inherited from the route. If you omit it, the gateway uses the default
  /// triggers: 5XX status codes and the CONNECTION_ERROR , FIRST_BYTE_TIMEOUT
  /// , and UNROUTABLE errors.
  pub trigger_on: FallbackTriggers? = None
  /// The maximum time, in milliseconds, from sending the request to this
  /// target until the first byte of the response body arrives. This setting
  /// isn't inherited from the route. If you don't specify a value, no timeout
  /// is enforced.
  pub first_byte_timeout_milliseconds: Int? = None
}

/// The conditions that trigger a fallback to the next target. A fallback
/// occurs if the response matches any of the specified status codes or
/// errors.
pub struct FallbackTriggers {
  /// The HTTP status codes returned by the target that trigger a fallback.
  /// You can specify the following: An exact status code – A three-digit
  /// code, such as 429 . A class of status codes – The first digit followed
  /// by XX , such as 5XX , which matches every code from 500 to 599. Only 4XX
  /// and 5XX codes are supported. Throttling by the gateway itself doesn't
  /// trigger a fallback.
  pub status_codes: List[Str]? = None
  /// The errors that trigger a fallback. You can specify the following:
  /// CONNECTION_ERROR – The gateway couldn't connect to the target because
  /// the connection was refused, reset, or timed out. The request didn't
  /// reach the target. FIRST_BYTE_TIMEOUT – The target accepted the
  /// connection but didn't return the first byte of the response within
  /// firstByteTimeoutMilliseconds . The gateway abandons the request before
  /// any of the response reaches you. UNROUTABLE – The gateway couldn't
  /// route the request to the target, for example because the target doesn't
  /// exist or doesn't support the request path. These errors don't count
  /// toward the circuit breaker.
  pub errors: List[FallbackError]? = None
}

