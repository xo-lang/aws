/// The period in which a remote Spark runtime environment is running.
pub struct Session {
  /// The ID of the session.
  pub id: Str? = None
  /// The time and date when the session was created.
  pub created_on: Time? = None
  /// The session status.
  pub status: SessionStatus? = None
  /// The error message displayed during the session.
  pub error_message: Str? = None
  /// The description of the session.
  pub description: Str? = None
  /// The name or Amazon Resource Name (ARN) of the IAM role associated with
  /// the Session.
  pub role: Str? = None
  /// The command object.See SessionCommand.
  pub command: SessionCommand? = None
  /// A map array of key-value pairs. Max is 75 pairs.
  pub default_arguments: Map[Str, Str]? = None
  /// The number of connections used for the session.
  pub connections: ConnectionsList? = None
  /// The code execution progress of the session.
  pub progress: Float? = None
  /// The number of Glue data processing units (DPUs) that can be allocated
  /// when the job runs. A DPU is a relative measure of processing power that
  /// consists of 4 vCPUs of compute capacity and 16 GB memory.
  pub max_capacity: Float? = None
  /// The name of the SecurityConfiguration structure to be used with the
  /// session.
  pub security_configuration: Str? = None
  /// The Glue version determines the versions of Apache Spark and Python that
  /// Glue supports. The GlueVersion must be greater than 2.0.
  pub glue_version: Str? = None
  /// The number of workers of a defined WorkerType to use for the session.
  pub number_of_workers: Int? = None
  /// The type of predefined worker that is allocated when a session runs.
  /// Accepts a value of G.1X , G.2X , G.4X , G.8X , G.12X , G.16X , R.1X ,
  /// R.2X , R.4X , or R.8X for Spark sessions. Accepts the value Z.2X for Ray
  /// sessions. The G.12X , G.16X , and R.1X through R.8X worker types are
  /// available only for Glue version 4.0 or later Spark ETL jobs in select
  /// Amazon Web Services Regions. For the supported Regions, see Configuring
  /// job properties for Spark jobs in the developer guide.
  pub worker_type: WorkerType? = None
  /// The date and time that this session is completed.
  pub completed_on: Time? = None
  /// The total time the session ran for.
  pub execution_time: Float? = None
  /// The DPUs consumed by the session (formula: ExecutionTime * MaxCapacity).
  pub dpu_seconds: Float? = None
  /// The number of minutes when idle before the session times out.
  pub idle_timeout: Int? = None
  /// The name of an Glue usage profile associated with the session.
  pub profile_name: Str? = None
  /// The type of the session.
  pub session_type: SessionType? = None
}

