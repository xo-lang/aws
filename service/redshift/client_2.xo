    query.add(f, query.key(prefix, "message"), x)
  }
}

fn query_put_account_attribute(var f: query.Form, prefix: Str, v: AccountAttribute) {
  if let Some(x) = v.attribute_name {
    query.add(f, query.key(prefix, "AttributeName"), x)
  }
  if let Some(x) = v.attribute_values {
    query_put_attribute_value_list(f, query.key(prefix, "AttributeValues"), x, false)
  }
}

fn query_put_account_attribute_list(var f: query.Form, prefix: Str, v: AccountAttributeList) {
  if let Some(x) = v.account_attributes {
    query_put_attribute_list(f, query.key(prefix, "AccountAttributes"), x, false)
  }
}

fn query_put_account_with_restore_access(var f: query.Form, prefix: Str, v: AccountWithRestoreAccess) {
  if let Some(x) = v.account_id {
    query.add(f, query.key(prefix, "AccountId"), x)
  }
  if let Some(x) = v.account_alias {
    query.add(f, query.key(prefix, "AccountAlias"), x)
  }
}

fn query_put_accounts_with_restore_access_list(var f: query.Form, prefix: Str, v: List[AccountWithRestoreAccess], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.AccountWithRestoreAccess.${i + 1}" }
    query_put_account_with_restore_access(f, k, x)
  }
}

fn query_put_aqua_configuration(var f: query.Form, prefix: Str, v: AquaConfiguration) {
  if let Some(x) = v.aqua_status {
    query.add(f, query.key(prefix, "AquaStatus"), x.value())
  }
  if let Some(x) = v.aqua_configuration_status {
    query.add(f, query.key(prefix, "AquaConfigurationStatus"), x.value())
  }
}

fn query_put_associate_data_share_consumer_message(var f: query.Form, prefix: Str, v: AssociateDataShareConsumerMessage) {
  if let Some(x) = v.data_share_arn {
    query.add(f, query.key(prefix, "DataShareArn"), x)
  }
  if let Some(x) = v.associate_entire_account {
    query.add(f, query.key(prefix, "AssociateEntireAccount"), "${x}")
  }
  if let Some(x) = v.consumer_arn {
    query.add(f, query.key(prefix, "ConsumerArn"), x)
  }
  if let Some(x) = v.consumer_region {
    query.add(f, query.key(prefix, "ConsumerRegion"), x)
  }
  if let Some(x) = v.allow_writes {
    query.add(f, query.key(prefix, "AllowWrites"), "${x}")
  }
}

