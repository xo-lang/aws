  var out = Volume{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "CreationTime" => out.creation_time = jsonv.read_time(fv, "epoch-seconds")?
      "FileSystemId" => out.file_system_id = jsonv.read_str(fv)?
      "Lifecycle" => out.lifecycle = VolumeLifecycle.from(jsonv.read_str(fv)?)
      "Name" => out.name = jsonv.read_str(fv)?
