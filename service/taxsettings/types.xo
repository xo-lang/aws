  ExpiredToken = "ExpiredToken"
  InvalidToken = "InvalidToken"
  FieldValidationFailed = "FieldValidationFailed"
  MissingInput = "MissingInput"
  NonIndiaCustomerCanNotSetPan = "NonIndiaCustomerCanNotSetPAN"
  GstExistenceBlockSetPan = "GSTExistenceBlockSetPAN"
  Unknown(value: Str)
}

