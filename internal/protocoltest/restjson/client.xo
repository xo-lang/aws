      "defaultLong" => out.default_long = jsonv.read_int(fv)?
      "defaultFloat" => out.default_float = jsonv.read_float(fv)?
      "defaultDouble" => out.default_double = jsonv.read_float(fv)?
      "defaultMap" => out.default_map = from_json_test_string_map(fv)?
      "defaultEnum" => out.default_enum = TestEnum.from(jsonv.read_str(fv)?)
      "defaultIntEnum" => out.default_int_enum = TestIntEnum.from(jsonv.read_int(fv)?)
      "emptyString" => out.empty_string = jsonv.read_str(fv)?
      "falseBoolean" => out.false_boolean = jsonv.read_bool(fv)?
      "emptyBlob" => out.empty_blob = jsonv.read_blob(fv)?
      "zeroByte" => out.zero_byte = jsonv.read_int(fv)?
      "zeroShort" => out.zero_short = jsonv.read_int(fv)?
