fn json_of_template_error(v: TemplateError) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.message {
    fs.push(("Message", json.Value.Str(x)))
  }
  if let Some(x) = v.violated_entities {
    fs.push(("ViolatedEntities", json_of_entity_list(x)))
  }
  json.Value.Object(fs)
}

fn from_json_template_error(v: json.Value) -> TemplateError ! Str {
  var out = TemplateError{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Type" => out.type_value = TemplateErrorType.from(jsonv.read_str(fv)?)
      "Message" => out.message = jsonv.read_str(fv)?
      "ViolatedEntities" => out.violated_entities = from_json_entity_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

