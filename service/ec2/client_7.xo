    xmlv.elem(w, "policyDocument", x, [])
  }
  if let Some(x) = v.route_table_ids {
    xml_write_value_string_list(w, x, "routeTableIdSet", [])
  }
  if let Some(x) = v.subnet_ids {
    xml_write_value_string_list(w, x, "subnetIdSet", [])
  }
  if let Some(x) = v.groups {
    xml_write_group_identifier_set(w, x, "groupSet", [])
  }
  if let Some(x) = v.ip_address_type {
    xmlv.elem(w, "ipAddressType", x.value(), [])
  }
  if let Some(x) = v.dns_options {
    xml_write_dns_options(w, x, "dnsOptions", [])
  }
  if let Some(x) = v.private_dns_enabled {
    xmlv.elem(w, "privateDnsEnabled", "${x}", [])
  }
  if let Some(x) = v.requester_managed {
    xmlv.elem(w, "requesterManaged", "${x}", [])
  }
  if let Some(x) = v.network_interface_ids {
    xml_write_value_string_list(w, x, "networkInterfaceIdSet", [])
  }
  if let Some(x) = v.dns_entries {
    xml_write_dns_entry_set(w, x, "dnsEntrySet", [])
  }
  if let Some(x) = v.creation_timestamp {
    xmlv.elem(w, "creationTimestamp", rest.date_time(x), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.last_error {
    xml_write_last_error(w, x, "lastError", [])
  }
  if let Some(x) = v.ipv4_prefixes {
    xml_write_subnet_ip_prefixes_list(w, x, "ipv4PrefixSet", [])
  }
  if let Some(x) = v.ipv6_prefixes {
    xml_write_subnet_ip_prefixes_list(w, x, "ipv6PrefixSet", [])
  }
  if let Some(x) = v.failure_reason {
    xmlv.elem(w, "failureReason", x, [])
  }
  if let Some(x) = v.service_network_arn {
    xmlv.elem(w, "serviceNetworkArn", x, [])
  }
  if let Some(x) = v.resource_configuration_arn {
    xmlv.elem(w, "resourceConfigurationArn", x, [])
  }
  if let Some(x) = v.service_region {
    xmlv.elem(w, "serviceRegion", x, [])
  }
  if let Some(x) = v.payer_responsibilities {
    xml_write_payer_responsibility_set(w, x, "payerResponsibilitySet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpc_endpoint(e: xml.Element) -> VpcEndpoint ! Str {
  var out = VpcEndpoint{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "vpcEndpointId" => out.vpc_endpoint_id = c.text()
      "vpcEndpointType" => out.vpc_endpoint_type = VpcEndpointType.from(c.text())
      "vpcId" => out.vpc_id = c.text()
      "serviceName" => out.service_name = c.text()
      "state" => out.state = State.from(c.text())
      "policyDocument" => out.policy_document = c.text()
      "routeTableIdSet" => out.route_table_ids = xml_read_value_string_list(c)?
      "subnetIdSet" => out.subnet_ids = xml_read_value_string_list(c)?
      "groupSet" => out.groups = xml_read_group_identifier_set(c)?
      "ipAddressType" => out.ip_address_type = IpAddressType.from(c.text())
      "dnsOptions" => out.dns_options = xml_read_dns_options(c)?
      "privateDnsEnabled" => out.private_dns_enabled = xmlv.read_bool(c.text())?
      "requesterManaged" => out.requester_managed = xmlv.read_bool(c.text())?
      "networkInterfaceIdSet" => out.network_interface_ids = xml_read_value_string_list(c)?
      "dnsEntrySet" => out.dns_entries = xml_read_dns_entry_set(c)?
      "creationTimestamp" => out.creation_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "ownerId" => out.owner_id = c.text()
      "lastError" => out.last_error = xml_read_last_error(c)?
      "ipv4PrefixSet" => out.ipv4_prefixes = xml_read_subnet_ip_prefixes_list(c)?
      "ipv6PrefixSet" => out.ipv6_prefixes = xml_read_subnet_ip_prefixes_list(c)?
      "failureReason" => out.failure_reason = c.text()
      "serviceNetworkArn" => out.service_network_arn = c.text()
      "resourceConfigurationArn" => out.resource_configuration_arn = c.text()
      "serviceRegion" => out.service_region = c.text()
      "payerResponsibilitySet" => out.payer_responsibilities = xml_read_payer_responsibility_set(c)?
      _ => {}
    }
  }
  Ok(out)
}

