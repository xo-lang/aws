fn json_of_findings_statistics(v: FindingsStatistics) -> json.Value {
  match v {
    ExternalAccessFindingsStatistics(x) => json.Value.Object([("externalAccessFindingsStatistics", json_of_external_access_findings_statistics(x))])
    InternalAccessFindingsStatistics(x) => json.Value.Object([("internalAccessFindingsStatistics", json_of_internal_access_findings_statistics(x))])
    UnusedAccessFindingsStatistics(x) => json.Value.Object([("unusedAccessFindingsStatistics", json_of_unused_access_findings_statistics(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_findings_statistics(v: json.Value) -> FindingsStatistics ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "externalAccessFindingsStatistics" => Ok(FindingsStatistics.ExternalAccessFindingsStatistics(from_json_external_access_findings_statistics(fv)?))
      "internalAccessFindingsStatistics" => Ok(FindingsStatistics.InternalAccessFindingsStatistics(from_json_internal_access_findings_statistics(fv)?))
      "unusedAccessFindingsStatistics" => Ok(FindingsStatistics.UnusedAccessFindingsStatistics(from_json_unused_access_findings_statistics(fv)?))
      _ => Ok(FindingsStatistics.Unknown(k))
    }
  }
  Err("FindingsStatistics: no member set")
}

fn json_of_findings_statistics_list(v: List[FindingsStatistics]) -> json.Value {
  json.Value.List(v.map(fn(x: FindingsStatistics) -> json.Value { json_of_findings_statistics(x) }))
