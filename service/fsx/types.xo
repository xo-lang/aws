  /// (a value between 1 and 12). The value of ThroughputCapacityPerHAPair is
  /// not a valid value.
  pub throughput_capacity_per_ha_pair: Int? = None
  /// Use to update the number of high-availability (HA) pairs for a
  /// second-generation single-AZ file system. If you increase the number of
