  /// performance factor. For more information, see Performance protection in
  /// the Amazon EC2 User Guide .
  pub baseline_performance_factors: BaselinePerformanceFactorsRequest? = None
  /// Specifies whether instance types must support encrypting in-transit
  /// traffic between instances. For more information, including the supported
  /// instance types, see Encryption in transit in the Amazon EC2 User Guide .
  /// Default: false
  pub require_encryption_in_transit: Bool? = None
}

