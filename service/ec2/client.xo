fn xml_write_availability_zone(var w: xmlv.Writer, v: AvailabilityZone, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.opt_in_status {
    xmlv.elem(w, "optInStatus", x.value(), [])
  }
  if let Some(x) = v.messages {
    xml_write_availability_zone_message_list(w, x, "messageSet", [])
  }
  if let Some(x) = v.region_name {
    xmlv.elem(w, "regionName", x, [])
  }
  if let Some(x) = v.zone_name {
    xmlv.elem(w, "zoneName", x, [])
  }
  if let Some(x) = v.zone_id {
    xmlv.elem(w, "zoneId", x, [])
  }
  if let Some(x) = v.group_name {
    xmlv.elem(w, "groupName", x, [])
  }
  if let Some(x) = v.network_border_group {
    xmlv.elem(w, "networkBorderGroup", x, [])
  }
  if let Some(x) = v.zone_type {
    xmlv.elem(w, "zoneType", x, [])
  }
  if let Some(x) = v.parent_zone_name {
    xmlv.elem(w, "parentZoneName", x, [])
  }
  if let Some(x) = v.parent_zone_id {
    xmlv.elem(w, "parentZoneId", x, [])
  }
  if let Some(x) = v.group_long_name {
    xmlv.elem(w, "groupLongName", x, [])
  }
  if let Some(x) = v.geography {
    xml_write_availability_zone_geography_list(w, x, "geographySet", [])
  }
  if let Some(x) = v.sub_geography {
    xml_write_availability_zone_sub_geography_list(w, x, "subGeographySet", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "zoneState", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_availability_zone(e: xml.Element) -> AvailabilityZone ! Str {
  var out = AvailabilityZone{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "optInStatus" => out.opt_in_status = AvailabilityZoneOptInStatus.from(c.text())
      "messageSet" => out.messages = xml_read_availability_zone_message_list(c)?
      "regionName" => out.region_name = c.text()
      "zoneName" => out.zone_name = c.text()
      "zoneId" => out.zone_id = c.text()
      "groupName" => out.group_name = c.text()
      "networkBorderGroup" => out.network_border_group = c.text()
      "zoneType" => out.zone_type = c.text()
      "parentZoneName" => out.parent_zone_name = c.text()
      "parentZoneId" => out.parent_zone_id = c.text()
      "groupLongName" => out.group_long_name = c.text()
      "geographySet" => out.geography = xml_read_availability_zone_geography_list(c)?
      "subGeographySet" => out.sub_geography = xml_read_availability_zone_sub_geography_list(c)?
      "zoneState" => out.state = AvailabilityZoneState.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

