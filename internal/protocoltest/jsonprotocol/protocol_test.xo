test "AwsJson11SupportsNaNFloatInputs" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
  let req = serialize_simple_scalar_properties(ep, SimpleScalarPropertiesInputOutput{float_value: rest.nan(), double_value: rest.nan()}, TOKEN, 0)?
  protocoltest.check_request(req, protocoltest.RequestWant{method: "POST", uri: "/", headers: [("Content-Type", "application/x-amz-json-1.1"), ("X-Amz-Target", "JsonProtocol.SimpleScalarProperties")], body: "{\n    \"floatValue\": \"NaN\",\n    \"doubleValue\": \"NaN\"\n}", body_media_type: "application/json"})?
}

test "AwsJson11SupportsInfinityFloatInputs" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
  let req = serialize_simple_scalar_properties(ep, SimpleScalarPropertiesInputOutput{float_value: rest.inf(), double_value: rest.inf()}, TOKEN, 0)?
