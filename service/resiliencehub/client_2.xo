  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateResiliencyPolicyErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_resiliency_policy_error(resp))
  }
  deserialize_update_resiliency_policy(resp) ?? e => Err(UpdateResiliencyPolicyErr.Deserialize(e))
}
