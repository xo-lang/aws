fn xml_write_pending_modified_values(var w: xmlv.Writer, v: PendingModifiedValues, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.num_cache_nodes {
    xmlv.elem(w, "NumCacheNodes", "${x}", [])
  }
  if let Some(x) = v.cache_node_ids_to_remove {
    xml_write_cache_node_ids_list(w, x, "CacheNodeIdsToRemove", [])
  }
  if let Some(x) = v.engine_version {
    xmlv.elem(w, "EngineVersion", x, [])
  }
  if let Some(x) = v.cache_node_type {
    xmlv.elem(w, "CacheNodeType", x, [])
  }
  if let Some(x) = v.auth_token_status {
    xmlv.elem(w, "AuthTokenStatus", x.value(), [])
  }
  if let Some(x) = v.log_delivery_configurations {
    xml_write_pending_log_delivery_configuration_list(w, x, "LogDeliveryConfigurations", [])
  }
  if let Some(x) = v.transit_encryption_enabled {
    xmlv.elem(w, "TransitEncryptionEnabled", "${x}", [])
  }
  if let Some(x) = v.transit_encryption_mode {
    xmlv.elem(w, "TransitEncryptionMode", x.value(), [])
  }
  if let Some(x) = v.scale_config {
    xml_write_scale_config(w, x, "ScaleConfig", [])
  }
  xmlv.end(w, name)
}

