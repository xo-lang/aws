fn xml_write_describe_alarm_history_input(var w: xmlv.Writer, v: DescribeAlarmHistoryInput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.alarm_name {
    xmlv.elem(w, "AlarmName", x, [])
  }
  if let Some(x) = v.alarm_contributor_id {
    xmlv.elem(w, "AlarmContributorId", x, [])
  }
  if let Some(x) = v.alarm_types {
    xml_write_alarm_types(w, x, "AlarmTypes", [])
  }
  if let Some(x) = v.history_item_type {
    xmlv.elem(w, "HistoryItemType", x.value(), [])
  }
  if let Some(x) = v.start_date {
    xmlv.elem(w, "StartDate", rest.date_time(x), [])
  }
  if let Some(x) = v.end_date {
    xmlv.elem(w, "EndDate", rest.date_time(x), [])
  }
  if let Some(x) = v.max_records {
    xmlv.elem(w, "MaxRecords", "${x}", [])
  }
  if let Some(x) = v.next_token {
    xmlv.elem(w, "NextToken", x, [])
  }
  if let Some(x) = v.scan_by {
    xmlv.elem(w, "ScanBy", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_describe_alarm_history_input(e: xml.Element) -> DescribeAlarmHistoryInput ! Str {
  var out = DescribeAlarmHistoryInput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "AlarmName" => out.alarm_name = c.text()
      "AlarmContributorId" => out.alarm_contributor_id = c.text()
      "AlarmTypes" => out.alarm_types = xml_read_alarm_types(c)?
      "HistoryItemType" => out.history_item_type = HistoryItemType.from(c.text())
      "StartDate" => out.start_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EndDate" => out.end_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MaxRecords" => out.max_records = xmlv.read_int(c.text())?
      "NextToken" => out.next_token = c.text()
      "ScanBy" => out.scan_by = ScanBy.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

