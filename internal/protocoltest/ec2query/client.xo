}

fn xml_read_xml_enums_output(e: xml.Element) -> XmlEnumsOutput ! Str {
  var out = XmlEnumsOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "fooEnum1" => out.foo_enum1 = FooEnum.from(c.text())
      "fooEnum2" => out.foo_enum2 = FooEnum.from(c.text())
      "fooEnum3" => out.foo_enum3 = FooEnum.from(c.text())
      "fooEnumList" => out.foo_enum_list = xml_read_foo_enum_list(c)?
      "fooEnumSet" => out.foo_enum_set = xml_read_foo_enum_set(c)?
      "fooEnumMap" => out.foo_enum_map = xml_read_foo_enum_map(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_xml_int_enums_output(var w: xmlv.Writer, v: XmlIntEnumsOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.int_enum1 {
    xmlv.elem(w, "intEnum1", "${x.value()}", [])
  }
  if let Some(x) = v.int_enum2 {
    xmlv.elem(w, "intEnum2", "${x.value()}", [])
  }
  if let Some(x) = v.int_enum3 {
    xmlv.elem(w, "intEnum3", "${x.value()}", [])
  }
  if let Some(x) = v.int_enum_list {
    xml_write_integer_enum_list(w, x, "intEnumList", [])
  }
  if let Some(x) = v.int_enum_set {
    xml_write_integer_enum_set(w, x, "intEnumSet", [])
  }
  if let Some(x) = v.int_enum_map {
    xml_write_integer_enum_map(w, x, "intEnumMap", [])
  }
  xmlv.end(w, name)
}

fn xml_read_xml_int_enums_output(e: xml.Element) -> XmlIntEnumsOutput ! Str {
  var out = XmlIntEnumsOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "intEnum1" => out.int_enum1 = IntegerEnum.from(xmlv.read_int(c.text())?)
      "intEnum2" => out.int_enum2 = IntegerEnum.from(xmlv.read_int(c.text())?)
      "intEnum3" => out.int_enum3 = IntegerEnum.from(xmlv.read_int(c.text())?)
      "intEnumList" => out.int_enum_list = xml_read_integer_enum_list(c)?
      "intEnumSet" => out.int_enum_set = xml_read_integer_enum_set(c)?
      "intEnumMap" => out.int_enum_map = xml_read_integer_enum_map(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_xml_lists_output(var w: xmlv.Writer, v: XmlListsOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.string_list {
    xml_write_string_list(w, x, "stringList", [])
  }
  if let Some(x) = v.string_set {
    xml_write_string_set(w, x, "stringSet", [])
  }
  if let Some(x) = v.integer_list {
    xml_write_integer_list(w, x, "integerList", [])
  }
  if let Some(x) = v.boolean_list {
    xml_write_boolean_list(w, x, "booleanList", [])
  }
  if let Some(x) = v.timestamp_list {
    xml_write_timestamp_list(w, x, "timestampList", [])
  }
  if let Some(x) = v.enum_list {
    xml_write_foo_enum_list(w, x, "enumList", [])
  }
  if let Some(x) = v.int_enum_list {
    xml_write_integer_enum_list(w, x, "intEnumList", [])
  }
  if let Some(x) = v.nested_string_list {
    xml_write_nested_string_list(w, x, "nestedStringList", [])
  }
  if let Some(x) = v.renamed_list_members {
    xml_write_renamed_list_members(w, x, "renamed", [])
  }
  if let Some(x) = v.flattened_list {
    for item in x {
      xmlv.elem(w, "flattenedList", item, [])
    }
  }
  if let Some(x) = v.flattened_list2 {
    for item in x {
      xmlv.elem(w, "customName", item, [])
    }
  }
  if let Some(x) = v.flattened_list_with_member_namespace {
    for item in x {
      xmlv.elem(w, "flattenedListWithMemberNamespace", item, [("xmlns", "https://xml-member.example.com")])
    }
  }
  if let Some(x) = v.flattened_list_with_namespace {
    for item in x {
      xmlv.elem(w, "flattenedListWithNamespace", item, [])
    }
  }
  if let Some(x) = v.structure_list {
    xml_write_structure_list(w, x, "myStructureList", [])
  }
  xmlv.end(w, name)
}

fn xml_read_xml_lists_output(e: xml.Element) -> XmlListsOutput ! Str {
  var out = XmlListsOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "stringList" => out.string_list = xml_read_string_list(c)?
      "stringSet" => out.string_set = xml_read_string_set(c)?
      "integerList" => out.integer_list = xml_read_integer_list(c)?
      "booleanList" => out.boolean_list = xml_read_boolean_list(c)?
      "timestampList" => out.timestamp_list = xml_read_timestamp_list(c)?
      "enumList" => out.enum_list = xml_read_foo_enum_list(c)?
      "intEnumList" => out.int_enum_list = xml_read_integer_enum_list(c)?
      "nestedStringList" => out.nested_string_list = xml_read_nested_string_list(c)?
      "renamed" => out.renamed_list_members = xml_read_renamed_list_members(c)?
      "flattenedList" => {
        var items = out.flattened_list ?? []
        items.push(c.text())
        out.flattened_list = items
      }
      "customName" => {
        var items = out.flattened_list2 ?? []
        items.push(c.text())
        out.flattened_list2 = items
      }
      "flattenedListWithMemberNamespace" => {
        var items = out.flattened_list_with_member_namespace ?? []
        items.push(c.text())
        out.flattened_list_with_member_namespace = items
      }
      "flattenedListWithNamespace" => {
        var items = out.flattened_list_with_namespace ?? []
        items.push(c.text())
        out.flattened_list_with_namespace = items
      }
      "myStructureList" => out.structure_list = xml_read_structure_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_xml_namespace_nested(var w: xmlv.Writer, v: XmlNamespaceNested, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.foo {
    xmlv.elem(w, "foo", x, [("xmlns:baz", "http://baz.com")])
  }
  if let Some(x) = v.values {
    xml_write_xml_namespaced_list(w, x, "values", [("xmlns", "http://qux.com")])
  }
  xmlv.end(w, name)
}

fn xml_read_xml_namespace_nested(e: xml.Element) -> XmlNamespaceNested ! Str {
  var out = XmlNamespaceNested{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "foo" => out.foo = c.text()
      "values" => out.values = xml_read_xml_namespaced_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_xml_namespaced_list(var w: xmlv.Writer, v: List[Str], name: Str, ns: List[(Str, Str)]) {
