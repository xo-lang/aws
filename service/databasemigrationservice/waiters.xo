        if state == "" && waiter.path_matches(o, "ReplicationTasks[].Status", "anyStringEquals", "stopping") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "ReplicationTasks[].Status", "anyStringEquals", "stopped") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "ReplicationTasks[].Status", "anyStringEquals", "failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "ReplicationTasks[].Status", "anyStringEquals", "modifying") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "ReplicationTasks[].Status", "anyStringEquals", "testing") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "ReplicationTasks[].Status", "anyStringEquals", "deleting") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
