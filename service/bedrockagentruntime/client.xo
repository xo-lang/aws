fn json_of_trace(v: Trace) -> json.Value {
  match v {
    GuardrailTrace(x) => json.Value.Object([("guardrailTrace", json_of_guardrail_trace(x))])
    PreProcessingTrace(x) => json.Value.Object([("preProcessingTrace", json_of_pre_processing_trace(x))])
    OrchestrationTrace(x) => json.Value.Object([("orchestrationTrace", json_of_orchestration_trace(x))])
    PostProcessingTrace(x) => json.Value.Object([("postProcessingTrace", json_of_post_processing_trace(x))])
