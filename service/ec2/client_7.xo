fn xml_write_verified_access_log_options(var w: xmlv.Writer, v: VerifiedAccessLogOptions, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.s3 {
    xml_write_verified_access_log_s3_destination_options(w, x, "S3", [])
  }
  if let Some(x) = v.cloud_watch_logs {
    xml_write_verified_access_log_cloud_watch_logs_destination_options(w, x, "CloudWatchLogs", [])
  }
  if let Some(x) = v.kinesis_data_firehose {
    xml_write_verified_access_log_kinesis_data_firehose_destination_options(w, x, "KinesisDataFirehose", [])
  }
  if let Some(x) = v.log_version {
    xmlv.elem(w, "LogVersion", x, [])
