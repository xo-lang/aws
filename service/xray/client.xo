  }
  if let Some(x) = v.revision {
    fs.push(("Revision", json.Value.Int(x)))
  }
  if let Some(x) = v.matched_event_time {
    fs.push(("MatchedEventTime", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

