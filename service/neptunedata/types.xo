  /// is 0. Both input data and the output model are stored on disk, so the
  /// volume size must be large enough to hold both data sets. If not
  /// specified or 0, Neptune ML selects a disk volume size based on the
  /// recommendation generated in the data processing step.
  pub base_processing_instance_volume_size_in_gb: Int? = None
  /// The IDs of the subnets in the Neptune VPC. The default is None.
  pub subnets: List[Str]? = None
  /// The VPC security group IDs. The default is None.
  pub security_group_ids: List[Str]? = None
  /// The Amazon Key Management Service (KMS) key that SageMaker uses to
  /// encrypt data on the storage volume attached to the ML compute instances
  /// that run the training job. The default is None.
  pub volume_encryption_kms_key: Str? = None
  /// The Amazon Key Management Service (KMS) key that SageMaker uses to
  /// encrypt the output of the processing job. The default is none.
  pub s3_output_encryption_kms_key: Str? = None
}

pub struct StartMLModelTransformJobOutput {
  /// The unique ID of the new model transform job.
  pub id: Str? = None
  /// The ARN of the model transform job.
  pub arn: Str? = None
  /// The creation time of the model transform job, in milliseconds.
  pub creation_time_in_millis: Int? = None
}

/// Contains statistics information. The DFE engine uses information about
/// the data in your Neptune graph to make effective trade-offs when
/// planning query execution. This information takes the form of statistics
/// that include so-called characteristic sets and predicate statistics that
/// can guide query planning. See Managing statistics for the Neptune DFE to
/// use .
pub struct Statistics {
  /// Indicates whether or not automatic statistics generation is enabled.
  pub auto_compute: Bool? = None
  /// Indicates whether or not DFE statistics generation is enabled at all.
  pub active: Bool? = None
  /// Reports the ID of the current statistics generation run. A value of -1
  /// indicates that no statistics have been generated.
  pub statistics_id: Str? = None
  /// The UTC time at which DFE statistics have most recently been generated.
  pub date: Time? = None
  /// A note about problems in the case where statistics are invalid.
  pub note: Str? = None
  /// A StatisticsSummary structure that contains: signatureCount - The total
  /// number of signatures across all characteristic sets. instanceCount - The
  /// total number of characteristic-set instances. predicateCount - The total
  /// number of unique predicates.
  pub signature_info: StatisticsSummary? = None
}

pub enum StatisticsAutoGenerationMode: Str {
  DisableAutocompute = "disableAutoCompute"
  EnableAutocompute = "enableAutoCompute"
  Refresh = "refresh"
  Unknown(value: Str)
}

/// Raised when statistics needed to satisfy a request are not available.
pub struct StatisticsNotAvailableException {
  /// A detailed message describing the problem.
  pub detailed_message: Str? = None
  /// The ID of the request in question.
  pub request_id: Str? = None
  /// The HTTP status code returned with the exception.
  pub code: Str? = None
}

/// Information about the characteristic sets generated in the statistics.
pub struct StatisticsSummary {
  /// The total number of signatures across all characteristic sets.
  pub signature_count: Int? = None
  /// The total number of characteristic-set instances.
  pub instance_count: Int? = None
  /// The total number of unique predicates.
  pub predicate_count: Int? = None
}

/// Contains storage size and entry count metrics.
pub struct StorageMetrics {
  /// Storage size in bytes.
  pub size_in_bytes: Int? = None
  /// The number of entries.
  pub count: Int? = None
}

/// Raised when stream records requested by a query cannot be found.
pub struct StreamRecordsNotFoundException {
  /// A detailed message describing the problem.
  pub detailed_message: Str? = None
  /// The ID of the request in question.
  pub request_id: Str? = None
  /// The HTTP status code returned with the exception.
  pub code: Str? = None
}

/// A subject structure.
pub struct SubjectStructure {
  /// Number of occurrences of this specific structure.
  pub count: Int? = None
  /// A list of predicates present in this specific structure.
  pub predicates: List[Str]? = None
}

/// Raised when the rate of requests exceeds the maximum throughput.
/// Requests can be retried after encountering this exception.
pub struct ThrottlingException {
  /// A detailed message describing the problem.
  pub detailed_message: Str? = None
  /// The ID of the request that could not be processed for this reason.
  pub request_id: Str? = None
  /// The HTTP status code returned with the exception.
  pub code: Str? = None
}

/// Raised when the an operation exceeds the time limit allowed for it.
pub struct TimeLimitExceededException {
  /// A detailed message describing the problem.
  pub detailed_message: Str? = None
  /// The ID of the request that could not be processed for this reason.
  pub request_id: Str? = None
  /// The HTTP status code returned with the exception.
  pub code: Str? = None
}

/// Raised when the number of requests being processed exceeds the limit.
pub struct TooManyRequestsException {
  /// A detailed message describing the problem.
  pub detailed_message: Str? = None
  /// The ID of the request that could not be processed for this reason.
  pub request_id: Str? = None
  /// The HTTP status code returned with the exception.
  pub code: Str? = None
}

/// Contains storage metrics for the Neptune undo logs, including the total
/// size in bytes and the number of entries in the undo log list.
pub struct UndoLogsMetrics {
  /// The total size of the undo logs in bytes.
  pub size_in_bytes: Int? = None
  /// The number of entries in the undo log list.
  pub list_size: Int? = None
}

/// Raised when a request attempts to initiate an operation that is not
/// supported.
pub struct UnsupportedOperationException {
  /// A detailed message describing the problem.
  pub detailed_message: Str? = None
  /// The ID of the request in question.
  pub request_id: Str? = None
  /// The HTTP status code returned with the exception.
  pub code: Str? = None
}

/// Raised when a parameter value is not valid or is malformed.
pub struct ValidationException {
  /// A detailed message describing the problem.
  pub detailed_message: Str? = None
  /// The ID of the request in question.
  pub request_id: Str? = None
  /// The HTTP status code returned with the exception.
  pub code: Str? = None
}

/// Controls the buffer size used during an index rebuild to track
/// concurrent write operations. Larger values allow the rebuild to tolerate
/// heavier concurrent write traffic.
pub enum WriteBufferSize: Str {
  Low = "LOW"
  Medium = "MEDIUM"
  High = "HIGH"
  Unknown(value: Str)
}
