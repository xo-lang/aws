  }
  if let Some(x) = v.service_update_recommended_apply_by_date {
    xmlv.elem(w, "ServiceUpdateRecommendedApplyByDate", rest.date_time(x), [])
  }
  if let Some(x) = v.service_update_status {
    xmlv.elem(w, "ServiceUpdateStatus", x.value(), [])
  }
