  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var f = query.form("VerifyEmailIdentity", "2010-12-01")
  if let Some(x) = input.email_address {
    query.add(f, query.key("", "EmailAddress"), x)
  }
  body = query.encode(f).bytes()
  headers.push(("Content-Type", "application/x-www-form-urlencoded"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

