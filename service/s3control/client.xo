  }
  if let Some(x) = v.alias {
    xmlv.elem(w, "Alias", x, [])
  }
  if let Some(x) = v.access_point_arn {
    xmlv.elem(w, "AccessPointArn", x, [])
  }
  if let Some(x) = v.endpoints {
    xml_write_endpoints(w, x, "Endpoints", [])
  }
  if let Some(x) = v.bucket_account_id {
