fn query_put_instance_specification(var f: query.Form, prefix: Str, v: InstanceSpecification) {
  if let Some(x) = v.instance_id {
    query.add(f, query.key(prefix, "InstanceId"), x)
  }
  if let Some(x) = v.exclude_boot_volume {
    query.add(f, query.key(prefix, "ExcludeBootVolume"), "${x}")
  }
  if let Some(x) = v.exclude_data_volume_ids {
    query_put_volume_id_string_list(f, query.key(prefix, "ExcludeDataVolumeId"), x, false)
  }
}

fn query_put_instance_state(var f: query.Form, prefix: Str, v: InstanceState) {
  if let Some(x) = v.code {
    query.add(f, query.key(prefix, "Code"), "${x}")
  }
  if let Some(x) = v.name {
    query.add(f, query.key(prefix, "Name"), x.value())
  }
}

fn query_put_instance_state_change(var f: query.Form, prefix: Str, v: InstanceStateChange) {
  if let Some(x) = v.instance_id {
    query.add(f, query.key(prefix, "InstanceId"), x)
  }
  if let Some(x) = v.current_state {
    query_put_instance_state(f, query.key(prefix, "CurrentState"), x)
  }
  if let Some(x) = v.previous_state {
    query_put_instance_state(f, query.key(prefix, "PreviousState"), x)
  }
}

fn query_put_instance_state_change_list(var f: query.Form, prefix: Str, v: List[InstanceStateChange], flat: Bool) {
  let _ = flat
  for (i, x) in v.indexed() {
    let k = "${prefix}.${i + 1}"
    query_put_instance_state_change(f, k, x)
  }
}

fn query_put_instance_status(var f: query.Form, prefix: Str, v: InstanceStatus) {
  if let Some(x) = v.availability_zone {
    query.add(f, query.key(prefix, "AvailabilityZone"), x)
  }
  if let Some(x) = v.availability_zone_id {
    query.add(f, query.key(prefix, "AvailabilityZoneId"), x)
  }
  if let Some(x) = v.outpost_arn {
    query.add(f, query.key(prefix, "OutpostArn"), x)
  }
  if let Some(x) = v.operator {
    query_put_operator_response(f, query.key(prefix, "Operator"), x)
  }
  if let Some(x) = v.events {
    query_put_instance_status_event_list(f, query.key(prefix, "EventsSet"), x, false)
  }
  if let Some(x) = v.instance_id {
    query.add(f, query.key(prefix, "InstanceId"), x)
  }
  if let Some(x) = v.instance_state {
    query_put_instance_state(f, query.key(prefix, "InstanceState"), x)
  }
  if let Some(x) = v.instance_status {
    query_put_instance_status_summary(f, query.key(prefix, "InstanceStatus"), x)
  }
  if let Some(x) = v.system_status {
    query_put_instance_status_summary(f, query.key(prefix, "SystemStatus"), x)
  }
  if let Some(x) = v.attached_ebs_status {
    query_put_ebs_status_summary(f, query.key(prefix, "AttachedEbsStatus"), x)
  }
  if let Some(x) = v.application_status {
    query_put_application_status_summary(f, query.key(prefix, "ApplicationStatus"), x)
  }
  if let Some(x) = v.performance_status {
    query_put_performance_status_summary(f, query.key(prefix, "PerformanceStatus"), x)
  }
}