  pub topic_configurations: List[TopicConfiguration]? = None
  /// An array of sheet definitions for a template.
  pub sheets: List[SheetDefinition]? = None
  /// An array of tooltip sheet definitions for a template.
  pub tooltip_sheets: List[TooltipSheetDefinition]? = None
  /// An array of calculated field definitions for the template.
  pub calculated_fields: List[CalculatedField]? = None
  /// An array of parameter declarations for a template. Parameters are named
  /// variables that can transfer a value for use by an action or an object.
  /// For more information, see Parameters in Amazon Quick Sight in the Amazon
  /// Quick Suite User Guide .
  pub parameter_declarations: List[ParameterDeclaration]? = None
  /// Filter definitions for a template. For more information, see Filtering
  /// Data in the Amazon Quick Suite User Guide .
  pub filter_groups: List[FilterGroup]? = None
  /// An array of template-level column configurations. Column configurations
  /// are used to set default formatting for a column that's used throughout a
  /// template.
  pub column_configurations: List[ColumnConfiguration]? = None
  pub analysis_defaults: AnalysisDefaults? = None
  /// An array of option definitions for a template.
  pub options: AssetOptions? = None
  pub query_execution_options: QueryExecutionOptions? = None
  /// The static files for the definition.
  pub static_files: List[StaticFile]? = None
}

