fn xml_read_restore_from_cluster_snapshot_message(e: xml.Element) -> RestoreFromClusterSnapshotMessage ! Str {
  var out = RestoreFromClusterSnapshotMessage{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ClusterIdentifier" => out.cluster_identifier = c.text()
      "SnapshotIdentifier" => out.snapshot_identifier = c.text()
      "SnapshotArn" => out.snapshot_arn = c.text()
      "SnapshotClusterIdentifier" => out.snapshot_cluster_identifier = c.text()
      "Port" => out.port = xmlv.read_int(c.text())?
      "AvailabilityZone" => out.availability_zone = c.text()
      "AllowVersionUpgrade" => out.allow_version_upgrade = xmlv.read_bool(c.text())?
      "ClusterSubnetGroupName" => out.cluster_subnet_group_name = c.text()
      "PubliclyAccessible" => out.publicly_accessible = xmlv.read_bool(c.text())?
      "OwnerAccount" => out.owner_account = c.text()
      "HsmClientCertificateIdentifier" => out.hsm_client_certificate_identifier = c.text()
      "HsmConfigurationIdentifier" => out.hsm_configuration_identifier = c.text()
      "ElasticIp" => out.elastic_ip = c.text()
      "ClusterParameterGroupName" => out.cluster_parameter_group_name = c.text()
      "ClusterSecurityGroups" => out.cluster_security_groups = xml_read_cluster_security_group_name_list(c)?
      "VpcSecurityGroupIds" => out.vpc_security_group_ids = xml_read_vpc_security_group_id_list(c)?
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "AutomatedSnapshotRetentionPeriod" => out.automated_snapshot_retention_period = xmlv.read_int(c.text())?
      "ManualSnapshotRetentionPeriod" => out.manual_snapshot_retention_period = xmlv.read_int(c.text())?
      "KmsKeyId" => out.kms_key_id = c.text()
      "NodeType" => out.node_type = c.text()
      "EnhancedVpcRouting" => out.enhanced_vpc_routing = xmlv.read_bool(c.text())?
      "AdditionalInfo" => out.additional_info = c.text()
      "IamRoles" => out.iam_roles = xml_read_iam_role_arn_list(c)?
      "MaintenanceTrackName" => out.maintenance_track_name = c.text()
      "SnapshotScheduleIdentifier" => out.snapshot_schedule_identifier = c.text()
      "NumberOfNodes" => out.number_of_nodes = xmlv.read_int(c.text())?
      "AvailabilityZoneRelocation" => out.availability_zone_relocation = xmlv.read_bool(c.text())?
      "AquaConfigurationStatus" => out.aqua_configuration_status = AquaConfigurationStatus.from(c.text())
      "DefaultIamRoleArn" => out.default_iam_role_arn = c.text()
      "ReservedNodeId" => out.reserved_node_id = c.text()
      "TargetReservedNodeOfferingId" => out.target_reserved_node_offering_id = c.text()
      "Encrypted" => out.encrypted = xmlv.read_bool(c.text())?
      "ManageMasterPassword" => out.manage_master_password = xmlv.read_bool(c.text())?
      "MasterPasswordSecretKmsKeyId" => out.master_password_secret_kms_key_id = c.text()
      "IpAddressType" => out.ip_address_type = c.text()
      "MultiAZ" => out.multi_az = xmlv.read_bool(c.text())?
      "CatalogName" => out.catalog_name = c.text()
      "RedshiftIdcApplicationArn" => out.redshift_idc_application_arn = c.text()
      _ => {}
    }
  }
  Ok(out)
}

