  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/v1/clusters/${rest.escape(label_cluster_arn, false)}/scram-secrets"),
    query: rest.query(qs),
    headers: headers,
    body: body,
