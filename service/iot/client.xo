fn json_of_asset_property_variant(v: AssetPropertyVariant) -> json.Value {
  match v {
    StringValue(x) => json.Value.Object([("stringValue", json.Value.Str(x))])
    IntegerValue(x) => json.Value.Object([("integerValue", json.Value.Str(x))])
    DoubleValue(x) => json.Value.Object([("doubleValue", json.Value.Str(x))])
    BooleanValue(x) => json.Value.Object([("booleanValue", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_asset_property_variant(v: json.Value) -> AssetPropertyVariant ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "stringValue" => Ok(AssetPropertyVariant.StringValue(jsonv.read_str(fv)?))
      "integerValue" => Ok(AssetPropertyVariant.IntegerValue(jsonv.read_str(fv)?))
      "doubleValue" => Ok(AssetPropertyVariant.DoubleValue(jsonv.read_str(fv)?))
      "booleanValue" => Ok(AssetPropertyVariant.BooleanValue(jsonv.read_str(fv)?))
      _ => Ok(AssetPropertyVariant.Unknown(k))
    }
  }
  Err("AssetPropertyVariant: no member set")
}

