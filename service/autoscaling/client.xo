fn query_put_accelerator_count_request(var f: query.Form, prefix: Str, v: AcceleratorCountRequest) {
  if let Some(x) = v.min {
    query.add(f, query.key(prefix, "Min"), "${x}")
  }
  if let Some(x) = v.max {
    query.add(f, query.key(prefix, "Max"), "${x}")
  }
}

fn query_put_accelerator_manufacturers(var f: query.Form, prefix: Str, v: List[AcceleratorManufacturer], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query.add(f, k, x.value())
  }
}

fn query_put_accelerator_names(var f: query.Form, prefix: Str, v: List[AcceleratorName], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
