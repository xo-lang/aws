  var req = serialize_create_participant_connection(ep, input, "") ?? e => return Err(CreateParticipantConnectionErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(CreateParticipantConnectionErr.Send(e))
  if resp.status >= 300 {
