    fs.push(("vpcLatticeConfigurations", json_of_vpc_lattice_configurations(x)))
  }
  if let Some(x) = v.resolved_configuration {
    fs.push(("resolvedConfiguration", json_of_resolved_configuration(x)))
  }
  if let Some(x) = v.ecs_managed_resources {
    fs.push(("ecsManagedResources", json_of_ecs_managed_resources(x)))
  }
  if let Some(x) = v.overrides {
    fs.push(("overrides", json_of_service_revision_overrides(x)))
  }
  if let Some(x) = v.gateway_connectors {
    fs.push(("gatewayConnectors", json_of_gateway_connector_list(x)))
  }
  if let Some(x) = v.monitoring {
    fs.push(("monitoring", json_of_monitoring_configuration(x)))
  }
  json.Value.Object(fs)
}

fn from_json_service_revision(v: json.Value) -> ServiceRevision ! Str {
  var out = ServiceRevision{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "serviceRevisionArn" => out.service_revision_arn = jsonv.read_str(fv)?
      "serviceArn" => out.service_arn = jsonv.read_str(fv)?
      "clusterArn" => out.cluster_arn = jsonv.read_str(fv)?
      "taskDefinition" => out.task_definition = jsonv.read_str(fv)?
      "capacityProviderStrategy" => out.capacity_provider_strategy = from_json_capacity_provider_strategy(fv)?
      "launchType" => out.launch_type = LaunchType.from(jsonv.read_str(fv)?)
      "platformVersion" => out.platform_version = jsonv.read_str(fv)?
      "platformFamily" => out.platform_family = jsonv.read_str(fv)?
      "loadBalancers" => out.load_balancers = from_json_load_balancers(fv)?
      "serviceRegistries" => out.service_registries = from_json_service_registries(fv)?
      "networkConfiguration" => out.network_configuration = from_json_network_configuration(fv)?
      "containerImages" => out.container_images = from_json_container_images(fv)?
      "guardDutyEnabled" => out.guard_duty_enabled = jsonv.read_bool(fv)?
      "serviceConnectConfiguration" => out.service_connect_configuration = from_json_service_connect_configuration(fv)?
      "volumeConfigurations" => out.volume_configurations = from_json_service_volume_configurations(fv)?
      "fargateEphemeralStorage" => out.fargate_ephemeral_storage = from_json_deployment_ephemeral_storage(fv)?
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "vpcLatticeConfigurations" => out.vpc_lattice_configurations = from_json_vpc_lattice_configurations(fv)?
      "resolvedConfiguration" => out.resolved_configuration = from_json_resolved_configuration(fv)?
      "ecsManagedResources" => out.ecs_managed_resources = from_json_ecs_managed_resources(fv)?
      "overrides" => out.overrides = from_json_service_revision_overrides(fv)?
      "gatewayConnectors" => out.gateway_connectors = from_json_gateway_connector_list(fv)?
      "monitoring" => out.monitoring = from_json_monitoring_configuration(fv)?
      _ => {}
    }
  }
  Ok(out)
}

