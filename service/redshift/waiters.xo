}

/// Calls DescribeClusterSnapshots until the SnapshotAvailable acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (15s) to `max_delay` (120s).
pub fn wait_until_snapshot_available(c: Client, input: DescribeClusterSnapshotsMessage, max_wait: Duration, min_delay: Duration = 15s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeClusterSnapshotsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_cluster_snapshots(input) {
      Ok(out) => {
        let o = jmes_of_snapshot_message(out)
        if state == "" && waiter.path_matches(o, "Snapshots[].Status", "allStringEquals", "available") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Snapshots[].Status", "anyStringEquals", "failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "Snapshots[].Status", "anyStringEquals", "deleted") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("SnapshotAvailable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeClusters until the ClusterAvailable acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (60s) to `max_delay` (120s).
pub fn wait_until_cluster_available(c: Client, input: DescribeClustersMessage, max_wait: Duration, min_delay: Duration = 60s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeClustersErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_clusters(input) {
      Ok(out) => {
        let o = jmes_of_clusters_message(out)
        if state == "" && waiter.path_matches(o, "Clusters[].ClusterStatus", "allStringEquals", "available") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Clusters[].ClusterStatus", "anyStringEquals", "deleting") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_clusters(e)
        if state == "" && waiter.error_is(names, "ClusterNotFound") {
          state = "retry"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ClusterAvailable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeClusters until the ClusterDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (60s) to `max_delay` (120s).
pub fn wait_until_cluster_deleted(c: Client, input: DescribeClustersMessage, max_wait: Duration, min_delay: Duration = 60s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeClustersErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_clusters(input) {
      Ok(out) => {
        let o = jmes_of_clusters_message(out)
        if state == "" && waiter.path_matches(o, "Clusters[].ClusterStatus", "anyStringEquals", "creating") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "Clusters[].ClusterStatus", "anyStringEquals", "modifying") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_clusters(e)
        if state == "" && waiter.error_is(names, "ClusterNotFound") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ClusterDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

