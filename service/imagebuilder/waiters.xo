/// Wait until an image build version reaches the AVAILABLE state, meaning
/// the build completed, including distribution and integration of output
/// resources. The waiter fails if the image reaches the FAILED or CANCELLED
/// state. Specify the full image build version ARN; wildcard version ARNs
/// only resolve to images that are already available.
///
/// Calls GetImage until the ImageAvailable acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (60s) to `max_delay` (120s).
pub fn wait_until_image_available(c: Client, input: GetImageRequest, max_wait: Duration, min_delay: Duration = 60s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetImageErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).get_image(input) {
      Ok(out) => {
        let o = jmes_of_get_image_response(out)
        if state == "" && waiter.path_matches(o, "image.state.status", "stringEquals", "AVAILABLE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "image.state.status", "stringEquals", "FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "image.state.status", "stringEquals", "CANCELLED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ImageAvailable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
