/// Metadata information about the health of a Slurm component on the
/// controller node of a HyperPod cluster.
pub struct SlurmHealthMetadata {
  /// The Slurm component that the health information describes. The valid
  /// value is Slurmdbd , the Slurm accounting daemon.
  pub component: SlurmHealthComponent? = None
  /// The health of the component. Valid values are Healthy and Unhealthy .
  pub status: SlurmHealthStatus? = None
  /// The reason the component is unhealthy. Valid values: DaemonDown : The
  /// daemon is not running, so job accounting records are not being written.
  /// DaemonDisabled : The daemon is running and its accounting database is
  /// responding, but the daemon is not enabled to start automatically. Job
  /// accounting stops the next time the controller node restarts.
  /// DbUnreachable : The daemon is running, but its accounting database did
  /// not respond. Job accounting records might not be written. This field is
  /// omitted when the component is healthy.
  pub reason: SlurmHealthReason? = None
}

