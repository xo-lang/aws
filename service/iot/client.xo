    fs.push(("jobExecutionsRolloutConfig", json_of_job_executions_rollout_config(x)))
  }
  if let Some(x) = v.abort_config {
    fs.push(("abortConfig", json_of_abort_config(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("createdAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_updated_at {
    fs.push(("lastUpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.completed_at {
