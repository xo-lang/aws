  ConcurrentModification(e: ConcurrentModification)
  InvalidInputError(e: InvalidInput)
  InvalidKeySigningKeyStatus(e: InvalidKeySigningKeyStatus)
  InvalidKMSArn(e: InvalidKMSArn)
