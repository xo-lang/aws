    xml_write_log_type_list(w, x, "EnableCloudwatchLogsExports", [])
  }
  if let Some(x) = v.deletion_protection {
    xmlv.elem(w, "DeletionProtection", "${x}", [])
  }
  if let Some(x) = v.db_cluster_parameter_group_name {
    xmlv.elem(w, "DBClusterParameterGroupName", x, [])
  }
  if let Some(x) = v.serverless_v2_scaling_configuration {
    xml_write_serverless_v2_scaling_configuration(w, x, "ServerlessV2ScalingConfiguration", [])
