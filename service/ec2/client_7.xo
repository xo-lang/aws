fn xml_read_snapshot_info(e: xml.Element) -> SnapshotInfo ! Str {
  var out = SnapshotInfo{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "description" => out.description = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "encrypted" => out.encrypted = xmlv.read_bool(c.text())?
      "volumeId" => out.volume_id = c.text()
      "state" => out.state = SnapshotState.from(c.text())
      "volumeSize" => out.volume_size = xmlv.read_int(c.text())?
      "startTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "progress" => out.progress = c.text()
      "ownerId" => out.owner_id = c.text()
      "snapshotId" => out.snapshot_id = c.text()
      "outpostArn" => out.outpost_arn = c.text()
      "sseType" => out.sse_type = SSEType.from(c.text())
      "availabilityZone" => out.availability_zone = c.text()
      _ => {}
    }
  }
  Ok(out)
}

