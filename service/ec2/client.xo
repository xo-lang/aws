fn xml_write_import_image_request(var w: xmlv.Writer, v: ImportImageRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.architecture {
    xmlv.elem(w, "Architecture", x, [])
  }
  if let Some(x) = v.client_data {
    xml_write_client_data(w, x, "ClientData", [])
  }
  if let Some(x) = v.client_token {
    xmlv.elem(w, "ClientToken", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.disk_containers {
    xml_write_image_disk_container_list(w, x, "DiskContainer", [])
  }
  if let Some(x) = v.dry_run {
    xmlv.elem(w, "DryRun", "${x}", [])
  }
  if let Some(x) = v.encrypted {
    xmlv.elem(w, "Encrypted", "${x}", [])
  }
  if let Some(x) = v.hypervisor {
    xmlv.elem(w, "Hypervisor", x, [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KmsKeyId", x, [])
  }
  if let Some(x) = v.license_type {
    xmlv.elem(w, "LicenseType", x, [])
  }
  if let Some(x) = v.platform {
    xmlv.elem(w, "Platform", x, [])
  }
  if let Some(x) = v.role_name {
    xmlv.elem(w, "RoleName", x, [])
