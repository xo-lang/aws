  /// AutomaticFailoverEnabled is false you can omit this parameter (it will
  /// default to 1), or you can explicitly set it to a value between 2 and 6.
  /// The maximum permitted value for NumCacheClusters is 6 (1 primary plus 5
  /// replicas).
  pub num_cache_clusters: Int? = None
  /// A list of EC2 Availability Zones in which the replication group's
