    match k {
      "Type" => out.type_value = jsonv.read_str(fv)?
      "Id" => out.id = jsonv.read_str(fv)?
      "Partition" => out.partition = Partition.from(jsonv.read_str(fv)?)
      "Region" => out.region = jsonv.read_str(fv)?
      "Provider" => out.provider = CloudProviderName.from(jsonv.read_str(fv)?)
      "Owner" => out.owner = from_json_resource_owner(fv)?
      "ResourceRole" => out.resource_role = jsonv.read_str(fv)?
      "Tags" => out.tags = from_json_field_map(fv)?
      "DataClassification" => out.data_classification = from_json_data_classification_details(fv)?
      "Details" => out.details = from_json_resource_details(fv)?
      "ApplicationName" => out.application_name = jsonv.read_str(fv)?
      "ApplicationArn" => out.application_arn = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_resource_conflict_exception(v: ResourceConflictException) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.message {
    fs.push(("Message", json.Value.Str(x)))
  }
  if let Some(x) = v.code {
    fs.push(("Code", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_resource_conflict_exception(v: json.Value) -> ResourceConflictException ! Str {
  var out = ResourceConflictException{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Message" => out.message = jsonv.read_str(fv)?
      "Code" => out.code = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

