/// Performs a rollback of a transaction. Rolling back a transaction cancels
/// its changes.
pub fn (c: Client) rollback_transaction(input: RollbackTransactionRequest) -> RollbackTransactionResponse ! RollbackTransactionErr uses (net.dial, clock, rand) {
