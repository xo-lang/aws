// Running a profile's credential_process (decision 0011: the root keeps
// `aws.CredentialProcess`, this module runs the program).

use github.com/xo-lang/aws
use std/task

/// Runs the command once and keeps its credentials; a failure keeps the
/// last good ones and records the error.
pub fn run_process_once(c: aws.CredentialProcess, proc: Proc, clock: Clock) -> () ! Str uses (proc, clock) {
  let (shell, flag) = if c.windows { ("cmd.exe", "/C") } else { ("sh", "-c") }
  let out = task.with_timeout(clock, c.timeout, fn() -> ProcOutput ! ProcErr { proc.cmd(shell, [flag, c.command]).output() }) ?? e => {
    let msg = match e {
      task.Timed.TimedOut => "did not finish within ${c.timeout}"
      task.Timed.Failed(pe) => pe.display()
    }
    return c.failed(msg)
  }
  if out.code != 0 {
    let err = (out.stderr.to_str() ?? "").trim()
    return c.failed("exit status ${out.code}${if err == "" { "" } else { ": ${err}" }}")
  }
  let creds = aws.parse_process_output(out.stdout) ?? e => return c.failed(e)
  c.succeeded(creds)
  Ok(())
}

/// Runs the command now and again 5 minutes before the credentials
/// expire, until cancelled; after a failure it tries again in a minute.
/// Credentials without an Expiration are fetched once.
pub fn run_process(c: aws.CredentialProcess, proc: Proc, clock: Clock) uses (proc, clock) {
  var first = true
  while true {
    let ok = run_process_once(c, proc, clock).is_ok()
    if first {
      first = false
      c.first_run_done()
    }
    let next = if ok {
      match c.expires() {
        Some(t) => (t.unix_millis() - clock.now().unix_millis() - 5 * 60 * 1000).max(10 * 1000)
        None => return
      }
    } else {
      60 * 1000
    }
    clock.sleep(Duration.from_millis(next))
  }
}

/// Starts `c` on `tasks` (a group that lives as long as the program,
/// `os.tasks`) unless it was started already.
pub fn start_process(c: aws.CredentialProcess, tasks: task.Group, proc: Proc, clock: Clock) uses (proc, clock) {
  if c.start() {
    tasks.spawn_background(fn() { run_process(c, proc, clock) })
  }
}
