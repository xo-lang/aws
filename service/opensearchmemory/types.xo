}

pub struct UpdateSpaceRequest {
  /// The ID of the space to update.
  pub space_id: Str? = None
  /// The complete new list of memory strategies. The service removes
  /// strategies that aren't in the list from the space. Removing a strategy
  /// stops extraction for it but doesn't delete its memories: they're kept,
  /// until they expire if the space sets memoryExpiryDays , and they're
  /// available again if you later add a strategy with the same type and name
  /// . To delete them, use DeleteMemory before you remove the strategy, or
  /// delete the space. To keep a strategy, include it with the same type and
  /// name that GetSpace returns. For a kept strategy, any configuration
  /// member you omit keeps its current value. It doesn't return to the
  /// default, and you can't clear a member once it's set. Omit this field to
  /// leave the strategies unchanged. The list must name at least one
  /// strategy. You can't remove every strategy from a space with UpdateSpace
  /// . The serialized list can be at most 384 KiB.
  pub memory_strategies: List[MemoryStrategy]? = None
  /// How many days the space keeps each event, from 1 to 365. Omit it to
  /// leave the current value unchanged. Events already stored keep the expiry
  /// they were written with.
  pub event_expiry_days: Int? = None
  /// How many days the space keeps each memory, from 0 to 3650. 0 means
  /// memories never expire. Omit it to leave the current value unchanged. You
  /// can't clear the setting. To make memories written from then on never
  /// expire, send 0. GetSpace then returns 0. A change applies to memories
  /// written after it. Memories already stored keep the expiry they were
  /// written with. A memory the service rewrites later, such as a summary it
  /// keeps up to date, takes the setting in force at that rewrite. A change
  /// moves the space to UPDATING . Sending the value that the space has
  /// stored doesn't.
  pub memory_expiry_days: Int? = None
  /// The model that extracts and consolidates memories for every strategy in
  /// the space: anthropic.claude-opus-5-5 or anthropic.claude-haiku-5-5 .
  /// Omit it to leave the current value unchanged. Once set, it can't be
  /// cleared back to the service default.
  pub extraction_model_id: Str? = None
}

pub struct UpdateSpaceResponse {
  /// The ID of the space.
  pub space_id: Str? = None
  /// The status of the space: UPDATING when the change has to be applied to
  /// the space's strategies, retention, or extraction model. Otherwise, the
  /// space's current status.
  pub status: SpaceStatus? = None
}

/// The request isn't valid. The reason , message , and fieldList members
/// describe the problem. Fix the request, and then try again.
pub struct ValidationException {
