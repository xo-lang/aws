fn xml_write_predictive_scaling_metric_specification(var w: xmlv.Writer, v: PredictiveScalingMetricSpecification, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.target_value {
    xmlv.elem(w, "TargetValue", rest.float_text(x), [])
  }
  if let Some(x) = v.predefined_metric_pair_specification {
    xml_write_predictive_scaling_predefined_metric_pair(w, x, "PredefinedMetricPairSpecification", [])
  }
  if let Some(x) = v.predefined_scaling_metric_specification {
    xml_write_predictive_scaling_predefined_scaling_metric(w, x, "PredefinedScalingMetricSpecification", [])
  }
  if let Some(x) = v.predefined_load_metric_specification {
    xml_write_predictive_scaling_predefined_load_metric(w, x, "PredefinedLoadMetricSpecification", [])
  }
  if let Some(x) = v.customized_scaling_metric_specification {
    xml_write_predictive_scaling_customized_scaling_metric(w, x, "CustomizedScalingMetricSpecification", [])
  }
  if let Some(x) = v.customized_load_metric_specification {
    xml_write_predictive_scaling_customized_load_metric(w, x, "CustomizedLoadMetricSpecification", [])
  }
  if let Some(x) = v.customized_capacity_metric_specification {
    xml_write_predictive_scaling_customized_capacity_metric(w, x, "CustomizedCapacityMetricSpecification", [])
  }
  xmlv.end(w, name)
}

fn xml_read_predictive_scaling_metric_specification(e: xml.Element) -> PredictiveScalingMetricSpecification ! Str {
  var out = PredictiveScalingMetricSpecification{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TargetValue" => out.target_value = xmlv.read_float(c.text())?
      "PredefinedMetricPairSpecification" => out.predefined_metric_pair_specification = xml_read_predictive_scaling_predefined_metric_pair(c)?
      "PredefinedScalingMetricSpecification" => out.predefined_scaling_metric_specification = xml_read_predictive_scaling_predefined_scaling_metric(c)?
      "PredefinedLoadMetricSpecification" => out.predefined_load_metric_specification = xml_read_predictive_scaling_predefined_load_metric(c)?
      "CustomizedScalingMetricSpecification" => out.customized_scaling_metric_specification = xml_read_predictive_scaling_customized_scaling_metric(c)?
      "CustomizedLoadMetricSpecification" => out.customized_load_metric_specification = xml_read_predictive_scaling_customized_load_metric(c)?
      "CustomizedCapacityMetricSpecification" => out.customized_capacity_metric_specification = xml_read_predictive_scaling_customized_capacity_metric(c)?
      _ => {}
    }
  }
  Ok(out)
}

