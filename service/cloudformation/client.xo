fn xml_write_change_set_summary(var w: xmlv.Writer, v: ChangeSetSummary, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.stack_id {
    xmlv.elem(w, "StackId", x, [])
  }
  if let Some(x) = v.stack_name {
    xmlv.elem(w, "StackName", x, [])
  }
  if let Some(x) = v.change_set_id {
    xmlv.elem(w, "ChangeSetId", x, [])
  }
  if let Some(x) = v.change_set_name {
    xmlv.elem(w, "ChangeSetName", x, [])
  }
  if let Some(x) = v.execution_status {
    xmlv.elem(w, "ExecutionStatus", x.value(), [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.status_reason {
    xmlv.elem(w, "StatusReason", x, [])
  }
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "CreationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.include_nested_stacks {
    xmlv.elem(w, "IncludeNestedStacks", "${x}", [])
  }
  if let Some(x) = v.parent_change_set_id {
    xmlv.elem(w, "ParentChangeSetId", x, [])
  }
  if let Some(x) = v.root_change_set_id {
    xmlv.elem(w, "RootChangeSetId", x, [])
  }
  if let Some(x) = v.import_existing_resources {
    xmlv.elem(w, "ImportExistingResources", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_change_set_summary(e: xml.Element) -> ChangeSetSummary ! Str {
  var out = ChangeSetSummary{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "StackId" => out.stack_id = c.text()
      "StackName" => out.stack_name = c.text()
      "ChangeSetId" => out.change_set_id = c.text()
      "ChangeSetName" => out.change_set_name = c.text()
      "ExecutionStatus" => out.execution_status = ExecutionStatus.from(c.text())
      "Status" => out.status = ChangeSetStatus.from(c.text())
      "StatusReason" => out.status_reason = c.text()
      "CreationTime" => out.creation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Description" => out.description = c.text()
      "IncludeNestedStacks" => out.include_nested_stacks = xmlv.read_bool(c.text())?
      "ParentChangeSetId" => out.parent_change_set_id = c.text()
      "RootChangeSetId" => out.root_change_set_id = c.text()
      "ImportExistingResources" => out.import_existing_resources = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

