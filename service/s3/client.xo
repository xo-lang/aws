  if let Some(x) = v.tagging {
    xmlv.elem(w, "Tagging", x, [])
  }
  if let Some(x) = v.object_lock_mode {
    xmlv.elem(w, "ObjectLockMode", x.value(), [])
  }
  if let Some(x) = v.object_lock_retain_until_date {
    xmlv.elem(w, "ObjectLockRetainUntilDate", rest.date_time(x), [])
  }
