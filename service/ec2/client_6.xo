  }
  if let Some(x) = v.cpu_options {
    xml_write_launch_template_cpu_options(w, x, "cpuOptions", [])
  }
  if let Some(x) = v.capacity_reservation_specification {
    xml_write_launch_template_capacity_reservation_specification_response(w, x, "capacityReservationSpecification", [])
  }
  if let Some(x) = v.license_specifications {
    xml_write_launch_template_license_list(w, x, "licenseSet", [])
  }
  if let Some(x) = v.hibernation_options {
    xml_write_launch_template_hibernation_options(w, x, "hibernationOptions", [])
  }
  if let Some(x) = v.metadata_options {
    xml_write_launch_template_instance_metadata_options(w, x, "metadataOptions", [])
  }
  if let Some(x) = v.enclave_options {
