    out.push(from_json_event(fv)?)
  }
  Ok(out)
}

fn json_of_event_payload(v: EventPayload) -> json.Value {
  match v {
    Conversational(x) => json.Value.Object([("conversational", json_of_conversational_payload(x))])
    StructuredData(x) => json.Value.Object([("structuredData", json_of_structured_data_payload(x))])
    Blob(x) => json.Value.Object([("blob", json_of_blob_payload(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_event_payload(v: json.Value) -> EventPayload ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "conversational" => Ok(EventPayload.Conversational(from_json_conversational_payload(fv)?))
      "structuredData" => Ok(EventPayload.StructuredData(from_json_structured_data_payload(fv)?))
      "blob" => Ok(EventPayload.Blob(from_json_blob_payload(fv)?))
      _ => Ok(EventPayload.Unknown(k))
    }
  }
  Err("EventPayload: no member set")
}

