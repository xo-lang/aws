  /// while a Direct Debit or UPI mandate waits for confirmation. Amazon Web
  /// Services doesn't use the instrument for payments until setup is
  /// complete. You don't need to take action.
  pub status: PaymentInstrumentStatus? = None
  /// The details that are specific to the instrument's payment method. This
  /// member is absent for a payment method that has no additional details.
  pub details: PaymentInstrumentDetails? = None
  /// The date and time, in UTC, when the instrument was registered.
  pub created_at: Time? = None
  /// The date and time, in UTC, when the instrument was last changed.
  pub updated_at: Time? = None
}

/// The details that are specific to a payment instrument's payment method.
pub enum PaymentInstrumentDetails {
  Card(value: Card)
  UsAchBankAccount(value: UsAchBankAccount)
  SepaBankAccount(value: SepaBankAccount)
  UkBacsBankAccount(value: UkBacsBankAccount)
  InNetBanking(value: InNetBanking)
  CnBankRedirect(value: CnBankRedirect)
  Upi(value: Upi)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

pub enum PaymentInstrumentStatus: Str {
  Active = "ACTIVE"
  PendingSetup = "PENDING_SETUP"
  SetupInProgress = "SETUP_IN_PROGRESS"
  Invalid = "INVALID"
  Unknown(value: Str)
}

/// A payment instrument as it appears in ListPaymentInstruments . Call
/// GetPaymentInstrument for the full instrument, including the details
/// specific to its payment method such as a card's last four digits and
/// expiration.
pub struct PaymentInstrumentSummary {
  /// The ID of the instrument, unique within your account. It's the last
  /// segment of the instrument's ARN.
  pub id: Str? = None
  /// The Amazon Resource Name (ARN) of the instrument. To allow or deny
  /// GetPaymentInstrument for this instrument, use the ARN in the Resource
  /// element of an Amazon Web Services Identity and Access Management (IAM)
  /// policy.
  pub arn: Str? = None
  /// The payment method of the instrument. The following values are valid:
  /// CARD – A credit or debit card. US_ACH_BANK_ACCOUNT – A US bank
  /// account debited over Automated Clearing House (ACH). SEPA_BANK_ACCOUNT
  /// – A bank account debited over Single Euro Payments Area (SEPA) Direct
  /// Debit. UK_BACS_BANK_ACCOUNT – A UK bank account debited over Bacs
  /// Direct Debit. IN_NET_BANKING – India net banking. You authorize each
  /// payment on your bank's website. CN_BANK_REDIRECT – China bank
  /// redirect. You authorize each payment on your bank's website. UPI –
  /// Unified Payments Interface, the India real-time payment system. PIX –
  /// Pix, the Brazilian Central Bank instant payment system. PAY_BY_INVOICE
  /// – Pay by invoice. You pay each invoice yourself, for example by bank
  /// transfer, instead of Amazon Web Services collecting payment from a card
  /// or a bank account.
  pub payment_method: PaymentMethod? = None
  /// The current status of the instrument. The following values are valid:
  /// ACTIVE – The instrument is set up, and Amazon Web Services can use it
  /// for payments. ACTIVE doesn't confirm that the instrument is verified or
  /// that a payment with it will succeed. You don't need to take action.
  /// INVALID – Amazon Web Services can't use the instrument for payments,
  /// for example because its Direct Debit or UPI mandate is no longer valid.
  /// This status is permanent. The instrument doesn't return to ACTIVE . To
  /// pay with this payment method again, add a new payment instrument.
  /// PENDING_SETUP – The instrument needs an action from you before Amazon
  /// Web Services can use it, such as resuming a paused UPI mandate in your
  /// UPI app. Amazon Web Services doesn't use the instrument for payments
  /// until you complete that action. SETUP_IN_PROGRESS – You completed the
  /// setup steps, and setup of the instrument is in progress, for example
  /// while a Direct Debit or UPI mandate waits for confirmation. Amazon Web
  /// Services doesn't use the instrument for payments until setup is
  /// complete. You don't need to take action.
  pub status: PaymentInstrumentStatus? = None
  /// The date and time, in UTC, when the instrument was registered.
  pub created_at: Time? = None
  /// The date and time, in UTC, when the instrument was last changed.
  pub updated_at: Time? = None
}

pub enum PaymentMethod: Str {
  Card = "CARD"
  UsAchBankAccount = "US_ACH_BANK_ACCOUNT"
  SepaBankAccount = "SEPA_BANK_ACCOUNT"
  UkBacsBankAccount = "UK_BACS_BANK_ACCOUNT"
  InNetBanking = "IN_NET_BANKING"
  CnBankRedirect = "CN_BANK_REDIRECT"
  Upi = "UPI"
  Pix = "PIX"
  PayByInvoice = "PAY_BY_INVOICE"
  Unknown(value: Str)
}

