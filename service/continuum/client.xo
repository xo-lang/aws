fn json_of_per_finding_result(v: PerFindingResult) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.finding_id {
    fs.push(("findingId", json.Value.Str(x)))
  }
  if let Some(x) = v.exploitable {
    fs.push(("exploitable", json.Value.Str(x.value())))
  }
  if let Some(x) = v.confidence {
    fs.push(("confidence", jsonv.float(x)))
  }
  if let Some(x) = v.flow_verdicts {
    fs.push(("flowVerdicts", json_of_flow_verdicts(x)))
  }
  if let Some(x) = v.reasoning_chain {
    fs.push(("reasoningChain", json_of_reasoning_steps(x)))
  }
  if let Some(x) = v.exploit_artifact {
