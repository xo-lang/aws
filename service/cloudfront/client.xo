}

fn xml_read_ca_certificates_bundle_source(e: xml.Element) -> CaCertificatesBundleSource ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "CaCertificatesBundleS3Location" => Ok(CaCertificatesBundleSource.CaCertificatesBundleS3Location(xml_read_ca_certificates_bundle_s3_location(c)?))
      _ => Ok(CaCertificatesBundleSource.Unknown(c.name.local))
    }
  }
  Err("CaCertificatesBundleSource: no member set")
}

fn xml_write_cache_behavior(var w: xmlv.Writer, v: CacheBehavior, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.path_pattern {
    xmlv.elem(w, "PathPattern", x, [])
  }
  if let Some(x) = v.target_origin_id {
    xmlv.elem(w, "TargetOriginId", x, [])
  }
  if let Some(x) = v.trusted_signers {
    xml_write_trusted_signers(w, x, "TrustedSigners", [])
  }
  if let Some(x) = v.trusted_key_groups {
    xml_write_trusted_key_groups(w, x, "TrustedKeyGroups", [])
  }
  if let Some(x) = v.viewer_protocol_policy {
    xmlv.elem(w, "ViewerProtocolPolicy", x.value(), [])
  }
  if let Some(x) = v.allowed_methods {
    xml_write_allowed_methods(w, x, "AllowedMethods", [])
  }
  if let Some(x) = v.smooth_streaming {
    xmlv.elem(w, "SmoothStreaming", "${x}", [])
  }
  if let Some(x) = v.compress {
    xmlv.elem(w, "Compress", "${x}", [])
  }
  if let Some(x) = v.lambda_function_associations {
    xml_write_lambda_function_associations(w, x, "LambdaFunctionAssociations", [])
  }
  if let Some(x) = v.function_associations {
    xml_write_function_associations(w, x, "FunctionAssociations", [])
  }
  if let Some(x) = v.field_level_encryption_id {
    xmlv.elem(w, "FieldLevelEncryptionId", x, [])
  }
  if let Some(x) = v.realtime_log_config_arn {
    xmlv.elem(w, "RealtimeLogConfigArn", x, [])
  }
  if let Some(x) = v.cache_policy_id {
    xmlv.elem(w, "CachePolicyId", x, [])
  }
  if let Some(x) = v.origin_request_policy_id {
    xmlv.elem(w, "OriginRequestPolicyId", x, [])
  }
  if let Some(x) = v.response_headers_policy_id {
    xmlv.elem(w, "ResponseHeadersPolicyId", x, [])
  }
  if let Some(x) = v.grpc_config {
    xml_write_grpc_config(w, x, "GrpcConfig", [])
  }
  if let Some(x) = v.forwarded_values {
    xml_write_forwarded_values(w, x, "ForwardedValues", [])
  }
  if let Some(x) = v.min_ttl {
    xmlv.elem(w, "MinTTL", "${x}", [])
  }
  if let Some(x) = v.default_ttl {
    xmlv.elem(w, "DefaultTTL", "${x}", [])
  }
  if let Some(x) = v.max_ttl {
    xmlv.elem(w, "MaxTTL", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_cache_behavior(e: xml.Element) -> CacheBehavior ! Str {
  var out = CacheBehavior{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "PathPattern" => out.path_pattern = c.text()
      "TargetOriginId" => out.target_origin_id = c.text()
      "TrustedSigners" => out.trusted_signers = xml_read_trusted_signers(c)?
      "TrustedKeyGroups" => out.trusted_key_groups = xml_read_trusted_key_groups(c)?
      "ViewerProtocolPolicy" => out.viewer_protocol_policy = ViewerProtocolPolicy.from(c.text())
      "AllowedMethods" => out.allowed_methods = xml_read_allowed_methods(c)?
      "SmoothStreaming" => out.smooth_streaming = xmlv.read_bool(c.text())?
      "Compress" => out.compress = xmlv.read_bool(c.text())?
      "LambdaFunctionAssociations" => out.lambda_function_associations = xml_read_lambda_function_associations(c)?
      "FunctionAssociations" => out.function_associations = xml_read_function_associations(c)?
      "FieldLevelEncryptionId" => out.field_level_encryption_id = c.text()
      "RealtimeLogConfigArn" => out.realtime_log_config_arn = c.text()
      "CachePolicyId" => out.cache_policy_id = c.text()
      "OriginRequestPolicyId" => out.origin_request_policy_id = c.text()
      "ResponseHeadersPolicyId" => out.response_headers_policy_id = c.text()
      "GrpcConfig" => out.grpc_config = xml_read_grpc_config(c)?
      "ForwardedValues" => out.forwarded_values = xml_read_forwarded_values(c)?
      "MinTTL" => out.min_ttl = xmlv.read_int(c.text())?
      "DefaultTTL" => out.default_ttl = xmlv.read_int(c.text())?
      "MaxTTL" => out.max_ttl = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

