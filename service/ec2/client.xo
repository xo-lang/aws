fn xml_write_account_vpc_encryption_control(var w: xmlv.Writer, v: AccountVpcEncryptionControl, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.mode {
    xmlv.elem(w, "mode", x.value(), [])
  }
  if let Some(x) = v.exclusions {
    xml_write_account_vpc_encryption_control_exclusions(w, x, "exclusions", [])
  }
  if let Some(x) = v.managed_by {
    xmlv.elem(w, "managedBy", x.value(), [])
  }
  if let Some(x) = v.last_update_timestamp {
    xmlv.elem(w, "lastUpdateTimestamp", rest.date_time(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_account_vpc_encryption_control(e: xml.Element) -> AccountVpcEncryptionControl ! Str {
  var out = AccountVpcEncryptionControl{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "state" => out.state = AccountVpcEncryptionControlState.from(c.text())
      "mode" => out.mode = AccountVpcEncryptionControlMode.from(c.text())
      "exclusions" => out.exclusions = xml_read_account_vpc_encryption_control_exclusions(c)?
      "managedBy" => out.managed_by = ManagedBy.from(c.text())
      "lastUpdateTimestamp" => out.last_update_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

