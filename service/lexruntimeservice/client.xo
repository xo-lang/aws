    Some(v) => v
    None => return Err("input member userId is required")
  }
  if label_user_id == "" {
    return Err("input member userId must not be empty")
  }
  if let Some(v) = input.accept {
    headers.push(("Accept", v))
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.session_attributes {
    fs.push(("sessionAttributes", json_of_string_map(x)))
