fn json_of_evaluation_answer_data(v: EvaluationAnswerData) -> json.Value {
  match v {
    StringValue(x) => json.Value.Object([("StringValue", json.Value.Str(x))])
    NumericValue(x) => json.Value.Object([("NumericValue", jsonv.float(x))])
    StringValues(x) => json.Value.Object([("StringValues", json_of_evaluation_answer_data_string_value_list(x))])
    DateTimeValue(x) => json.Value.Object([("DateTimeValue", json.Value.Str(x))])
    NotApplicable(x) => json.Value.Object([("NotApplicable", json.Value.Bool(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_evaluation_answer_data(v: json.Value) -> EvaluationAnswerData ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "StringValue" => Ok(EvaluationAnswerData.StringValue(jsonv.read_str(fv)?))
