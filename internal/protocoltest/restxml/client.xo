fn xml_write_http_request_with_labels_and_timestamp_format_input(var w: xmlv.Writer, v: HttpRequestWithLabelsAndTimestampFormatInput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.member_epoch_seconds {
    xmlv.elem(w, "memberEpochSeconds", rest.epoch_seconds(x), [])
  }
  if let Some(x) = v.member_http_date {
    xmlv.elem(w, "memberHttpDate", rest.http_date(x), [])
  }
  if let Some(x) = v.member_date_time {
    xmlv.elem(w, "memberDateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.default_format {
    xmlv.elem(w, "defaultFormat", rest.date_time(x), [])
  }
  if let Some(x) = v.target_epoch_seconds {
    xmlv.elem(w, "targetEpochSeconds", rest.epoch_seconds(x), [])
  }
  if let Some(x) = v.target_http_date {
    xmlv.elem(w, "targetHttpDate", rest.http_date(x), [])
  }
  if let Some(x) = v.target_date_time {
    xmlv.elem(w, "targetDateTime", rest.date_time(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_http_request_with_labels_and_timestamp_format_input(e: xml.Element) -> HttpRequestWithLabelsAndTimestampFormatInput ! Str {
  var out = HttpRequestWithLabelsAndTimestampFormatInput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "memberEpochSeconds" => out.member_epoch_seconds = (rest.parse_epoch_seconds(c.text().trim()) ?? return Err("bad timestamp"))
      "memberHttpDate" => out.member_http_date = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      "memberDateTime" => out.member_date_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "defaultFormat" => out.default_format = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "targetEpochSeconds" => out.target_epoch_seconds = (rest.parse_epoch_seconds(c.text().trim()) ?? return Err("bad timestamp"))
      "targetHttpDate" => out.target_http_date = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      "targetDateTime" => out.target_date_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_http_request_with_labels_input(var w: xmlv.Writer, v: HttpRequestWithLabelsInput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.string {
    xmlv.elem(w, "string", x, [])
  }
  if let Some(x) = v.short {
    xmlv.elem(w, "short", "${x}", [])
  }
  if let Some(x) = v.integer {
    xmlv.elem(w, "integer", "${x}", [])
  }
  if let Some(x) = v.long {
    xmlv.elem(w, "long", "${x}", [])
  }
  if let Some(x) = v.float {
    xmlv.elem(w, "float", rest.float_text(x), [])
  }
  if let Some(x) = v.double {
    xmlv.elem(w, "double", rest.float_text(x), [])
  }
  if let Some(x) = v.boolean {
    xmlv.elem(w, "boolean", "${x}", [])
  }
  if let Some(x) = v.timestamp {
    xmlv.elem(w, "timestamp", rest.date_time(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_http_request_with_labels_input(e: xml.Element) -> HttpRequestWithLabelsInput ! Str {
  var out = HttpRequestWithLabelsInput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "string" => out.string = c.text()
      "short" => out.short = xmlv.read_int(c.text())?
      "integer" => out.integer = xmlv.read_int(c.text())?
      "long" => out.long = xmlv.read_int(c.text())?
      "float" => out.float = xmlv.read_float(c.text())?
      "double" => out.double = xmlv.read_float(c.text())?
      "boolean" => out.boolean = xmlv.read_bool(c.text())?
      "timestamp" => out.timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

