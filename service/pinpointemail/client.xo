  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(CreateConfigurationSetErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_create_configuration_set_error(resp))
  }
  deserialize_create_configuration_set(resp) ?? e => Err(CreateConfigurationSetErr.Deserialize(e))
}

