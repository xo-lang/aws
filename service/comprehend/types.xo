  /// The time that training of the entity recognizer was completed.
  pub training_end_time: Time? = None
  /// The input data properties of an entity recognizer.
  pub input_data_config: EntityRecognizerInputDataConfig? = None
  /// Provides information about an entity recognizer.
  pub recognizer_metadata: EntityRecognizerMetadata? = None
  /// The Amazon Resource Name (ARN) of the IAM role that grants Amazon
  /// Comprehend read access to your input data.
  pub data_access_role_arn: Str? = None
  /// ID for the Amazon Web Services Key Management Service (KMS) key that
  /// Amazon Comprehend uses to encrypt data on the storage volume attached to
  /// the ML compute instance(s) that process the analysis job. The
  /// VolumeKmsKeyId can be either of the following formats: KMS Key ID:
  /// "1234abcd-12ab-34cd-56ef-1234567890ab" Amazon Resource Name (ARN) of a
  /// KMS Key:
  /// "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
  pub volume_kms_key_id: Str? = None
  /// Configuration parameters for a private Virtual Private Cloud (VPC)
  /// containing the resources you are using for your custom entity
  /// recognizer. For more information, see Amazon VPC .
  pub vpc_config: VpcConfig? = None
  /// ID for the KMS key that Amazon Comprehend uses to encrypt trained custom
  /// models. The ModelKmsKeyId can be either of the following formats: KMS
  /// Key ID: "1234abcd-12ab-34cd-56ef-1234567890ab" Amazon Resource Name
  /// (ARN) of a KMS Key:
  /// "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
  pub model_kms_key_id: Str? = None
  /// The version name you assigned to the entity recognizer.
  pub version_name: Str? = None
  /// The Amazon Resource Name (ARN) of the source model. This model was
  /// imported from a different Amazon Web Services account to create the
  /// entity recognizer model in your Amazon Web Services account.
  pub source_model_arn: Str? = None
  /// The Amazon Resource Number (ARN) of the flywheel
  pub flywheel_arn: Str? = None
  /// Output data configuration.
  pub output_data_config: EntityRecognizerOutputDataConfig? = None
}

