fn json_of_handshake(v: Handshake) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.parties {
    fs.push(("Parties", json_of_handshake_parties(x)))
  }
  if let Some(x) = v.state {
    fs.push(("State", json.Value.Str(x.value())))
  }
  if let Some(x) = v.requested_timestamp {
    fs.push(("RequestedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.expiration_timestamp {
    fs.push(("ExpirationTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.action {
    fs.push(("Action", json.Value.Str(x.value())))
  }
  if let Some(x) = v.resources {
    fs.push(("Resources", json_of_handshake_resources(x)))
  }
  json.Value.Object(fs)
}

fn from_json_handshake(v: json.Value) -> Handshake ! Str {
  var out = Handshake{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Id" => out.id = jsonv.read_str(fv)?
      "Arn" => out.arn = jsonv.read_str(fv)?
      "Parties" => out.parties = from_json_handshake_parties(fv)?
      "State" => out.state = HandshakeState.from(jsonv.read_str(fv)?)
      "RequestedTimestamp" => out.requested_timestamp = jsonv.read_time(fv, "epoch-seconds")?
