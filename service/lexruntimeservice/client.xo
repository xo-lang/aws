  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/bot/${rest.escape(label_bot_name, false)}/alias/${rest.escape(label_bot_alias, false)}/user/${rest.escape(label_user_id, false)}/session"),
    query: rest.query(qs),
