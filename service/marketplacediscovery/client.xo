    VariablePaymentTerm(x) => json.Value.Object([("variablePaymentTerm", json_of_variable_payment_term(x))])
    NetPaymentTerm(x) => json.Value.Object([("netPaymentTerm", json_of_net_payment_term(x))])
    Unknown(_) => json.Value.Object([])
