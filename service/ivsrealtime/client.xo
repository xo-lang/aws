fn json_of_event(v: Event) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.participant_id {
    fs.push(("participantId", json.Value.Str(x)))
  }
  if let Some(x) = v.event_time {
    fs.push(("eventTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.remote_participant_id {
    fs.push(("remoteParticipantId", json.Value.Str(x)))
  }
  if let Some(x) = v.error_code {
    fs.push(("errorCode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.destination_stage_arn {
    fs.push(("destinationStageArn", json.Value.Str(x)))
  }
  if let Some(x) = v.destination_session_id {
    fs.push(("destinationSessionId", json.Value.Str(x)))
  }
  if let Some(x) = v.replica {
    fs.push(("replica", json.Value.Bool(x)))
  }
  if let Some(x) = v.previous_token {
    fs.push(("previousToken", json_of_exchanged_participant_token(x)))
  }
  if let Some(x) = v.new_token {
    fs.push(("newToken", json_of_exchanged_participant_token(x)))
  }
  json.Value.Object(fs)
}

fn from_json_event(v: json.Value) -> Event ! Str {
  var out = Event{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "name" => out.name = jsonv.read_str(fv)?
      "participantId" => out.participant_id = jsonv.read_str(fv)?
      "eventTime" => out.event_time = jsonv.read_time(fv, "date-time")?
      "remoteParticipantId" => out.remote_participant_id = jsonv.read_str(fv)?
      "errorCode" => out.error_code = EventErrorCode.from(jsonv.read_str(fv)?)
      "destinationStageArn" => out.destination_stage_arn = jsonv.read_str(fv)?
      "destinationSessionId" => out.destination_session_id = jsonv.read_str(fv)?
      "replica" => out.replica = jsonv.read_bool(fv)?
      "previousToken" => out.previous_token = from_json_exchanged_participant_token(fv)?
      "newToken" => out.new_token = from_json_exchanged_participant_token(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_event_list(v: List[Event]) -> json.Value {
  json.Value.List(v.map(fn(x: Event) -> json.Value { json_of_event(x) }))
}

fn from_json_event_list(v: json.Value) -> List[Event] ! Str {
  var out: List[Event] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
