  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.1"))
  headers.push(("X-Amz-Target", "AWSHawksNestServiceFacade.BatchCreateVariable"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

