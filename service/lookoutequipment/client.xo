fn json_of_model_summary(v: ModelSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.model_name {
    fs.push(("ModelName", json.Value.Str(x)))
  }
  if let Some(x) = v.model_arn {
    fs.push(("ModelArn", json.Value.Str(x)))
  }
  if let Some(x) = v.dataset_name {
    fs.push(("DatasetName", json.Value.Str(x)))
  }
  if let Some(x) = v.dataset_arn {
    fs.push(("DatasetArn", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.active_model_version {
    fs.push(("ActiveModelVersion", json.Value.Int(x)))
  }
  if let Some(x) = v.active_model_version_arn {
    fs.push(("ActiveModelVersionArn", json.Value.Str(x)))
  }
  if let Some(x) = v.latest_scheduled_retraining_status {
    fs.push(("LatestScheduledRetrainingStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.latest_scheduled_retraining_model_version {
    fs.push(("LatestScheduledRetrainingModelVersion", json.Value.Int(x)))
  }
  if let Some(x) = v.latest_scheduled_retraining_start_time {
    fs.push(("LatestScheduledRetrainingStartTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.next_scheduled_retraining_start_date {
    fs.push(("NextScheduledRetrainingStartDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.retraining_scheduler_status {
    fs.push(("RetrainingSchedulerStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.model_diagnostics_output_configuration {
    fs.push(("ModelDiagnosticsOutputConfiguration", json_of_model_diagnostics_output_configuration(x)))
  }
  if let Some(x) = v.model_quality {
    fs.push(("ModelQuality", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_model_summary(v: json.Value) -> ModelSummary ! Str {
  var out = ModelSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ModelName" => out.model_name = jsonv.read_str(fv)?
      "ModelArn" => out.model_arn = jsonv.read_str(fv)?
      "DatasetName" => out.dataset_name = jsonv.read_str(fv)?
      "DatasetArn" => out.dataset_arn = jsonv.read_str(fv)?
      "Status" => out.status = ModelStatus.from(jsonv.read_str(fv)?)
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "ActiveModelVersion" => out.active_model_version = jsonv.read_int(fv)?
      "ActiveModelVersionArn" => out.active_model_version_arn = jsonv.read_str(fv)?
      "LatestScheduledRetrainingStatus" => out.latest_scheduled_retraining_status = ModelVersionStatus.from(jsonv.read_str(fv)?)
      "LatestScheduledRetrainingModelVersion" => out.latest_scheduled_retraining_model_version = jsonv.read_int(fv)?
      "LatestScheduledRetrainingStartTime" => out.latest_scheduled_retraining_start_time = jsonv.read_time(fv, "epoch-seconds")?
      "NextScheduledRetrainingStartDate" => out.next_scheduled_retraining_start_date = jsonv.read_time(fv, "epoch-seconds")?
      "RetrainingSchedulerStatus" => out.retraining_scheduler_status = RetrainingSchedulerStatus.from(jsonv.read_str(fv)?)
      "ModelDiagnosticsOutputConfiguration" => out.model_diagnostics_output_configuration = from_json_model_diagnostics_output_configuration(fv)?
      "ModelQuality" => out.model_quality = ModelQuality.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

