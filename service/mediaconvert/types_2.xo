  Expire = "EXPIRE"
  Unknown(value: Str)
}

/// Set to ENABLED to force a rendition to be included.
pub enum RequiredFlag: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// Details about the pricing plan for your reserved queue. Required for
/// reserved queues and not applicable to on-demand queues.
