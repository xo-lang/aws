  /// The name of the component as displayed. If DisplayName isn't specified,
  /// TrialComponentName is displayed.
  pub display_name: Str? = None
  /// The Amazon Resource Name (ARN) of the trial component.
  pub trial_component_arn: Str? = None
  /// The Amazon Resource Name (ARN) and job type of the source of the
  /// component.
  pub source: TrialComponentSource? = None
  pub status: TrialComponentStatus? = None
  /// When the component started.
  pub start_time: Time? = None
  /// When the component ended.
  pub end_time: Time? = None
  /// When the component was created.
  pub creation_time: Time? = None
  /// Who created the trial component.
