  deserialize_tag_resource(resp) ?? e => Err(TagResourceErr.Deserialize(e))
}

pub fn endpoint_params_untag_resource(base: EndpointParameters, input: UntagResourceRequest) -> EndpointParameters {
  let _ = input
  base
