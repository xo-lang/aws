fn jmes_of_resource(v: Resource) -> json.Value {
  match v {
    Arn(x) => json.Value.Object([("arn", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

/// Calls GetMemory until the MemoryCreated acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (2s) to `max_delay` (120s).
pub fn wait_until_memory_created(c: Client, input: GetMemoryInput, max_wait: Duration, min_delay: Duration = 2s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetMemoryErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).get_memory(input) {
      Ok(out) => {
        let o = jmes_of_get_memory_output(out)
        if state == "" && waiter.path_matches(o, "memory.status", "stringEquals", "CREATING") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "memory.status", "stringEquals", "ACTIVE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "memory.status", "stringEquals", "FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("MemoryCreated: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

