/// A channel is a named input source that training algorithms can consume.
pub struct Channel {
  /// The name of the channel.
  pub channel_name: Str? = None
  /// The location of the channel data.
  pub data_source: DataSource? = None
  /// The MIME type of the data.
  pub content_type: Str? = None
  /// If training data is compressed, the compression type. The default value
  /// is None . CompressionType is used only in Pipe input mode. In File mode,
  /// leave this field unset or set it to None.
  pub compression_type: CompressionType? = None
  /// Specify RecordIO as the value when input data is in raw format but the
  /// training algorithm requires the RecordIO format. In this case, SageMaker
  /// wraps each individual S3 object in a RecordIO record. If the input data
  /// is already in RecordIO format, you don't need to set this attribute. For
  /// more information, see Create a Dataset Using RecordIO . In File mode,
  /// leave this field unset or set it to None.
  pub record_wrapper_type: RecordWrapper? = None
  /// (Optional) The input mode to use for the data channel in a training job.
  /// If you don't set a value for InputMode , SageMaker uses the value set
  /// for TrainingInputMode . Use this parameter to override the
  /// TrainingInputMode setting in a AlgorithmSpecification request when you
  /// have a channel that needs a different input mode from the training job's
  /// general setting. To download the data from Amazon Simple Storage Service
  /// (Amazon S3) to the provisioned ML storage volume, and mount the
  /// directory to a Docker volume, use File input mode. To stream data
  /// directly from Amazon S3 to the container, choose Pipe input mode. To use
  /// a model for incremental training, choose File input model.
  pub input_mode: TrainingInputMode? = None
  /// A configuration for a shuffle option for input data in a channel. If you
  /// use S3Prefix for S3DataType , this shuffles the results of the S3 key
  /// prefix matches. If you use ManifestFile , the order of the S3 object
  /// references in the ManifestFile is shuffled. If you use
  /// AugmentedManifestFile , the order of the JSON lines in the
  /// AugmentedManifestFile is shuffled. The shuffling order is determined
  /// using the Seed value. For Pipe input mode, shuffling is done at the
  /// start of every epoch. With large datasets this ensures that the order of
  /// the training data is different for each epoch, it helps reduce bias and
  /// possible overfitting. In a multi-node training job when ShuffleConfig is
  /// combined with S3DataDistributionType of ShardedByS3Key , the data is
  /// shuffled across nodes so that the content sent to a particular node on
  /// the first epoch might be sent to a different node on the second epoch.
  pub shuffle_config: ShuffleConfig? = None
}

/// Defines a named input source, called a channel, to be used by an
/// algorithm.
pub struct ChannelSpecification {
  /// The name of the channel.
  pub name: Str? = None
  /// A brief description of the channel.
  pub description: Str? = None
  /// Indicates whether the channel is required by the algorithm.
  pub is_required: Bool? = None
  /// The supported MIME types for the data.
  pub supported_content_types: List[Str]? = None
  /// The allowed compression types, if data compression is used.
  pub supported_compression_types: List[CompressionType]? = None
  /// The allowed input mode, either FILE or PIPE. In FILE mode, Amazon
  /// SageMaker copies the data from the input source onto the local Amazon
  /// Elastic Block Store (Amazon EBS) volumes before starting your training
  /// algorithm. This is the most commonly used input mode. In PIPE mode,
  /// Amazon SageMaker streams input data from the source directly to your
  /// algorithm without using the EBS volume.
  pub supported_input_modes: List[TrainingInputMode]? = None
}

