/// Wait until a Policy is deleted
///
/// Calls GetPolicy until the PolicyDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (2s) to `max_delay` (120s).
pub fn wait_until_policy_deleted(c: Client, input: GetPolicyRequest, max_wait: Duration, min_delay: Duration = 2s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[GetPolicyErr] uses (net.dial, clock, rand) {
