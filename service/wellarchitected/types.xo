/// A single Well-Architected Agent preference and its current state.
pub struct PreferenceEntry {
  /// Which preference this entry describes.
  pub key: PreferenceKey? = None
  /// Current state of the preference. ENABLED and DISABLED reflect the result
  /// of the most recent successful change. FAILED reflects a stored failure
  /// surfaced on a read and is accompanied by a detail message.
  pub status: PreferenceStatus? = None
  /// A human-readable explanation present only when status is FAILED,
  /// describing what went wrong and how to recover.
  pub detail: Str? = None
}

/// Identifies one of the caller's Well-Architected Agent preferences. A new
/// preference is introduced as a new enum value, which is a
/// backward-compatible change. Existing values are never removed or
/// renamed.
pub enum PreferenceKey: Str {
  OrgIntegration = "ORG_INTEGRATION"
  Unknown(value: Str)
}

/// This is the writable subset of PreferenceStatus : you can set a
/// preference to ENABLED or DISABLED , but you cannot set FAILED , which is
/// an observed state only. The settable state of a preference, supplied to
/// PutAgentPreferences .
pub enum PreferenceState: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// The observed state of a preference. Because enabling and disabling are
/// performed synchronously by PutAgentPreferences , this value is both what
/// the caller requested and what the system achieved. FAILED is never an
/// accepted input; it reflects a stored failure (for example, an
/// onboarding-time auto-creation that failed) surfaced on a read, and is
/// accompanied by a statusMessage .
pub enum PreferenceStatus: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Failed = "FAILED"
  Unknown(value: Str)
}

/// A caller's requested change to one preference, supplied to
/// PutAgentPreferences.
pub struct PreferenceUpdate {
  /// Which preference to update.
  pub key: PreferenceKey? = None
  /// State to set the preference to. FAILED is an observed state only and
  /// cannot be requested.
  pub state: PreferenceState? = None
}

/// The priority of a recommendation.
