  /// Request-level deduplication settings, applied to every entry in the
  /// batch.
  pub deduplication_configuration: DeduplicationConfiguration? = None
}

/// A single event entry in a raw publish request.
pub struct PutRawEventsRequestEntry {
  /// The event data as a base64-encoded blob. Supports binary formats.
  pub data: Bytes? = None
  /// Metadata key-value pairs you define. Keys must be 1-128 characters and
  /// must not contain "/".
  pub metadata: Map[Str, Str]? = None
  /// Structured system metadata with defined properties.
  pub system_metadata: PutRawEventsSystemMetadata? = None
}

pub struct PutRawEventsResponse {
  /// The number of entries in the batch that failed to be published.
  pub failed_entry_count: Int? = None
  pub entries: List[PutRawEventsResultEntry]? = None
}

/// Result entry for a published event. The position of each entry in the
/// response list aligns 1:1 with the corresponding request entry, enabling
/// co-location by index.
pub struct PutRawEventsResultEntry {
  /// Unique event ID assigned by the service. Present on successful entries.
  pub event_id: Str? = None
  /// Sequence number for ordering within the event group.
  pub sequence_number: Str? = None
  /// Indicates how the entry was processed. Present only on successful
  /// entries.
  pub success_code: SuccessCode? = None
  /// Error code if the entry failed.
  pub error_code: Str? = None
  /// Error message if the entry failed.
  pub error_message: Str? = None
}

/// System metadata for PutRawEvents entries. ContentType is required
/// because PutRawEvents supports arbitrary binary formats.
pub struct PutRawEventsSystemMetadata {
  /// Content type of the event data (e.g., "application/cloudevents+json").
  pub content_type: Str? = None
  /// Deduplication ID for FIFO deduplication.
  pub deduplication_id: Str? = None
  /// Event group ID for FIFO ordering.
  pub event_group_id: Str? = None
}

pub struct PutResourcePolicyRequest {
  pub resource_arn: Str? = None
  pub policy_document: Str? = None
  /// Which named policy to write. Defaults to "default", the customer-managed
  /// policy, when omitted (a write AWS Resource Access Manager makes on the
  /// owner's behalf resolves to "AWS_RAM" instead). The two writers are
  /// exclusive in both directions — only Resource Access Manager can write
  /// "AWS_RAM", and only the bus owner can write "default" — so naming the
  /// other party's policy fails with AccessDeniedException. A well-formed
  /// name that is neither of the two fails with InvalidInputException.
  pub policy_name: Str? = None
  /// The write succeeds only if the named policy's current revision ID
  /// matches this value; a policy that does not exist yet matches only the
  /// sentinel "NO_POLICY" (create-only). On mismatch the operation fails with
  /// ConflictException. When omitted, the write is unconditional. Every
  /// attempt stores a newly generated revision ID, so retrying an unanswered
  /// request can conflict with the caller's own earlier attempt; read the
  /// policy back and compare it with the one you intended before treating a
  /// conflict as another writer's change.
  pub expected_revision_id: Str? = None
}

pub struct PutResourcePolicyResponse {
  pub resource_arn: Str? = None
  pub policy_name: Str? = None
  /// Absent when the write removed the policy; a removal produces no new
  /// revision.
  pub revision_id: Str? = None
}

/// A resource with the same name already exists.
pub struct ResourceAlreadyExistsException {
  pub message: Str? = None
}

/// The resource is in use and cannot be deleted. For example, an event bus
/// with subscribers or event sources cannot be deleted until they are
/// deleted.
pub struct ResourceInUseException {
  pub message: Str? = None
}

/// The resource does not exist.
pub struct ResourceNotFoundException {
  pub message: Str? = None
}

/// Summary of a policy attached to a resource: its name and revision ID.
pub struct ResourcePolicySummary {
  pub policy_name: Str? = None
  pub revision_id: Str? = None
}

/// Position from which delivery resumes when a subscriber is unpaused.
/// Honored only on an UpdateSubscriber call that transitions State from
/// STOPPED to RUNNING (unpause); ignored on any other call and not accepted
/// on Create. Defaults to LAST_PROCESSED when omitted.
pub enum ResumePosition: Str {
  LastProcessed = "LAST_PROCESSED"
  Latest = "LATEST"
  Unknown(value: Str)
}

/// Retry policy for a subscriber.
pub struct RetryPolicy {
  /// Maximum number of retry attempts (0-185, default: 5).
  pub max_retry_attempts: Int? = None
  /// Maximum age of an event in seconds before it is discarded (60-86400,
  /// default: 300).
  pub max_event_age_in_seconds: Int? = None
  /// Strategy for determining which exceptions are retried. Default: ALL.
  pub retry_strategy: RetryStrategy? = None
}

/// Retry strategy — determines which exceptions are retried.
pub enum RetryStrategy: Str {
  All = "ALL"
  Unknown(value: Str)
}

pub struct RevokeResourceRequest {
  pub arn: Str? = None
}

pub struct RevokeResourceResponse {
  pub arn: Str? = None
