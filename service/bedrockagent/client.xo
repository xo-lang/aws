      "malformedConditionExpression" => Ok(FlowValidationDetails.MalformedConditionExpression(from_json_malformed_condition_expression_flow_validation_details(fv)?))
      "malformedNodeInputExpression" => Ok(FlowValidationDetails.MalformedNodeInputExpression(from_json_malformed_node_input_expression_flow_validation_details(fv)?))
      "mismatchedNodeInputType" => Ok(FlowValidationDetails.MismatchedNodeInputType(from_json_mismatched_node_input_type_flow_validation_details(fv)?))
      "mismatchedNodeOutputType" => Ok(FlowValidationDetails.MismatchedNodeOutputType(from_json_mismatched_node_output_type_flow_validation_details(fv)?))
      "incompatibleConnectionDataType" => Ok(FlowValidationDetails.IncompatibleConnectionDataType(from_json_incompatible_connection_data_type_flow_validation_details(fv)?))
      "missingConnectionConfiguration" => Ok(FlowValidationDetails.MissingConnectionConfiguration(from_json_missing_connection_configuration_flow_validation_details(fv)?))
      "missingDefaultCondition" => Ok(FlowValidationDetails.MissingDefaultCondition(from_json_missing_default_condition_flow_validation_details(fv)?))
      "missingEndingNodes" => Ok(FlowValidationDetails.MissingEndingNodes(from_json_missing_ending_nodes_flow_validation_details(fv)?))
      "missingNodeConfiguration" => Ok(FlowValidationDetails.MissingNodeConfiguration(from_json_missing_node_configuration_flow_validation_details(fv)?))
      "missingNodeInput" => Ok(FlowValidationDetails.MissingNodeInput(from_json_missing_node_input_flow_validation_details(fv)?))
      "missingNodeOutput" => Ok(FlowValidationDetails.MissingNodeOutput(from_json_missing_node_output_flow_validation_details(fv)?))
      "missingStartingNodes" => Ok(FlowValidationDetails.MissingStartingNodes(from_json_missing_starting_nodes_flow_validation_details(fv)?))
      "multipleNodeInputConnections" => Ok(FlowValidationDetails.MultipleNodeInputConnections(from_json_multiple_node_input_connections_flow_validation_details(fv)?))
      "unfulfilledNodeInput" => Ok(FlowValidationDetails.UnfulfilledNodeInput(from_json_unfulfilled_node_input_flow_validation_details(fv)?))
      "unsatisfiedConnectionConditions" => Ok(FlowValidationDetails.UnsatisfiedConnectionConditions(from_json_unsatisfied_connection_conditions_flow_validation_details(fv)?))
      "unspecified" => Ok(FlowValidationDetails.Unspecified(from_json_unspecified_flow_validation_details(fv)?))
      "unknownNodeInput" => Ok(FlowValidationDetails.UnknownNodeInput(from_json_unknown_node_input_flow_validation_details(fv)?))
      "unknownNodeOutput" => Ok(FlowValidationDetails.UnknownNodeOutput(from_json_unknown_node_output_flow_validation_details(fv)?))
      "missingLoopInputNode" => Ok(FlowValidationDetails.MissingLoopInputNode(from_json_missing_loop_input_node_flow_validation_details(fv)?))
      "missingLoopControllerNode" => Ok(FlowValidationDetails.MissingLoopControllerNode(from_json_missing_loop_controller_node_flow_validation_details(fv)?))
      "multipleLoopInputNodes" => Ok(FlowValidationDetails.MultipleLoopInputNodes(from_json_multiple_loop_input_nodes_flow_validation_details(fv)?))
