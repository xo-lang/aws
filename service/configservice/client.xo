  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(AssociateResourceTypesErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_associate_resource_types_error(resp))
  }
  deserialize_associate_resource_types(resp) ?? e => Err(AssociateResourceTypesErr.Deserialize(e))
}

