      Err(msg) => return UpdateEventIntegrationErr.Deserialize(msg)
    }
    "InternalServiceError" => match read_error_internal_service_error(resp, body) {
      Ok(x) => return UpdateEventIntegrationErr.InternalServiceError(x)
      Err(msg) => return UpdateEventIntegrationErr.Deserialize(msg)
    }
    "InvalidRequestException" => match read_error_invalid_request_exception(resp, body) {
      Ok(x) => return UpdateEventIntegrationErr.InvalidRequestException(x)
      Err(msg) => return UpdateEventIntegrationErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateEventIntegrationErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateEventIntegrationErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateEventIntegrationErr.ThrottlingException(x)
      Err(msg) => return UpdateEventIntegrationErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateEventIntegrationErr.Api(restjson.api_error(resp, body))
}

/// Updates the description of an event integration.
pub fn (c: Client) update_event_integration(input: UpdateEventIntegrationRequest) -> UpdateEventIntegrationResponse ! UpdateEventIntegrationErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_event_integration(c.params, input)) ?? e => return Err(UpdateEventIntegrationErr.InvalidInput(e))
  var req = serialize_update_event_integration(ep, input, "") ?? e => return Err(UpdateEventIntegrationErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateEventIntegrationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_event_integration_error(resp))
  }
  deserialize_update_event_integration(resp) ?? e => Err(UpdateEventIntegrationErr.Deserialize(e))
}
