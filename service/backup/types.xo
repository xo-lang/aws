/// A legal hold is an administrative tool that helps prevent backups from
/// being deleted while under a hold. While the hold is in place, backups
/// under a hold cannot be deleted and lifecycle policies that would alter
/// the backup status (such as transition to cold storage) are delayed until
/// the legal hold is removed. A backup can have more than one legal hold.
/// Legal holds are applied to one or more backups (also known as recovery
/// points). These backups can be filtered by resource types and by resource
/// IDs.
pub struct LegalHold {
  /// The title of a legal hold.
  pub title: Str? = None
  /// The status of the legal hold.
  pub status: LegalHoldStatus? = None
  /// The description of a legal hold.
  pub description: Str? = None
  /// The ID of the legal hold.
  pub legal_hold_id: Str? = None
  /// The Amazon Resource Name (ARN) of the legal hold; for example,
  /// arn:aws:backup:us-east-1:123456789012:recovery-point:1EB3B5E7-9EB0-435A-A80B-108B488B0D45
  /// .
  pub legal_hold_arn: Str? = None
  /// The time when the legal hold was created.
  pub creation_date: Time? = None
  /// The time when the legal hold was cancelled.
  pub cancellation_date: Time? = None
}

pub enum LegalHoldStatus: Str {
  Creating = "CREATING"
  Active = "ACTIVE"
  Canceling = "CANCELING"
  Canceled = "CANCELED"
  Unknown(value: Str)
}

/// Specifies the time period, in days, before a recovery point transitions
/// to cold storage or is deleted. Backups transitioned to cold storage must
/// be stored in cold storage for a minimum of 90 days. Therefore, on the
/// console, the retention setting must be 90 days greater than the
/// transition to cold after days setting. The transition to cold after days
/// setting can't be changed after a backup has been transitioned to cold.
/// Resource types that can transition to cold storage are listed in the
/// Feature availability by resource table. Backup ignores this expression
/// for other resource types. To remove the existing lifecycle and retention
/// periods and keep your recovery points indefinitely, specify -1 for
/// MoveToColdStorageAfterDays and DeleteAfterDays .
pub struct Lifecycle {
  /// The number of days after creation that a recovery point is moved to cold
  /// storage.
  pub move_to_cold_storage_after_days: Int? = None
  /// The number of days after creation that a recovery point is deleted. This
  /// value must be at least 90 days after the number of days specified in
  /// MoveToColdStorageAfterDays .
  pub delete_after_days: Int? = None
  /// If the value is true, your backup plan transitions supported resources
  /// to archive (cold) storage tier in accordance with your lifecycle
  /// settings.
  pub opt_in_to_archive_for_supported_resources: Bool? = None
  /// The event after which a recovery point is deleted. A recovery point with
  /// both DeleteAfterDays and DeleteAfterEvent will delete after whichever
  /// condition is satisfied first. Not valid as an input.
  pub delete_after_event: LifecycleDeleteAfterEvent? = None
}

pub enum LifecycleDeleteAfterEvent: Str {
  DeleteAfterCopy = "DELETE_AFTER_COPY"
  Unknown(value: Str)
}

