fn json_of_portal_summary(v: PortalSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("id", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.start_url {
    fs.push(("startUrl", json.Value.Str(x)))
  }
  if let Some(x) = v.creation_date {
    fs.push(("creationDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_update_date {
    fs.push(("lastUpdateDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.role_arn {
    fs.push(("roleArn", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("status", json_of_portal_status(x)))
  }
  if let Some(x) = v.portal_type {
    fs.push(("portalType", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_portal_summary(v: json.Value) -> PortalSummary ! Str {
  var out = PortalSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "id" => out.id = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "startUrl" => out.start_url = jsonv.read_str(fv)?
      "creationDate" => out.creation_date = jsonv.read_time(fv, "epoch-seconds")?
      "lastUpdateDate" => out.last_update_date = jsonv.read_time(fv, "epoch-seconds")?
      "roleArn" => out.role_arn = jsonv.read_str(fv)?
      "status" => out.status = from_json_portal_status(fv)?
      "portalType" => out.portal_type = PortalType.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

