fn query_put_secondary_interface(var f: query.Form, prefix: Str, v: SecondaryInterface) {
  if let Some(x) = v.availability_zone {
    query.add(f, query.key(prefix, "AvailabilityZone"), x)
  }
  if let Some(x) = v.availability_zone_id {
    query.add(f, query.key(prefix, "AvailabilityZoneId"), x)
  }
  if let Some(x) = v.attachment {
    query_put_secondary_interface_attachment(f, query.key(prefix, "Attachment"), x)
  }
  if let Some(x) = v.mac_address {
    query.add(f, query.key(prefix, "MacAddress"), x)
  }
  if let Some(x) = v.owner_id {
    query.add(f, query.key(prefix, "OwnerId"), x)
  }
  if let Some(x) = v.private_ipv4_addresses {
    query_put_secondary_interface_ipv4_address_list(f, query.key(prefix, "PrivateIpv4AddressSet"), x, false)
  }
  if let Some(x) = v.secondary_interface_id {
    query.add(f, query.key(prefix, "SecondaryInterfaceId"), x)
  }
  if let Some(x) = v.secondary_interface_arn {
    query.add(f, query.key(prefix, "SecondaryInterfaceArn"), x)
  }
  if let Some(x) = v.secondary_interface_type {
    query.add(f, query.key(prefix, "SecondaryInterfaceType"), x.value())
  }
  if let Some(x) = v.secondary_subnet_id {
    query.add(f, query.key(prefix, "SecondarySubnetId"), x)
  }
  if let Some(x) = v.secondary_network_id {
    query.add(f, query.key(prefix, "SecondaryNetworkId"), x)
  }
  if let Some(x) = v.secondary_network_type {
    query.add(f, query.key(prefix, "SecondaryNetworkType"), x.value())
  }
  if let Some(x) = v.source_dest_check {
    query.add(f, query.key(prefix, "SourceDestCheck"), "${x}")
  }
  if let Some(x) = v.status {
    query.add(f, query.key(prefix, "Status"), x.value())
  }
  if let Some(x) = v.tags {
    query_put_tag_list(f, query.key(prefix, "TagSet"), x, false)
  }
}

fn query_put_secondary_interface_attachment(var f: query.Form, prefix: Str, v: SecondaryInterfaceAttachment) {
  if let Some(x) = v.attachment_id {
    query.add(f, query.key(prefix, "AttachmentId"), x)
  }
  if let Some(x) = v.attach_time {
    query.add(f, query.key(prefix, "AttachTime"), rest.date_time(x))
  }
  if let Some(x) = v.delete_on_termination {
    query.add(f, query.key(prefix, "DeleteOnTermination"), "${x}")
  }
  if let Some(x) = v.device_index {
    query.add(f, query.key(prefix, "DeviceIndex"), "${x}")
  }
  if let Some(x) = v.instance_id {
    query.add(f, query.key(prefix, "InstanceId"), x)
  }
  if let Some(x) = v.instance_owner_id {
    query.add(f, query.key(prefix, "InstanceOwnerId"), x)
  }
  if let Some(x) = v.network_card_index {
    query.add(f, query.key(prefix, "NetworkCardIndex"), "${x}")
  }
  if let Some(x) = v.status {
    query.add(f, query.key(prefix, "Status"), x.value())
  }
}

