  /// The number of instances that Amazon Web Services recommends that you
  /// purchase.
  pub number_of_instances_to_purchase: Str? = None
  /// The type of instance that Amazon Web Services recommends.
  pub instance_type: Str? = None
  /// Determines whether the recommendation is for a current generation
  /// instance.
  pub current_generation: Str? = None
  /// Determines whether the recommendation is size flexible.
  pub size_flex_eligible: Bool? = None
}

pub enum Order: Str {
  Asc = "Asc"
