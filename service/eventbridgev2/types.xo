  /// carry credentials or that describe the network path, and the header that
  /// carries the static token, can't be listed.
  pub metadata_http_headers: List[Str]? = None
  /// Optional. Deduplicates this EventSource's events on the event bus. Omit
  /// it to deduplicate nothing.
  pub deduplication_configuration: WebhookDeduplicationConfiguration? = None
  /// Optional. Controls the log records EventBridge delivers for this
  /// EventSource's webhook requests. Omit it to deliver no logs. Logs are
  /// delivered to the destinations you configure with Amazon CloudWatch Logs
  /// vended log delivery.
  pub log_configuration: LogConfiguration? = None
}

/// Hash algorithms supported for hash-based message authentication code
/// (HMAC) signatures.
pub enum WebhookHmacAlgorithm: Str {
  Sha256 = "SHA256"
  Sha1 = "SHA1"
  Unknown(value: Str)
}

/// The provider signs each request with a hash-based message authentication
/// code (HMAC) of the secret. Amazon EventBridge accepts the request if any
/// signature in SignatureHttpHeader matches.
pub struct WebhookHmacAuthConfiguration {
  /// The hash algorithm the provider uses to compute the signature.
  pub algorithm: WebhookHmacAlgorithm? = None
  /// How the provider encodes the signature in the header.
  pub encoding: WebhookHmacEncoding? = None
  /// The name of the header that carries the signature, for example
  /// X-Hub-Signature-256. When TimestampHttpHeader names the same header,
  /// Delimiter, SignaturePrefix and TimestampPrefix are all required.
  /// Reserved names are rejected, as described on
  /// StaticTokenAuthConfiguration's TokenHttpHeader.
  pub signature_http_header: Str? = None
  /// The text that precedes the signature in the header value, for example
  /// sha256=. Required when TimestampHttpHeader is the same header as
  /// SignatureHttpHeader.
  pub signature_prefix: Str? = None
  /// The separator between parts of the signature header value, for example a
  /// comma for a header value of t=1727816400,v1=&lt;signature&gt;, or a
  /// space when the header carries several signatures. Required when
  /// TimestampHttpHeader is the same header as SignatureHttpHeader.
  pub delimiter: Str? = None
  /// The name of the header that carries the request timestamp. Required when
  /// SignedMessageComposition is TIMESTAMP_DOT_BODY or
  /// MESSAGE_ID_DOT_TIMESTAMP_DOT_BODY, or when TimestampToleranceInSeconds
  /// is set. Not allowed when SignedMessageComposition is BODY, because BODY
  /// does not sign the timestamp. Reserved names are rejected, as described
  /// on StaticTokenAuthConfiguration's TokenHttpHeader.
  pub timestamp_http_header: Str? = None
  /// The text that precedes the timestamp in the header value, for example
  /// t=. Required when TimestampHttpHeader is the same header as
  /// SignatureHttpHeader.
  pub timestamp_prefix: Str? = None
  /// The maximum difference, in seconds, allowed between the request
  /// timestamp and the time EventBridge receives the request. Requests
  /// outside this window are rejected. The default is 300 seconds. Requires
  /// TimestampHttpHeader. Not allowed when SignedMessageComposition is BODY,
  /// because BODY does not sign the timestamp.
  pub timestamp_tolerance_in_seconds: Int? = None
  /// The name of the header that carries the message ID. Required when
  /// SignedMessageComposition is MESSAGE_ID_DOT_TIMESTAMP_DOT_BODY. Requests
  /// whose message ID contains a period (.) are rejected. Reserved names are
  /// rejected, as described on StaticTokenAuthConfiguration's
  /// TokenHttpHeader.
  pub message_id_http_header: Str? = None
  /// How the provider assembles the message it signs from the request. BODY -
  /// The request body alone. BODY provides no replay protection.
  /// TIMESTAMP_DOT_BODY - &lt;timestamp&gt;.&lt;body&gt;. Requires
  /// TimestampHttpHeader. MESSAGE_ID_DOT_TIMESTAMP_DOT_BODY -
  /// &lt;messageId&gt;.&lt;timestamp&gt;.&lt;body&gt;, as in the Standard
  /// Webhooks specification. Requires TimestampHttpHeader and
  /// MessageIdHttpHeader.
  pub signed_message_composition: WebhookSignedMessageComposition? = None
  /// The signing key shared with the provider. If you omit it, EventBridge
  /// generates one. EventBridge stores the key only in AWS Secrets Manager
  /// and never returns it, including from DescribeEventSource. The key must
  /// be 16 to 512 bytes; with BASE64 SecretEncoding, this is measured after
  /// decoding.
  pub secret_value: Str? = None
  /// How the secret is encoded. RAW uses the secret's characters as the
  /// signing key. BASE64 decodes the secret first, as providers that follow
  /// the Standard Webhooks specification require. The default is RAW.
  pub secret_encoding: WebhookSecretEncoding? = None
}

/// Encodings supported for HMAC signatures.
pub enum WebhookHmacEncoding: Str {
  Hex = "HEX"
  Base64 = "BASE64"
  Unknown(value: Str)
}

/// Encodings supported for an HMAC secret.
pub enum WebhookSecretEncoding: Str {
  Raw = "RAW"
  Base64 = "BASE64"
  Unknown(value: Str)
}

/// How the provider assembles the message it signs from the request. BODY -
/// The request body alone. BODY provides no replay protection.
/// TIMESTAMP_DOT_BODY - &lt;timestamp&gt;.&lt;body&gt;. Requires
/// TimestampHttpHeader. MESSAGE_ID_DOT_TIMESTAMP_DOT_BODY -
/// &lt;messageId&gt;.&lt;timestamp&gt;.&lt;body&gt;, as in the Standard
/// Webhooks specification. Requires TimestampHttpHeader and
/// MessageIdHttpHeader.
pub enum WebhookSignedMessageComposition: Str {
  Body = "BODY"
  TimestampDotBody = "TIMESTAMP_DOT_BODY"
  MessageIdDotTimestampDotBody = "MESSAGE_ID_DOT_TIMESTAMP_DOT_BODY"
  Unknown(value: Str)
}

/// The provider sends the secret as the value of an HTTP header.
pub struct WebhookStaticTokenAuthConfiguration {
  /// The name of the header that carries the secret, for example
  /// X-Webhook-Secret. Reserved names are rejected: the names EventBridge's
  /// edge writes, such as Host and the X-Forwarded-* family, and the
  /// hop-by-hop and framing names an HTTP intermediary may rewrite, such as
  /// Connection and Content-Length. Authorization is allowed.
  pub token_http_header: Str? = None
  /// The token the provider sends in the header. If you omit it, EventBridge
  /// generates one. EventBridge stores the token only in AWS Secrets Manager
  /// and never returns it, including from DescribeEventSource. EventBridge
  /// compares it against the entire header value, so a provider that sends
  /// Authorization: Bearer &lt;token&gt; needs SecretValue to include the
  /// "Bearer " prefix.
  pub secret_value: Str? = None
}
