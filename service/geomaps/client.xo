  let (ep, signing, extra) = c.route(endpoint_params_get_style_descriptor(c.params, input)) ?? e => return Err(GetStyleDescriptorErr.InvalidInput(e))
  var req = serialize_get_style_descriptor(ep, input, "") ?? e => return Err(GetStyleDescriptorErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(GetStyleDescriptorErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_get_style_descriptor_error(resp))
  }
  deserialize_get_style_descriptor(resp) ?? e => Err(GetStyleDescriptorErr.Deserialize(e))
}

pub fn endpoint_params_get_tile(base: EndpointParameters, input: GetTileRequest) -> EndpointParameters {
  let _ = input
  base
}

/// The HTTP request of GetTile.
pub fn serialize_get_tile(ep: rest.Endpoint, input: GetTileRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_tileset = match input.tileset {
    Some(v) => v
    None => return Err("input member Tileset is required")
  }
  if label_tileset == "" {
    return Err("input member Tileset must not be empty")
  }
  let label_z = match input.z {
    Some(v) => v
    None => return Err("input member Z is required")
  }
  if label_z == "" {
    return Err("input member Z must not be empty")
  }
  let label_x = match input.x {
    Some(v) => v
    None => return Err("input member X is required")
  }
  if label_x == "" {
    return Err("input member X must not be empty")
  }
  let label_y = match input.y {
    Some(v) => v
    None => return Err("input member Y is required")
  }
  if label_y == "" {
    return Err("input member Y must not be empty")
  }
  if let Some(xs) = input.additional_features {
    for x in xs {
      qs.push(("additional-features", x.value()))
    }
  }
  if let Some(v) = input.key {
    qs.push(("key", v))
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "GET",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/v2/tiles/${rest.escape(label_tileset, false)}/${rest.escape(label_z, false)}/${rest.escape(label_x, false)}/${rest.escape(label_y, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_get_tile(resp: http.Response) -> GetTileResponse ! Str {
  var out = GetTileResponse{}
  if let Some(hv) = resp.header("Content-Type") {
    out.content_type = hv
  }
  if let Some(hv) = resp.header("Cache-Control") {
    out.cache_control = hv
  }
  if let Some(hv) = resp.header("ETag") {
    out.e_tag = hv
  }
  if let Some(hv) = resp.header("x-amz-geo-pricing-bucket") {
    out.pricing_bucket = hv
  }
  if !resp.body.is_empty() {
    out.blob = resp.body
  }
  Ok(out)
}

/// The errors of GetTile.
pub enum GetTileErr {
  AccessDeniedException(e: AccessDeniedException)
  InternalServerException(e: InternalServerException)
  ResourceNotFoundException(e: ResourceNotFoundException)
  ThrottlingException(e: ThrottlingException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: GetTileErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_get_tile_error(resp: http.Response) -> GetTileErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return GetTileErr.AccessDeniedException(x)
      Err(msg) => return GetTileErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return GetTileErr.InternalServerException(x)
      Err(msg) => return GetTileErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return GetTileErr.ResourceNotFoundException(x)
      Err(msg) => return GetTileErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return GetTileErr.ThrottlingException(x)
      Err(msg) => return GetTileErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return GetTileErr.ValidationException(x)
      Err(msg) => return GetTileErr.Deserialize(msg)
    }
    _ => {}
  }
  GetTileErr.Api(restjson.api_error(resp, body))
}

/// GetTile returns a tile. Map tiles are used by clients to render a map.
/// They're addressed using a grid arrangement with an X coordinate, Y
/// coordinate, and Z (zoom) level. For more information, see Tiles in the
/// Amazon Location Service Developer Guide .
pub fn (c: Client) get_tile(input: GetTileRequest) -> GetTileResponse ! GetTileErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_get_tile(c.params, input)) ?? e => return Err(GetTileErr.InvalidInput(e))
  var req = serialize_get_tile(ep, input, "") ?? e => return Err(GetTileErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(GetTileErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_get_tile_error(resp))
  }
  deserialize_get_tile(resp) ?? e => Err(GetTileErr.Deserialize(e))
}
