  if let Some(x) = v.origin_ssl_protocols {
    xml_write_origin_ssl_protocols(w, x, "OriginSslProtocols", [])
  }
  if let Some(x) = v.ip_address_type {
    xmlv.elem(w, "IpAddressType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpc_origin_endpoint_config(e: xml.Element) -> VpcOriginEndpointConfig ! Str {
  var out = VpcOriginEndpointConfig{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Name" => out.name = c.text()
      "Arn" => out.arn = c.text()
      "HTTPPort" => out.http_port = xmlv.read_int(c.text())?
      "HTTPSPort" => out.https_port = xmlv.read_int(c.text())?
      "OriginProtocolPolicy" => out.origin_protocol_policy = OriginProtocolPolicy.from(c.text())
      "OriginSslProtocols" => out.origin_ssl_protocols = xml_read_origin_ssl_protocols(c)?
      "IpAddressType" => out.ip_address_type = VpcIpAddressType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_vpc_origin_list(var w: xmlv.Writer, v: VpcOriginList, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.marker {
    xmlv.elem(w, "Marker", x, [])
  }
  if let Some(x) = v.next_marker {
    xmlv.elem(w, "NextMarker", x, [])
  }
  if let Some(x) = v.max_items {
    xmlv.elem(w, "MaxItems", "${x}", [])
  }
  if let Some(x) = v.is_truncated {
    xmlv.elem(w, "IsTruncated", "${x}", [])
  }
  if let Some(x) = v.quantity {
    xmlv.elem(w, "Quantity", "${x}", [])
  }
  if let Some(x) = v.items {
    xml_write_vpc_origin_summary_list(w, x, "Items", [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpc_origin_list(e: xml.Element) -> VpcOriginList ! Str {
  var out = VpcOriginList{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Marker" => out.marker = c.text()
      "NextMarker" => out.next_marker = c.text()
      "MaxItems" => out.max_items = xmlv.read_int(c.text())?
      "IsTruncated" => out.is_truncated = xmlv.read_bool(c.text())?
      "Quantity" => out.quantity = xmlv.read_int(c.text())?
      "Items" => out.items = xml_read_vpc_origin_summary_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_vpc_origin_summary(var w: xmlv.Writer, v: VpcOriginSummary, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.id {
    xmlv.elem(w, "Id", x, [])
  }
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.created_time {
    xmlv.elem(w, "CreatedTime", rest.date_time(x), [])
  }
  if let Some(x) = v.last_modified_time {
    xmlv.elem(w, "LastModifiedTime", rest.date_time(x), [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "Arn", x, [])
  }
  if let Some(x) = v.account_id {
    xmlv.elem(w, "AccountId", x, [])
  }
  if let Some(x) = v.origin_endpoint_arn {
    xmlv.elem(w, "OriginEndpointArn", x, [])
  }
  if let Some(x) = v.ip_address_type {
    xmlv.elem(w, "IpAddressType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpc_origin_summary(e: xml.Element) -> VpcOriginSummary ! Str {
  var out = VpcOriginSummary{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Id" => out.id = c.text()
      "Name" => out.name = c.text()
      "Status" => out.status = c.text()
      "CreatedTime" => out.created_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "LastModifiedTime" => out.last_modified_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Arn" => out.arn = c.text()
      "AccountId" => out.account_id = c.text()
      "OriginEndpointArn" => out.origin_endpoint_arn = c.text()
      "IpAddressType" => out.ip_address_type = VpcIpAddressType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_vpc_origin_summary_list(var w: xmlv.Writer, v: List[VpcOriginSummary], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_vpc_origin_summary(w, item, "VpcOriginSummary", [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpc_origin_summary_list(e: xml.Element) -> List[VpcOriginSummary] ! Str {
  var out: List[VpcOriginSummary] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_vpc_origin_summary(c)?)
  }
  Ok(out)
}

fn xml_write_web_acl_customization(var w: xmlv.Writer, v: WebAclCustomization, name: Str, ns: List[(Str, Str)]) {
