/// Why reading a AgentOutputMessageStream stream stopped.
pub enum AgentOutputMessageStreamErr {
  /// An error message, or an exception the model does not list.
  Api(e: aws.ApiError)
  /// The body could not be read or is not event stream messages.
  Read(msg: Str)
}

pub fn (e: AgentOutputMessageStreamErr) display() -> Str {
  match e {
    Api(x) => x.display()
    Read(msg) => "event stream: ${msg}"
