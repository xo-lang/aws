/// This entity represents an instance group, which is a group of instances
/// that have common purpose. For example, CORE instance group is used for
/// HDFS.
pub struct InstanceGroup {
  /// The identifier of the instance group.
  pub id: Str? = None
  /// The name of the instance group.
  pub name: Str? = None
  /// The marketplace to provision instances for this group. Valid values are
  /// ON_DEMAND or SPOT.
  pub market: MarketType? = None
  /// The type of the instance group. Valid values are MASTER, CORE or TASK.
  pub instance_group_type: InstanceGroupType? = None
  /// The bid price for each Amazon EC2 Spot Instance type as defined by
  /// InstanceType . Expressed in USD. If neither BidPrice nor
  /// BidPriceAsPercentageOfOnDemandPrice is provided,
  /// BidPriceAsPercentageOfOnDemandPrice defaults to 100%.
  pub bid_price: Str? = None
  /// The Amazon EC2 instance type for all instances in the instance group.
  pub instance_type: Str? = None
  /// The target number of instances for the instance group.
  pub requested_instance_count: Int? = None
  /// The number of instances currently running in this instance group.
  pub running_instance_count: Int? = None
  /// The current status of the instance group.
  pub status: InstanceGroupStatus? = None
  /// Amazon EMR releases 4.x or later. The list of configurations supplied
  /// for an Amazon EMR cluster instance group. You can specify a separate
  /// configuration for each instance group (master, core, and task).
  pub configurations: List[Configuration]? = None
  /// The version number of the requested configuration specification for this
  /// instance group.
  pub configurations_version: Int? = None
  /// A list of configurations that were successfully applied for an instance
  /// group last time.
  pub last_successfully_applied_configurations: List[Configuration]? = None
  /// The version number of a configuration specification that was
  /// successfully applied for an instance group last time.
  pub last_successfully_applied_configurations_version: Int? = None
  /// The EBS block devices that are mapped to this instance group.
  pub ebs_block_devices: List[EbsBlockDevice]? = None
  /// If the instance group is EBS-optimized. An Amazon EBS-optimized instance
  /// uses an optimized configuration stack and provides additional, dedicated
  /// capacity for Amazon EBS I/O.
  pub ebs_optimized: Bool? = None
  /// Policy for customizing shrink operations.
  pub shrink_policy: ShrinkPolicy? = None
  /// An automatic scaling policy for a core instance group or task instance
  /// group in an Amazon EMR cluster. The automatic scaling policy defines how
  /// an instance group dynamically adds and terminates Amazon EC2 instances
  /// in response to the value of a CloudWatch metric. See
  /// PutAutoScalingPolicy.
  pub auto_scaling_policy: AutoScalingPolicyDescription? = None
  /// The custom AMI ID to use for the provisioned instance group.
  pub custom_ami_id: Str? = None
}

