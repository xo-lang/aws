pub fn wait_until_tasks_running(c: Client, input: DescribeTasksRequest, max_wait: Duration, min_delay: Duration = 6s, max_delay: Duration = 600s) -> () ! waiter.WaitErr[DescribeTasksErr] uses (net.dial, clock, rand) {
