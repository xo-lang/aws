  /// bot.
  pub phrase: Str? = None
}

/// You can provide Amazon Lex V2 with hints to the phrases that a customer
/// is likely to use for a slot. When a slot with hints is resolved, the
/// phrases in the runtime hints are preferred in the resolution. You can
/// provide hints for a maximum of 100 intents. You can provide a maximum of
