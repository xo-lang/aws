      "afterInvocation" => Ok(HarnessHook.AfterInvocation(from_json_harness_after_invocation_hook(fv)?))
      "beforeToolCall" => Ok(HarnessHook.BeforeToolCall(from_json_harness_before_tool_call_hook(fv)?))
      "afterToolCall" => Ok(HarnessHook.AfterToolCall(from_json_harness_after_tool_call_hook(fv)?))
      _ => Ok(HarnessHook.Unknown(k))
    }
  }
  Err("HarnessHook: no member set")
}

fn json_of_harness_hook_event_bridge_target(v: HarnessHookEventBridgeTarget) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("arn", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_harness_hook_event_bridge_target(v: json.Value) -> HarnessHookEventBridgeTarget ! Str {
  var out = HarnessHookEventBridgeTarget{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
