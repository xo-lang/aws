}

fn from_json_step_input(v: json.Value) -> StepInput ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "integerValue" => Ok(StepInput.IntegerValue(jsonv.read_int(fv)?))
      "stringValue" => Ok(StepInput.StringValue(jsonv.read_str(fv)?))
      "listOfStringsValue" => Ok(StepInput.ListOfStringsValue(from_json_string_list(fv)?))
      "mapOfStringValue" => Ok(StepInput.MapOfStringValue(from_json_string_map(fv)?))
      _ => Ok(StepInput.Unknown(k))
    }
  }
  Err("StepInput: no member set")
}

