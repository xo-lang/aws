fn json_of_deployment_state(v: DeploymentState) -> json.Value {
  match v {
    ServiceInstance(x) => json.Value.Object([("serviceInstance", json_of_service_instance_state(x))])
    Environment(x) => json.Value.Object([("environment", json_of_environment_state(x))])
    ServicePipeline(x) => json.Value.Object([("servicePipeline", json_of_service_pipeline_state(x))])
    Component(x) => json.Value.Object([("component", json_of_component_state(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_deployment_state(v: json.Value) -> DeploymentState ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "serviceInstance" => Ok(DeploymentState.ServiceInstance(from_json_service_instance_state(fv)?))
      "environment" => Ok(DeploymentState.Environment(from_json_environment_state(fv)?))
      "servicePipeline" => Ok(DeploymentState.ServicePipeline(from_json_service_pipeline_state(fv)?))
      "component" => Ok(DeploymentState.Component(from_json_component_state(fv)?))
      _ => Ok(DeploymentState.Unknown(k))
    }
  }
  Err("DeploymentState: no member set")
}

