fn from_json_autonomous_database_summary(v: json.Value) -> AutonomousDatabaseSummary ! Str {
  var out = AutonomousDatabaseSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "autonomousDatabaseId" => out.autonomous_database_id = jsonv.read_str(fv)?
      "autonomousDatabaseArn" => out.autonomous_database_arn = jsonv.read_str(fv)?
      "ociResourceAnchorName" => out.oci_resource_anchor_name = jsonv.read_str(fv)?
      "percentProgress" => out.percent_progress = jsonv.read_float(fv)?
      "ocid" => out.ocid = jsonv.read_str(fv)?
      "ociUrl" => out.oci_url = jsonv.read_str(fv)?
      "displayName" => out.display_name = jsonv.read_str(fv)?
      "dbName" => out.db_name = jsonv.read_str(fv)?
      "sourceId" => out.source_id = jsonv.read_str(fv)?
      "status" => out.status = AutonomousDatabaseResourceStatus.from(jsonv.read_str(fv)?)
      "statusReason" => out.status_reason = jsonv.read_str(fv)?
      "databaseType" => out.database_type = DatabaseType.from(jsonv.read_str(fv)?)
      "dbVersion" => out.db_version = jsonv.read_str(fv)?
      "dbWorkload" => out.db_workload = DbWorkload.from(jsonv.read_str(fv)?)
      "characterSet" => out.character_set = jsonv.read_str(fv)?
      "ncharacterSet" => out.ncharacter_set = jsonv.read_str(fv)?
      "databaseEdition" => out.database_edition = DatabaseEdition.from(jsonv.read_str(fv)?)
      "licenseModel" => out.license_model = LicenseModel.from(jsonv.read_str(fv)?)
      "openMode" => out.open_mode = OpenMode.from(jsonv.read_str(fv)?)
      "permissionLevel" => out.permission_level = PermissionLevel.from(jsonv.read_str(fv)?)
      "isMtlsConnectionRequired" => out.is_mtls_connection_required = jsonv.read_bool(fv)?
      "autonomousMaintenanceScheduleType" => out.autonomous_maintenance_schedule_type = AutonomousMaintenanceScheduleType.from(jsonv.read_str(fv)?)
      "netServicesArchitecture" => out.net_services_architecture = NetServicesArchitecture.from(jsonv.read_str(fv)?)
      "availableUpgradeVersions" => out.available_upgrade_versions = from_json_string_list(fv)?
      "byolComputeCountLimit" => out.byol_compute_count_limit = jsonv.read_int(fv)?
      "connectionStringDetails" => out.connection_string_details = from_json_autonomous_database_connection_strings(fv)?
      "serviceConsoleUrl" => out.service_console_url = jsonv.read_str(fv)?
      "sqlWebDeveloperUrl" => out.sql_web_developer_url = jsonv.read_str(fv)?
      "customerContacts" => out.customer_contacts = from_json_customer_contacts(fv)?
      "apexDetails" => out.apex_details = from_json_autonomous_database_apex(fv)?
      "standbyDb" => out.standby_db = from_json_database_standby_summary(fv)?
      "localStandbyDb" => out.local_standby_db = from_json_database_standby_summary(fv)?
      "dataSafeStatus" => out.data_safe_status = DataSafeStatus.from(jsonv.read_str(fv)?)
      "databaseManagementStatus" => out.database_management_status = DatabaseManagementStatus.from(jsonv.read_str(fv)?)
      "operationsInsightsStatus" => out.operations_insights_status = OperationsInsightsStatus.from(jsonv.read_str(fv)?)
      "availabilityZone" => out.availability_zone = jsonv.read_str(fv)?
      "availabilityZoneId" => out.availability_zone_id = jsonv.read_str(fv)?
      "maintenanceTargetComponent" => out.maintenance_target_component = jsonv.read_str(fv)?
      "connectionUrls" => out.connection_urls = from_json_autonomous_database_connection_urls(fv)?
      "dbToolsDetails" => out.db_tools_details = from_json_database_tool_list(fv)?
      "scheduledOperations" => out.scheduled_operations = from_json_scheduled_operation_details_list(fv)?
      "resourcePoolLeaderId" => out.resource_pool_leader_id = jsonv.read_str(fv)?
      "computeCount" => out.compute_count = jsonv.read_float(fv)?
      "computeModel" => out.compute_model = ComputeModel.from(jsonv.read_str(fv)?)
      "cpuCoreCount" => out.cpu_core_count = jsonv.read_int(fv)?
      "memoryPerOracleComputeUnitInGBs" => out.memory_per_oracle_compute_unit_in_gbs = jsonv.read_int(fv)?
