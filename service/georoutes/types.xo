  /// Offset in the leg geometry corresponding to the start of this span.
  pub geometry_offset: Int? = None
  /// Incidents corresponding to the span. These index into the Incidents in
  /// the parent Leg.
  pub incidents: List[Int]? = None
  /// Provides an array of names of the vehicle span in available languages.
  pub names: List[LocalizedString]? = None
  /// Notices are additional information returned that indicate issues that
  /// occurred during route calculation.
  pub notices: List[Int]? = None
  /// Attributes corresponding to a railway crossing. The gate is present at
  /// the end of the returned span.
  pub railway_crossing: RouteSpanRailwayCrossingAttribute? = None
  /// 2-3 letter Region code corresponding to the Span. This is either a
  /// province or a state.
  pub region: Str? = None
  /// Attributes for the road segment corresponding to the span.
  pub road_attributes: List[RouteSpanRoadAttribute]? = None
  /// Designated route name or number corresponding to the span.
  pub route_numbers: List[RouteNumber]? = None
  /// Access attributes for a scooter corresponding to the span.
  pub scooter_access: List[RouteSpanScooterAccessAttribute]? = None
  /// Speed limit details corresponding to the span. Unit : kilometers per
  /// hour
  pub speed_limit: RouteSpanSpeedLimitDetails? = None
  /// Toll systems are authorities that collect payments for the toll.
  pub toll_systems: List[Int]? = None
  /// Access attributes for a truck corresponding to the span.
  pub truck_access: List[RouteSpanTruckAccessAttribute]? = None
  /// Truck road type identifiers. BK1 through BK4 apply only to Sweden.
  /// A2,A4,B2,B4,C,D,ET2,ET4 apply only to Mexico. There are currently no
  /// other supported values as of 26th April 2024.
  pub truck_road_types: List[Int]? = None
  /// Duration of the computed span under typical traffic congestion. Unit :
  /// seconds
  pub typical_duration: Int? = None
  /// Zones corresponding to this leg of the route.
  pub zones: List[Int]? = None
}

