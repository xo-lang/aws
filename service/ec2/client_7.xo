  }
  if let Some(x) = v.availability_zones {
    xml_write_value_string_list(w, x, "availabilityZoneSet", [])
  }
  if let Some(x) = v.acceptance_required {
    xmlv.elem(w, "acceptanceRequired", "${x}", [])
  }
  if let Some(x) = v.manages_vpc_endpoints {
    xmlv.elem(w, "managesVpcEndpoints", "${x}", [])
  }
  if let Some(x) = v.network_load_balancer_arns {
    xml_write_value_string_list(w, x, "networkLoadBalancerArnSet", [])
  }
  if let Some(x) = v.gateway_load_balancer_arns {
    xml_write_value_string_list(w, x, "gatewayLoadBalancerArnSet", [])
  }
  if let Some(x) = v.supported_ip_address_types {
    xml_write_supported_ip_address_types(w, x, "supportedIpAddressTypeSet", [])
  }
  if let Some(x) = v.base_endpoint_dns_names {
    xml_write_value_string_list(w, x, "baseEndpointDnsNameSet", [])
  }
  if let Some(x) = v.private_dns_name {
    xmlv.elem(w, "privateDnsName", x, [])
  }
  if let Some(x) = v.private_dns_name_configuration {
    xml_write_private_dns_name_configuration(w, x, "privateDnsNameConfiguration", [])
  }
  if let Some(x) = v.payer_responsibility {
    xmlv.elem(w, "payerResponsibility", x.value(), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.supported_regions {
    xml_write_supported_region_set(w, x, "supportedRegionSet", [])
  }
  if let Some(x) = v.remote_access_enabled {
    xmlv.elem(w, "remoteAccessEnabled", "${x}", [])
