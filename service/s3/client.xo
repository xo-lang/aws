  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_metadata_entry(w, item, "MetadataEntry", [])
  }
  xmlv.end(w, name)
}

fn xml_read_user_metadata(e: xml.Element) -> List[MetadataEntry] ! Str {
  var out: List[MetadataEntry] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_metadata_entry(c)?)
  }
  Ok(out)
}

