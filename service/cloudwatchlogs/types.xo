  /// The maximum numeric value allowed for the configuration. This applies
  /// only when the valueType is a numeric type.
  pub max_value: Float? = None
}

pub enum DeliverySourceConfigurationSchemaValueType: Str {
  String = "string"
  Boolean = "boolean"
  Int = "int"
  Double = "double"
  Long = "long"
  Unknown(value: Str)
}

