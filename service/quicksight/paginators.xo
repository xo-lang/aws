/// the previous page's NextToken as its
/// NextToken.
pub struct SearchDataSetsPaginator {
  client: Client
  input: SearchDataSetsRequest
  first: Bool = true
  more: Bool = true
}

pub fn new_search_data_sets_paginator(c: Client, input: SearchDataSetsRequest) -> SearchDataSetsPaginator {
  SearchDataSetsPaginator{client: c, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: SearchDataSetsPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: SearchDataSetsPaginator) next_page() -> SearchDataSetsResponse ! SearchDataSetsErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.search_data_sets(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}

