  /// value for this parameter in an update-server call. For example:
  /// update-server --server-id s-1234567890abcdef0
  /// --structured-log-destinations
  pub structured_log_destinations: List[Str]? = None
  /// Specifies whether or not performance for your Amazon S3 directories is
  /// optimized. If using the console, this is enabled by default. If using
  /// the API or CLI, this is disabled by default. By default, home directory
  /// mappings have a TYPE of DIRECTORY . If you enable this option, you would
  /// then need to explicitly set the HomeDirectoryMapEntry Type to FILE if
  /// you want a mapping to have a file target.
  pub s3_storage_options: S3StorageOptions? = None
  /// Specifies whether to use IPv4 only, or to use dual-stack (IPv4 and IPv6)
  /// for your Transfer Family endpoint. The default value is IPV4 . The
  /// IpAddressType parameter has the following limitations: It cannot be
  /// changed while the server is online. You must stop the server before
  /// modifying this parameter. It cannot be updated to DUALSTACK if the
  /// server has AddressAllocationIds specified. When using DUALSTACK as the
  /// IpAddressType , you cannot set the AddressAllocationIds parameter for
  /// the EndpointDetails for the server.
  pub ip_address_type: IpAddressType? = None
  /// The mode of authentication for a server. The default value is
  /// SERVICE_MANAGED , which allows you to store and access user credentials
  /// within the Transfer Family service. Use AWS_DIRECTORY_SERVICE to provide
