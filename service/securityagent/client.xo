fn json_of_diff_source(v: DiffSource) -> json.Value {
  match v {
    S3Uri(x) => json.Value.Object([("s3Uri", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_diff_source(v: json.Value) -> DiffSource ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "s3Uri" => Ok(DiffSource.S3Uri(jsonv.read_str(fv)?))
      _ => Ok(DiffSource.Unknown(k))
    }
  }
  Err("DiffSource: no member set")
}

