      "Notes" => out.notes = from_json_evaluation_notes_map(fv)?
      "Status" => out.status = EvaluationStatus.from(jsonv.read_str(fv)?)
      "Scores" => out.scores = from_json_evaluation_scores_map(fv)?
      "CreatedTime" => out.created_time = jsonv.read_time(fv, "epoch-seconds")?
      "LastModifiedTime" => out.last_modified_time = jsonv.read_time(fv, "epoch-seconds")?
      "EvaluationType" => out.evaluation_type = EvaluationType.from(jsonv.read_str(fv)?)
      "Tags" => out.tags = from_json_tag_map(fv)?
      _ => {}
    }
  }
  Ok(out)
}

