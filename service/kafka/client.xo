  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_cluster_arn = match input.cluster_arn {
    Some(v) => v
    None => return Err("input member ClusterArn is required")
  }
  if label_cluster_arn == "" {
    return Err("input member ClusterArn must not be empty")
  }
  if let Some(v) = input.max_results {
    qs.push(("maxResults", "${v}"))
  }
  if let Some(v) = input.next_token {
    qs.push(("nextToken", v))
  }
  if let Some(v) = input.topic_name_filter {
    qs.push(("topicNameFilter", v))
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "GET",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/v1/clusters/${rest.escape(label_cluster_arn, false)}/channels"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}