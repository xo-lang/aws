fn json_of_managed_source_configuration(v: ManagedSourceConfiguration) -> json.Value {
  match v {
    WebCrawlerConfiguration(x) => json.Value.Object([("webCrawlerConfiguration", json_of_web_crawler_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_managed_source_configuration(v: json.Value) -> ManagedSourceConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "webCrawlerConfiguration" => Ok(ManagedSourceConfiguration.WebCrawlerConfiguration(from_json_web_crawler_configuration(fv)?))
      _ => Ok(ManagedSourceConfiguration.Unknown(k))
    }
  }
