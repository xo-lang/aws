    fs.push(("StartTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.max_expiration_time {
    fs.push(("MaxExpirationTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.authentication_type {
    fs.push(("AuthenticationType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.network_access_configuration {
    fs.push(("NetworkAccessConfiguration", json_of_network_access_configuration(x)))
  }
  if let Some(x) = v.instance_id {
    fs.push(("InstanceId", json.Value.Str(x)))
  }
  if let Some(x) = v.instance_drain_status {
    fs.push(("InstanceDrainStatus", json.Value.Str(x.value())))
