  first: Bool = true
  more: Bool = true
}

pub fn new_describe_tenant_databases_paginator(c: Client, input: DescribeTenantDatabasesMessage) -> DescribeTenantDatabasesPaginator {
  DescribeTenantDatabasesPaginator{client: c, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: DescribeTenantDatabasesPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: DescribeTenantDatabasesPaginator) next_page() -> TenantDatabasesMessage ! DescribeTenantDatabasesErr uses (net.dial, clock, rand) {
  let prev = p.input.marker
  let out = p.client.describe_tenant_databases(p.input)?
  p.first = false
  var next: Str? = None
  next = out.marker
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.marker = next
  Ok(out)
}

/// The pages of DownloadDBLogFilePortion. Each `next_page` sends the input with
/// the previous page's Marker as its
/// Marker.
pub struct DownloadDBLogFilePortionPaginator {
  client: Client
  input: DownloadDBLogFilePortionMessage
  first: Bool = true
  more: Bool = true
}

pub fn new_download_db_log_file_portion_paginator(c: Client, input: DownloadDBLogFilePortionMessage) -> DownloadDBLogFilePortionPaginator {
