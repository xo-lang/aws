}

pub struct UpdateShardCountInput {
  /// The name of the stream.
  pub stream_name: Str? = None
  /// The new number of shards. This value has the following default limits.
  /// By default, you cannot do the following: Set this value to more than
  /// double your current shard count for a stream. Set this value below half
  /// your current shard count for a stream. Set this value to more than 10000
  /// shards in a stream (the default limit for shard count per stream is
  /// 10000 per account per region), unless you request a limit increase.
  /// Scale a stream with more than 10000 shards down unless you set this
  /// value to less than 10000 shards.
  pub target_shard_count: Int? = None
  /// The scaling type. Uniform scaling creates shards of equal size.
  pub scaling_type: ScalingType? = None
  /// The ARN of the stream.
  pub stream_arn: Str? = None
  /// Not Implemented. Reserved for future use.
  pub stream_id: Str? = None
}

pub struct UpdateShardCountOutput {
