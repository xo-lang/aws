/// Calls DescribeDBClusterSnapshots until the DBClusterSnapshotAvailable acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (1800s).
pub fn wait_until_db_cluster_snapshot_available(c: Client, input: DescribeDBClusterSnapshotsMessage, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 1800s) -> () ! waiter.WaitErr[DescribeDBClusterSnapshotsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_db_cluster_snapshots(input) {
      Ok(out) => {
        let o = jmes_of_db_cluster_snapshot_message(out)
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "allStringEquals", "available") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "deleted") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "deleting") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "failed") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "incompatible-restore") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "incompatible-parameters") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("DBClusterSnapshotAvailable: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeDBClusterSnapshots until the DBClusterSnapshotDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (1800s).
pub fn wait_until_db_cluster_snapshot_deleted(c: Client, input: DescribeDBClusterSnapshotsMessage, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 1800s) -> () ! waiter.WaitErr[DescribeDBClusterSnapshotsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_db_cluster_snapshots(input) {
      Ok(out) => {
        let o = jmes_of_db_cluster_snapshot_message(out)
        if state == "" && waiter.path_matches(o, "length(DBClusterSnapshots) == `0`", "booleanEquals", "true") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "creating") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "modifying") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "rebooting") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "DBClusterSnapshots[].Status", "anyStringEquals", "resetting-master-credentials") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_db_cluster_snapshots(e)
        if state == "" && waiter.error_is(names, "DBClusterSnapshotNotFoundFault") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("DBClusterSnapshotDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeDBClusters until the DBClusterAvailable acceptors reach success
