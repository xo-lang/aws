  let (ep, signing, extra) = c.route(endpoint_params_accept_handshake(c.params, input)) ?? e => return Err(AcceptHandshakeErr.InvalidInput(e))
  var req = serialize_accept_handshake(ep, input, "") ?? e => return Err(AcceptHandshakeErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(AcceptHandshakeErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_accept_handshake_error(resp))
  }
  deserialize_accept_handshake(resp) ?? e => Err(AcceptHandshakeErr.Deserialize(e))
}

