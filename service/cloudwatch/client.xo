  }
  if let Some(x) = v.metric_datapoints {
    xml_write_insight_rule_metric_datapoints(w, x, "MetricDatapoints", [])
  }
  xmlv.end(w, name)
}

fn xml_read_get_insight_rule_report_output(e: xml.Element) -> GetInsightRuleReportOutput ! Str {
  var out = GetInsightRuleReportOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "KeyLabels" => out.key_labels = xml_read_insight_rule_contributor_key_labels(c)?
      "AggregationStatistic" => out.aggregation_statistic = c.text()
      "AggregateValue" => out.aggregate_value = xmlv.read_float(c.text())?
      "ApproximateUniqueCount" => out.approximate_unique_count = xmlv.read_int(c.text())?
      "Contributors" => out.contributors = xml_read_insight_rule_contributors(c)?
      "MetricDatapoints" => out.metric_datapoints = xml_read_insight_rule_metric_datapoints(c)?
      _ => {}
