// The generator's command, run from codegen/:
//   xo run ./cmd/gen -- protocol-test <service shape id> <out dir>
// generates a client for one of Smithy's protocol test services (with
// its protocol tests);
//   xo run ./cmd/gen -- aws <model directory> <out dir>
//   xo run ./cmd/gen -- endpoints <model directory> <out dir>
//   xo run ./cmd/gen -- service <model directory> -
// (the last writes the service's module into service/<name>, from its
// sdkId, with an xo.mod, and lists it in xo.work)
// (the last writes only the compiled endpoint rules and their tests)
// generates the client of one AWS service from .models/models/<model
// directory>. <out dir> is relative to the repository root.

use std/json
use github.com/xo-lang/aws/codegen/gen
use github.com/xo-lang/aws/codegen/idl
use github.com/xo-lang/aws/codegen/model

fn protocol_test_ast(os: Os) -> json.Value ! Error {
  let dir = ".protocol-tests/smithy-aws-protocol-tests/model"
  let files = os.fs.glob("${dir}/*.smithy")? + os.fs.glob("${dir}/*/*.smithy")? + os.fs.glob("${dir}/*/*/*.smithy")? + os.fs.glob(".protocol-tests/smithy-validation-model/model/*.smithy")?
  var sources: List[idl.Source] = []
  for f in files.sort() {
    sources.push(idl.Source{name: f, text: os.fs.read_text(f)?})
  }
  Ok(idl.parse(sources)?)
}

fn main(os: Os) -> () ! Error {
  // the arguments after the program name
  let args = os.env.args()
  if args.len() < 3 || (args[0] != "protocol-test" && args[0] != "aws" && args[0] != "endpoints" && args[0] != "service") {
    os.stdio.println("usage: gen protocol-test <service shape id> <out dir> | gen aws <model directory> <out dir>")
    return Ok(())
  }
  let tests = args[0] == "protocol-test"
  let m = if tests {
    var pm = model.from_ast(protocol_test_ast(os)?, args[1])?
    if args[1] == "com.amazonaws.s3#AmazonS3" {
      // Smithy's S3 test service has no endpoint rules; its addressing
      // cases are written against the real S3 service's
      let found = os.fs.glob(".models/models/s3/service/*/*.json")?
      if found.len() == 1 {
        let real = model.load(os.fs.read_text(found[0])?)?
        let rs = real.shapes.get(real.service) ?? return Ok(())
        var svc = pm.shapes.get(pm.service) ?? return Ok(())
        for (k, v) in rs.traits {
          if k.starts_with("smithy.rules#") {
            svc.traits.push((k, v))
          }
        }
        pm.shapes.put(pm.service, svc)
      }
    }
    pm
  } else {
    let found = os.fs.glob(".models/models/${args[1]}/service/*/*.json")?
    if found.len() != 1 {
      os.stdio.println("want one model file for ${args[1]}, found ${found.len()}")
      return Ok(())
    }
    model.load(os.fs.read_text(found[0])?)?
  }
  let dir = if args[0] == "service" {
    let sdk = match model.trait_of((m.shapes.get(m.service) ?? return Ok(())).traits, "aws.api#service") {
      Some(t) => match t.get("sdkId") {
        Some(json.Value.Str(x)) => x
        _ => args[1]
      }
      None => args[1]
    }
    "service/${gen.service_dir(sdk)}"
  } else {
    args[2]
  }
  let out = "../${dir}"
  if args[0] == "service" {
    let module = "github.com/xo-lang/aws/${dir}"
    os.fs.create_dir_all(out)?
    os.fs.write("${out}/xo.mod", "module ${module}\nedition preview\n".bytes())?
    let work = os.fs.read_text("../xo.work")?
    if !work.contains("use ./${dir}\n") {
      os.fs.write("../xo.work", "${work}use ./${dir}\n".bytes())?
    }
  }
  let files = if args[0] == "endpoints" { gen.endpoint_files(m, true)? } else { gen.generate(m, gen.Options{package: dir, protocol_tests: tests}) }
  os.fs.create_dir_all(out)?
  for f in files {
    os.fs.write("${out}/${f.path}", f.text.bytes())?
    os.stdio.println("wrote ${out}/${f.path}")
  }
  Ok(())
}
