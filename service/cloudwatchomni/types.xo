  /// The operations observed on this edge.
  pub operations: List[Str]? = None
  /// Attributes promoted out of the flat attribute map onto typed members.
  /// Which members are present depends on what produced the edge.
  pub edge_properties: EdgeProperties? = None
  /// The edge's OpenTelemetry (OTel) attributes, as emitted by telemetry. A
  /// key promoted onto an `edgeProperties` member is removed here, so no
  /// value appears twice.
  pub telemetry_attributes: Map[Str, Str]? = None
  /// The kinds of telemetry signal observed on this edge.
  pub signal_types: List[Signal]? = None
  /// The discovery sources that contributed this edge.
  pub sources: List[Source]? = None
  /// Descriptive metadata about the edge. Present only when the request sets
  /// includeMetadata.
  pub metadata: Metadata? = None
  /// When this edge was first observed (UTC), at minute granularity. For an
  /// edge that merged across sources, this is the earliest value any source
  /// reported.
  pub first_observed_at: Time? = None
  /// When this edge was most recently observed (UTC), at minute granularity.
  /// For an edge that merged across sources, this is the latest value any
  /// source reported.
  pub last_observed_at: Time? = None
}

/// Criteria for filtering edges in a context graph query.
pub struct EdgeFilters {
  /// Match only the edge with this identifier.
  pub edge_id: Str? = None
  /// Match only edges originating from this node identifier.
  pub from_value: Str? = None
  /// Match only edges pointing to this node identifier.
  pub to: Str? = None
  /// Match only edges of this relationship kind.
  pub edge_type: EdgeType? = None
  /// Match edges carrying any of these operations.
  pub operations: List[Str]? = None
  /// Match edges by their OpenTelemetry (OTel) telemetry attributes. Not yet
  /// enforced: currently accepted but ignored (does not filter), matching
  /// nodeFilters.telemetryAttributes.
  pub telemetry_attributes: List[KeyFilter]? = None
  /// Match edges contributed by any of these discovery sources.
  pub sources: List[Source]? = None
}

/// Edge attributes promoted out of the flat attribute map onto typed
/// members. Which members are present depends entirely on what produced the
/// edge, so most edges carry only a few of them.
pub struct EdgeProperties {
  /// The IANA protocol name for the observed network traffic, such as "tcp".
  pub protocol: Str? = None
  /// The source port of the observed traffic. May be a placeholder when the
  /// port is unknown.
  pub source_port: Str? = None
  /// The destination port of the observed traffic. May be a placeholder when
  /// the port is unknown.
  pub destination_port: Str? = None
  /// Whether the observed network flow was denied. Absent means the edge was
  /// not derived from network flow data, which is not the same as allowed.
  pub blocked: Bool? = None
  /// The error code returned when the call was attempted and refused. Its
  /// presence means the edge exists but the dependency is failing.
  pub error_code: Str? = None
  /// The HTTP status code observed on the request. Distinct from errorCode.
  pub http_status_code: Str? = None
  /// The HTTP method observed on the request.
  pub http_method: Str? = None
  /// Whether the caller was an AWS service principal rather than a user or
  /// role. Absent means the edge was not derived from a source that reports
  /// it.
  pub service_initiated: Bool? = None
  /// Traffic counters accumulated over the edge's observation window.
  pub traffic_stats: EdgeTrafficStats? = None
}

/// Additive traffic counters accumulated over an edge's observation window.
/// Which counters are populated depends on what produced the edge.
pub struct EdgeTrafficStats {
  /// Total bytes observed across the edge.
  pub bytes: Int? = None
  /// Total packets observed across the edge.
  pub packets: Int? = None
  /// Total network flows observed across the edge.
  pub flows: Int? = None
  /// Total bytes sent to the destination.
  pub sent_bytes: Int? = None
  /// Total bytes received from the destination.
  pub received_bytes: Int? = None
}

/// Context graph edge types.
pub enum EdgeType: Str {
  Calls = "CALLS"
  Accesses = "ACCESSES"
  RunsOn = "RUNS_ON"
  Unknown(value: Str)
}

/// How a resource's data at rest is encrypted. `kmsKeyArn` is required when
/// `encryptionStrategy` is CUSTOMER_MANAGED and must be absent when it is
/// AWS_OWNED; a mismatch is a ValidationException rather than a silently
/// ignored field, so a caller that selects AWS_OWNED while still passing a
/// key learns that the key was not applied.
pub struct EncryptionConfiguration {
  /// Which kind of key to use. Required.
  pub encryption_strategy: EncryptionStrategy? = None
  /// Customer managed KMS key ARN. Required when `encryptionStrategy` is
  /// CUSTOMER_MANAGED, and must be omitted when it is AWS_OWNED. Must be a
  /// symmetric ENCRYPT_DECRYPT key in the caller's account and region.
  pub kms_key_arn: Str? = None
}

/// Which kind of KMS key protects a resource's data at rest.
pub enum EncryptionStrategy: Str {
  AwsOwned = "AWS_OWNED"
  CustomerManaged = "CUSTOMER_MANAGED"
  Unknown(value: Str)
}

