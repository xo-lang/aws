// Package gen turns a loaded model into Xo source files (decision 0002:
// plan and emit).

use github.com/xo-lang/aws/codegen/model

pub struct Options {
  /// The output directory relative to the repository root, which is also
  /// the package's import path below the module.
  pub package: Str
  /// Also emit the model's Smithy protocol tests as Xo tests.
  pub protocol_tests: Bool = false
}

pub struct File {
  pub path: Str
  pub text: Str
}

pub fn generate(m: model.Model, opts: Options) -> List[File] {
  let g = new_g(m)
  var files: List[File] = []
  for f in split_file("types", emit_types(g)) {
    files.push(f)
  }
  for f in split_file("client", emit_restjson(g)) {
    files.push(f)
  }
  for f in split_file("waiters", emit_waiters(g)) {
    files.push(f)
  }
  for f in split_file("paginators", emit_paginators(g)) {
    files.push(f)
  }
  if let Some(rules) = rules_of(g) {
    let text = match emit_endpoint_rules(rules) {
      Ok(t) => with_uses(t)
      Err(e) => "// the endpoint rules could not be compiled: ${e}\n"
    }
    files.push(File{path: "endpoint.xo", text: text})
  }
  if !g.names.renames.is_empty() {
    var lines = ["# Renames", "", "Names the generator changed from the model's (decision 0002).", "", "| What | Model | Xo | Why |", "|---|---|---|---|"]
    for r in g.names.renames {
      lines.push("| ${r.what} | ${r.from} | ${r.to} | ${r.why} |")
    }
    files.push(File{path: "RENAMES.md", text: lines.join("\n") + "\n"})
  }
  if opts.protocol_tests {
    let protocol = if g.ec2 { "aws.protocols#ec2Query" } else if g.query { "aws.protocols#awsQuery" } else if g.xml { "aws.protocols#restXml" } else if g.rpc == "1.0" { "aws.protocols#awsJson1_0" } else if g.rpc == "1.1" { "aws.protocols#awsJson1_1" } else { "aws.protocols#restJson1" }
    files.push(File{path: "protocol_test.xo", text: with_uses(emit_protocol_tests(g, protocol, SKIP))})
  }
  files
}

/// The size a generated file is cut at, and the most any may have (xo
/// issue 8: the checker mixes up nodes between files over 1 MiB).
pub const SPLIT_BYTES: Int = 458752
pub const MAX_FILE_BYTES: Int = 524288

/// `body` as files `<base>.xo`, `<base>_2.xo`, ... of about SPLIT_BYTES
/// each, cut after a top-level declaration (a `}` at column 0 followed
/// by a blank line), each with its own imports. None for an empty body.
pub fn split_file(base: Str, body: Str) -> List[File] {
  if body == "" {
    return []
  }
  var pieces: List[Str] = []
  var cur: List[Str] = []
  var size = 0
  let lines = body.split("\n")
  for (i, line) in lines.indexed() {
    cur.push(line)
    size += line.len() + 1
    let boundary = line == "}" && i + 1 < lines.len() && lines[i + 1] == ""
    if size >= SPLIT_BYTES && boundary {
      pieces.push(cur.join("\n"))
      cur = []
      size = 0
    }
  }
  if !cur.is_empty() {
    pieces.push(cur.join("\n"))
  }
  var out: List[File] = []
  for (i, p) in pieces.indexed() {
    let name = if i == 0 { "${base}.xo" } else { "${base}_${i + 1}.xo" }
    out.push(File{path: name, text: with_uses(p.trim_start_chars("\n"))})
  }
  out
}

/// The generated .xo files over MAX_FILE_BYTES (a declaration too large
/// to cut): the generator fails on any.
pub fn oversized(files: List[File]) -> List[Str] {
  files.filter(fn(f: File) -> Bool { f.path.ends_with(".xo") && f.text.len() > MAX_FILE_BYTES }).map(fn(f: File) -> Str { "${f.path} (${f.text.len()} bytes)" })
}

/// Protocol tests not run, with why (aws-sdk-go-v2 skips most of these too).
const SKIP: List[(Str, Str)] = [
  ("RestJsonClientPopulatesDefaultValuesInInput", "members are optional and unset defaults are not sent (decision 0004); aws-sdk-go-v2 skips it too"),
  ("RestJsonClientPopulatesDefaultsValuesWhenMissingInResponse", "defaults are not filled into outputs (decision 0004); aws-sdk-go-v2 skips it too"),
  ("RestJsonClientPopulatesNestedDefaultValuesWhenMissing", "defaults are not filled in (decision 0004); aws-sdk-go-v2 skips it too"),
  ("RestJsonClientPopulatesNestedDefaultsWhenMissingInResponseBody", "defaults are not filled in (decision 0004); aws-sdk-go-v2 skips it too"),
  ("AwsJson10ClientPopulatesDefaultValuesInInput", "members are optional and unset defaults are not sent (decision 0004)"),
  ("AwsJson10ClientPopulatesNestedDefaultValuesWhenMissing", "members are optional and unset defaults are not sent (decision 0004)"),
  ("AwsJson10ClientPopulatesDefaultsValuesWhenMissingInResponse", "defaults are not filled into outputs (decision 0004)"),
  ("AwsJson10ClientPopulatesNestedDefaultsWhenMissingInResponseBody", "defaults are not filled into outputs (decision 0004)"),
  ("AwsJson10ClientErrorCorrectsWhenServerFailsToSerializeRequiredValues", "members are optional, so a missing required member stays None rather than a corrected zero value (decision 0004)"),
  ("AwsJson10ClientErrorCorrectsWithDefaultValuesWhenServerFailsToSerializeRequiredValues", "members are optional, so a missing required member stays None rather than a corrected zero value (decision 0004)"),
]

/// The `use` lines a generated file needs: each candidate whose package
/// name appears as `name.` in `body`.
pub fn uses_for(body: Str, candidates: List[Str]) -> Str {
  let code = code_only(body)
  var out: List[Str] = []
  for c in candidates {
    let name = (c.split("/")).last() ?? c
    if code.contains(" ${name}.") || code.contains("(${name}.") || code.contains("[${name}.") || code.contains("!${name}.") || code.contains("-${name}.") || code.contains("{${name}.") {
      out.push("use ${c}")
    }
  }
  out.join("\n")
}

pub const HEADER: Str = "// Code generated by xo-lang-aws codegen. DO NOT EDIT."

const CANDIDATES: List[Str] = ["std/compress", "std/crypto", "std/http", "std/json", "std/xml", "github.com/xo-lang/aws", "github.com/xo-lang/aws/checksum", "github.com/xo-lang/aws/discovery", "github.com/xo-lang/aws/endpoints", "github.com/xo-lang/aws/eventstream", "github.com/xo-lang/aws/protocol/jsonv", "github.com/xo-lang/aws/protocol/protocoltest", "github.com/xo-lang/aws/protocol/query", "github.com/xo-lang/aws/protocol/rest", "github.com/xo-lang/aws/protocol/restjson", "github.com/xo-lang/aws/protocol/restxml", "github.com/xo-lang/aws/protocol/xmlv", "github.com/xo-lang/aws/retry", "github.com/xo-lang/aws/sigv4", "github.com/xo-lang/aws/transport", "github.com/xo-lang/aws/waiter"]

/// A generated file: the header, the imports its body uses, the body.
pub fn with_uses(body: Str) -> Str {
  let u = uses_for(body, CANDIDATES)
  if u == "" { "${HEADER}\n\n${body}" } else { "${HEADER}\n\n${u}\n\n${body}" }
}

/// `body` without comments and string contents, for finding package uses.
fn code_only(body: Str) -> Str {
  var out = StrBuilder.new()
  for line in body.split("\n") {
    if line.trim().starts_with("//") {
      continue
    }
    var quoted = false
    var escaped = false
    for r in line.runes() {
      if quoted {
        if escaped {
          escaped = false
        } else if r == '\\' {
          escaped = true
        } else if r == '"' {
          quoted = false
          out.write("\"")
        }
      } else {
        if r == '"' {
          quoted = true
        }
        out.write("${r}")
      }
    }
    out.write("\n")
  }
  out.freeze()
}
