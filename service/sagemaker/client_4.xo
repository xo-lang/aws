fn json_of_metric_specification(v: MetricSpecification) -> json.Value {
  match v {
    Predefined(x) => json.Value.Object([("Predefined", json_of_predefined_metric_specification(x))])
    Customized(x) => json.Value.Object([("Customized", json_of_customized_metric_specification(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_metric_specification(v: json.Value) -> MetricSpecification ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Predefined" => Ok(MetricSpecification.Predefined(from_json_predefined_metric_specification(fv)?))
      "Customized" => Ok(MetricSpecification.Customized(from_json_customized_metric_specification(fv)?))
      _ => Ok(MetricSpecification.Unknown(k))
    }
  }
  Err("MetricSpecification: no member set")
}

