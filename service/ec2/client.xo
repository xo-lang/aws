    query.add(f, query.key(prefix, "ExplanationCode"), x)
  }
  if let Some(x) = v.ingress_route_table {
    query_put_analysis_component(f, query.key(prefix, "IngressRouteTable"), x)
  }
  if let Some(x) = v.internet_gateway {
    query_put_analysis_component(f, query.key(prefix, "InternetGateway"), x)
  }
  if let Some(x) = v.load_balancer_arn {
