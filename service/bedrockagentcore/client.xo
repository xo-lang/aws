    InternalServerException(x) => "InternalServerException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ServiceQuotaExceededException(x) => "ServiceQuotaExceededException: ${x:?}"
