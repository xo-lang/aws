  pub version: Str? = None
}

/// Provides a regular expression used to validate the value of a slot.
pub struct SlotTypeRegexConfiguration {
  /// A regular expression used to validate the value of a slot. Use a
  /// standard regular expression. Amazon Lex supports the following
  /// characters in the regular expression: A-Z, a-z 0-9 Unicode characters
