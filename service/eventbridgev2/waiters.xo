/// Waits until the event bus reports ACTIVE. Use after CreateEventBus (bus
/// starts in CREATING) or UpdateEventBus (bus moves to UPDATING) before
/// invoking operations that require an ACTIVE bus. Fails fast on the
/// terminal failure states CREATE_FAILED, UPDATE_FAILED, and DELETE_FAILED,
/// surfacing StateReason. CREATING, UPDATING, and DELETING are
/// intentionally unmodeled intermediate states that fall through to the
/// implicit retry.
///
/// Calls DescribeEventBus until the EventBusActive acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (2s) to `max_delay` (120s).
pub fn wait_until_event_bus_active(c: Client, input: DescribeEventBusRequest, max_wait: Duration, min_delay: Duration = 2s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeEventBusErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_event_bus(input) {
      Ok(out) => {
        let o = jmes_of_describe_event_bus_response(out)
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "CREATE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "UPDATE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "DELETE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "ACTIVE") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("EventBusActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

