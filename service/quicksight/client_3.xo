fn from_json_knowledge_base(v: json.Value) -> KnowledgeBase ! Str {
  var out = KnowledgeBase{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "KnowledgeBaseArn" => out.knowledge_base_arn = jsonv.read_str(fv)?
      "KnowledgeBaseId" => out.knowledge_base_id = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "Status" => out.status = DataSetStatus.from(jsonv.read_str(fv)?)
      "DataSourceArn" => out.data_source_arn = jsonv.read_str(fv)?
      "KnowledgeBaseConfiguration" => out.knowledge_base_configuration = from_json_knowledge_base_configuration(fv)?
      "MediaExtractionConfiguration" => out.media_extraction_configuration = from_json_media_extraction_configuration(fv)?
      "AccessControlConfiguration" => out.access_control_configuration = from_json_access_control_configuration(fv)?
      "Type" => out.type_value = jsonv.read_str(fv)?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "UpdatedAt" => out.updated_at = jsonv.read_time(fv, "epoch-seconds")?
      "Description" => out.description = jsonv.read_str(fv)?
      "IsEmailNotificationOptedForIngestionFailures" => out.is_email_notification_opted_for_ingestion_failures = jsonv.read_bool(fv)?
      "FirstCompletedIngestionSummary" => out.first_completed_ingestion_summary = from_json_knowledge_base_ingestion_summary(fv)?
      "FirstIncompleteIngestionSummary" => out.first_incomplete_ingestion_summary = from_json_knowledge_base_ingestion_summary(fv)?
      "LatestIngestionSummary" => out.latest_ingestion_summary = from_json_knowledge_base_ingestion_summary(fv)?
      "KnowledgeBaseSizeBytes" => out.knowledge_base_size_bytes = jsonv.read_int(fv)?
      "DocumentCount" => out.document_count = jsonv.read_int(fv)?
      "PrimaryOwnerArn" => out.primary_owner_arn = jsonv.read_str(fv)?
      "PrimaryOwnerUsername" => out.primary_owner_username = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

