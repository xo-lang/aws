fn json_of_task_parameter_value(v: TaskParameterValue) -> json.Value {
  match v {
    Int(x) => json.Value.Object([("int", json.Value.Str(x))])
    Float(x) => json.Value.Object([("float", json.Value.Str(x))])
    String(x) => json.Value.Object([("string", json.Value.Str(x))])
    Path(x) => json.Value.Object([("path", json.Value.Str(x))])
    ChunkInt(x) => json.Value.Object([("chunkInt", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_task_parameter_value(v: json.Value) -> TaskParameterValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "int" => Ok(TaskParameterValue.Int(jsonv.read_str(fv)?))
      "float" => Ok(TaskParameterValue.Float(jsonv.read_str(fv)?))
      "string" => Ok(TaskParameterValue.String(jsonv.read_str(fv)?))
      "path" => Ok(TaskParameterValue.Path(jsonv.read_str(fv)?))
      "chunkInt" => Ok(TaskParameterValue.ChunkInt(jsonv.read_str(fv)?))
      _ => Ok(TaskParameterValue.Unknown(k))
    }
  }
  Err("TaskParameterValue: no member set")
}

fn json_of_task_parameters(v: Map[Str, TaskParameterValue]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, TaskParameterValue)) -> (Str, json.Value) { (e.0, json_of_task_parameter_value(e.1)) }))
