    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ServiceCreated: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until a Service, its instances, and possibly pipeline have been
/// deleted after DeleteService is invoked
///
/// Calls GetService until the ServiceDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (4999s).
pub fn wait_until_service_deleted(c: Client, input: GetServiceInput, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 4999s) -> () ! waiter.WaitErr[GetServiceErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).get_service(input) {
      Ok(out) => {
        let o = jmes_of_get_service_output(out)
        if state == "" && waiter.path_matches(o, "service.status", "stringEquals", "DELETE_FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_get_service(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ServiceDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

