  /// An array of ProjectSourceVersion objects that override the secondary
  /// source versions in the batch build project.
  pub secondary_sources_version_override: List[ProjectSourceVersion]? = None
  /// The version of the batch build input to be built, for this build only.
  /// If not specified, the latest version is used. If specified, the contents
  /// depends on the source provider: CodeCommit The commit ID, branch, or Git
  /// tag to use. GitHub The commit ID, pull request ID, branch name, or tag
  /// name that corresponds to the version of the source code you want to
  /// build. If a pull request ID is specified, it must use the format
  /// pr/pull-request-ID (for example pr/25 ). If a branch name is specified,
  /// the branch's HEAD commit ID is used. If not specified, the default
  /// branch's HEAD commit ID is used. Bitbucket The commit ID, branch name,
  /// or tag name that corresponds to the version of the source code you want
  /// to build. If a branch name is specified, the branch's HEAD commit ID is
  /// used. If not specified, the default branch's HEAD commit ID is used.
  /// Amazon S3 The version ID of the object that represents the build input
  /// ZIP file to use. If sourceVersion is specified at the project level,
  /// then this sourceVersion (at the build level) takes precedence. For more
  /// information, see Source Version Sample with CodeBuild in the CodeBuild
  /// User Guide .
  pub source_version: Str? = None
  /// An array of ProjectArtifacts objects that contains information about the
  /// build output artifact overrides for the build project.
  pub artifacts_override: ProjectArtifacts? = None
  /// An array of ProjectArtifacts objects that override the secondary
  /// artifacts defined in the batch build project.
  pub secondary_artifacts_override: List[ProjectArtifacts]? = None
  /// An array of EnvironmentVariable objects that override, or add to, the
  /// environment variables defined in the batch build project.
  pub environment_variables_override: List[EnvironmentVariable]? = None
  /// The source input type that overrides the source input defined in the
  /// batch build project.
  pub source_type_override: SourceType? = None
  /// A location that overrides, for this batch build, the source location
  /// defined in the batch build project.
  pub source_location_override: Str? = None
  /// A SourceAuth object that overrides the one defined in the batch build
  /// project. This override applies only if the build project's source is
  /// BitBucket or GitHub.
  pub source_auth_override: SourceAuth? = None
  /// The user-defined depth of history, with a minimum value of 0, that
  /// overrides, for this batch build only, any previous depth of history
  /// defined in the batch build project.
  pub git_clone_depth_override: Int? = None
  /// A GitSubmodulesConfig object that overrides the Git submodules
  /// configuration for this batch build.
  pub git_submodules_config_override: GitSubmodulesConfig? = None
  /// A buildspec file declaration that overrides, for this build only, the
  /// latest one already defined in the build project. If this value is set,
  /// it can be either an inline buildspec definition, the path to an
  /// alternate buildspec file relative to the value of the built-in
  /// CODEBUILD_SRC_DIR environment variable, or the path to an S3 bucket. The
  /// bucket must be in the same Amazon Web Services Region as the build
  /// project. Specify the buildspec file using its ARN (for example,
  /// arn:aws:s3:::my-codebuild-sample2/buildspec.yml ). If this value is not
  /// provided or is set to an empty string, the source code must contain a
  /// buildspec file in its root directory. For more information, see
  /// Buildspec File Name and Storage Location .
  pub buildspec_override: Str? = None
  /// Enable this flag to override the insecure SSL setting that is specified
  /// in the batch build project. The insecure SSL setting determines whether
  /// to ignore SSL warnings while connecting to the project source code. This
  /// override applies only if the build's source is GitHub Enterprise.
  pub insecure_ssl_override: Bool? = None
  /// Set to true to report to your source provider the status of a batch
  /// build's start and completion. If you use this option with a source
  /// provider other than GitHub, GitHub Enterprise, or Bitbucket, an
  /// invalidInputException is thrown. The status of a build triggered by a
  /// webhook is always reported to your source provider.
  pub report_build_batch_status_override: Bool? = None
  /// A container type for this batch build that overrides the one specified
  /// in the batch build project.
  pub environment_type_override: EnvironmentType? = None
  /// The name of an image for this batch build that overrides the one
  /// specified in the batch build project.
  pub image_override: Str? = None
  /// The name of a compute type for this batch build that overrides the one
  /// specified in the batch build project.
  pub compute_type_override: ComputeType? = None
  /// The name of a certificate for this batch build that overrides the one
  /// specified in the batch build project.
  pub certificate_override: Str? = None
  /// A ProjectCache object that specifies cache overrides.
  pub cache_override: ProjectCache? = None
  /// The name of a service role for this batch build that overrides the one
  /// specified in the batch build project.
  pub service_role_override: Str? = None
  /// Enable this flag to override privileged mode in the batch build project.
  pub privileged_mode_override: Bool? = None
  /// Overrides the build timeout specified in the batch build project.
  pub build_timeout_in_minutes_override: Int? = None
  /// The number of minutes a batch build is allowed to be queued before it
  /// times out.
  pub queued_timeout_in_minutes_override: Int? = None
  /// The Key Management Service customer master key (CMK) that overrides the
  /// one specified in the batch build project. The CMK key encrypts the build
  /// output artifacts. You can use a cross-account KMS key to encrypt the
  /// build output artifacts if your service role has permission to that key.
  /// You can specify either the Amazon Resource Name (ARN) of the CMK or, if
  /// available, the CMK's alias (using the format alias/ ).
  pub encryption_key_override: Str? = None
  /// A unique, case sensitive identifier you provide to ensure the
  /// idempotency of the StartBuildBatch request. The token is included in the
  /// StartBuildBatch request and is valid for five minutes. If you repeat the
  /// StartBuildBatch request with the same token, but change a parameter,
