  var req = serialize_put_bucket_website(ep, input, "") ?? e => return Err(PutBucketWebsiteErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(PutBucketWebsiteErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_put_bucket_website_error(resp))
  }
  deserialize_put_bucket_website(resp) ?? e => Err(PutBucketWebsiteErr.Deserialize(e))
}

pub fn endpoint_params_put_object(base: EndpointParameters, input: PutObjectRequest) -> EndpointParameters {
  var p = base
  if let Some(x) = input.bucket {
    p.bucket = x
  }
  if let Some(x) = input.key {
    p.key = x
  }
  p
}

