      "phase2EncryptionAlgorithm" => out.phase2_encryption_algorithm = c.text()
      "phase1IntegrityAlgorithm" => out.phase1_integrity_algorithm = c.text()
      "phase2IntegrityAlgorithm" => out.phase2_integrity_algorithm = c.text()
      "phase1DHGroup" => out.phase1_dh_group = xmlv.read_int(c.text())?
      "phase2DHGroup" => out.phase2_dh_group = xmlv.read_int(c.text())?
      "ikeVersion" => out.ike_version = c.text()
      "provisioningStatus" => out.provisioning_status = VpnTunnelProvisioningStatus.from(c.text())
      "provisioningStatusReason" => out.provisioning_status_reason = c.text()
      _ => {}
    }
  }
  Ok(out)
}

