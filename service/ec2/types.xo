  /// The ID of the VPC.
  pub vpc_id: Str? = None
  /// The URL of the self-service portal.
  pub self_service_portal_url: Str? = None
  /// The options for managing connection authorization for new client
  /// connections.
  pub client_connect_options: ClientConnectResponseOptions? = None
  /// The maximum VPN session duration time in hours. Valid values: 8 | 10 |
