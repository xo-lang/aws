/// The configuration for pre-roll ad insertion.
pub struct LivePreRollConfiguration {
  /// The URL for the ad decision server (ADS) for pre-roll ads. This includes
  /// the specification of static parameters and placeholders for dynamic
  /// parameters. AWS Elemental MediaTailor substitutes player-specific and
  /// session-specific parameters as needed when calling the ADS. Alternately,
  /// for testing, you can provide a static VAST URL. The maximum length is
  /// 25,000 characters.
  pub ad_decision_server_url: Str? = None
  /// The maximum allowed duration for the pre-roll ad avail. AWS Elemental
  /// MediaTailor won't play pre-roll ads to exceed this duration, regardless
  /// of the total duration of ads that the ADS returns.
  pub max_duration_seconds: Int? = None
  /// The configuration for the ad decision server (ADS) for live pre-roll
  /// ads. The configuration contains settings that control how MediaTailor
  /// processes VAST responses for pre-roll ad breaks.
  pub ad_decision_server_configuration: PreRollAdDecisionServerConfiguration? = None
}

/// Live source configuration parameters.
pub struct LiveSource {
  /// The ARN for the live source.
  pub arn: Str? = None
  /// The timestamp that indicates when the live source was created.
  pub creation_time: Time? = None
  /// The HTTP package configurations for the live source.
  pub http_package_configurations: List[HttpPackageConfiguration]? = None
  /// The timestamp that indicates when the live source was last modified.
  pub last_modified_time: Time? = None
  /// The name that's used to refer to a live source.
  pub live_source_name: Str? = None
  /// The name of the source location.
  pub source_location_name: Str? = None
  /// The tags assigned to the live source. Tags are key-value pairs that you
  /// can associate with Amazon resources to help with organization, access
  /// control, and cost tracking. For more information, see Tagging AWS
  /// Elemental MediaTailor Resources .
  pub tags: Map[Str, Str]? = None
}

/// Defines where AWS Elemental MediaTailor sends logs for the playback
/// configuration.
pub struct LogConfiguration {
  /// The percentage of session logs that MediaTailor sends to your configured
  /// log destination. For example, if your playback configuration has 1000
  /// sessions and percentEnabled is set to 60 , MediaTailor sends logs for
  /// 600 of the sessions to CloudWatch Logs. MediaTailor decides at random
  /// which of the playback configuration sessions to send logs for. If you
  /// want to view logs for a specific session, you can use the debug log mode
  /// . Valid values: 0 - 100
  pub percent_enabled: Int? = None
  /// The method used for collecting logs from AWS Elemental MediaTailor.
  /// LEGACY_CLOUDWATCH indicates that MediaTailor is sending logs directly to
  /// Amazon CloudWatch Logs. VENDED_LOGS indicates that MediaTailor is
  /// sending logs to CloudWatch, which then vends the logs to your
  /// destination of choice. Supported destinations are CloudWatch Logs log
  /// group, Amazon S3 bucket, and Amazon Data Firehose stream.
  pub enabled_logging_strategies: List[LoggingStrategy]? = None
  /// Settings for customizing what events are included in logs for
  /// interactions with the ad decision server (ADS).
  pub ads_interaction_log: AdsInteractionLog? = None
  /// Settings for customizing what events are included in logs for
  /// interactions with the origin server.
  pub manifest_service_interaction_log: ManifestServiceInteractionLog? = None
}

/// The log configuration for the channel.
pub struct LogConfigurationForChannel {
  /// The log types.
  pub log_types: List[LogType]? = None
}

pub enum LogType: Str {
  AsRun = "AS_RUN"
  Unknown(value: Str)
}

pub enum LoggingStrategy: Str {
  VendedLogs = "VENDED_LOGS"
  LegacyCloudwatch = "LEGACY_CLOUDWATCH"
  Unknown(value: Str)
}

/// The configuration for manifest processing rules. Manifest processing
/// rules enable customization of the personalized manifests created by
/// MediaTailor.
pub struct ManifestProcessingRules {
  /// For HLS, when set to true , MediaTailor passes through EXT-X-CUE-IN ,
  /// EXT-X-CUE-OUT , and EXT-X-SPLICEPOINT-SCTE35 ad markers from the origin
  /// manifest to the MediaTailor personalized manifest. No logic is applied
  /// to these ad markers. For example, if EXT-X-CUE-OUT has a value of 60 ,
  /// but no ads are filled for that ad break, MediaTailor will not set the
  /// value to 0 .
  pub ad_marker_passthrough: AdMarkerPassthrough? = None
}

pub enum ManifestServiceExcludeEventType: Str {
  GeneratedManifest = "GENERATED_MANIFEST"
  OriginManifest = "ORIGIN_MANIFEST"
  SessionInitialized = "SESSION_INITIALIZED"
  TrackingResponse = "TRACKING_RESPONSE"
  ConfigSyntaxError = "CONFIG_SYNTAX_ERROR"
  ConfigSecurityError = "CONFIG_SECURITY_ERROR"
  UnknownHost = "UNKNOWN_HOST"
  TimeoutError = "TIMEOUT_ERROR"
  ConnectionError = "CONNECTION_ERROR"
  IoError = "IO_ERROR"
  UnknownError = "UNKNOWN_ERROR"
  HostDisallowed = "HOST_DISALLOWED"
  ParsingError = "PARSING_ERROR"
  ManifestError = "MANIFEST_ERROR"
  NoMasterOrMediaPlaylist = "NO_MASTER_OR_MEDIA_PLAYLIST"
  NoMasterPlaylist = "NO_MASTER_PLAYLIST"
  NoMediaPlaylist = "NO_MEDIA_PLAYLIST"
  IncompatibleHlsVersion = "INCOMPATIBLE_HLS_VERSION"
  Scte35ParsingError = "SCTE35_PARSING_ERROR"
  InvalidSinglePeriodDashManifest = "INVALID_SINGLE_PERIOD_DASH_MANIFEST"
  UnsupportedSinglePeriodDashManifest = "UNSUPPORTED_SINGLE_PERIOD_DASH_MANIFEST"
  LastPeriodMissingAudio = "LAST_PERIOD_MISSING_AUDIO"
  LastPeriodMissingAudioWarning = "LAST_PERIOD_MISSING_AUDIO_WARNING"
  ErrorOriginPrefixInterpolation = "ERROR_ORIGIN_PREFIX_INTERPOLATION"
  ErrorAdsInterpolation = "ERROR_ADS_INTERPOLATION"
  ErrorLivePreRollAdsInterpolation = "ERROR_LIVE_PRE_ROLL_ADS_INTERPOLATION"
  ErrorCdnAdSegmentInterpolation = "ERROR_CDN_AD_SEGMENT_INTERPOLATION"
  ErrorCdnContentSegmentInterpolation = "ERROR_CDN_CONTENT_SEGMENT_INTERPOLATION"
  ErrorSlateAdUrlInterpolation = "ERROR_SLATE_AD_URL_INTERPOLATION"
  ErrorProfileNameInterpolation = "ERROR_PROFILE_NAME_INTERPOLATION"
  ErrorBumperStartInterpolation = "ERROR_BUMPER_START_INTERPOLATION"
  ErrorBumperEndInterpolation = "ERROR_BUMPER_END_INTERPOLATION"
  PreSessionInitHookError = "PRE_SESSION_INIT_HOOK_ERROR"
  PreSessionInitFunctionError = "PRE_SESSION_INIT_FUNCTION_ERROR"
