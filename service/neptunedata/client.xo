pub fn (e: GetSparqlStreamErr) display() -> Str {
  match e {
    ClientTimeoutException(x) => "ClientTimeoutException: ${x:?}"
    ConstraintViolationException(x) => "ConstraintViolationException: ${x:?}"
    ExpiredStreamException(x) => "ExpiredStreamException: ${x:?}"
    IllegalArgumentException(x) => "IllegalArgumentException: ${x:?}"
    InvalidArgumentException(x) => "InvalidArgumentException: ${x:?}"
    InvalidParameterException(x) => "InvalidParameterException: ${x:?}"
    MemoryLimitExceededException(x) => "MemoryLimitExceededException: ${x:?}"
    PreconditionsFailedException(x) => "PreconditionsFailedException: ${x:?}"
    StreamRecordsNotFoundException(x) => "StreamRecordsNotFoundException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    TooManyRequestsException(x) => "TooManyRequestsException: ${x:?}"
    UnsupportedOperationException(x) => "UnsupportedOperationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

