fn json_of_processing_configuration(v: ProcessingConfiguration) -> json.Value {
  match v {
    AuditLog(x) => json.Value.Object([("auditLog", json_of_audit_log_processing_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_processing_configuration(v: json.Value) -> ProcessingConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "auditLog" => Ok(ProcessingConfiguration.AuditLog(from_json_audit_log_processing_configuration(fv)?))
      _ => Ok(ProcessingConfiguration.Unknown(k))
    }
  }
  Err("ProcessingConfiguration: no member set")
}

