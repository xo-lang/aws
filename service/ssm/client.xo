      "WarningMessage" => out.warning_message = jsonv.read_str(fv)?
      "Mode" => out.mode = ExecutionMode.from(jsonv.read_str(fv)?)
      "ParentAutomationExecutionId" => out.parent_automation_execution_id = jsonv.read_str(fv)?
      "ExecutedBy" => out.executed_by = jsonv.read_str(fv)?
      "CurrentStepName" => out.current_step_name = jsonv.read_str(fv)?
      "CurrentAction" => out.current_action = jsonv.read_str(fv)?
      "TargetParameterName" => out.target_parameter_name = jsonv.read_str(fv)?
      "Targets" => out.targets = from_json_targets(fv)?
      "TargetMaps" => out.target_maps = from_json_target_maps(fv)?
      "ResolvedTargets" => out.resolved_targets = from_json_resolved_targets(fv)?
      "MaxConcurrency" => out.max_concurrency = jsonv.read_str(fv)?
      "MaxErrors" => out.max_errors = jsonv.read_str(fv)?
      "Target" => out.target_value = jsonv.read_str(fv)?
