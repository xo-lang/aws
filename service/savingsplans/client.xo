    fs.push(("commitment", json.Value.Str(x)))
  }
  if let Some(x) = input.upfront_payment_amount {
    fs.push(("upfrontPaymentAmount", json.Value.Str(x)))
  }
  if let Some(x) = input.purchase_time {
    fs.push(("purchaseTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = input.client_token {
    fs.push(("clientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("clientToken", json.Value.Str(idempotency_token)))
