  if let Some(x) = v.aggregate_value {
    xmlv.elem(w, "AggregateValue", rest.float_text(x), [])
  }
  if let Some(x) = v.approximate_unique_count {
    xmlv.elem(w, "ApproximateUniqueCount", "${x}", [])
  }
  if let Some(x) = v.contributors {
