    xmlv.elem(w, "ParameterValue", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.source {
    xmlv.elem(w, "Source", x, [])
  }
  if let Some(x) = v.apply_type {
    xmlv.elem(w, "ApplyType", x, [])
  }
  if let Some(x) = v.data_type {
    xmlv.elem(w, "DataType", x, [])
  }
  if let Some(x) = v.allowed_values {
    xmlv.elem(w, "AllowedValues", x, [])
  }
  if let Some(x) = v.is_modifiable {
    xmlv.elem(w, "IsModifiable", "${x}", [])
  }
  if let Some(x) = v.minimum_engine_version {
    xmlv.elem(w, "MinimumEngineVersion", x, [])
  }
  if let Some(x) = v.apply_method {
    xmlv.elem(w, "ApplyMethod", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_parameter(e: xml.Element) -> Parameter ! Str {
  var out = Parameter{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ParameterName" => out.parameter_name = c.text()
      "ParameterValue" => out.parameter_value = c.text()
      "Description" => out.description = c.text()
      "Source" => out.source = c.text()
      "ApplyType" => out.apply_type = c.text()
      "DataType" => out.data_type = c.text()
      "AllowedValues" => out.allowed_values = c.text()
      "IsModifiable" => out.is_modifiable = xmlv.read_bool(c.text())?
      "MinimumEngineVersion" => out.minimum_engine_version = c.text()
      "ApplyMethod" => out.apply_method = ApplyMethod.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

