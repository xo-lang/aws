fn xml_write_launch_specification(var w: xmlv.Writer, v: LaunchSpecification, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.user_data {
    xmlv.elem(w, "userData", x, [])
  }
  if let Some(x) = v.addressing_type {
    xmlv.elem(w, "addressingType", x, [])
  }
  if let Some(x) = v.block_device_mappings {
    xml_write_block_device_mapping_list(w, x, "blockDeviceMapping", [])
  }
  if let Some(x) = v.ebs_optimized {
    xmlv.elem(w, "ebsOptimized", "${x}", [])
  }
  if let Some(x) = v.iam_instance_profile {
    xml_write_iam_instance_profile_specification(w, x, "iamInstanceProfile", [])
  }
  if let Some(x) = v.image_id {
    xmlv.elem(w, "imageId", x, [])
  }
  if let Some(x) = v.instance_type {
    xmlv.elem(w, "instanceType", x.value(), [])
  }
  if let Some(x) = v.kernel_id {
    xmlv.elem(w, "kernelId", x, [])
  }
  if let Some(x) = v.key_name {
    xmlv.elem(w, "keyName", x, [])
  }
  if let Some(x) = v.network_interfaces {
    xml_write_instance_network_interface_specification_list(w, x, "networkInterfaceSet", [])
  }
  if let Some(x) = v.placement {
    xml_write_spot_placement(w, x, "placement", [])
  }
  if let Some(x) = v.ramdisk_id {
    xmlv.elem(w, "ramdiskId", x, [])
  }
  if let Some(x) = v.subnet_id {
    xmlv.elem(w, "subnetId", x, [])
  }
  if let Some(x) = v.security_groups {
    xml_write_group_identifier_list(w, x, "groupSet", [])
  }
  if let Some(x) = v.monitoring {
    xml_write_run_instances_monitoring_enabled(w, x, "monitoring", [])
  }
  xmlv.end(w, name)
}

fn xml_read_launch_specification(e: xml.Element) -> LaunchSpecification ! Str {
  var out = LaunchSpecification{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "userData" => out.user_data = c.text()
      "addressingType" => out.addressing_type = c.text()
      "blockDeviceMapping" => out.block_device_mappings = xml_read_block_device_mapping_list(c)?
      "ebsOptimized" => out.ebs_optimized = xmlv.read_bool(c.text())?
      "iamInstanceProfile" => out.iam_instance_profile = xml_read_iam_instance_profile_specification(c)?
      "imageId" => out.image_id = c.text()
      "instanceType" => out.instance_type = InstanceType.from(c.text())
      "kernelId" => out.kernel_id = c.text()
      "keyName" => out.key_name = c.text()
      "networkInterfaceSet" => out.network_interfaces = xml_read_instance_network_interface_specification_list(c)?
      "placement" => out.placement = xml_read_spot_placement(c)?
      "ramdiskId" => out.ramdisk_id = c.text()
      "subnetId" => out.subnet_id = c.text()
      "groupSet" => out.security_groups = xml_read_group_identifier_list(c)?
      "monitoring" => out.monitoring = xml_read_run_instances_monitoring_enabled(c)?
      _ => {}
    }
  }
  Ok(out)
}

