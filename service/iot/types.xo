  /// The ARN of the role that grants permission to retrieve the InfluxDB API
  /// token from Amazon Web Services Secrets Manager.
  pub role_arn: Str? = None
  /// The name of the InfluxDB database to write to. In InfluxDB 2, this is
  /// the name of the bucket.
  pub database_name: Str? = None
  /// The name of the table to write the data point to. This is the
  /// measurement name of the InfluxDB line protocol record. Accepts
  /// substitution templates.
  pub table_name: Str? = None
  /// The name of the InfluxDB organization that owns the database. A write to
  /// an InfluxDB 2 instance fails if this value isn't set. This value isn't
  /// used when the destination is an InfluxDB 3 instance.
  pub organization: Str? = None
  /// The set of tags to write with each data point. Tags are the indexed
  /// metadata of an InfluxDB data point. Tag names and tag values accept
  /// substitution templates. A tag name can't use the @{...} per-element
  /// form. A tag name must resolve to the same value for every element of an
  /// array payload.
  pub tags: Map[Str, Str]? = None
  /// The precision of the timestamp written with each data point. Valid
  /// values are s (seconds), ms (milliseconds), us (microseconds), and ns
  /// (nanoseconds). If omitted, the topic rule action uses ms .
  pub timestamp_unit: InfluxDBTimestampUnit? = None
  /// The batching configuration for the action. When present, IoT collects
  /// data points from multiple messages and writes them to InfluxDB in a
  /// single request. If omitted, each message is written to InfluxDB in its
  /// own request.
  pub batch_config: InfluxDBBatchConfig? = None
}

/// The batching configuration of an InfluxDB rule action. IoT closes a
/// batch and writes it to InfluxDB when the first of the configured limits
/// is reached.
pub struct InfluxDBBatchConfig {
  /// The maximum number of data points to collect in a batch. If you don't
  /// specify a value, this limit doesn't apply. IoT then closes each batch
  /// when another configured limit is reached.
