fn json_of_job(v: Job) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("arn", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created {
    fs.push(("created", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.result {
    fs.push(("result", json.Value.Str(x.value())))
  }
  if let Some(x) = v.started {
    fs.push(("started", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.stopped {
    fs.push(("stopped", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.counters {
    fs.push(("counters", json_of_counters(x)))
  }
  if let Some(x) = v.message {
    fs.push(("message", json.Value.Str(x)))
  }
  if let Some(x) = v.device {
    fs.push(("device", json_of_device(x)))
  }
  if let Some(x) = v.instance_arn {
    fs.push(("instanceArn", json.Value.Str(x)))
  }
  if let Some(x) = v.device_minutes {
    fs.push(("deviceMinutes", json_of_device_minutes(x)))
  }
  if let Some(x) = v.video_endpoint {
    fs.push(("videoEndpoint", json.Value.Str(x)))
  }
  if let Some(x) = v.video_capture {
    fs.push(("videoCapture", json.Value.Bool(x)))
  }
  if let Some(x) = v.insights {
    fs.push(("insights", json_of_job_insights(x)))
  }
  json.Value.Object(fs)
}

fn from_json_job(v: json.Value) -> Job ! Str {
  var out = Job{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "arn" => out.arn = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "type" => out.type_value = TestType.from(jsonv.read_str(fv)?)
      "created" => out.created = jsonv.read_time(fv, "epoch-seconds")?
      "status" => out.status = ExecutionStatus.from(jsonv.read_str(fv)?)
      "result" => out.result = ExecutionResult.from(jsonv.read_str(fv)?)
      "started" => out.started = jsonv.read_time(fv, "epoch-seconds")?
      "stopped" => out.stopped = jsonv.read_time(fv, "epoch-seconds")?
      "counters" => out.counters = from_json_counters(fv)?
      "message" => out.message = jsonv.read_str(fv)?
      "device" => out.device = from_json_device(fv)?
      "instanceArn" => out.instance_arn = jsonv.read_str(fv)?
      "deviceMinutes" => out.device_minutes = from_json_device_minutes(fv)?
      "videoEndpoint" => out.video_endpoint = jsonv.read_str(fv)?
      "videoCapture" => out.video_capture = jsonv.read_bool(fv)?
      "insights" => out.insights = from_json_job_insights(fv)?
      _ => {}
    }
  }
  Ok(out)
}

