    xmlv.elem(w, "IntegrationName", x, [])
  }
  if let Some(x) = v.source_arn {
    xmlv.elem(w, "SourceArn", x, [])
  }
  if let Some(x) = v.target_arn {
    xmlv.elem(w, "TargetArn", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.errors {
    xml_write_integration_error_list(w, x, "Errors", [])
  }
  if let Some(x) = v.create_time {
    xmlv.elem(w, "CreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KMSKeyId", x, [])
  }
  if let Some(x) = v.additional_encryption_context {
    xml_write_encryption_context_map(w, x, "AdditionalEncryptionContext", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "Tags", [])
  }
  xmlv.end(w, name)
}

fn xml_read_integration(e: xml.Element) -> Integration ! Str {
  var out = Integration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "IntegrationArn" => out.integration_arn = c.text()
      "IntegrationName" => out.integration_name = c.text()
      "SourceArn" => out.source_arn = c.text()
      "TargetArn" => out.target_arn = c.text()
      "Status" => out.status = ZeroETLIntegrationStatus.from(c.text())
      "Errors" => out.errors = xml_read_integration_error_list(c)?
      "CreateTime" => out.create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Description" => out.description = c.text()
      "KMSKeyId" => out.kms_key_id = c.text()
      "AdditionalEncryptionContext" => out.additional_encryption_context = xml_read_encryption_context_map(c)?
