fn xml_write_cluster(var w: xmlv.Writer, v: Cluster, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.cluster_identifier {
    xmlv.elem(w, "ClusterIdentifier", x, [])
  }
  if let Some(x) = v.node_type {
    xmlv.elem(w, "NodeType", x, [])
  }
  if let Some(x) = v.cluster_status {
    xmlv.elem(w, "ClusterStatus", x, [])
  }
  if let Some(x) = v.cluster_availability_status {
    xmlv.elem(w, "ClusterAvailabilityStatus", x, [])
  }
  if let Some(x) = v.modify_status {
    xmlv.elem(w, "ModifyStatus", x, [])
  }
  if let Some(x) = v.master_username {
    xmlv.elem(w, "MasterUsername", x, [])
  }
  if let Some(x) = v.db_name {
    xmlv.elem(w, "DBName", x, [])
  }
  if let Some(x) = v.endpoint {
    xml_write_endpoint(w, x, "Endpoint", [])
  }
  if let Some(x) = v.cluster_create_time {
    xmlv.elem(w, "ClusterCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.automated_snapshot_retention_period {
    xmlv.elem(w, "AutomatedSnapshotRetentionPeriod", "${x}", [])
  }
  if let Some(x) = v.manual_snapshot_retention_period {
    xmlv.elem(w, "ManualSnapshotRetentionPeriod", "${x}", [])
  }
  if let Some(x) = v.cluster_security_groups {
    xml_write_cluster_security_group_membership_list(w, x, "ClusterSecurityGroups", [])
  }
  if let Some(x) = v.vpc_security_groups {
    xml_write_vpc_security_group_membership_list(w, x, "VpcSecurityGroups", [])
  }
  if let Some(x) = v.cluster_parameter_groups {
    xml_write_cluster_parameter_group_status_list(w, x, "ClusterParameterGroups", [])
  }
  if let Some(x) = v.cluster_subnet_group_name {
    xmlv.elem(w, "ClusterSubnetGroupName", x, [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "VpcId", x, [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "AvailabilityZone", x, [])
  }
  if let Some(x) = v.preferred_maintenance_window {
    xmlv.elem(w, "PreferredMaintenanceWindow", x, [])
  }
  if let Some(x) = v.pending_modified_values {
    xml_write_pending_modified_values(w, x, "PendingModifiedValues", [])
