/// Calls ListReports until the ReportSucceeded acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (120s).
pub fn wait_until_report_succeeded(c: Client, input: ListReportsRequest, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[ListReportsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.list_reports(input) {
      Ok(out) => {
        let o = jmes_of_list_reports_response(out)
        if state == "" && waiter.path_matches(o, "length(reportGenerationResults[]) == `0`", "booleanEquals", "true") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "reportGenerationResults[].status", "allStringEquals", "SUCCEEDED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "reportGenerationResults[].status", "anyStringEquals", "FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ReportSucceeded: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
