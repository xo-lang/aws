fn from_json_exadb_vm_cluster_list(v: json.Value) -> List[ExadbVmClusterSummary] ! Str {
  var out: List[ExadbVmClusterSummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
