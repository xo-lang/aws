  /// result is complete; error means the category could not be read.
  pub status: DiffStatus? = None
  /// The number of items that are identical on both domains.
  pub in_sync: Int? = None
  /// The number of items that exist only on the source domain.
  pub source_only: Int? = None
  /// The number of items that exist only on the target domain.
  pub target_only: Int? = None
  /// The number of items that exist on both domains but differ.
  pub diverged: Int? = None
  /// The names of the items that differ, and for diverging items, the fields
  /// that differ.
  pub items: DiffItems? = None
  /// Whether Items omits some differences because the category contained more
  /// than the response can carry. The counts remain complete when this is
  /// true .
  pub truncated: Bool? = None
}

/// Container for information about a configuration change happening on a
/// domain.
pub struct ChangeProgressDetails {
  /// The ID of the configuration change.
  pub change_id: Str? = None
  /// A message corresponding to the status of the configuration change.
  pub message: Str? = None
  /// The current status of the configuration change.
  pub config_change_status: ConfigChangeStatus? = None
  /// The IAM principal who initiated the configuration change.
  pub initiated_by: InitiatedBy? = None
  /// The time that the configuration change was initiated, in Universal
  /// Coordinated Time (UTC).
  pub start_time: Time? = None
  /// The last time that the configuration change was updated.
  pub last_updated_time: Time? = None
}

/// Progress details for each stage of a domain update.
pub struct ChangeProgressStage {
  /// The name of the stage.
  pub name: Str? = None
  /// The status of the stage.
  pub status: Str? = None
  /// The description of the stage.
  pub description: Str? = None
  /// The most recent updated timestamp of the stage.
  pub last_updated: Time? = None
}

/// The progress details of a specific domain configuration change.
pub struct ChangeProgressStatusDetails {
  /// The unique change identifier associated with a specific domain
  /// configuration change.
  pub change_id: Str? = None
  /// The time at which the configuration change is made on the domain.
  pub start_time: Time? = None
  /// The overall status of the domain configuration change.
  pub status: OverallChangeStatus? = None
  /// The list of properties in the domain configuration change that are still
  /// pending.
  pub pending_properties: List[Str]? = None
  /// The list of properties in the domain configuration change that have
  /// completed.
  pub completed_properties: List[Str]? = None
  /// The total number of stages required for the configuration change.
  pub total_number_of_stages: Int? = None
  /// The specific stages that the domain is going through to perform the
  /// configuration change.
  pub change_progress_stages: List[ChangeProgressStage]? = None
  /// The last time that the status of the configuration change was updated.
  pub last_updated_time: Time? = None
  /// The current status of the configuration change.
  pub config_change_status: ConfigChangeStatus? = None
  /// The IAM principal who initiated the configuration change.
  pub initiated_by: InitiatedBy? = None
  /// The validation failures that occurred as a result of the configuration
  /// change.
  pub validation_failures: List[ValidationFailure]? = None
  /// The list of advisory warning codes that were accepted for the
  /// configuration change.
  pub accepted_warnings: List[Str]? = None
}

/// Configuration details for a CloudWatch Logs data source that can be used
/// for direct queries.
pub struct CloudWatchDirectQueryDataSource {
  /// The unique identifier of the IAM role that grants OpenSearch Service
  /// permission to access the specified data source.
  pub role_arn: Str? = None
}

/// Container for the cluster configuration of an OpenSearch Service domain.
/// For more information, see Creating and managing Amazon OpenSearch
/// Service domains .
pub struct ClusterConfig {
  /// Instance type of data nodes in the cluster.
  pub instance_type: OpenSearchPartitionInstanceType? = None
  /// Number of data nodes in the cluster. This number must be greater than 1,
  /// otherwise you receive a validation exception.
  pub instance_count: Int? = None
  /// Indicates whether dedicated master nodes are enabled for the cluster.
  /// True if the cluster will use a dedicated master node. False if the
  /// cluster will not.
  pub dedicated_master_enabled: Bool? = None
  /// Indicates whether multiple Availability Zones are enabled. For more
  /// information, see Configuring a multi-AZ domain in Amazon OpenSearch
  /// Service .
  pub zone_awareness_enabled: Bool? = None
  /// Container for zone awareness configuration options. Only required if
  /// ZoneAwarenessEnabled is true .
  pub zone_awareness_config: ZoneAwarenessConfig? = None
  /// OpenSearch Service instance type of the dedicated master nodes in the
  /// cluster.
  pub dedicated_master_type: OpenSearchPartitionInstanceType? = None
  /// Number of dedicated master nodes in the cluster. This number must be
  /// greater than 2 and not 4, otherwise you receive a validation exception.
  pub dedicated_master_count: Int? = None
  /// Whether to enable warm storage for the cluster.
  pub warm_enabled: Bool? = None
  /// The instance type for the cluster's warm nodes.
  pub warm_type: OpenSearchWarmPartitionInstanceType? = None
  /// The number of warm nodes in the cluster.
  pub warm_count: Int? = None
  /// Container for cold storage configuration options.
  pub cold_storage_options: ColdStorageOptions? = None
  /// A boolean that indicates whether a multi-AZ domain is turned on with a
  /// standby AZ. For more information, see Configuring a multi-AZ domain in
  /// Amazon OpenSearch Service .
  pub multi_az_with_standby_enabled: Bool? = None
  /// List of node options for the domain.
  pub node_options: List[NodeOption]? = None
}

/// The cluster configuration status for a domain.
pub struct ClusterConfigStatus {
  /// Cluster configuration options for the specified domain.
  pub options: ClusterConfig? = None
  /// The status of cluster configuration options for the specified domain.
  pub status: OptionStatus? = None
}

