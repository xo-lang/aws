    xml_write_instance_network_interface_list(w, x, "networkInterfaceSet", [])
  }
  if let Some(x) = v.outpost_arn {
    xmlv.elem(w, "outpostArn", x, [])
  }
  if let Some(x) = v.root_device_name {
    xmlv.elem(w, "rootDeviceName", x, [])
  }
  if let Some(x) = v.root_device_type {
    xmlv.elem(w, "rootDeviceType", x.value(), [])
  }
  if let Some(x) = v.security_groups {
    xml_write_group_identifier_list(w, x, "groupSet", [])
  }
  if let Some(x) = v.source_dest_check {
    xmlv.elem(w, "sourceDestCheck", "${x}", [])
  }
  if let Some(x) = v.spot_instance_request_id {
    xmlv.elem(w, "spotInstanceRequestId", x, [])
  }
  if let Some(x) = v.sriov_net_support {
    xmlv.elem(w, "sriovNetSupport", x, [])
  }
