  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateScheduleErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_schedule_error(resp))
  }
  deserialize_update_schedule(resp) ?? e => Err(UpdateScheduleErr.Deserialize(e))
}
