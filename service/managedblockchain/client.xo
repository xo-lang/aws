/// The errors of CreateAccessor.
pub enum CreateAccessorErr {
  AccessDeniedException(e: AccessDeniedException)
  InternalServiceErrorException(e: InternalServiceErrorException)
  InvalidRequestException(e: InvalidRequestException)
  ResourceAlreadyExistsException(e: ResourceAlreadyExistsException)
  ResourceLimitExceededException(e: ResourceLimitExceededException)
  ThrottlingException(e: ThrottlingException)
  TooManyTagsException(e: TooManyTagsException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: CreateAccessorErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    InternalServiceErrorException(x) => "InternalServiceErrorException: ${x:?}"
    InvalidRequestException(x) => "InvalidRequestException: ${x:?}"
    ResourceAlreadyExistsException(x) => "ResourceAlreadyExistsException: ${x:?}"
    ResourceLimitExceededException(x) => "ResourceLimitExceededException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    TooManyTagsException(x) => "TooManyTagsException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_create_accessor_error(resp: http.Response) -> CreateAccessorErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return CreateAccessorErr.AccessDeniedException(x)
      Err(msg) => return CreateAccessorErr.Deserialize(msg)
    }
    "InternalServiceErrorException" => match read_error_internal_service_error_exception(resp, body) {
      Ok(x) => return CreateAccessorErr.InternalServiceErrorException(x)
      Err(msg) => return CreateAccessorErr.Deserialize(msg)
    }
    "InvalidRequestException" => match read_error_invalid_request_exception(resp, body) {
      Ok(x) => return CreateAccessorErr.InvalidRequestException(x)
      Err(msg) => return CreateAccessorErr.Deserialize(msg)
    }
    "ResourceAlreadyExistsException" => match read_error_resource_already_exists_exception(resp, body) {
      Ok(x) => return CreateAccessorErr.ResourceAlreadyExistsException(x)
      Err(msg) => return CreateAccessorErr.Deserialize(msg)
    }
    "ResourceLimitExceededException" => match read_error_resource_limit_exceeded_exception(resp, body) {
      Ok(x) => return CreateAccessorErr.ResourceLimitExceededException(x)
      Err(msg) => return CreateAccessorErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return CreateAccessorErr.ThrottlingException(x)
      Err(msg) => return CreateAccessorErr.Deserialize(msg)
    }
    "TooManyTagsException" => match read_error_too_many_tags_exception(resp, body) {
      Ok(x) => return CreateAccessorErr.TooManyTagsException(x)
      Err(msg) => return CreateAccessorErr.Deserialize(msg)
    }
