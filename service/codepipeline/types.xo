}

/// Represents the input of a CreateCustomActionType operation.
pub struct CreateCustomActionTypeInput {
  /// The category of the custom action, such as a build action or a test
  /// action.
  pub category: ActionCategory? = None
  /// The provider of the service used in the custom action, such as
  /// CodeDeploy.
  pub provider: Str? = None
  /// The version identifier of the custom action.
  pub version: Str? = None
  /// URLs that provide users information about this custom action.
  pub settings: ActionTypeSettings? = None
  /// The configuration properties for the custom action. You can refer to a
  /// name in the configuration properties of the custom action within the URL
  /// templates by following the format of {Config:name}, as long as the
  /// configuration property is both required and not secret. For more
  /// information, see Create a Custom Action for a Pipeline .
  pub configuration_properties: List[ActionConfigurationProperty]? = None
  /// The details of the input artifact for the action, such as its commit ID.
  pub input_artifact_details: ArtifactDetails? = None
  /// The details of the output artifact of the action, such as its commit ID.
  pub output_artifact_details: ArtifactDetails? = None
  /// The tags for the custom action.
  pub tags: List[Tag]? = None
}

/// Represents the output of a CreateCustomActionType operation.
pub struct CreateCustomActionTypeOutput {
  /// Returns information about the details of an action type.
  pub action_type: ActionType? = None
  /// Specifies the tags applied to the custom action.
  pub tags: List[Tag]? = None
}

