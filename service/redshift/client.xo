fn xml_write_namespace_identifier_union(var w: xmlv.Writer, v: NamespaceIdentifierUnion, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    ServerlessIdentifier(x) => {
      xml_write_serverless_identifier(w, x, "ServerlessIdentifier", [])
    }
    ProvisionedIdentifier(x) => {
      xml_write_provisioned_identifier(w, x, "ProvisionedIdentifier", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_namespace_identifier_union(e: xml.Element) -> NamespaceIdentifierUnion ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "ServerlessIdentifier" => Ok(NamespaceIdentifierUnion.ServerlessIdentifier(xml_read_serverless_identifier(c)?))
      "ProvisionedIdentifier" => Ok(NamespaceIdentifierUnion.ProvisionedIdentifier(xml_read_provisioned_identifier(c)?))
      _ => Ok(NamespaceIdentifierUnion.Unknown(c.name.local))
    }
  }
  Err("NamespaceIdentifierUnion: no member set")
}

