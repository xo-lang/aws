  }
  if let Some(x) = v.service_update_recommended_apply_by_date {
    query.add(f, query.key(prefix, "ServiceUpdateRecommendedApplyByDate"), rest.date_time(x))
  }
  if let Some(x) = v.service_update_type {
    query.add(f, query.key(prefix, "ServiceUpdateType"), x.value())
  }
  if let Some(x) = v.update_action_available_date {
