  Integer = "INTEGER"
  Unknown(value: Str)
}

/// Hls Media Store Settings
pub struct HlsMediaStoreSettings {
  /// Number of seconds to wait before retrying connection to the CDN if the
  /// connection is lost.
  pub connection_retry_interval: Int? = None
  /// Size in seconds of file cache for streaming outputs.
  pub filecache_duration: Int? = None
  /// When set to temporal, output files are stored in non-persistent memory
  /// for faster reading and writing.
  pub media_store_storage_class: HlsMediaStoreStorageClass? = None
  /// Number of retry attempts that will be made before the Live Event is put
  /// into an error state. Applies only if the CDN destination URI begins with
  /// "s3" or "mediastore". For other URIs, the value is always 3.
  pub num_retries: Int? = None
  /// If a streaming output fails, number of seconds to wait until a restart
  /// is initiated. A value of 0 means never restart.
  pub restart_delay: Int? = None
}

/// Hls Media Store Storage Class
pub enum HlsMediaStoreStorageClass: Str {
  Temporal = "TEMPORAL"
  Unknown(value: Str)
}

