fn json_of_harness_hook_target(v: HarnessHookTarget) -> json.Value {
  match v {
    Lambda(x) => json.Value.Object([("lambda", json_of_harness_hook_lambda_target(x))])
    Sns(x) => json.Value.Object([("sns", json_of_harness_hook_sns_target(x))])
    EventBridge(x) => json.Value.Object([("eventBridge", json_of_harness_hook_event_bridge_target(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_harness_hook_target(v: json.Value) -> HarnessHookTarget ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "lambda" => Ok(HarnessHookTarget.Lambda(from_json_harness_hook_lambda_target(fv)?))
      "sns" => Ok(HarnessHookTarget.Sns(from_json_harness_hook_sns_target(fv)?))
      "eventBridge" => Ok(HarnessHookTarget.EventBridge(from_json_harness_hook_event_bridge_target(fv)?))
      _ => Ok(HarnessHookTarget.Unknown(k))
    }
  }
  Err("HarnessHookTarget: no member set")
}

fn json_of_harness_hooks(v: List[HarnessHook]) -> json.Value {
  json.Value.List(v.map(fn(x: HarnessHook) -> json.Value { json_of_harness_hook(x) }))
}

fn from_json_harness_hooks(v: json.Value) -> List[HarnessHook] ! Str {
  var out: List[HarnessHook] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_harness_hook(fv)?)
  }
  Ok(out)
}

