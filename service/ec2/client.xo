fn xml_read_snapshot(e: xml.Element) -> Snapshot ! Str {
  var out = Snapshot{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ownerAlias" => out.owner_alias = c.text()
      "outpostArn" => out.outpost_arn = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "storageTier" => out.storage_tier = StorageTier.from(c.text())
      "restoreExpiryTime" => out.restore_expiry_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "sseType" => out.sse_type = SSEType.from(c.text())
      "availabilityZone" => out.availability_zone = c.text()
      "transferType" => out.transfer_type = TransferType.from(c.text())
      "completionDurationMinutes" => out.completion_duration_minutes = xmlv.read_int(c.text())?
      "completionTime" => out.completion_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "fullSnapshotSizeInBytes" => out.full_snapshot_size_in_bytes = xmlv.read_int(c.text())?
      "snapshotId" => out.snapshot_id = c.text()
      "volumeId" => out.volume_id = c.text()
      "status" => out.state = SnapshotState.from(c.text())
      "statusMessage" => out.state_message = c.text()
      "startTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "progress" => out.progress = c.text()
      "ownerId" => out.owner_id = c.text()
      "description" => out.description = c.text()
      "volumeSize" => out.volume_size = xmlv.read_int(c.text())?
      "encrypted" => out.encrypted = xmlv.read_bool(c.text())?
      "kmsKeyId" => out.kms_key_id = c.text()
      "dataEncryptionKeyId" => out.data_encryption_key_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

