fn xml_write_replication_group(var w: xmlv.Writer, v: ReplicationGroup, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.replication_group_id {
    xmlv.elem(w, "ReplicationGroupId", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.global_replication_group_info {
    xml_write_global_replication_group_info(w, x, "GlobalReplicationGroupInfo", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.pending_modified_values {
    xml_write_replication_group_pending_modified_values(w, x, "PendingModifiedValues", [])
  }
  if let Some(x) = v.member_clusters {
    xml_write_cluster_id_list(w, x, "MemberClusters", [])
  }
  if let Some(x) = v.node_groups {
    xml_write_node_group_list(w, x, "NodeGroups", [])
  }
  if let Some(x) = v.snapshotting_cluster_id {
    xmlv.elem(w, "SnapshottingClusterId", x, [])
  }
  if let Some(x) = v.automatic_failover {
    xmlv.elem(w, "AutomaticFailover", x.value(), [])
  }
  if let Some(x) = v.multi_az {
    xmlv.elem(w, "MultiAZ", x.value(), [])
  }
  if let Some(x) = v.configuration_endpoint {
    xml_write_endpoint(w, x, "ConfigurationEndpoint", [])
  }
  if let Some(x) = v.snapshot_retention_limit {
    xmlv.elem(w, "SnapshotRetentionLimit", "${x}", [])
  }
  if let Some(x) = v.snapshot_window {
    xmlv.elem(w, "SnapshotWindow", x, [])
  }
  if let Some(x) = v.cluster_enabled {
    xmlv.elem(w, "ClusterEnabled", "${x}", [])
  }
  if let Some(x) = v.cache_node_type {
    xmlv.elem(w, "CacheNodeType", x, [])
  }
  if let Some(x) = v.auth_token_enabled {
    xmlv.elem(w, "AuthTokenEnabled", "${x}", [])
  }
  if let Some(x) = v.auth_token_last_modified_date {
    xmlv.elem(w, "AuthTokenLastModifiedDate", rest.date_time(x), [])
  }
  if let Some(x) = v.transit_encryption_enabled {
    xmlv.elem(w, "TransitEncryptionEnabled", "${x}", [])
  }
  if let Some(x) = v.at_rest_encryption_enabled {
    xmlv.elem(w, "AtRestEncryptionEnabled", "${x}", [])
  }
  if let Some(x) = v.member_clusters_outpost_arns {
    xml_write_replication_group_outpost_arn_list(w, x, "MemberClustersOutpostArns", [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KmsKeyId", x, [])
  }
  if let Some(x) = v.storage_encryption_type {
    xmlv.elem(w, "StorageEncryptionType", x.value(), [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "ARN", x, [])
  }
  if let Some(x) = v.user_group_ids {
    xml_write_user_group_id_list(w, x, "UserGroupIds", [])
  }
  if let Some(x) = v.log_delivery_configurations {
    xml_write_log_delivery_configuration_list(w, x, "LogDeliveryConfigurations", [])
  }
  if let Some(x) = v.replication_group_create_time {
    xmlv.elem(w, "ReplicationGroupCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.data_tiering {
    xmlv.elem(w, "DataTiering", x.value(), [])
  }
  if let Some(x) = v.auto_minor_version_upgrade {
    xmlv.elem(w, "AutoMinorVersionUpgrade", "${x}", [])
  }
  if let Some(x) = v.network_type {
    xmlv.elem(w, "NetworkType", x.value(), [])
  }
  if let Some(x) = v.ip_discovery {
    xmlv.elem(w, "IpDiscovery", x.value(), [])
  }
  if let Some(x) = v.transit_encryption_mode {
    xmlv.elem(w, "TransitEncryptionMode", x.value(), [])
  }
  if let Some(x) = v.cluster_mode {
    xmlv.elem(w, "ClusterMode", x.value(), [])
  }
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.durability {
    xmlv.elem(w, "Durability", x.value(), [])
  }
  if let Some(x) = v.effective_durability {
    xmlv.elem(w, "EffectiveDurability", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_replication_group(e: xml.Element) -> ReplicationGroup ! Str {
  var out = ReplicationGroup{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ReplicationGroupId" => out.replication_group_id = c.text()
      "Description" => out.description = c.text()
      "GlobalReplicationGroupInfo" => out.global_replication_group_info = xml_read_global_replication_group_info(c)?
      "Status" => out.status = c.text()
      "PendingModifiedValues" => out.pending_modified_values = xml_read_replication_group_pending_modified_values(c)?
      "MemberClusters" => out.member_clusters = xml_read_cluster_id_list(c)?
      "NodeGroups" => out.node_groups = xml_read_node_group_list(c)?
      "SnapshottingClusterId" => out.snapshotting_cluster_id = c.text()
      "AutomaticFailover" => out.automatic_failover = AutomaticFailoverStatus.from(c.text())
      "MultiAZ" => out.multi_az = MultiAZStatus.from(c.text())
      "ConfigurationEndpoint" => out.configuration_endpoint = xml_read_endpoint(c)?
      "SnapshotRetentionLimit" => out.snapshot_retention_limit = xmlv.read_int(c.text())?
      "SnapshotWindow" => out.snapshot_window = c.text()
      "ClusterEnabled" => out.cluster_enabled = xmlv.read_bool(c.text())?
      "CacheNodeType" => out.cache_node_type = c.text()
      "AuthTokenEnabled" => out.auth_token_enabled = xmlv.read_bool(c.text())?
      "AuthTokenLastModifiedDate" => out.auth_token_last_modified_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "TransitEncryptionEnabled" => out.transit_encryption_enabled = xmlv.read_bool(c.text())?
      "AtRestEncryptionEnabled" => out.at_rest_encryption_enabled = xmlv.read_bool(c.text())?
      "MemberClustersOutpostArns" => out.member_clusters_outpost_arns = xml_read_replication_group_outpost_arn_list(c)?
      "KmsKeyId" => out.kms_key_id = c.text()
      "StorageEncryptionType" => out.storage_encryption_type = StorageEncryptionType.from(c.text())
      "ARN" => out.arn = c.text()
      "UserGroupIds" => out.user_group_ids = xml_read_user_group_id_list(c)?
      "LogDeliveryConfigurations" => out.log_delivery_configurations = xml_read_log_delivery_configuration_list(c)?
      "ReplicationGroupCreateTime" => out.replication_group_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DataTiering" => out.data_tiering = DataTieringStatus.from(c.text())
      "AutoMinorVersionUpgrade" => out.auto_minor_version_upgrade = xmlv.read_bool(c.text())?
      "NetworkType" => out.network_type = NetworkType.from(c.text())
      "IpDiscovery" => out.ip_discovery = IpDiscovery.from(c.text())
      "TransitEncryptionMode" => out.transit_encryption_mode = TransitEncryptionMode.from(c.text())
      "ClusterMode" => out.cluster_mode = ClusterMode.from(c.text())
      "Engine" => out.engine = c.text()
      "Durability" => out.durability = Durability.from(c.text())
      "EffectiveDurability" => out.effective_durability = EffectiveDurability.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

