fn xml_write_tunnel_option(var w: xmlv.Writer, v: TunnelOption, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.outside_ip_address {
    xmlv.elem(w, "outsideIpAddress", x, [])
  }
  if let Some(x) = v.tunnel_inside_cidr {
    xmlv.elem(w, "tunnelInsideCidr", x, [])
  }
  if let Some(x) = v.tunnel_inside_ipv6_cidr {
    xmlv.elem(w, "tunnelInsideIpv6Cidr", x, [])
  }
  if let Some(x) = v.pre_shared_key {
    xmlv.elem(w, "preSharedKey", x, [])
  }
  if let Some(x) = v.phase1_lifetime_seconds {
    xmlv.elem(w, "phase1LifetimeSeconds", "${x}", [])
  }
  if let Some(x) = v.phase2_lifetime_seconds {
    xmlv.elem(w, "phase2LifetimeSeconds", "${x}", [])
  }
  if let Some(x) = v.rekey_margin_time_seconds {
    xmlv.elem(w, "rekeyMarginTimeSeconds", "${x}", [])
  }
  if let Some(x) = v.rekey_fuzz_percentage {
    xmlv.elem(w, "rekeyFuzzPercentage", "${x}", [])
  }
  if let Some(x) = v.replay_window_size {
    xmlv.elem(w, "replayWindowSize", "${x}", [])
  }
  if let Some(x) = v.dpd_timeout_seconds {
    xmlv.elem(w, "dpdTimeoutSeconds", "${x}", [])
  }
  if let Some(x) = v.dpd_timeout_action {
    xmlv.elem(w, "dpdTimeoutAction", x, [])
  }
  if let Some(x) = v.phase1_encryption_algorithms {
    xml_write_phase1_encryption_algorithms_list(w, x, "phase1EncryptionAlgorithmSet", [])
  }
  if let Some(x) = v.phase2_encryption_algorithms {
    xml_write_phase2_encryption_algorithms_list(w, x, "phase2EncryptionAlgorithmSet", [])
  }
  if let Some(x) = v.phase1_integrity_algorithms {
    xml_write_phase1_integrity_algorithms_list(w, x, "phase1IntegrityAlgorithmSet", [])
  }
  if let Some(x) = v.phase2_integrity_algorithms {
    xml_write_phase2_integrity_algorithms_list(w, x, "phase2IntegrityAlgorithmSet", [])
  }
  if let Some(x) = v.phase1_dh_group_numbers {
    xml_write_phase1_dh_group_numbers_list(w, x, "phase1DHGroupNumberSet", [])
  }
  if let Some(x) = v.phase2_dh_group_numbers {
    xml_write_phase2_dh_group_numbers_list(w, x, "phase2DHGroupNumberSet", [])
  }
  if let Some(x) = v.ike_versions {
    xml_write_ike_versions_list(w, x, "ikeVersionSet", [])
  }
  if let Some(x) = v.startup_action {
    xmlv.elem(w, "startupAction", x, [])
  }
  if let Some(x) = v.log_options {
    xml_write_vpn_tunnel_log_options(w, x, "logOptions", [])
  }
  if let Some(x) = v.enable_tunnel_lifecycle_control {
    xmlv.elem(w, "enableTunnelLifecycleControl", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_tunnel_option(e: xml.Element) -> TunnelOption ! Str {
  var out = TunnelOption{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "outsideIpAddress" => out.outside_ip_address = c.text()
      "tunnelInsideCidr" => out.tunnel_inside_cidr = c.text()
      "tunnelInsideIpv6Cidr" => out.tunnel_inside_ipv6_cidr = c.text()
      "preSharedKey" => out.pre_shared_key = c.text()
      "phase1LifetimeSeconds" => out.phase1_lifetime_seconds = xmlv.read_int(c.text())?
      "phase2LifetimeSeconds" => out.phase2_lifetime_seconds = xmlv.read_int(c.text())?
      "rekeyMarginTimeSeconds" => out.rekey_margin_time_seconds = xmlv.read_int(c.text())?
      "rekeyFuzzPercentage" => out.rekey_fuzz_percentage = xmlv.read_int(c.text())?
      "replayWindowSize" => out.replay_window_size = xmlv.read_int(c.text())?
      "dpdTimeoutSeconds" => out.dpd_timeout_seconds = xmlv.read_int(c.text())?
      "dpdTimeoutAction" => out.dpd_timeout_action = c.text()
      "phase1EncryptionAlgorithmSet" => out.phase1_encryption_algorithms = xml_read_phase1_encryption_algorithms_list(c)?
      "phase2EncryptionAlgorithmSet" => out.phase2_encryption_algorithms = xml_read_phase2_encryption_algorithms_list(c)?
      "phase1IntegrityAlgorithmSet" => out.phase1_integrity_algorithms = xml_read_phase1_integrity_algorithms_list(c)?
      "phase2IntegrityAlgorithmSet" => out.phase2_integrity_algorithms = xml_read_phase2_integrity_algorithms_list(c)?
      "phase1DHGroupNumberSet" => out.phase1_dh_group_numbers = xml_read_phase1_dh_group_numbers_list(c)?
      "phase2DHGroupNumberSet" => out.phase2_dh_group_numbers = xml_read_phase2_dh_group_numbers_list(c)?
      "ikeVersionSet" => out.ike_versions = xml_read_ike_versions_list(c)?
      "startupAction" => out.startup_action = c.text()
      "logOptions" => out.log_options = xml_read_vpn_tunnel_log_options(c)?
      "enableTunnelLifecycleControl" => out.enable_tunnel_lifecycle_control = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_tunnel_options_list(var w: xmlv.Writer, v: List[TunnelOption], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
