fn xml_write_service_configuration(var w: xmlv.Writer, v: ServiceConfiguration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.service_type {
    xml_write_service_type_detail_set(w, x, "serviceType", [])
  }
  if let Some(x) = v.service_id {
    xmlv.elem(w, "serviceId", x, [])
  }
  if let Some(x) = v.service_name {
    xmlv.elem(w, "serviceName", x, [])
  }
  if let Some(x) = v.service_state {
    xmlv.elem(w, "serviceState", x.value(), [])
  }
  if let Some(x) = v.availability_zone_ids {
    xml_write_value_string_list(w, x, "availabilityZoneIdSet", [])
  }
  if let Some(x) = v.availability_zones {
    xml_write_value_string_list(w, x, "availabilityZoneSet", [])
  }
  if let Some(x) = v.acceptance_required {
    xmlv.elem(w, "acceptanceRequired", "${x}", [])
  }
  if let Some(x) = v.manages_vpc_endpoints {
    xmlv.elem(w, "managesVpcEndpoints", "${x}", [])
  }
  if let Some(x) = v.network_load_balancer_arns {
    xml_write_value_string_list(w, x, "networkLoadBalancerArnSet", [])
  }
  if let Some(x) = v.gateway_load_balancer_arns {
    xml_write_value_string_list(w, x, "gatewayLoadBalancerArnSet", [])
  }
  if let Some(x) = v.supported_ip_address_types {
    xml_write_supported_ip_address_types(w, x, "supportedIpAddressTypeSet", [])
  }
  if let Some(x) = v.base_endpoint_dns_names {
    xml_write_value_string_list(w, x, "baseEndpointDnsNameSet", [])
  }
  if let Some(x) = v.private_dns_name {
    xmlv.elem(w, "privateDnsName", x, [])
  }
  if let Some(x) = v.private_dns_name_configuration {
    xml_write_private_dns_name_configuration(w, x, "privateDnsNameConfiguration", [])
  }
  if let Some(x) = v.payer_responsibility {
    xmlv.elem(w, "payerResponsibility", x.value(), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.supported_regions {
    xml_write_supported_region_set(w, x, "supportedRegionSet", [])
  }
  if let Some(x) = v.remote_access_enabled {
    xmlv.elem(w, "remoteAccessEnabled", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_service_configuration(e: xml.Element) -> ServiceConfiguration ! Str {
  var out = ServiceConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "serviceType" => out.service_type = xml_read_service_type_detail_set(c)?
      "serviceId" => out.service_id = c.text()
      "serviceName" => out.service_name = c.text()
      "serviceState" => out.service_state = ServiceState.from(c.text())
      "availabilityZoneIdSet" => out.availability_zone_ids = xml_read_value_string_list(c)?
      "availabilityZoneSet" => out.availability_zones = xml_read_value_string_list(c)?
      "acceptanceRequired" => out.acceptance_required = xmlv.read_bool(c.text())?
      "managesVpcEndpoints" => out.manages_vpc_endpoints = xmlv.read_bool(c.text())?
      "networkLoadBalancerArnSet" => out.network_load_balancer_arns = xml_read_value_string_list(c)?
      "gatewayLoadBalancerArnSet" => out.gateway_load_balancer_arns = xml_read_value_string_list(c)?
      "supportedIpAddressTypeSet" => out.supported_ip_address_types = xml_read_supported_ip_address_types(c)?
      "baseEndpointDnsNameSet" => out.base_endpoint_dns_names = xml_read_value_string_list(c)?
      "privateDnsName" => out.private_dns_name = c.text()
      "privateDnsNameConfiguration" => out.private_dns_name_configuration = xml_read_private_dns_name_configuration(c)?
      "payerResponsibility" => out.payer_responsibility = PayerResponsibility.from(c.text())
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "supportedRegionSet" => out.supported_regions = xml_read_supported_region_set(c)?
      "remoteAccessEnabled" => out.remote_access_enabled = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_service_configuration_set(var w: xmlv.Writer, v: List[ServiceConfiguration], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_service_configuration(w, item, "item", [])
  }
  xmlv.end(w, name)
}

fn xml_read_service_configuration_set(e: xml.Element) -> List[ServiceConfiguration] ! Str {
  var out: List[ServiceConfiguration] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_service_configuration(c)?)
  }
  Ok(out)
}

