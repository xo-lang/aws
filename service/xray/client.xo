      continue
    }
    return match k {
      "Probabilistic" => Ok(IndexingRuleValue.Probabilistic(from_json_probabilistic_rule_value(fv)?))
      _ => Ok(IndexingRuleValue.Unknown(k))
    }
  }
  Err("IndexingRuleValue: no member set")
}

