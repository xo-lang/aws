fn query_put_add_role_to_db_cluster_message(var f: query.Form, prefix: Str, v: AddRoleToDBClusterMessage) {
  if let Some(x) = v.db_cluster_identifier {
    query.add(f, query.key(prefix, "DBClusterIdentifier"), x)
  }
  if let Some(x) = v.role_arn {
    query.add(f, query.key(prefix, "RoleArn"), x)
  }
  if let Some(x) = v.feature_name {
    query.add(f, query.key(prefix, "FeatureName"), x)
