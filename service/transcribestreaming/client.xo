fn event_message_medical_scribe_input_stream(v: MedicalScribeInputStream) -> eventstream.Message {
  match v {
    AudioEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("AudioEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/octet-stream")})
      eventstream.Message{headers: hs, payload: x.audio_chunk ?? b""}
    }
    SessionControlEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("SessionControlEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.type_value {
        fs.push(("Type", json.Value.Str(y.value())))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    ConfigurationEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("ConfigurationEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.vocabulary_name {
        fs.push(("VocabularyName", json.Value.Str(y)))
      }
      if let Some(y) = x.vocabulary_filter_name {
        fs.push(("VocabularyFilterName", json.Value.Str(y)))
      }
      if let Some(y) = x.vocabulary_filter_method {
        fs.push(("VocabularyFilterMethod", json.Value.Str(y.value())))
      }
      if let Some(y) = x.resource_access_role_arn {
        fs.push(("ResourceAccessRoleArn", json.Value.Str(y)))
      }
      if let Some(y) = x.channel_definitions {
        fs.push(("ChannelDefinitions", json_of_medical_scribe_channel_definitions(y)))
      }
      if let Some(y) = x.encryption_settings {
        fs.push(("EncryptionSettings", json_of_medical_scribe_encryption_settings(y)))
      }
      if let Some(y) = x.post_stream_analytics_settings {
        fs.push(("PostStreamAnalyticsSettings", json_of_medical_scribe_post_stream_analytics_settings(y)))
      }
      if let Some(y) = x.medical_scribe_context {
        fs.push(("MedicalScribeContext", json_of_medical_scribe_context(y)))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    Unknown(_) => eventstream.Message{}
  }
}

