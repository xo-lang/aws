  }
  xmlv.end(w, name)
}

fn xml_read_metric_stream_entry(e: xml.Element) -> MetricStreamEntry ! Str {
  var out = MetricStreamEntry{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Arn" => out.arn = c.text()
      "CreationDate" => out.creation_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "LastUpdateDate" => out.last_update_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Name" => out.name = c.text()
      "FirehoseArn" => out.firehose_arn = c.text()
      "State" => out.state = c.text()
      "OutputFormat" => out.output_format = MetricStreamOutputFormat.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

