  /// The number of Amazon S3 objects discovered for ingestion.
  pub objects_discovered: Int? = None
  /// The number of Amazon S3 objects successfully ingested.
  pub objects_ingested: Int? = None
  /// The number of Amazon S3 objects that failed to be ingested.
  pub objects_failed: Int? = None
}

/// Describes SAML options for an OpenSearch Serverless security
/// configuration in the form of a key-value map.
pub struct SamlConfigOptions {
  /// The XML IdP metadata file generated from your identity provider.
  pub metadata: Str? = None
  /// A user attribute for this SAML integration.
  pub user_attribute: Str? = None
  /// The group attribute for this SAML integration.
  pub group_attribute: Str? = None
  /// Custom entity ID attribute to override the default entity ID for this
  /// SAML integration.
  pub open_search_serverless_entity_id: Str? = None
  /// The session timeout, in minutes. Default is 60 minutes (12 hours).
  pub session_timeout: Int? = None
}

/// Details about a security configuration for OpenSearch Serverless.
pub struct SecurityConfigDetail {
  /// The unique identifier of the security configuration.
  pub id: Str? = None
  /// The type of security configuration.
  pub type_value: Str? = None
  /// The version of the security configuration.
  pub config_version: Str? = None
  /// The description of the security configuration.
  pub description: Str? = None
  /// SAML options for the security configuration in the form of a key-value
  /// map.
  pub saml_options: SamlConfigOptions? = None
  /// Describes IAM Identity Center options in the form of a key-value map.
  pub iam_identity_center_options: IamIdentityCenterConfigOptions? = None
  /// Describes IAM federation options in the form of a key-value map.
  /// Contains configuration details about how OpenSearch Serverless
  /// integrates with external identity providers through federation.
  pub iam_federation_options: IamFederationConfigOptions? = None
  /// The date the configuration was created.
  pub created_date: Int? = None
  /// The timestamp of when the configuration was last modified.
  pub last_modified_date: Int? = None
}

/// Statistics for an OpenSearch Serverless security configuration.
pub struct SecurityConfigStats {
  /// The number of security configurations in the current account.
  pub saml_config_count: Int? = None
}

/// A summary of a security configuration for OpenSearch Serverless.
pub struct SecurityConfigSummary {
  /// The unique identifier of the security configuration.
  pub id: Str? = None
  /// The type of security configuration.
  pub type_value: Str? = None
  /// The version of the security configuration.
  pub config_version: Str? = None
  /// The description of the security configuration.
  pub description: Str? = None
  /// The Epoch time when the security configuration was created.
  pub created_date: Int? = None
  /// The timestamp of when the configuration was last modified.
  pub last_modified_date: Int? = None
}

/// Details about an OpenSearch Serverless security policy.
pub struct SecurityPolicyDetail {
