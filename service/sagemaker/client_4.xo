    fs.push(("ProblemType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.target_attribute_name {
    fs.push(("TargetAttributeName", json.Value.Str(x)))
  }
  if let Some(x) = v.sample_weight_attribute_name {
    fs.push(("SampleWeightAttributeName", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_tabular_job_config(v: json.Value) -> TabularJobConfig ! Str {
  var out = TabularJobConfig{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "CandidateGenerationConfig" => out.candidate_generation_config = from_json_candidate_generation_config(fv)?
      "CompletionCriteria" => out.completion_criteria = from_json_auto_ml_job_completion_criteria(fv)?
      "FeatureSpecificationS3Uri" => out.feature_specification_s3_uri = jsonv.read_str(fv)?
      "Mode" => out.mode = AutoMLMode.from(jsonv.read_str(fv)?)
      "GenerateCandidateDefinitionsOnly" => out.generate_candidate_definitions_only = jsonv.read_bool(fv)?
      "ProblemType" => out.problem_type = ProblemType.from(jsonv.read_str(fv)?)
      "TargetAttributeName" => out.target_attribute_name = jsonv.read_str(fv)?
      "SampleWeightAttributeName" => out.sample_weight_attribute_name = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

