fn query_put_map_string_to_string(var f: query.Form, prefix: Str, v: Map[Str, Str], flat: Bool) {
  // sorted keys, as aws-sdk-go-v2 writes them
  for (i, k) in v.keys().sort().indexed() {
    let e = if flat { "${prefix}.${i + 1}" } else { "${prefix}.entry.${i + 1}" }
    query.add(f, "${e}.key", k)
    if let Some(x) = v.get(k) {
      query.add(f, "${e}.value", x)
    }
  }
}

fn query_put_message_attribute_map(var f: query.Form, prefix: Str, v: Map[Str, MessageAttributeValue], flat: Bool) {
  // sorted keys, as aws-sdk-go-v2 writes them
  for (i, k) in v.keys().sort().indexed() {
    let e = if flat { "${prefix}.${i + 1}" } else { "${prefix}.entry.${i + 1}" }
    query.add(f, "${e}.Name", k)
    if let Some(x) = v.get(k) {
      query_put_message_attribute_value(f, "${e}.Value", x)
    }
  }
}

fn query_put_message_attribute_value(var f: query.Form, prefix: Str, v: MessageAttributeValue) {
  if let Some(x) = v.data_type {
    query.add(f, query.key(prefix, "DataType"), x)
  }
  if let Some(x) = v.string_value {
    query.add(f, query.key(prefix, "StringValue"), x)
  }
  if let Some(x) = v.binary_value {
    query.add(f, query.key(prefix, "BinaryValue"), x.to_base64())
  }
}

