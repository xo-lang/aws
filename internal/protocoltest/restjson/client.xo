fn json_of_my_union(v: MyUnion) -> json.Value {
  match v {
    StringValue(x) => json.Value.Object([("stringValue", json.Value.Str(x))])
    BooleanValue(x) => json.Value.Object([("booleanValue", json.Value.Bool(x))])
    NumberValue(x) => json.Value.Object([("numberValue", json.Value.Int(x))])
    BlobValue(x) => json.Value.Object([("blobValue", jsonv.blob(x))])
    TimestampValue(x) => json.Value.Object([("timestampValue", jsonv.time(x, "epoch-seconds"))])
    EnumValue(x) => json.Value.Object([("enumValue", json.Value.Str(x.value()))])
    ListValue(x) => json.Value.Object([("listValue", json_of_string_list(x))])
    MapValue(x) => json.Value.Object([("mapValue", json_of_string_map(x))])
    StructureValue(x) => json.Value.Object([("structureValue", json_of_greeting_struct(x))])
    RenamedStructureValue(x) => json.Value.Object([("renamedStructureValue", json_of_renamed_greeting(x))])
    UnionValue(x) => json.Value.Object([("unionValue", json_of_nested_union(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_my_union(v: json.Value) -> MyUnion ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "stringValue" => Ok(MyUnion.StringValue(jsonv.read_str(fv)?))
      "booleanValue" => Ok(MyUnion.BooleanValue(jsonv.read_bool(fv)?))
      "numberValue" => Ok(MyUnion.NumberValue(jsonv.read_int(fv)?))
      "blobValue" => Ok(MyUnion.BlobValue(jsonv.read_blob(fv)?))
      "timestampValue" => Ok(MyUnion.TimestampValue(jsonv.read_time(fv, "epoch-seconds")?))
      "enumValue" => Ok(MyUnion.EnumValue(FooEnum.from(jsonv.read_str(fv)?)))
      "listValue" => Ok(MyUnion.ListValue(from_json_string_list(fv)?))
      "mapValue" => Ok(MyUnion.MapValue(from_json_string_map(fv)?))
      "structureValue" => Ok(MyUnion.StructureValue(from_json_greeting_struct(fv)?))
      "renamedStructureValue" => Ok(MyUnion.RenamedStructureValue(from_json_renamed_greeting(fv)?))
      "unionValue" => Ok(MyUnion.UnionValue(from_json_nested_union(fv)?))
      _ => Ok(MyUnion.Unknown(k))
    }
  }
  Err("MyUnion: no member set")
}

