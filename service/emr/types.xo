/// An instance type that the specified Amazon EMR release supports.
pub struct SupportedInstanceType {
  /// The Amazon EC2 instance type , for example m5.xlarge , of the
  /// SupportedInstanceType .
  pub type_value: Str? = None
  /// The amount of memory that is available to Amazon EMR from the
  /// SupportedInstanceType . The kernel and hypervisor software consume some
  /// memory, so this value might be lower than the overall memory for the
  /// instance type.
  pub memory_gb: Float? = None
  /// StorageGB represents the storage capacity of the SupportedInstanceType .
  /// This value is 0 for Amazon EBS-only instance types.
  pub storage_gb: Int? = None
  /// The number of vCPUs available for the SupportedInstanceType .
  pub vcpu: Int? = None
  /// Indicates whether the SupportedInstanceType only supports 64-bit
  /// architecture.
  pub is64_bits_only: Bool? = None
  /// The Amazon EC2 family and generation for the SupportedInstanceType .
  pub instance_family_id: Str? = None
  /// Indicates whether the SupportedInstanceType supports Amazon EBS
  /// optimization.
  pub ebs_optimized_available: Bool? = None
  /// Indicates whether the SupportedInstanceType uses Amazon EBS optimization
  /// by default.
  pub ebs_optimized_by_default: Bool? = None
  /// Number of disks for the SupportedInstanceType . This value is 0 for
  /// Amazon EBS-only instance types.
  pub number_of_disks: Int? = None
  /// Indicates whether the SupportedInstanceType only supports Amazon EBS.
  pub ebs_storage_only: Bool? = None
  /// The CPU architecture, for example X86_64 or AARCH64 .
  pub architecture: Str? = None
}

