  Expired = "EXPIRED"
  PageRequired = "PAGE_REQUIRED"
  Unknown(value: Str)
}

/// Summary of a social connection returned by ListSocialConnections.
/// Carries no ARN (owner ruling 2026-10-05): a connection is addressed by
