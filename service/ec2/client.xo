fn xml_write_transit_gateway_options(var w: xmlv.Writer, v: TransitGatewayOptions, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.amazon_side_asn {
    xmlv.elem(w, "amazonSideAsn", "${x}", [])
  }
  if let Some(x) = v.transit_gateway_cidr_blocks {
    xml_write_value_string_list(w, x, "transitGatewayCidrBlocks", [])
  }
  if let Some(x) = v.auto_accept_shared_attachments {
    xmlv.elem(w, "autoAcceptSharedAttachments", x.value(), [])
  }
  if let Some(x) = v.default_route_table_association {
    xmlv.elem(w, "defaultRouteTableAssociation", x.value(), [])
  }
  if let Some(x) = v.association_default_route_table_id {
    xmlv.elem(w, "associationDefaultRouteTableId", x, [])
  }
  if let Some(x) = v.default_route_table_propagation {
    xmlv.elem(w, "defaultRouteTablePropagation", x.value(), [])
  }
  if let Some(x) = v.propagation_default_route_table_id {
    xmlv.elem(w, "propagationDefaultRouteTableId", x, [])
  }
  if let Some(x) = v.vpn_ecmp_support {
    xmlv.elem(w, "vpnEcmpSupport", x.value(), [])
  }
  if let Some(x) = v.dns_support {
    xmlv.elem(w, "dnsSupport", x.value(), [])
  }
  if let Some(x) = v.security_group_referencing_support {
    xmlv.elem(w, "securityGroupReferencingSupport", x.value(), [])
  }
  if let Some(x) = v.multicast_support {
    xmlv.elem(w, "multicastSupport", x.value(), [])
  }
  if let Some(x) = v.encryption_support {
    xml_write_encryption_support(w, x, "encryptionSupport", [])
  }
  xmlv.end(w, name)
}

fn xml_read_transit_gateway_options(e: xml.Element) -> TransitGatewayOptions ! Str {
  var out = TransitGatewayOptions{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "amazonSideAsn" => out.amazon_side_asn = xmlv.read_int(c.text())?
      "transitGatewayCidrBlocks" => out.transit_gateway_cidr_blocks = xml_read_value_string_list(c)?
      "autoAcceptSharedAttachments" => out.auto_accept_shared_attachments = AutoAcceptSharedAttachmentsValue.from(c.text())
      "defaultRouteTableAssociation" => out.default_route_table_association = DefaultRouteTableAssociationValue.from(c.text())
      "associationDefaultRouteTableId" => out.association_default_route_table_id = c.text()
