fn query_put_enable_fast_launch_result(var f: query.Form, prefix: Str, v: EnableFastLaunchResult) {
  if let Some(x) = v.image_id {
    query.add(f, query.key(prefix, "ImageId"), x)
  }
  if let Some(x) = v.resource_type {
    query.add(f, query.key(prefix, "ResourceType"), x.value())
  }
  if let Some(x) = v.snapshot_configuration {
    query_put_fast_launch_snapshot_configuration_response(f, query.key(prefix, "SnapshotConfiguration"), x)
  }
  if let Some(x) = v.launch_template {
    query_put_fast_launch_launch_template_specification_response(f, query.key(prefix, "LaunchTemplate"), x)
  }
  if let Some(x) = v.max_parallel_launches {
    query.add(f, query.key(prefix, "MaxParallelLaunches"), "${x}")
  }
  if let Some(x) = v.owner_id {
    query.add(f, query.key(prefix, "OwnerId"), x)
  }
  if let Some(x) = v.state {
    query.add(f, query.key(prefix, "State"), x.value())
  }
  if let Some(x) = v.state_transition_reason {
    query.add(f, query.key(prefix, "StateTransitionReason"), x)
