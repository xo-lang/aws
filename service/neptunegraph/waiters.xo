      Ok(out) => {
        let o = jmes_of_get_import_task_output(out)
        if state == "" && waiter.path_matches(o, "status != 'CANCELLING' && status != 'CANCELLED'", "booleanEquals", "true") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "CANCELLED") {
          state = "success"
        }
