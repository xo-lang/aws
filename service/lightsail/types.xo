}

/// Describes the full details of an Amazon Lightsail SSL/TLS certificate.
/// To get a summary of a certificate, use the GetCertificates action and
/// omit includeCertificateDetails from your request. The response will
/// include only the certificate Amazon Resource Name (ARN), certificate
/// name, domain name, and tags.
pub struct Certificate {
  /// The Amazon Resource Name (ARN) of the certificate.
  pub arn: Str? = None
  /// The name of the certificate ( my-certificate ).
  pub name: Str? = None
  /// The domain name of the certificate.
  pub domain_name: Str? = None
  /// The validation status of the certificate.
  pub status: CertificateStatus? = None
  /// The serial number of the certificate.
  pub serial_number: Str? = None
  /// An array of strings that specify the alternate domains ( example2.com )
  /// and subdomains ( blog.example.com ) of the certificate.
  pub subject_alternative_names: List[Str]? = None
  /// An array of objects that describe the domain validation records of the
  /// certificate.
  pub domain_validation_records: List[DomainValidationRecord]? = None
  /// The validation failure reason, if any, of the certificate. The following
  /// failure reasons are possible: NO_AVAILABLE_CONTACTS - This failure
  /// applies to email validation, which is not available for Lightsail
  /// certificates. ADDITIONAL_VERIFICATION_REQUIRED - Lightsail requires
  /// additional information to process this certificate request. This can
  /// happen as a fraud-protection measure, such as when the domain ranks
  /// within the Alexa top 1000 websites. To provide the required information,
  /// use the Amazon Web Services Support Center to contact Amazon Web
  /// Services Support. You cannot request a certificate for Amazon-owned
  /// domain names such as those ending in amazonaws.com, cloudfront.net, or
  /// elasticbeanstalk.com. DOMAIN_NOT_ALLOWED - One or more of the domain
  /// names in the certificate request was reported as an unsafe domain by
  /// VirusTotal . To correct the problem, search for your domain name on the
  /// VirusTotal website. If your domain is reported as suspicious, see Google
  /// Help for Hacked Websites to learn what you can do. If you believe that
  /// the result is a false positive, notify the organization that is
  /// reporting the domain. VirusTotal is an aggregate of several antivirus
  /// and URL scanners and cannot remove your domain from a block list itself.
  /// After you correct the problem and the VirusTotal registry has been
  /// updated, request a new certificate. If you see this error and your
  /// domain is not included in the VirusTotal list, visit the Amazon Web
  /// Services Support Center and create a case. INVALID_PUBLIC_DOMAIN - One
  /// or more of the domain names in the certificate request is not valid.
  /// Typically, this is because a domain name in the request is not a valid
  /// top-level domain. Try to request a certificate again, correcting any
  /// spelling errors or typos that were in the failed request, and ensure
  /// that all domain names in the request are for valid top-level domains.
  /// For example, you cannot request a certificate for
  /// example.invalidpublicdomain because invalidpublicdomain is not a valid
  /// top-level domain. OTHER - Typically, this failure occurs when there is a
  /// typographical error in one or more of the domain names in the
  /// certificate request. Try to request a certificate again, correcting any
  /// spelling errors or typos that were in the failed request.
  pub request_failure_reason: Str? = None
  /// The number of Lightsail resources that the certificate is attached to.
  pub in_use_resource_count: Int? = None
  /// The algorithm used to generate the key pair (the public and private key)
  /// of the certificate.
  pub key_algorithm: Str? = None
  /// The timestamp when the certificate was created.
  pub created_at: Time? = None
  /// The timestamp when the certificate was issued.
  pub issued_at: Time? = None
  /// The certificate authority that issued the certificate.
  pub issuer_ca: Str? = None
  /// The timestamp when the certificate is first valid.
  pub not_before: Time? = None
  /// The timestamp when the certificate expires.
  pub not_after: Time? = None
  /// The renewal eligibility of the certificate.
  pub eligible_to_renew: Str? = None
  /// An object that describes the status of the certificate renewal managed
  /// by Lightsail.
  pub renewal_summary: RenewalSummary? = None
  /// The timestamp when the certificate was revoked. This value is present
  /// only when the certificate status is REVOKED .
  pub revoked_at: Time? = None
  /// The reason the certificate was revoked. This value is present only when
  /// the certificate status is REVOKED .
  pub revocation_reason: Str? = None
  /// The tag keys and optional values for the resource. For more information
  /// about tags in Lightsail, see the Amazon Lightsail Developer Guide .
  pub tags: List[Tag]? = None
  /// The support code. Include this code in your email to support when you
  /// have questions about your Lightsail certificate. This code enables our
  /// support team to look up your Lightsail information more easily.
  pub support_code: Str? = None
}

