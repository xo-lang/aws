  /// Represents the name of the customer’s company associated with the
  /// Engagement Invitation. This field is used to identify the customer.
  pub company_name: Str? = None
  /// Provides the website URL of the customer’s company. This field helps
  /// partners verify the legitimacy and size of the customer organization.
  pub website_url: Str? = None
  /// Indicates the country in which the customer’s company operates. This
  /// field is useful for understanding regional requirements or compliance
  /// needs.
  pub country_code: CountryCode? = None
}

/// Provides comprehensive details about a customer project associated with
/// an Engagement. This may include information such as project goals,
/// timelines, and specific customer requirements.
pub struct EngagementCustomerProjectDetails {
  /// The title of the project.
  pub title: Str? = None
  /// A description of the business problem the project aims to solve.
  pub business_problem: Str? = None
  /// The target completion date for the customer's project.
  pub target_completion_date: Str? = None
}

pub enum EngagementInvitationPayloadType: Str {
  OpportunityInvitation = "OpportunityInvitation"
  LeadInvitation = "LeadInvitation"
  Unknown(value: Str)
}

/// Provides a summarized view of the Engagement Invitation, including
/// details like the identifier, status, and sender. This summary helps
/// partners track and manage AWS originated opportunities.
pub struct EngagementInvitationSummary {
  /// The Amazon Resource Name (ARN) of the Engagement Invitation. The ARN is
  /// a unique identifier that allows partners to reference the invitation in
  /// their system and manage its lifecycle.
  pub arn: Str? = None
  /// Describes the type of payload associated with the Engagement Invitation,
  /// such as Opportunity or MarketplaceOffer . This helps partners understand
  /// the nature of the engagement request from AWS.
  pub payload_type: EngagementInvitationPayloadType? = None
  /// Represents the unique identifier of the Engagement Invitation. This
  /// identifier is used to track the invitation and to manage responses like
  /// acceptance or rejection.
  pub id: Str? = None
  /// The identifier of the Engagement associated with this invitation. This
  /// links the invitation to its parent Engagement.
  pub engagement_id: Str? = None
  /// Provides a short title or description of the Engagement Invitation. This
  /// title helps partners quickly identify and differentiate between multiple
  /// engagement opportunities.
  pub engagement_title: Str? = None
  /// Represents the current status of the Engagement Invitation, such as
  /// Pending , Accepted , or Rejected . The status helps track the progress
  /// and response to the invitation.
  pub status: InvitationStatus? = None
  /// Indicates the date when the Engagement Invitation was sent to the
  /// partner. This provides context for when the opportunity was shared and
  /// helps in tracking the timeline for engagement.
  pub invitation_date: Time? = None
  /// Indicates the date and time when the Engagement Invitation will expire.
  /// After this date, the invitation can no longer be accepted, and the
  /// opportunity will be unavailable to the partner.
  pub expiration_date: Time? = None
  /// Specifies the AWS account ID of the sender who initiated the Engagement
  /// Invitation. This allows the partner to identify the AWS entity or
  /// representative responsible for sharing the opportunity.
  pub sender_aws_account_id: Str? = None
  /// Indicates the name of the company or AWS division that sent the
  /// Engagement Invitation. This information is useful for partners to know
  /// which part of AWS is requesting engagement.
  pub sender_company_name: Str? = None
  /// Specifies the partner company or individual that received the Engagement
  /// Invitation. This field is important for tracking who the invitation was
  /// sent to within the partner organization.
  pub receiver: Receiver? = None
  /// Specifies the catalog in which the Engagement Invitation resides. This
  /// can be either the AWS or Sandbox catalog, indicating whether the
  /// opportunity is live or being tested.
  pub catalog: Str? = None
  /// Identifies the role of the caller in the engagement invitation.
  pub participant_type: ParticipantType? = None
}

/// Engagement members are the participants in an Engagement, which is
/// likely a collaborative project or business opportunity within the AWS
/// partner network. Members can be different partner organizations or AWS
/// accounts that are working together on a specific engagement. Each member
/// is represented by their AWS Account ID, Company Name, and associated
/// details. Members have a status within the Engagement (PENDING, ACCEPTED,
/// REJECTED, or WITHDRAWN), indicating their current state of
/// participation. Only existing members of an Engagement can view the list
/// of other members. This implies a level of privacy and access control
/// within the Engagement structure.
pub struct EngagementMember {
  /// The official name of the member's company or organization.
  pub company_name: Str? = None
  /// The URL of the member company's website. This offers a way to find more
  /// information about the member organization and serves as an additional
  /// identifier.
  pub website_url: Str? = None
  /// This is the unique identifier for the AWS account associated with the
  /// member organization. It's used for AWS-related operations and identity
  /// verification.
  pub account_id: Str? = None
}

/// The EngagementMemberSummary provides a snapshot of essential information
/// about participants in an AWS Partner Central Engagement. This compact
/// data structure encapsulates key details of each member, facilitating
/// efficient collaboration and management within the Engagement.
pub struct EngagementMemberSummary {
  /// The official name of the member's company or organization.
  pub company_name: Str? = None
  /// The URL of the member company's website. This offers a way to find more
  /// information about the member organization and serves as an additional
  /// identifier.
  pub website_url: Str? = None
}

/// Contains the result of processing a single engagement within a
/// prospecting task. Each engagement is processed independently, so
/// individual engagements can succeed or fail regardless of other
/// engagements in the same task.
pub struct EngagementProspectingResult {
  /// The unique identifier of the engagement that was processed.
  pub engagement_identifier: Str? = None
  /// The identifier of the prospecting context created for this engagement.
  /// This field is only populated when the engagement was processed
  /// successfully (status is COMPLETED ). Use this identifier to reference
  /// the prospecting context in subsequent operations.
  pub engagement_context_id: Str? = None
  /// The processing status of this specific engagement. Possible values are
  /// PENDING , IN_PROGRESS , COMPLETED , and FAILED .
  pub status: ProspectingTaskStatus? = None
  /// An enumerated code indicating the reason this engagement failed to
  /// process. This field is only populated when Status is FAILED .
  pub reason_code: Str? = None
  /// A human-readable description of the failure for this engagement,
  /// including suggested recovery steps. This field is only populated when
  /// Status is FAILED .
  pub message: Str? = None
}

/// This provide a streamlined view of the relationships between engagements
/// and resources. These summaries offer a crucial link between
/// collaborative engagements and the specific resources involved, such as
/// opportunities.These summaries are particularly valuable for partners
/// navigating complex engagements with multiple resources. They enable
/// quick insights into resource distribution across engagements, support
/// efficient resource management, and help maintain a clear overview of
/// collaborative activities.
pub struct EngagementResourceAssociationSummary {
  /// Indicates the environment in which the resource and engagement exist.
  pub catalog: Str? = None
  /// A unique identifier for the engagement associated with the resource.
  pub engagement_id: Str? = None
  /// Categorizes the type of resource associated with the engagement.
  pub resource_type: ResourceType? = None
  /// A unique identifier for the specific resource. Varies depending on the
  /// resource type.
  pub resource_id: Str? = None
  /// The AWS account ID of the entity that owns the resource. Identifies the
  /// account responsible for or having primary control over the resource.
  pub created_by: Str? = None
}

pub enum EngagementScore: Str {
  High = "High"
  Medium = "Medium"
  Low = "Low"
  Unknown(value: Str)
}

/// Specifies the sorting parameters for listing Engagements.
