    fs.push(("SecurityConfiguration", json.Value.Str(x)))
  }
  if let Some(x) = v.glue_version {
    fs.push(("GlueVersion", json.Value.Str(x)))
  }
  if let Some(x) = v.number_of_workers {
    fs.push(("NumberOfWorkers", json.Value.Int(x)))
  }
  if let Some(x) = v.worker_type {
    fs.push(("WorkerType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.completed_on {
    fs.push(("CompletedOn", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.execution_time {
    fs.push(("ExecutionTime", jsonv.float(x)))
  }
  if let Some(x) = v.dpu_seconds {
    fs.push(("DPUSeconds", jsonv.float(x)))
  }
  if let Some(x) = v.idle_timeout {
    fs.push(("IdleTimeout", json.Value.Int(x)))
  }
  if let Some(x) = v.profile_name {
    fs.push(("ProfileName", json.Value.Str(x)))
  }
  if let Some(x) = v.session_type {
    fs.push(("SessionType", json.Value.Str(x.value())))
