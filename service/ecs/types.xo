}

/// The Amazon S3 destination for the access logs of a gateway's load
/// balancers.
pub struct GatewayElbAccessLogS3Destination {
  /// The name of the Amazon S3 bucket where access logs are delivered.
  pub bucket: Str? = None
  /// The object key prefix for the access logs in the Amazon S3 bucket.
  pub prefix: Str? = None
}

/// The IP address type for the load balancers that a gateway manages.
pub enum GatewayElbIpAddressType: Str {
  Ipv4 = "ipv4"
  Dualstack = "dualstack"
  DualstackWithoutPublicIpv4 = "dualstack-without-public-ipv4"
  Unknown(value: Str)
}

/// The network configuration for the load balancers that a gateway manages.
pub struct GatewayElbNetworkConfiguration {
  /// The ID of a security group that you provide to control inbound traffic
  /// to the load balancers that the gateway manages. When you specify a
  /// security group, the gateway doesn't create inbound rules on the security
  /// group it manages.
  pub inbound_security_group: Str? = None
  /// The subnets for the load balancers that the gateway manages. The default
  /// is the subnets in the default VPC.
  pub subnets: List[Str]? = None
  /// The IP address type for the load balancers that the gateway manages. The
  /// default is dualstack .
  pub ip_address_type: GatewayElbIpAddressType? = None
}

/// Specifies whether the load balancers that a gateway manages are
