  pub code: Str? = None
  pub message: Str? = None
}

/// The request was rejected because it specified an invalid type
/// definition.
pub struct InvalidTypeException {
  pub code: Str? = None
  pub message: Str? = None
}

/// Options for a latlon field. A latlon field contains a location stored as
/// a latitude and longitude value pair. Present if IndexFieldType specifies
/// the field is of type latlon . All options are enabled by default.
pub struct LatLonOptions {
  /// A value to use for the field if the field isn't specified for a
  /// document.
  pub default_value: Str? = None
  pub source_field: Str? = None
  /// Whether facet information can be returned for the field.
  pub facet_enabled: Bool? = None
  /// Whether the contents of the field are searchable.
  pub search_enabled: Bool? = None
  /// Whether the contents of the field can be returned in the search results.
  pub return_enabled: Bool? = None
  /// Whether the field can be used to sort the search results.
  pub sort_enabled: Bool? = None
}

/// The request was rejected because a resource limit has already been met.
pub struct LimitExceededException {
  pub code: Str? = None
  pub message: Str? = None
}

pub struct Limits {
  pub maximum_replication_count: Int? = None
  pub maximum_partition_count: Int? = None
}

/// The result of a ListDomainNames request. Contains a list of the domains
/// owned by an account.
pub struct ListDomainNamesResponse {
  /// The names of the search domains owned by an account.
  pub domain_names: Map[Str, Str]? = None
}

/// Options for a field that contains an array of literal strings. Present
/// if IndexFieldType specifies the field is of type literal-array . All
/// options are enabled by default.
pub struct LiteralArrayOptions {
  /// A value to use for the field if the field isn't specified for a
  /// document.
  pub default_value: Str? = None
  /// A list of source fields to map to the field.
  pub source_fields: Str? = None
  /// Whether facet information can be returned for the field.
  pub facet_enabled: Bool? = None
  /// Whether the contents of the field are searchable.
  pub search_enabled: Bool? = None
  /// Whether the contents of the field can be returned in the search results.
  pub return_enabled: Bool? = None
}

/// Options for literal field. Present if IndexFieldType specifies the field
/// is of type literal . All options are enabled by default.
pub struct LiteralOptions {
  /// A value to use for the field if the field isn't specified for a
  /// document.
  pub default_value: Str? = None
  pub source_field: Str? = None
  /// Whether facet information can be returned for the field.
  pub facet_enabled: Bool? = None
  /// Whether the contents of the field are searchable.
  pub search_enabled: Bool? = None
  /// Whether the contents of the field can be returned in the search results.
  pub return_enabled: Bool? = None
  /// Whether the field can be used to sort the search results.
  pub sort_enabled: Bool? = None
}

/// The state of processing a change to an option. One of:
/// RequiresIndexDocuments: The option's latest value will not be deployed
/// until IndexDocuments has been called and indexing is complete.
/// Processing: The option's latest value is in the process of being
/// activated. Active: The option's latest value is fully deployed.
/// FailedToValidate: The option value is not compatible with the domain's
/// data and cannot be used to index the data. You must either modify the
/// option value or update or remove the incompatible documents.
pub enum OptionState: Str {
  RequiresIndexDocuments = "RequiresIndexDocuments"
  Processing = "Processing"
  Active = "Active"
  FailedToValidate = "FailedToValidate"
  Unknown(value: Str)
}

/// The status of domain configuration option.
pub struct OptionStatus {
  /// A timestamp for when this option was created.
  pub creation_date: Time? = None
  /// A timestamp for when this option was last updated.
  pub update_date: Time? = None
  /// A unique integer that indicates when this option was last updated.
  pub update_version: Int? = None
  /// The state of processing a change to an option. Possible values:
  /// RequiresIndexDocuments : the option's latest value will not be deployed
  /// until IndexDocuments has been called and indexing is complete.
  /// Processing : the option's latest value is in the process of being
  /// activated. Active : the option's latest value is completely deployed.
  /// FailedToValidate : the option value is not compatible with the domain's
  /// data and cannot be used to index the data. You must either modify the
  /// option value or update or remove the incompatible documents.
  pub state: OptionState? = None
  /// Indicates that the option will be deleted once processing is complete.
  pub pending_deletion: Bool? = None
}

/// The instance type (such as search.m1.small ) on which an index partition
/// is hosted.
pub enum PartitionInstanceType: Str {
  SearchM1Small = "search.m1.small"
  SearchM1Large = "search.m1.large"
  SearchM2Xlarge = "search.m2.xlarge"
  SearchM22xlarge = "search.m2.2xlarge"
  SearchM3Medium = "search.m3.medium"
  SearchM3Large = "search.m3.large"
  SearchM3Xlarge = "search.m3.xlarge"
  SearchM32xlarge = "search.m3.2xlarge"
  SearchSmall = "search.small"
  SearchMedium = "search.medium"
  SearchLarge = "search.large"
  SearchXlarge = "search.xlarge"
  Search2xlarge = "search.2xlarge"
  SearchPreviousgenerationSmall = "search.previousgeneration.small"
  SearchPreviousgenerationLarge = "search.previousgeneration.large"
  SearchPreviousgenerationXlarge = "search.previousgeneration.xlarge"
  SearchPreviousgeneration2xlarge = "search.previousgeneration.2xlarge"
  Unknown(value: Str)
}

/// The request was rejected because it attempted to create a resource that
/// already exists.
pub struct ResourceAlreadyExistsException {
  pub code: Str? = None
  pub message: Str? = None
}

/// The request was rejected because it attempted to reference a resource
/// that does not exist.
pub struct ResourceNotFoundException {
  pub code: Str? = None
  pub message: Str? = None
}

/// The desired instance type and desired number of replicas of each index
/// partition.
pub struct ScalingParameters {
  /// The instance type that you want to preconfigure for your domain. For
  /// example, search.m1.small .
  pub desired_instance_type: PartitionInstanceType? = None
  /// The number of replicas you want to preconfigure for each index
  /// partition.
  pub desired_replication_count: Int? = None
  /// The number of partitions you want to preconfigure for your domain. Only
  /// valid when you select m2.2xlarge as the desired instance type.
  pub desired_partition_count: Int? = None
}

/// The status and configuration of a search domain's scaling parameters.
pub struct ScalingParametersStatus {
  pub options: ScalingParameters? = None
  pub status: OptionStatus? = None
}

/// The endpoint to which service requests can be submitted.
pub struct ServiceEndpoint {
  pub endpoint: Str? = None
}

/// Configuration information for a search suggester. Each suggester has a
/// unique name and specifies the text field you want to use for
/// suggestions. The following options can be configured for a suggester:
/// FuzzyMatching , SortExpression .
pub struct Suggester {
  pub suggester_name: Str? = None
  pub document_suggester_options: DocumentSuggesterOptions? = None
}

pub enum SuggesterFuzzyMatching: Str {
  None = "none"
  Low = "low"
  High = "high"
  Unknown(value: Str)
}

/// The value of a Suggester and its current status.
pub struct SuggesterStatus {
  pub options: Suggester? = None
  pub status: OptionStatus? = None
}

/// The minimum required TLS version.
pub enum TLSSecurityPolicy: Str {
  PolicyMinTls10201907 = "Policy-Min-TLS-1-0-2019-07"
  PolicyMinTls12201907 = "Policy-Min-TLS-1-2-2019-07"
  Unknown(value: Str)
}

/// Options for a field that contains an array of text strings. Present if
/// IndexFieldType specifies the field is of type text-array . A text-array
/// field is always searchable. All options are enabled by default.
pub struct TextArrayOptions {
  /// A value to use for the field if the field isn't specified for a
  /// document.
  pub default_value: Str? = None
  /// A list of source fields to map to the field.
  pub source_fields: Str? = None
  /// Whether the contents of the field can be returned in the search results.
  pub return_enabled: Bool? = None
  /// Whether highlights can be returned for the field.
  pub highlight_enabled: Bool? = None
  /// The name of an analysis scheme for a text-array field.
  pub analysis_scheme: Str? = None
}

/// Options for text field. Present if IndexFieldType specifies the field is
/// of type text . A text field is always searchable. All options are
/// enabled by default.
pub struct TextOptions {
  /// A value to use for the field if the field isn't specified for a
  /// document.
  pub default_value: Str? = None
  pub source_field: Str? = None
  /// Whether the contents of the field can be returned in the search results.
  pub return_enabled: Bool? = None
  /// Whether the field can be used to sort the search results.
  pub sort_enabled: Bool? = None
  /// Whether highlights can be returned for the field.
  pub highlight_enabled: Bool? = None
  /// The name of an analysis scheme for a text field.
  pub analysis_scheme: Str? = None
}

/// Container for the parameters to the UpdateAvailabilityOptions operation.
/// Specifies the name of the domain you want to update and the Multi-AZ
/// availability option.
pub struct UpdateAvailabilityOptionsRequest {
  pub domain_name: Str? = None
  /// You expand an existing search domain to a second Availability Zone by
  /// setting the Multi-AZ option to true. Similarly, you can turn off the
  /// Multi-AZ option to downgrade the domain to a single Availability Zone by
  /// setting the Multi-AZ option to false .
  pub multi_az: Bool? = None
}

/// The result of a UpdateAvailabilityOptions request. Contains the status
/// of the domain's availability options.
pub struct UpdateAvailabilityOptionsResponse {
  /// The newly-configured availability options. Indicates whether Multi-AZ is
  /// enabled for the domain.
  pub availability_options: AvailabilityOptionsStatus? = None
}

/// Container for the parameters to the UpdateDomainEndpointOptions
/// operation. Specifies the name of the domain you want to update and the
/// domain endpoint options.
pub struct UpdateDomainEndpointOptionsRequest {
  /// A string that represents the name of a domain.
  pub domain_name: Str? = None
  /// Whether to require that all requests to the domain arrive over HTTPS. We
  /// recommend Policy-Min-TLS-1-2-2019-07 for TLSSecurityPolicy. For
  /// compatibility with older clients, the default is
  /// Policy-Min-TLS-1-0-2019-07.
  pub domain_endpoint_options: DomainEndpointOptions? = None
}

/// The result of a UpdateDomainEndpointOptions request. Contains the
/// configuration and status of the domain's endpoint options.
pub struct UpdateDomainEndpointOptionsResponse {
  /// The newly-configured domain endpoint options.
  pub domain_endpoint_options: DomainEndpointOptionsStatus? = None
}

/// Container for the parameters to the UpdateScalingParameters operation.
/// Specifies the name of the domain you want to update and the scaling
/// parameters you want to configure.
pub struct UpdateScalingParametersRequest {
  pub domain_name: Str? = None
  pub scaling_parameters: ScalingParameters? = None
}

/// The result of a UpdateScalingParameters request. Contains the status of
/// the newly-configured scaling parameters.
pub struct UpdateScalingParametersResponse {
  pub scaling_parameters: ScalingParametersStatus? = None
}

/// Container for the parameters to the UpdateServiceAccessPolicies
/// operation. Specifies the name of the domain you want to update and the
/// access rules you want to configure.
pub struct UpdateServiceAccessPoliciesRequest {
  pub domain_name: Str? = None
  /// The access rules you want to configure. These rules replace any existing
  /// rules.
  pub access_policies: Str? = None
}

/// The result of an UpdateServiceAccessPolicies request. Contains the new
/// access policies.
pub struct UpdateServiceAccessPoliciesResponse {
  /// The access rules configured for the domain.
  pub access_policies: AccessPoliciesStatus? = None
}

/// The request was rejected because it has invalid parameters.
pub struct ValidationException {
  pub code: Str? = None
  pub message: Str? = None
}
