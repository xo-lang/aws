  let _ = input
  base
}

/// The HTTP request of AssociatePublisher.
pub fn serialize_associate_publisher(ep: rest.Endpoint, input: AssociatePublisherRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.record_arn {
    fs.push(("recordArn", json.Value.Str(x)))
  }
  if let Some(x) = input.publisher_arn {
    fs.push(("publisherArn", json.Value.Str(x)))
  }
  if let Some(x) = input.subdomain {
    fs.push(("subdomain", json.Value.Str(x)))
  }
  if let Some(x) = input.categories {
    fs.push(("categories", json_of_category_list(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("clientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("clientToken", json.Value.Str(idempotency_token)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
