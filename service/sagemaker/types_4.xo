  /// The input artifacts of the component.
  pub input_artifacts: Map[Str, TrialComponentArtifact]? = None
  /// The output artifacts of the component.
  pub output_artifacts: Map[Str, TrialComponentArtifact]? = None
  /// The metrics for the component.
