fn xml_write_summary_map_type(var w: xmlv.Writer, v: Map[Str, Int], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", "${item}", [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_summary_map_type(e: xml.Element) -> Map[Str, Int] ! Str {
  var out: Map[Str, Int] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, xmlv.read_int(vc.text())?)
    }
  }
  Ok(out)
}

