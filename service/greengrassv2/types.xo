  pub event_sources: List[LambdaEventSource]? = None
  /// The maximum size of the message queue for the Lambda function component.
  /// The IoT Greengrass core stores messages in a FIFO (first-in-first-out)
  /// queue until it can run the Lambda function to consume each message.
  pub max_queue_size: Int? = None
  /// The maximum number of instances that a non-pinned Lambda function can
  /// run at the same time.
  pub max_instances_count: Int? = None
  /// The maximum amount of time in seconds that a non-pinned Lambda function
  /// can idle before the IoT Greengrass Core software stops its process.
  pub max_idle_time_in_seconds: Int? = None
  /// The maximum amount of time in seconds that the Lambda function can
  /// process a work item.
  pub timeout_in_seconds: Int? = None
  /// The interval in seconds at which a pinned (also known as long-lived)
  /// Lambda function component sends status updates to the Lambda manager
  /// component.
  pub status_timeout_in_seconds: Int? = None
  /// Whether or not the Lambda function is pinned, or long-lived. A pinned
  /// Lambda function starts when IoT Greengrass starts and keeps running in
  /// its own container. A non-pinned Lambda function starts only when it
  /// receives a work item and exists after it idles for maxIdleTimeInSeconds
  /// . If the function has multiple work items, the IoT Greengrass Core
  /// software creates multiple instances of the function. Default: true
  pub pinned: Bool? = None
  /// The encoding type that the Lambda function supports. Default: json
