  }
}

fn query_put_authorize_cache_security_group_ingress_message(var f: query.Form, prefix: Str, v: AuthorizeCacheSecurityGroupIngressMessage) {
  if let Some(x) = v.cache_security_group_name {
    query.add(f, query.key(prefix, "CacheSecurityGroupName"), x)
  }
  if let Some(x) = v.ec2_security_group_name {
    query.add(f, query.key(prefix, "EC2SecurityGroupName"), x)
  }
  if let Some(x) = v.ec2_security_group_owner_id {
    query.add(f, query.key(prefix, "EC2SecurityGroupOwnerId"), x)
  }
}

fn query_put_authorize_cache_security_group_ingress_result(var f: query.Form, prefix: Str, v: AuthorizeCacheSecurityGroupIngressResult) {
  if let Some(x) = v.cache_security_group {
    query_put_cache_security_group(f, query.key(prefix, "CacheSecurityGroup"), x)
  }
}

fn query_put_availability_zone(var f: query.Form, prefix: Str, v: AvailabilityZone) {
  if let Some(x) = v.name {
    query.add(f, query.key(prefix, "Name"), x)
  }
}

fn query_put_availability_zones_list(var f: query.Form, prefix: Str, v: List[Str], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.AvailabilityZone.${i + 1}" }
    query.add(f, k, x)
  }
}

fn query_put_batch_apply_update_action_message(var f: query.Form, prefix: Str, v: BatchApplyUpdateActionMessage) {
  if let Some(x) = v.replication_group_ids {
    query_put_replication_group_id_list(f, query.key(prefix, "ReplicationGroupIds"), x, false)
  }
  if let Some(x) = v.cache_cluster_ids {
    query_put_cache_cluster_id_list(f, query.key(prefix, "CacheClusterIds"), x, false)
  }
  if let Some(x) = v.service_update_name {
    query.add(f, query.key(prefix, "ServiceUpdateName"), x)
  }
}

fn query_put_batch_stop_update_action_message(var f: query.Form, prefix: Str, v: BatchStopUpdateActionMessage) {
  if let Some(x) = v.replication_group_ids {
    query_put_replication_group_id_list(f, query.key(prefix, "ReplicationGroupIds"), x, false)
  }
  if let Some(x) = v.cache_cluster_ids {
    query_put_cache_cluster_id_list(f, query.key(prefix, "CacheClusterIds"), x, false)
  }
  if let Some(x) = v.service_update_name {
    query.add(f, query.key(prefix, "ServiceUpdateName"), x)
  }
}

fn query_put_cache_cluster(var f: query.Form, prefix: Str, v: CacheCluster) {
  if let Some(x) = v.cache_cluster_id {
    query.add(f, query.key(prefix, "CacheClusterId"), x)
  }
  if let Some(x) = v.configuration_endpoint {
    query_put_endpoint(f, query.key(prefix, "ConfigurationEndpoint"), x)
  }
  if let Some(x) = v.client_download_landing_page {
    query.add(f, query.key(prefix, "ClientDownloadLandingPage"), x)
  }
  if let Some(x) = v.cache_node_type {
    query.add(f, query.key(prefix, "CacheNodeType"), x)
  }
  if let Some(x) = v.engine {
    query.add(f, query.key(prefix, "Engine"), x)
  }
  if let Some(x) = v.engine_version {
    query.add(f, query.key(prefix, "EngineVersion"), x)
  }
  if let Some(x) = v.cache_cluster_status {
    query.add(f, query.key(prefix, "CacheClusterStatus"), x)
  }
  if let Some(x) = v.num_cache_nodes {
    query.add(f, query.key(prefix, "NumCacheNodes"), "${x}")
  }
  if let Some(x) = v.preferred_availability_zone {
    query.add(f, query.key(prefix, "PreferredAvailabilityZone"), x)
  }
  if let Some(x) = v.preferred_outpost_arn {
    query.add(f, query.key(prefix, "PreferredOutpostArn"), x)
  }
  if let Some(x) = v.cache_cluster_create_time {
    query.add(f, query.key(prefix, "CacheClusterCreateTime"), rest.date_time(x))
  }
  if let Some(x) = v.preferred_maintenance_window {
    query.add(f, query.key(prefix, "PreferredMaintenanceWindow"), x)
  }
  if let Some(x) = v.pending_modified_values {
