fn json_of_pipeline(v: Pipeline) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.pipeline_name {
    fs.push(("PipelineName", json.Value.Str(x)))
  }
  if let Some(x) = v.pipeline_arn {
    fs.push(("PipelineArn", json.Value.Str(x)))
  }
  if let Some(x) = v.min_units {
    fs.push(("MinUnits", json.Value.Int(x)))
  }
  if let Some(x) = v.max_units {
    fs.push(("MaxUnits", json.Value.Int(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.status_reason {
    fs.push(("StatusReason", json_of_pipeline_status_reason(x)))
  }
  if let Some(x) = v.pipeline_configuration_body {
    fs.push(("PipelineConfigurationBody", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_updated_at {
    fs.push(("LastUpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.ingest_endpoint_urls {
    fs.push(("IngestEndpointUrls", json_of_ingest_endpoint_urls_list(x)))
  }
  if let Some(x) = v.log_publishing_options {
    fs.push(("LogPublishingOptions", json_of_log_publishing_options(x)))
  }
  if let Some(x) = v.vpc_endpoints {
    fs.push(("VpcEndpoints", json_of_vpc_endpoints_list(x)))
  }
  if let Some(x) = v.buffer_options {
    fs.push(("BufferOptions", json_of_buffer_options(x)))
  }
  if let Some(x) = v.encryption_at_rest_options {
    fs.push(("EncryptionAtRestOptions", json_of_encryption_at_rest_options(x)))
  }
  if let Some(x) = v.vpc_endpoint_service {
    fs.push(("VpcEndpointService", json.Value.Str(x)))
  }
  if let Some(x) = v.service_vpc_endpoints {
    fs.push(("ServiceVpcEndpoints", json_of_service_vpc_endpoints_list(x)))
  }
  if let Some(x) = v.destinations {
    fs.push(("Destinations", json_of_pipeline_destination_list(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_list(x)))
  }
  if let Some(x) = v.pipeline_role_arn {
    fs.push(("PipelineRoleArn", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_pipeline(v: json.Value) -> Pipeline ! Str {
  var out = Pipeline{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "PipelineName" => out.pipeline_name = jsonv.read_str(fv)?
      "PipelineArn" => out.pipeline_arn = jsonv.read_str(fv)?
      "MinUnits" => out.min_units = jsonv.read_int(fv)?
      "MaxUnits" => out.max_units = jsonv.read_int(fv)?
      "Status" => out.status = PipelineStatus.from(jsonv.read_str(fv)?)
      "StatusReason" => out.status_reason = from_json_pipeline_status_reason(fv)?
      "PipelineConfigurationBody" => out.pipeline_configuration_body = jsonv.read_str(fv)?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "LastUpdatedAt" => out.last_updated_at = jsonv.read_time(fv, "epoch-seconds")?
      "IngestEndpointUrls" => out.ingest_endpoint_urls = from_json_ingest_endpoint_urls_list(fv)?
      "LogPublishingOptions" => out.log_publishing_options = from_json_log_publishing_options(fv)?
      "VpcEndpoints" => out.vpc_endpoints = from_json_vpc_endpoints_list(fv)?
      "BufferOptions" => out.buffer_options = from_json_buffer_options(fv)?
      "EncryptionAtRestOptions" => out.encryption_at_rest_options = from_json_encryption_at_rest_options(fv)?
      "VpcEndpointService" => out.vpc_endpoint_service = jsonv.read_str(fv)?
      "ServiceVpcEndpoints" => out.service_vpc_endpoints = from_json_service_vpc_endpoints_list(fv)?
      "Destinations" => out.destinations = from_json_pipeline_destination_list(fv)?
      "Tags" => out.tags = from_json_tag_list(fv)?
      "PipelineRoleArn" => out.pipeline_role_arn = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

