fn from_json_input(v: json.Value) -> Input ! Str {
  var out = Input{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "advancedInputFilter" => out.advanced_input_filter = AdvancedInputFilter.from(jsonv.read_str(fv)?)
      "advancedInputFilterSettings" => out.advanced_input_filter_settings = from_json_advanced_input_filter_settings(fv)?
      "audioSelectorGroups" => out.audio_selector_groups = from_json_map_of_audio_selector_group(fv)?
      "audioSelectors" => out.audio_selectors = from_json_map_of_audio_selector(fv)?
      "captionSelectors" => out.caption_selectors = from_json_map_of_caption_selector(fv)?
      "crop" => out.crop = from_json_rectangle(fv)?
      "deblockFilter" => out.deblock_filter = InputDeblockFilter.from(jsonv.read_str(fv)?)
      "decryptionSettings" => out.decryption_settings = from_json_input_decryption_settings(fv)?
      "denoiseFilter" => out.denoise_filter = InputDenoiseFilter.from(jsonv.read_str(fv)?)
      "dolbyVisionMetadataXml" => out.dolby_vision_metadata_xml = jsonv.read_str(fv)?
      "dynamicAudioSelectors" => out.dynamic_audio_selectors = from_json_map_of_dynamic_audio_selector(fv)?
      "fileInput" => out.file_input = jsonv.read_str(fv)?
      "filterEnable" => out.filter_enable = InputFilterEnable.from(jsonv.read_str(fv)?)
      "filterStrength" => out.filter_strength = jsonv.read_int(fv)?
      "imageInserter" => out.image_inserter = from_json_image_inserter(fv)?
      "inputClippings" => out.input_clippings = from_json_list_of_input_clipping(fv)?
      "inputScanType" => out.input_scan_type = InputScanType.from(jsonv.read_str(fv)?)
      "multiViewSettings" => out.multi_view_settings = from_json_list_of_multi_view_settings(fv)?
      "position" => out.position = from_json_rectangle(fv)?
      "programNumber" => out.program_number = jsonv.read_int(fv)?
      "psiControl" => out.psi_control = InputPsiControl.from(jsonv.read_str(fv)?)
      "supplementalImps" => out.supplemental_imps = from_json_list_of_string_pattern_s3_assetmap_xml(fv)?
      "tamsSettings" => out.tams_settings = from_json_input_tams_settings(fv)?
      "timecodeSource" => out.timecode_source = InputTimecodeSource.from(jsonv.read_str(fv)?)
      "timecodeStart" => out.timecode_start = jsonv.read_str(fv)?
      "videoGenerator" => out.video_generator = from_json_input_video_generator(fv)?
      "videoOverlays" => out.video_overlays = from_json_list_of_video_overlay(fv)?
      "videoSelector" => out.video_selector = from_json_video_selector(fv)?
      _ => {}
    }
  }
  Ok(out)
}

