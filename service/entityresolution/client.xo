  if let Some(x) = v.input_records {
    fs.push(("inputRecords", json.Value.Int(x)))
  }
  if let Some(x) = v.total_records_processed {
    fs.push(("totalRecordsProcessed", json.Value.Int(x)))
  }
  if let Some(x) = v.records_not_processed {
    fs.push(("recordsNotProcessed", json.Value.Int(x)))
  }
  if let Some(x) = v.delete_records_processed {
    fs.push(("deleteRecordsProcessed", json.Value.Int(x)))
  }
  if let Some(x) = v.match_ids {
    fs.push(("matchIDs", json.Value.Int(x)))
  }
  json.Value.Object(fs)
}

fn from_json_job_metrics(v: json.Value) -> JobMetrics ! Str {
  var out = JobMetrics{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "inputRecords" => out.input_records = jsonv.read_int(fv)?
      "totalRecordsProcessed" => out.total_records_processed = jsonv.read_int(fv)?
      "recordsNotProcessed" => out.records_not_processed = jsonv.read_int(fv)?
      "deleteRecordsProcessed" => out.delete_records_processed = jsonv.read_int(fv)?
      "matchIDs" => out.match_ids = jsonv.read_int(fv)?
      _ => {}
    }
  }
  Ok(out)
}

