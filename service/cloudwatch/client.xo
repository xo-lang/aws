fn xml_write_metric_alarm(var w: xmlv.Writer, v: MetricAlarm, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.alarm_name {
    xmlv.elem(w, "AlarmName", x, [])
  }
  if let Some(x) = v.alarm_arn {
    xmlv.elem(w, "AlarmArn", x, [])
  }
  if let Some(x) = v.alarm_description {
    xmlv.elem(w, "AlarmDescription", x, [])
  }
  if let Some(x) = v.alarm_configuration_updated_timestamp {
    xmlv.elem(w, "AlarmConfigurationUpdatedTimestamp", rest.date_time(x), [])
  }
  if let Some(x) = v.actions_enabled {
    xmlv.elem(w, "ActionsEnabled", "${x}", [])
  }
  if let Some(x) = v.ok_actions {
    xml_write_resource_list(w, x, "OKActions", [])
  }
  if let Some(x) = v.alarm_actions {
    xml_write_resource_list(w, x, "AlarmActions", [])
  }
  if let Some(x) = v.insufficient_data_actions {
    xml_write_resource_list(w, x, "InsufficientDataActions", [])
  }
  if let Some(x) = v.state_value {
    xmlv.elem(w, "StateValue", x.value(), [])
  }
  if let Some(x) = v.state_reason {
    xmlv.elem(w, "StateReason", x, [])
  }
  if let Some(x) = v.state_reason_data {
    xmlv.elem(w, "StateReasonData", x, [])
  }
  if let Some(x) = v.state_updated_timestamp {
    xmlv.elem(w, "StateUpdatedTimestamp", rest.date_time(x), [])
  }
  if let Some(x) = v.metric_name {
    xmlv.elem(w, "MetricName", x, [])
  }
  if let Some(x) = v.namespace {
    xmlv.elem(w, "Namespace", x, [])
  }
  if let Some(x) = v.statistic {
    xmlv.elem(w, "Statistic", x.value(), [])
  }
  if let Some(x) = v.extended_statistic {
    xmlv.elem(w, "ExtendedStatistic", x, [])
  }
  if let Some(x) = v.dimensions {
    xml_write_dimensions(w, x, "Dimensions", [])
  }
  if let Some(x) = v.period {
    xmlv.elem(w, "Period", "${x}", [])
  }
  if let Some(x) = v.unit {
    xmlv.elem(w, "Unit", x.value(), [])
  }
  if let Some(x) = v.evaluation_periods {
    xmlv.elem(w, "EvaluationPeriods", "${x}", [])
  }
  if let Some(x) = v.datapoints_to_alarm {
    xmlv.elem(w, "DatapointsToAlarm", "${x}", [])
  }
  if let Some(x) = v.threshold {
    xmlv.elem(w, "Threshold", rest.float_text(x), [])
  }
  if let Some(x) = v.comparison_operator {
    xmlv.elem(w, "ComparisonOperator", x.value(), [])
  }
  if let Some(x) = v.treat_missing_data {
    xmlv.elem(w, "TreatMissingData", x, [])
  }
  if let Some(x) = v.evaluate_low_sample_count_percentile {
    xmlv.elem(w, "EvaluateLowSampleCountPercentile", x, [])
  }
  if let Some(x) = v.metrics {
    xml_write_metric_data_queries(w, x, "Metrics", [])
  }
  if let Some(x) = v.threshold_metric_id {
    xmlv.elem(w, "ThresholdMetricId", x, [])
  }
  if let Some(x) = v.evaluation_state {
    xmlv.elem(w, "EvaluationState", x.value(), [])
  }
  if let Some(x) = v.state_transitioned_timestamp {
    xmlv.elem(w, "StateTransitionedTimestamp", rest.date_time(x), [])
  }
  if let Some(x) = v.evaluation_window {
    xml_write_evaluation_window(w, x, "EvaluationWindow", [])
  }
  if let Some(x) = v.warm_up_configuration {
    xml_write_warm_up_configuration(w, x, "WarmUpConfiguration", [])
  }
  if let Some(x) = v.evaluation_criteria {
    xml_write_evaluation_criteria(w, x, "EvaluationCriteria", [])
  }
  if let Some(x) = v.evaluation_interval {
    xmlv.elem(w, "EvaluationInterval", "${x}", [])
  }
  if let Some(x) = v.action_configuration {
    xml_write_action_configuration(w, x, "ActionConfiguration", [])
  }
  xmlv.end(w, name)
}

fn xml_read_metric_alarm(e: xml.Element) -> MetricAlarm ! Str {
  var out = MetricAlarm{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "AlarmName" => out.alarm_name = c.text()
      "AlarmArn" => out.alarm_arn = c.text()
      "AlarmDescription" => out.alarm_description = c.text()
      "AlarmConfigurationUpdatedTimestamp" => out.alarm_configuration_updated_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ActionsEnabled" => out.actions_enabled = xmlv.read_bool(c.text())?
      "OKActions" => out.ok_actions = xml_read_resource_list(c)?
      "AlarmActions" => out.alarm_actions = xml_read_resource_list(c)?
      "InsufficientDataActions" => out.insufficient_data_actions = xml_read_resource_list(c)?
      "StateValue" => out.state_value = StateValue.from(c.text())
      "StateReason" => out.state_reason = c.text()
      "StateReasonData" => out.state_reason_data = c.text()
      "StateUpdatedTimestamp" => out.state_updated_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MetricName" => out.metric_name = c.text()
      "Namespace" => out.namespace = c.text()
      "Statistic" => out.statistic = Statistic.from(c.text())
      "ExtendedStatistic" => out.extended_statistic = c.text()
      "Dimensions" => out.dimensions = xml_read_dimensions(c)?
      "Period" => out.period = xmlv.read_int(c.text())?
      "Unit" => out.unit = StandardUnit.from(c.text())
      "EvaluationPeriods" => out.evaluation_periods = xmlv.read_int(c.text())?
      "DatapointsToAlarm" => out.datapoints_to_alarm = xmlv.read_int(c.text())?
      "Threshold" => out.threshold = xmlv.read_float(c.text())?
      "ComparisonOperator" => out.comparison_operator = ComparisonOperator.from(c.text())
      "TreatMissingData" => out.treat_missing_data = c.text()
      "EvaluateLowSampleCountPercentile" => out.evaluate_low_sample_count_percentile = c.text()
      "Metrics" => out.metrics = xml_read_metric_data_queries(c)?
      "ThresholdMetricId" => out.threshold_metric_id = c.text()
      "EvaluationState" => out.evaluation_state = EvaluationState.from(c.text())
      "StateTransitionedTimestamp" => out.state_transitioned_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EvaluationWindow" => out.evaluation_window = xml_read_evaluation_window(c)?
      "WarmUpConfiguration" => out.warm_up_configuration = xml_read_warm_up_configuration(c)?
      "EvaluationCriteria" => out.evaluation_criteria = xml_read_evaluation_criteria(c)?
      "EvaluationInterval" => out.evaluation_interval = xmlv.read_int(c.text())?
      "ActionConfiguration" => out.action_configuration = xml_read_action_configuration(c)?
      _ => {}
    }
  }
  Ok(out)
}

