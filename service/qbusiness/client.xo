/// A Chat stream: `send` writes input events (signed in a chain),
/// `close_send` ends them, and `close` ends the whole stream.
pub struct ChatStream {
  pub output: ChatOutput
  writer: http.PipeWriter
  signer: sigv4.StreamSigner
  clock: Clock
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
  sent_end: Bool = false
}

/// Sends input event `e`.
pub fn (var s: ChatStream) send(e: ChatInputStream) -> () ! IoErr uses clock {
  let m = eventstream.encode(event_message_chat_input_stream(e))
  s.writer.write(eventstream.signed(s.signer, m, s.clock.now()))
}

/// Ends the input events: sends the signed empty message and closes
/// the request body.
pub fn (var s: ChatStream) close_send() -> () ! IoErr uses clock {
  if s.sent_end {
    return Ok(())
  }
  s.sent_end = true
  let r = s.writer.write(eventstream.signed(s.signer, b"", s.clock.now()))
  s.writer.close()
  r
}

/// The next event, None at the end of the stream.
pub fn (var s: ChatStream) next() -> ChatOutputStream? ! ChatOutputStreamErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(ChatOutputStreamErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              continue
            }
            return match event_chat_output_stream(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(ChatOutputStreamErr.Read(msg))
            }
          }
          "exception" => return Err(exception_chat_output_stream(m))
          _ => return Err(ChatOutputStreamErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(ChatOutputStreamErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(ChatOutputStreamErr.Read(e.display()))
          }
        }
      }
    }
  }
  Ok(None)
}

/// Ends the stream in both directions.
pub fn (var s: ChatStream) close() uses clock {
  match s.close_send() {
    Ok(_) => {}
    // closing anyway: a failed end message changes nothing here
    Err(_) => {}
  }
  if !s.done {
    s.done = true
    s.body.close()
  }
}

fn event_message_chat_input_stream(v: ChatInputStream) -> eventstream.Message {
  match v {
    ConfigurationEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("configurationEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.chat_mode {
        fs.push(("chatMode", json.Value.Str(y.value())))
      }
      if let Some(y) = x.chat_mode_configuration {
        fs.push(("chatModeConfiguration", json_of_chat_mode_configuration(y)))
      }
      if let Some(y) = x.attribute_filter {
        fs.push(("attributeFilter", json_of_attribute_filter(y)))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    TextEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("textEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.user_message {
        fs.push(("userMessage", json.Value.Str(y)))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    AttachmentEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("attachmentEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.attachment {
        fs.push(("attachment", json_of_attachment_input(y)))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    ActionExecutionEvent(x) => {
