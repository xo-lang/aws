fn json_of_schedule(v: Schedule) -> json.Value {
  match v {
    OneTime(x) => json.Value.Object([("oneTime", json_of_one_time_schedule(x))])
    Daily(x) => json.Value.Object([("daily", json_of_daily_schedule(x))])
    Weekly(x) => json.Value.Object([("weekly", json_of_weekly_schedule(x))])
    Monthly(x) => json.Value.Object([("monthly", json_of_monthly_schedule(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_schedule(v: json.Value) -> Schedule ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "oneTime" => Ok(Schedule.OneTime(from_json_one_time_schedule(fv)?))
      "daily" => Ok(Schedule.Daily(from_json_daily_schedule(fv)?))
      "weekly" => Ok(Schedule.Weekly(from_json_weekly_schedule(fv)?))
      "monthly" => Ok(Schedule.Monthly(from_json_monthly_schedule(fv)?))
      _ => Ok(Schedule.Unknown(k))
    }
  }
  Err("Schedule: no member set")
}

