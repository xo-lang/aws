  ServiceQuotaExceededException(e: ServiceQuotaExceededException)
  ThrottlingException(e: ThrottlingException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UpdateTestSetErr) display() -> Str {
  match e {
    ConflictException(x) => "ConflictException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    PreconditionFailedException(x) => "PreconditionFailedException: ${x:?}"
    ServiceQuotaExceededException(x) => "ServiceQuotaExceededException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_test_set_error(resp: http.Response) -> UpdateTestSetErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UpdateTestSetErr.ConflictException(x)
      Err(msg) => return UpdateTestSetErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return UpdateTestSetErr.InternalServerException(x)
      Err(msg) => return UpdateTestSetErr.Deserialize(msg)
    }
    "PreconditionFailedException" => match read_error_precondition_failed_exception(resp, body) {
      Ok(x) => return UpdateTestSetErr.PreconditionFailedException(x)
      Err(msg) => return UpdateTestSetErr.Deserialize(msg)
    }
    "ServiceQuotaExceededException" => match read_error_service_quota_exceeded_exception(resp, body) {
      Ok(x) => return UpdateTestSetErr.ServiceQuotaExceededException(x)
      Err(msg) => return UpdateTestSetErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateTestSetErr.ThrottlingException(x)
      Err(msg) => return UpdateTestSetErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateTestSetErr.ValidationException(x)
      Err(msg) => return UpdateTestSetErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateTestSetErr.Api(restjson.api_error(resp, body))
}

/// The action to update the test set.
pub fn (c: Client) update_test_set(input: UpdateTestSetRequest) -> UpdateTestSetResponse ! UpdateTestSetErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_test_set(c.params, input)) ?? e => return Err(UpdateTestSetErr.InvalidInput(e))
  var req = serialize_update_test_set(ep, input, "") ?? e => return Err(UpdateTestSetErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateTestSetErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_test_set_error(resp))
  }
  deserialize_update_test_set(resp) ?? e => Err(UpdateTestSetErr.Deserialize(e))
}
