    "KMSThrottlingException" => match exception_read_kms_throttling_exception(m.payload) {
      Ok(x) => SubscribeToShardEventStreamErr.KmsThrottlingException(x)
      Err(msg) => SubscribeToShardEventStreamErr.Read(msg)
    }
    "InternalFailureException" => match exception_read_internal_failure_exception(m.payload) {
      Ok(x) => SubscribeToShardEventStreamErr.InternalFailureException(x)
      Err(msg) => SubscribeToShardEventStreamErr.Read(msg)
    }
    _ => SubscribeToShardEventStreamErr.Api(aws.ApiError{code: t, message: m.payload.to_str() ?? ""})
