fn xml_write_configuration_settings_description(var w: xmlv.Writer, v: ConfigurationSettingsDescription, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.solution_stack_name {
    xmlv.elem(w, "SolutionStackName", x, [])
  }
  if let Some(x) = v.platform_arn {
    xmlv.elem(w, "PlatformArn", x, [])
  }
  if let Some(x) = v.application_name {
    xmlv.elem(w, "ApplicationName", x, [])
  }
  if let Some(x) = v.template_name {
    xmlv.elem(w, "TemplateName", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.environment_name {
    xmlv.elem(w, "EnvironmentName", x, [])
  }
  if let Some(x) = v.deployment_status {
    xmlv.elem(w, "DeploymentStatus", x.value(), [])
  }
  if let Some(x) = v.date_created {
    xmlv.elem(w, "DateCreated", rest.date_time(x), [])
  }
  if let Some(x) = v.date_updated {
    xmlv.elem(w, "DateUpdated", rest.date_time(x), [])
  }
  if let Some(x) = v.option_settings {
    xml_write_configuration_option_settings_list(w, x, "OptionSettings", [])
  }
  xmlv.end(w, name)
}

fn xml_read_configuration_settings_description(e: xml.Element) -> ConfigurationSettingsDescription ! Str {
  var out = ConfigurationSettingsDescription{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "SolutionStackName" => out.solution_stack_name = c.text()
      "PlatformArn" => out.platform_arn = c.text()
      "ApplicationName" => out.application_name = c.text()
      "TemplateName" => out.template_name = c.text()
      "Description" => out.description = c.text()
      "EnvironmentName" => out.environment_name = c.text()
      "DeploymentStatus" => out.deployment_status = ConfigurationDeploymentStatus.from(c.text())
      "DateCreated" => out.date_created = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DateUpdated" => out.date_updated = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "OptionSettings" => out.option_settings = xml_read_configuration_option_settings_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

