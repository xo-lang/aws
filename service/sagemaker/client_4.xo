fn json_of_optimization_config(v: OptimizationConfig) -> json.Value {
  match v {
    ModelQuantizationConfig(x) => json.Value.Object([("ModelQuantizationConfig", json_of_model_quantization_config(x))])
    ModelCompilationConfig(x) => json.Value.Object([("ModelCompilationConfig", json_of_model_compilation_config(x))])
    ModelShardingConfig(x) => json.Value.Object([("ModelShardingConfig", json_of_model_sharding_config(x))])
    ModelSpeculativeDecodingConfig(x) => json.Value.Object([("ModelSpeculativeDecodingConfig", json_of_model_speculative_decoding_config(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_optimization_config(v: json.Value) -> OptimizationConfig ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "ModelQuantizationConfig" => Ok(OptimizationConfig.ModelQuantizationConfig(from_json_model_quantization_config(fv)?))
      "ModelCompilationConfig" => Ok(OptimizationConfig.ModelCompilationConfig(from_json_model_compilation_config(fv)?))
      "ModelShardingConfig" => Ok(OptimizationConfig.ModelShardingConfig(from_json_model_sharding_config(fv)?))
      "ModelSpeculativeDecodingConfig" => Ok(OptimizationConfig.ModelSpeculativeDecodingConfig(from_json_model_speculative_decoding_config(fv)?))
      _ => Ok(OptimizationConfig.Unknown(k))
    }
  }
  Err("OptimizationConfig: no member set")
}

