fn json_of_listing_item(v: ListingItem) -> json.Value {
  match v {
    AssetListing(x) => json.Value.Object([("assetListing", json_of_asset_listing(x))])
    DataProductListing(x) => json.Value.Object([("dataProductListing", json_of_data_product_listing(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_listing_item(v: json.Value) -> ListingItem ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "assetListing" => Ok(ListingItem.AssetListing(from_json_asset_listing(fv)?))
      "dataProductListing" => Ok(ListingItem.DataProductListing(from_json_data_product_listing(fv)?))
      _ => Ok(ListingItem.Unknown(k))
    }
  }
  Err("ListingItem: no member set")
}

