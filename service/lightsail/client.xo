      "sizeInGb" => out.size_in_gb = jsonv.read_int(fv)?
      "isSystemDisk" => out.is_system_disk = jsonv.read_bool(fv)?
      "iops" => out.iops = jsonv.read_int(fv)?
      "path" => out.path = jsonv.read_str(fv)?
      "state" => out.state = DiskState.from(jsonv.read_str(fv)?)
      "attachedTo" => out.attached_to = jsonv.read_str(fv)?
      "isAttached" => out.is_attached = jsonv.read_bool(fv)?
      "attachmentState" => out.attachment_state = jsonv.read_str(fv)?
      "gbInUse" => out.gb_in_use = jsonv.read_int(fv)?
      "autoMountStatus" => out.auto_mount_status = AutoMountStatus.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
