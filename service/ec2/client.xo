}

fn xml_read_s3_object_tag_list(e: xml.Element) -> List[S3ObjectTag] ! Str {
  var out: List[S3ObjectTag] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_s3_object_tag(c)?)
  }
  Ok(out)
}

