fn json_of_criterion(v: Map[Str, Condition]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, Condition)) -> (Str, json.Value) { (e.0, json_of_condition(e.1)) }))
}

fn from_json_criterion(v: json.Value) -> Map[Str, Condition] ! Str {
  var out: Map[Str, Condition] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_condition(fv)?)
  }
  Ok(out)
}

