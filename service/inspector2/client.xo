fn json_of_filter_list(v: List[Filter]) -> json.Value {
  json.Value.List(v.map(fn(x: Filter) -> json.Value { json_of_filter(x) }))
}

fn from_json_filter_list(v: json.Value) -> List[Filter] ! Str {
  var out: List[Filter] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_filter(fv)?)
  }
  Ok(out)
}

fn json_of_finding(v: Finding) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.finding_arn {
    fs.push(("findingArn", json.Value.Str(x)))
  }
  if let Some(x) = v.aws_account_id {
    fs.push(("awsAccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("type", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.title {
    fs.push(("title", json.Value.Str(x)))
  }
  if let Some(x) = v.remediation {
    fs.push(("remediation", json_of_remediation(x)))
  }
  if let Some(x) = v.severity {
    fs.push(("severity", json.Value.Str(x)))
