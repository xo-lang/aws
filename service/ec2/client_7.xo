  }
  if let Some(x) = v.transport_transit_gateway_attachment_id {
    xmlv.elem(w, "transportTransitGatewayAttachmentId", x, [])
  }
  if let Some(x) = v.tunnel_inside_ip_version {
    xmlv.elem(w, "tunnelInsideIpVersion", x.value(), [])
  }
  if let Some(x) = v.tunnel_options {
    xml_write_tunnel_options_list(w, x, "tunnelOptionSet", [])
  }
  if let Some(x) = v.tunnel_bandwidth {
    xmlv.elem(w, "tunnelBandwidth", x.value(), [])
  }
  xmlv.end(w, name)
