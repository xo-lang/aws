fn xml_write_instance_secondary_interface(var w: xmlv.Writer, v: InstanceSecondaryInterface, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.attachment {
    xml_write_instance_secondary_interface_attachment(w, x, "attachment", [])
  }
  if let Some(x) = v.mac_address {
    xmlv.elem(w, "macAddress", x, [])
  }
  if let Some(x) = v.secondary_interface_id {
    xmlv.elem(w, "secondaryInterfaceId", x, [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.private_ip_addresses {
    xml_write_instance_secondary_interface_private_ip_address_list(w, x, "privateIpAddressSet", [])
  }
  if let Some(x) = v.source_dest_check {
    xmlv.elem(w, "sourceDestCheck", "${x}", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.secondary_subnet_id {
    xmlv.elem(w, "secondarySubnetId", x, [])
  }
  if let Some(x) = v.secondary_network_id {
    xmlv.elem(w, "secondaryNetworkId", x, [])
  }
  if let Some(x) = v.interface_type {
    xmlv.elem(w, "interfaceType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_secondary_interface(e: xml.Element) -> InstanceSecondaryInterface ! Str {
  var out = InstanceSecondaryInterface{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "attachment" => out.attachment = xml_read_instance_secondary_interface_attachment(c)?
      "macAddress" => out.mac_address = c.text()
      "secondaryInterfaceId" => out.secondary_interface_id = c.text()
      "ownerId" => out.owner_id = c.text()
      "privateIpAddressSet" => out.private_ip_addresses = xml_read_instance_secondary_interface_private_ip_address_list(c)?
      "sourceDestCheck" => out.source_dest_check = xmlv.read_bool(c.text())?
      "status" => out.status = SecondaryInterfaceStatus.from(c.text())
      "secondarySubnetId" => out.secondary_subnet_id = c.text()
      "secondaryNetworkId" => out.secondary_network_id = c.text()
      "interfaceType" => out.interface_type = SecondaryInterfaceType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_instance_secondary_interface_attachment(var w: xmlv.Writer, v: InstanceSecondaryInterfaceAttachment, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.attach_time {
    xmlv.elem(w, "attachTime", rest.date_time(x), [])
  }
  if let Some(x) = v.attachment_id {
    xmlv.elem(w, "attachmentId", x, [])
  }
  if let Some(x) = v.delete_on_termination {
    xmlv.elem(w, "deleteOnTermination", "${x}", [])
  }
  if let Some(x) = v.device_index {
    xmlv.elem(w, "deviceIndex", "${x}", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.network_card_index {
    xmlv.elem(w, "networkCardIndex", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_secondary_interface_attachment(e: xml.Element) -> InstanceSecondaryInterfaceAttachment ! Str {
  var out = InstanceSecondaryInterfaceAttachment{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "attachTime" => out.attach_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "attachmentId" => out.attachment_id = c.text()
      "deleteOnTermination" => out.delete_on_termination = xmlv.read_bool(c.text())?
      "deviceIndex" => out.device_index = xmlv.read_int(c.text())?
      "status" => out.status = AttachmentStatus.from(c.text())
      "networkCardIndex" => out.network_card_index = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_instance_secondary_interface_list(var w: xmlv.Writer, v: List[InstanceSecondaryInterface], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_instance_secondary_interface(w, item, "item", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_secondary_interface_list(e: xml.Element) -> List[InstanceSecondaryInterface] ! Str {
  var out: List[InstanceSecondaryInterface] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_instance_secondary_interface(c)?)
  }
  Ok(out)
}

