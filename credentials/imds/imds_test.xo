use std/http
use std/testing
use github.com/xo-lang/aws

const BASE: Str = "http://169.254.169.254"
const CREDS: Str = "{\"Code\":\"Success\",\"Type\":\"AWS-HMAC\",\"AccessKeyId\":\"ASIATEST0000000000\",\"SecretAccessKey\":\"invented-secret\",\"Token\":\"invented-token\",\"Expiration\":\"2026-01-01T06:00:00Z\"}"

fn serve(net: testing.FakeNet, tokens: Mutex[Int]) {
  net.handle("PUT ${BASE}/latest/api/token", fn(req: http.Request) -> http.Response {
    tokens.with(fn(var n: Int) { n += 1 })
    expect(req.header("X-Aws-Ec2-Metadata-Token-Ttl-Seconds")) == Some("21600")
    http.text(200, "tok-1").with_header("X-Aws-Ec2-Metadata-Token-Ttl-Seconds", "21600")
  })
  net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/", fn(req: http.Request) -> http.Response {
    if req.header("X-Aws-Ec2-Metadata-Token") != Some("tok-1") {
      return http.text(401, "")
    }
    http.text(200, "my-role\n")
  })
  net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/my-role", fn(req: http.Request) -> http.Response {
    if req.header("X-Aws-Ec2-Metadata-Token") != Some("tok-1") {
      return http.text(401, "")
    }
    http.text(200, CREDS)
  })
}

test "IMDSv2: a token, the role, its credentials, capped at an hour; the token is reused" {
  let tokens = Mutex[Int].new(0)
  serve(os.net, tokens)
  let p = provider(os.net, os.clock, os.rand)
  let c = p.retrieve()?
  expect(c.access_key_id) == "ASIATEST0000000000"
  expect(c.secret_access_key.reveal()) == "invented-secret"
  expect(c.session_token.map(fn(t: Secret[Str]) -> Str { t.reveal() })) == Some("invented-token")
  expect(c.source) == "EC2RoleProvider"
  let hour = os.clock.now().unix_millis() + 3600 * 1000
  expect(c.expires.map(fn(t: Time) -> Int { t.unix_millis() })) == Some(hour)
  p.retrieve()?
  expect(tokens.with_read(fn(n: Int) -> Int { n })) == 1
}

test "no metadata endpoint is NotFound, so a chain moves on" {
  match provider(os.net, os.clock, os.rand).retrieve() {
    Err(aws.CredentialsErr.NotFound(_)) => {}
    other => expect("${other:?}") == "NotFound"
  }
}

test "an instance with no role is NotFound" {
  os.net.handle("PUT ${BASE}/latest/api/token", fn(req: http.Request) -> http.Response { http.text(200, "tok-1") })
  os.net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/", fn(req: http.Request) -> http.Response { http.text(404, "") })
  match provider(os.net, os.clock, os.rand).retrieve() {
    Err(aws.CredentialsErr.NotFound(m)) => expect(m.contains("no role")) == true
    other => expect("${other:?}") == "NotFound"
  }
}

test "a refused token fails unless the IMDSv1 fallback is on" {
  os.net.handle("PUT ${BASE}/latest/api/token", fn(req: http.Request) -> http.Response { http.text(403, "") })
  os.net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/", fn(req: http.Request) -> http.Response {
    expect(req.header("X-Aws-Ec2-Metadata-Token")) == None
    http.text(200, "my-role")
  })
  os.net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/my-role", fn(req: http.Request) -> http.Response { http.text(200, CREDS) })
  match provider(os.net, os.clock, os.rand).retrieve() {
    Err(aws.CredentialsErr.Fetch(m)) => expect(m.contains("allow_v1")) == true
    other => expect("${other:?}") == "Fetch"
  }
  let v1 = provider(os.net, os.clock, os.rand, Options{allow_v1: true}).retrieve()?
  expect(v1.access_key_id) == "ASIATEST0000000000"
}

test "a 401 drops the token and asks for a new one" {
  let tokens = Mutex[Int].new(0)
  os.net.handle("PUT ${BASE}/latest/api/token", fn(req: http.Request) -> http.Response {
    let n = tokens.with(fn(var n: Int) -> Int { n += 1; n })
    http.text(200, "tok-${n}")
  })
  os.net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/", fn(req: http.Request) -> http.Response {
    if req.header("X-Aws-Ec2-Metadata-Token") != Some("tok-2") {
      return http.text(401, "")
    }
    http.text(200, "my-role")
  })
  os.net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/my-role", fn(req: http.Request) -> http.Response { http.text(200, CREDS) })
  let c = provider(os.net, os.clock, os.rand).retrieve()?
  expect(c.access_key_id) == "ASIATEST0000000000"
  expect(tokens.with_read(fn(n: Int) -> Int { n })) == 2
}

test "when a refresh fails, the last credentials are kept for 5 to 15 more minutes" {
  let down = Mutex[Bool].new(false)
  os.net.handle("PUT ${BASE}/latest/api/token", fn(req: http.Request) -> http.Response { http.text(200, "tok-1") })
  os.net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/", fn(req: http.Request) -> http.Response {
    if down.with_read(fn(d: Bool) -> Bool { d }) {
      return http.text(503, "")
    }
    http.text(200, "my-role")
  })
  os.net.handle("GET ${BASE}/latest/meta-data/iam/security-credentials/my-role", fn(req: http.Request) -> http.Response { http.text(200, CREDS) })
  let p = provider(os.net, os.clock, os.rand)
  let first = p.retrieve()?
  down.reset(true)
  // still an hour left: the same credentials
  expect(p.retrieve()?.expires) == first.expires
  // near expiry: extended by 5 to 15 minutes from now
  os.clock.advance(58m)
  let kept = p.retrieve()?
  let left = (kept.expires.map(fn(t: Time) -> Int { t.unix_millis() }) ?? 0) - os.clock.now().unix_millis()
  expect(left >= 5 * 60 * 1000 && left <= 15 * 60 * 1000) == true
  expect(kept.access_key_id) == "ASIATEST0000000000"
}

test "the endpoint: given, else IPv4, or IPv6 by mode" {
  expect(endpoint_of(Options{})) == "http://169.254.169.254"
  expect(endpoint_of(Options{mode: "IPv6"})) == "http://[fd00:ec2::254]"
  expect(endpoint_of(Options{endpoint: "http://127.0.0.1:1338/"})) == "http://127.0.0.1:1338"
}
