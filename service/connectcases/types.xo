/// case field conditions to a case template .
pub struct TemplateRule {
  /// Unique identifier of a case rule.
  pub case_rule_id: Str? = None
  /// Unique identifier of a field.
  pub field_id: Str? = None
}

/// Template summary information.
pub struct TemplateSummary {
  /// The unique identifier for the template.
  pub template_id: Str? = None
  /// The Amazon Resource Name (ARN) of the template.
  pub template_arn: Str? = None
  /// The template name.
  pub name: Str? = None
  /// The status of the template.
  pub status: Str? = None
  /// Defines tag propagation configuration for resources created within a
  /// domain. Tags specified here will be automatically applied to resources
  /// being created for the specified resource type.
  pub tag_propagation_configurations: List[TagPropagationConfiguration]? = None
}

