use std/http
use std/json
use std/testing
use github.com/xo-lang/aws
use github.com/xo-lang/aws/credentials
use github.com/xo-lang/aws/protocol/jsonv

const PORTAL: Str = "https://portal.sso.us-west-2.amazonaws.com"
const OIDC: Str = "https://oidc.us-west-2.amazonaws.com"
const ROLE_CREDS: Str = "{\"roleCredentials\":{\"accessKeyId\":\"ASIASSOEXAMPLE00001\",\"secretAccessKey\":\"invented-sso-secret\",\"sessionToken\":\"invented-sso-token\",\"expiration\":1767229200000}}"

fn token_json(access: Str, expires: Str) -> Str {
  "{\"accessToken\":\"${access}\",\"expiresAt\":\"${expires}\",\"refreshToken\":\"refresh-1\",\"clientId\":\"client-1\",\"clientSecret\":\"secret-1\",\"region\":\"us-west-2\",\"startUrl\":\"https://example.awsapps.com/start\"}"
}

fn serve_portal(n: testing.FakeNet, want: Str) {
  n.handle("GET ${PORTAL}/federation/credentials", fn(req: http.Request) -> http.Response {
    if req.header("x-amz-sso_bearer_token") != Some(want) {
      return http.text(401, "{\"message\":\"Session token not found or invalid\"}").with_header("x-amzn-ErrorType", "UnauthorizedException:http://internal.amazon.com/coral/com.amazonaws.switchboard.portal/")
    }
    expect(req.url.query.get("account_id")) == Some("123456789012")
    expect(req.url.query.get("role_name")) == Some("Dev")
    http.text(200, ROLE_CREDS).with_header("Content-Type", "application/json")
  })
}

fn opts(token: aws.TokenFile, refresh: Bool) -> Options {
  Options{region: "us-west-2", account_id: "123456789012", role_name: "Dev", token: token, refresh: refresh}
}

test "the cache file name is the SHA-1 of the key, as aws-sdk-go-v2" {
  expect(cache_path("/h", "https://example.awsapps.com/start")) == "/h/.aws/sso/cache/e8be5486177c5b5392bd9aa76563515b29358e6e.json"
}

test "a valid cached token gets the role's credentials" {
  serve_portal(os.net, "access-1")
  let p = provider(os.net, os.clock, opts(aws.fixed_token(token_json("access-1", "2026-01-01T08:00:00Z")), false))
  let c = p.retrieve()?
  expect(c.access_key_id) == "ASIASSOEXAMPLE00001"
  expect(c.secret_access_key.reveal()) == "invented-sso-secret"
  expect(c.account_id) == Some("123456789012")
  expect(c.source) == "SSOProvider"
  expect(c.expires.map(fn(t: Time) -> Str { t.format_rfc3339() })) == Some("2026-01-01T01:00:00Z")
}

test "an expired token is refreshed through SSO OIDC and kept for the cache file" {
  os.net.handle("POST ${OIDC}/token", fn(req: http.Request) -> http.Response {
    let b = jsonv.parse_body(req.body).ok() ?? json.Value.Null
    expect(str_field(b, "grantType")) == "refresh_token"
    expect(str_field(b, "refreshToken")) == "refresh-1"
    expect(str_field(b, "clientId")) == "client-1"
    http.text(200, "{\"accessToken\":\"access-2\",\"expiresIn\":3600,\"refreshToken\":\"refresh-2\",\"tokenType\":\"Bearer\"}")
  })
  serve_portal(os.net, "access-2")
  let tok = aws.fixed_token(token_json("access-1", "2025-12-31T23:00:00Z"))
  let c = provider(os.net, os.clock, opts(tok, true)).retrieve()?
  expect(c.access_key_id) == "ASIASSOEXAMPLE00001"
  let kept = jsonv.parse_body(tok.get().reveal().bytes())?
  expect(str_field(kept, "accessToken")) == "access-2"
  expect(str_field(kept, "refreshToken")) == "refresh-2"
  expect(str_field(kept, "expiresAt")) == "2026-01-01T01:00:00Z"
  // other fields stay
  expect(str_field(kept, "startUrl")) == "https://example.awsapps.com/start"
}

test "an expired token without a session, or a refused one, says to log in" {
  let p = provider(os.net, os.clock, opts(aws.fixed_token(token_json("access-1", "2025-12-31T23:00:00Z")), false))
  match p.retrieve() {
    Err(aws.CredentialsErr.Fetch(m)) => expect(m.contains("run aws sso login")) == true
    other => expect("${other:?}") == "Fetch"
  }
  serve_portal(os.net, "other")
  let q = provider(os.net, os.clock, opts(aws.fixed_token(token_json("access-1", "2026-01-01T08:00:00Z")), false))
  match q.retrieve() {
    Err(aws.CredentialsErr.Fetch(m)) => {
      expect(m.contains("HTTP 401 UnauthorizedException")) == true
      expect(m.contains("run aws sso login")) == true
    }
    other => expect("${other:?}") == "Fetch"
  }
}

test "a refreshed token is written back by the token file's watch, keeping its mode" {
  os.fs.create_dir_all("/h/.aws/sso/cache")?
  let path = cache_path("/h", "my-sso")
  os.fs.write(path, token_json("access-1", "2025-12-31T23:00:00Z").bytes())?
  os.fs.set_mode(path, 0o600)?
  os.net.handle("POST ${OIDC}/token", fn(req: http.Request) -> http.Response {
    http.text(200, "{\"accessToken\":\"access-2\",\"expiresIn\":3600,\"refreshToken\":\"refresh-2\"}")
  })
  serve_portal(os.net, "access-2")
  let tok = credentials.load_token_file(os.fs, path)?
  provider(os.net, os.clock, opts(tok, true)).retrieve()?
  os.tasks.spawn_background(fn() { credentials.watch(tok, os.fs, os.clock) })
  os.clock.advance(6m)
  let on_disk = jsonv.parse_body(os.fs.read(path)?)?
  expect(str_field(on_disk, "accessToken")) == "access-2"
  expect(os.fs.mode(path)?) == 0o600
}

test "a repeated error type is its first field, as Go's Header.Get" {
  let resp = http.text(400, "{\"message\":\"bad\"}").add_header("x-amzn-ErrorType", "ValidationException").add_header("x-amzn-ErrorType", "UnauthorizedException")
  expect(api_error("GetRoleCredentials", resp)) == "GetRoleCredentials: HTTP 400 ValidationException bad"
}
