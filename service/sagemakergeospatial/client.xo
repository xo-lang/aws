      "Assets" => out.assets = from_json_assets_map(fv)?
      "DateTime" => out.date_time = jsonv.read_time(fv, "epoch-seconds")?
      "Properties" => out.properties = from_json_properties(fv)?
      _ => {}
    }
  }
  Ok(out)
}

