fn xml_write_foo_enum_map(var w: xmlv.Writer, v: Map[Str, FooEnum], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xmlv.elem(w, "value", item.value(), [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_foo_enum_map(e: xml.Element) -> Map[Str, FooEnum] ! Str {
  var out: Map[Str, FooEnum] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, FooEnum.from(vc.text()))
    }
  }
  Ok(out)
}

