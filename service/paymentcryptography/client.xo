      "DeriveKeyUsage" => out.derive_key_usage = jsonv.read_str(fv)?
      "MultiRegionKeyType" => out.multi_region_key_type = jsonv.read_str(fv)?
      "PrimaryRegion" => out.primary_region = jsonv.read_str(fv)?
      "ReplicationStatus" => out.replication_status = from_json_replication_status(fv)?
      "UsingDefaultReplicationRegions" => out.using_default_replication_regions = jsonv.read_bool(fv)?
      "MpaStatus" => out.mpa_status = from_json_mpa_status(fv)?
