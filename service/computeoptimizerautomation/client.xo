    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    ForbiddenException(x) => "ForbiddenException: ${x:?}"
    IdempotencyTokenInUseException(x) => "IdempotencyTokenInUseException: ${x:?}"
    IdempotentParameterMismatchException(x) => "IdempotentParameterMismatchException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    InvalidParameterValueException(x) => "InvalidParameterValueException: ${x:?}"
    NotManagementAccountException(x) => "NotManagementAccountException: ${x:?}"
    OptInRequiredException(x) => "OptInRequiredException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ServiceUnavailableException(x) => "ServiceUnavailableException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

