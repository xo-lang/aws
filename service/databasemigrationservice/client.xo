fn json_of_orderable_replication_instance(v: OrderableReplicationInstance) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.engine_version {
    fs.push(("EngineVersion", json.Value.Str(x)))
  }
  if let Some(x) = v.replication_instance_class {
    fs.push(("ReplicationInstanceClass", json.Value.Str(x)))
  }
  if let Some(x) = v.storage_type {
    fs.push(("StorageType", json.Value.Str(x)))
  }
  if let Some(x) = v.min_allocated_storage {
    fs.push(("MinAllocatedStorage", json.Value.Int(x)))
  }
  if let Some(x) = v.max_allocated_storage {
    fs.push(("MaxAllocatedStorage", json.Value.Int(x)))
  }
  if let Some(x) = v.default_allocated_storage {
    fs.push(("DefaultAllocatedStorage", json.Value.Int(x)))
  }
  if let Some(x) = v.included_allocated_storage {
    fs.push(("IncludedAllocatedStorage", json.Value.Int(x)))
  }
  if let Some(x) = v.availability_zones {
    fs.push(("AvailabilityZones", json_of_availability_zones_list(x)))
  }
  if let Some(x) = v.release_status {
    fs.push(("ReleaseStatus", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_orderable_replication_instance(v: json.Value) -> OrderableReplicationInstance ! Str {
  var out = OrderableReplicationInstance{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "EngineVersion" => out.engine_version = jsonv.read_str(fv)?
      "ReplicationInstanceClass" => out.replication_instance_class = jsonv.read_str(fv)?
      "StorageType" => out.storage_type = jsonv.read_str(fv)?
      "MinAllocatedStorage" => out.min_allocated_storage = jsonv.read_int(fv)?
      "MaxAllocatedStorage" => out.max_allocated_storage = jsonv.read_int(fv)?
      "DefaultAllocatedStorage" => out.default_allocated_storage = jsonv.read_int(fv)?
      "IncludedAllocatedStorage" => out.included_allocated_storage = jsonv.read_int(fv)?
      "AvailabilityZones" => out.availability_zones = from_json_availability_zones_list(fv)?
      "ReleaseStatus" => out.release_status = ReleaseStatusValues.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_orderable_replication_instance_list(v: List[OrderableReplicationInstance]) -> json.Value {
  json.Value.List(v.map(fn(x: OrderableReplicationInstance) -> json.Value { json_of_orderable_replication_instance(x) }))
}

fn from_json_orderable_replication_instance_list(v: json.Value) -> List[OrderableReplicationInstance] ! Str {
  var out: List[OrderableReplicationInstance] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_orderable_replication_instance(fv)?)
  }
  Ok(out)
}

fn json_of_pending_maintenance_action(v: PendingMaintenanceAction) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.action {
    fs.push(("Action", json.Value.Str(x)))
  }
  if let Some(x) = v.auto_applied_after_date {
    fs.push(("AutoAppliedAfterDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.forced_apply_date {
    fs.push(("ForcedApplyDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.opt_in_status {
    fs.push(("OptInStatus", json.Value.Str(x)))
  }
  if let Some(x) = v.current_apply_date {
    fs.push(("CurrentApplyDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_pending_maintenance_action(v: json.Value) -> PendingMaintenanceAction ! Str {
  var out = PendingMaintenanceAction{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
