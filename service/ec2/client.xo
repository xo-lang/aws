    xmlv.elem(w, "statusTimeStamp", rest.date_time(x), [])
  }
  if let Some(x) = v.status_since {
    xmlv.elem(w, "statusSince", rest.date_time(x), [])
  }
  if let Some(x) = v.resume_at {
    xmlv.elem(w, "resumeAt", rest.date_time(x), [])
  }
  if let Some(x) = v.details {
    xml_write_application_status_detail_set(w, x, "detailSet", [])
