  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.ipam_prefix_list_resolver_target_id {
    xmlv.elem(w, "ipamPrefixListResolverTargetId", x, [])
  }
  if let Some(x) = v.ipam_prefix_list_resolver_sync_enabled {
