    Some(v) => v
    None => return Err("input member domainId is required")
  }
  if label_domain_id == "" {
    return Err("input member domainId must not be empty")
  }
  let label_template_id = match input.template_id {
    Some(v) => v
    None => return Err("input member templateId is required")
  }
  if label_template_id == "" {
    return Err("input member templateId must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = input.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = input.layout_configuration {
    fs.push(("layoutConfiguration", json_of_layout_configuration(x)))
  }
  if let Some(x) = input.required_fields {
    fs.push(("requiredFields", json_of_required_field_list(x)))
  }
  if let Some(x) = input.status {
    fs.push(("status", json.Value.Str(x)))
  }
  if let Some(x) = input.rules {
    fs.push(("rules", json_of_template_case_rule_list(x)))
  }
  if let Some(x) = input.tag_propagation_configurations {
    fs.push(("tagPropagationConfigurations", json_of_tag_propagation_configuration_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PUT",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/domains/${rest.escape(label_domain_id, false)}/templates/${rest.escape(label_template_id, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
