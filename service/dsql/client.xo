  let (ep, signing, extra) = c.route(endpoint_params_update_cluster(c.params, input)) ?? e => return Err(UpdateClusterErr.InvalidInput(e))
  var req = serialize_update_cluster(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateClusterErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateClusterErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_cluster_error(resp))
  }
  deserialize_update_cluster(resp) ?? e => Err(UpdateClusterErr.Deserialize(e))
