      "SecurityLake" => Ok(DirectQueryDataSourceType.SecurityLake(from_json_security_lake_direct_query_data_source(fv)?))
      "Prometheus" => Ok(DirectQueryDataSourceType.Prometheus(from_json_prometheus_direct_query_data_source(fv)?))
