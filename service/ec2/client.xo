fn query_put_allocate_address_result(var f: query.Form, prefix: Str, v: AllocateAddressResult) {
  if let Some(x) = v.allocation_id {
    query.add(f, query.key(prefix, "AllocationId"), x)
  }
  if let Some(x) = v.public_ipv4_pool {
    query.add(f, query.key(prefix, "PublicIpv4Pool"), x)
  }
  if let Some(x) = v.network_border_group {
    query.add(f, query.key(prefix, "NetworkBorderGroup"), x)
