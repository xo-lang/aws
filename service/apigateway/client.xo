  }
  if let Some(x) = v.api_key_required {
    fs.push(("apiKeyRequired", json.Value.Bool(x)))
  }
  if let Some(x) = v.request_validator_id {
    fs.push(("requestValidatorId", json.Value.Str(x)))
  }
  if let Some(x) = v.operation_name {
    fs.push(("operationName", json.Value.Str(x)))
  }
  if let Some(x) = v.request_parameters {
    fs.push(("requestParameters", json_of_map_of_string_to_boolean(x)))
  }
  if let Some(x) = v.request_models {
    fs.push(("requestModels", json_of_map_of_string_to_string(x)))
  }
  if let Some(x) = v.method_responses {
    fs.push(("methodResponses", json_of_map_of_method_response(x)))
  }
  if let Some(x) = v.method_integration {
    fs.push(("methodIntegration", json_of_integration(x)))
  }
  if let Some(x) = v.authorization_scopes {
    fs.push(("authorizationScopes", json_of_list_of_string(x)))
  }
  json.Value.Object(fs)
}

fn from_json_method(v: json.Value) -> Method ! Str {
  var out = Method{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "httpMethod" => out.http_method = jsonv.read_str(fv)?
      "authorizationType" => out.authorization_type = jsonv.read_str(fv)?
      "authorizerId" => out.authorizer_id = jsonv.read_str(fv)?
      "apiKeyRequired" => out.api_key_required = jsonv.read_bool(fv)?
      "requestValidatorId" => out.request_validator_id = jsonv.read_str(fv)?
      "operationName" => out.operation_name = jsonv.read_str(fv)?
      "requestParameters" => out.request_parameters = from_json_map_of_string_to_boolean(fv)?
