    xml_write_instance_market_options_request(w, x, "InstanceMarketOptions", [])
  }
  if let Some(x) = v.credit_specification {
    xml_write_credit_specification_request(w, x, "CreditSpecification", [])
  }
  if let Some(x) = v.cpu_options {
    xml_write_cpu_options_request(w, x, "CpuOptions", [])
  }
  if let Some(x) = v.capacity_reservation_specification {
    xml_write_capacity_reservation_specification(w, x, "CapacityReservationSpecification", [])
  }
  if let Some(x) = v.hibernation_options {
    xml_write_hibernation_options_request(w, x, "HibernationOptions", [])
  }
  if let Some(x) = v.license_specifications {
    xml_write_license_specification_list_request(w, x, "LicenseSpecification", [])
  }
  if let Some(x) = v.metadata_options {
    xml_write_instance_metadata_options_request(w, x, "MetadataOptions", [])
  }
  if let Some(x) = v.enclave_options {
    xml_write_enclave_options_request(w, x, "EnclaveOptions", [])
  }
  if let Some(x) = v.private_dns_name_options {
    xml_write_private_dns_name_options_request(w, x, "PrivateDnsNameOptions", [])
  }
  if let Some(x) = v.maintenance_options {
    xml_write_instance_maintenance_options_request(w, x, "MaintenanceOptions", [])
  }
  if let Some(x) = v.disable_api_stop {
    xmlv.elem(w, "DisableApiStop", "${x}", [])
  }
  if let Some(x) = v.enable_primary_ipv6 {
    xmlv.elem(w, "EnablePrimaryIpv6", "${x}", [])
  }
  if let Some(x) = v.network_performance_options {
    xml_write_instance_network_performance_options_request(w, x, "NetworkPerformanceOptions", [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_request(w, x, "Operator", [])
  }
  if let Some(x) = v.secondary_interfaces {
    xml_write_instance_secondary_interface_specification_list_request(w, x, "SecondaryInterface", [])
  }
  if let Some(x) = v.dry_run {
