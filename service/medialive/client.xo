      "channelEngineVersion" => out.channel_engine_version = from_json_channel_engine_version_response(fv)?
      "usedChannelEngineVersions" => out.used_channel_engine_versions = from_json_list_of_channel_engine_version_response(fv)?
      "linkedChannelSettings" => out.linked_channel_settings = from_json_describe_linked_channel_settings(fv)?
      "channelSecurityGroups" => out.channel_security_groups = from_json_list_of_string(fv)?
      "inferenceSettings" => out.inference_settings = from_json_describe_inference_settings(fv)?
      _ => {}
    }
