  var out = VgwTelemetry{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "acceptedRouteCount" => out.accepted_route_count = xmlv.read_int(c.text())?
      "lastStatusChange" => out.last_status_change = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "outsideIpAddress" => out.outside_ip_address = c.text()
      "status" => out.status = TelemetryStatus.from(c.text())
      "statusMessage" => out.status_message = c.text()
      "certificateArn" => out.certificate_arn = c.text()
      _ => {}
    }
  }
  Ok(out)
}

