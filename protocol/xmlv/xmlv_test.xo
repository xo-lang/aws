test "writer" {
  var w = writer()
  start(w, "Root", [("xmlns", "https://example.com/ns")])
  elem(w, "A", "x<y&\"z\"")
  elem(w, "B", "", [("k", "v\"1")])
  end(w, "Root")
  expect(finish(w).to_str() ?? "") == "<Root xmlns=\"https://example.com/ns\"><A>x&lt;y&amp;&#34;z&#34;</A><B k=\"v&#34;1\"></B></Root>"
}

test "readers" {
  let e = parse_body(b"<R><A> 12 </A><B>true</B><C>aGk=</C><D>1.5</D></R>")?
  expect(read_int(child_text(e, "A") ?? "")?) == 12
  expect(read_bool(child_text(e, "B") ?? "")?) == true
  expect(read_blob(child_text(e, "C") ?? "")?) == b"hi"
  expect(read_float(child_text(e, "D") ?? "")?) == 1.5
  expect(elements(e).len()) == 4
  expect(child_text(e, "Z")) == None
}
