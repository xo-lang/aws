  /// engine rules, for use in a Next Generation policy.
  pub type_value: RuleGroupType? = None
  /// The maximum operating resources that this rule group can use. Rule group
  /// capacity is fixed at creation. When you update a rule group, you are
  /// limited to this capacity. When you reference a rule group from a
  /// firewall policy, Network Firewall reserves this capacity for the rule
  /// group. You can retrieve the capacity that would be required for a rule
  /// group before you create the rule group by calling CreateRuleGroup with
  /// DryRun set to TRUE .
  pub capacity: Int? = None
  /// Detailed information about the current status of a rule group.
  pub rule_group_status: ResourceStatus? = None
  /// The key:value pairs to associate with the resource.
  pub tags: List[Tag]? = None
  /// The number of capacity units currently consumed by the rule group rules.
  pub consumed_capacity: Int? = None
  /// The number of firewall policies that use this rule group.
  pub number_of_associations: Int? = None
  /// A complex type that contains the Amazon Web Services KMS encryption
  /// configuration settings for your rule group.
  pub encryption_configuration: EncryptionConfiguration? = None
  /// A complex type that contains metadata about the rule group that your own
  /// rule group is copied from. You can use the metadata to track the version
  /// updates made to the originating rule group.
  pub source_metadata: SourceMetadata? = None
  /// The Amazon Resource Name (ARN) of the Amazon Simple Notification Service
  /// SNS topic that's used to record changes to the managed rule group. You
  /// can subscribe to the SNS topic to receive notifications when the managed
  /// rule group is modified, such as for new versions and for version
  /// expiration. For more information, see the Amazon Simple Notification
  /// Service Developer Guide. .
  pub sns_topic: Str? = None
  /// The last time that the rule group was changed.
  pub last_modified_time: Time? = None
  /// The list of analysis results for AnalyzeRuleGroup . If you set
  /// AnalyzeRuleGroup to TRUE in CreateRuleGroup , UpdateRuleGroup , or
  /// DescribeRuleGroup , Network Firewall analyzes the rule group and
  /// identifies the rules that might adversely effect your firewall's
  /// functionality. For example, if Network Firewall detects a rule that's
  /// routing traffic asymmetrically, which impacts the service's ability to
  /// properly process traffic, the service includes the rule in the list of
  /// analysis results.
  pub analysis_results: List[AnalysisResult]? = None
  /// A complex type containing the currently selected rule option fields that
  /// will be displayed for rule summarization returned by
  /// DescribeRuleGroupSummary . The RuleOptions specified in
  /// SummaryConfiguration Rule metadata organization preferences
  pub summary_configuration: SummaryConfiguration? = None
}

pub enum RuleGroupType: Str {
