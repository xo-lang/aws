fn exception_subscribe_to_shard_event_stream(m: eventstream.Message) -> SubscribeToShardEventStreamErr {
  let t = m.header_str(":exception-type")
  match t {
    "ResourceNotFoundException" => match exception_read_resource_not_found_exception(m.payload) {
      Ok(x) => SubscribeToShardEventStreamErr.ResourceNotFoundException(x)
