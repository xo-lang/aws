  }
  Ok(out)
}

fn xml_write_instance_requirements(var w: xmlv.Writer, v: InstanceRequirements, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.v_cpu_count {
    xml_write_v_cpu_count_range(w, x, "vCpuCount", [])
  }
  if let Some(x) = v.memory_mi_b {
    xml_write_memory_mi_b(w, x, "memoryMiB", [])
  }
  if let Some(x) = v.cpu_manufacturers {
    xml_write_cpu_manufacturer_set(w, x, "cpuManufacturerSet", [])
  }
  if let Some(x) = v.memory_gi_b_per_v_cpu {
    xml_write_memory_gi_b_per_v_cpu(w, x, "memoryGiBPerVCpu", [])
  }
  if let Some(x) = v.excluded_instance_types {
    xml_write_excluded_instance_type_set(w, x, "excludedInstanceTypeSet", [])
  }
  if let Some(x) = v.instance_generations {
    xml_write_instance_generation_set(w, x, "instanceGenerationSet", [])
  }
  if let Some(x) = v.spot_max_price_percentage_over_lowest_price {
    xmlv.elem(w, "spotMaxPricePercentageOverLowestPrice", "${x}", [])
  }
  if let Some(x) = v.on_demand_max_price_percentage_over_lowest_price {
    xmlv.elem(w, "onDemandMaxPricePercentageOverLowestPrice", "${x}", [])
  }
  if let Some(x) = v.bare_metal {
    xmlv.elem(w, "bareMetal", x.value(), [])
  }
  if let Some(x) = v.burstable_performance {
    xmlv.elem(w, "burstablePerformance", x.value(), [])
  }
  if let Some(x) = v.require_hibernate_support {
    xmlv.elem(w, "requireHibernateSupport", "${x}", [])
  }
  if let Some(x) = v.network_interface_count {
    xml_write_network_interface_count(w, x, "networkInterfaceCount", [])
  }
  if let Some(x) = v.local_storage {
    xmlv.elem(w, "localStorage", x.value(), [])
  }
  if let Some(x) = v.local_storage_types {
    xml_write_local_storage_type_set(w, x, "localStorageTypeSet", [])
  }
  if let Some(x) = v.total_local_storage_gb {
    xml_write_total_local_storage_gb(w, x, "totalLocalStorageGB", [])
  }
  if let Some(x) = v.baseline_ebs_bandwidth_mbps {
    xml_write_baseline_ebs_bandwidth_mbps(w, x, "baselineEbsBandwidthMbps", [])
  }
  if let Some(x) = v.accelerator_types {
    xml_write_accelerator_type_set(w, x, "acceleratorTypeSet", [])
  }
  if let Some(x) = v.accelerator_count {
    xml_write_accelerator_count(w, x, "acceleratorCount", [])
  }
  if let Some(x) = v.accelerator_manufacturers {
    xml_write_accelerator_manufacturer_set(w, x, "acceleratorManufacturerSet", [])
  }
  if let Some(x) = v.accelerator_names {
    xml_write_accelerator_name_set(w, x, "acceleratorNameSet", [])
  }
  if let Some(x) = v.accelerator_total_memory_mi_b {
    xml_write_accelerator_total_memory_mi_b(w, x, "acceleratorTotalMemoryMiB", [])
  }
  if let Some(x) = v.network_bandwidth_gbps {
    xml_write_network_bandwidth_gbps(w, x, "networkBandwidthGbps", [])
  }
  if let Some(x) = v.allowed_instance_types {
    xml_write_allowed_instance_type_set(w, x, "allowedInstanceTypeSet", [])
  }
  if let Some(x) = v.max_spot_price_as_percentage_of_optimal_on_demand_price {
    xmlv.elem(w, "maxSpotPriceAsPercentageOfOptimalOnDemandPrice", "${x}", [])
  }
  if let Some(x) = v.baseline_performance_factors {
    xml_write_baseline_performance_factors(w, x, "baselinePerformanceFactors", [])
  }
  if let Some(x) = v.require_encryption_in_transit {
    xmlv.elem(w, "requireEncryptionInTransit", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_requirements(e: xml.Element) -> InstanceRequirements ! Str {
  var out = InstanceRequirements{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "vCpuCount" => out.v_cpu_count = xml_read_v_cpu_count_range(c)?
      "memoryMiB" => out.memory_mi_b = xml_read_memory_mi_b(c)?
      "cpuManufacturerSet" => out.cpu_manufacturers = xml_read_cpu_manufacturer_set(c)?
      "memoryGiBPerVCpu" => out.memory_gi_b_per_v_cpu = xml_read_memory_gi_b_per_v_cpu(c)?
      "excludedInstanceTypeSet" => out.excluded_instance_types = xml_read_excluded_instance_type_set(c)?
      "instanceGenerationSet" => out.instance_generations = xml_read_instance_generation_set(c)?
      "spotMaxPricePercentageOverLowestPrice" => out.spot_max_price_percentage_over_lowest_price = xmlv.read_int(c.text())?
      "onDemandMaxPricePercentageOverLowestPrice" => out.on_demand_max_price_percentage_over_lowest_price = xmlv.read_int(c.text())?
      "bareMetal" => out.bare_metal = BareMetal.from(c.text())
      "burstablePerformance" => out.burstable_performance = BurstablePerformance.from(c.text())
      "requireHibernateSupport" => out.require_hibernate_support = xmlv.read_bool(c.text())?
      "networkInterfaceCount" => out.network_interface_count = xml_read_network_interface_count(c)?
      "localStorage" => out.local_storage = LocalStorage.from(c.text())
      "localStorageTypeSet" => out.local_storage_types = xml_read_local_storage_type_set(c)?
      "totalLocalStorageGB" => out.total_local_storage_gb = xml_read_total_local_storage_gb(c)?
      "baselineEbsBandwidthMbps" => out.baseline_ebs_bandwidth_mbps = xml_read_baseline_ebs_bandwidth_mbps(c)?
      "acceleratorTypeSet" => out.accelerator_types = xml_read_accelerator_type_set(c)?
      "acceleratorCount" => out.accelerator_count = xml_read_accelerator_count(c)?
      "acceleratorManufacturerSet" => out.accelerator_manufacturers = xml_read_accelerator_manufacturer_set(c)?
      "acceleratorNameSet" => out.accelerator_names = xml_read_accelerator_name_set(c)?
      "acceleratorTotalMemoryMiB" => out.accelerator_total_memory_mi_b = xml_read_accelerator_total_memory_mi_b(c)?
      "networkBandwidthGbps" => out.network_bandwidth_gbps = xml_read_network_bandwidth_gbps(c)?
      "allowedInstanceTypeSet" => out.allowed_instance_types = xml_read_allowed_instance_type_set(c)?
      "maxSpotPriceAsPercentageOfOptimalOnDemandPrice" => out.max_spot_price_as_percentage_of_optimal_on_demand_price = xmlv.read_int(c.text())?
      "baselinePerformanceFactors" => out.baseline_performance_factors = xml_read_baseline_performance_factors(c)?
      "requireEncryptionInTransit" => out.require_encryption_in_transit = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}