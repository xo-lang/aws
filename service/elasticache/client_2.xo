  if let Some(x) = v.nodes_updated {
    query.add(f, query.key(prefix, "NodesUpdated"), x)
  }
  if let Some(x) = v.update_action_status_modified_date {
    query.add(f, query.key(prefix, "UpdateActionStatusModifiedDate"), rest.date_time(x))
  }
  if let Some(x) = v.sla_met {
    query.add(f, query.key(prefix, "SlaMet"), x.value())
  }
  if let Some(x) = v.node_group_update_status {
