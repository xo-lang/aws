  if let Some(x) = v.vpc_security_group_id {
    query.add(f, query.key(prefix, "VpcSecurityGroupId"), x)
  }
  if let Some(x) = v.status {
    query.add(f, query.key(prefix, "Status"), x)
  }
}

fn query_put_vpc_security_group_membership_list(var f: query.Form, prefix: Str, v: List[VpcSecurityGroupMembership], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.VpcSecurityGroupMembership.${i + 1}" }
    query_put_vpc_security_group_membership(f, k, x)
  }
}

