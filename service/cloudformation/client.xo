    query.add(f, k, x)
  }
}

fn query_put_jazz_resource_identifier_properties(var f: query.Form, prefix: Str, v: Map[Str, Str], flat: Bool) {
  // sorted keys, as aws-sdk-go-v2 writes them
  for (i, k) in v.keys().sort().indexed() {
    let e = if flat { "${prefix}.${i + 1}" } else { "${prefix}.entry.${i + 1}" }
    query.add(f, "${e}.key", k)
    if let Some(x) = v.get(k) {
      query.add(f, "${e}.value", x)
    }
  }
}

fn query_put_last_operations(var f: query.Form, prefix: Str, v: List[OperationEntry], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_operation_entry(f, k, x)
  }
}

