  /// host container instance until you delete it manually. If the source path
  /// location doesn't exist on the host container instance, the Docker daemon
  /// creates it. If the location does exist, the contents of the source path
  /// folder are exported. This parameter isn't applicable to jobs that run on
  /// Fargate resources. Don't provide this for these jobs.
  pub source_path: Str? = None
}

