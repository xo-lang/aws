pub struct CreateApplicationStatusCheckRequest {
  /// The health check paths to use for the application status check. Health
  /// check paths define the network path from a source subnet to one or more
  /// destination subnets for cross-Availability Zone or Availability Zone to
  /// Local Zone health checking. If omitted, health checks are performed in
  /// the same subnet as the instance.
  pub health_check_paths: List[HealthCheckPathRequestObject]? = None
  /// The aggregation setting for the application status check. When set to
  /// included , the result of this check contributes to the instance-level
  /// application status reported by DescribeApplicationStatus . When set to
  /// excluded , the check runs independently and does not affect the
  /// instance-level status. Valid values: included | excluded .
  pub aggregation: AggregationStatusEnum? = None
  /// The protocol to use for the health check. Valid values: http | https .
  pub protocol: NetworkProtocolEnum? = None
  /// The port to use for the health check. Valid values: 1 to 65535.
  pub port: Int? = None
  /// The URL path to use for the health check HTTP request (for example,
  /// /health or /status ).
  pub path: Str? = None
  /// The index of the network device to use for the health check. The value
  /// must be greater than or equal to 0.
  pub device_index: Int? = None
  /// The IP version to use for the health check. Valid values: ipv4 and ipv6
  /// .
  pub ip_version: IpVersionEnum? = None
  /// The IP scope to use for the health check. Valid value: private .
  pub ip_scope: IpScopeEnum? = None
  /// The interval, in seconds, between health checks. Valid value: 60.
  pub interval: Int? = None
  /// The amount of time, in seconds, to wait for a health check response
  /// before considering it failed. Valid values: 1 to 30. The value must be
  /// less than Interval .
  pub timeout: Int? = None
  /// The number of consecutive failed health checks before the application
  /// status is considered impaired. The value must be greater than 0.
  pub failure_threshold: Int? = None
  /// The number of consecutive successful health checks before the
  /// application status is considered healthy. The value must be greater than
  /// 0.
  pub success_threshold: Int? = None
  /// The HTTP status codes that indicate a successful health check response.
  /// Specify a comma-separated list of individual status codes or ranges, for
  /// example, 200,202,300-399 . For a range, the first value must be less
  /// than the second value. Maximum length: 64 characters. Default: 200 .
  pub status_code_matcher: Str? = None
  /// The number of seconds to wait before starting health checks after an
  /// instance is launched. Valid values: 1 to 600.
  pub initialization_grace_period_seconds: Int? = None
  /// The tags to apply to the application status check.
  pub tag_specifications: List[TagSpecification]? = None
  /// A unique, case-sensitive identifier that you provide to ensure that the
  /// operation completes no more than one time. If you retry a request with
  /// the same token, the service ignores the request but does not return an
  /// error. For more information, see Ensuring idempotency .
