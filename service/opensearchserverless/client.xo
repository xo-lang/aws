  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateVpcEndpointErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_vpc_endpoint_error(resp))
  }
  deserialize_update_vpc_endpoint(resp) ?? e => Err(UpdateVpcEndpointErr.Deserialize(e))
}
