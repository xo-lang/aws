/// The HTTP request of ApplyGuardrail.
pub fn serialize_apply_guardrail(ep: rest.Endpoint, input: ApplyGuardrailRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_guardrail_identifier = match input.guardrail_identifier {
    Some(v) => v
    None => return Err("input member guardrailIdentifier is required")
  }
  if label_guardrail_identifier == "" {
    return Err("input member guardrailIdentifier must not be empty")
  }
  let label_guardrail_version = match input.guardrail_version {
    Some(v) => v
    None => return Err("input member guardrailVersion is required")
  }
  if label_guardrail_version == "" {
    return Err("input member guardrailVersion must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.source {
    fs.push(("source", json.Value.Str(x.value())))
  }
  if let Some(x) = input.content {
    fs.push(("content", json_of_guardrail_content_block_list(x)))
  }
  if let Some(x) = input.output_scope {
    fs.push(("outputScope", json.Value.Str(x.value())))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/guardrail/${rest.escape(label_guardrail_identifier, false)}/version/${rest.escape(label_guardrail_version, false)}/apply"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_apply_guardrail(resp: http.Response) -> ApplyGuardrailResponse ! Str {
  var out = ApplyGuardrailResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "usage" => out.usage = from_json_guardrail_usage(fv)?
      "action" => out.action = GuardrailAction.from(jsonv.read_str(fv)?)
      "actionReason" => out.action_reason = jsonv.read_str(fv)?
      "outputs" => out.outputs = from_json_guardrail_output_content_list(fv)?
      "assessments" => out.assessments = from_json_guardrail_assessment_list(fv)?
      "guardrailCoverage" => out.guardrail_coverage = from_json_guardrail_coverage(fv)?
      _ => {}
    }
  }
  Ok(out)
}

