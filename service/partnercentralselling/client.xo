fn json_of_filter(v: Filter) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.and_all_filters {
    fs.push(("AndAllFilters", json_of_filter_list(x)))
  }
  if let Some(x) = v.or_all_filters {
    fs.push(("OrAllFilters", json_of_filter_list(x)))
  }
  if let Some(x) = v.not_filter {
    fs.push(("NotFilter", json_of_filter(x)))
  }
  if let Some(x) = v.equals_to {
    fs.push(("EqualsTo", json_of_filter_condition(x)))
  }
  if let Some(x) = v.contains_any {
    fs.push(("ContainsAny", json_of_filter_condition(x)))
  }
  if let Some(x) = v.contains_all {
    fs.push(("ContainsAll", json_of_filter_condition(x)))
  }
  if let Some(x) = v.greater_than {
    fs.push(("GreaterThan", json_of_filter_condition(x)))
  }
  if let Some(x) = v.greater_than_or_equals {
    fs.push(("GreaterThanOrEquals", json_of_filter_condition(x)))
  }
  if let Some(x) = v.less_than {
    fs.push(("LessThan", json_of_filter_condition(x)))
  }
  if let Some(x) = v.less_than_or_equals {
    fs.push(("LessThanOrEquals", json_of_filter_condition(x)))
  }
  json.Value.Object(fs)
}

fn from_json_filter(v: json.Value) -> Filter ! Str {
  var out = Filter{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
