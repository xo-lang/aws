fn json_of_session_summaries(v: List[SessionSummary]) -> json.Value {
  json.Value.List(v.map(fn(x: SessionSummary) -> json.Value { json_of_session_summary(x) }))
}

fn from_json_session_summaries(v: json.Value) -> List[SessionSummary] ! Str {
  var out: List[SessionSummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_session_summary(fv)?)
  }
  Ok(out)
}

