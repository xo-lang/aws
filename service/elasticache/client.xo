    query.add(f, query.key(prefix, "Port"), "${x}")
  }
}

fn query_put_customer_node_endpoint_list(var f: query.Form, prefix: Str, v: List[CustomerNodeEndpoint], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_customer_node_endpoint(f, k, x)
  }
}

