  /// The identifier for the distribution. For example: EDFDVBD632BHDS5 .
  pub id: Str? = None
  /// The ARN (Amazon Resource Name) for the distribution. For example:
  /// arn:aws:cloudfront::123456789012:distribution/EDFDVBD632BHDS5 , where
  /// 123456789012 is your Amazon Web Services account ID.
  pub arn: Str? = None
  /// The current version of the distribution.
  pub e_tag: Str? = None
  /// The current status of the distribution. When the status is Deployed ,
  /// the distribution's information is propagated to all CloudFront edge
  /// locations.
  pub status: Str? = None
  /// The date and time the distribution was last modified.
  pub last_modified_time: Time? = None
  /// The domain name that corresponds to the distribution, for example,
  /// d111111abcdef8.cloudfront.net .
  pub domain_name: Str? = None
  /// A complex type that contains information about CNAMEs (alternate domain
  /// names), if any, for this distribution.
  pub aliases: Aliases? = None
  /// A complex type that contains information about origins for this
  /// distribution.
  pub origins: Origins? = None
  /// A complex type that contains information about origin groups for this
  /// distribution.
  pub origin_groups: OriginGroups? = None
  /// A complex type that describes the default cache behavior if you don't
  /// specify a CacheBehavior element or if files don't match any of the
  /// values of PathPattern in CacheBehavior elements. You must create exactly
  /// one default cache behavior.
  pub default_cache_behavior: DefaultCacheBehavior? = None
  /// A complex type that contains zero or more CacheBehavior elements.
  pub cache_behaviors: CacheBehaviors? = None
  /// A complex type that contains zero or more CustomErrorResponses elements.
  pub custom_error_responses: CustomErrorResponses? = None
  /// The comment originally specified when this distribution was created.
  pub comment: Str? = None
  /// This field only supports standard distributions. You can't specify this
  /// field for multi-tenant distributions. For more information, see
  /// Unsupported features for SaaS Manager for Amazon CloudFront in the
  /// Amazon CloudFront Developer Guide . A complex type that contains
  /// information about price class for this streaming distribution.
  pub price_class: PriceClass? = None
  /// Whether the distribution is enabled to accept user requests for content.
  pub enabled: Bool? = None
  /// A complex type that determines the distribution's SSL/TLS configuration
  /// for communicating with viewers.
  pub viewer_certificate: ViewerCertificate? = None
  /// A complex type that identifies ways in which you want to restrict
  /// distribution of your content.
  pub restrictions: Restrictions? = None
  /// The Web ACL Id (if any) associated with the distribution.
  pub web_acl_id: Str? = None
  /// Specify the maximum HTTP version that you want viewers to use to
  /// communicate with CloudFront. The default value for new web distributions
  /// is http2 . Viewers that don't support HTTP/2 will automatically use an
  /// earlier version.
  pub http_version: HttpVersion? = None
  /// Whether CloudFront responds to IPv6 DNS requests with an IPv6 address
  /// for your distribution.
  pub is_ipv6_enabled: Bool? = None
  /// Amazon Web Services services in China customers must file for an
  /// Internet Content Provider (ICP) recordal if they want to serve content
  /// publicly on an alternate domain name, also known as a CNAME, that
  /// they've added to CloudFront. AliasICPRecordal provides the ICP recordal
  /// status for CNAMEs associated with distributions. For more information
  /// about ICP recordals, see Signup, Accounts, and Credentials in Getting
  /// Started with Amazon Web Services services in China .
  pub alias_icp_recordals: List[AliasICPRecordal]? = None
  /// A Boolean that indicates whether this is a staging distribution. When
  /// this value is true , this is a staging distribution. When this value is
  /// false , this is not a staging distribution.
  pub staging: Bool? = None
  /// This field specifies whether the connection mode is through a standard
  /// distribution (direct) or a multi-tenant distribution with distribution
  /// tenants (tenant-only).
  pub connection_mode: ConnectionMode? = None
  /// ID of the Anycast static IP list that is associated with the
  /// distribution.
  pub anycast_ip_list_id: Str? = None
  /// The distribution's viewer mTLS configuration.
  pub viewer_mtls_config: ViewerMtlsConfig? = None
  /// The distribution's connection function association.
  pub connection_function_association: ConnectionFunctionAssociation? = None
}

/// The distribution tenant.
pub struct DistributionTenant {
  /// The ID of the distribution tenant.
  pub id: Str? = None
  /// The ID of the multi-tenant distribution.
  pub distribution_id: Str? = None
  /// The name of the distribution tenant.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) of the distribution tenant.
  pub arn: Str? = None
  /// The domains associated with the distribution tenant.
  pub domains: List[DomainResult]? = None
  pub tags: Tags? = None
  /// Customizations for the distribution tenant. For each distribution
  /// tenant, you can specify the geographic restrictions, and the Amazon
  /// Resource Names (ARNs) for the ACM certificate and WAF web ACL. These are
  /// specific values that you can override or disable from the multi-tenant
  /// distribution that was used to create the distribution tenant.
  pub customizations: Customizations? = None
  /// A list of parameter values to add to the resource. A parameter is
  /// specified as a key-value pair. A valid parameter value must exist for
  /// any parameter that is marked as required in the multi-tenant
  /// distribution.
  pub parameters: List[Parameter]? = None
  /// The ID of the connection group for the distribution tenant. If you don't
  /// specify a connection group, CloudFront uses the default connection
  /// group.
  pub connection_group_id: Str? = None
  /// The date and time when the distribution tenant was created.
  pub created_time: Time? = None
  /// The date and time when the distribution tenant was updated.
  pub last_modified_time: Time? = None
  /// Indicates whether the distribution tenant is in an enabled state. If
  /// disabled, the distribution tenant won't serve traffic.
  pub enabled: Bool? = None
  /// The status of the distribution tenant.
  pub status: Str? = None
}

/// Filter by the associated distribution ID or connection group ID.
pub struct DistributionTenantAssociationFilter {
  /// The distribution ID to filter by. You can find distribution tenants
  /// associated with a specific distribution.
  pub distribution_id: Str? = None
  /// The ID of the connection group to filter by. You can find distribution
  /// tenants associated with a specific connection group.
  pub connection_group_id: Str? = None
}

