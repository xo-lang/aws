fn json_of_voice(v: Voice) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.gender {
    fs.push(("Gender", json.Value.Str(x.value())))
  }
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x.value())))
  }
  if let Some(x) = v.language_code {
    fs.push(("LanguageCode", json.Value.Str(x.value())))
  }
  if let Some(x) = v.language_name {
    fs.push(("LanguageName", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.origin {
    fs.push(("Origin", json.Value.Str(x.value())))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.status_reason {
    fs.push(("StatusReason", json.Value.Str(x)))
  }
  if let Some(x) = v.additional_language_codes {
    fs.push(("AdditionalLanguageCodes", json_of_language_code_list(x)))
  }
  if let Some(x) = v.supported_engines {
    fs.push(("SupportedEngines", json_of_engine_list(x)))
  }
  if let Some(x) = v.voice_creation_data {
    fs.push(("VoiceCreationData", json_of_voice_creation_data(x)))
  }
  if let Some(x) = v.customer_managed_encryption {
    fs.push(("CustomerManagedEncryption", json_of_customer_managed_encryption(x)))
  }
  if let Some(x) = v.creation_time {
    fs.push(("CreationTime", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_voice(v: json.Value) -> Voice ! Str {
  var out = Voice{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Arn" => out.arn = jsonv.read_str(fv)?
      "Gender" => out.gender = Gender.from(jsonv.read_str(fv)?)
      "Id" => out.id = VoiceId.from(jsonv.read_str(fv)?)
      "LanguageCode" => out.language_code = LanguageCode.from(jsonv.read_str(fv)?)
      "LanguageName" => out.language_name = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "Origin" => out.origin = VoiceOrigin.from(jsonv.read_str(fv)?)
      "Status" => out.status = VoiceStatus.from(jsonv.read_str(fv)?)
      "StatusReason" => out.status_reason = jsonv.read_str(fv)?
      "AdditionalLanguageCodes" => out.additional_language_codes = from_json_language_code_list(fv)?
      "SupportedEngines" => out.supported_engines = from_json_engine_list(fv)?
      "VoiceCreationData" => out.voice_creation_data = from_json_voice_creation_data(fv)?
      "CustomerManagedEncryption" => out.customer_managed_encryption = from_json_customer_managed_encryption(fv)?
      "CreationTime" => out.creation_time = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
}

