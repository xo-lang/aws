  match v {
    TemplateIdentifier(x) => json.Value.Object([("templateIdentifier", json.Value.Str(x))])
    RuleIdentifier(x) => json.Value.Object([("ruleIdentifier", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_template_or_rule_reference(v: json.Value) -> TemplateOrRuleReference ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "templateIdentifier" => Ok(TemplateOrRuleReference.TemplateIdentifier(jsonv.read_str(fv)?))
      "ruleIdentifier" => Ok(TemplateOrRuleReference.RuleIdentifier(jsonv.read_str(fv)?))
      _ => Ok(TemplateOrRuleReference.Unknown(k))
    }
  }
  Err("TemplateOrRuleReference: no member set")
}

