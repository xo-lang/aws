pub struct ModelPackageValidationSpecification {
  /// The IAM roles to be used for the validation of the model package.
  pub validation_role: Str? = None
  /// An array of ModelPackageValidationProfile objects, each of which
  /// specifies a batch transform job that SageMaker runs to validate your
  /// model package.
  pub validation_profiles: List[ModelPackageValidationProfile]? = None
}

/// Model quality statistics and constraints.
pub struct ModelQuality {
  /// Model quality statistics.
  pub statistics: MetricsSource? = None
  /// Model quality constraints.
  pub constraints: MetricsSource? = None
}

/// Container image configuration object for the monitoring job.
pub struct ModelQualityAppSpecification {
  /// The address of the container image that the monitoring job runs.
  pub image_uri: Str? = None
  /// Specifies the entrypoint for a container that the monitoring job runs.
  pub container_entrypoint: List[Str]? = None
  /// An array of arguments for the container used to run the monitoring job.
  pub container_arguments: List[Str]? = None
  /// An Amazon S3 URI to a script that is called per row prior to running
  /// analysis. It can base64 decode the payload and convert it into a
  /// flattened JSON so that the built-in container can use the converted
  /// data. Applicable only for the built-in (first party) containers.
  pub record_preprocessor_source_uri: Str? = None
  /// An Amazon S3 URI to a script that is called after analysis has been
  /// performed. Applicable only for the built-in (first party) containers.
  pub post_analytics_processor_source_uri: Str? = None
  /// The machine learning problem type of the model that the monitoring job
  /// monitors.
  pub problem_type: MonitoringProblemType? = None
  /// Sets the environment variables in the container that the monitoring job
  /// runs.
  pub environment: Map[Str, Str]? = None
}

/// Configuration for monitoring constraints and monitoring statistics.
/// These baseline resources are compared against the results of the current
/// job from the series of jobs scheduled to collect data periodically.
pub struct ModelQualityBaselineConfig {
  /// The name of the job that performs baselining for the monitoring job.
  pub baselining_job_name: Str? = None
  pub constraints_resource: MonitoringConstraintsResource? = None
}

/// The input for the model quality monitoring job. Currently endpoints are
/// supported for input for model quality monitoring jobs.
pub struct ModelQualityJobInput {
  pub endpoint_input: EndpointInput? = None
  /// Input object for the batch transform job.
  pub batch_transform_input: BatchTransformInput? = None
  /// The ground truth label provided for the model.
  pub ground_truth_s3_input: MonitoringGroundTruthS3Input? = None
}

/// Settings for the model quantization technique that's applied by a model
/// optimization job.
pub struct ModelQuantizationConfig {
  /// The URI of an LMI DLC in Amazon ECR. SageMaker uses this image to run
  /// the optimization.
  pub image: Str? = None
  /// Environment variables that override the default ones in the model
  /// container.
  pub override_environment: Map[Str, Str]? = None
}

/// The model registry settings for the SageMaker Canvas application.
pub struct ModelRegisterSettings {
  /// Describes whether the integration to the model registry is enabled or
  /// disabled in the Canvas application.
