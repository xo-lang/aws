  var out = PreconditionFailedException{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "message" => out.message = jsonv.read_str(fv)?
      "resourceId" => out.resource_id = jsonv.read_str(fv)?
