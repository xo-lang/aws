pub struct UpdateAttachmentNatConfigurationRequest {
  /// The ID of the attachment to update the NAT configuration for.
  pub attachment_id: Str? = None
  /// Specifies whether to enable or disable NAT gateway support on the
  /// attachment. When you disable NAT gateway support, the attachment keeps
  /// its NAT rules but doesn't apply them. To enable NAT gateway support, the
  /// attachment must have at least one NAT rule, either specified in this
  /// request or already configured on the attachment. If you omit this
  /// parameter, NAT gateway support is unchanged.
  pub nat_gateway_support: NatGatewaySupportValue? = None
  /// Specifies whether the core network installs system routes for the NAT
  /// CIDR blocks of the attachment's NAT rules. System routes have a route
  /// type of SYSTEM . NAT is applied to traffic whether or not this option is
  /// enabled. If you omit this parameter, the current value is unchanged.
  pub nat_system_route_support: Bool? = None
  /// The complete set of NAT rules for the attachment, up to 50 rules. The
  /// rules that you specify replace the existing rules of the attachment,
  /// matched by rule number. Existing rules that aren't included in the
  /// request are deleted. To delete all NAT rules, specify an empty list. You
  /// can delete all NAT rules only when NAT gateway support is disabled, or
  /// when you disable it in the same request. If you omit this parameter, the
  /// existing rules are unchanged.
  pub nat_gateway_rules: List[NatRuleRequest]? = None
  /// The client token associated with the request.
  pub client_token: Str? = None
}

pub struct UpdateAttachmentNatConfigurationResponse {
  /// The ID of the attachment.
  pub attachment_id: Str? = None
  /// The state of NAT gateway support on the attachment. The transitional
  /// states ENABLING and DISABLING change to ENABLED or DISABLED after the
  /// update is applied. The state is PENDING_ATTACHMENT_ACCEPTANCE when NAT
  /// gateway support is enabled on an attachment that is pending acceptance.
  pub nat_gateway_support: NatGatewaySupportState? = None
  /// Indicates whether the core network installs system routes for the NAT
  /// CIDR blocks of the attachment's NAT rules.
  pub nat_system_route_support: Bool? = None
  /// The NAT rules of the attachment, including rules that are being deleted.
  pub nat_gateway_rules: List[NatRule]? = None
}

