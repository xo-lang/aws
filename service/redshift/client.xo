  if let Some(x) = v.multi_az_secondary {
    xml_write_secondary_cluster_info(w, x, "MultiAZSecondary", [])
  }
  if let Some(x) = v.lakehouse_registration_status {
    xmlv.elem(w, "LakehouseRegistrationStatus", x, [])
