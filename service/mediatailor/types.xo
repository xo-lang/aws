  /// The configuration for a CUSTOM_OUTPUT function.
  pub custom_output_configuration: CustomOutputConfiguration? = None
  /// The configuration for a CONCURRENT_EXECUTOR function.
  pub concurrent_executor_configuration: ConcurrentExecutorConfiguration? = None
  /// The configuration for a SEQUENTIAL_EXECUTOR function.
  pub sequential_executor_configuration: SequentialExecutorConfiguration? = None
  /// The configuration for a VAST_REQUEST function.
  pub vast_request_configuration: VastRequestConfiguration? = None
  /// The tags assigned to the function. Tags are key-value pairs that you can
  /// associate with Amazon resources to help with organization, access
  /// control, and cost tracking. For more information, see Tagging AWS
  /// Elemental MediaTailor Resources .
  pub tags: Map[Str, Str]? = None
  /// The Amazon Resource Name (ARN) of the function.
  pub arn: Str? = None
}

/// A reference to a child function within a SEQUENTIAL_EXECUTOR function.
pub struct FunctionRef {
  /// An optional expression that evaluates to a boolean. MediaTailor
  /// evaluates this expression immediately before running the step, using the
  /// accumulated state at that point in the sequence. If the expression
  /// evaluates to false , MediaTailor skips the step and moves to the next
  /// one. If omitted, the step always runs.
  pub run_condition: Str? = None
  /// The identifier of the child function to execute in this step.
  pub function_id: Str? = None
  /// An optional alternate name for the function within the executor. If
  /// omitted, MediaTailor uses the function identifier.
  pub alias: Str? = None
}

/// The type of a function, which determines what the function can do at
/// runtime. For more information, see Function types and composition in the
/// MediaTailor User Guide .
pub enum FunctionType: Str {
  HttpRequest = "HTTP_REQUEST"
  AwsServiceRequest = "AWS_SERVICE_REQUEST"
  CustomOutput = "CUSTOM_OUTPUT"
  ConcurrentExecutor = "CONCURRENT_EXECUTOR"
  SequentialExecutor = "SEQUENTIAL_EXECUTOR"
  VastRequest = "VAST_REQUEST"
  Unknown(value: Str)
}

