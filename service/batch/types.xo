  /// The total number of active shares in the fairshare scheduling job queue
  /// that are currently utilizing capacity.
  pub active_share_count: Int? = None
  /// A list of the top 20 shares with the highest capacity utilization,
  /// ordered by usage amount.
  pub top_capacity_utilization: List[FairshareCapacityUtilization]? = None
}

