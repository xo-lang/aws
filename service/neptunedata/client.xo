pub fn serialize_cancel_gremlin_query(ep: rest.Endpoint, input: CancelGremlinQueryInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_query_id = match input.query_id {
    Some(v) => v
    None => return Err("input member queryId is required")
  }
  if label_query_id == "" {
    return Err("input member queryId must not be empty")
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "DELETE",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/gremlin/status/${rest.escape(label_query_id, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

