/// Describes an image.
pub struct Image {
  /// The name of the image.
  pub name: Str? = None
  /// The ARN of the image.
  pub arn: Str? = None
  /// The ARN of the image from which this image was created.
  pub base_image_arn: Str? = None
  /// The image name to display.
  pub display_name: Str? = None
  /// The image starts in the PENDING state. If image creation succeeds, the
  /// state is AVAILABLE . If image creation fails, the state is FAILED .
  pub state: ImageState? = None
  /// Indicates whether the image is public or private.
  pub visibility: VisibilityType? = None
  /// Indicates whether an image builder can be launched from this image.
  pub image_builder_supported: Bool? = None
  /// The name of the image builder that was used to create the private image.
  /// If the image is shared, copied, or updated by using Managed Image
  /// Updates, this value is null.
  pub image_builder_name: Str? = None
  /// The operating system platform of the image.
  pub platform: PlatformType? = None
  /// The description to display.
  pub description: Str? = None
  /// The reason why the last state change occurred.
  pub state_change_reason: ImageStateChangeReason? = None
  /// The applications associated with the image.
  pub applications: List[Application]? = None
  /// The time the image was created.
  pub created_time: Time? = None
  /// The release date of the public base image. For private images, this date
  /// is the release date of the base image from which the image was created.
  pub public_base_image_released_date: Time? = None
  /// The version of the WorkSpaces Applications agent to use for instances
  /// that are launched from this image.
  pub appstream_agent_version: Str? = None
  /// The permissions to provide to the destination AWS account for the
  /// specified image.
  pub image_permissions: ImagePermissions? = None
  /// Describes the errors that are returned when a new image can't be
  /// created.
  pub image_errors: List[ResourceError]? = None
  /// Indicates whether the image is using the latest WorkSpaces Applications
  /// agent version or not.
  pub latest_appstream_agent_version: LatestAppstreamAgentVersion? = None
  /// The supported instances families that determine which image a customer
  /// can use when the customer launches a fleet or image builder. The
  /// following instances families are supported: General Purpose Compute
  /// Optimized Memory Optimized Graphics G4 Graphics G5 Graphics G6
  pub supported_instance_families: List[Str]? = None
  /// Indicates whether dynamic app providers are enabled within an WorkSpaces
  /// Applications image or not.
  pub dynamic_app_providers_enabled: DynamicAppProvidersEnabled? = None
  /// Indicates whether the image is shared with another account ID.
  pub image_shared_with_others: ImageSharedWithOthers? = None
  /// Indicates whether the image includes license-included applications.
  pub managed_software_included: Bool? = None
  /// The type of the image. Images created through AMI import have type
  /// "custom", while WorkSpaces Applications provided images have type
  /// "native". Custom images support additional instance types including
  /// GeneralPurpose, MemoryOptimized, ComputeOptimized, and Accelerated
  /// instance families.
  pub image_type: ImageType? = None
  /// The software metadata associated with the image.
  pub image_software_metadata: ImageSoftwareMetadata? = None
}

