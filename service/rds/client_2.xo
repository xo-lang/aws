fn xml_read_option_group(e: xml.Element) -> OptionGroup ! Str {
  var out = OptionGroup{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "OptionGroupName" => out.option_group_name = c.text()
      "OptionGroupDescription" => out.option_group_description = c.text()
      "EngineName" => out.engine_name = c.text()
      "MajorEngineVersion" => out.major_engine_version = c.text()
      "Options" => out.options = xml_read_options_list(c)?
      "AllowsVpcAndNonVpcInstanceMemberships" => out.allows_vpc_and_non_vpc_instance_memberships = xmlv.read_bool(c.text())?
      "VpcId" => out.vpc_id = c.text()
      "OptionGroupArn" => out.option_group_arn = c.text()
      "SourceOptionGroup" => out.source_option_group = c.text()
      "SourceAccountId" => out.source_account_id = c.text()
      "CopyTimestamp" => out.copy_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SourceRegion" => out.source_region = c.text()
      _ => {}
    }
  }
  Ok(out)
}

