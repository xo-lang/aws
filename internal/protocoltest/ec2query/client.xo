  if let Some(x) = v.float_value {
    xmlv.elem(w, "floatValue", rest.float_text(x), [])
  }
  if let Some(x) = v.double_value {
    xmlv.elem(w, "DoubleDribble", rest.float_text(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_simple_scalar_xml_properties_output(e: xml.Element) -> SimpleScalarXmlPropertiesOutput ! Str {
  var out = SimpleScalarXmlPropertiesOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "stringValue" => out.string_value = c.text()
      "emptyStringValue" => out.empty_string_value = c.text()
      "trueBooleanValue" => out.true_boolean_value = xmlv.read_bool(c.text())?
      "falseBooleanValue" => out.false_boolean_value = xmlv.read_bool(c.text())?
      "byteValue" => out.byte_value = xmlv.read_int(c.text())?
      "shortValue" => out.short_value = xmlv.read_int(c.text())?
      "integerValue" => out.integer_value = xmlv.read_int(c.text())?
      "longValue" => out.long_value = xmlv.read_int(c.text())?
      "floatValue" => out.float_value = xmlv.read_float(c.text())?
      "DoubleDribble" => out.double_value = xmlv.read_float(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_struct_arg(var w: xmlv.Writer, v: StructArg, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
