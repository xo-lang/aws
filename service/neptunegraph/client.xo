fn json_of_import_options(v: ImportOptions) -> json.Value {
  match v {
    Neptune(x) => json.Value.Object([("neptune", json_of_neptune_import_options(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_import_options(v: json.Value) -> ImportOptions ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "neptune" => Ok(ImportOptions.Neptune(from_json_neptune_import_options(fv)?))
      _ => Ok(ImportOptions.Unknown(k))
    }
  }
  Err("ImportOptions: no member set")
}

