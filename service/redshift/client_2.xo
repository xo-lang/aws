fn xml_write_usage_limit(var w: xmlv.Writer, v: UsageLimit, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.usage_limit_id {
    xmlv.elem(w, "UsageLimitId", x, [])
  }
  if let Some(x) = v.cluster_identifier {
    xmlv.elem(w, "ClusterIdentifier", x, [])
  }
  if let Some(x) = v.feature_type {
    xmlv.elem(w, "FeatureType", x.value(), [])
  }
  if let Some(x) = v.limit_type {
    xmlv.elem(w, "LimitType", x.value(), [])
  }
  if let Some(x) = v.amount {
    xmlv.elem(w, "Amount", "${x}", [])
  }
  if let Some(x) = v.period {
    xmlv.elem(w, "Period", x.value(), [])
  }
  if let Some(x) = v.breach_action {
    xmlv.elem(w, "BreachAction", x.value(), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "Tags", [])
  }
  xmlv.end(w, name)
}

fn xml_read_usage_limit(e: xml.Element) -> UsageLimit ! Str {
  var out = UsageLimit{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "UsageLimitId" => out.usage_limit_id = c.text()
      "ClusterIdentifier" => out.cluster_identifier = c.text()
      "FeatureType" => out.feature_type = UsageLimitFeatureType.from(c.text())
      "LimitType" => out.limit_type = UsageLimitLimitType.from(c.text())
      "Amount" => out.amount = xmlv.read_int(c.text())?
      "Period" => out.period = UsageLimitPeriod.from(c.text())
      "BreachAction" => out.breach_action = UsageLimitBreachAction.from(c.text())
      "Tags" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

