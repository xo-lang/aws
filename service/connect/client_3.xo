    ParticipantTimerDurationInMinutes(x) => json.Value.Object([("ParticipantTimerDurationInMinutes", json.Value.Int(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_participant_timer_value(v: json.Value) -> ParticipantTimerValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "ParticipantTimerAction" => Ok(ParticipantTimerValue.ParticipantTimerAction(ParticipantTimerAction.from(jsonv.read_str(fv)?)))
      "ParticipantTimerDurationInMinutes" => Ok(ParticipantTimerValue.ParticipantTimerDurationInMinutes(jsonv.read_int(fv)?))
      _ => Ok(ParticipantTimerValue.Unknown(k))
    }
  }
  Err("ParticipantTimerValue: no member set")
}

