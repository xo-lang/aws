fn from_json_capabilities(v: json.Value) -> Capabilities ! Str {
  var out = Capabilities{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ExportToCsv" => out.export_to_csv = CapabilityState.from(jsonv.read_str(fv)?)
      "ExportToExcel" => out.export_to_excel = CapabilityState.from(jsonv.read_str(fv)?)
      "ExportToPdf" => out.export_to_pdf = CapabilityState.from(jsonv.read_str(fv)?)
      "PrintReports" => out.print_reports = CapabilityState.from(jsonv.read_str(fv)?)
      "CreateAndUpdateThemes" => out.create_and_update_themes = CapabilityState.from(jsonv.read_str(fv)?)
      "AddOrRunAnomalyDetectionForAnalyses" => out.add_or_run_anomaly_detection_for_analyses = CapabilityState.from(jsonv.read_str(fv)?)
      "ShareAnalyses" => out.share_analyses = CapabilityState.from(jsonv.read_str(fv)?)
      "CreateAndUpdateDatasets" => out.create_and_update_datasets = CapabilityState.from(jsonv.read_str(fv)?)
      "ShareDatasets" => out.share_datasets = CapabilityState.from(jsonv.read_str(fv)?)
      "SubscribeDashboardEmailReports" => out.subscribe_dashboard_email_reports = CapabilityState.from(jsonv.read_str(fv)?)
      "CreateAndUpdateDashboardEmailReports" => out.create_and_update_dashboard_email_reports = CapabilityState.from(jsonv.read_str(fv)?)
      "ShareDashboards" => out.share_dashboards = CapabilityState.from(jsonv.read_str(fv)?)
      "CreateAndUpdateThresholdAlerts" => out.create_and_update_threshold_alerts = CapabilityState.from(jsonv.read_str(fv)?)
      "RenameSharedFolders" => out.rename_shared_folders = CapabilityState.from(jsonv.read_str(fv)?)
      "CreateSharedFolders" => out.create_shared_folders = CapabilityState.from(jsonv.read_str(fv)?)
      "CreateAndUpdateDataSources" => out.create_and_update_data_sources = CapabilityState.from(jsonv.read_str(fv)?)
      "ShareDataSources" => out.share_data_sources = CapabilityState.from(jsonv.read_str(fv)?)
      "ViewAccountSPICECapacity" => out.view_account_spice_capacity = CapabilityState.from(jsonv.read_str(fv)?)
      "CreateSPICEDataset" => out.create_spice_dataset = CapabilityState.from(jsonv.read_str(fv)?)
