  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.resource_arn {
    fs.push(("ResourceArn", json.Value.Str(x)))
  }
  if let Some(x) = input.tag_keys {
    fs.push(("TagKeys", json_of_tag_key_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/UntagResource"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
