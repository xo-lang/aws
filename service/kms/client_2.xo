/// The HTTP request of VerifyMac.
pub fn serialize_verify_mac(ep: rest.Endpoint, input: VerifyMacRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.message {
    fs.push(("Message", jsonv.blob(x)))
  }
  if let Some(x) = input.key_id {
    fs.push(("KeyId", json.Value.Str(x)))
  }
  if let Some(x) = input.mac_algorithm {
    fs.push(("MacAlgorithm", json.Value.Str(x.value())))
  }
  if let Some(x) = input.mac {
    fs.push(("Mac", jsonv.blob(x)))
  }
  if let Some(x) = input.grant_tokens {
    fs.push(("GrantTokens", json_of_grant_token_list(x)))
  }
  if let Some(x) = input.dry_run {
    fs.push(("DryRun", json.Value.Bool(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.1"))
  headers.push(("X-Amz-Target", "TrentService.VerifyMac"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_verify_mac(resp: http.Response) -> VerifyMacResponse ! Str {
  var out = VerifyMacResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "KeyId" => out.key_id = jsonv.read_str(fv)?
      "MacValid" => out.mac_valid = jsonv.read_bool(fv)?
      "MacAlgorithm" => out.mac_algorithm = MacAlgorithmSpec.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
