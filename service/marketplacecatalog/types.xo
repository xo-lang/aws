/// The filter for subsidiary authorization statuses.
pub struct SubsidiaryAuthorizationStatusFilter {
  /// A list of statuses to filter by. The operation returns subsidiary
  /// authorizations with a status that matches a value in this list. Valid
  /// values are: Draft - The subsidiary authorization was created but not yet
  /// released. The subsidiary account can't see it. Active - The subsidiary
  /// account can use the subsidiary authorization to create offers for the
  /// authorized product. Restricted - The subsidiary authorization was
  /// discarded while in Draft or revoked while Active . It can't be used to
  /// create new offers. This status is final.
  pub value_list: List[SubsidiaryAuthorizationStatusString]? = None
}

pub enum SubsidiaryAuthorizationStatusString: Str {
  Draft = "Draft"
  Active = "Active"
  Restricted = "Restricted"
  Unknown(value: Str)
}

