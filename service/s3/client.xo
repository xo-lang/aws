  }
  if let Some(x) = v.expected_bucket_owner {
    xmlv.elem(w, "ExpectedBucketOwner", x, [])
  }
  if let Some(x) = v.expected_source_bucket_owner {
    xmlv.elem(w, "ExpectedSourceBucketOwner", x, [])
