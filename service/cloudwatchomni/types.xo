  /// The list of session summaries.
  pub sessions: List[SessionSummary]? = None
  /// A token to retrieve the next page of results, or null if there are no
  /// more results.
  pub next_token: Str? = None
}

pub struct ListViewsRequest {
  /// Return only views of this ownership category.
  pub type_value: ViewType? = None
  /// The maximum number of views to return per page.
  pub max_results: Int? = None
  /// A token to retrieve the next page of results.
  pub next_token: Str? = None
}

pub struct ListViewsResponse {
  /// The list of view summaries.
  pub items: List[ViewSummary]? = None
  /// A token to retrieve the next page of results, or null if there are no
  /// more results.
  pub next_token: Str? = None
}

/// One LOGS query selector block on a node. The `attributes` map's keys are
/// AND'd; each selects with `col = value`. Deliberately RAW/un-normalized
/// so the selector matches the store, not the node's merged identity.
pub struct LogMetadata {
  pub attributes: Map[Str, Str]? = None
}

/// Descriptive information about a context graph node or edge, as opposed
/// to its identity and structure. Returned only when the request sets
/// includeMetadata.
pub struct Metadata {
  /// The metrics observed on the element.
  pub metrics: List[MetricMetadata]? = None
  /// Semantic description of the node. Absent on an edge, because semantics
  /// describe a service rather than a relationship.
  pub semantics: NodeSemantics? = None
  /// LOGS query selectors: a list of blocks to OR together, each block an AND
  /// of exact store column to raw value. Present on node metadata only —
  /// edges carry trace selectors. Returned when the request sets
  /// includeMetadata.
  pub logs: List[LogMetadata]? = None
  /// TRACES query selectors, same block shape as the logs selectors. Present
  /// on both node and edge metadata. Returned when the request sets
  /// includeMetadata.
  pub traces: List[TraceMetadata]? = None
}

/// A single metric observed on a context graph node.
pub struct MetricMetadata {
  /// The metric name as emitted, such as "Duration".
  pub name: Str? = None
  /// The statistic to chart or alarm on, such as "p99" or "Sum". Free-form
  /// and frequently absent.
  pub preferred_stat: Str? = None
  /// OTel metric kind: "gauge", "sum", "histogram", "exponential_histogram",
  /// or "summary" (CloudWatch-vended metrics carry the same kinds). Absent
  /// when the producer did not report one.
  pub metric_type: Str? = None
  /// Per-metric qualifying attributes used to query this metric's telemetry.
  /// Keys are the metric store's own label names, not bare OTel attribute
  /// names: service identity arrives as "@resource.service.name" and
  /// "@resource.service.namespace", and the instrumentation scope as
  /// "@instrumentation.@name", while span-derived metrics label the service
  /// as a bare "service.name". Cloud provider, account and region are not
  /// repeated per metric — read those from the node. Values are RAW,
  /// deliberately NOT the node's normalized or merged identity, so a selector
  /// built from them matches the emitted series. A merged node can carry
  /// different values per metric, which is why these live here rather than on
  /// the node.
  pub attributes: Map[Str, Str]? = None
  /// What the metric means and the unit it is reported in.
  pub semantics: MetricSemantics? = None
}

/// The meaning and unit of a single metric.
pub struct MetricSemantics {
  /// Human-readable description of what the metric measures.
  pub description: Str? = None
  /// The unit the metric is reported in.
  pub unit: Str? = None
}

/// Configures how the alert reacts when an evaluation produces no data.
/// {@code treatAs} carries the resulting state; defaults to {@code NODATA}
/// when omitted.
pub struct NoData {
  /// The state to report when an evaluation produces no data.
  pub treat_as: AlertState? = None
}

/// A node in the context graph representing a service, resource, or remote
/// service.
pub struct Node {
  /// The unique identifier of the node within the context graph.
  pub node_id: Str? = None
  /// Whether the node is a service, a resource, or a remote service.
  pub node_type: NodeType? = None
  /// The primary display name of the node.
  pub name: Str? = None
  /// Other names this node was observed under. A node that merged across
  /// sources reports one resolved name, and the names it was merged away from
  /// appear here.
  pub alternate_names: List[Str]? = None
  /// The tags observed on the underlying resource.
  pub tags: Map[Str, Str]? = None
  /// Identity attributes promoted out of the flat attribute map onto typed
  /// members.
  pub node_properties: NodeProperties? = None
  /// The node's OpenTelemetry (OTel) attributes, as emitted by telemetry —
  /// the raw values, as opposed to the normalized `nodeProperties`. A key
  /// promoted onto a `nodeProperties` member is removed here, so no value
  /// appears twice.
  pub telemetry_attributes: Map[Str, Str]? = None
  /// The operations observed on this node, keyed by operation name. Each
  /// value lists the dimension sets that identify the metric series for that
  /// operation.
  pub operation_details: Map[Str, List[Map[Str, Str]]]? = None
  /// The kinds of telemetry signal observed on this node.
  pub signal_types: List[Signal]? = None
  /// The discovery sources that contributed this node.
  pub sources: List[Source]? = None
  /// Descriptive metadata about the node. Present only when the request sets
  /// includeMetadata.
  pub metadata: Metadata? = None
  /// When this node was first observed (UTC), at minute granularity. For a
  /// node that merged across sources, this is the earliest value any source
  /// reported.
  pub first_observed_at: Time? = None
  /// When this node was most recently observed (UTC), at minute granularity.
  /// For a node that merged across sources, this is the latest value any
  /// source reported.
  pub last_observed_at: Time? = None
  /// Outbound edges originating from this node. Each edge carries its `from`.
  pub edges: List[Edge]? = None
}

/// Coarse classification of what a node is. Orthogonal to NodeType, which
/// says whether the node is a service, a resource, or a remote service.
/// Absent on most nodes today because few producers emit the source
/// attribute.
pub enum NodeCategory: Str {
  GenAiAgent = "GEN_AI_AGENT"
  GenAiModel = "GEN_AI_MODEL"
  Database = "DATABASE"
  MessagingQueue = "MESSAGING_QUEUE"
  Compute = "COMPUTE"
  Storage = "STORAGE"
  Network = "NETWORK"
  Unknown(value: Str)
}

/// Criteria for selecting nodes in a context graph query.
pub struct NodeFilters {
  /// Match only the node with this identifier.
  pub node_id: Str? = None
  /// Match only nodes of this type.
  pub node_type: NodeType? = None
  /// Match only nodes with this name.
  pub name: Str? = None
  /// Match nodes by the tags on the underlying resource.
  pub tags: List[KeyFilter]? = None
  /// Match nodes by their OpenTelemetry (OTel) telemetry attributes.
  pub telemetry_attributes: List[KeyFilter]? = None
  /// Match nodes in any of these regions.
  pub region: List[Str]? = None
  /// Match nodes on any of these cloud providers.
  pub cloud_provider: List[Str]? = None
  /// Match nodes discovered from telemetry produced by any of these accounts.
  pub source_account_id: List[Str]? = None
  /// Match nodes in any of these logical service groupings.
  pub namespace: List[Str]? = None
  /// Match nodes of any of these categories.
  pub category: List[NodeCategory]? = None
  /// Match nodes observed in any of these deployment environments.
  pub stage: List[Str]? = None
  /// Match nodes contributed by any of these discovery sources.
  pub sources: List[Source]? = None
}

/// Node identity attributes promoted out of the flat attribute map onto
/// typed members. The first four are part of the node's merge key, so a
/// node that merged across sources reports one resolved value for each.
pub struct NodeProperties {
  /// The region the node runs in. Falls back to the region the telemetry was
  /// ingested from when the node does not report one.
  pub region: Str? = None
  /// The cloud provider hosting the node, resolved from the reported
  /// provider, platform, or vendor namespace, and defaulting to "aws".
  pub cloud_provider: Str? = None
  /// The account that produced the telemetry this node was discovered from.
  pub source_account_id: Str? = None
  /// The logical service grouping the node belongs to. This is not a metric
  /// namespace.
  pub namespace: Str? = None
  /// What kind of thing the node is, coarser than nodeType.
  pub category: NodeCategory? = None
  /// The node's deployment environment. A node may be observed in several;
  /// this is the highest-precedence one. Match any of them with
  /// NodeFilters.stage.
  pub stage: Str? = None
}

/// Semantic description of the service a context graph node represents.
pub struct NodeSemantics {
  /// What the service does.
  pub purpose: Str? = None
  /// The primary programming language the service is written in.
  pub language: Str? = None
  /// The application framework the service is built on.
  pub framework: Str? = None
  /// The kind of workload the service is.
  pub kind: Str? = None
  /// The source repository the service is built from.
  pub repository: Str? = None
}

/// Context graph node types.
pub enum NodeType: Str {
  Service = "SERVICE"
  Resource = "RESOURCE"
  RemoteService = "REMOTE_SERVICE"
  Unknown(value: Str)
}

/// Single notification rule: which transitions trigger this rule and where
/// the resulting notification should be sent.
pub struct NotificationRule {
  /// The conditions that trigger this notification rule.
  pub trigger: NotificationTrigger? = None
  /// The destination for notifications from this rule.
  pub target_value: NotificationTarget? = None
}

pub enum NotificationStatus: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// The destination for a notification.
pub struct NotificationTarget {
  /// The type of notification target.
  pub type_value: NotificationTargetType? = None
  /// The Amazon Resource Name (ARN) of the notification target. For {@code
  /// slack} and {@code pagerduty}, an integration ARN as returned by {@code
  /// ListIntegrations}.
  pub arn: Str? = None
  /// Additional target-specific metadata.
  pub metadata: Map[Str, Str]? = None
}

/// Supported notification target type.
pub enum NotificationTargetType: Str {
  Sns = "sns"
  Slack = "slack"
  Pagerduty = "pagerduty"
  Unknown(value: Str)
}

/// Trigger conditions for a notification rule. {@code stateValues} entries
/// combine with OR semantics; empty / omitted = any state.
pub struct NotificationTrigger {
  /// Alert state(s) that trigger this rule. Empty / omitted = any state.
  pub state_values: List[AlertState]? = None
}

