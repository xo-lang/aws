/// Smithy's, from `min_delay` (60s) to `max_delay` (3600s).
pub fn wait_until_graph_snapshot_deleted(c: Client, input: GetGraphSnapshotInput, max_wait: Duration, min_delay: Duration = 60s, max_delay: Duration = 3600s) -> () ! waiter.WaitErr[GetGraphSnapshotErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).get_graph_snapshot(input) {
      Ok(out) => {
        let o = jmes_of_get_graph_snapshot_output(out)
        if state == "" && waiter.path_matches(o, "status != 'DELETING'", "booleanEquals", "true") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_get_graph_snapshot(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("GraphSnapshotDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

