fn from_json_command(v: json.Value) -> Command ! Str {
  var out = Command{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "CommandId" => out.command_id = jsonv.read_str(fv)?
