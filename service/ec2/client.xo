  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.earliest_time {
    xmlv.elem(w, "EarliestTime", rest.date_time(x), [])
  }
  if let Some(x) = v.latest_time {
    xmlv.elem(w, "LatestTime", rest.date_time(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_slot_date_time_range_request(e: xml.Element) -> SlotDateTimeRangeRequest ! Str {
  var out = SlotDateTimeRangeRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "EarliestTime" => out.earliest_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "LatestTime" => out.latest_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

