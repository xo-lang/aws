fn json_of_integer_list(v: List[Int]) -> json.Value {
  json.Value.List(v.map(fn(x: Int) -> json.Value { json.Value.Int(x) }))
}

fn from_json_integer_list(v: json.Value) -> List[Int] ! Str {
  var out: List[Int] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(jsonv.read_int(fv)?)
  }
  Ok(out)
}

