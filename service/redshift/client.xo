  if let Some(x) = v.enabled_all {
    xmlv.elem(w, "EnabledAll", "${x}", [])
  }
  if let Some(x) = v.last_ingestion_times {
    xml_write_s3_table_last_ingestion_time_map(w, x, "LastIngestionTimes", [])
  }
  xmlv.end(w, name)
}

fn xml_read_s3_table_publish_status(e: xml.Element) -> S3TablePublishStatus ! Str {
