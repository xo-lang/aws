/// Updates the reward values for a trajectory and transitions it to
/// reward-received status, signaling that it is eligible for processing.
/// Call this operation after CompleteRollout to provide the computed reward
/// scores.
pub fn (c: Client) update_reward(input: UpdateRewardRequest) -> UpdateRewardResponse ! UpdateRewardErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_reward(c.params, input)) ?? e => return Err(UpdateRewardErr.InvalidInput(e))
  var req = serialize_update_reward(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateRewardErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateRewardErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_reward_error(resp))
  }
  deserialize_update_reward(resp) ?? e => Err(UpdateRewardErr.Deserialize(e))
}
