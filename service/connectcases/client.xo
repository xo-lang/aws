fn json_of_custom_fields_filter(v: CustomFieldsFilter) -> json.Value {
  match v {
    Field(x) => json.Value.Object([("field", json_of_field_filter(x))])
    Not(x) => json.Value.Object([("not", json_of_custom_fields_filter(x))])
    AndAll(x) => json.Value.Object([("andAll", json_of_custom_fields_filter_list(x))])
    OrAll(x) => json.Value.Object([("orAll", json_of_custom_fields_filter_list(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_custom_fields_filter(v: json.Value) -> CustomFieldsFilter ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "field" => Ok(CustomFieldsFilter.Field(from_json_field_filter(fv)?))
      "not" => Ok(CustomFieldsFilter.Not(from_json_custom_fields_filter(fv)?))
      "andAll" => Ok(CustomFieldsFilter.AndAll(from_json_custom_fields_filter_list(fv)?))
      "orAll" => Ok(CustomFieldsFilter.OrAll(from_json_custom_fields_filter_list(fv)?))
      _ => Ok(CustomFieldsFilter.Unknown(k))
    }
  }
  Err("CustomFieldsFilter: no member set")
}

fn json_of_custom_fields_filter_list(v: List[CustomFieldsFilter]) -> json.Value {
  json.Value.List(v.map(fn(x: CustomFieldsFilter) -> json.Value { json_of_custom_fields_filter(x) }))
}

fn from_json_custom_fields_filter_list(v: json.Value) -> List[CustomFieldsFilter] ! Str {
  var out: List[CustomFieldsFilter] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_custom_fields_filter(fv)?)
  }
  Ok(out)
}

