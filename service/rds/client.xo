  }
  if let Some(x) = v.cust_subscription_id {
    xmlv.elem(w, "CustSubscriptionId", x, [])
  }
  if let Some(x) = v.sns_topic_arn {
    xmlv.elem(w, "SnsTopicArn", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.subscription_creation_time {
    xmlv.elem(w, "SubscriptionCreationTime", x, [])
  }
  if let Some(x) = v.source_type {
    xmlv.elem(w, "SourceType", x, [])
  }
  if let Some(x) = v.source_ids_list {
    xml_write_source_ids_list(w, x, "SourceIdsList", [])
  }
  if let Some(x) = v.event_categories_list {
    xml_write_event_categories_list(w, x, "EventCategoriesList", [])
  }
  if let Some(x) = v.enabled {
    xmlv.elem(w, "Enabled", "${x}", [])
  }
  if let Some(x) = v.event_subscription_arn {
    xmlv.elem(w, "EventSubscriptionArn", x, [])
  }
  xmlv.end(w, name)
