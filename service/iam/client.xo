fn query_put_accept_delegation_request_request(var f: query.Form, prefix: Str, v: AcceptDelegationRequestRequest) {
  if let Some(x) = v.delegation_request_id {
    query.add(f, query.key(prefix, "DelegationRequestId"), x)
  }
}

fn query_put_access_detail(var f: query.Form, prefix: Str, v: AccessDetail) {
  if let Some(x) = v.service_name {
    query.add(f, query.key(prefix, "ServiceName"), x)
  }
  if let Some(x) = v.service_namespace {
    query.add(f, query.key(prefix, "ServiceNamespace"), x)
  }
  if let Some(x) = v.region {
    query.add(f, query.key(prefix, "Region"), x)
  }
  if let Some(x) = v.entity_path {
    query.add(f, query.key(prefix, "EntityPath"), x)
  }
  if let Some(x) = v.last_authenticated_time {
    query.add(f, query.key(prefix, "LastAuthenticatedTime"), rest.date_time(x))
  }
  if let Some(x) = v.total_authenticated_entities {
    query.add(f, query.key(prefix, "TotalAuthenticatedEntities"), "${x}")
  }
}

fn query_put_access_details(var f: query.Form, prefix: Str, v: List[AccessDetail], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_access_detail(f, k, x)
  }
}

fn query_put_access_key(var f: query.Form, prefix: Str, v: AccessKey) {
  if let Some(x) = v.user_name {
    query.add(f, query.key(prefix, "UserName"), x)
  }
  if let Some(x) = v.access_key_id {
    query.add(f, query.key(prefix, "AccessKeyId"), x)
  }
  if let Some(x) = v.status {
    query.add(f, query.key(prefix, "Status"), x.value())
  }
  if let Some(x) = v.secret_access_key {
    query.add(f, query.key(prefix, "SecretAccessKey"), x)
  }
  if let Some(x) = v.create_date {
    query.add(f, query.key(prefix, "CreateDate"), rest.date_time(x))
  }
}

fn query_put_access_key_last_used(var f: query.Form, prefix: Str, v: AccessKeyLastUsed) {
  if let Some(x) = v.last_used_date {
    query.add(f, query.key(prefix, "LastUsedDate"), rest.date_time(x))
  }
  if let Some(x) = v.service_name {
    query.add(f, query.key(prefix, "ServiceName"), x)
  }
  if let Some(x) = v.region {
    query.add(f, query.key(prefix, "Region"), x)
  }
}

fn query_put_access_key_metadata(var f: query.Form, prefix: Str, v: AccessKeyMetadata) {
  if let Some(x) = v.user_name {
    query.add(f, query.key(prefix, "UserName"), x)
  }
  if let Some(x) = v.access_key_id {
    query.add(f, query.key(prefix, "AccessKeyId"), x)
  }
  if let Some(x) = v.status {
    query.add(f, query.key(prefix, "Status"), x.value())
  }
  if let Some(x) = v.create_date {
    query.add(f, query.key(prefix, "CreateDate"), rest.date_time(x))
  }
}

fn query_put_account_not_management_or_delegated_administrator_exception(var f: query.Form, prefix: Str, v: AccountNotManagementOrDelegatedAdministratorException) {
  if let Some(x) = v.message {
    query.add(f, query.key(prefix, "Message"), x)
  }
}

fn query_put_acquire_role_request(var f: query.Form, prefix: Str, v: AcquireRoleRequest) {
  if let Some(x) = v.template_arn {
    query.add(f, query.key(prefix, "TemplateArn"), x)
  }
  if let Some(x) = v.template_minor_version {
    query.add(f, query.key(prefix, "TemplateMinorVersion"), "${x}")
  }
  if let Some(x) = v.replacement_values {
    query_put_map_string_replacement_value_entry(f, query.key(prefix, "ReplacementValues"), x, false)
  }
}

fn query_put_acquire_role_response(var f: query.Form, prefix: Str, v: AcquireRoleResponse) {
  if let Some(x) = v.role {
    query_put_role(f, query.key(prefix, "Role"), x)
  }
}

fn query_put_action_name_list_type(var f: query.Form, prefix: Str, v: List[Str], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query.add(f, k, x)
  }
}

fn query_put_add_client_id_to_open_id_connect_provider_request(var f: query.Form, prefix: Str, v: AddClientIDToOpenIDConnectProviderRequest) {
  if let Some(x) = v.open_id_connect_provider_arn {
    query.add(f, query.key(prefix, "OpenIDConnectProviderArn"), x)
  }
  if let Some(x) = v.client_id {
    query.add(f, query.key(prefix, "ClientID"), x)
  }
}

fn query_put_add_role_to_instance_profile_request(var f: query.Form, prefix: Str, v: AddRoleToInstanceProfileRequest) {
  if let Some(x) = v.instance_profile_name {
    query.add(f, query.key(prefix, "InstanceProfileName"), x)
  }
  if let Some(x) = v.role_name {
    query.add(f, query.key(prefix, "RoleName"), x)
  }
}

fn query_put_add_user_to_group_request(var f: query.Form, prefix: Str, v: AddUserToGroupRequest) {
  if let Some(x) = v.group_name {
    query.add(f, query.key(prefix, "GroupName"), x)
  }
  if let Some(x) = v.user_name {
