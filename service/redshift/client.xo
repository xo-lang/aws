    xmlv.elem(w, "AllowVersionUpgrade", "${x}", [])
  }
  if let Some(x) = v.number_of_nodes {
    xmlv.elem(w, "NumberOfNodes", "${x}", [])
  }
  if let Some(x) = v.publicly_accessible {
    xmlv.elem(w, "PubliclyAccessible", "${x}", [])
  }
  if let Some(x) = v.encrypted {
    xmlv.elem(w, "Encrypted", "${x}", [])
  }
  if let Some(x) = v.restore_status {
    xml_write_restore_status(w, x, "RestoreStatus", [])
  }
  if let Some(x) = v.data_transfer_progress {
    xml_write_data_transfer_progress(w, x, "DataTransferProgress", [])
  }
  if let Some(x) = v.hsm_status {
    xml_write_hsm_status(w, x, "HsmStatus", [])
  }
  if let Some(x) = v.cluster_snapshot_copy_status {
    xml_write_cluster_snapshot_copy_status(w, x, "ClusterSnapshotCopyStatus", [])
  }
  if let Some(x) = v.cluster_public_key {
    xmlv.elem(w, "ClusterPublicKey", x, [])
  }
  if let Some(x) = v.cluster_nodes {
    xml_write_cluster_nodes_list(w, x, "ClusterNodes", [])
  }
  if let Some(x) = v.elastic_ip_status {
    xml_write_elastic_ip_status(w, x, "ElasticIpStatus", [])
  }
  if let Some(x) = v.cluster_revision_number {
    xmlv.elem(w, "ClusterRevisionNumber", x, [])
  }
  if let Some(x) = v.tags {
