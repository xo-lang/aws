fn json_of_web_acl(v: WebACL) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("ARN", json.Value.Str(x)))
  }
  if let Some(x) = v.default_action {
    fs.push(("DefaultAction", json_of_default_action(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.rules {
    fs.push(("Rules", json_of_rules(x)))
  }
  if let Some(x) = v.visibility_config {
    fs.push(("VisibilityConfig", json_of_visibility_config(x)))
  }
  if let Some(x) = v.data_protection_config {
    fs.push(("DataProtectionConfig", json_of_data_protection_config(x)))
  }
  if let Some(x) = v.capacity {
    fs.push(("Capacity", json.Value.Int(x)))
  }
  if let Some(x) = v.pre_process_firewall_manager_rule_groups {
    fs.push(("PreProcessFirewallManagerRuleGroups", json_of_firewall_manager_rule_groups(x)))
  }
  if let Some(x) = v.post_process_firewall_manager_rule_groups {
    fs.push(("PostProcessFirewallManagerRuleGroups", json_of_firewall_manager_rule_groups(x)))
  }
  if let Some(x) = v.managed_by_firewall_manager {
    fs.push(("ManagedByFirewallManager", json.Value.Bool(x)))
  }
  if let Some(x) = v.label_namespace {
    fs.push(("LabelNamespace", json.Value.Str(x)))
  }
  if let Some(x) = v.custom_response_bodies {
    fs.push(("CustomResponseBodies", json_of_custom_response_bodies(x)))
  }
  if let Some(x) = v.captcha_config {
    fs.push(("CaptchaConfig", json_of_captcha_config(x)))
  }
  if let Some(x) = v.challenge_config {
    fs.push(("ChallengeConfig", json_of_challenge_config(x)))
  }
  if let Some(x) = v.token_domains {
    fs.push(("TokenDomains", json_of_token_domains(x)))
  }
  if let Some(x) = v.association_config {
    fs.push(("AssociationConfig", json_of_association_config(x)))
  }
  if let Some(x) = v.retrofitted_by_firewall_manager {
    fs.push(("RetrofittedByFirewallManager", json.Value.Bool(x)))
  }
  if let Some(x) = v.on_source_d_do_s_protection_config {
    fs.push(("OnSourceDDoSProtectionConfig", json_of_on_source_d_do_s_protection_config(x)))
  }
  if let Some(x) = v.application_config {
    fs.push(("ApplicationConfig", json_of_application_config(x)))
  }
  if let Some(x) = v.monetization_config {
    fs.push(("MonetizationConfig", json_of_monetization_config(x)))
  }
  json.Value.Object(fs)
}

fn from_json_web_acl(v: json.Value) -> WebACL ! Str {
  var out = WebACL{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Name" => out.name = jsonv.read_str(fv)?
      "Id" => out.id = jsonv.read_str(fv)?
      "ARN" => out.arn = jsonv.read_str(fv)?
      "DefaultAction" => out.default_action = from_json_default_action(fv)?
      "Description" => out.description = jsonv.read_str(fv)?
      "Rules" => out.rules = from_json_rules(fv)?
      "VisibilityConfig" => out.visibility_config = from_json_visibility_config(fv)?
      "DataProtectionConfig" => out.data_protection_config = from_json_data_protection_config(fv)?
      "Capacity" => out.capacity = jsonv.read_int(fv)?
      "PreProcessFirewallManagerRuleGroups" => out.pre_process_firewall_manager_rule_groups = from_json_firewall_manager_rule_groups(fv)?
      "PostProcessFirewallManagerRuleGroups" => out.post_process_firewall_manager_rule_groups = from_json_firewall_manager_rule_groups(fv)?
      "ManagedByFirewallManager" => out.managed_by_firewall_manager = jsonv.read_bool(fv)?
      "LabelNamespace" => out.label_namespace = jsonv.read_str(fv)?
      "CustomResponseBodies" => out.custom_response_bodies = from_json_custom_response_bodies(fv)?
      "CaptchaConfig" => out.captcha_config = from_json_captcha_config(fv)?
      "ChallengeConfig" => out.challenge_config = from_json_challenge_config(fv)?
      "TokenDomains" => out.token_domains = from_json_token_domains(fv)?
      "AssociationConfig" => out.association_config = from_json_association_config(fv)?
      "RetrofittedByFirewallManager" => out.retrofitted_by_firewall_manager = jsonv.read_bool(fv)?
      "OnSourceDDoSProtectionConfig" => out.on_source_d_do_s_protection_config = from_json_on_source_d_do_s_protection_config(fv)?
      "ApplicationConfig" => out.application_config = from_json_application_config(fv)?
      "MonetizationConfig" => out.monetization_config = from_json_monetization_config(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_web_acl_summaries(v: List[WebACLSummary]) -> json.Value {
  json.Value.List(v.map(fn(x: WebACLSummary) -> json.Value { json_of_web_acl_summary(x) }))
}

fn from_json_web_acl_summaries(v: json.Value) -> List[WebACLSummary] ! Str {
  var out: List[WebACLSummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_web_acl_summary(fv)?)
  }
  Ok(out)
}

