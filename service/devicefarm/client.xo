  }
  if let Some(x) = v.model {
    fs.push(("model", json.Value.Str(x)))
  }
  if let Some(x) = v.model_id {
    fs.push(("modelId", json.Value.Str(x)))
  }
  if let Some(x) = v.form_factor {
    fs.push(("formFactor", json.Value.Str(x.value())))
  }
  if let Some(x) = v.platform {
    fs.push(("platform", json.Value.Str(x.value())))
  }
  if let Some(x) = v.os {
    fs.push(("os", json.Value.Str(x)))
  }
  if let Some(x) = v.cpu {
    fs.push(("cpu", json_of_cpu(x)))
  }
  if let Some(x) = v.resolution {
    fs.push(("resolution", json_of_resolution(x)))
  }
  if let Some(x) = v.heap_size {
    fs.push(("heapSize", json.Value.Int(x)))
  }
  if let Some(x) = v.memory {
    fs.push(("memory", json.Value.Int(x)))
  }
  if let Some(x) = v.image {
    fs.push(("image", json.Value.Str(x)))
  }
  if let Some(x) = v.carrier {
    fs.push(("carrier", json.Value.Str(x)))
  }
  if let Some(x) = v.radio {
    fs.push(("radio", json.Value.Str(x)))
  }
  if let Some(x) = v.remote_access_enabled {
    fs.push(("remoteAccessEnabled", json.Value.Bool(x)))
  }
  if let Some(x) = v.remote_debug_enabled {
    fs.push(("remoteDebugEnabled", json.Value.Bool(x)))
  }
  if let Some(x) = v.fleet_type {
    fs.push(("fleetType", json.Value.Str(x)))
  }
  if let Some(x) = v.fleet_name {
    fs.push(("fleetName", json.Value.Str(x)))
  }
  if let Some(x) = v.instances {
    fs.push(("instances", json_of_device_instances(x)))
  }
  if let Some(x) = v.availability {
    fs.push(("availability", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
