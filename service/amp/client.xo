fn json_of_source(v: Source) -> json.Value {
  match v {
    EksConfiguration(x) => json.Value.Object([("eksConfiguration", json_of_eks_configuration(x))])
    VpcConfiguration(x) => json.Value.Object([("vpcConfiguration", json_of_vpc_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_source(v: json.Value) -> Source ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "eksConfiguration" => Ok(Source.EksConfiguration(from_json_eks_configuration(fv)?))
      "vpcConfiguration" => Ok(Source.VpcConfiguration(from_json_vpc_configuration(fv)?))
      _ => Ok(Source.Unknown(k))
    }
  }
  Err("Source: no member set")
}

