fn xml_read_ipam_address_history_record(e: xml.Element) -> IpamAddressHistoryRecord ! Str {
  var out = IpamAddressHistoryRecord{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "resourceOwnerId" => out.resource_owner_id = c.text()
      "resourceRegion" => out.resource_region = c.text()
      "resourceType" => out.resource_type = IpamAddressHistoryResourceType.from(c.text())
      "resourceId" => out.resource_id = c.text()
      "resourceCidr" => out.resource_cidr = c.text()
      "resourceName" => out.resource_name = c.text()
      "resourceComplianceStatus" => out.resource_compliance_status = IpamComplianceStatus.from(c.text())
      "resourceOverlapStatus" => out.resource_overlap_status = IpamOverlapStatus.from(c.text())
      "vpcId" => out.vpc_id = c.text()
      "sampledStartTime" => out.sampled_start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "sampledEndTime" => out.sampled_end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

