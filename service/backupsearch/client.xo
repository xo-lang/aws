fn json_of_result_item(v: ResultItem) -> json.Value {
  match v {
    S3ResultItem(x) => json.Value.Object([("S3ResultItem", json_of_s3_result_item(x))])
    EbsResultItem(x) => json.Value.Object([("EBSResultItem", json_of_ebs_result_item(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_result_item(v: json.Value) -> ResultItem ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "S3ResultItem" => Ok(ResultItem.S3ResultItem(from_json_s3_result_item(fv)?))
      "EBSResultItem" => Ok(ResultItem.EbsResultItem(from_json_ebs_result_item(fv)?))
      _ => Ok(ResultItem.Unknown(k))
    }
  }
  Err("ResultItem: no member set")
}

