/// Updates trail settings that control what events you are logging, and how
/// to handle log files. Changes to a trail do not require stopping the
/// CloudTrail service. Use this action to designate an existing bucket for
/// log delivery. If the existing bucket has previously been a target for
/// CloudTrail log files, an IAM policy exists for the bucket. UpdateTrail
/// must be called from the Region in which the trail was created;
/// otherwise, an InvalidHomeRegionException is thrown.
pub fn (c: Client) update_trail(input: UpdateTrailRequest) -> UpdateTrailResponse ! UpdateTrailErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_trail(c.params, input)) ?? e => return Err(UpdateTrailErr.InvalidInput(e))
  var req = serialize_update_trail(ep, input, "") ?? e => return Err(UpdateTrailErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateTrailErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_trail_error(resp))
  }
  deserialize_update_trail(resp) ?? e => Err(UpdateTrailErr.Deserialize(e))
}
