pub fn wait_until_streaming_distribution_deployed(c: Client, input: GetStreamingDistributionRequest, max_wait: Duration, min_delay: Duration = 60s, max_delay: Duration = 1500s) -> () ! waiter.WaitErr[GetStreamingDistributionErr] uses (net.dial, clock, rand) {
