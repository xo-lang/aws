fn jmes_of_destination_endpoint(v: DestinationEndpoint) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.region_name {
    fs.push(("RegionName", json.Value.Str(x)))
  }
  if let Some(x) = v.availability_zone {
    fs.push(("AvailabilityZone", json.Value.Str(x)))
  }
  if let Some(x) = v.availability_zone_id {
    fs.push(("AvailabilityZoneId", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("UpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.lifecycle_management {
    fs.push(("LifecycleManagement", json.Value.Str(x.value())))
  }
  if let Some(x) = v.messages {
    fs.push(("Messages", jmes_of_destination_endpoint_message_list(x)))
  }
  if let Some(x) = v.destination_type {
    fs.push(("DestinationType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.configuration {
    fs.push(("Configuration", jmes_of_destination_endpoint_configuration(x)))
  }
  if let Some(x) = v.resource_share_ownership {
    fs.push(("ResourceShareOwnership", json.Value.Str(x.value())))
  }
  if let Some(x) = v.resource_share_details {
    fs.push(("ResourceShareDetails", jmes_of_resource_share_details(x)))
  }
  if let Some(x) = v.registration_state {
    fs.push(("RegistrationState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.connection_details {
    fs.push(("ConnectionDetails", jmes_of_destination_endpoint_connection_details(x)))
  }
  if let Some(x) = v.connection_state {
    fs.push(("ConnectionState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.connected_source {
    fs.push(("ConnectedSource", json.Value.Str(x)))
  }
  if let Some(x) = v.decryption_type {
    fs.push(("DecryptionType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.decryption_configuration {
    fs.push(("DecryptionConfiguration", jmes_of_endpoint_encryption_configuration(x)))
  }
  if let Some(x) = v.associated_resource_details {
    fs.push(("AssociatedResourceDetails", jmes_of_destination_endpoint_associated_resource_details(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", jmes_of_map_of_string(x)))
  }
  json.Value.Object(fs)
}

