/// The structure of a VPC connection.
pub struct VPCConnection {
  /// The ID of the VPC connection that you're creating. This ID is a unique
  /// identifier for each Amazon Web Services Region in an Amazon Web Services
  /// account.
  pub vpc_connection_id: Str? = None
  /// The Amazon Resource Name (ARN) of the VPC connection.
  pub arn: Str? = None
  /// The display name for the VPC connection.
  pub name: Str? = None
  /// The Amazon EC2 VPC ID associated with the VPC connection.
  pub vpc_id: Str? = None
  /// The Amazon EC2 security group IDs associated with the VPC connection.
  pub security_group_ids: List[Str]? = None
  /// A list of IP addresses of DNS resolver endpoints for the VPC connection.
  pub dns_resolvers: List[Str]? = None
  /// The status of the VPC connection.
  pub status: VPCConnectionResourceStatus? = None
  /// The availability status of the VPC connection.
  pub availability_status: VPCConnectionAvailabilityStatus? = None
  /// A list of network interfaces.
  pub network_interfaces: List[NetworkInterface]? = None
  /// The ARN of the IAM role associated with the VPC connection.
  pub role_arn: Str? = None
  /// The time that the VPC connection was created.
  pub created_time: Time? = None
  /// The time that the VPC connection was last updated.
  pub last_updated_time: Time? = None
}

pub enum VPCConnectionAvailabilityStatus: Str {
