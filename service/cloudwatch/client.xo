  }
  if let Some(x) = v.dimensions {
    xml_write_dimension_filters(w, x, "Dimensions", [])
  }
  if let Some(x) = v.next_token {
    xmlv.elem(w, "NextToken", x, [])
  }
  if let Some(x) = v.recently_active {
    xmlv.elem(w, "RecentlyActive", x.value(), [])
  }
  if let Some(x) = v.include_linked_accounts {
    xmlv.elem(w, "IncludeLinkedAccounts", "${x}", [])
  }
  if let Some(x) = v.owning_account {
    xmlv.elem(w, "OwningAccount", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_list_metrics_input(e: xml.Element) -> ListMetricsInput ! Str {
  var out = ListMetricsInput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Namespace" => out.namespace = c.text()
      "MetricName" => out.metric_name = c.text()
      "Dimensions" => out.dimensions = xml_read_dimension_filters(c)?
      "NextToken" => out.next_token = c.text()
      "RecentlyActive" => out.recently_active = RecentlyActive.from(c.text())
      "IncludeLinkedAccounts" => out.include_linked_accounts = xmlv.read_bool(c.text())?
      "OwningAccount" => out.owning_account = c.text()
      _ => {}
    }
  }
  Ok(out)
}

