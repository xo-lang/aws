fn xml_write_secondary_interface(var w: xmlv.Writer, v: SecondaryInterface, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.availability_zone_id {
    xmlv.elem(w, "availabilityZoneId", x, [])
  }
  if let Some(x) = v.attachment {
    xml_write_secondary_interface_attachment(w, x, "attachment", [])
  }
  if let Some(x) = v.mac_address {
    xmlv.elem(w, "macAddress", x, [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.private_ipv4_addresses {
    xml_write_secondary_interface_ipv4_address_list(w, x, "privateIpv4AddressSet", [])
  }
  if let Some(x) = v.secondary_interface_id {
    xmlv.elem(w, "secondaryInterfaceId", x, [])
  }
  if let Some(x) = v.secondary_interface_arn {
    xmlv.elem(w, "secondaryInterfaceArn", x, [])
  }
  if let Some(x) = v.secondary_interface_type {
    xmlv.elem(w, "secondaryInterfaceType", x.value(), [])
  }
  if let Some(x) = v.secondary_subnet_id {
    xmlv.elem(w, "secondarySubnetId", x, [])
  }
  if let Some(x) = v.secondary_network_id {
    xmlv.elem(w, "secondaryNetworkId", x, [])
  }
  if let Some(x) = v.secondary_network_type {
    xmlv.elem(w, "secondaryNetworkType", x.value(), [])
  }
  if let Some(x) = v.source_dest_check {
    xmlv.elem(w, "sourceDestCheck", "${x}", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_secondary_interface(e: xml.Element) -> SecondaryInterface ! Str {
  var out = SecondaryInterface{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "availabilityZone" => out.availability_zone = c.text()
      "availabilityZoneId" => out.availability_zone_id = c.text()
      "attachment" => out.attachment = xml_read_secondary_interface_attachment(c)?
      "macAddress" => out.mac_address = c.text()
      "ownerId" => out.owner_id = c.text()
      "privateIpv4AddressSet" => out.private_ipv4_addresses = xml_read_secondary_interface_ipv4_address_list(c)?
      "secondaryInterfaceId" => out.secondary_interface_id = c.text()
      "secondaryInterfaceArn" => out.secondary_interface_arn = c.text()
      "secondaryInterfaceType" => out.secondary_interface_type = SecondaryInterfaceType.from(c.text())
      "secondarySubnetId" => out.secondary_subnet_id = c.text()
      "secondaryNetworkId" => out.secondary_network_id = c.text()
      "secondaryNetworkType" => out.secondary_network_type = SecondaryNetworkType.from(c.text())
      "sourceDestCheck" => out.source_dest_check = xmlv.read_bool(c.text())?
      "status" => out.status = SecondaryInterfaceStatus.from(c.text())
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_secondary_interface_attachment(var w: xmlv.Writer, v: SecondaryInterfaceAttachment, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.attachment_id {
    xmlv.elem(w, "attachmentId", x, [])
  }
  if let Some(x) = v.attach_time {
    xmlv.elem(w, "attachTime", rest.date_time(x), [])
  }
  if let Some(x) = v.delete_on_termination {
    xmlv.elem(w, "deleteOnTermination", "${x}", [])
  }
  if let Some(x) = v.device_index {
    xmlv.elem(w, "deviceIndex", "${x}", [])
  }
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.instance_owner_id {
    xmlv.elem(w, "instanceOwnerId", x, [])
  }
  if let Some(x) = v.network_card_index {
    xmlv.elem(w, "networkCardIndex", "${x}", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_secondary_interface_attachment(e: xml.Element) -> SecondaryInterfaceAttachment ! Str {
  var out = SecondaryInterfaceAttachment{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "attachmentId" => out.attachment_id = c.text()
      "attachTime" => out.attach_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "deleteOnTermination" => out.delete_on_termination = xmlv.read_bool(c.text())?
      "deviceIndex" => out.device_index = xmlv.read_int(c.text())?
      "instanceId" => out.instance_id = c.text()
      "instanceOwnerId" => out.instance_owner_id = c.text()
      "networkCardIndex" => out.network_card_index = xmlv.read_int(c.text())?
      "status" => out.status = AttachmentStatus.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

