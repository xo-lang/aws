pub struct SrtListenerDecryption {
  /// The algorithm used to decrypt content.
  pub algorithm: Algorithm? = None
  /// The ARN for the secret in Secrets Manager that holds the passphrase for
  /// decryption.
  pub passphrase_secret_arn: Str? = None
}

/// Decryption settings. If specified, both algorithm and
/// passphraseSecretArn are required.
pub struct SrtListenerDecryptionRequest {
  /// Required. The decryption algorithm.
  pub algorithm: Algorithm? = None
  /// Required. The ARN for the secret in Secrets Manager that holds the
  /// passphrase.
  pub passphrase_secret_arn: Str? = None
}

/// Settings for SRT Listener input.
pub struct SrtListenerSettings {
  pub decryption: SrtListenerDecryption? = None
  /// The preferred latency (in milliseconds) for implementing packet loss and
  /// recovery. Range 120-15000.
  pub minimum_latency: Int? = None
  /// The stream ID, if the upstream system uses this identifier.
  pub stream_id: Str? = None
}

/// Configuration for SRT Listener input. Encryption is REQUIRED for all SRT
/// Listener inputs for security reasons. You must provide decryption
/// settings including algorithm and passphrase secret ARN.
pub struct SrtListenerSettingsRequest {
  pub decryption: SrtListenerDecryptionRequest? = None
  /// Required. The preferred latency in milliseconds for packet loss and
  /// recovery. Range 120-15000.
  pub minimum_latency: Int? = None
  /// Optional. The stream ID if the upstream system uses this identifier.
  pub stream_id: Str? = None
}

/// Placeholder documentation for SrtOutputDestinationSettings
pub struct SrtOutputDestinationSettings {
  /// Arn used to extract the password from Secrets Manager
  pub encryption_passphrase_secret_arn: Str? = None
  /// Stream id for SRT destinations (URLs of type srt://)
  pub stream_id: Str? = None
  /// A URL specifying a destination
  pub url: Str? = None
  /// Specifies the mode the output should use for connection establishment.
  /// CALLER mode requires URL, LISTENER mode requires port.
  pub connection_mode: ConnectionMode? = None
  /// Port number for listener mode connections (required when connectionMode
  /// is LISTENER, must not be provided when connectionMode is CALLER).
  pub listener_port: Int? = None
}

/// Srt Output Settings
pub struct SrtOutputSettings {
  /// SRT output buffering in milliseconds. A higher value increases latency
  /// through the encoder. But the benefits are that it helps to maintain a
  /// constant, low-jitter SRT output, and it accommodates clock recovery,
  /// input switching, input disruptions, picture reordering, and so on.
  /// Range: 0-10000 milliseconds.
  pub buffer_msec: Int? = None
  pub container_settings: UdpContainerSettings? = None
  pub destination: OutputLocationRef? = None
  /// The encryption level for the content. Valid values are AES128, AES192,
  /// AES256. You and the downstream system should plan how to set this field
  /// because the values must not conflict with each other.
  pub encryption_type: SrtEncryptionType? = None
  /// The latency value, in milliseconds, that is proposed during the SRT
  /// connection handshake. SRT will choose the maximum of the values proposed
  /// by the sender and receiver. On the sender side, latency is the amount of
  /// time a packet is held to give it a chance to be delivered successfully.
  /// On the receiver side, latency is the amount of time the packet is held
  /// before delivering to the application, aiding in packet recovery and
  /// matching as closely as possible the packet timing of the sender. Range:
  /// 40-16000 milliseconds.
  pub latency: Int? = None
}

