fn json_of_grader_config(v: GraderConfig) -> json.Value {
  match v {
    LambdaGrader(x) => json.Value.Object([("lambdaGrader", json_of_lambda_grader_config(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_grader_config(v: json.Value) -> GraderConfig ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "lambdaGrader" => Ok(GraderConfig.LambdaGrader(from_json_lambda_grader_config(fv)?))
      _ => Ok(GraderConfig.Unknown(k))
    }
  }
  Err("GraderConfig: no member set")
}

