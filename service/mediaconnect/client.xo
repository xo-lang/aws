    }
    return match k {
      "rist" => Ok(FailoverRouterInputProtocolConfiguration.Rist(from_json_rist_router_input_configuration(fv)?))
      "srtListener" => Ok(FailoverRouterInputProtocolConfiguration.SrtListener(from_json_srt_listener_router_input_configuration(fv)?))
      "srtCaller" => Ok(FailoverRouterInputProtocolConfiguration.SrtCaller(from_json_srt_caller_router_input_configuration(fv)?))
      "rtp" => Ok(FailoverRouterInputProtocolConfiguration.Rtp(from_json_rtp_router_input_configuration(fv)?))
      _ => Ok(FailoverRouterInputProtocolConfiguration.Unknown(k))
    }
  }
  Err("FailoverRouterInputProtocolConfiguration: no member set")
}

fn json_of_failover_router_input_protocol_configuration_list(v: List[FailoverRouterInputProtocolConfiguration]) -> json.Value {
  json.Value.List(v.map(fn(x: FailoverRouterInputProtocolConfiguration) -> json.Value { json_of_failover_router_input_protocol_configuration(x) }))
}

fn from_json_failover_router_input_protocol_configuration_list(v: json.Value) -> List[FailoverRouterInputProtocolConfiguration] ! Str {
  var out: List[FailoverRouterInputProtocolConfiguration] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_failover_router_input_protocol_configuration(fv)?)
  }
  Ok(out)
}

