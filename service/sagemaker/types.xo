  /// The ID of the Amazon Machine Image (AMI) currently in use by the
  /// instance group.
  pub current_image_id: Str? = None
  /// The ID of the Amazon Machine Image (AMI) desired for the instance group.
  pub desired_image_id: Str? = None
  /// The version of the HyperPod-managed AMI currently running on the
  /// instance group.
  pub current_image_release_version: Str? = None
  /// The desired version of the HyperPod-managed AMI for the instance group.
  /// This may differ from the current version when an update is pending.
  pub desired_image_release_version: Str? = None
  /// The status of the image version for the instance group. Indicates
