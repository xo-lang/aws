      Err(msg) => return UpdateResponderGatewayErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateResponderGatewayErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateResponderGatewayErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateResponderGatewayErr.ThrottlingException(x)
      Err(msg) => return UpdateResponderGatewayErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateResponderGatewayErr.ValidationException(x)
      Err(msg) => return UpdateResponderGatewayErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateResponderGatewayErr.Api(restjson.api_error(resp, body))
}

/// Updates the description, Auto Scaling group managed endpoint
/// configuration, trust store configuration, and client routing policy of a
/// responder gateway. This operation also updates the protocols list in the
/// listener configuration. You cannot change the domainName , port , and
/// protocol values that you set when you create a responder gateway. To
/// change any of them, delete the gateway and create a new one.
pub fn (c: Client) update_responder_gateway(input: UpdateResponderGatewayRequest) -> UpdateResponderGatewayResponse ! UpdateResponderGatewayErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_responder_gateway(c.params, input)) ?? e => return Err(UpdateResponderGatewayErr.InvalidInput(e))
  var req = serialize_update_responder_gateway(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateResponderGatewayErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateResponderGatewayErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_responder_gateway_error(resp))
  }
  deserialize_update_responder_gateway(resp) ?? e => Err(UpdateResponderGatewayErr.Deserialize(e))
}
