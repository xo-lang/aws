fn xml_write_modify_account_vpc_encryption_control_request(var w: xmlv.Writer, v: ModifyAccountVpcEncryptionControlRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.dry_run {
    xmlv.elem(w, "DryRun", "${x}", [])
