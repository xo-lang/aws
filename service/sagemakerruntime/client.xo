/// authenticated by using Amazon Web Services Signature Version 4. For
/// information, see Authenticating Requests (Amazon Web Services Signature
/// Version 4) in the Amazon S3 API Reference .
pub fn (c: Client) invoke_endpoint_with_response_stream(input: InvokeEndpointWithResponseStreamInput) -> InvokeEndpointWithResponseStreamEvents ! InvokeEndpointWithResponseStreamErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_invoke_endpoint_with_response_stream(c.params, input)) ?? e => return Err(InvokeEndpointWithResponseStreamErr.InvalidInput(e))
  var req = serialize_invoke_endpoint_with_response_stream(ep, input, "") ?? e => return Err(InvokeEndpointWithResponseStreamErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let opened = transport.open(c.transport, req, signing, restjson.classify) ?? e => return Err(InvokeEndpointWithResponseStreamErr.Send(e))
  match opened {
    Done(resp) => Err(deserialize_invoke_endpoint_with_response_stream_error(resp))
    Stream(head, body) => {
      // the other members are in the headers (an initial-response
      // event carries them in awsJson)
      match deserialize_invoke_endpoint_with_response_stream(http.Response{status: head.status, headers: head.headers, body: b""}) {
        Ok(o) => Ok(InvokeEndpointWithResponseStreamEvents{output: o, body: body})
        Err(msg) => {
          body.close()
          Err(InvokeEndpointWithResponseStreamErr.Deserialize(msg))
        }
      }
    }
  }
}
