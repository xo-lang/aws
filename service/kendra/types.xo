pub enum QueryResultFormat: Str {
  Table = "TABLE"
  Text = "TEXT"
  Unknown(value: Str)
}

/// A single query result. A query result contains information about a
/// document returned by the query. This includes the original location of
/// the document, a list of attributes assigned to the document, and
/// relevant text from the document that satisfies the query.
pub struct QueryResultItem {
  /// The unique identifier for the query result item id ( Id ) and the query
  /// result item document id ( DocumentId ) combined. The value of this field
  /// changes with every request, even when you have the same documents.
  pub id: Str? = None
  /// The type of document within the response. For example, a response could
  /// include a question-answer that's relevant to the query.
  pub type_value: QueryResultType? = None
  /// If the Type of document within the response is ANSWER , then it is
  /// either a TABLE answer or TEXT answer. If it's a table answer, a table
  /// excerpt is returned in TableExcerpt . If it's a text answer, a text
  /// excerpt is returned in DocumentExcerpt .
  pub format: QueryResultFormat? = None
  /// One or more additional fields/attributes associated with the query
  /// result.
  pub additional_attributes: List[AdditionalResultAttribute]? = None
  /// The identifier for the document.
  pub document_id: Str? = None
  /// The title of the document. Contains the text of the title and
  /// information for highlighting the relevant terms in the title.
  pub document_title: TextWithHighlights? = None
  /// An extract of the text in the document. Contains information about
  /// highlighting the relevant terms in the excerpt.
  pub document_excerpt: TextWithHighlights? = None
  /// The URI of the original location of the document.
  pub document_uri: Str? = None
  /// An array of document fields/attributes assigned to a document in the
  /// search results. For example, the document author ( _author ) or the
  /// source URI ( _source_uri ) of the document.
  pub document_attributes: List[DocumentAttribute]? = None
  /// Indicates the confidence level of Amazon Kendra providing a relevant
  /// result for the query. Each result is placed into a bin that indicates
  /// the confidence, VERY_HIGH , HIGH , MEDIUM and LOW . You can use the
  /// score to determine if a response meets the confidence needed for your
  /// application. The field is only set to LOW when the Type field is set to
  /// DOCUMENT and Amazon Kendra is not confident that the result is relevant
  /// to the query.
  pub score_attributes: ScoreAttributes? = None
  /// A token that identifies a particular result from a particular query. Use
  /// this token to provide click-through feedback for the result. For more
  /// information, see Submitting feedback .
  pub feedback_token: Str? = None
  /// An excerpt from a table within a document.
  pub table_excerpt: TableExcerpt? = None
  /// Provides details about a collapsed group of search results.
  pub collapsed_result_detail: CollapsedResultDetail? = None
}

