  /// eventsPollInterval=5; In the example, DMS checks for changes in the
  /// binary logs every five seconds.
  pub events_poll_interval: Int? = None
  /// Specifies where to migrate source tables on the target, either to a
  /// single database or multiple databases. If you specify SPECIFIC_DATABASE
  /// , specify the database name using the DatabaseName parameter of the
  /// Endpoint object. Example: targetDbType=MULTIPLE_DATABASES
  pub target_db_type: TargetDbType? = None
  /// Specifies the maximum size (in KB) of any .csv file used to transfer
  /// data to a MySQL-compatible database. Example: maxFileSize=512
  pub max_file_size: Int? = None
  /// Improves performance when loading data into the MySQL-compatible target
  /// database. Specifies how many threads to use to load the data into the
  /// MySQL-compatible target database. Setting a large number of threads can
  /// have an adverse effect on database performance, because a separate
  /// connection is required for each thread. The default is one. Example:
  /// parallelLoadThreads=1
  pub parallel_load_threads: Int? = None
  /// Endpoint connection password.
  pub password: Str? = None
  /// Endpoint TCP port.
  pub port: Int? = None
  /// The host name of the endpoint database. For an Amazon RDS MySQL
  /// instance, this is the output of DescribeDBInstances , in the Endpoint
  /// .Address field. For an Aurora MySQL instance, this is the output of
  /// DescribeDBClusters , in the Endpoint field.
  pub server_name: Str? = None
  /// Specifies the time zone for the source MySQL database. Example:
  /// serverTimezone=US/Pacific; Note: Do not enclose time zones in single
  /// quotes.
  pub server_timezone: Str? = None
  /// Endpoint connection user name.
  pub username: Str? = None
  /// The full Amazon Resource Name (ARN) of the IAM role that specifies DMS
  /// as the trusted entity and grants the required permissions to access the
