  /// must match the second level, and so on.
  pub column: ColumnIdentifier? = None
  /// The value in the parent node's HierarchyValues that this node belongs
  /// to. When a parent selects several values, each of its children repeats
  /// one of them here to identify which branch of the hierarchy that child
  /// describes. Omit this attribute on the root node of HierarchyTree , which
  /// has no parent.
  pub parent_value: Str? = None
  /// The values that are selected at this level of the hierarchy. You can
  /// specify a maximum of 2,000 values per node.
  pub hierarchy_values: List[Str]? = None
  /// The nodes that record the selections at the next level of the hierarchy.
  /// You can specify a maximum of 1,000 children per node.
  pub children: List[HierarchyFilterNode]? = None
}

