fn json_of_private_endpoint(v: PrivateEndpoint) -> json.Value {
  match v {
    SelfManagedLatticeResource(x) => json.Value.Object([("selfManagedLatticeResource", json_of_self_managed_lattice_resource(x))])
    ManagedVpcResource(x) => json.Value.Object([("managedVpcResource", json_of_managed_vpc_resource(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_private_endpoint(v: json.Value) -> PrivateEndpoint ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "selfManagedLatticeResource" => Ok(PrivateEndpoint.SelfManagedLatticeResource(from_json_self_managed_lattice_resource(fv)?))
      "managedVpcResource" => Ok(PrivateEndpoint.ManagedVpcResource(from_json_managed_vpc_resource(fv)?))
      _ => Ok(PrivateEndpoint.Unknown(k))
    }
  }
  Err("PrivateEndpoint: no member set")
}

