/// The HTTP request of CreateApplication.
pub fn serialize_create_application(ep: rest.Endpoint, input: CreateApplicationRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_environment_identifier = match input.environment_identifier {
    Some(v) => v
    None => return Err("input member EnvironmentIdentifier is required")
  }
  if label_environment_identifier == "" {
    return Err("input member EnvironmentIdentifier must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = input.vpc_id {
    fs.push(("VpcId", json.Value.Str(x)))
  }
  if let Some(x) = input.proxy_type {
    fs.push(("ProxyType", json.Value.Str(x)))
  }
  if let Some(x) = input.api_gateway_proxy {
    fs.push(("ApiGatewayProxy", json_of_api_gateway_proxy_input(x)))
  }
  if let Some(x) = input.tags {
    fs.push(("Tags", json_of_tag_map(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("ClientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("ClientToken", json.Value.Str(idempotency_token)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/environments/${rest.escape(label_environment_identifier, false)}/applications"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

