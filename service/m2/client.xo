fn json_of_storage_configuration(v: StorageConfiguration) -> json.Value {
  match v {
    Efs(x) => json.Value.Object([("efs", json_of_efs_storage_configuration(x))])
    Fsx(x) => json.Value.Object([("fsx", json_of_fsx_storage_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_storage_configuration(v: json.Value) -> StorageConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "efs" => Ok(StorageConfiguration.Efs(from_json_efs_storage_configuration(fv)?))
      "fsx" => Ok(StorageConfiguration.Fsx(from_json_fsx_storage_configuration(fv)?))
      _ => Ok(StorageConfiguration.Unknown(k))
    }
  }
  Err("StorageConfiguration: no member set")
}

