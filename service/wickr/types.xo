  pub is_ato_enabled: Bool? = None
  /// Enables automatic preview of links shared in messages, showing webpage
  /// thumbnails and descriptions.
  pub is_link_preview_enabled: Bool? = None
  /// Allows map integration in location sharing, enabling users to view
  /// shared locations on interactive maps. Only allowed when location setting
  /// is enabled.
  pub location_allow_maps: Bool? = None
  /// Enables location sharing features, allowing users to share their current
  /// location with others.
  pub location_enabled: Bool? = None
  /// The maximum file size in bytes that will be automatically downloaded
  /// without user confirmation. Only allowed if fileDownload is enabled.
  /// Valid Values [512000 (low_quality), 7340032 (high_quality) ]
  pub max_auto_download_size: Int? = None
  /// The maximum burn-on-read (BOR) time in seconds, which determines how
  /// long messages remain visible before auto-deletion after being read.
  pub max_bor: Int? = None
  /// The maximum time-to-live (TTL) in seconds for messages, after which they
  /// will be automatically deleted from all devices.
  pub max_ttl: Int? = None
  /// Enables message forwarding, allowing users to forward messages from one
  /// conversation to another.
  pub message_forwarding_enabled: Bool? = None
  /// The password complexity requirements that users must follow when
  /// creating or changing passwords.
  pub password_requirements: PasswordRequirements? = None
  /// Enables presence indicators that show whether users are online, away, or
  /// offline.
  pub presence_enabled: Bool? = None
  /// A list of pre-defined quick response message templates that users can
  /// send with a single tap.
  pub quick_responses: List[Str]? = None
  /// Users will get a master recovery key that can be used to securely sign
  /// in to their Wickr account without having access to their primary device
  /// for authentication. Available in SSO enabled network.
  pub show_master_recovery_key: Bool? = None
  /// The message shredder configuration that controls secure deletion of
  /// messages and files from devices.
  pub shredder: ShredderSettings? = None
  /// The duration for which users SSO session remains inactive before
  /// automatically logging them out for security. Available in SSO enabled
  /// network.
  pub sso_max_idle_minutes: Int? = None
  /// Maximum session duration in minutes for non-SSO users. Set to 0 to
  /// disable. Valid range is 60 to 525600 (1 hour to 365 days).
  pub max_non_sso_session_minutes: Int? = None
  /// The local federation mode controlling how users can communicate with
  /// other networks. Values: 0 (none), 1 (federated), 2 (restricted).
  pub federation_mode: Int? = None
  /// The number of failed password attempts before a user account is locked
  /// out.
  pub lockout_threshold: Int? = None
  /// A list of network IDs that are permitted for local federation when
  /// federation mode is set to restricted.
  pub permitted_networks: List[Str]? = None
  /// A list of permitted Wickr networks for global federation, restricting
  /// communication to specific approved networks.
  pub permitted_wickr_aws_networks: List[WickrAwsNetworks]? = None
  /// A list of permitted Wickr Enterprise networks for global federation,
  /// restricting communication to specific approved networks.
  pub permitted_wickr_enterprise_networks: List[PermittedWickrEnterpriseNetwork]? = None
}

/// Contains the security group configuration settings that can be specified
/// when creating or updating a security group. This is a subset of
/// SecurityGroupSettings containing only the modifiable federation and
/// security settings.
pub struct SecurityGroupSettingsRequest {
  /// The number of failed password attempts before a user account is locked
  /// out.
  pub lockout_threshold: Int? = None
  /// A list of network IDs that are permitted for local federation when
  /// federation mode is set to restricted.
  pub permitted_networks: List[Str]? = None
  /// Guest users let you work with people outside your organization that only
  /// have limited access to Wickr. Only valid when federationMode is set to
  /// Global.
  pub enable_guest_federation: Bool? = None
  /// Allow users to securely federate with all Amazon Web Services Wickr
  /// networks and Amazon Web Services Enterprise networks.
  pub global_federation: Bool? = None
  /// The local federation mode. Values: 0 (none), 1 (federated - all
  /// networks), 2 (restricted - only permitted networks).
  pub federation_mode: Int? = None
  /// Enables restricted global federation to limit communication to specific
  /// permitted networks only. Requires globalFederation to be enabled.
  pub enable_restricted_global_federation: Bool? = None
  /// A list of permitted Amazon Web Services Wickr networks for restricted
  /// global federation.
  pub permitted_wickr_aws_networks: List[WickrAwsNetworks]? = None
  /// A list of permitted Wickr Enterprise networks for restricted global
  /// federation.
  pub permitted_wickr_enterprise_networks: List[PermittedWickrEnterpriseNetwork]? = None
}

/// Represents a single network-level configuration setting with its name,
/// value, and data type. Settings control network-wide behaviors and
/// features.
pub struct Setting {
  /// The name of the network setting (e.g., 'enableClientMetrics',
  /// 'dataRetention').
  pub option_name: Str? = None
  /// The current value of the setting as a string. Boolean values are
  /// represented as 'true' or 'false'.
  pub value: Str? = None
  /// The data type of the setting value (e.g., 'boolean', 'string',
  /// 'number').
  pub type_value: Str? = None
}

/// Configuration for the Wickr shredder feature, which writes random data
/// over free memory and disk space on client devices. You can configure
/// your Wickr shredder intensity using the parameters below. Secure
/// Shredder will not write over files that are permanently stored on the
/// device or saved outside of the Wickr client. Wickr Network
/// Administrators are able to disable file downloads within Security Group
/// Settings.
pub struct ShredderSettings {
  /// Specifies whether users can manually trigger the shredder to delete
  /// content.
  pub can_process_manually: Bool? = None
  /// Controls the rate (MB/minute) at which the shredder function runs on
  /// clients. Valid Values: Must be one of [0, 20, 60, 100]. A higher
  /// intensity setting could lead to higher battery usage on mobile devices.
  pub intensity: Int? = None
}

pub enum SortDirection: Str {
  Asc = "ASC"
  Desc = "DESC"
  Unknown(value: Str)
}

pub enum Status: Str {
  Disabled = "DISABLED"
  Enabled = "ENABLED"
  ForceEnabled = "FORCE_ENABLED"
  Unknown(value: Str)
}

/// The request was not authenticated or the authentication credentials were
/// invalid. This error occurs when the request lacks valid authentication
/// credentials or the credentials have expired.
pub struct UnauthorizedError {
  /// A message explaining why the authentication failed.
  pub message: Str? = None
}

pub struct UpdateBotRequest {
