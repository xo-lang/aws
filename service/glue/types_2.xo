/// Specifies configuration for Snowflake nodes in Glue Studio.
pub struct SnowflakeNodeData {
  /// Specifies how retrieved data is specified. Valid values: "table" ,
  /// "query" .
  pub source_type: Str? = None
  /// Specifies a Glue Data Catalog Connection to a Snowflake endpoint.
  pub connection: OptionShape? = None
  /// Specifies a Snowflake database schema for your node to use.
  pub schema: Str? = None
  /// Specifies a Snowflake table for your node to use.
  pub table: Str? = None
  /// Specifies a Snowflake database for your node to use.
  pub database: Str? = None
  /// Not currently used.
  pub temp_dir: Str? = None
  /// Not currently used.
  pub iam_role: OptionShape? = None
  /// Specifies additional options passed to the Snowflake connector. If
  /// options are specified elsewhere in this node, this will take precedence.
  pub additional_options: Map[Str, Str]? = None
  /// A SQL string used to retrieve data with the query sourcetype.
  pub sample_query: Str? = None
  /// A SQL string run before the Snowflake connector performs its standard
  /// actions.
  pub pre_action: Str? = None
  /// A SQL string run after the Snowflake connector performs its standard
  /// actions.
  pub post_action: Str? = None
  /// Specifies what action to take when writing to a table with preexisting
  /// data. Valid values: append , merge , truncate , drop .
  pub action: Str? = None
  /// Used when Action is append . Specifies the resolution behavior when a
  /// row already exists. If true, preexisting rows will be updated. If false,
  /// those rows will be inserted.
  pub upsert: Bool? = None
  /// Specifies a merge action. Valid values: simple , custom . If simple,
  /// merge behavior is defined by MergeWhenMatched and MergeWhenNotMatched .
  /// If custom, defined by MergeClause .
  pub merge_action: Str? = None
  /// Specifies how to resolve records that match preexisting data when
  /// merging. Valid values: update , delete .
  pub merge_when_matched: Str? = None
  /// Specifies how to process records that do not match preexisting data when
  /// merging. Valid values: insert , none .
  pub merge_when_not_matched: Str? = None
  /// A SQL statement that specifies a custom merge behavior.
  pub merge_clause: Str? = None
  /// The name of a staging table used when performing merge or upsert append
  /// actions. Data is written to this table, then moved to table by a
  /// generated postaction.
  pub staging_table: Str? = None
  /// Specifies the columns combined to identify a record when detecting
  /// matches for merges and upserts. A list of structures with value , label
  /// and description keys. Each structure describes a column.
  pub selected_columns: List[OptionShape]? = None
  /// Specifies whether automatic query pushdown is enabled. If pushdown is
  /// enabled, then when a query is run on Spark, if part of the query can be
  /// "pushed down" to the Snowflake server, it is pushed down. This improves
  /// performance of some queries.
  pub auto_pushdown: Bool? = None
  /// Manually defines the target schema for the node. A list of structures
  /// with value , label and description keys. Each structure defines a
  /// column.
  pub table_schema: List[OptionShape]? = None
}

