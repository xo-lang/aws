    PaymentScheduleTermTemplate(x) => json.Value.Object([("paymentScheduleTermTemplate", json_of_payment_schedule_term_template(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_term_template(v: json.Value) -> TermTemplate ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "paymentScheduleTermTemplate" => Ok(TermTemplate.PaymentScheduleTermTemplate(from_json_payment_schedule_term_template(fv)?))
      _ => Ok(TermTemplate.Unknown(k))
    }
  }
  Err("TermTemplate: no member set")
}

