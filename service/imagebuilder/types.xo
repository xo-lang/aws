  /// The name of the image pipeline.
  pub name: Str? = None
  /// The description of the image pipeline.
  pub description: Str? = None
  /// The platform of the image pipeline, inherited from the recipe that the
  /// pipeline uses.
  pub platform: Platform? = None
  /// Specifies whether to collect additional information about the image
  /// being created, including the operating system (OS) version and package
  /// list. Defaults to true .
  pub enhanced_image_metadata_enabled: Bool? = None
  /// The Amazon Resource Name (ARN) of the image recipe associated with this
  /// image pipeline.
  pub image_recipe_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the container recipe that is used for
  /// this pipeline.
  pub container_recipe_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the infrastructure configuration
  /// associated with this image pipeline.
  pub infrastructure_configuration_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the distribution configuration
  /// associated with this image pipeline.
  pub distribution_configuration_arn: Str? = None
  /// The image tests configuration of the image pipeline.
  pub image_tests_configuration: ImageTestsConfiguration? = None
  /// The schedule of the image pipeline.
  pub schedule: Schedule? = None
  /// The status of the image pipeline. A disabled pipeline doesn't run on its
  /// schedule, but you can still start builds manually. Image Builder can
  /// also disable a pipeline automatically when consecutive scheduled builds
  /// fail.
  pub status: PipelineStatus? = None
  /// The date on which this image pipeline was created.
  pub date_created: Str? = None
  /// The date on which this image pipeline was last updated.
  pub date_updated: Str? = None
  /// The date on which this image pipeline was last run.
  pub date_last_run: Str? = None
  /// The status of the last image that this pipeline built, such as BUILDING
  /// , TESTING , FAILED , or AVAILABLE .
  pub last_run_status: ImageStatus? = None
  /// The next date when the pipeline is scheduled to run.
  pub date_next_run: Str? = None
  /// The tags of this image pipeline.
  pub tags: Map[Str, Str]? = None
  /// The settings that determine whether and how Amazon Inspector scans the
  /// images that the pipeline creates.
  pub image_scanning_configuration: ImageScanningConfiguration? = None
  /// The tags that Image Builder applies to the Image Builder image resource
  /// that this pipeline's scheduled executions create. These tags don't apply
  /// to the output AMI. Builds that you start manually use the tags from the
  /// StartImagePipelineExecution request instead.
  pub image_tags: Map[Str, Str]? = None
  /// The name or Amazon Resource Name (ARN) for the IAM role you create that
  /// grants Image Builder access to perform workflow actions.
  pub execution_role: Str? = None
  /// Contains the workflows that run for the image pipeline.
  pub workflows: List[WorkflowConfiguration]? = None
  /// The CloudWatch Logs configuration for the pipeline: the log group for
  /// image build logs and the log group for pipeline execution logs.
  pub logging_configuration: PipelineLoggingConfiguration? = None
  /// Image Builder tracks the number of consecutive failures for scheduled
  /// pipeline executions and takes one of the following actions each time it
  /// runs on a schedule: If the pipeline execution is successful, the number
  /// of consecutive failures resets to zero. If the pipeline execution fails,
  /// Image Builder increments the number of consecutive failures. If the
  /// failure count reaches the limit defined in the AutoDisablePolicy , Image
  /// Builder disables the pipeline. The consecutive failure count is also
  /// reset to zero under the following conditions: The pipeline runs manually
  /// and succeeds. The pipeline configuration is updated. If the pipeline
  /// runs manually and fails, the count remains the same. The next scheduled
  /// run continues to increment where it left off before.
  pub consecutive_failures: Int? = None
}

