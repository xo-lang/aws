/// Creates a staging distribution using the configuration of the provided
/// primary distribution. A staging distribution is a copy of an existing
/// distribution (called the primary distribution) that you can use in a
/// continuous deployment workflow. After you create a staging distribution,
/// you can use UpdateDistribution to modify the staging distribution's
/// configuration. Then you can use CreateContinuousDeploymentPolicy to
/// incrementally move traffic to the staging distribution. This API
/// operation requires the following IAM permissions: GetDistribution
/// CreateDistribution CopyDistribution
pub fn (c: Client) copy_distribution(input: CopyDistributionRequest) -> CopyDistributionResult ! CopyDistributionErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_copy_distribution(c.params, input)) ?? e => return Err(CopyDistributionErr.InvalidInput(e))
  var req = serialize_copy_distribution(ep, input, "") ?? e => return Err(CopyDistributionErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(CopyDistributionErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_copy_distribution_error(resp))
  }
  deserialize_copy_distribution(resp) ?? e => Err(CopyDistributionErr.Deserialize(e))
}

