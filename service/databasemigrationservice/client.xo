fn from_json_oracle_settings(v: json.Value) -> OracleSettings ! Str {
  var out = OracleSettings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "AddSupplementalLogging" => out.add_supplemental_logging = jsonv.read_bool(fv)?
      "ArchivedLogDestId" => out.archived_log_dest_id = jsonv.read_int(fv)?
      "AdditionalArchivedLogDestId" => out.additional_archived_log_dest_id = jsonv.read_int(fv)?
      "ExtraArchivedLogDestIds" => out.extra_archived_log_dest_ids = from_json_integer_list(fv)?
      "AllowSelectNestedTables" => out.allow_select_nested_tables = jsonv.read_bool(fv)?
      "ParallelAsmReadThreads" => out.parallel_asm_read_threads = jsonv.read_int(fv)?
      "ReadAheadBlocks" => out.read_ahead_blocks = jsonv.read_int(fv)?
      "AccessAlternateDirectly" => out.access_alternate_directly = jsonv.read_bool(fv)?
      "UseAlternateFolderForOnline" => out.use_alternate_folder_for_online = jsonv.read_bool(fv)?
      "OraclePathPrefix" => out.oracle_path_prefix = jsonv.read_str(fv)?
      "UsePathPrefix" => out.use_path_prefix = jsonv.read_str(fv)?
      "ReplacePathPrefix" => out.replace_path_prefix = jsonv.read_bool(fv)?
      "EnableHomogenousTablespace" => out.enable_homogenous_tablespace = jsonv.read_bool(fv)?
      "DirectPathNoLog" => out.direct_path_no_log = jsonv.read_bool(fv)?
      "ArchivedLogsOnly" => out.archived_logs_only = jsonv.read_bool(fv)?
      "AsmPassword" => out.asm_password = jsonv.read_str(fv)?
      "AsmServer" => out.asm_server = jsonv.read_str(fv)?
      "AsmUser" => out.asm_user = jsonv.read_str(fv)?
      "CharLengthSemantics" => out.char_length_semantics = CharLengthSemantics.from(jsonv.read_str(fv)?)
      "DatabaseName" => out.database_name = jsonv.read_str(fv)?
      "DirectPathParallelLoad" => out.direct_path_parallel_load = jsonv.read_bool(fv)?
      "FailTasksOnLobTruncation" => out.fail_tasks_on_lob_truncation = jsonv.read_bool(fv)?
      "NumberDatatypeScale" => out.number_datatype_scale = jsonv.read_int(fv)?
      "Password" => out.password = jsonv.read_str(fv)?
      "Port" => out.port = jsonv.read_int(fv)?
      "ReadTableSpaceName" => out.read_table_space_name = jsonv.read_bool(fv)?
      "RetryInterval" => out.retry_interval = jsonv.read_int(fv)?
      "SecurityDbEncryption" => out.security_db_encryption = jsonv.read_str(fv)?
      "SecurityDbEncryptionName" => out.security_db_encryption_name = jsonv.read_str(fv)?
      "ServerName" => out.server_name = jsonv.read_str(fv)?
      "SpatialDataOptionToGeoJsonFunctionName" => out.spatial_data_option_to_geo_json_function_name = jsonv.read_str(fv)?
      "StandbyDelayTime" => out.standby_delay_time = jsonv.read_int(fv)?
      "Username" => out.username = jsonv.read_str(fv)?
      "UseBFile" => out.use_b_file = jsonv.read_bool(fv)?
      "UseDirectPathFullLoad" => out.use_direct_path_full_load = jsonv.read_bool(fv)?
      "UseLogminerReader" => out.use_logminer_reader = jsonv.read_bool(fv)?
      "SecretsManagerAccessRoleArn" => out.secrets_manager_access_role_arn = jsonv.read_str(fv)?
      "SecretsManagerSecretId" => out.secrets_manager_secret_id = jsonv.read_str(fv)?
      "SecretsManagerOracleAsmAccessRoleArn" => out.secrets_manager_oracle_asm_access_role_arn = jsonv.read_str(fv)?
      "SecretsManagerOracleAsmSecretId" => out.secrets_manager_oracle_asm_secret_id = jsonv.read_str(fv)?
      "TrimSpaceInChar" => out.trim_space_in_char = jsonv.read_bool(fv)?
      "ConvertTimestampWithZoneToUTC" => out.convert_timestamp_with_zone_to_utc = jsonv.read_bool(fv)?
      "OpenTransactionWindow" => out.open_transaction_window = jsonv.read_int(fv)?
      "AuthenticationMethod" => out.authentication_method = OracleAuthenticationMethod.from(jsonv.read_str(fv)?)
      _ => {}
    }
