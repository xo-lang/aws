  ExcludedProperties = "EXCLUDED_PROPERTIES"
  ExcludedResources = "EXCLUDED_RESOURCES"
  Unknown(value: Str)
}

/// Contains any warnings returned by the GetTemplateSummary API action.
pub struct Warnings {
  /// A list of all of the unrecognized resource types. This is only returned
  /// if the TemplateSummaryConfig parameter has the
  /// TreatUnrecognizedResourceTypesAsWarning configuration set to True .
  pub unrecognized_resource_types: List[Str]? = None
}
