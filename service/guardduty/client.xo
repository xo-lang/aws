  if let Some(x) = v.function_arn {
    fs.push(("functionArn", json.Value.Str(x)))
  }
  if let Some(x) = v.function_name {
    fs.push(("functionName", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.last_modified_at {
    fs.push(("lastModifiedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.revision_id {
    fs.push(("revisionId", json.Value.Str(x)))
  }
  if let Some(x) = v.function_version {
    fs.push(("functionVersion", json.Value.Str(x)))
  }
  if let Some(x) = v.role {
    fs.push(("role", json.Value.Str(x)))
  }
  if let Some(x) = v.vpc_config {
    fs.push(("vpcConfig", json_of_vpc_config(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("tags", json_of_tags(x)))
  }
  json.Value.Object(fs)
}

fn from_json_lambda_details(v: json.Value) -> LambdaDetails ! Str {
  var out = LambdaDetails{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "functionArn" => out.function_arn = jsonv.read_str(fv)?
      "functionName" => out.function_name = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "lastModifiedAt" => out.last_modified_at = jsonv.read_time(fv, "epoch-seconds")?
      "revisionId" => out.revision_id = jsonv.read_str(fv)?
      "functionVersion" => out.function_version = jsonv.read_str(fv)?
      "role" => out.role = jsonv.read_str(fv)?
      "vpcConfig" => out.vpc_config = from_json_vpc_config(fv)?
      "tags" => out.tags = from_json_tags(fv)?
      _ => {}
    }
  }
  Ok(out)
}

