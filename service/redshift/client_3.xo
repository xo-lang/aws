  InvalidRetentionPeriodFault(e: InvalidRetentionPeriodFault)
  Ipv6CidrBlockNotFoundFault(e: Ipv6CidrBlockNotFoundFault)
  LimitExceededFault(e: LimitExceededFault)
  NumberOfNodesPerClusterLimitExceededFault(e: NumberOfNodesPerClusterLimitExceededFault)
  NumberOfNodesQuotaExceededFault(e: NumberOfNodesQuotaExceededFault)
  TableLimitExceededFault(e: TableLimitExceededFault)
  UnauthorizedOperation(e: UnauthorizedOperation)
  UnsupportedOperationFault(e: UnsupportedOperationFault)
  UnsupportedOptionFault(e: UnsupportedOptionFault)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}