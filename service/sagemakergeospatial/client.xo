fn json_of_job_config_input(v: JobConfigInput) -> json.Value {
  match v {
    BandMathConfig(x) => json.Value.Object([("BandMathConfig", json_of_band_math_config_input(x))])
    ResamplingConfig(x) => json.Value.Object([("ResamplingConfig", json_of_resampling_config_input(x))])
    TemporalStatisticsConfig(x) => json.Value.Object([("TemporalStatisticsConfig", json_of_temporal_statistics_config_input(x))])
    CloudRemovalConfig(x) => json.Value.Object([("CloudRemovalConfig", json_of_cloud_removal_config_input(x))])
    ZonalStatisticsConfig(x) => json.Value.Object([("ZonalStatisticsConfig", json_of_zonal_statistics_config_input(x))])
    GeoMosaicConfig(x) => json.Value.Object([("GeoMosaicConfig", json_of_geo_mosaic_config_input(x))])
    StackConfig(x) => json.Value.Object([("StackConfig", json_of_stack_config_input(x))])
    CloudMaskingConfig(x) => json.Value.Object([("CloudMaskingConfig", json_of_cloud_masking_config_input(x))])
    LandCoverSegmentationConfig(x) => json.Value.Object([("LandCoverSegmentationConfig", json_of_land_cover_segmentation_config_input(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_job_config_input(v: json.Value) -> JobConfigInput ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "BandMathConfig" => Ok(JobConfigInput.BandMathConfig(from_json_band_math_config_input(fv)?))
      "ResamplingConfig" => Ok(JobConfigInput.ResamplingConfig(from_json_resampling_config_input(fv)?))
      "TemporalStatisticsConfig" => Ok(JobConfigInput.TemporalStatisticsConfig(from_json_temporal_statistics_config_input(fv)?))
      "CloudRemovalConfig" => Ok(JobConfigInput.CloudRemovalConfig(from_json_cloud_removal_config_input(fv)?))
      "ZonalStatisticsConfig" => Ok(JobConfigInput.ZonalStatisticsConfig(from_json_zonal_statistics_config_input(fv)?))
      "GeoMosaicConfig" => Ok(JobConfigInput.GeoMosaicConfig(from_json_geo_mosaic_config_input(fv)?))
      "StackConfig" => Ok(JobConfigInput.StackConfig(from_json_stack_config_input(fv)?))
      "CloudMaskingConfig" => Ok(JobConfigInput.CloudMaskingConfig(from_json_cloud_masking_config_input(fv)?))
      "LandCoverSegmentationConfig" => Ok(JobConfigInput.LandCoverSegmentationConfig(from_json_land_cover_segmentation_config_input(fv)?))
      _ => Ok(JobConfigInput.Unknown(k))
    }
  }
  Err("JobConfigInput: no member set")
}

