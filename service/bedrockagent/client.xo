      "loopIncompatibleNodeType" => Ok(FlowValidationDetails.LoopIncompatibleNodeType(from_json_loop_incompatible_node_type_flow_validation_details(fv)?))
      "invalidLoopBoundary" => Ok(FlowValidationDetails.InvalidLoopBoundary(from_json_invalid_loop_boundary_flow_validation_details(fv)?))
      _ => Ok(FlowValidationDetails.Unknown(k))
    }
  }
  Err("FlowValidationDetails: no member set")
