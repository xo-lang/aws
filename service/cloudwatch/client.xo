    xmlv.elem(w, "SampleCount", rest.float_text(x), [])
  }
  if let Some(x) = v.average {
    xmlv.elem(w, "Average", rest.float_text(x), [])
  }
  if let Some(x) = v.sum {
    xmlv.elem(w, "Sum", rest.float_text(x), [])
  }
  if let Some(x) = v.minimum {
    xmlv.elem(w, "Minimum", rest.float_text(x), [])
  }
  if let Some(x) = v.maximum {
    xmlv.elem(w, "Maximum", rest.float_text(x), [])
  }
  if let Some(x) = v.unit {
    xmlv.elem(w, "Unit", x.value(), [])
  }
  if let Some(x) = v.extended_statistics {
    xml_write_datapoint_value_map(w, x, "ExtendedStatistics", [])
  }
  xmlv.end(w, name)
}

