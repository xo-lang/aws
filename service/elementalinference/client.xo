/// The HTTP request of UpdateFeed.
pub fn serialize_update_feed(ep: rest.Endpoint, input: UpdateFeedRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
