}

fn from_json_data_source_list(v: json.Value) -> List[DataSource] ! Str {
  var out: List[DataSource] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(DataSource.from(jsonv.read_str(fv)?))
  }
  Ok(out)
}

