/// Information about a durable execution .
pub struct Execution {
  /// The Amazon Resource Name (ARN) of the durable execution, if this
  /// execution is a durable execution.
  pub durable_execution_arn: Str? = None
  /// The unique name of the durable execution, if one was provided when the
  /// execution was started.
  pub durable_execution_name: Str? = None
  /// The Amazon Resource Name (ARN) of the Lambda function.
  pub function_arn: Str? = None
  /// The current status of the durable execution.
  pub status: ExecutionStatus? = None
  /// The date and time when the durable execution started, in ISO-8601 format
  /// (YYYY-MM-DDThh:mm:ss.sTZD).
  pub start_timestamp: Time? = None
  /// The date and time when the durable execution ended, in ISO-8601 format
  /// (YYYY-MM-DDThh:mm:ss.sTZD).
  pub end_timestamp: Time? = None
  /// The ARN of the Key Management Service (KMS) customer managed key that is
  /// used to encrypt your durable execution's payload data, including input,
  /// output, and error payloads.
  pub kms_key_arn: Str? = None
}

