  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(BatchDeleteTaxRegistrationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_batch_delete_tax_registration_error(resp))
  }
  deserialize_batch_delete_tax_registration(resp) ?? e => Err(BatchDeleteTaxRegistrationErr.Deserialize(e))
}

