  /// file extension.
  pub name: Str? = None
  /// The upload's content type (for example, application/x-yaml ).
  pub content_type: Str? = None
  /// Set to true if the YAML file has changed and must be updated. Otherwise,
  /// set to false.
  pub edit_content: Bool? = None
