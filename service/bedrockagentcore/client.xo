fn json_of_evaluation_result_content(v: EvaluationResultContent) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.evaluator_arn {
    fs.push(("evaluatorArn", json.Value.Str(x)))
  }
  if let Some(x) = v.evaluator_id {
