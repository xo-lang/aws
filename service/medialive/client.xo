fn from_json_hls_group_settings(v: json.Value) -> HlsGroupSettings ! Str {
  var out = HlsGroupSettings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "adMarkers" => out.ad_markers = from_json_list_of_hls_ad_markers(fv)?
      "baseUrlContent" => out.base_url_content = jsonv.read_str(fv)?
      "baseUrlContent1" => out.base_url_content1 = jsonv.read_str(fv)?
      "baseUrlManifest" => out.base_url_manifest = jsonv.read_str(fv)?
      "baseUrlManifest1" => out.base_url_manifest1 = jsonv.read_str(fv)?
      "captionLanguageMappings" => out.caption_language_mappings = from_json_list_of_caption_language_mapping(fv)?
      "captionLanguageSetting" => out.caption_language_setting = HlsCaptionLanguageSetting.from(jsonv.read_str(fv)?)
      "clientCache" => out.client_cache = HlsClientCache.from(jsonv.read_str(fv)?)
      "codecSpecification" => out.codec_specification = HlsCodecSpecification.from(jsonv.read_str(fv)?)
      "constantIv" => out.constant_iv = jsonv.read_str(fv)?
      "destination" => out.destination = from_json_output_location_ref(fv)?
      "directoryStructure" => out.directory_structure = HlsDirectoryStructure.from(jsonv.read_str(fv)?)
      "discontinuityTags" => out.discontinuity_tags = HlsDiscontinuityTags.from(jsonv.read_str(fv)?)
      "encryptionType" => out.encryption_type = HlsEncryptionType.from(jsonv.read_str(fv)?)
      "hlsCdnSettings" => out.hls_cdn_settings = from_json_hls_cdn_settings(fv)?
      "hlsId3SegmentTagging" => out.hls_id3_segment_tagging = HlsId3SegmentTaggingState.from(jsonv.read_str(fv)?)
      "iFrameOnlyPlaylists" => out.i_frame_only_playlists = IFrameOnlyPlaylistType.from(jsonv.read_str(fv)?)
      "incompleteSegmentBehavior" => out.incomplete_segment_behavior = HlsIncompleteSegmentBehavior.from(jsonv.read_str(fv)?)
      "indexNSegments" => out.index_n_segments = jsonv.read_int(fv)?
      "inputLossAction" => out.input_loss_action = InputLossActionForHlsOut.from(jsonv.read_str(fv)?)
      "ivInManifest" => out.iv_in_manifest = HlsIvInManifest.from(jsonv.read_str(fv)?)
      "ivSource" => out.iv_source = HlsIvSource.from(jsonv.read_str(fv)?)
      "keepSegments" => out.keep_segments = jsonv.read_int(fv)?
      "keyFormat" => out.key_format = jsonv.read_str(fv)?
      "keyFormatVersions" => out.key_format_versions = jsonv.read_str(fv)?
      "keyProviderSettings" => out.key_provider_settings = from_json_key_provider_settings(fv)?
      "manifestCompression" => out.manifest_compression = HlsManifestCompression.from(jsonv.read_str(fv)?)
      "manifestDurationFormat" => out.manifest_duration_format = HlsManifestDurationFormat.from(jsonv.read_str(fv)?)
      "minSegmentLength" => out.min_segment_length = jsonv.read_int(fv)?
      "mode" => out.mode = HlsMode.from(jsonv.read_str(fv)?)
      "outputSelection" => out.output_selection = HlsOutputSelection.from(jsonv.read_str(fv)?)
      "programDateTime" => out.program_date_time = HlsProgramDateTime.from(jsonv.read_str(fv)?)
      "programDateTimeClock" => out.program_date_time_clock = HlsProgramDateTimeClock.from(jsonv.read_str(fv)?)
      "programDateTimePeriod" => out.program_date_time_period = jsonv.read_int(fv)?
      "redundantManifest" => out.redundant_manifest = HlsRedundantManifest.from(jsonv.read_str(fv)?)
      "segmentLength" => out.segment_length = jsonv.read_int(fv)?
      "segmentationMode" => out.segmentation_mode = HlsSegmentationMode.from(jsonv.read_str(fv)?)
      "segmentsPerSubdirectory" => out.segments_per_subdirectory = jsonv.read_int(fv)?
