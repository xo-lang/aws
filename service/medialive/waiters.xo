/// Wait until a channel has been created
///
/// Calls DescribeChannel until the ChannelCreated acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (3s) to `max_delay` (120s).
pub fn wait_until_channel_created(c: Client, input: DescribeChannelRequest, max_wait: Duration, min_delay: Duration = 3s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeChannelErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_channel(input) {
      Ok(out) => {
        let o = jmes_of_describe_channel_response(out)
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "IDLE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "CREATING") {
          state = "retry"
        }
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "CREATE_FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_channel(e)
        if state == "" && waiter.error_is(names, "InternalServerErrorException") {
          state = "retry"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ChannelCreated: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

