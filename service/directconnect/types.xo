/// Information about an interconnect.
pub struct Interconnect {
  /// The ID of the interconnect.
  pub interconnect_id: Str? = None
  /// The name of the interconnect.
  pub interconnect_name: Str? = None
  /// The state of the interconnect. The following are the possible values:
  /// requested : The initial state of an interconnect. The interconnect stays
  /// in the requested state until the Letter of Authorization (LOA) is sent
  /// to the customer. pending : The interconnect is approved, and is being
  /// initialized. available : The network link is up, and the interconnect is
  /// ready for use. down : The network link is down. deleting : The
  /// interconnect is being deleted. deleted : The interconnect is deleted.
  /// unknown : The state of the interconnect is not available.
  pub interconnect_state: InterconnectState? = None
  /// The Amazon Web Services Region where the connection is located.
  pub region: Str? = None
  /// The location of the connection.
  pub location: Str? = None
  /// The bandwidth of the connection.
