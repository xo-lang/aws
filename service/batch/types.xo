  /// The Amazon Resource Name (ARN) of the job queue associated with the
  /// quota share.
  pub job_queue_arn: Str? = None
  /// A list that specifies the quantity and type of compute capacity
  /// allocated to the quota share.
  pub capacity_limits: List[QuotaShareCapacityLimit]? = None
  /// Specifies whether a quota share reserves, lends, or both lends and
  /// borrows idle compute capacity.
  pub resource_sharing_configuration: QuotaShareResourceSharingConfiguration? = None
  /// Specifies the preemption behavior for jobs in a quota share.
  pub preemption_configuration: QuotaSharePreemptionConfiguration? = None
  /// The state of the quota share.
  pub state: QuotaShareState? = None
  /// The current status of the quota share.
  pub status: QuotaShareStatus? = None
}

pub enum QuotaShareIdleResourceAssignmentStrategy: Str {
  Fifo = "FIFO"
  Unknown(value: Str)
}

pub enum QuotaShareInSharePreemptionState: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// The quota share scheduling policy details for a job queue.
pub struct QuotaSharePolicy {
  /// The strategy that determines how idle resources are assigned to quota
  /// shares that are borrowing capacity. Currently, only FIFO is supported.
  pub idle_resource_assignment_strategy: QuotaShareIdleResourceAssignmentStrategy? = None
}

/// Specifies the preemption behavior for jobs in a quota share.
pub struct QuotaSharePreemptionConfiguration {
  /// Specifies whether jobs within a quota share can be preempted by another,
  /// higher priority job in the same quota share.
  pub in_share_preemption: QuotaShareInSharePreemptionState? = None
}

/// Specifies whether a quota share reserves, lends, or both lends and
/// borrows idle compute capacity.
pub struct QuotaShareResourceSharingConfiguration {
  /// The resource sharing strategy for the quota share. The RESERVE strategy
  /// allows a quota share to reserve idle capacity for itself. LEND
  /// configures the share to lend its idle capacity to another share in need
  /// of capacity. The LEND_AND_BORROW strategy configures the share to borrow
  /// idle capacity from an underutilized share, as well as lend to another
  /// share.
  pub strategy: QuotaShareResourceSharingStrategy? = None
  /// The maximum percentage of additional capacity that the quota share can
  /// borrow from other shares. borrowLimit can only be applied to quota
  /// shares with a strategy of LEND_AND_BORROW . This value is expressed as a
  /// percentage of the quota share's configured CapacityLimits . The
  /// borrowLimit is applied uniformly across all capacity units. For example,
  /// if the borrowLimit is 200, the quota share can borrow up to 200% of its
  /// configured maxCapacity for each capacity unit. The default borrowLimit
  /// is -1, which indicates unlimited borrowing.
  pub borrow_limit: Int? = None
}

pub enum QuotaShareResourceSharingStrategy: Str {
  Reserve = "RESERVE"
  Lend = "LEND"
  LendAndBorrow = "LEND_AND_BORROW"
  Unknown(value: Str)
}

pub enum QuotaShareState: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

pub enum QuotaShareStatus: Str {
  Creating = "CREATING"
  Valid = "VALID"
