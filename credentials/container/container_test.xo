use std/http
use github.com/xo-lang/aws

const BODY: Str = "{\"AccessKeyId\":\"ASIATEST0000000000\",\"SecretAccessKey\":\"invented-secret\",\"Token\":\"invented-token\",\"Expiration\":\"2026-01-01T06:00:00Z\",\"AccountId\":\"123456789012\"}"

test "the credentials URL is fetched with the token, and its answer read" {
  os.net.handle("GET http://169.254.170.2/v2/credentials/abc", fn(req: http.Request) -> http.Response {
    expect(req.header("Authorization")) == Some("invented-auth")
    http.text(200, BODY).with_header("Content-Type", "application/json")
  })
  let p = provider(os.net, os.clock, Options{uri: relative_uri("/v2/credentials/abc"), token: aws.fixed_token("invented-auth")})
  let c = p.retrieve()?
  expect(c.access_key_id) == "ASIATEST0000000000"
  expect(c.secret_access_key.reveal()) == "invented-secret"
  expect(c.session_token.map(fn(t: Secret[Str]) -> Str { t.reveal() })) == Some("invented-token")
  expect(c.account_id) == Some("123456789012")
  expect(c.source) == "CredentialsEndpointProvider"
  expect(c.expires.map(fn(t: Time) -> Str { t.format_rfc3339() })) == Some("2026-01-01T06:00:00Z")
}

test "an error answer is a Fetch error with its code and message; a 5xx is retried" {
  let calls = Mutex[Int].new(0)
  os.net.handle("GET http://169.254.170.23/v1/credentials", fn(req: http.Request) -> http.Response {
    let n = calls.with(fn(var n: Int) -> Int { n += 1; n })
    if n == 1 {
      return http.text(503, "busy")
    }
    http.text(403, "{\"code\":\"AccessDenied\",\"message\":\"bad token\"}").with_header("Content-Type", "application/json")
  })
  match provider(os.net, os.clock, Options{uri: "http://169.254.170.23/v1/credentials"}).retrieve() {
    Err(aws.CredentialsErr.Fetch(m)) => expect(m) == "container credentials: HTTP 403: AccessDenied bad token"
    other => expect("${other:?}") == "Fetch"
  }
  expect(calls.with_read(fn(n: Int) -> Int { n })) == 2
}

test "full URIs: https anywhere, http only to loopback and the agents" {
  expect(allowed_uri("https://example.com/creds").is_ok()) == true
  expect(allowed_uri("http://127.0.0.1:8080/creds").is_ok()) == true
  expect(allowed_uri("http://localhost/creds").is_ok()) == true
  expect(allowed_uri("http://169.254.170.23/v1/credentials").is_ok()) == true
  expect(allowed_uri("http://[fd00:ec2::23]/v1/credentials").is_ok()) == true
  expect(allowed_uri("http://[::1]:9000/").is_ok()) == true
  expect(allowed_uri("http://example.com/creds").is_ok()) == false
  expect(allowed_uri("http://10.0.0.5/creds").is_ok()) == false
  expect(allowed_uri("ftp://127.0.0.1/creds").is_ok()) == false
}
