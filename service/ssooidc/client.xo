/// Creates and returns access and refresh tokens for clients that are
/// authenticated using client secrets. The access token can be used to
/// fetch short-lived credentials for the assigned AWS accounts or to access
/// application APIs using bearer authentication.
pub fn (c: Client) create_token(input: CreateTokenRequest) -> CreateTokenResponse ! CreateTokenErr uses (net.dial, clock, rand) {
  let (ep, routed, extra) = c.route(endpoint_params_create_token(c.params, input)) ?? e => return Err(CreateTokenErr.InvalidInput(e))
  let signing = routed with {auth: transport.Auth.None}
  var req = serialize_create_token(ep, input, "") ?? e => return Err(CreateTokenErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(CreateTokenErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_create_token_error(resp))
  }
  deserialize_create_token(resp) ?? e => Err(CreateTokenErr.Deserialize(e))
}

