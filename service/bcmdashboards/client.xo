fn json_of_query_parameters(v: QueryParameters) -> json.Value {
  match v {
    CostAndUsage(x) => json.Value.Object([("costAndUsage", json_of_cost_and_usage_query(x))])
    SavingsPlansCoverage(x) => json.Value.Object([("savingsPlansCoverage", json_of_savings_plans_coverage_query(x))])
    SavingsPlansUtilization(x) => json.Value.Object([("savingsPlansUtilization", json_of_savings_plans_utilization_query(x))])
    ReservationCoverage(x) => json.Value.Object([("reservationCoverage", json_of_reservation_coverage_query(x))])
    ReservationUtilization(x) => json.Value.Object([("reservationUtilization", json_of_reservation_utilization_query(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_query_parameters(v: json.Value) -> QueryParameters ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "costAndUsage" => Ok(QueryParameters.CostAndUsage(from_json_cost_and_usage_query(fv)?))
      "savingsPlansCoverage" => Ok(QueryParameters.SavingsPlansCoverage(from_json_savings_plans_coverage_query(fv)?))
      "savingsPlansUtilization" => Ok(QueryParameters.SavingsPlansUtilization(from_json_savings_plans_utilization_query(fv)?))
      "reservationCoverage" => Ok(QueryParameters.ReservationCoverage(from_json_reservation_coverage_query(fv)?))
      "reservationUtilization" => Ok(QueryParameters.ReservationUtilization(from_json_reservation_utilization_query(fv)?))
      _ => Ok(QueryParameters.Unknown(k))
    }
  }
  Err("QueryParameters: no member set")
}

