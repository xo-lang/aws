/// The HTTP request of PostText.
pub fn serialize_post_text(ep: rest.Endpoint, input: PostTextRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_bot_name = match input.bot_name {
    Some(v) => v
    None => return Err("input member botName is required")
  }
  if label_bot_name == "" {
    return Err("input member botName must not be empty")
  }
  let label_bot_alias = match input.bot_alias {
    Some(v) => v
    None => return Err("input member botAlias is required")
  }
  if label_bot_alias == "" {
    return Err("input member botAlias must not be empty")
  }
  let label_user_id = match input.user_id {
    Some(v) => v
    None => return Err("input member userId is required")
  }
  if label_user_id == "" {
    return Err("input member userId must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.session_attributes {
    fs.push(("sessionAttributes", json_of_string_map(x)))
  }
  if let Some(x) = input.request_attributes {
    fs.push(("requestAttributes", json_of_string_map(x)))
  }
  if let Some(x) = input.input_text {
    fs.push(("inputText", json.Value.Str(x)))
  }
  if let Some(x) = input.active_contexts {
    fs.push(("activeContexts", json_of_active_contexts_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/bot/${rest.escape(label_bot_name, false)}/alias/${rest.escape(label_bot_alias, false)}/user/${rest.escape(label_user_id, false)}/text"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_post_text(resp: http.Response) -> PostTextResponse ! Str {
  var out = PostTextResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "intentName" => out.intent_name = jsonv.read_str(fv)?
      "nluIntentConfidence" => out.nlu_intent_confidence = from_json_intent_confidence(fv)?
      "alternativeIntents" => out.alternative_intents = from_json_intent_list(fv)?
      "slots" => out.slots = from_json_string_map(fv)?
      "sessionAttributes" => out.session_attributes = from_json_string_map(fv)?
      "message" => out.message = jsonv.read_str(fv)?
      "sentimentResponse" => out.sentiment_response = from_json_sentiment_response(fv)?
      "messageFormat" => out.message_format = MessageFormatType.from(jsonv.read_str(fv)?)
      "dialogState" => out.dialog_state = DialogState.from(jsonv.read_str(fv)?)
      "slotToElicit" => out.slot_to_elicit = jsonv.read_str(fv)?
      "responseCard" => out.response_card = from_json_response_card(fv)?
      "sessionId" => out.session_id = jsonv.read_str(fv)?
      "botVersion" => out.bot_version = jsonv.read_str(fv)?
      "activeContexts" => out.active_contexts = from_json_active_contexts_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

