  /// The name of the vehicle middleware.
  pub name: Str? = None
  /// The protocol name of the vehicle middleware.
  pub protocol_name: VehicleMiddlewareProtocol? = None
}

pub enum VehicleMiddlewareProtocol: Str {
  Ros2 = "ROS_2"
  Unknown(value: Str)
}

pub enum VehicleState: Str {
  Created = "CREATED"
  Ready = "READY"
  Healthy = "HEALTHY"
  Suspended = "SUSPENDED"
  Deleting = "DELETING"
  ReadyForCheckin = "READY_FOR_CHECKIN"
  Unknown(value: Str)
}

/// Information about a campaign associated with a vehicle.
pub struct VehicleStatus {
  /// The name of a campaign.
  pub campaign_name: Str? = None
  /// The unique ID of the vehicle.
  pub vehicle_name: Str? = None
  /// The status of a campaign, which can be one of the following: CREATED -
  /// The campaign exists but is not yet approved. READY - The campaign is
  /// approved but has not been deployed to the vehicle. Data has not arrived
  /// at the vehicle yet. HEALTHY - The campaign is deployed to the vehicle.
  /// SUSPENDED - The campaign is suspended and data collection is paused.
  /// DELETING - The campaign is being removed from the vehicle.
  /// READY_FOR_CHECKIN - The campaign is approved and waiting for vehicle
  /// check-in before deployment.
  pub status: VehicleState? = None
}

/// Information about a vehicle. To return this information about vehicles
/// in your account, you can use the API operation.
pub struct VehicleSummary {
  /// The unique ID of the vehicle.
  pub vehicle_name: Str? = None
  /// The Amazon Resource Name (ARN) of the vehicle.
  pub arn: Str? = None
  /// The ARN of a vehicle model (model manifest) associated with the vehicle.
  pub model_manifest_arn: Str? = None
  /// The ARN of a decoder manifest associated with the vehicle.
  pub decoder_manifest_arn: Str? = None
  /// The time the vehicle was created in seconds since epoch (January 1, 1970
  /// at midnight UTC time).
  pub creation_time: Time? = None
  /// The time the vehicle was last updated in seconds since epoch (January 1,
  /// 1970 at midnight UTC time).
  pub last_modification_time: Time? = None
  /// Static information about a vehicle in a key-value pair. For example:
  /// "engineType" : "1.3 L R2"
  pub attributes: Map[Str, Str]? = None
}
