/// The errors of GetPreferences.
pub enum GetPreferencesErr {
  AccessDeniedException(e: AccessDeniedException)
  InternalServerException(e: InternalServerException)
  ThrottlingException(e: ThrottlingException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: GetPreferencesErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_get_preferences_error(resp: http.Response) -> GetPreferencesErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return GetPreferencesErr.AccessDeniedException(x)
      Err(msg) => return GetPreferencesErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return GetPreferencesErr.InternalServerException(x)
      Err(msg) => return GetPreferencesErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return GetPreferencesErr.ThrottlingException(x)
      Err(msg) => return GetPreferencesErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return GetPreferencesErr.ValidationException(x)
      Err(msg) => return GetPreferencesErr.Deserialize(msg)
    }
    _ => {}
  }
  GetPreferencesErr.Api(restjson.api_error(resp, body))
}

/// Returns a set of preferences for an account in order to add
/// account-specific preferences into the service. These preferences impact
/// how the savings associated with recommendations are
/// presented—estimated savings after discounts or estimated savings
/// before discounts, for example.
pub fn (c: Client) get_preferences(input: GetPreferencesRequest) -> GetPreferencesResponse ! GetPreferencesErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_get_preferences(c.params, input)) ?? e => return Err(GetPreferencesErr.InvalidInput(e))
  var req = serialize_get_preferences(ep, input, "") ?? e => return Err(GetPreferencesErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(GetPreferencesErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_get_preferences_error(resp))
  }
  deserialize_get_preferences(resp) ?? e => Err(GetPreferencesErr.Deserialize(e))
}

