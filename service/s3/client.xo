fn xml_write_delete_marker_entry(var w: xmlv.Writer, v: DeleteMarkerEntry, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.owner {
    xml_write_owner(w, x, "Owner", [])
  }
  if let Some(x) = v.key {
    xmlv.elem(w, "Key", x, [])
  }
  if let Some(x) = v.version_id {
    xmlv.elem(w, "VersionId", x, [])
  }
  if let Some(x) = v.is_latest {
    xmlv.elem(w, "IsLatest", "${x}", [])
  }
  if let Some(x) = v.last_modified {
    xmlv.elem(w, "LastModified", rest.date_time(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_delete_marker_entry(e: xml.Element) -> DeleteMarkerEntry ! Str {
  var out = DeleteMarkerEntry{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Owner" => out.owner = xml_read_owner(c)?
      "Key" => out.key = c.text()
      "VersionId" => out.version_id = c.text()
      "IsLatest" => out.is_latest = xmlv.read_bool(c.text())?
      "LastModified" => out.last_modified = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

