/// object. If not specified, the default object will be created.
pub enum ContainerType: Str {
  F4V = "F4V"
  Gif = "GIF"
  Ismv = "ISMV"
  M2Ts = "M2TS"
  M3U8 = "M3U8"
  Cmfc = "CMFC"
  Mov = "MOV"
  Mp4 = "MP4"
  Mpd = "MPD"
  Mxf = "MXF"
  Ogg = "OGG"
  Webm = "WEBM"
