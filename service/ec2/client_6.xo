fn xml_write_reserved_instances(var w: xmlv.Writer, v: ReservedInstances, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.currency_code {
    xmlv.elem(w, "currencyCode", x.value(), [])
  }
  if let Some(x) = v.instance_tenancy {
    xmlv.elem(w, "instanceTenancy", x.value(), [])
  }
  if let Some(x) = v.offering_class {
    xmlv.elem(w, "offeringClass", x.value(), [])
  }
  if let Some(x) = v.offering_type {
    xmlv.elem(w, "offeringType", x.value(), [])
  }
  if let Some(x) = v.recurring_charges {
    xml_write_recurring_charges_list(w, x, "recurringCharges", [])
  }
  if let Some(x) = v.scope {
    xmlv.elem(w, "scope", x.value(), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.availability_zone_id {
    xmlv.elem(w, "availabilityZoneId", x, [])
  }
  if let Some(x) = v.reserved_instances_id {
    xmlv.elem(w, "reservedInstancesId", x, [])
  }
  if let Some(x) = v.instance_type {
    xmlv.elem(w, "instanceType", x.value(), [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.start {
    xmlv.elem(w, "start", rest.date_time(x), [])
  }
  if let Some(x) = v.end {
    xmlv.elem(w, "end", rest.date_time(x), [])
  }
  if let Some(x) = v.duration {
    xmlv.elem(w, "duration", "${x}", [])
  }
  if let Some(x) = v.usage_price {
    xmlv.elem(w, "usagePrice", rest.float_text(x), [])
  }
  if let Some(x) = v.fixed_price {
    xmlv.elem(w, "fixedPrice", rest.float_text(x), [])
  }
  if let Some(x) = v.instance_count {
    xmlv.elem(w, "instanceCount", "${x}", [])
  }
  if let Some(x) = v.product_description {
    xmlv.elem(w, "productDescription", x.value(), [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_reserved_instances(e: xml.Element) -> ReservedInstances ! Str {
  var out = ReservedInstances{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "currencyCode" => out.currency_code = CurrencyCodeValues.from(c.text())
      "instanceTenancy" => out.instance_tenancy = Tenancy.from(c.text())
      "offeringClass" => out.offering_class = OfferingClassType.from(c.text())
      "offeringType" => out.offering_type = OfferingTypeValues.from(c.text())
      "recurringCharges" => out.recurring_charges = xml_read_recurring_charges_list(c)?
      "scope" => out.scope = Scope.from(c.text())
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "availabilityZoneId" => out.availability_zone_id = c.text()
      "reservedInstancesId" => out.reserved_instances_id = c.text()
      "instanceType" => out.instance_type = InstanceType.from(c.text())
      "availabilityZone" => out.availability_zone = c.text()
      "start" => out.start = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "end" => out.end = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "duration" => out.duration = xmlv.read_int(c.text())?
      "usagePrice" => out.usage_price = xmlv.read_float(c.text())?
      "fixedPrice" => out.fixed_price = xmlv.read_float(c.text())?
      "instanceCount" => out.instance_count = xmlv.read_int(c.text())?
      "productDescription" => out.product_description = RIProductDescription.from(c.text())
      "state" => out.state = ReservedInstanceState.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

