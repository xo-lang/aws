fn json_of_system_event_metadata(v: SystemEventMetadata) -> json.Value {
  match v {
    SystemCreated(x) => json.Value.Object([("systemCreated", json_of_system_created_metadata(x))])
    SystemDeleted(x) => json.Value.Object([("systemDeleted", json_of_system_deleted_metadata(x))])
    SystemUserJourneyCreated(x) => json.Value.Object([("systemUserJourneyCreated", json_of_system_user_journey_created_metadata(x))])
    SystemUserJourneyUpdated(x) => json.Value.Object([("systemUserJourneyUpdated", json_of_system_user_journey_updated_metadata(x))])
    SystemUserJourneyDeleted(x) => json.Value.Object([("systemUserJourneyDeleted", json_of_system_user_journey_deleted_metadata(x))])
    SystemServiceAssociated(x) => json.Value.Object([("systemServiceAssociated", json_of_system_service_associated_metadata(x))])
    SystemServiceDisassociated(x) => json.Value.Object([("systemServiceDisassociated", json_of_system_service_disassociated_metadata(x))])
    SystemPolicyAssociated(x) => json.Value.Object([("systemPolicyAssociated", json_of_system_policy_associated_metadata(x))])
    SystemPolicyDisassociated(x) => json.Value.Object([("systemPolicyDisassociated", json_of_system_policy_disassociated_metadata(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_system_event_metadata(v: json.Value) -> SystemEventMetadata ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "systemCreated" => Ok(SystemEventMetadata.SystemCreated(from_json_system_created_metadata(fv)?))
      "systemDeleted" => Ok(SystemEventMetadata.SystemDeleted(from_json_system_deleted_metadata(fv)?))
      "systemUserJourneyCreated" => Ok(SystemEventMetadata.SystemUserJourneyCreated(from_json_system_user_journey_created_metadata(fv)?))
      "systemUserJourneyUpdated" => Ok(SystemEventMetadata.SystemUserJourneyUpdated(from_json_system_user_journey_updated_metadata(fv)?))
      "systemUserJourneyDeleted" => Ok(SystemEventMetadata.SystemUserJourneyDeleted(from_json_system_user_journey_deleted_metadata(fv)?))
      "systemServiceAssociated" => Ok(SystemEventMetadata.SystemServiceAssociated(from_json_system_service_associated_metadata(fv)?))
      "systemServiceDisassociated" => Ok(SystemEventMetadata.SystemServiceDisassociated(from_json_system_service_disassociated_metadata(fv)?))
      "systemPolicyAssociated" => Ok(SystemEventMetadata.SystemPolicyAssociated(from_json_system_policy_associated_metadata(fv)?))
      "systemPolicyDisassociated" => Ok(SystemEventMetadata.SystemPolicyDisassociated(from_json_system_policy_disassociated_metadata(fv)?))
      _ => Ok(SystemEventMetadata.Unknown(k))
    }
  }
  Err("SystemEventMetadata: no member set")
}

