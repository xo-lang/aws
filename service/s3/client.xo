  if let Some(x) = v.version_id {
    xmlv.elem(w, "VersionId", x, [])
  }
  if let Some(x) = v.sse_customer_algorithm {
    xmlv.elem(w, "SSECustomerAlgorithm", x, [])
  }
  if let Some(x) = v.sse_customer_key {
    xmlv.elem(w, "SSECustomerKey", x, [])
  }
  if let Some(x) = v.sse_customer_key_md5 {
    xmlv.elem(w, "SSECustomerKeyMD5", x, [])
  }
  if let Some(x) = v.request_payer {
    xmlv.elem(w, "RequestPayer", x.value(), [])
  }
  if let Some(x) = v.part_number {
    xmlv.elem(w, "PartNumber", "${x}", [])
  }
  if let Some(x) = v.expected_bucket_owner {
    xmlv.elem(w, "ExpectedBucketOwner", x, [])
  }
  if let Some(x) = v.checksum_mode {
    xmlv.elem(w, "ChecksumMode", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_head_object_request(e: xml.Element) -> HeadObjectRequest ! Str {
  var out = HeadObjectRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Bucket" => out.bucket = c.text()
      "IfMatch" => out.if_match = c.text()
      "IfModifiedSince" => out.if_modified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "IfNoneMatch" => out.if_none_match = c.text()
      "IfUnmodifiedSince" => out.if_unmodified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Key" => out.key = c.text()
      "Range" => out.range = c.text()
      "ResponseCacheControl" => out.response_cache_control = c.text()
      "ResponseContentDisposition" => out.response_content_disposition = c.text()
      "ResponseContentEncoding" => out.response_content_encoding = c.text()
      "ResponseContentLanguage" => out.response_content_language = c.text()
      "ResponseContentType" => out.response_content_type = c.text()
      "ResponseExpires" => out.response_expires = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      "VersionId" => out.version_id = c.text()
      "SSECustomerAlgorithm" => out.sse_customer_algorithm = c.text()
      "SSECustomerKey" => out.sse_customer_key = c.text()
      "SSECustomerKeyMD5" => out.sse_customer_key_md5 = c.text()
      "RequestPayer" => out.request_payer = RequestPayer.from(c.text())
      "PartNumber" => out.part_number = xmlv.read_int(c.text())?
      "ExpectedBucketOwner" => out.expected_bucket_owner = c.text()
      "ChecksumMode" => out.checksum_mode = ChecksumMode.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

