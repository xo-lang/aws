    ListContains(x) => json.Value.Object([("listContains", json_of_filter_attribute(x))])
    StringContains(x) => json.Value.Object([("stringContains", json_of_filter_attribute(x))])
    AndAll(x) => json.Value.Object([("andAll", json_of_retrieval_filter_list(x))])
    OrAll(x) => json.Value.Object([("orAll", json_of_retrieval_filter_list(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_retrieval_filter(v: json.Value) -> RetrievalFilter ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "equals" => Ok(RetrievalFilter.Equals(from_json_filter_attribute(fv)?))
      "notEquals" => Ok(RetrievalFilter.NotEquals(from_json_filter_attribute(fv)?))
      "greaterThan" => Ok(RetrievalFilter.GreaterThan(from_json_filter_attribute(fv)?))
      "greaterThanOrEquals" => Ok(RetrievalFilter.GreaterThanOrEquals(from_json_filter_attribute(fv)?))
      "lessThan" => Ok(RetrievalFilter.LessThan(from_json_filter_attribute(fv)?))
      "lessThanOrEquals" => Ok(RetrievalFilter.LessThanOrEquals(from_json_filter_attribute(fv)?))
      "in" => Ok(RetrievalFilter.In(from_json_filter_attribute(fv)?))
      "notIn" => Ok(RetrievalFilter.NotIn(from_json_filter_attribute(fv)?))
      "startsWith" => Ok(RetrievalFilter.StartsWith(from_json_filter_attribute(fv)?))
      "listContains" => Ok(RetrievalFilter.ListContains(from_json_filter_attribute(fv)?))
      "stringContains" => Ok(RetrievalFilter.StringContains(from_json_filter_attribute(fv)?))
      "andAll" => Ok(RetrievalFilter.AndAll(from_json_retrieval_filter_list(fv)?))
      "orAll" => Ok(RetrievalFilter.OrAll(from_json_retrieval_filter_list(fv)?))
      _ => Ok(RetrievalFilter.Unknown(k))
    }
  }
  Err("RetrievalFilter: no member set")
}

fn json_of_retrieval_filter_list(v: List[RetrievalFilter]) -> json.Value {
  json.Value.List(v.map(fn(x: RetrievalFilter) -> json.Value { json_of_retrieval_filter(x) }))
}

fn from_json_retrieval_filter_list(v: json.Value) -> List[RetrievalFilter] ! Str {
  var out: List[RetrievalFilter] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_retrieval_filter(fv)?)
  }
  Ok(out)
}

