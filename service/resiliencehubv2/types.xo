}

pub struct UpdateSystemResponse {
  /// The updated system.
  pub system: System? = None
}

pub struct UpdateTestRequest {
  /// The identifier of the test to update.
  pub test_id: Str? = None
  /// The ARN of the service the test belongs to.
  pub service_arn: Str? = None
  /// The updated logging configuration for the test.
  pub logging_configuration: LoggingConfiguration? = None
  /// The updated stop conditions for the test.
  pub stop_conditions: List[StopCondition]? = None
  /// The updated IAM execution role name.
  pub role_name: Str? = None
  /// The updated parameter values for the test.
  pub parameters: Map[Str, List[Str]]? = None
}

pub struct UpdateTestResponse {
  /// The updated test.
  pub test_value: Test? = None
}

pub struct UpdateUserJourneyRequest {
  pub system_arn: Str? = None
  /// The identifier of the user journey to update.
  pub user_journey_id: Str? = None
  pub name: Str? = None
  pub description: Str? = None
  pub policy_arn: Str? = None
}

pub struct UpdateUserJourneyResponse {
  /// The updated user journey.
  pub user_journey: UserJourney? = None
}

/// Represents a user journey that defines a critical path through a system.
pub struct UserJourney {
  /// The unique identifier of the user journey.
  pub user_journey_id: Str? = None
  pub name: Str? = None
  pub description: Str? = None
  pub policy_arn: Str? = None
  /// The timestamp when the user journey was created.
  pub created_at: Time? = None
  /// The timestamp when the user journey was last updated.
  pub updated_at: Time? = None
}

/// Describes changes made to a user journey.
pub struct UserJourneyChanges {
  /// Changes to the user journey description.
  pub journey_description: StringChange? = None
  /// Changes to the services associated with the user journey.
  pub associated_services: ServiceReferenceChanges? = None
}

/// Contains summary information about a user journey.
pub struct UserJourneySummary {
  /// The unique identifier of the user journey.
  pub user_journey_id: Str? = None
  pub name: Str? = None
  /// The timestamp when the user journey was created.
  pub created_at: Time? = None
  /// The timestamp when the user journey was last updated.
  pub updated_at: Time? = None
}

/// Validation error — invalid input parameters.
pub struct ValidationException {
  pub message: Str? = None
  /// The reason for the validation failure.
  pub reason: ValidationExceptionReason? = None
  /// The list of fields that failed validation.
  pub field_list: List[ValidationExceptionField]? = None
}

/// Describes a field that failed validation.
pub struct ValidationExceptionField {
  /// The name of the field that failed validation.
  pub name: Str? = None
  /// The validation error message for the field.
  pub message: Str? = None
}

pub enum ValidationExceptionReason: Str {
  InvalidFieldValue = "INVALID_FIELD_VALUE"
  DuplicateValue = "DUPLICATE_VALUE"
  MissingRequiredField = "MISSING_REQUIRED_FIELD"
  Other = "OTHER"
  Unknown(value: Str)
}
