    match c.name.local {
      "StackId" => out.stack_id = c.text()
      "StackName" => out.stack_name = c.text()
      "ChangeSetId" => out.change_set_id = c.text()
      "Description" => out.description = c.text()
      "Parameters" => out.parameters = xml_read_parameters(c)?
      "CreationTime" => out.creation_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DeletionTime" => out.deletion_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "LastUpdatedTime" => out.last_updated_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "RollbackConfiguration" => out.rollback_configuration = xml_read_rollback_configuration(c)?
      "StackStatus" => out.stack_status = StackStatus.from(c.text())
      "StackStatusReason" => out.stack_status_reason = c.text()
      "DisableRollback" => out.disable_rollback = xmlv.read_bool(c.text())?
      "DeploymentConfig" => out.deployment_config = xml_read_deployment_config(c)?
      "NotificationARNs" => out.notification_arns = xml_read_notification_arns(c)?
      "TimeoutInMinutes" => out.timeout_in_minutes = xmlv.read_int(c.text())?
      "Capabilities" => out.capabilities = xml_read_capabilities(c)?
      "Outputs" => out.outputs = xml_read_outputs(c)?
      "RoleARN" => out.role_arn = c.text()
      "Tags" => out.tags = xml_read_tags(c)?
      "EnableTerminationProtection" => out.enable_termination_protection = xmlv.read_bool(c.text())?
      "ParentId" => out.parent_id = c.text()
      "RootId" => out.root_id = c.text()
      "DriftInformation" => out.drift_information = xml_read_stack_drift_information(c)?
      "RetainExceptOnCreate" => out.retain_except_on_create = xmlv.read_bool(c.text())?
      "DeletionMode" => out.deletion_mode = DeletionMode.from(c.text())
      "DetailedStatus" => out.detailed_status = DetailedStatus.from(c.text())
      "LastOperations" => out.last_operations = xml_read_last_operations(c)?
      _ => {}
    }
  }
  Ok(out)
}

