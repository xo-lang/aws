/// Provides information that describes a serverless replication created by
/// the CreateReplication operation.
pub struct Replication {
  /// The identifier for the ReplicationConfig associated with the
  /// replication.
  pub replication_config_identifier: Str? = None
  /// The Amazon Resource Name for the ReplicationConfig associated with the
  /// replication.
  pub replication_config_arn: Str? = None
  /// The Amazon Resource Name for an existing Endpoint the serverless
  /// replication uses for its data source.
  pub source_endpoint_arn: Str? = None
  /// The Amazon Resource Name for an existing Endpoint the serverless
  /// replication uses for its data target.
  pub target_endpoint_arn: Str? = None
  /// The type of the serverless replication.
  pub replication_type: MigrationTypeValue? = None
  /// The current status of the serverless replication.
  pub status: Str? = None
  /// Information about provisioning resources for an DMS serverless
  /// replication.
  pub provision_data: ProvisionData? = None
  /// The status output of premigration assessment in describe-replications.
  pub premigration_assessment_statuses: List[PremigrationAssessmentStatus]? = None
  /// The reason the replication task was stopped. This response parameter can
  /// return one of the following values: "Stop Reason NORMAL" "Stop Reason
  /// RECOVERABLE_ERROR" "Stop Reason FATAL_ERROR" "Stop Reason
  /// FULL_LOAD_ONLY_FINISHED" "Stop Reason STOPPED_AFTER_FULL_LOAD" – Full
  /// load completed, with cached changes not applied "Stop Reason
  /// STOPPED_AFTER_CACHED_EVENTS" – Full load completed, with cached
  /// changes applied "Stop Reason EXPRESS_LICENSE_LIMITS_REACHED" "Stop
  /// Reason STOPPED_AFTER_DDL_APPLY" – User-defined stop task after DDL
  /// applied "Stop Reason STOPPED_DUE_TO_LOW_MEMORY" "Stop Reason
  /// STOPPED_DUE_TO_LOW_DISK" "Stop Reason STOPPED_AT_SERVER_TIME" –
  /// User-defined server time for stopping task "Stop Reason
  /// STOPPED_AT_COMMIT_TIME" – User-defined commit time for stopping task
  /// "Stop Reason RECONFIGURATION_RESTART" "Stop Reason RECYCLE_TASK"
  pub stop_reason: Str? = None
  /// Error and other information about why a serverless replication failed.
  pub failure_messages: List[Str]? = None
  /// This object provides a collection of statistics about a serverless
  /// replication.
  pub replication_stats: ReplicationStats? = None
  /// The type of replication to start.
  pub start_replication_type: Str? = None
  /// Indicates the start time for a change data capture (CDC) operation. Use
  /// either CdcStartTime or CdcStartPosition to specify when you want a CDC
  /// operation to start. Specifying both values results in an error.
  pub cdc_start_time: Time? = None
  /// Indicates the start time for a change data capture (CDC) operation. Use
  /// either CdcStartTime or CdcStartPosition to specify when you want a CDC
  /// operation to start. Specifying both values results in an error.
  pub cdc_start_position: Str? = None
  /// Indicates when you want a change data capture (CDC) operation to stop.
  /// The value can be either server time or commit time.
  pub cdc_stop_position: Str? = None
  /// Indicates the last checkpoint that occurred during a change data capture
  /// (CDC) operation. You can provide this value to the CdcStartPosition
  /// parameter to start a CDC operation that begins at that checkpoint.
  pub recovery_checkpoint: Str? = None
  /// The time the serverless replication was created.
  pub replication_create_time: Time? = None
  /// The time the serverless replication was updated.
  pub replication_update_time: Time? = None
  /// The timestamp when replication was last stopped.
  pub replication_last_stop_time: Time? = None
  /// The timestamp when DMS will deprovision the replication.
  pub replication_deprovision_time: Time? = None
  /// Indicates whether the serverless replication is read-only. When set to
  /// true , this replication is managed by DMS as part of a zero-ETL
  /// integration and cannot be modified or deleted directly. You can only
  /// modify or delete read-only replications through their associated
  /// zero-ETL integration.
  pub is_read_only: Bool? = None
}

/// This object provides configuration information about a serverless
/// replication.
pub struct ReplicationConfig {
  /// The identifier for the ReplicationConfig associated with the
  /// replication.
  pub replication_config_identifier: Str? = None
  /// The Amazon Resource Name (ARN) of this DMS Serverless replication
  /// configuration.
  pub replication_config_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the source endpoint for this DMS
  /// serverless replication configuration.
  pub source_endpoint_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the target endpoint for this DMS
  /// serverless replication configuration.
  pub target_endpoint_arn: Str? = None
  /// The type of the replication.
  pub replication_type: MigrationTypeValue? = None
  /// Configuration parameters for provisioning an DMS serverless replication.
  pub compute_config: ComputeConfig? = None
  /// Configuration parameters for an DMS serverless replication.
  pub replication_settings: Str? = None
  /// Additional parameters for an DMS serverless replication.
  pub supplemental_settings: Str? = None
  /// Table mappings specified in the replication.
  pub table_mappings: Str? = None
  /// The time the serverless replication config was created.
  pub replication_config_create_time: Time? = None
  /// The time the serverless replication config was updated.
  pub replication_config_update_time: Time? = None
  /// Indicates whether the replication configuration is read-only. When set
  /// to true , this replication configuration is managed by DMS as part of a
  /// zero-ETL integration and cannot be modified or deleted directly. You can
  /// only modify or delete read-only replication configurations through their
  /// associated zero-ETL integration.
  pub is_read_only: Bool? = None
}

pub enum ReplicationEndpointTypeValue: Str {
  Source = "source"
  Target = "target"
  Unknown(value: Str)
}

/// Provides information that defines a replication instance.
pub struct ReplicationInstance {
  /// The replication instance identifier is a required parameter. This
  /// parameter is stored as a lowercase string. Constraints: Must contain
  /// 1-63 alphanumeric characters or hyphens. First character must be a
  /// letter. Cannot end with a hyphen or contain two consecutive hyphens.
  /// Example: myrepinstance
  pub replication_instance_identifier: Str? = None
  /// The compute and memory capacity of the replication instance as defined
  /// for the specified replication instance class. It is a required
  /// parameter, although a default value is pre-selected in the DMS console.
  /// For more information on the settings and capacities for the available
  /// replication instance classes, see Selecting the right DMS replication
  /// instance for your migration .
  pub replication_instance_class: Str? = None
  /// The status of the replication instance. The possible return values
  /// include: "available" "creating" "deleted" "deleting" "failed"
  /// "modifying" "upgrading" "rebooting" "resetting-master-credentials"
  /// "storage-full" "incompatible-credentials" "incompatible-network"
  /// "maintenance"
  pub replication_instance_status: Str? = None
  /// The amount of storage (in gigabytes) that is allocated for the
  /// replication instance.
  pub allocated_storage: Int? = None
  /// The time the replication instance was created.
  pub instance_create_time: Time? = None
  /// The VPC security group for the instance.
  pub vpc_security_groups: List[VpcSecurityGroupMembership]? = None
  /// The Availability Zone for the instance.
  pub availability_zone: Str? = None
  /// The subnet group for the replication instance.
  pub replication_subnet_group: ReplicationSubnetGroup? = None
  /// The maintenance window times for the replication instance. Any pending
  /// upgrades to the replication instance are performed during this time.
  pub preferred_maintenance_window: Str? = None
  /// The pending modification values.
  pub pending_modified_values: ReplicationPendingModifiedValues? = None
  /// Specifies whether the replication instance is a Multi-AZ deployment. You
  /// can't set the AvailabilityZone parameter if the Multi-AZ parameter is
  /// set to true .
  pub multi_az: Bool? = None
  /// The engine version number of the replication instance. If an engine
  /// version number is not specified when a replication instance is created,
  /// the default is the latest engine version available. When modifying a
  /// major engine version of an instance, also set AllowMajorVersionUpgrade
  /// to true .
  pub engine_version: Str? = None
  /// Boolean value indicating if minor version upgrades will be automatically
  /// applied to the instance.
  pub auto_minor_version_upgrade: Bool? = None
  /// An KMS key identifier that is used to encrypt the data on the
  /// replication instance. If you don't specify a value for the KmsKeyId
  /// parameter, then DMS uses your default encryption key. KMS creates the
  /// default encryption key for your Amazon Web Services account. Your Amazon
  /// Web Services account has a different default encryption key for each
  /// Amazon Web Services Region.
  pub kms_key_id: Str? = None
  /// The Amazon Resource Name (ARN) of the replication instance.
  pub replication_instance_arn: Str? = None
  /// The public IP address of the replication instance.
  pub replication_instance_public_ip_address: Str? = None
  /// The private IP address of the replication instance.
  pub replication_instance_private_ip_address: Str? = None
  /// One or more public IP addresses for the replication instance.
  pub replication_instance_public_ip_addresses: List[Str]? = None
  /// One or more private IP addresses for the replication instance.
  pub replication_instance_private_ip_addresses: List[Str]? = None
  /// One or more IPv6 addresses for the replication instance.
  pub replication_instance_ipv6_addresses: List[Str]? = None
  /// Specifies the accessibility options for the replication instance. A
  /// value of true represents an instance with a public IP address. A value
  /// of false represents an instance with a private IP address. The default
  /// value is true .
  pub publicly_accessible: Bool? = None
  /// The Availability Zone of the standby replication instance in a Multi-AZ
  /// deployment.
  pub secondary_availability_zone: Str? = None
  /// The expiration date of the free replication instance that is part of the
  /// Free DMS program.
  pub free_until: Time? = None
  /// The DNS name servers supported for the replication instance to access
  /// your on-premise source or target database.
  pub dns_name_servers: Str? = None
  /// The type of IP address protocol used by a replication instance, such as
  /// IPv4 only or Dual-stack that supports both IPv4 and IPv6 addressing.
  /// IPv6 only is not yet supported.
  pub network_type: Str? = None
  /// Specifies the settings required for kerberos authentication when
  /// replicating an instance.
  pub kerberos_authentication_settings: KerberosAuthenticationSettings? = None
}

