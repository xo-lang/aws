  /// Create actions in the ReplicaUpdates action list. You can specify one of
  /// the following consistency modes: EVENTUAL : Configures a new global
  /// table for multi-Region eventual consistency (MREC). This is the default
  /// consistency mode for global tables. STRONG : Configures a new global
  /// table for multi-Region strong consistency (MRSC). If you don't specify
  /// this field, the global table consistency mode defaults to EVENTUAL . For
  /// more information about global tables consistency modes, see Consistency
  /// modes in DynamoDB developer guide.
  pub multi_region_consistency: MultiRegionConsistency? = None
  /// A list of witness updates for a MRSC global table. A witness provides a
  /// cost-effective alternative to a full replica in a MRSC global table by
  /// maintaining replicated change data written to global table replicas. You
  /// cannot perform read or write operations on a witness. For each witness,
  /// you can request one action: Create - add a new witness to the global
  /// table. Delete - remove a witness from the global table. You can create
  /// or delete only one witness per UpdateTable operation. For more
  /// information, see Multi-Region strong consistency (MRSC) in the Amazon
  /// DynamoDB Developer Guide
  pub global_table_witness_updates: List[GlobalTableWitnessGroupUpdate]? = None
  /// Updates the maximum number of read and write units for the specified
  /// table in on-demand capacity mode. If you use this parameter, you must
  /// specify MaxReadRequestUnits , MaxWriteRequestUnits , or both.
  pub on_demand_throughput: OnDemandThroughput? = None
  /// Represents the warm throughput (in read units per second and write units
  /// per second) for updating a table.
  pub warm_throughput: WarmThroughput? = None
  /// Controls the settings replication mode for a global table replica. This
  /// attribute can be defined using UpdateTable operation only on a regional
  /// table with values: ENABLED : Defines settings replication on a regional
  /// table to be used as a source table for creating Multi-Account Global
  /// Table. DISABLED : Remove settings replication on a regional table.
  /// Settings replication needs to be defined to ENABLED again in order to
  /// create a Multi-Account Global Table using this table.
  pub global_table_settings_replication_mode: GlobalTableSettingsReplicationMode? = None
  /// Specifies whether disassociation protection is enabled ( true ) or
  /// disabled ( false ) for the local replica of a multi-Region eventual
  /// consistency (MREC) global table using Version 2019.11.21. Disassociation
  /// protection is enabled by default. If you omit this parameter, the
  /// existing setting is unchanged. This setting is independent of
  /// DeletionProtectionEnabled . You can't combine this change with any other
  /// change in the same UpdateTable request.
  pub disassociation_protection_enabled: Bool? = None
  /// A list of vector indexes to be added to or removed from the table. You
  /// can add or remove one vector index for each UpdateTable operation. To
  /// add a vector index, specify IndexName , VectorAttribute , Dimensions ,
  /// DistanceFunction , and Projection . To remove a vector index, specify
  /// only the IndexName .
  pub vector_index_updates: List[VectorIndexUpdate]? = None
}

/// Represents the output of an UpdateTable operation.
pub struct UpdateTableOutput {
  /// Represents the properties of the table.
  pub table_description: TableDescription? = None
}

pub struct UpdateTableReplicaAutoScalingInput {
  /// Represents the auto scaling settings of the global secondary indexes of
  /// the replica to be updated.
  pub global_secondary_index_updates: List[GlobalSecondaryIndexAutoScalingUpdate]? = None
  /// The name of the global table to be updated. You can also provide the
  /// Amazon Resource Name (ARN) of the table in this parameter.
  pub table_name: Str? = None
  pub provisioned_write_capacity_auto_scaling_update: AutoScalingSettingsUpdate? = None
  /// Represents the auto scaling settings of replicas of the table that will
  /// be modified.
  pub replica_updates: List[ReplicaAutoScalingUpdate]? = None
}

pub struct UpdateTableReplicaAutoScalingOutput {
  /// Returns information about the auto scaling settings of a table with
  /// replicas.
  pub table_auto_scaling_description: TableAutoScalingDescription? = None
}

/// Represents the input of an UpdateTimeToLive operation.
pub struct UpdateTimeToLiveInput {
  /// The name of the table to be configured. You can also provide the Amazon
  /// Resource Name (ARN) of the table in this parameter.
  pub table_name: Str? = None
  /// Represents the settings used to enable or disable Time to Live for the
  /// specified table.
  pub time_to_live_specification: TimeToLiveSpecification? = None
}

pub struct UpdateTimeToLiveOutput {
  /// Represents the output of an UpdateTimeToLive operation.
  pub time_to_live_specification: TimeToLiveSpecification? = None
}

/// The definition of a vector attribute for a vector index.
pub struct VectorAttributeDefinition {
  /// The name of the vector attribute.
  pub attribute_name: Str? = None
}

/// The consumed capacity for vector index operations, including vector
/// search request bytes and vector write request bytes.
pub struct VectorCapacity {
  /// The number of vector search request bytes consumed by a SearchVectors
  /// operation.
  pub vector_search_request_bytes: Float? = None
  /// The number of vector write request bytes consumed when writing to a
  /// vector index. Reported for write operations that modify attributes
  /// indexed by a vector index.
  pub vector_write_request_bytes: Float? = None
}

pub enum VectorDistanceFunction: Str {
  Cosine = "COSINE"
  DotProduct = "DOT_PRODUCT"
  Euclidean = "EUCLIDEAN"
  Unknown(value: Str)
}

/// Contains the configuration settings for a vector index, including the
/// index name, vector attribute, dimensions, distance function, search
/// schema, and projection.
pub struct VectorIndex {
  /// The name of the vector index.
  pub index_name: Str? = None
  /// The vector attribute configuration for the index.
  pub vector_attribute: VectorAttributeDefinition? = None
  /// The search schema that defines partition key and inline filter
  /// attributes for the vector index.
  pub search_schema: List[SearchSchemaElement]? = None
  /// Specifies attributes that are copied (projected) from the table into the
  /// vector index.
  pub projection: Projection? = None
  /// The number of dimensions in each vector.
  pub dimensions: Int? = None
  /// The distance function used to calculate similarity between vectors.
  /// Valid values: COSINE , EUCLIDEAN , DOT_PRODUCT .
  pub distance_function: VectorDistanceFunction? = None
}

/// Contains the current state and configuration of a vector index,
/// including its status, size, item count, and the settings specified when
/// the index was created.
pub struct VectorIndexDescription {
  /// The name of the vector index.
  pub index_name: Str? = None
  /// The search schema that defines partition key and inline filter
  /// attributes for the vector index.
  pub search_schema: List[SearchSchemaElement]? = None
  /// Specifies attributes that are copied (projected) from the table into the
  /// vector index.
  pub projection: Projection? = None
  /// The vector attribute configuration for the index.
  pub vector_attribute: VectorAttributeDefinition? = None
  /// The number of dimensions in each vector.
  pub dimensions: Int? = None
  /// The distance function used to calculate similarity between vectors.
  pub distance_function: VectorDistanceFunction? = None
  /// The current state of the vector index: CREATING - The index is being
  /// created. ACTIVE - The index is ready for use. DELETING - The index is
  /// being deleted.
  pub index_status: IndexStatus? = None
  /// Specifies whether the index is currently backfilling. During backfill,
  /// SearchVectors operations might return incomplete results.
  pub backfilling: Bool? = None
  /// The total size of the vector index, in bytes. Amazon DynamoDB updates
  /// this value approximately every six hours. Recent changes might not be
  /// reflected in this value.
  pub index_size_bytes: Int? = None
  /// The number of items indexed in the vector index. Amazon DynamoDB updates
  /// this value approximately every six hours. Recent changes might not be
  /// reflected in this value.
  pub item_count: Int? = None
  /// The Amazon Resource Name (ARN) that uniquely identifies the vector
  /// index.
  pub index_arn: Str? = None
}

/// Contains the configuration of a vector index as it existed at the time a
/// backup was created.
pub struct VectorIndexInfo {
  /// The name of the vector index.
  pub index_name: Str? = None
  /// The vector attribute configuration for the index.
  pub vector_attribute: VectorAttributeDefinition? = None
  /// The search schema that defines partition key and inline filter
  /// attributes for the vector index.
  pub search_schema: List[SearchSchemaElement]? = None
  /// Specifies attributes that are copied (projected) from the table into the
  /// vector index.
  pub projection: Projection? = None
  /// The number of dimensions in each vector.
  pub dimensions: Int? = None
  /// The distance function used to calculate similarity between vectors.
  pub distance_function: VectorDistanceFunction? = None
}

/// A vector index to be added to or removed from a table.
pub struct VectorIndexUpdate {
  /// The configuration for creating a new vector index on the table.
  pub create: CreateVectorIndexAction? = None
  /// The configuration for deleting an existing vector index from the table.
  pub delete: DeleteVectorIndexAction? = None
}

/// Provides visibility into the number of read and write operations your
/// table or secondary index can instantaneously support. The settings can
/// be modified using the UpdateTable operation to meet the throughput
/// requirements of an upcoming peak event.
pub struct WarmThroughput {
  /// Represents the number of read operations your base table can
  /// instantaneously support.
  pub read_units_per_second: Int? = None
  /// Represents the number of write operations your base table can
  /// instantaneously support.
  pub write_units_per_second: Int? = None
}

pub enum WitnessStatus: Str {
  Creating = "CREATING"
  Deleting = "DELETING"
  Active = "ACTIVE"
  Unknown(value: Str)
}

/// Represents an operation to perform - either DeleteItem or PutItem . You
/// can only request one of these operations, not both, in a single
/// WriteRequest . If you do need to perform both of these operations, you
/// need to provide two separate WriteRequest objects.
pub struct WriteRequest {
  /// A request to perform a PutItem operation.
  pub put_request: PutRequest? = None
  /// A request to perform a DeleteItem operation.
  pub delete_request: DeleteRequest? = None
}
