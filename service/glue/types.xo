  /// set of features and on-disk layout supported by the table.
  pub format_version: Str? = None
  /// The unique identifier (UUID) for the Iceberg table, assigned when the
  /// table is created and used to track the table across metadata updates.
  pub table_uuid: Str? = None
  /// The base S3 location where the Iceberg table's data and metadata files
  /// are stored.
  pub location: Str? = None
  /// A map of key-value pairs that define table-level properties and
  /// configuration settings for the Iceberg table.
  pub properties: Map[Str, Str]? = None
  /// The list of schemas that have been associated with the Iceberg table
  /// over its history, supporting schema evolution.
