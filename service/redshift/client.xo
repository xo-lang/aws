  }
  xmlv.end(w, name)
}

fn xml_read_redshift_scope_union(e: xml.Element) -> RedshiftScopeUnion ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "Connect" => Ok(RedshiftScopeUnion.Connect(xml_read_connect(c)?))
      _ => Ok(RedshiftScopeUnion.Unknown(c.name.local))
    }
  }
  Err("RedshiftScopeUnion: no member set")
}

