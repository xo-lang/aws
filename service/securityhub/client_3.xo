fn json_of_target_value(v: Target) -> json.Value {
  match v {
    AccountId(x) => json.Value.Object([("AccountId", json.Value.Str(x))])
    OrganizationalUnitId(x) => json.Value.Object([("OrganizationalUnitId", json.Value.Str(x))])
    RootId(x) => json.Value.Object([("RootId", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_target_value(v: json.Value) -> Target ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "AccountId" => Ok(Target.AccountId(jsonv.read_str(fv)?))
      "OrganizationalUnitId" => Ok(Target.OrganizationalUnitId(jsonv.read_str(fv)?))
      "RootId" => Ok(Target.RootId(jsonv.read_str(fv)?))
      _ => Ok(Target.Unknown(k))
    }
  }
  Err("Target: no member set")
}

