fn json_of_field_type(v: FieldType) -> json.Value {
  match v {
    Text(x) => json.Value.Object([("Text", json_of_text_field_type(x))])
    RichText(x) => json.Value.Object([("RichText", json_of_rich_text_field_type(x))])
    Image(x) => json.Value.Object([("Image", json_of_image_field_type(x))])
    AssetLink(x) => json.Value.Object([("AssetLink", json_of_asset_link_field_type(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_field_type(v: json.Value) -> FieldType ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Text" => Ok(FieldType.Text(from_json_text_field_type(fv)?))
      "RichText" => Ok(FieldType.RichText(from_json_rich_text_field_type(fv)?))
      "Image" => Ok(FieldType.Image(from_json_image_field_type(fv)?))
      "AssetLink" => Ok(FieldType.AssetLink(from_json_asset_link_field_type(fv)?))
      _ => Ok(FieldType.Unknown(k))
    }
  }
  Err("FieldType: no member set")
}

