pub enum Statistic: Str {
  SampleCount = "SAMPLE_COUNT"
  Average = "AVERAGE"
  Sum = "SUM"
  Minimum = "MINIMUM"
  Maximum = "MAXIMUM"
  Unknown(value: Str)
}

/// This represents a step in a cluster.
pub struct Step {
  /// The identifier of the cluster step.
  pub id: Str? = None
  /// The name of the cluster step.
  pub name: Str? = None
  /// The Hadoop job configuration of the cluster step.
  pub config: HadoopStepConfig? = None
  /// The action to take when the cluster step fails. Possible values are
  /// TERMINATE_CLUSTER , CANCEL_AND_WAIT , and CONTINUE . TERMINATE_JOB_FLOW
  /// is provided for backward compatibility. We recommend using
  /// TERMINATE_CLUSTER instead. If a cluster's StepConcurrencyLevel is
  /// greater than 1 , do not use AddJobFlowSteps to submit a step with this
  /// parameter set to CANCEL_AND_WAIT or TERMINATE_CLUSTER . The step is not
  /// submitted and the action fails with a message that the ActionOnFailure
  /// setting is not valid. If you change a cluster's StepConcurrencyLevel to
  /// be greater than 1 while a step is running, the ActionOnFailure parameter
  /// may not behave as you expect. In this case, for a step that fails with
  /// this parameter set to CANCEL_AND_WAIT , pending steps and the running
  /// step are not canceled; for a step that fails with this parameter set to
  /// TERMINATE_CLUSTER , the cluster does not terminate.
  pub action_on_failure: ActionOnFailure? = None
  /// The current execution status details of the cluster step.
  pub status: StepStatus? = None
  /// The Amazon Resource Name (ARN) of the runtime role for a step on the
  /// cluster. The runtime role can be a cross-account IAM role. The runtime
  /// role ARN is a combination of account ID, role name, and role type using
  /// the following format: arn:partition:service:region:account:resource .
  /// For example, arn:aws:IAM::1234567890:role/ReadOnly is a correctly
  /// formatted runtime role ARN.
  pub execution_role_arn: Str? = None
  /// The Amazon S3 destination URI for log publishing.
  pub log_uri: Str? = None
  /// The KMS key ARN to encrypt the logs published to the given Amazon S3
  /// destination.
  pub encryption_key_arn: Str? = None
}

pub enum StepCancellationOption: Str {
  SendInterrupt = "SEND_INTERRUPT"
  TerminateProcess = "TERMINATE_PROCESS"
  Unknown(value: Str)
}

/// Specification for a cluster (job flow) step.
pub struct StepConfig {
  /// The name of the step.
  pub name: Str? = None
  /// The action to take when the step fails. Use one of the following values:
  /// TERMINATE_CLUSTER - Shuts down the cluster. CANCEL_AND_WAIT - Cancels
  /// any pending steps and returns the cluster to the WAITING state. CONTINUE
  /// - Continues to the next step in the queue. TERMINATE_JOB_FLOW - Shuts
  /// down the cluster. TERMINATE_JOB_FLOW is provided for backward
  /// compatibility. We recommend using TERMINATE_CLUSTER instead. If a
  /// cluster's StepConcurrencyLevel is greater than 1 , do not use
  /// AddJobFlowSteps to submit a step with this parameter set to
  /// CANCEL_AND_WAIT or TERMINATE_CLUSTER . The step is not submitted and the
  /// action fails with a message that the ActionOnFailure setting is not
  /// valid. If you change a cluster's StepConcurrencyLevel to be greater than
  /// 1 while a step is running, the ActionOnFailure parameter may not behave
  /// as you expect. In this case, for a step that fails with this parameter
  /// set to CANCEL_AND_WAIT , pending steps and the running step are not
  /// canceled; for a step that fails with this parameter set to
  /// TERMINATE_CLUSTER , the cluster does not terminate.
  pub action_on_failure: ActionOnFailure? = None
  /// The JAR file used for the step.
  pub hadoop_jar_step: HadoopJarStepConfig? = None
  /// Object that holds configuration properties for logging.
  pub step_monitoring_configuration: StepMonitoringConfiguration? = None
}

/// Combines the execution state and configuration of a step.
pub struct StepDetail {
  /// The step configuration.
  pub step_config: StepConfig? = None
  /// The description of the step status.
  pub execution_status_detail: StepExecutionStatusDetail? = None
}

pub enum StepExecutionState: Str {
  Pending = "PENDING"
  Running = "RUNNING"
  Continue = "CONTINUE"
  Completed = "COMPLETED"
  Cancelled = "CANCELLED"
  Failed = "FAILED"
  Interrupted = "INTERRUPTED"
  Unknown(value: Str)
}

/// The execution state of a step.
pub struct StepExecutionStatusDetail {
  /// The state of the step.
  pub state: StepExecutionState? = None
  /// The creation date and time of the step.
  pub creation_date_time: Time? = None
  /// The start date and time of the step.
  pub start_date_time: Time? = None
  /// The completion date and time of the step.
  pub end_date_time: Time? = None
  /// A description of the step's current state.
  pub last_state_change_reason: Str? = None
}

/// Object that holds configuration properties for logging.
pub struct StepMonitoringConfiguration {
  /// The Amazon S3 configuration for monitoring log publishing. You can
  /// configure your step to send log information to Amazon S3. When it's
  /// specified, it takes precedence over the cluster's logging configuration.
  /// If you don't specify this configuration entirely, or omit individual
  /// fields, EMR falls back to cluster-level logging behavior.
  pub s3_monitoring_configuration: S3MonitoringConfiguration? = None
}

pub enum StepState: Str {
  Pending = "PENDING"
  CancelPending = "CANCEL_PENDING"
  Running = "RUNNING"
  Completed = "COMPLETED"
  Cancelled = "CANCELLED"
  Failed = "FAILED"
  Interrupted = "INTERRUPTED"
  Unknown(value: Str)
}

/// The details of the step state change reason.
pub struct StepStateChangeReason {
  /// The programmable code for the state change reason. Note: Currently, the
  /// service provides no code for the state change.
  pub code: StepStateChangeReasonCode? = None
  /// The descriptive message for the state change reason.
  pub message: Str? = None
}

pub enum StepStateChangeReasonCode: Str {
  None = "NONE"
  Unknown(value: Str)
}

/// The execution status details of the cluster step.
pub struct StepStatus {
  /// The execution state of the cluster step.
  pub state: StepState? = None
  /// The reason for the step execution status change.
  pub state_change_reason: StepStateChangeReason? = None
  /// The details for the step failure including reason, message, and log file
  /// path where the root cause was identified.
  pub failure_details: FailureDetails? = None
  /// The timeline of the cluster step status over time.
  pub timeline: StepTimeline? = None
}

/// The summary of the cluster step.
pub struct StepSummary {
  /// The identifier of the cluster step.
  pub id: Str? = None
  /// The name of the cluster step.
  pub name: Str? = None
  /// The Hadoop job configuration of the cluster step.
  pub config: HadoopStepConfig? = None
  /// The action to take when the cluster step fails. Possible values are
  /// TERMINATE_CLUSTER, CANCEL_AND_WAIT, and CONTINUE. TERMINATE_JOB_FLOW is
  /// available for backward compatibility.
  pub action_on_failure: ActionOnFailure? = None
  /// The current execution status details of the cluster step.
  pub status: StepStatus? = None
  /// The Amazon S3 destination URI for log publishing.
  pub log_uri: Str? = None
  /// The KMS key ARN to encrypt the logs published to the given Amazon S3
  /// destination.
  pub encryption_key_arn: Str? = None
}

/// The timeline of the cluster step lifecycle.
pub struct StepTimeline {
  /// The date and time when the cluster step was created.
  pub creation_date_time: Time? = None
  /// The date and time when the cluster step execution started.
  pub start_date_time: Time? = None
  /// The date and time when the cluster step execution completed or failed.
  pub end_date_time: Time? = None
}

