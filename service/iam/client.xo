fn xml_write_instance_profile(var w: xmlv.Writer, v: InstanceProfile, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.path {
    xmlv.elem(w, "Path", x, [])
  }
  if let Some(x) = v.instance_profile_name {
    xmlv.elem(w, "InstanceProfileName", x, [])
  }
  if let Some(x) = v.instance_profile_id {
    xmlv.elem(w, "InstanceProfileId", x, [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "Arn", x, [])
  }
  if let Some(x) = v.create_date {
    xmlv.elem(w, "CreateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.roles {
    xml_write_role_list_type(w, x, "Roles", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list_type(w, x, "Tags", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_profile(e: xml.Element) -> InstanceProfile ! Str {
  var out = InstanceProfile{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Path" => out.path = c.text()
      "InstanceProfileName" => out.instance_profile_name = c.text()
      "InstanceProfileId" => out.instance_profile_id = c.text()
      "Arn" => out.arn = c.text()
      "CreateDate" => out.create_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Roles" => out.roles = xml_read_role_list_type(c)?
      "Tags" => out.tags = xml_read_tag_list_type(c)?
      _ => {}
    }
  }
  Ok(out)
}

