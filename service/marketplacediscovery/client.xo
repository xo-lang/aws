  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "byolPricingTerm" => Ok(OfferTerm.ByolPricingTerm(from_json_byol_pricing_term(fv)?))
      "configurableUpfrontPricingTerm" => Ok(OfferTerm.ConfigurableUpfrontPricingTerm(from_json_configurable_upfront_pricing_term(fv)?))
      "fixedUpfrontPricingTerm" => Ok(OfferTerm.FixedUpfrontPricingTerm(from_json_fixed_upfront_pricing_term(fv)?))
