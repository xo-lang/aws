fn xml_write_snapshot(var w: xmlv.Writer, v: Snapshot, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.owner_alias {
    xmlv.elem(w, "ownerAlias", x, [])
  }
  if let Some(x) = v.outpost_arn {
    xmlv.elem(w, "outpostArn", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.storage_tier {
    xmlv.elem(w, "storageTier", x.value(), [])
  }
  if let Some(x) = v.restore_expiry_time {
    xmlv.elem(w, "restoreExpiryTime", rest.date_time(x), [])
  }
  if let Some(x) = v.sse_type {
    xmlv.elem(w, "sseType", x.value(), [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.transfer_type {
    xmlv.elem(w, "transferType", x.value(), [])
  }
  if let Some(x) = v.completion_duration_minutes {
    xmlv.elem(w, "completionDurationMinutes", "${x}", [])
  }
  if let Some(x) = v.completion_time {
    xmlv.elem(w, "completionTime", rest.date_time(x), [])
  }
  if let Some(x) = v.full_snapshot_size_in_bytes {
    xmlv.elem(w, "fullSnapshotSizeInBytes", "${x}", [])
  }
  if let Some(x) = v.snapshot_id {
    xmlv.elem(w, "snapshotId", x, [])
  }
  if let Some(x) = v.volume_id {
    xmlv.elem(w, "volumeId", x, [])
