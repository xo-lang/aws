fn json_of_user(v: User) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.email {
    fs.push(("Email", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.display_name {
    fs.push(("DisplayName", json.Value.Str(x)))
  }
  if let Some(x) = v.state {
    fs.push(("State", json.Value.Str(x.value())))
  }
  if let Some(x) = v.user_role {
    fs.push(("UserRole", json.Value.Str(x.value())))
  }
  if let Some(x) = v.enabled_date {
    fs.push(("EnabledDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.disabled_date {
    fs.push(("DisabledDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.identity_provider_user_id {
    fs.push(("IdentityProviderUserId", json.Value.Str(x)))
  }
  if let Some(x) = v.identity_provider_identity_store_id {
    fs.push(("IdentityProviderIdentityStoreId", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_user(v: json.Value) -> User ! Str {
  var out = User{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Id" => out.id = jsonv.read_str(fv)?
      "Email" => out.email = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "DisplayName" => out.display_name = jsonv.read_str(fv)?
      "State" => out.state = EntityState.from(jsonv.read_str(fv)?)
      "UserRole" => out.user_role = UserRole.from(jsonv.read_str(fv)?)
      "EnabledDate" => out.enabled_date = jsonv.read_time(fv, "epoch-seconds")?
      "DisabledDate" => out.disabled_date = jsonv.read_time(fv, "epoch-seconds")?
      "IdentityProviderUserId" => out.identity_provider_user_id = jsonv.read_str(fv)?
      "IdentityProviderIdentityStoreId" => out.identity_provider_identity_store_id = jsonv.read_str(fv)?
      _ => {}
    }
