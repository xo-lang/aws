fn query_put_dkim_attributes(var f: query.Form, prefix: Str, v: Map[Str, IdentityDkimAttributes], flat: Bool) {
  // sorted keys, as aws-sdk-go-v2 writes them
  for (i, k) in v.keys().sort().indexed() {
    let e = if flat { "${prefix}.${i + 1}" } else { "${prefix}.entry.${i + 1}" }
    query.add(f, "${e}.key", k)
    if let Some(x) = v.get(k) {
      query_put_identity_dkim_attributes(f, "${e}.value", x)
    }
  }
}

fn query_put_event_destination(var f: query.Form, prefix: Str, v: EventDestination) {
