fn json_of_provider_configuration(v: ProviderConfiguration) -> json.Value {
  match v {
    Github(x) => json.Value.Object([("github", json_of_git_hub_configuration(x))])
    Gitlab(x) => json.Value.Object([("gitlab", json_of_git_lab_configuration(x))])
    S3(x) => json.Value.Object([("s3", json_of_s3_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_provider_configuration(v: json.Value) -> ProviderConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "github" => Ok(ProviderConfiguration.Github(from_json_git_hub_configuration(fv)?))
      "gitlab" => Ok(ProviderConfiguration.Gitlab(from_json_git_lab_configuration(fv)?))
      "s3" => Ok(ProviderConfiguration.S3(from_json_s3_configuration(fv)?))
      _ => Ok(ProviderConfiguration.Unknown(k))
    }
  }
  Err("ProviderConfiguration: no member set")
}

