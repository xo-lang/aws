  /// Specifies whether the package version should remain in the unfinished
  /// state. If omitted, the package version status will be set to Published
  /// (see Package version status in the CodeArtifact User Guide ). Valid
  /// values: unfinished
  pub unfinished: Bool? = None
  /// `asset_content` sent as it is read (`fileio.upload_file`, `aws.upload_opener`, `aws.upload_reader`),
  /// in place of `asset_content`: a large body without holding it in memory.
  pub asset_content_stream: aws.Upload? = None
}

