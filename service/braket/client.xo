/// The HTTP request of CancelJob.
pub fn serialize_cancel_job(ep: rest.Endpoint, input: CancelJobRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_job_arn = match input.job_arn {
    Some(v) => v
    None => return Err("input member jobArn is required")
  }
  if label_job_arn == "" {
    return Err("input member jobArn must not be empty")
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PUT",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/job/${rest.escape(label_job_arn, false)}/cancel"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

