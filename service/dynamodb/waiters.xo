/// Calls DescribeContributorInsights until the ContributorInsightsEnabled acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (20s) to `max_delay` (120s).
pub fn wait_until_contributor_insights_enabled(c: Client, input: DescribeContributorInsightsInput, max_wait: Duration, min_delay: Duration = 20s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeContributorInsightsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_contributor_insights(input) {
      Ok(out) => {
        let o = jmes_of_describe_contributor_insights_output(out)
        if state == "" && waiter.path_matches(o, "ContributorInsightsStatus", "stringEquals", "ENABLED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "ContributorInsightsStatus", "stringEquals", "FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ContributorInsightsEnabled: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

