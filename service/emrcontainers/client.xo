fn json_of_get_managed_endpoint_session_credentials_request(v: GetManagedEndpointSessionCredentialsRequest) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.endpoint_identifier {
    fs.push(("endpointIdentifier", json.Value.Str(x)))
  }
  if let Some(x) = v.virtual_cluster_identifier {
    fs.push(("virtualClusterIdentifier", json.Value.Str(x)))
  }
  if let Some(x) = v.execution_role_arn {
    fs.push(("executionRoleArn", json.Value.Str(x)))
  }
  if let Some(x) = v.credential_type {
    fs.push(("credentialType", json.Value.Str(x)))
