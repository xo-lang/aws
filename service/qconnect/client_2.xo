/// Submits a message to the Amazon Q in Connect session.
pub fn (c: Client) send_message(input: SendMessageRequest) -> SendMessageResponse ! SendMessageErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_send_message(c.params, input)) ?? e => return Err(SendMessageErr.InvalidInput(e))
  var req = serialize_send_message(ep, input, rest.uuid(c.rand)) ?? e => return Err(SendMessageErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(SendMessageErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_send_message_error(resp))
  }
  deserialize_send_message(resp) ?? e => Err(SendMessageErr.Deserialize(e))
}

