  /// The ID of the node at which the edge starts.
  pub source: Str? = None
  /// The ID of the node at which the edge ends.
  pub target_value: Str? = None
  /// The target of the edge.
  pub target_parameter: Str? = None
}

/// Represents a node in a directed acyclic graph (DAG)
pub struct CodeGenNode {
  /// A node identifier that is unique within the node's graph.
  pub id: Str? = None
  /// The type of node that this is.
  pub node_type: Str? = None
  /// Properties of the node, in the form of name-value pairs.
  pub args: List[CodeGenNodeArg]? = None
  /// The line number of the node.
  pub line_number: Int? = None
}

/// An argument or property of a node.
pub struct CodeGenNodeArg {
  /// The name of the argument or property.
  pub name: Str? = None
  /// The value of the argument or property.
  pub value: Str? = None
  /// True if the value is used as a parameter.
  pub param: Bool? = None
}

/// A column in a Table .
pub struct Column {
  /// The name of the Column .
  pub name: Str? = None
  /// The data type of the Column .
  pub type_value: Str? = None
  /// A free-form text comment.
  pub comment: Str? = None
  /// These key-value pairs define properties associated with the column.
  pub parameters: Map[Str, Str]? = None
}

/// Encapsulates a column name that failed and the reason for failure.
