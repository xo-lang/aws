    query.add(f, query.key(prefix, "CreateDate"), rest.date_time(x))
  }
  if let Some(x) = v.user_policy_list {
    query_put_policy_detail_list_type(f, query.key(prefix, "UserPolicyList"), x, false)
  }
  if let Some(x) = v.group_list {
    query_put_group_name_list_type(f, query.key(prefix, "GroupList"), x, false)
  }
  if let Some(x) = v.attached_managed_policies {
    query_put_attached_policies_list_type(f, query.key(prefix, "AttachedManagedPolicies"), x, false)
  }
  if let Some(x) = v.permissions_boundary {
    query_put_attached_permissions_boundary(f, query.key(prefix, "PermissionsBoundary"), x)
  }
  if let Some(x) = v.tags {
    query_put_tag_list_type(f, query.key(prefix, "Tags"), x, false)
  }
}

fn query_put_virtual_mfa_device(var f: query.Form, prefix: Str, v: VirtualMFADevice) {
