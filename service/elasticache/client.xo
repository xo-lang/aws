fn xml_write_modify_cache_cluster_message(var w: xmlv.Writer, v: ModifyCacheClusterMessage, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.cache_cluster_id {
    xmlv.elem(w, "CacheClusterId", x, [])
  }
  if let Some(x) = v.num_cache_nodes {
    xmlv.elem(w, "NumCacheNodes", "${x}", [])
  }
  if let Some(x) = v.cache_node_ids_to_remove {
    xml_write_cache_node_ids_list(w, x, "CacheNodeIdsToRemove", [])
  }
  if let Some(x) = v.az_mode {
    xmlv.elem(w, "AZMode", x.value(), [])
  }
  if let Some(x) = v.new_availability_zones {
