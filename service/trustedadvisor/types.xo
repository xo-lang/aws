  NotApplicable = "not_applicable"
  Other = "other"
  Unknown(value: Str)
}

/// The error entry for Recommendation Resource exclusion. Each entry is a
/// combination of Recommendation Resource ARN, error code and error message
pub struct UpdateRecommendationResourceExclusionError {
  /// The ARN of the Recommendation Resource
  pub arn: Str? = None
  /// The error code
  pub error_code: Str? = None
  /// The error message
  pub error_message: Str? = None
}

/// Exception that the request failed to satisfy service constraints
pub struct ValidationException {
  pub message: Str? = None
}
