  /// The storage type to associate with the green DB instance. Valid Values:
  /// gp2 | gp3 | io1 | io2 This setting doesn't apply to Amazon Aurora
  /// blue/green deployments.
  pub target_storage_type: Str? = None
  /// The amount of storage in gibibytes (GiB) to allocate for the green DB
