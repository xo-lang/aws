  pub description: Str? = None
  /// The name of the recipe to be published.
  pub name: Str? = None
}

pub struct PublishRecipeResponse {
  /// The name of the recipe that you published.
  pub name: Str? = None
}

/// Represents one or more actions to be performed on a DataBrew dataset.
pub struct Recipe {
  /// The Amazon Resource Name (ARN) of the user who created the recipe.
  pub created_by: Str? = None
  /// The date and time that the recipe was created.
  pub create_date: Time? = None
  /// The Amazon Resource Name (ARN) of the user who last modified the recipe.
  pub last_modified_by: Str? = None
  /// The last modification date and time of the recipe.
  pub last_modified_date: Time? = None
  /// The name of the project that the recipe is associated with.
  pub project_name: Str? = None
  /// The Amazon Resource Name (ARN) of the user who published the recipe.
  pub published_by: Str? = None
  /// The date and time when the recipe was published.
  pub published_date: Time? = None
  /// The description of the recipe.
  pub description: Str? = None
  /// The unique name for the recipe.
  pub name: Str? = None
  /// The Amazon Resource Name (ARN) for the recipe.
  pub resource_arn: Str? = None
  /// A list of steps that are defined by the recipe.
  pub steps: List[RecipeStep]? = None
  /// Metadata tags that have been applied to the recipe.
  pub tags: Map[Str, Str]? = None
  /// The identifier for the version for the recipe. Must be one of the
  /// following: Numeric version ( X.Y ) - X and Y stand for major and minor
  /// version numbers. The maximum length of each is 6 digits, and neither can
  /// be negative values. Both X and Y are required, and "0.0" isn't a valid
  /// version. LATEST_WORKING - the most recent valid version being developed
  /// in a DataBrew project. LATEST_PUBLISHED - the most recent published
  /// version.
  pub recipe_version: Str? = None
}

/// Represents a transformation and associated parameters that are used to
/// apply a change to a DataBrew dataset. For more information, see Recipe
/// actions reference .
pub struct RecipeAction {
  /// The name of a valid DataBrew transformation to be performed on the data.
  pub operation: Str? = None
  /// Contextual parameters for the transformation.
  pub parameters: Map[Str, Str]? = None
}

/// Represents the name and version of a DataBrew recipe.
pub struct RecipeReference {
  /// The name of the recipe.
  pub name: Str? = None
  /// The identifier for the version for the recipe.
  pub recipe_version: Str? = None
}

/// Represents a single step from a DataBrew recipe to be performed.
pub struct RecipeStep {
  /// The particular action to be performed in the recipe step.
  pub action: RecipeAction? = None
  /// One or more conditions that must be met for the recipe step to succeed.
  /// All of the conditions in the array must be met. In other words, all of
  /// the conditions must be combined using a logical AND operation.
  pub condition_expressions: List[ConditionExpression]? = None
}

/// Represents any errors encountered when attempting to delete multiple
/// recipe versions.
pub struct RecipeVersionErrorDetail {
  /// The HTTP status code for the error.
  pub error_code: Str? = None
  /// The text of the error message.
  pub error_message: Str? = None
  /// The identifier for the recipe version associated with this error.
  pub recipe_version: Str? = None
}

/// One or more resources can't be found.
pub struct ResourceNotFoundException {
  pub message: Str? = None
}

/// Represents a single data quality requirement that should be validated in
/// the scope of this dataset.
pub struct Rule {
  /// The name of the rule.
  pub name: Str? = None
  /// A value that specifies whether the rule is disabled. Once a rule is
  /// disabled, a profile job will not validate it during a job run. Default
  /// value is false.
  pub disabled: Bool? = None
  /// The expression which includes column references, condition names
  /// followed by variable references, possibly grouped and combined with
  /// other conditions. For example, (:col1 starts_with :prefix1 or :col1
  /// starts_with :prefix2) and (:col1 ends_with :suffix1 or :col1 ends_with
  /// :suffix2) . Column and value references are substitution variables that
  /// should start with the ':' symbol. Depending on the context, substitution
  /// variables' values can be either an actual value or a column name. These
  /// values are defined in the SubstitutionMap. If a CheckExpression starts
  /// with a column reference, then ColumnSelectors in the rule should be
  /// null. If ColumnSelectors has been defined, then there should be no
  /// column reference in the left side of a condition, for example,
  /// is_between :val1 and :val2 . For more information, see Available checks
  pub check_expression: Str? = None
  /// The map of substitution variable names to their values used in a check
  /// expression. Variable names should start with a ':' (colon). Variable
  /// values can either be actual values or column names. To differentiate
  /// between the two, column names should be enclosed in backticks, for
  /// example, ":col1": "`Column A`".
  pub substitution_map: Map[Str, Str]? = None
  /// The threshold used with a non-aggregate check expression. Non-aggregate
  /// check expressions will be applied to each row in a specific column, and
  /// the threshold will be used to determine whether the validation succeeds.
  pub threshold: Threshold? = None
  /// List of column selectors. Selectors can be used to select columns using
  /// a name or regular expression from the dataset. Rule will be applied to
  /// selected columns.
  pub column_selectors: List[ColumnSelector]? = None
}

