  /// 50Mbps , 100Mbps , 200Mbps , 300Mbps , 400Mbps , 500Mbps , 600Mbps ,
  /// 700Mbps , 800Mbps , 900Mbps , 1Gbps , 1.2Gbps , 1.5Gbps , 1.8Gbps ,
  /// 2Gbps , 2.1Gbps , 2.4Gbps , 2.7Gbps , 3Gbps , 3.2Gbps , 3.6Gbps , 4Gbps
  /// , 5Gbps , 6Gbps , 7Gbps , 8Gbps , 9Gbps , 10Gbps , 12Gbps , 15Gbps ,
  /// 18Gbps , 20Gbps , 21Gbps , 24Gbps , 27Gbps , 30Gbps , 32Gbps , 36Gbps ,
  /// 40Gbps , 50Gbps , 60Gbps , 70Gbps , 80Gbps , 100Gbps , 120Gbps , 150Gbps
  /// , 180Gbps , 200Gbps , 210Gbps , 240Gbps , 270Gbps , 300Gbps , 320Gbps ,
  /// 360Gbps , 400Gbps , 450Gbps , 480Gbps , 500Gbps , 540Gbps , 600Gbps ,
  /// 700Gbps , 800Gbps , 900Gbps , 1Tbps , 1.1Tbps , 1.2Tbps , 1.3Tbps ,
  /// 1.4Tbps , 1.5Tbps , 1.6Tbps .
  pub rate_limit: Str? = None
}

pub enum VirtualInterfaceState: Str {
  Confirming = "confirming"
  Verifying = "verifying"
  Pending = "pending"
  Available = "available"
  Down = "down"
  Testing = "testing"
  Deleting = "deleting"
  Deleted = "deleted"
  Rejected = "rejected"
  Unknown = "unknown"
  UnknownValue(value: Str)
}

/// Information about the virtual interface failover test.
pub struct VirtualInterfaceTestHistory {
  /// The ID of the virtual interface failover test.
  pub test_id: Str? = None
  /// The ID of the tested virtual interface.
  pub virtual_interface_id: Str? = None
  /// The BGP peers that were put in the DOWN state as part of the virtual
  /// interface failover test.
  pub bgp_peers: List[Str]? = None
  /// The status of the virtual interface failover test.
  pub status: Str? = None
  /// The owner ID of the tested virtual interface.
  pub owner_account: Str? = None
  /// The time that the virtual interface failover test ran in minutes.
  pub test_duration_in_minutes: Int? = None
  /// The time that the virtual interface moves to the DOWN state.
  pub start_time: Time? = None
  /// The time that the virtual interface moves out of the DOWN state.
  pub end_time: Time? = None
}

pub struct VirtualInterfaces {
  /// The virtual interfaces
  pub virtual_interfaces: List[VirtualInterface]? = None
  /// The token to use to retrieve the next page of results. This value is
  /// null when there are no more results to return.
  pub next_token: Str? = None
}
