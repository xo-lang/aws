fn query_put_data_share_association_list(var f: query.Form, prefix: Str, v: List[DataShareAssociation], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_data_share_association(f, k, x)
  }
}

