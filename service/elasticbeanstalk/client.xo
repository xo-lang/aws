fn xml_write_single_instance_health(var w: xmlv.Writer, v: SingleInstanceHealth, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "InstanceId", x, [])
  }
  if let Some(x) = v.health_status {
    xmlv.elem(w, "HealthStatus", x, [])
  }
  if let Some(x) = v.color {
    xmlv.elem(w, "Color", x, [])
  }
  if let Some(x) = v.causes {
    xml_write_causes(w, x, "Causes", [])
  }
  if let Some(x) = v.launched_at {
    xmlv.elem(w, "LaunchedAt", rest.date_time(x), [])
  }
  if let Some(x) = v.application_metrics {
    xml_write_application_metrics(w, x, "ApplicationMetrics", [])
  }
  if let Some(x) = v.system {
    xml_write_system_status(w, x, "System", [])
  }
  if let Some(x) = v.deployment {
    xml_write_deployment(w, x, "Deployment", [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "AvailabilityZone", x, [])
  }
  if let Some(x) = v.instance_type {
    xmlv.elem(w, "InstanceType", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_single_instance_health(e: xml.Element) -> SingleInstanceHealth ! Str {
  var out = SingleInstanceHealth{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "InstanceId" => out.instance_id = c.text()
      "HealthStatus" => out.health_status = c.text()
      "Color" => out.color = c.text()
      "Causes" => out.causes = xml_read_causes(c)?
      "LaunchedAt" => out.launched_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ApplicationMetrics" => out.application_metrics = xml_read_application_metrics(c)?
      "System" => out.system = xml_read_system_status(c)?
      "Deployment" => out.deployment = xml_read_deployment(c)?
      "AvailabilityZone" => out.availability_zone = c.text()
      "InstanceType" => out.instance_type = c.text()
      _ => {}
    }
  }
  Ok(out)
}

