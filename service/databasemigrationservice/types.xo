  /// Specifies the number scale. You can select a scale up to 38, or you can
  /// select FLOAT. By default, the NUMBER data type is converted to precision
  /// 38, scale 10. Example: numberDataTypeScale=12
  pub number_datatype_scale: Int? = None
  /// Endpoint connection password.
  pub password: Str? = None
  /// Endpoint TCP port.
  pub port: Int? = None
  /// When set to true , this attribute supports tablespace replication.
  pub read_table_space_name: Bool? = None
  /// Specifies the number of seconds that the system waits before resending a
  /// query. Example: retryInterval=6;
  pub retry_interval: Int? = None
  /// For an Oracle source endpoint, the transparent data encryption (TDE)
  /// password required by DMS to access Oracle redo logs encrypted by TDE
  /// using Binary Reader. It is also the TDE_Password part of the
  /// comma-separated value you set to the Password request parameter when you
  /// create the endpoint. The SecurityDbEncryption setting is related to this
  /// SecurityDbEncryptionName setting. For more information, see Supported
  /// encryption methods for using Oracle as a source for DMS in the Database
  /// Migration Service User Guide .
  pub security_db_encryption: Str? = None
  /// For an Oracle source endpoint, the name of a key used for the
  /// transparent data encryption (TDE) of the columns and tablespaces in an
  /// Oracle source database that is encrypted using TDE. The key value is the
  /// value of the SecurityDbEncryption setting. For more information on
  /// setting the key name value of SecurityDbEncryptionName , see the
  /// information and example for setting the securityDbEncryptionName extra
  /// connection attribute in Supported encryption methods for using Oracle as
  /// a source for DMS in the Database Migration Service User Guide .
  pub security_db_encryption_name: Str? = None
  /// Fully qualified domain name of the endpoint. For an Amazon RDS Oracle
  /// instance, this is the output of DescribeDBInstances , in the Endpoint
  /// .Address field.
  pub server_name: Str? = None
  /// Use this attribute to convert SDO_GEOMETRY to GEOJSON format. By
  /// default, DMS calls the SDO2GEOJSON custom function if present and
  /// accessible. Or you can create your own custom function that mimics the
  /// operation of SDOGEOJSON and set SpatialDataOptionToGeoJsonFunctionName
  /// to call it instead.
  pub spatial_data_option_to_geo_json_function_name: Str? = None
  /// Use this attribute to specify a time in minutes for the delay in standby
  /// sync. If the source is an Oracle Active Data Guard standby database, use
  /// this attribute to specify the time lag between primary and standby
  /// databases. In DMS, you can create an Oracle CDC task that uses an Active
  /// Data Guard standby instance as a source for replicating ongoing changes.
  /// Doing this eliminates the need to connect to an active database that
  /// might be in production.
  pub standby_delay_time: Int? = None
  /// Endpoint connection user name.
  pub username: Str? = None
  /// Set this attribute to True to capture change data using the Binary
  /// Reader utility. Set UseLogminerReader to False to set this attribute to
  /// True. To use Binary Reader with Amazon RDS for Oracle as the source, you
  /// set additional attributes. For more information about using this setting
  /// with Oracle Automatic Storage Management (ASM), see Using Oracle
  /// LogMiner or DMS Binary Reader for CDC .
  pub use_b_file: Bool? = None
  /// Set this attribute to True to have DMS use a direct path full load.
  /// Specify this value to use the direct path protocol in the Oracle Call
  /// Interface (OCI). By using this OCI protocol, you can bulk-load Oracle
  /// target tables during a full load.
  pub use_direct_path_full_load: Bool? = None
  /// Set this attribute to True to capture change data using the Oracle
  /// LogMiner utility (the default). Set this attribute to False if you want
  /// to access the redo logs as a binary file. When you set UseLogminerReader
  /// to False, also set UseBfile to True. For more information on this
  /// setting and using Oracle ASM, see Using Oracle LogMiner or DMS Binary
  /// Reader for CDC in the DMS User Guide .
  pub use_logminer_reader: Bool? = None
  /// The full Amazon Resource Name (ARN) of the IAM role that specifies DMS
  /// as the trusted entity and grants the required permissions to access the
  /// value in SecretsManagerSecret . The role must allow the iam:PassRole
  /// action. SecretsManagerSecret has the value of the Amazon Web Services
  /// Secrets Manager secret that allows access to the Oracle endpoint. You
  /// can specify one of two sets of values for these permissions. You can
  /// specify the values for this setting and SecretsManagerSecretId . Or you
  /// can specify clear-text values for UserName , Password , ServerName , and
  /// Port . You can't specify both. For more information on creating this
  /// SecretsManagerSecret and the SecretsManagerAccessRoleArn and
  /// SecretsManagerSecretId required to access it, see Using secrets to
  /// access Database Migration Service resources in the Database Migration
  /// Service User Guide .
  pub secrets_manager_access_role_arn: Str? = None
  /// The full ARN, partial ARN, or friendly name of the SecretsManagerSecret
  /// that contains the Oracle endpoint connection details.
  pub secrets_manager_secret_id: Str? = None
  /// Required only if your Oracle endpoint uses Automatic Storage Management
  /// (ASM). The full ARN of the IAM role that specifies DMS as the trusted
  /// entity and grants the required permissions to access the
  /// SecretsManagerOracleAsmSecret . This SecretsManagerOracleAsmSecret has
  /// the secret value that allows access to the Oracle ASM of the endpoint.
  /// You can specify one of two sets of values for these permissions. You can
  /// specify the values for this setting and SecretsManagerOracleAsmSecretId
  /// . Or you can specify clear-text values for AsmUser , AsmPassword , and
  /// AsmServerName . You can't specify both. For more information on creating
  /// this SecretsManagerOracleAsmSecret and the
  /// SecretsManagerOracleAsmAccessRoleArn and SecretsManagerOracleAsmSecretId
  /// required to access it, see Using secrets to access Database Migration
  /// Service resources in the Database Migration Service User Guide .
  pub secrets_manager_oracle_asm_access_role_arn: Str? = None
  /// Required only if your Oracle endpoint uses Automatic Storage Management
  /// (ASM). The full ARN, partial ARN, or friendly name of the
  /// SecretsManagerOracleAsmSecret that contains the Oracle ASM connection
  /// details for the Oracle endpoint.
  pub secrets_manager_oracle_asm_secret_id: Str? = None
  /// Use the TrimSpaceInChar source endpoint setting to trim data on CHAR and
  /// NCHAR data types during migration. The default value is true .
  pub trim_space_in_char: Bool? = None
  /// When true, converts timestamps with the timezone datatype to their UTC
  /// value.
  pub convert_timestamp_with_zone_to_utc: Bool? = None
  /// The timeframe in minutes to check for open transactions for a CDC-only
  /// task. You can specify an integer value between 0 (the default) and 240
  /// (the maximum). This parameter is only valid in DMS version 3.5.0 and
  /// later.
  pub open_transaction_window: Int? = None
  /// Specifies the authentication method to be used with Oracle.
  pub authentication_method: OracleAuthenticationMethod? = None
}

/// In response to the DescribeOrderableReplicationInstances operation, this
/// object describes an available replication instance. This description
/// includes the replication instance's type, engine version, and allocated
/// storage.
pub struct OrderableReplicationInstance {
  /// The version of the replication engine.
  pub engine_version: Str? = None
  /// The compute and memory capacity of the replication instance as defined
  /// for the specified replication instance class. For example to specify the
  /// instance class dms.c4.large, set this parameter to "dms.c4.large" . For
  /// more information on the settings and capacities for the available
  /// replication instance classes, see Selecting the right DMS replication
  /// instance for your migration .
  pub replication_instance_class: Str? = None
  /// The type of storage used by the replication instance.
  pub storage_type: Str? = None
  /// The minimum amount of storage (in gigabytes) that can be allocated for
  /// the replication instance.
  pub min_allocated_storage: Int? = None
  /// The minimum amount of storage (in gigabytes) that can be allocated for
  /// the replication instance.
  pub max_allocated_storage: Int? = None
  /// The default amount of storage (in gigabytes) that is allocated for the
  /// replication instance.
  pub default_allocated_storage: Int? = None
  /// The amount of storage (in gigabytes) that is allocated for the
  /// replication instance.
  pub included_allocated_storage: Int? = None
  /// List of Availability Zones for this replication instance.
  pub availability_zones: List[Str]? = None
  /// The value returned when the specified EngineVersion of the replication
  /// instance is in Beta or test mode. This indicates some features might not
  /// work as expected. DMS supports the ReleaseStatus parameter in versions
  /// 3.1.4 and later.
  pub release_status: ReleaseStatusValues? = None
}

pub enum OriginTypeValue: Str {
  Source = "SOURCE"
  Target = "TARGET"
  Unknown(value: Str)
}

pub enum ParquetVersionValue: Str {
  Parquet10 = "parquet-1-0"
  Parquet20 = "parquet-2-0"
  Unknown(value: Str)
}

/// Describes a maintenance action pending for an DMS resource, including
/// when and how it will be applied. This data type is a response element to
/// the DescribePendingMaintenanceActions operation.
pub struct PendingMaintenanceAction {
  /// The type of pending maintenance action that is available for the
  /// resource.
  pub action: Str? = None
  /// The date of the maintenance window when the action is to be applied. The
  /// maintenance action is applied to the resource during its first
  /// maintenance window after this date. If this date is specified, any
  /// next-maintenance opt-in requests are ignored.
  pub auto_applied_after_date: Time? = None
  /// The date when the maintenance action will be automatically applied. The
  /// maintenance action is applied to the resource on this date regardless of
  /// the maintenance window for the resource. If this date is specified, any
  /// immediate opt-in requests are ignored.
  pub forced_apply_date: Time? = None
  /// The type of opt-in request that has been received for the resource.
  pub opt_in_status: Str? = None
  /// The effective date when the pending maintenance action will be applied
  /// to the resource. This date takes into account opt-in requests received
  /// from the ApplyPendingMaintenanceAction API operation, and also the
  /// AutoAppliedAfterDate and ForcedApplyDate parameter values. This value is
  /// blank if an opt-in request has not been received and nothing has been
  /// specified for AutoAppliedAfterDate or ForcedApplyDate .
  pub current_apply_date: Time? = None
  /// A description providing more detail about the maintenance action.
  pub description: Str? = None
}

pub enum PluginNameValue: Str {
  NoPreference = "no-preference"
  TestDecoding = "test-decoding"
  Pglogical = "pglogical"
  Unknown(value: Str)
}

pub enum PostgreSQLAuthenticationMethod: Str {
  Password = "password"
  Iam = "iam"
  Unknown(value: Str)
}

/// Provides information that defines a PostgreSQL endpoint.
pub struct PostgreSQLSettings {
  /// For use with change data capture (CDC) only, this attribute has DMS
  /// bypass foreign keys and user triggers to reduce the time it takes to
  /// bulk load data. Example: afterConnectScript=SET
  /// session_replication_role='replica'
  pub after_connect_script: Str? = None
  /// To capture DDL events, DMS creates various artifacts in the PostgreSQL
  /// database when the task starts. You can later remove these artifacts. The
  /// default value is true . If this value is set to N , you don't have to
  /// create tables or triggers on the source database.
  pub capture_ddls: Bool? = None
  /// Specifies the maximum size (in KB) of any .csv file used to transfer
  /// data to PostgreSQL. The default value is 32,768 KB (32 MB). Example:
  /// maxFileSize=512
  pub max_file_size: Int? = None
  /// Database name for the endpoint.
  pub database_name: Str? = None
  /// The schema in which the operational DDL database artifacts are created.
  /// The default value is public . Example: ddlArtifactsSchema=xyzddlschema;
  pub ddl_artifacts_schema: Str? = None
  /// Sets the client statement timeout for the PostgreSQL instance, in
  /// seconds. The default value is 60 seconds. Example: executeTimeout=100;
  pub execute_timeout: Int? = None
  /// When set to true , this value causes a task to fail if the actual size
  /// of a LOB column is greater than the specified LobMaxSize . The default
  /// value is false . If task is set to Limited LOB mode and this option is
  /// set to true, the task fails instead of truncating the LOB data.
  pub fail_tasks_on_lob_truncation: Bool? = None
  /// The write-ahead log (WAL) heartbeat feature mimics a dummy transaction.
  /// By doing this, it prevents idle logical replication slots from holding
  /// onto old WAL logs, which can result in storage full situations on the
  /// source. This heartbeat keeps restart_lsn moving and prevents storage
  /// full scenarios. The default value is false .
  pub heartbeat_enable: Bool? = None
  /// Sets the schema in which the heartbeat artifacts are created. The
  /// default value is public .
  pub heartbeat_schema: Str? = None
  /// Sets the WAL heartbeat frequency (in minutes). The default value is 5
  /// minutes.
  pub heartbeat_frequency: Int? = None
  /// Endpoint connection password.
  pub password: Str? = None
  /// Endpoint TCP port. The default is 5432.
  pub port: Int? = None
  /// The host name of the endpoint database. For an Amazon RDS PostgreSQL
  /// instance, this is the output of DescribeDBInstances , in the Endpoint
  /// .Address field. For an Aurora PostgreSQL instance, this is the output of
  /// DescribeDBClusters , in the Endpoint field.
  pub server_name: Str? = None
  /// Endpoint connection user name.
  pub username: Str? = None
  /// Sets the name of a previously created logical replication slot for a
  /// change data capture (CDC) load of the PostgreSQL source instance. When
  /// used with the CdcStartPosition request parameter for the DMS API , this
  /// attribute also makes it possible to use native CDC start points. DMS
  /// verifies that the specified logical replication slot exists before
  /// starting the CDC load task. It also verifies that the task was created
  /// with a valid setting of CdcStartPosition . If the specified slot doesn't
  /// exist or the task doesn't have a valid CdcStartPosition setting, DMS
  /// raises an error. For more information about setting the CdcStartPosition
  /// request parameter, see Determining a CDC native start point in the
  /// Database Migration Service User Guide . For more information about using
  /// CdcStartPosition , see CreateReplicationTask , StartReplicationTask ,
  /// and ModifyReplicationTask .
  pub slot_name: Str? = None
  /// Specifies the plugin to use to create a replication slot. The default
  /// value is pglogical .
  pub plugin_name: PluginNameValue? = None
  /// The full Amazon Resource Name (ARN) of the IAM role that specifies DMS
  /// as the trusted entity and grants the required permissions to access the
  /// value in SecretsManagerSecret . The role must allow the iam:PassRole
  /// action. SecretsManagerSecret has the value of the Amazon Web Services
  /// Secrets Manager secret that allows access to the PostgreSQL endpoint.
  /// You can specify one of two sets of values for these permissions. You can
  /// specify the values for this setting and SecretsManagerSecretId . Or you
  /// can specify clear-text values for UserName , Password , ServerName , and
  /// Port . You can't specify both. For more information on creating this
  /// SecretsManagerSecret and the SecretsManagerAccessRoleArn and
  /// SecretsManagerSecretId required to access it, see Using secrets to
  /// access Database Migration Service resources in the Database Migration
  /// Service User Guide .
  pub secrets_manager_access_role_arn: Str? = None
  /// The full ARN, partial ARN, or friendly name of the SecretsManagerSecret
  /// that contains the PostgreSQL endpoint connection details.
  pub secrets_manager_secret_id: Str? = None
  /// Use the TrimSpaceInChar source endpoint setting to trim data on CHAR and
  /// NCHAR data types during migration. The default value is true .
  pub trim_space_in_char: Bool? = None
  /// When true, lets PostgreSQL migrate the boolean type as boolean. By
  /// default, PostgreSQL migrates booleans as varchar(5) . You must set this
  /// setting on both the source and target endpoints for it to take effect.
  /// The default value is false .
  pub map_boolean_as_boolean: Bool? = None
  /// When true, DMS migrates JSONB values as CLOB. The default value is false
  /// .
  pub map_jsonb_as_clob: Bool? = None
  /// Sets what datatype to map LONG values as. The default value is wstring .
  pub map_long_varchar_as: LongVarcharMappingType? = None
  /// Specifies the default behavior of the replication's handling of
  /// PostgreSQL- compatible endpoints that require some additional
  /// configuration, such as Babelfish endpoints.
  pub database_mode: DatabaseMode? = None
  /// The Babelfish for Aurora PostgreSQL database name for the endpoint.
  pub babelfish_database_name: Str? = None
  /// Disables the Unicode source filter with PostgreSQL, for values passed
  /// into the Selection rule filter on Source Endpoint column values. By
  /// default DMS performs source filter comparisons using a Unicode string
  /// which can cause look ups to ignore the indexes in the text columns and
  /// slow down migrations. Unicode support should only be disabled when using
  /// a selection rule filter is on a text column in the Source database that
  /// is indexed.
  pub disable_unicode_source_filter: Bool? = None
  /// The IAM role arn you can use to authenticate the connection to your
  /// endpoint. Ensure to include iam:PassRole and rds-db:connect actions in
  /// permission policy.
  pub service_access_role_arn: Str? = None
  /// This attribute allows you to specify the authentication method as "iam
  /// auth".
  pub authentication_method: PostgreSQLAuthenticationMethod? = None
}

/// Provides information that defines a PostgreSQL data provider.
pub struct PostgreSqlDataProviderSettings {
  /// The name of the PostgreSQL server.
  pub server_name: Str? = None
  /// The port value for the PostgreSQL data provider.
  pub port: Int? = None
  /// The database name on the PostgreSQL data provider.
  pub database_name: Str? = None
  /// The SSL mode used to connect to the PostgreSQL data provider. The
  /// default value is none .
  pub ssl_mode: DmsSslModeValue? = None
  /// The Amazon Resource Name (ARN) of the certificate used for SSL
  /// connection.
  pub certificate_arn: Str? = None
  /// The path for the Amazon S3 bucket that the application uses for
  /// accessing the user-defined schema.
  pub s3_path: Str? = None
  /// The ARN for the role the application uses to access its Amazon S3
  /// bucket.
  pub s3_access_role_arn: Str? = None
}

/// The results returned in describe-replications to display the results of
/// the premigration assessment from the replication configuration.
pub struct PremigrationAssessmentStatus {
  /// The Amazon Resource Name (ARN) of this assessment run.
  pub premigration_assessment_run_arn: Str? = None
  /// A configurable setting you can set to true (the defualt setting) or
  /// false . Use this setting to to stop the replication from starting
  /// automatically if the assessment fails. This can help you evaluate the
  /// issue that is preventing the replication from running successfully.
  pub fail_on_assessment_failure: Bool? = None
  /// This describes the assessment run status. The status can be one of the
  /// following values: cancelling : The assessment run was canceled. deleting
  /// : The assessment run was deleted. failed : At least one individual
  /// assessment completed with a failed status. error-provisioning : An
  /// internal error occurred while resources were provisioned (during the
  /// provisioning status). error-executing An internal error occurred while
  /// individual assessments ran (during the running status). invalid state :
  /// The assessment run is in an unknown state. passed : All individual
  /// assessments have completed and none have a failed status. provisioning :
  /// The resources required to run individual assessments are being
  /// provisioned. running : Individual assessments are being run. starting :
  /// The assessment run is starting, but resources are not yet being
  /// provisioned for individual assessments. warning : At least one
  /// individual assessment completed with a warning status.
  pub status: Str? = None
  /// The date which the assessment run was created.
  pub premigration_assessment_run_creation_date: Time? = None
  pub assessment_progress: ReplicationTaskAssessmentRunProgress? = None
  /// The last message generated by an individual assessment failure.
  pub last_failure_message: Str? = None
  /// The Amazon S3 bucket that Database Migration Service Serverless created
  /// to store the results of this assessment run.
  pub result_location_bucket: Str? = None
  /// The folder within an Amazon S3 bucket where you want Database Migration
  /// Service to store the results of this assessment run.
  pub result_location_folder: Str? = None
  /// The supported values are SSE_KMS and SSE_S3 . If these values are not
  /// provided, then the files are not encrypted at rest. For more
  /// information, see Creating Amazon Web Services KMS keys to encrypt Amazon
  /// S3 target objects .
  pub result_encryption_mode: Str? = None
  /// The ARN of a custom KMS encryption key that you specify when you set
  /// ResultEncryptionMode to SSE_KMS .
  pub result_kms_key_arn: Str? = None
  pub result_statistic: ReplicationTaskAssessmentRunResultStatistic? = None
}

/// The database object that the schema conversion operation currently uses.
pub struct ProcessedObject {
  /// The name of the database object.
  pub name: Str? = None
  /// The type of the database object. For example, a table, view, procedure,
  /// and so on.
  pub type_value: Str? = None
  /// The type of the data provider. This parameter can store one of the
  /// following values: "SOURCE" or "TARGET" .
  pub endpoint_type: Str? = None
}

/// Provides information about the progress of the schema conversion
/// operation.
pub struct Progress {
  /// The percent complete for the current step of the schema conversion
  /// operation.
  pub progress_percent: Float? = None
  /// The number of objects in this schema conversion operation.
  pub total_objects: Int? = None
  /// The step of the schema conversion operation. This parameter can store
  /// one of the following values: IN_PROGRESS – The operation is running.
  /// LOADING_METADATA – Loads metadata from the source database.
  /// COUNTING_OBJECTS – Determines the number of objects involved in the
  /// operation. ANALYZING – Analyzes the source database objects.
  /// CONVERTING – Converts the source database objects to a format
  /// compatible with the target database. APPLYING – Applies the converted
  /// code to the target database. FINISHED – The operation completed
  /// successfully.
  pub progress_step: Str? = None
  /// The name of the database object that the schema conversion operation
  /// currently uses.
  pub processed_object: ProcessedObject? = None
}

/// Information about provisioning resources for an DMS serverless
/// replication.
pub struct ProvisionData {
  /// The current provisioning state
  pub provision_state: Str? = None
  /// The number of capacity units the replication is using.
  pub provisioned_capacity_units: Int? = None
  /// The timestamp when DMS provisioned replication resources.
  pub date_provisioned: Time? = None
  /// Whether the new provisioning is available to the replication.
  pub is_new_provisioning_available: Bool? = None
  /// The timestamp when provisioning became available.
  pub date_new_provisioning_data_available: Time? = None
  /// A message describing the reason that DMS provisioned new resources for
  /// the serverless replication.
  pub reason_for_new_provisioning_data: Str? = None
}

/// Provides information that describes the configuration of the recommended
/// target engine on Amazon RDS.
pub struct RdsConfiguration {
  /// Describes the recommended target Amazon RDS engine edition.
  pub engine_edition: Str? = None
  /// Describes the recommended target Amazon RDS instance type.
  pub instance_type: Str? = None
  /// Describes the number of virtual CPUs (vCPU) on the recommended Amazon
  /// RDS DB instance that meets your requirements.
  pub instance_vcpu: Float? = None
  /// Describes the memory on the recommended Amazon RDS DB instance that
  /// meets your requirements.
  pub instance_memory: Float? = None
  /// Describes the storage type of the recommended Amazon RDS DB instance
  /// that meets your requirements. Amazon RDS provides three storage types:
  /// General Purpose SSD (also known as gp2 and gp3), Provisioned IOPS SSD
  /// (also known as io1), and magnetic (also known as standard).
  pub storage_type: Str? = None
  /// Describes the storage size of the recommended Amazon RDS DB instance
  /// that meets your requirements.
  pub storage_size: Int? = None
  /// Describes the number of I/O operations completed each second (IOPS) on
  /// the recommended Amazon RDS DB instance that meets your requirements.
  pub storage_iops: Int? = None
  /// Describes the deployment option for the recommended Amazon RDS DB
  /// instance. The deployment options include Multi-AZ and Single-AZ
  /// deployments. Valid values include "MULTI_AZ" and "SINGLE_AZ" .
  pub deployment_option: Str? = None
  /// Describes the recommended target Amazon RDS engine version.
  pub engine_version: Str? = None
}

/// Provides information that describes a recommendation of a target engine
/// on Amazon RDS.
pub struct RdsRecommendation {
  /// Supplemental information about the requirements to the recommended
  /// target database on Amazon RDS.
  pub requirements_to_target: RdsRequirements? = None
  /// Supplemental information about the configuration of the recommended
  /// target database on Amazon RDS.
  pub target_configuration: RdsConfiguration? = None
}

/// Provides information that describes the requirements to the target
/// engine on Amazon RDS.
pub struct RdsRequirements {
  /// The required target Amazon RDS engine edition.
  pub engine_edition: Str? = None
  /// The required number of virtual CPUs (vCPU) on the Amazon RDS DB
  /// instance.
  pub instance_vcpu: Float? = None
  /// The required memory on the Amazon RDS DB instance.
  pub instance_memory: Float? = None
  /// The required Amazon RDS DB instance storage size.
  pub storage_size: Int? = None
  /// The required number of I/O operations completed each second (IOPS) on
  /// your Amazon RDS DB instance.
  pub storage_iops: Int? = None
  /// The required deployment option for the Amazon RDS DB instance. Valid
  /// values include "MULTI_AZ" for Multi-AZ deployments and "SINGLE_AZ" for
  /// Single-AZ deployments.
  pub deployment_option: Str? = None
  /// The required target Amazon RDS engine version.
  pub engine_version: Str? = None
}

pub struct RebootReplicationInstanceMessage {
  /// The Amazon Resource Name (ARN) of the replication instance.
  pub replication_instance_arn: Str? = None
  /// If this parameter is true , the reboot is conducted through a Multi-AZ
  /// failover. If the instance isn't configured for Multi-AZ, then you can't
  /// specify true . ( --force-planned-failover and --force-failover can't
  /// both be set to true .)
  pub force_failover: Bool? = None
  /// If this parameter is true , the reboot is conducted through a planned
  /// Multi-AZ failover where resources are released and cleaned up prior to
  /// conducting the failover. If the instance isn''t configured for Multi-AZ,
  /// then you can't specify true . ( --force-planned-failover and
  /// --force-failover can't both be set to true .)
  pub force_planned_failover: Bool? = None
}

pub struct RebootReplicationInstanceResponse {
  /// The replication instance that is being rebooted.
  pub replication_instance: ReplicationInstance? = None
}

/// Provides information that describes a recommendation of a target engine.
/// A recommendation is a set of possible Amazon Web Services target engines
/// that you can choose to migrate your source on-premises database. In this
/// set, Fleet Advisor suggests a single target engine as the right sized
/// migration destination. To determine this rightsized migration
/// destination, Fleet Advisor uses the inventory metadata and metrics from
/// data collector. You can use recommendations before the start of
/// migration to save costs and reduce risks. With recommendations, you can
/// explore different target options and compare metrics, so you can make an
/// informed decision when you choose the migration target.
pub struct Recommendation {
  /// The identifier of the source database for which Fleet Advisor provided
  /// this recommendation.
  pub database_id: Str? = None
  /// The name of the target engine. Valid values include "rds-aurora-mysql" ,
  /// "rds-aurora-postgresql" , "rds-mysql" , "rds-oracle" , "rds-sql-server"
  /// , and "rds-postgresql" .
  pub engine_name: Str? = None
  /// The date when Fleet Advisor created the target engine recommendation.
  pub created_date: Str? = None
  /// The status of the target engine recommendation. Valid values include
  /// "alternate" , "in-progress" , "not-viable" , and "recommended" .
  pub status: Str? = None
  /// Indicates that this target is the rightsized migration destination.
  pub preferred: Bool? = None
  /// The settings in JSON format for the preferred target engine parameters.
  /// These parameters include capacity, resource utilization, and the usage
  /// type (production, development, or testing).
  pub settings: RecommendationSettings? = None
  /// The recommendation of a target engine for the specified source database.
  pub data: RecommendationData? = None
}

/// Provides information about the target engine for the specified source
/// database.
pub struct RecommendationData {
  /// The recommendation of a target Amazon RDS database engine.
  pub rds_engine: RdsRecommendation? = None
}

/// Provides information about the required target engine settings.
pub struct RecommendationSettings {
  /// The size of your target instance. Fleet Advisor calculates this value
  /// based on your data collection type, such as total capacity and resource
  /// utilization. Valid values include "total-capacity" and "utilization" .
  pub instance_sizing_type: Str? = None
  /// The deployment option for your target engine. For production databases,
  /// Fleet Advisor chooses Multi-AZ deployment. For development or test
  /// databases, Fleet Advisor chooses Single-AZ deployment. Valid values
  /// include "development" and "production" .
  pub workload_type: Str? = None
}

pub enum RedisAuthTypeValue: Str {
  None = "none"
  AuthRole = "auth-role"
  AuthToken = "auth-token"
  Unknown(value: Str)
}

/// Provides information that defines a Redis target endpoint.
pub struct RedisSettings {
  /// Fully qualified domain name of the endpoint.
  pub server_name: Str? = None
  /// Transmission Control Protocol (TCP) port for the endpoint.
  pub port: Int? = None
  /// The connection to a Redis target endpoint using Transport Layer Security
  /// (TLS). Valid values include plaintext and ssl-encryption . The default
  /// is ssl-encryption . The ssl-encryption option makes an encrypted
  /// connection. Optionally, you can identify an Amazon Resource Name (ARN)
  /// for an SSL certificate authority (CA) using the SslCaCertificateArn
  /// setting. If an ARN isn't given for a CA, DMS uses the Amazon root CA.
  /// The plaintext option doesn't provide Transport Layer Security (TLS)
  /// encryption for traffic between endpoint and database.
  pub ssl_security_protocol: SslSecurityProtocolValue? = None
  /// The type of authentication to perform when connecting to a Redis target.
  /// Options include none , auth-token , and auth-role . The auth-token
  /// option requires an AuthPassword value to be provided. The auth-role
  /// option requires AuthUserName and AuthPassword values to be provided.
  pub auth_type: RedisAuthTypeValue? = None
  /// The user name provided with the auth-role option of the AuthType setting
  /// for a Redis target endpoint.
  pub auth_user_name: Str? = None
  /// The password provided with the auth-role and auth-token options of the
  /// AuthType setting for a Redis target endpoint.
  pub auth_password: Str? = None
  /// The Amazon Resource Name (ARN) for the certificate authority (CA) that
  /// DMS uses to connect to your Redis target endpoint.
  pub ssl_ca_certificate_arn: Str? = None
}

/// Provides information that defines an Amazon Redshift data provider.
pub struct RedshiftDataProviderSettings {
  /// The name of the Amazon Redshift server.
  pub server_name: Str? = None
  /// The port value for the Amazon Redshift data provider.
  pub port: Int? = None
  /// The database name on the Amazon Redshift data provider.
  pub database_name: Str? = None
  /// The path for the Amazon S3 bucket that the application uses for
  /// accessing the user-defined schema.
  pub s3_path: Str? = None
  /// The ARN for the role the application uses to access its Amazon S3
  /// bucket.
  pub s3_access_role_arn: Str? = None
}

/// Provides information that defines an Amazon Redshift endpoint.
pub struct RedshiftSettings {
  /// A value that indicates to allow any date format, including invalid
  /// formats such as 00/00/00 00:00:00, to be loaded without generating an
  /// error. You can choose true or false (the default). This parameter
  /// applies only to TIMESTAMP and DATE columns. Always use ACCEPTANYDATE
  /// with the DATEFORMAT parameter. If the date format for the data doesn't
  /// match the DATEFORMAT specification, Amazon Redshift inserts a NULL value
  /// into that field.
  pub accept_any_date: Bool? = None
  /// Code to run after connecting. This parameter should contain the code
  /// itself, not the name of a file containing the code.
  pub after_connect_script: Str? = None
  /// An S3 folder where the comma-separated-value (.csv) files are stored
  /// before being uploaded to the target Redshift cluster. For full load
  /// mode, DMS converts source records into .csv files and loads them to the
  /// BucketFolder/TableID path. DMS uses the Redshift COPY command to upload
  /// the .csv files to the target table. The files are deleted once the COPY
  /// operation has finished. For more information, see COPY in the Amazon
  /// Redshift Database Developer Guide . For change-data-capture (CDC) mode,
  /// DMS creates a NetChanges table, and loads the .csv files to this
  /// BucketFolder/NetChangesTableID path.
  pub bucket_folder: Str? = None
  /// The name of the intermediate S3 bucket used to store .csv files before
  /// uploading data to Redshift.
  pub bucket_name: Str? = None
  /// If Amazon Redshift is configured to support case sensitive schema names,
  /// set CaseSensitiveNames to true . The default is false .
  pub case_sensitive_names: Bool? = None
  /// If you set CompUpdate to true Amazon Redshift applies automatic
  /// compression if the table is empty. This applies even if the table
  /// columns already have encodings other than RAW . If you set CompUpdate to
  /// false , automatic compression is disabled and existing column encodings
  /// aren't changed. The default is true .
  pub comp_update: Bool? = None
  /// A value that sets the amount of time to wait (in milliseconds) before
  /// timing out, beginning from when you initially establish a connection.
  pub connection_timeout: Int? = None
  /// The name of the Amazon Redshift data warehouse (service) that you are
  /// working with.
  pub database_name: Str? = None
  /// The date format that you are using. Valid values are auto
  /// (case-sensitive), your date format string enclosed in quotes, or NULL.
  /// If this parameter is left unset (NULL), it defaults to a format of
  /// 'YYYY-MM-DD'. Using auto recognizes most strings, even some that aren't
  /// supported when you use a date format string. If your date and time
  /// values use formats different from each other, set this to auto .
  pub date_format: Str? = None
  /// A value that specifies whether DMS should migrate empty CHAR and VARCHAR
  /// fields as NULL. A value of true sets empty CHAR and VARCHAR fields to
  /// null. The default is false .
  pub empty_as_null: Bool? = None
  /// The type of server-side encryption that you want to use for your data.
  /// This encryption type is part of the endpoint settings or the extra
  /// connections attributes for Amazon S3. You can choose either SSE_S3 (the
  /// default) or SSE_KMS . For the ModifyEndpoint operation, you can change
  /// the existing value of the EncryptionMode parameter from SSE_KMS to
  /// SSE_S3 . But you can’t change the existing value from SSE_S3 to
  /// SSE_KMS . To use SSE_S3 , create an Identity and Access Management (IAM)
  /// role with a policy that allows "arn:aws:s3:::*" to use the following
  /// actions: "s3:PutObject", "s3:ListBucket"
  pub encryption_mode: EncryptionModeValue? = None
  /// This setting is only valid for a full-load migration task. Set
  /// ExplicitIds to true to have tables with IDENTITY columns override their
  /// auto-generated values with explicit values loaded from the source data
  /// files used to populate the tables. The default is false .
  pub explicit_ids: Bool? = None
  /// The number of threads used to upload a single file. This parameter
  /// accepts a value from 1 through 64. It defaults to 10. The number of
  /// parallel streams used to upload a single .csv file to an S3 bucket using
  /// S3 Multipart Upload. For more information, see Multipart upload overview
  /// . FileTransferUploadStreams accepts a value from 1 through 64. It
  /// defaults to 10.
  pub file_transfer_upload_streams: Int? = None
  /// The amount of time to wait (in seconds) before timing out of operations
  /// performed by DMS on a Redshift cluster, such as Redshift COPY, INSERT,
  /// DELETE, and UPDATE.
  pub load_timeout: Int? = None
  /// The maximum size (in KB) of any .csv file used to load data on an S3
  /// bucket and transfer data to Amazon Redshift. It defaults to 1048576KB (1
  /// GB).
  pub max_file_size: Int? = None
  /// The password for the user named in the username property.
  pub password: Str? = None
  /// The port number for Amazon Redshift. The default value is 5439.
  pub port: Int? = None
  /// A value that specifies to remove surrounding quotation marks from
  /// strings in the incoming data. All characters within the quotation marks,
  /// including delimiters, are retained. Choose true to remove quotation
  /// marks. The default is false .
  pub remove_quotes: Bool? = None
  /// A list of characters that you want to replace. Use with ReplaceChars .
  pub replace_invalid_chars: Str? = None
  /// A value that specifies to replaces the invalid characters specified in
  /// ReplaceInvalidChars , substituting the specified characters instead. The
  /// default is "?" .
  pub replace_chars: Str? = None
  /// The name of the Amazon Redshift cluster you are using.
  pub server_name: Str? = None
  /// The Amazon Resource Name (ARN) of the IAM role that has access to the
  /// Amazon Redshift service. The role must allow the iam:PassRole action.
  pub service_access_role_arn: Str? = None
  /// The KMS key ID. If you are using SSE_KMS for the EncryptionMode ,
  /// provide this key ID. The key that you use needs an attached policy that
  /// enables IAM user permissions and allows use of the key.
  pub server_side_encryption_kms_key_id: Str? = None
  /// The time format that you want to use. Valid values are auto
  /// (case-sensitive), 'timeformat_string' , 'epochsecs' , or
  /// 'epochmillisecs' . It defaults to 10. Using auto recognizes most
  /// strings, even some that aren't supported when you use a time format
  /// string. If your date and time values use formats different from each
  /// other, set this parameter to auto .
  pub time_format: Str? = None
  /// A value that specifies to remove the trailing white space characters
  /// from a VARCHAR string. This parameter applies only to columns with a
  /// VARCHAR data type. Choose true to remove unneeded white space. The
  /// default is false .
  pub trim_blanks: Bool? = None
  /// A value that specifies to truncate data in columns to the appropriate
  /// number of characters, so that the data fits in the column. This
  /// parameter applies only to columns with a VARCHAR or CHAR data type, and
  /// rows with a size of 4 MB or less. Choose true to truncate data. The
  /// default is false .
  pub truncate_columns: Bool? = None
  /// An Amazon Redshift user name for a registered user.
  pub username: Str? = None
  /// The size (in KB) of the in-memory file write buffer used when generating
  /// .csv files on the local disk at the DMS replication instance. The
  /// default value is 1000 (buffer size is 1000KB).
  pub write_buffer_size: Int? = None
  /// The full Amazon Resource Name (ARN) of the IAM role that specifies DMS
  /// as the trusted entity and grants the required permissions to access the
  /// value in SecretsManagerSecret . The role must allow the iam:PassRole
  /// action. SecretsManagerSecret has the value of the Amazon Web Services
  /// Secrets Manager secret that allows access to the Amazon Redshift
  /// endpoint. You can specify one of two sets of values for these
  /// permissions. You can specify the values for this setting and
  /// SecretsManagerSecretId . Or you can specify clear-text values for
  /// UserName , Password , ServerName , and Port . You can't specify both.
  /// For more information on creating this SecretsManagerSecret and the
  /// SecretsManagerAccessRoleArn and SecretsManagerSecretId required to
  /// access it, see Using secrets to access Database Migration Service
  /// resources in the Database Migration Service User Guide .
  pub secrets_manager_access_role_arn: Str? = None
  /// The full ARN, partial ARN, or friendly name of the SecretsManagerSecret
  /// that contains the Amazon Redshift endpoint connection details.
  pub secrets_manager_secret_id: Str? = None
  /// When true, lets Redshift migrate the boolean type as boolean. By
  /// default, Redshift migrates booleans as varchar(1) . You must set this
  /// setting on both the source and target endpoints for it to take effect.
  pub map_boolean_as_boolean: Bool? = None
}

