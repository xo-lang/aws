  }
  if let Some(x) = v.creation_time {
    fs.push(("CreationTime", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_endpoint_config_summary(v: json.Value) -> EndpointConfigSummary ! Str {
  var out = EndpointConfigSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "EndpointConfigName" => out.endpoint_config_name = jsonv.read_str(fv)?
      "EndpointConfigArn" => out.endpoint_config_arn = jsonv.read_str(fv)?
      "CreationTime" => out.creation_time = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_endpoint_config_summary_list(v: List[EndpointConfigSummary]) -> json.Value {
  json.Value.List(v.map(fn(x: EndpointConfigSummary) -> json.Value { json_of_endpoint_config_summary(x) }))
}

fn from_json_endpoint_config_summary_list(v: json.Value) -> List[EndpointConfigSummary] ! Str {
  var out: List[EndpointConfigSummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_endpoint_config_summary(fv)?)
  }
  Ok(out)
}

