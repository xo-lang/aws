fn from_json_node_type(v: json.Value) -> NodeType ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Instance" => Ok(NodeType.Instance(from_json_instance_info(fv)?))
      _ => Ok(NodeType.Unknown(k))
    }
  }
  Err("NodeType: no member set")
}

