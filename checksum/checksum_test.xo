// Known answers: "Hello world" as in aws-sdk-go-v2's
// service/internal/checksum tests, and the CRC catalogue's "123456789".

use std/crypto

test "checksums match aws-sdk-go-v2's values" {
  let b = b"Hello world"
  expect(compute("CRC32", b)) == Some("i9aeUg==")
  expect(compute("CRC32C", b)) == Some("crUfeA==")
  expect(compute("SHA1", b)) == Some("e1AsOh9IyGCa4hLN+2Od7jlnP14=")
  expect(compute("SHA256", b)) == Some("ZOyIygCyaOW6GjVnihtTFtIS9PNmskdyMlNKiuyjfzw=")
  expect(compute("crc32", b)) == Some("i9aeUg==")
  expect(compute("XXHASH64", b)) == None
}

test "CRC64NVME matches the catalogue check value" {
  // 0xae8b14860a799888
  expect(compute("CRC64NVME", b"123456789")) == Some("rosUhgp5mIg=")
}

test "a required checksum defaults to CRC32; an algorithm the caller names wins" {
  var h: List[(Str, Str)] = []
  add(h, b"Hello world", None, true)?
  expect(h) == [("x-amz-checksum-crc32", "i9aeUg==")]
  var h2: List[(Str, Str)] = []
  add(h2, b"Hello world", Some("SHA256"), false)?
  expect(h2) == [("x-amz-checksum-sha256", "ZOyIygCyaOW6GjVnihtTFtIS9PNmskdyMlNKiuyjfzw=")]
  var h3: List[(Str, Str)] = []
  add(h3, b"x", None, false)?
  expect(h3) == []
}

test "a checksum the caller supplied is kept" {
  var h = [("Content-MD5", "abc")]
  add(h, b"Hello world", None, true)?
  expect(h.len()) == 1
  var h2 = [("x-amz-checksum-crc32c", "abc")]
  add(h2, b"Hello world", Some("CRC32"), true)?
  expect(h2.len()) == 1
}

test "an unsupported algorithm is an error, not a request without a checksum" {
  var h: List[(Str, Str)] = []
  expect(add(h, b"x", Some("XXHASH3"), true).is_err()) == true
}

test "response validation checks the strongest fast checksum and skips composites" {
  let b = b"Hello world"
  expect(validate([("x-amz-checksum-sha256", "ZOyIygCyaOW6GjVnihtTFtIS9PNmskdyMlNKiuyjfzw="), ("x-amz-checksum-crc32", "i9aeUg==")], b)) == Ok(Some("CRC32"))
  expect(validate([("x-amz-checksum-crc32", "AAAAAA==")], b).is_err()) == true
  expect(validate([("x-amz-checksum-crc32", "i9aeUg==-3")], b)) == Ok(None)
  expect(validate([], b)) == Ok(None)
}

test "Glacier's tree hash: one chunk is its SHA-256; several combine pairwise" {
  let one = b"Hello world"
  expect(tree_hash(one)) == crypto.digest(crypto.Hash.Sha256, one).to_hex()
  expect(tree_hash(b"")) == ""
  // 3 MiB and a byte: four chunks, hashed in pairs then together
  let mib = 1048576
  let body = "a".repeat(3 * mib + 1).bytes()
  let h = [0, 1, 2, 3].map(fn(k: Int) -> Bytes {
    let end = if (k + 1) * mib < body.len() { (k + 1) * mib } else { body.len() }
    crypto.digest(crypto.Hash.Sha256, body[k * mib..end])
  })
  let left = crypto.digest(crypto.Hash.Sha256, h[0] + h[1])
  let right = crypto.digest(crypto.Hash.Sha256, h[2] + h[3])
  expect(tree_hash(body)) == crypto.digest(crypto.Hash.Sha256, left + right).to_hex()
  // three chunks: the third is carried up unpaired
  let body3 = "b".repeat(2 * mib + 5).bytes()
  let a = crypto.digest(crypto.Hash.Sha256, body3[0..mib])
  let b = crypto.digest(crypto.Hash.Sha256, body3[mib..2 * mib])
  let c = crypto.digest(crypto.Hash.Sha256, body3[2 * mib..body3.len()])
  expect(tree_hash(body3)) == crypto.digest(crypto.Hash.Sha256, crypto.digest(crypto.Hash.Sha256, a + b) + c).to_hex()
}

test "a running checksum matches the whole body's" {
  let body = "hello, streaming world".bytes()
  for alg in ["CRC32", "CRC32C", "CRC64NVME", "SHA1", "SHA256"] {
    var r = running(alg) ?? return Err("no ${alg}")
    write(r, body[0..5])
    write(r, body[5..body.len()])
    expect(sum(r)) == (compute(alg, body) ?? "")
    expect(sum(r).len()) == encoded_len(alg)
  }
}

test "the unsigned aws-chunked encoding and its length" {
  let data = "hello".bytes()
  let v = compute("CRC32", data) ?? ""
  let enc = chunk(data) + chunked_end("CRC32", v)
  expect(enc.to_str_lossy()) == "5\r\nhello\r\n0\r\nx-amz-checksum-crc32:${v}\r\n\r\n"
  expect(chunked_length(5, "CRC32")) == enc.len()
  expect(chunked_length(0, "SHA256")) == chunked_end("SHA256", compute("SHA256", b"") ?? "").len()
  // two full chunks and a partial one
  let big = 2 * CHUNK + 10
  expect(chunked_length(big, "CRC32")) == 2 * (5 + 2 + CHUNK + 2) + (1 + 2 + 10 + 2) + "0\r\nx-amz-checksum-crc32:AAAAAA==\r\n\r\n".len()
}
