fn json_of_target_definition(v: TargetDefinition) -> json.Value {
  match v {
    Kinesis(x) => json.Value.Object([("kinesis", json_of_kinesis_target_definition(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_target_definition(v: json.Value) -> TargetDefinition ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "kinesis" => Ok(TargetDefinition.Kinesis(from_json_kinesis_target_definition(fv)?))
      _ => Ok(TargetDefinition.Unknown(k))
    }
  }
  Err("TargetDefinition: no member set")
}

