  /// your user pool, see Using Your Own Domain for the Hosted UI .
  pub custom_domain: Str? = None
  /// The configuration for AdminCreateUser requests.
  pub admin_create_user_config: AdminCreateUserConfigType? = None
  /// Contains settings for activation of threat protection, including the
  /// operating mode and additional authentication types. To log user security
