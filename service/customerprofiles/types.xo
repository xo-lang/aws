  pub matching_rules: List[MatchingRule]? = None
  /// PENDING The first status after configuration a rule-based matching rule.
  /// If it is an existing domain, the rule-based Identity Resolution waits
  /// one hour before creating the matching rule. If it is a new domain, the
  /// system will skip the PENDING stage. IN_PROGRESS The system is creating
  /// the rule-based matching rule. Under this status, the system is
  /// evaluating the existing data and you can no longer change the Rule-based
  /// matching configuration. ACTIVE The rule is ready to use. You can change
  /// the rule a day after the status is in ACTIVE .
  pub status: RuleBasedMatchingStatus? = None
  /// MatchingRule
  pub max_allowed_rule_level_for_merging: Int? = None
  /// Indicates the maximum allowed rule level.
  pub max_allowed_rule_level_for_matching: Int? = None
  /// Configures information about the AttributeTypesSelector where the
  /// rule-based identity resolution uses to match profiles.
  pub attribute_types_selector: AttributeTypesSelector? = None
  pub conflict_resolution: ConflictResolution? = None
  pub exporting_config: ExportingConfig? = None
}

