  Ok(out)
}

/// The errors of UpdateRelationship.
pub enum UpdateRelationshipErr {
  AccessDeniedException(e: AccessDeniedException)
  ConflictException(e: ConflictException)
  InternalServerException(e: InternalServerException)
  ResourceNotFoundException(e: ResourceNotFoundException)
  ThrottlingException(e: ThrottlingException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UpdateRelationshipErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_relationship_error(resp: http.Response) -> UpdateRelationshipErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return UpdateRelationshipErr.AccessDeniedException(x)
      Err(msg) => return UpdateRelationshipErr.Deserialize(msg)
    }
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UpdateRelationshipErr.ConflictException(x)
      Err(msg) => return UpdateRelationshipErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return UpdateRelationshipErr.InternalServerException(x)
      Err(msg) => return UpdateRelationshipErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateRelationshipErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateRelationshipErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateRelationshipErr.ThrottlingException(x)
      Err(msg) => return UpdateRelationshipErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateRelationshipErr.ValidationException(x)
      Err(msg) => return UpdateRelationshipErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateRelationshipErr.Api(restjson.api_error(resp, body))
}

/// Updates the properties of a partner relationship.
pub fn (c: Client) update_relationship(input: UpdateRelationshipRequest) -> UpdateRelationshipResponse ! UpdateRelationshipErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_relationship(c.params, input)) ?? e => return Err(UpdateRelationshipErr.InvalidInput(e))
  var req = serialize_update_relationship(ep, input, "") ?? e => return Err(UpdateRelationshipErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateRelationshipErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_relationship_error(resp))
  }
  deserialize_update_relationship(resp) ?? e => Err(UpdateRelationshipErr.Deserialize(e))
}
