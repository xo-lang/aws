pub struct ServiceId {
  pub name: Str? = None
  pub names: List[Str]? = None
  pub account_id: Str? = None
  pub type_value: Str? = None
}

/// Response statistics for a service.
pub struct ServiceStatistics {
  /// The number of requests that completed with a 2xx Success status code.
  pub ok_count: Int? = None
  /// Information about requests that failed with a 4xx Client Error status
  /// code.
  pub error_statistics: ErrorStatistics? = None
  /// Information about requests that failed with a 5xx Server Error status
  /// code.
  pub fault_statistics: FaultStatistics? = None
  /// The total number of completed requests.
  pub total_count: Int? = None
  /// The aggregate response time of completed requests.
  pub total_response_time: Float? = None
}

/// A span from a trace that has been ingested by the X-Ray service. A span
/// represents a unit of work or an operation performed by a service.
pub struct Span {
  /// The span ID.
  pub id: Str? = None
  /// The span document.
  pub document: Str? = None
}

pub struct StartTraceRetrievalRequest {
  /// Specify the trace IDs of the traces to be retrieved.
  pub trace_ids: List[Str]? = None
  /// The start of the time range to retrieve traces. The range is inclusive,
  /// so the specified start time is included in the query. Specified as epoch
  /// time, the number of seconds since January 1, 1970, 00:00:00 UTC.
  pub start_time: Time? = None
  /// The end of the time range to retrieve traces. The range is inclusive, so
  /// the specified end time is included in the query. Specified as epoch
  /// time, the number of seconds since January 1, 1970, 00:00:00 UTC.
  pub end_time: Time? = None
}

pub struct StartTraceRetrievalResult {
  /// Retrieval token.
  pub retrieval_token: Str? = None
}

/// A map that contains tag keys and tag values to attach to an Amazon Web
/// Services X-Ray group or sampling rule. For more information about ways
/// to use tags, see Tagging Amazon Web Services resources in the Amazon Web
/// Services General Reference . The following restrictions apply to tags:
/// Maximum number of user-applied tags per resource: 50 Tag keys and values
/// are case sensitive. Don't use aws: as a prefix for keys; it's reserved
/// for Amazon Web Services use. You cannot edit or delete system tags.
pub struct Tag {
  /// A tag key, such as Stage or Name . A tag key cannot be empty. The key
  /// can be a maximum of 128 characters, and can contain only Unicode
  /// letters, numbers, or separators, or the following special characters: +
  /// - = . _ : /
  pub key: Str? = None
  /// An optional tag value, such as Production or test-only . The value can
  /// be a maximum of 255 characters, and contain only Unicode letters,
  /// numbers, or separators, or the following special characters: + - = . _ :
  /// /
  pub value: Str? = None
}

pub struct TagResourceRequest {
  /// The Amazon Resource Number (ARN) of an X-Ray group or sampling rule.
  pub resource_arn: Str? = None
  /// A map that contains one or more tag keys and tag values to attach to an
  /// X-Ray group or sampling rule. For more information about ways to use
  /// tags, see Tagging Amazon Web Services resources in the Amazon Web
  /// Services General Reference . The following restrictions apply to tags:
  /// Maximum number of user-applied tags per resource: 50 Maximum tag key
  /// length: 128 Unicode characters Maximum tag value length: 256 Unicode
  /// characters Valid values for key and value: a-z, A-Z, 0-9, space, and the
  /// following characters: _ . : / = + - and @ Tag keys and values are case
  /// sensitive. Don't use aws: as a prefix for keys; it's reserved for Amazon
  /// Web Services use. You cannot edit or delete system tags.
  pub tags: List[Tag]? = None
}

pub struct TagResourceResponse {
}

pub struct TelemetryRecord {
  pub timestamp: Time? = None
  pub segments_received_count: Int? = None
  pub segments_sent_count: Int? = None
  pub segments_spillover_count: Int? = None
  pub segments_rejected_count: Int? = None
  pub backend_connection_errors: BackendConnectionErrors? = None
}

/// The request exceeds the maximum number of requests per second.
pub struct ThrottledException {
  pub message: Str? = None
}

pub enum TimeRangeType: Str {
  TraceId = "TraceId"
  Event = "Event"
  Service = "Service"
  Unknown(value: Str)
}

/// A list of TimeSeriesStatistic structures.
pub struct TimeSeriesServiceStatistics {
  /// Timestamp of the window for which statistics are aggregated.
  pub timestamp: Time? = None
  pub edge_summary_statistics: EdgeStatistics? = None
  pub service_summary_statistics: ServiceStatistics? = None
  /// The forecasted high and low fault count values.
  pub service_forecast_statistics: ForecastStatistics? = None
  /// The response time histogram for the selected entities.
  pub response_time_histogram: List[HistogramEntry]? = None
}

/// You have exceeded the maximum number of tags you can apply to this
/// resource.
pub struct TooManyTagsException {
  pub message: Str? = None
  pub resource_name: Str? = None
}

/// A collection of segment documents with matching trace IDs.
pub struct Trace {
  /// The unique identifier for the request that generated the trace's
  /// segments and subsegments.
  pub id: Str? = None
  /// The length of time in seconds between the start time of the earliest
  /// segment that started and the end time of the last segment that
  /// completed.
  pub duration: Float? = None
  /// LimitExceeded is set to true when the trace has exceeded the Trace
  /// document size limit. For more information about this limit and other
  /// X-Ray limits and quotas, see Amazon Web Services X-Ray endpoints and
  /// quotas .
  pub limit_exceeded: Bool? = None
  /// Segment documents for the segments and subsegments that comprise the
  /// trace.
  pub segments: List[Segment]? = None
}

pub enum TraceFormatType: Str {
  Xray = "XRAY"
  Otel = "OTEL"
  Unknown(value: Str)
}

pub enum TraceSegmentDestination: Str {
  XRay = "XRay"
  CloudWatchLogs = "CloudWatchLogs"
  Unknown(value: Str)
}

pub enum TraceSegmentDestinationStatus: Str {
  Pending = "PENDING"
  Active = "ACTIVE"
  Unknown(value: Str)
}

/// Metadata generated from the segment documents in a trace.
pub struct TraceSummary {
  /// The unique identifier for the request that generated the trace's
  /// segments and subsegments.
  pub id: Str? = None
  /// The start time of a trace, based on the earliest trace segment start
  /// time.
  pub start_time: Time? = None
  /// The length of time in seconds between the start time of the earliest
  /// segment that started and the end time of the last segment that
  /// completed.
  pub duration: Float? = None
  /// The length of time in seconds between the start and end times of the
  /// root segment. If the service performs work asynchronously, the response
  /// time measures the time before the response is sent to the user, while
  /// the duration measures the amount of time before the last traced activity
  /// completes.
  pub response_time: Float? = None
  /// The root segment document has a 500 series error.
  pub has_fault: Bool? = None
  /// The root segment document has a 400 series error.
  pub has_error: Bool? = None
  /// One or more of the segment documents has a 429 throttling error.
  pub has_throttle: Bool? = None
  /// One or more of the segment documents is in progress.
  pub is_partial: Bool? = None
  /// Information about the HTTP request served by the trace.
  pub http: Http? = None
  /// Annotations from the trace's segment documents.
  pub annotations: Map[Str, List[ValueWithServiceIds]]? = None
  /// Users from the trace's segment documents.
  pub users: List[TraceUser]? = None
  /// Service IDs from the trace's segment documents.
  pub service_ids: List[ServiceId]? = None
  /// A list of resource ARNs for any resource corresponding to the trace
  /// segments.
  pub resource_arns: List[ResourceARNDetail]? = None
  /// A list of EC2 instance IDs for any instance corresponding to the trace
  /// segments.
  pub instance_ids: List[InstanceIdDetail]? = None
  /// A list of Availability Zones for any zone corresponding to the trace
  /// segments.
  pub availability_zones: List[AvailabilityZoneDetail]? = None
  /// The root of a trace.
  pub entry_point: ServiceId? = None
  /// A collection of FaultRootCause structures corresponding to the trace
  /// segments.
  pub fault_root_causes: List[FaultRootCause]? = None
  /// A collection of ErrorRootCause structures corresponding to the trace
  /// segments.
  pub error_root_causes: List[ErrorRootCause]? = None
  /// A collection of ResponseTimeRootCause structures corresponding to the
  /// trace segments.
  pub response_time_root_causes: List[ResponseTimeRootCause]? = None
  /// The revision number of a trace.
  pub revision: Int? = None
  /// The matched time stamp of a defined event.
  pub matched_event_time: Time? = None
}

/// Information about a user recorded in segment documents.
pub struct TraceUser {
  /// The user's name.
  pub user_name: Str? = None
  /// Services that the user's request hit.
  pub service_ids: List[ServiceId]? = None
}

/// Sampling statistics from a call to GetSamplingTargets that X-Ray could
/// not process.
pub struct UnprocessedStatistics {
  /// The name of the sampling rule.
  pub rule_name: Str? = None
  /// The error code.
  pub error_code: Str? = None
  /// The error message.
  pub message: Str? = None
}

/// Information about a segment that failed processing.
pub struct UnprocessedTraceSegment {
  /// The segment's ID.
  pub id: Str? = None
  /// The error that caused processing to fail.
  pub error_code: Str? = None
  /// The error message.
  pub message: Str? = None
}

pub struct UntagResourceRequest {
  /// The Amazon Resource Number (ARN) of an X-Ray group or sampling rule.
  pub resource_arn: Str? = None
  /// Keys for one or more tags that you want to remove from an X-Ray group or
  /// sampling rule.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

pub struct UpdateGroupRequest {
  /// The case-sensitive name of the group.
  pub group_name: Str? = None
  /// The ARN that was generated upon creation.
  pub group_arn: Str? = None
  /// The updated filter expression defining criteria by which to group
  /// traces.
  pub filter_expression: Str? = None
  /// The structure containing configurations related to insights. The
  /// InsightsEnabled boolean can be set to true to enable insights for the
  /// group or false to disable insights for the group. The
  /// NotificationsEnabled boolean can be set to true to enable insights
  /// notifications for the group. Notifications can only be enabled on a
  /// group with InsightsEnabled set to true.
  pub insights_configuration: InsightsConfiguration? = None
}

pub struct UpdateGroupResult {
  /// The group that was updated. Contains the name of the group that was
  /// updated, the ARN of the group that was updated, the updated filter
  /// expression, and the updated insight configuration assigned to the group.
  pub group: Group? = None
}

pub struct UpdateIndexingRuleRequest {
  /// Name of the indexing rule to be updated.
  pub name: Str? = None
  /// Rule configuration to be updated.
  pub rule: IndexingRuleValueUpdate? = None
}

pub struct UpdateIndexingRuleResult {
  /// Updated indexing rule.
  pub indexing_rule: IndexingRule? = None
}

pub struct UpdateSamplingRuleRequest {
  /// The rule and fields to change.
  pub sampling_rule_update: SamplingRuleUpdate? = None
}

pub struct UpdateSamplingRuleResult {
  /// The updated rule definition and metadata.
  pub sampling_rule_record: SamplingRuleRecord? = None
}

pub struct UpdateTraceSegmentDestinationRequest {
  /// The configured destination of trace segments.
  pub destination: TraceSegmentDestination? = None
  /// Specifies settings for the CloudWatch Logs log groups that X-Ray creates
  /// for Transaction Search. Specify this only when Destination is
  /// CloudWatchLogs .
  pub cloud_watch_logs_configuration: CloudWatchLogsConfiguration? = None
}

pub struct UpdateTraceSegmentDestinationResult {
  /// The destination of the trace segments.
  pub destination: TraceSegmentDestination? = None
  /// The status of the update.
  pub status: TraceSegmentDestinationStatus? = None
}

/// Information about a segment annotation.
pub struct ValueWithServiceIds {
  /// Values of the annotation.
  pub annotation_value: AnnotationValue? = None
  /// Services to which the annotation applies.
  pub service_ids: List[ServiceId]? = None
}
