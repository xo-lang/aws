fn json_of_schedule(v: Schedule) -> json.Value {
  match v {
    At(x) => json.Value.Object([("at", jsonv.time(x, "epoch-seconds"))])
    Cron(x) => json.Value.Object([("cron", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_schedule(v: json.Value) -> Schedule ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "at" => Ok(Schedule.At(jsonv.read_time(fv, "epoch-seconds")?))
      "cron" => Ok(Schedule.Cron(jsonv.read_str(fv)?))
      _ => Ok(Schedule.Unknown(k))
    }
  }
  Err("Schedule: no member set")
}

