fn json_of_compute_configuration(v: ComputeConfiguration) -> json.Value {
  match v {
    Worker(x) => json.Value.Object([("worker", json_of_worker_compute_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_compute_configuration(v: json.Value) -> ComputeConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "worker" => Ok(ComputeConfiguration.Worker(from_json_worker_compute_configuration(fv)?))
      _ => Ok(ComputeConfiguration.Unknown(k))
    }
  }
  Err("ComputeConfiguration: no member set")
}

