pub struct UpdateEntitlementRequest {
  /// The name of the entitlement.
  pub name: Str? = None
  /// The name of the stack with which the entitlement is associated.
  pub stack_name: Str? = None
  /// The description of the entitlement.
  pub description: Str? = None
  /// Specifies whether all or only selected apps are entitled.
  pub app_visibility: AppVisibility? = None
  /// The attributes of the entitlement.
  pub attributes: List[EntitlementAttribute]? = None
}

pub struct UpdateEntitlementResult {
  /// The entitlement.
  pub entitlement: Entitlement? = None
}

pub struct UpdateFleetRequest {
  /// The name of the image used to create the fleet.
  pub image_name: Str? = None
  /// The ARN of the public, private, or shared image to use.
  pub image_arn: Str? = None
  /// A unique name for the fleet.
  pub name: Str? = None
  /// The instance type to use when launching fleet instances. The following
  /// instance types are available: stream.standard.small
  /// stream.standard.medium stream.standard.large stream.standard.xlarge
  /// stream.standard.2xlarge stream.compute.large stream.compute.xlarge
  /// stream.compute.2xlarge stream.compute.4xlarge stream.compute.8xlarge
  /// stream.memory.large stream.memory.xlarge stream.memory.2xlarge
  /// stream.memory.4xlarge stream.memory.8xlarge stream.memory.z1d.large
  /// stream.memory.z1d.xlarge stream.memory.z1d.2xlarge
  /// stream.memory.z1d.3xlarge stream.memory.z1d.6xlarge
  /// stream.memory.z1d.12xlarge stream.graphics.g4dn.xlarge
  /// stream.graphics.g4dn.2xlarge stream.graphics.g4dn.4xlarge
  /// stream.graphics.g4dn.8xlarge stream.graphics.g4dn.12xlarge
  /// stream.graphics.g4dn.16xlarge stream.graphics.g5.xlarge
  /// stream.graphics.g5.2xlarge stream.graphics.g5.4xlarge
  /// stream.graphics.g5.8xlarge stream.graphics.g5.16xlarge
  /// stream.graphics.g5.12xlarge stream.graphics.g5.24xlarge
  /// stream.graphics.g6.xlarge stream.graphics.g6.2xlarge
  /// stream.graphics.g6.4xlarge stream.graphics.g6.8xlarge
  /// stream.graphics.g6.16xlarge stream.graphics.g6.12xlarge
  /// stream.graphics.g6.24xlarge stream.graphics.gr6.4xlarge
  /// stream.graphics.gr6.8xlarge stream.graphics.g6f.large
  /// stream.graphics.g6f.xlarge stream.graphics.g6f.2xlarge
  /// stream.graphics.g6f.4xlarge stream.graphics.gr6f.4xlarge The following
  /// instance types are available for Elastic fleets: stream.standard.small
  /// stream.standard.medium stream.standard.large stream.standard.xlarge
  /// stream.standard.2xlarge
  pub instance_type: Str? = None
  /// The desired capacity for the fleet. This is not allowed for Elastic
  /// fleets.
  pub compute_capacity: ComputeCapacity? = None
  /// The VPC configuration for the fleet. This is required for Elastic
  /// fleets, but not required for other fleet types. Elastic fleets require
  /// that you specify at least two subnets in different availability zones.
  pub vpc_config: VpcConfig? = None
  /// The maximum amount of time that a streaming session can remain active,
  /// in seconds. If users are still connected to a streaming instance five
  /// minutes before this limit is reached, they are prompted to save any open
  /// documents before being disconnected. After this time elapses, the
  /// instance is terminated and replaced by a new instance. Specify a value
  /// between 600 and 432000.
  pub max_user_duration_in_seconds: Int? = None
  /// The amount of time that a streaming session remains active after users
  /// disconnect. If users try to reconnect to the streaming session after a
  /// disconnection or network interruption within this time interval, they
  /// are connected to their previous session. Otherwise, they are connected
  /// to a new session with a new streaming instance. Specify a value between
  /// 60 and 36000.
  pub disconnect_timeout_in_seconds: Int? = None
  /// Deletes the VPC association for the specified fleet.
  pub delete_vpc_config: Bool? = None
  /// The description to display.
  pub description: Str? = None
  /// The fleet name to display.
  pub display_name: Str? = None
  /// Enables or disables default internet access for the fleet.
  pub enable_default_internet_access: Bool? = None
  /// The name of the directory and organizational unit (OU) to use to join
  /// the fleet to a Microsoft Active Directory domain.
  pub domain_join_info: DomainJoinInfo? = None
  /// The amount of time that users can be idle (inactive) before they are
  /// disconnected from their streaming session and the
  /// DisconnectTimeoutInSeconds time interval begins. Users are notified
  /// before they are disconnected due to inactivity. If users try to
  /// reconnect to the streaming session before the time interval specified in
  /// DisconnectTimeoutInSeconds elapses, they are connected to their previous
  /// session. Users are considered idle when they stop providing keyboard or
  /// mouse input during their streaming session. File uploads and downloads,
  /// audio in, audio out, and pixels changing do not qualify as user
  /// activity. If users continue to be idle after the time interval in
  /// IdleDisconnectTimeoutInSeconds elapses, they are disconnected. To
  /// prevent users from being disconnected due to inactivity, specify a value
  /// of 0. Otherwise, specify a value between 60 and 36000. The default value
  /// is 0. If you enable this feature, we recommend that you specify a value
  /// that corresponds exactly to a whole number of minutes (for example, 60,
  /// 120, and 180). If you don't do this, the value is rounded to the nearest
  /// minute. For example, if you specify a value of 70, users are
  /// disconnected after 1 minute of inactivity. If you specify a value that
  /// is at the midpoint between two different minutes, the value is rounded
  /// up. For example, if you specify a value of 90, users are disconnected
  /// after 2 minutes of inactivity.
  pub idle_disconnect_timeout_in_seconds: Int? = None
  /// The fleet attributes to delete.
  pub attributes_to_delete: List[FleetAttribute]? = None
  /// The Amazon Resource Name (ARN) of the IAM role to apply to the fleet. To
  /// assume a role, a fleet instance calls the AWS Security Token Service
  /// (STS) AssumeRole API operation and passes the ARN of the role to use.
  /// The operation creates a new session with temporary credentials.
  /// WorkSpaces Applications retrieves the temporary credentials and creates
  /// the appstream_machine_role credential profile on the instance. For more
  /// information, see Using an IAM Role to Grant Permissions to Applications
  /// and Scripts Running on WorkSpaces Applications Streaming Instances in
  /// the Amazon WorkSpaces Applications Administration Guide .
  pub iam_role_arn: Str? = None
  /// The WorkSpaces Applications view that is displayed to your users when
  /// they stream from the fleet. When APP is specified, only the windows of
  /// applications opened by users display. When DESKTOP is specified, the
  /// standard desktop that is provided by the operating system displays. The
  /// default value is APP .
  pub stream_view: StreamView? = None
  /// The platform of the fleet. WINDOWS_SERVER_2019, AMAZON_LINUX2 and
  /// UBUNTU_PRO_2404 are supported for Elastic fleets.
  pub platform: PlatformType? = None
  /// The maximum number of concurrent sessions for a fleet.
  pub max_concurrent_sessions: Int? = None
  /// The USB device filter strings that specify which USB devices a user can
  /// redirect to the fleet streaming session, when using the Windows native
  /// client. This is allowed but not required for Elastic fleets.
  pub usb_device_filter_strings: List[Str]? = None
  /// The S3 location of the session scripts configuration zip file. This only
  /// applies to Elastic fleets.
  pub session_script_s3_location: S3Location? = None
  /// The maximum number of user sessions on an instance. This only applies to
  /// multi-session fleets.
  pub max_sessions_per_instance: Int? = None
  /// The updated configuration for the root volume of fleet instances. Note
  /// that volume size cannot be decreased below the image volume size.
  pub root_volume_config: VolumeConfig? = None
  /// Set to true to disable Instance Metadata Service Version 1 (IMDSv1) and
  /// enforce IMDSv2. Set to false to enable both IMDSv1 and IMDSv2. Before
  /// disabling IMDSv1, ensure your WorkSpaces Applications images are running
  /// the agent version or managed image update released on or after January
  /// 16, 2024 to support IMDSv2 enforcement.
  pub disable_imdsv1: Bool? = None
}

pub struct UpdateFleetResult {
  /// Information about the fleet.
  pub fleet: Fleet? = None
}

pub struct UpdateImagePermissionsRequest {
  /// The name of the private image.
  pub name: Str? = None
  /// The 12-digit identifier of the AWS account for which you want add or
  /// update image permissions.
  pub shared_account_id: Str? = None
  /// The permissions for the image.
  pub image_permissions: ImagePermissions? = None
}

pub struct UpdateImagePermissionsResult {
}

pub struct UpdateStackRequest {
  /// The stack name to display.
  pub display_name: Str? = None
  /// The description to display.
  pub description: Str? = None
  /// The name of the stack.
  pub name: Str? = None
  /// The storage connectors to enable.
  pub storage_connectors: List[StorageConnector]? = None
  /// Deletes the storage connectors currently enabled for the stack.
  pub delete_storage_connectors: Bool? = None
  /// The URL that users are redirected to after their streaming session ends.
  pub redirect_url: Str? = None
  /// The URL that users are redirected to after they choose the Send Feedback
  /// link. If no URL is specified, no Send Feedback link is displayed.
  pub feedback_url: Str? = None
  /// The stack attributes to delete.
  pub attributes_to_delete: List[StackAttribute]? = None
  /// The actions that are enabled or disabled for users during their
  /// streaming sessions. By default, these actions are enabled.
  pub user_settings: List[UserSetting]? = None
  /// The persistent application settings for users of a stack. When these
  /// settings are enabled, changes that users make to applications and
  /// Windows settings are automatically saved after each session and applied
  /// to the next session.
  pub application_settings: ApplicationSettings? = None
  /// The list of interface VPC endpoint (interface endpoint) objects. Users
  /// of the stack can connect to WorkSpaces Applications only through the
  /// specified endpoints.
  pub access_endpoints: List[AccessEndpoint]? = None
  /// The domains where WorkSpaces Applications streaming sessions can be
  /// embedded in an iframe. You must approve the domains that you want to
  /// host embedded WorkSpaces Applications streaming sessions.
  pub embed_host_domains: List[Str]? = None
  /// The streaming protocol you want your stack to prefer. This can be UDP or
  /// TCP. Currently, UDP is only supported in the Windows native client.
  pub streaming_experience_settings: StreamingExperienceSettings? = None
  pub content_redirection: ContentRedirection? = None
  /// The configuration for agent access on the stack. Specify this to update
  /// agent access settings. To remove agent access, use AttributesToDelete
  /// with the AGENT_ACCESS_CONFIG value.
  pub agent_access_config: AgentAccessConfigForUpdate? = None
  /// Specifies whether users' cloud storage authentication persists across
  /// streaming sessions. When you specify FORCE_REAUTHENTICATION, WorkSpaces
  /// Applications removes the stored authentication for the stack's OneDrive
  /// and Google Drive connectors when a user's session ends. The user links
  /// their cloud storage again on their next session. To clear this
  /// attribute, add STORAGE_CONNECTOR_AUTHENTICATION to AttributesToDelete.
  pub storage_connector_authentication: StorageConnectorAuthentication? = None
}

pub struct UpdateStackResult {
  /// Information about the stack.
  pub stack: Stack? = None
}

pub struct UpdateThemeForStackRequest {
  /// The name of the stack for the theme.
  pub stack_name: Str? = None
  /// The links that are displayed in the footer of the streaming application
  /// catalog page. These links are helpful resources for users, such as the
  /// organization's IT support and product marketing sites.
  pub footer_links: List[ThemeFooterLink]? = None
  /// The title that is displayed at the top of the browser tab during users'
  /// application streaming sessions.
  pub title_text: Str? = None
  /// The color theme that is applied to website links, text, and buttons.
  /// These colors are also applied as accents in the background for the
  /// streaming application catalog page.
  pub theme_styling: ThemeStyling? = None
  /// The organization logo that appears on the streaming application catalog
  /// page.
  pub organization_logo_s3_location: S3Location? = None
  /// The S3 location of the favicon. The favicon enables users to recognize
  /// their application streaming site in a browser full of tabs or bookmarks.
  /// It is displayed at the top of the browser tab for the application
  /// streaming site during users' streaming sessions.
  pub favicon_s3_location: S3Location? = None
  /// Specifies whether custom branding should be applied to catalog page or
  /// not.
  pub state: ThemeState? = None
  /// The attributes to delete.
  pub attributes_to_delete: List[ThemeAttribute]? = None
}

pub struct UpdateThemeForStackResult {
  /// The theme object that contains the metadata of the custom branding.
  pub theme: Theme? = None
}

/// Configuration for URL redirection in a specific direction
/// (host-to-client or client-to-host). When enabled, URLs matching the
/// allowed or denied patterns are redirected accordingly. The denied list
/// takes precedence over the allowed list.
pub struct UrlRedirectionConfig {
  /// Whether URL redirection is enabled for this direction.
  pub enabled: Bool? = None
  /// List of URL patterns that are allowed to be redirected. URLs matching
  /// these patterns will be redirected unless they also match a pattern in
  /// the denied list.
  pub allowed_urls: List[Str]? = None
  /// List of URL patterns that are denied from redirection. This list takes
  /// precedence over the allowed list.
  pub denied_urls: List[Str]? = None
}

pub enum UsageReportExecutionErrorCode: Str {
  ResourceNotFound = "RESOURCE_NOT_FOUND"
  AccessDenied = "ACCESS_DENIED"
  InternalServiceError = "INTERNAL_SERVICE_ERROR"
  Unknown(value: Str)
}

pub enum UsageReportSchedule: Str {
  Daily = "DAILY"
  Unknown(value: Str)
}

/// Describes information about the usage report subscription.
pub struct UsageReportSubscription {
  /// The Amazon S3 bucket where generated reports are stored. If you enabled
  /// on-instance session scripts and Amazon S3 logging for your session
  /// script configuration, WorkSpaces Applications created an S3 bucket to
  /// store the script output. The bucket is unique to your account and
  /// Region. When you enable usage reporting in this case, WorkSpaces
  /// Applications uses the same bucket to store your usage reports. If you
  /// haven't already enabled on-instance session scripts, when you enable
  /// usage reports, WorkSpaces Applications creates a new S3 bucket.
  pub s3_bucket_name: Str? = None
  /// The schedule for generating usage reports.
  pub schedule: UsageReportSchedule? = None
  /// The time when the last usage report was generated.
  pub last_generated_report_date: Time? = None
  /// The errors that were returned if usage reports couldn't be generated.
  pub subscription_errors: List[LastReportGenerationExecutionError]? = None
}

/// Describes a user in the user pool.
pub struct User {
  /// The ARN of the user.
  pub arn: Str? = None
  /// The email address of the user. Users' email addresses are
  /// case-sensitive.
  pub user_name: Str? = None
  /// Specifies whether the user in the user pool is enabled.
  pub enabled: Bool? = None
  /// The status of the user in the user pool. The status can be one of the
  /// following: UNCONFIRMED – The user is created but not confirmed.
  /// CONFIRMED – The user is confirmed. ARCHIVED – The user is no longer
  /// active. COMPROMISED – The user is disabled because of a potential
  /// security threat. UNKNOWN – The user status is not known.
  pub status: Str? = None
  /// The first name, or given name, of the user.
  pub first_name: Str? = None
  /// The last name, or surname, of the user.
  pub last_name: Str? = None
  /// The date and time the user was created in the user pool.
  pub created_time: Time? = None
  /// The authentication type for the user.
  pub authentication_type: AuthenticationType? = None
}

/// The user control mode for agent sessions. VIEW_ONLY - Users can view and
/// observe agent actions as they happen. VIEW_STOP - Users can view agent
/// actions and stop the agent if needed. DISABLED - Users cannot view or
/// stop the agent session.
pub enum UserControlMode: Str {
  ViewOnly = "VIEW_ONLY"
  ViewStop = "VIEW_STOP"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// Describes an action and whether the action is enabled or disabled for
/// users during their streaming sessions.
pub struct UserSetting {
  /// The action that is enabled or disabled.
  pub action: Action? = None
  /// Indicates whether the action is enabled or disabled.
  pub permission: Permission? = None
  /// Specifies the number of characters that can be copied by end users from
  /// the local device to the remote session, and to the local device from the
  /// remote session. This can be specified only for the
  /// CLIPBOARD_COPY_FROM_LOCAL_DEVICE and CLIPBOARD_COPY_TO_LOCAL_DEVICE
  /// actions. This defaults to 20,971,520 (20 MB) when unspecified and the
  /// permission is ENABLED . This can't be specified when the permission is
  /// DISABLED . The value can be between 1 and 20,971,520 (20 MB).
  pub maximum_length: Int? = None
}

/// Describes a user in the user pool and the associated stack.
pub struct UserStackAssociation {
  /// The name of the stack that is associated with the user.
  pub stack_name: Str? = None
  /// The email address of the user who is associated with the stack. Users'
  /// email addresses are case-sensitive.
  pub user_name: Str? = None
  /// The authentication type for the user.
  pub authentication_type: AuthenticationType? = None
  /// Specifies whether a welcome email is sent to a user after the user is
  /// created in the user pool.
  pub send_email_notification: Bool? = None
}

/// Describes the error that is returned when a user can’t be associated
/// with or disassociated from a stack.
pub struct UserStackAssociationError {
  /// Information about the user and associated stack.
  pub user_stack_association: UserStackAssociation? = None
  /// The error code for the error that is returned when a user can’t be
  /// associated with or disassociated from a stack.
  pub error_code: UserStackAssociationErrorCode? = None
  /// The error message for the error that is returned when a user can’t be
  /// associated with or disassociated from a stack.
  pub error_message: Str? = None
}

pub enum UserStackAssociationErrorCode: Str {
  StackNotFound = "STACK_NOT_FOUND"
  UserNameNotFound = "USER_NAME_NOT_FOUND"
  DirectoryNotFound = "DIRECTORY_NOT_FOUND"
  InternalError = "INTERNAL_ERROR"
  Unknown(value: Str)
}

pub enum VisibilityType: Str {
  Public = "PUBLIC"
  Private = "PRIVATE"
  Shared = "SHARED"
  Unknown(value: Str)
}

/// Configuration for the root volume of fleet instances and image builders.
/// This allows you to customize the storage capacity beyond the default 200
/// GB.
pub struct VolumeConfig {
  /// The size of the root volume in GB. Valid range is 200-500 GB. The
  /// default is 200 GB, which is included in the hourly instance rate.
  /// Additional storage beyond 200 GB incurs extra charges and applies to
  /// instances regardless of their running state.
  pub volume_size_in_gb: Int? = None
}

/// Describes VPC configuration information for fleets and image builders.
pub struct VpcConfig {
  /// The identifiers of the subnets to which a network interface is attached
  /// from the fleet instance or image builder instance. Fleet instances use
  /// one or more subnets. Image builder instances use one subnet.
  pub subnet_ids: List[Str]? = None
  /// The identifiers of the security groups for the fleet or image builder.
  pub security_group_ids: List[Str]? = None
}
