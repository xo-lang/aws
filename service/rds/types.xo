  /// describe-db-engine-versions --query
  /// "DBEngineVersions[].DBParameterGroupFamily" --engine aurora-postgresql
  /// The output contains duplicates. The following are the valid DB engine
  /// values: aurora-mysql aurora-postgresql mysql postgres
  pub db_parameter_group_family: Str? = None
  /// The description for the DB cluster parameter group.
  pub description: Str? = None
  /// Tags to assign to the DB cluster parameter group.
