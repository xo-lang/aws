/// Initiates a bulk publish of all existing datasets for an Identity Pool
/// to the configured stream. Customers are limited to one successful bulk
/// publish per 24 hours. Bulk publish is an asynchronous request, customers
/// can see the status of the request via the GetBulkPublishDetails
/// operation. This API can only be called with developer credentials. You
/// cannot call this API with the temporary user credentials provided by
/// Cognito Identity.
pub fn (c: Client) bulk_publish(input: BulkPublishRequest) -> BulkPublishResponse ! BulkPublishErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_bulk_publish(c.params, input)) ?? e => return Err(BulkPublishErr.InvalidInput(e))
  var req = serialize_bulk_publish(ep, input, "") ?? e => return Err(BulkPublishErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(BulkPublishErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_bulk_publish_error(resp))
  }
  deserialize_bulk_publish(resp) ?? e => Err(BulkPublishErr.Deserialize(e))
}

