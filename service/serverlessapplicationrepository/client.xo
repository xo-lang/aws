      "version" => out.version = from_json_version(fv)?
      _ => {}
    }
  }
  Ok(out)
}

/// The errors of UpdateApplication.
pub enum UpdateApplicationErr {
  BadRequestException(e: BadRequestException)
  ConflictException(e: ConflictException)
  ForbiddenException(e: ForbiddenException)
  InternalServerErrorException(e: InternalServerErrorException)
  NotFoundException(e: NotFoundException)
  TooManyRequestsException(e: TooManyRequestsException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UpdateApplicationErr) display() -> Str {
  match e {
    BadRequestException(x) => "BadRequestException: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    ForbiddenException(x) => "ForbiddenException: ${x:?}"
    InternalServerErrorException(x) => "InternalServerErrorException: ${x:?}"
    NotFoundException(x) => "NotFoundException: ${x:?}"
    TooManyRequestsException(x) => "TooManyRequestsException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_application_error(resp: http.Response) -> UpdateApplicationErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "BadRequestException" => match read_error_bad_request_exception(resp, body) {
      Ok(x) => return UpdateApplicationErr.BadRequestException(x)
      Err(msg) => return UpdateApplicationErr.Deserialize(msg)
    }
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UpdateApplicationErr.ConflictException(x)
      Err(msg) => return UpdateApplicationErr.Deserialize(msg)
    }
    "ForbiddenException" => match read_error_forbidden_exception(resp, body) {
      Ok(x) => return UpdateApplicationErr.ForbiddenException(x)
      Err(msg) => return UpdateApplicationErr.Deserialize(msg)
    }
    "InternalServerErrorException" => match read_error_internal_server_error_exception(resp, body) {
      Ok(x) => return UpdateApplicationErr.InternalServerErrorException(x)
      Err(msg) => return UpdateApplicationErr.Deserialize(msg)
    }
    "NotFoundException" => match read_error_not_found_exception(resp, body) {
      Ok(x) => return UpdateApplicationErr.NotFoundException(x)
      Err(msg) => return UpdateApplicationErr.Deserialize(msg)
    }
    "TooManyRequestsException" => match read_error_too_many_requests_exception(resp, body) {
      Ok(x) => return UpdateApplicationErr.TooManyRequestsException(x)
      Err(msg) => return UpdateApplicationErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateApplicationErr.Api(restjson.api_error(resp, body))
}

/// Updates the specified application.
pub fn (c: Client) update_application(input: UpdateApplicationRequest) -> UpdateApplicationResponse ! UpdateApplicationErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_application(c.params, input)) ?? e => return Err(UpdateApplicationErr.InvalidInput(e))
  var req = serialize_update_application(ep, input, "") ?? e => return Err(UpdateApplicationErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateApplicationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_application_error(resp))
  }
  deserialize_update_application(resp) ?? e => Err(UpdateApplicationErr.Deserialize(e))
}
