fn xml_write_object(var w: xmlv.Writer, v: Object, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.key {
    xmlv.elem(w, "Key", x, [])
  }
  if let Some(x) = v.last_modified {
    xmlv.elem(w, "LastModified", rest.date_time(x), [])
  }
  if let Some(x) = v.e_tag {
    xmlv.elem(w, "ETag", x, [])
  }
  if let Some(x) = v.checksum_algorithm {
    for item in x {
      xmlv.elem(w, "ChecksumAlgorithm", item.value(), [])
    }
  }
  if let Some(x) = v.checksum_type {
    xmlv.elem(w, "ChecksumType", x.value(), [])
  }
  if let Some(x) = v.size {
    xmlv.elem(w, "Size", "${x}", [])
  }
  if let Some(x) = v.storage_class {
    xmlv.elem(w, "StorageClass", x.value(), [])
  }
  if let Some(x) = v.owner {
    xml_write_owner(w, x, "Owner", [])
  }
  if let Some(x) = v.restore_status {
    xml_write_restore_status(w, x, "RestoreStatus", [])
  }
  xmlv.end(w, name)
}

fn xml_read_object(e: xml.Element) -> Object ! Str {
  var out = Object{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Key" => out.key = c.text()
      "LastModified" => out.last_modified = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ETag" => out.e_tag = c.text()
      "ChecksumAlgorithm" => {
        var items = out.checksum_algorithm ?? []
        items.push(ChecksumAlgorithm.from(c.text()))
        out.checksum_algorithm = items
      }
      "ChecksumType" => out.checksum_type = ChecksumType.from(c.text())
      "Size" => out.size = xmlv.read_int(c.text())?
      "StorageClass" => out.storage_class = ObjectStorageClass.from(c.text())
      "Owner" => out.owner = xml_read_owner(c)?
      "RestoreStatus" => out.restore_status = xml_read_restore_status(c)?
      _ => {}
    }
  }
  Ok(out)
}

