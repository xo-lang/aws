fn json_of_multi_region_cluster(v: MultiRegionCluster) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.multi_region_cluster_name {
    fs.push(("MultiRegionClusterName", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x)))
  }
  if let Some(x) = v.node_type {
    fs.push(("NodeType", json.Value.Str(x)))
  }
  if let Some(x) = v.engine {
    fs.push(("Engine", json.Value.Str(x)))
  }
  if let Some(x) = v.engine_version {
    fs.push(("EngineVersion", json.Value.Str(x)))
  }
  if let Some(x) = v.number_of_shards {
    fs.push(("NumberOfShards", json.Value.Int(x)))
  }
  if let Some(x) = v.clusters {
    fs.push(("Clusters", json_of_regional_cluster_list(x)))
  }
  if let Some(x) = v.multi_region_parameter_group_name {
    fs.push(("MultiRegionParameterGroupName", json.Value.Str(x)))
