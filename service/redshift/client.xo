  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.import_tables_completed {
    xml_write_import_tables_completed(w, x, "ImportTablesCompleted", [])
  }
  if let Some(x) = v.import_tables_in_progress {
    xml_write_import_tables_in_progress(w, x, "ImportTablesInProgress", [])
  }
  if let Some(x) = v.import_tables_not_started {
    xml_write_import_tables_not_started(w, x, "ImportTablesNotStarted", [])
  }
  if let Some(x) = v.avg_resize_rate_in_mega_bytes_per_second {
    xmlv.elem(w, "AvgResizeRateInMegaBytesPerSecond", rest.encode_float(x), [])
  }
  if let Some(x) = v.total_resize_data_in_mega_bytes {
    xmlv.elem(w, "TotalResizeDataInMegaBytes", "${x}", [])
  }
  if let Some(x) = v.progress_in_mega_bytes {
    xmlv.elem(w, "ProgressInMegaBytes", "${x}", [])
  }
  if let Some(x) = v.elapsed_time_in_seconds {
    xmlv.elem(w, "ElapsedTimeInSeconds", "${x}", [])
  }
  if let Some(x) = v.estimated_time_to_completion_in_seconds {
    xmlv.elem(w, "EstimatedTimeToCompletionInSeconds", "${x}", [])
  }
  if let Some(x) = v.resize_type {
    xmlv.elem(w, "ResizeType", x, [])
  }
  if let Some(x) = v.message {
    xmlv.elem(w, "Message", x, [])
  }
  if let Some(x) = v.target_encryption_type {
    xmlv.elem(w, "TargetEncryptionType", x, [])
  }
  if let Some(x) = v.data_transfer_progress_percent {
    xmlv.elem(w, "DataTransferProgressPercent", rest.encode_float(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_resize_progress_message(e: xml.Element) -> ResizeProgressMessage ! Str {
  var out = ResizeProgressMessage{}
  for c in xmlv.elements(e) {
