fn json_of_sync_resource_filter(v: SyncResourceFilter) -> json.Value {
  match v {
    State(x) => json.Value.Object([("state", json.Value.Str(x))])
    ResourceType(x) => json.Value.Object([("resourceType", json.Value.Str(x))])
    ResourceId(x) => json.Value.Object([("resourceId", json.Value.Str(x))])
    ExternalId(x) => json.Value.Object([("externalId", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_sync_resource_filter(v: json.Value) -> SyncResourceFilter ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "state" => Ok(SyncResourceFilter.State(jsonv.read_str(fv)?))
      "resourceType" => Ok(SyncResourceFilter.ResourceType(jsonv.read_str(fv)?))
      "resourceId" => Ok(SyncResourceFilter.ResourceId(jsonv.read_str(fv)?))
      "externalId" => Ok(SyncResourceFilter.ExternalId(jsonv.read_str(fv)?))
      _ => Ok(SyncResourceFilter.Unknown(k))
    }
  }
  Err("SyncResourceFilter: no member set")
}

