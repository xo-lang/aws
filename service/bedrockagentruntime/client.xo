  if let Some(x) = v.session_start_time {
    fs.push(("sessionStartTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.session_expiry_time {
    fs.push(("sessionExpiryTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.summary_text {
