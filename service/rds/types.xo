  pub processor_features: List[ProcessorFeature]? = None
  /// Specifies whether the DB instance class of the DB instance uses its
  /// default processor features. This setting doesn't apply to RDS Custom DB
  /// instances.
  pub use_default_processor_features: Bool? = None
  /// Specifies whether to enable deletion protection for the DB instance. The
