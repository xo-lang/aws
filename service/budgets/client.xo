      Err(msg) => return UpdateSubscriberErr.Deserialize(msg)
    }
    "InternalErrorException" => match read_error_internal_error_exception(resp, body) {
      Ok(x) => return UpdateSubscriberErr.InternalErrorException(x)
      Err(msg) => return UpdateSubscriberErr.Deserialize(msg)
    }
    "InvalidParameterException" => match read_error_invalid_parameter_exception(resp, body) {
      Ok(x) => return UpdateSubscriberErr.InvalidParameterException(x)
      Err(msg) => return UpdateSubscriberErr.Deserialize(msg)
    }
    "NotFoundException" => match read_error_not_found_exception(resp, body) {
      Ok(x) => return UpdateSubscriberErr.NotFoundException(x)
      Err(msg) => return UpdateSubscriberErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateSubscriberErr.ThrottlingException(x)
      Err(msg) => return UpdateSubscriberErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateSubscriberErr.Api(restjson.api_error(resp, body))
}

/// Updates a subscriber.
pub fn (c: Client) update_subscriber(input: UpdateSubscriberRequest) -> UpdateSubscriberResponse ! UpdateSubscriberErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_subscriber(c.params, input)) ?? e => return Err(UpdateSubscriberErr.InvalidInput(e))
  var req = serialize_update_subscriber(ep, input, "") ?? e => return Err(UpdateSubscriberErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateSubscriberErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_subscriber_error(resp))
  }
  deserialize_update_subscriber(resp) ?? e => Err(UpdateSubscriberErr.Deserialize(e))
}
