fn json_of_payment_instrument_details(v: PaymentInstrumentDetails) -> json.Value {
  match v {
    Card(x) => json.Value.Object([("card", json_of_card(x))])
    UsAchBankAccount(x) => json.Value.Object([("usAchBankAccount", json_of_us_ach_bank_account(x))])
    SepaBankAccount(x) => json.Value.Object([("sepaBankAccount", json_of_sepa_bank_account(x))])
    UkBacsBankAccount(x) => json.Value.Object([("ukBacsBankAccount", json_of_uk_bacs_bank_account(x))])
    InNetBanking(x) => json.Value.Object([("inNetBanking", json_of_in_net_banking(x))])
    CnBankRedirect(x) => json.Value.Object([("cnBankRedirect", json_of_cn_bank_redirect(x))])
    Upi(x) => json.Value.Object([("upi", json_of_upi(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_payment_instrument_details(v: json.Value) -> PaymentInstrumentDetails ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "card" => Ok(PaymentInstrumentDetails.Card(from_json_card(fv)?))
      "usAchBankAccount" => Ok(PaymentInstrumentDetails.UsAchBankAccount(from_json_us_ach_bank_account(fv)?))
      "sepaBankAccount" => Ok(PaymentInstrumentDetails.SepaBankAccount(from_json_sepa_bank_account(fv)?))
      "ukBacsBankAccount" => Ok(PaymentInstrumentDetails.UkBacsBankAccount(from_json_uk_bacs_bank_account(fv)?))
      "inNetBanking" => Ok(PaymentInstrumentDetails.InNetBanking(from_json_in_net_banking(fv)?))
      "cnBankRedirect" => Ok(PaymentInstrumentDetails.CnBankRedirect(from_json_cn_bank_redirect(fv)?))
      "upi" => Ok(PaymentInstrumentDetails.Upi(from_json_upi(fv)?))
      _ => Ok(PaymentInstrumentDetails.Unknown(k))
    }
  }
  Err("PaymentInstrumentDetails: no member set")
}

