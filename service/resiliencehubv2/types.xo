pub struct PolicyDeletedMetadata {
  /// The number of services that were using the policy when it was deleted.
  pub affected_service_count: Int? = None
}

/// Contains details about the service that stopped using the policy, such
/// as the account that owns the service.
pub struct PolicyDetachedFromServiceMetadata {
  pub service_arn: Str? = None
  /// The account that owns the service.
  pub account_id: Str? = None
}

pub enum PolicyDisassociationReason: Str {
  ReplacedByUpdate = "REPLACED_BY_UPDATE"
  SharingRevoked = "SHARING_REVOKED"
  PolicyDeleted = "POLICY_DELETED"
  Unknown(value: Str)
}

/// An event on the timeline of a resilience policy.
pub struct PolicyEvent {
  /// The identifier of the event.
  pub event_id: Str? = None
  /// The time the event occurred.
  pub timestamp: Time? = None
  /// The type of the event.
  pub event_type: PolicyEventType? = None
  pub policy_arn: Str? = None
  pub actor: EventActor? = None
  /// The details of the event.
  pub event_details: PolicyEventDetails? = None
}

/// Contains the title, description, and event-specific metadata for a
/// single event on the timeline of a resilience policy.
pub struct PolicyEventDetails {
  /// A short summary of the event.
  pub title: Str? = None
  /// A description of the event.
  pub description: Str? = None
  /// The event-specific metadata, with one member populated according to the
  /// event type.
  pub event_metadata: PolicyEventMetadata? = None
}

/// Contains the event-specific metadata for a policy event. Exactly one
/// member is populated, according to the event type.
/// policyAttachedToService — a service started using the policy.
/// policyDetachedFromService — a service stopped using the policy.
/// policySharingRevoked — cross-account sharing was disabled for the
/// policy. policyDeleted — the policy was deleted.
pub enum PolicyEventMetadata {
  PolicyAttachedToService(value: PolicyAttachedToServiceMetadata)
  PolicyDetachedFromService(value: PolicyDetachedFromServiceMetadata)
  PolicySharingRevoked(value: PolicySharingRevokedMetadata)
  PolicyDeleted(value: PolicyDeletedMetadata)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

pub enum PolicyEventType: Str {
  PolicyAttachedToService = "POLICY_ATTACHED_TO_SERVICE"
  PolicyDetachedFromService = "POLICY_DETACHED_FROM_SERVICE"
  PolicySharingRevoked = "POLICY_SHARING_REVOKED"
  PolicyDeleted = "POLICY_DELETED"
  Unknown(value: Str)
}

/// Contains details about a policy for which organization sharing was
/// revoked, including the number of services that were affected.
pub struct PolicySharingRevokedMetadata {
  /// The number of services that were using the policy when sharing was
  /// revoked.
  pub affected_service_count: Int? = None
}

/// Contains summary information about a resilience policy.
pub struct PolicySummary {
  pub policy_arn: Str? = None
  pub name: Str? = None
  /// The availability SLO defined in the policy.
  pub availability_slo: AvailabilitySlo? = None
  /// The multi-AZ disaster recovery targets defined in the policy.
  pub multi_az: MultiAzTargets? = None
  /// The multi-Region disaster recovery targets defined in the policy.
  pub multi_region: MultiRegionTargets? = None
  /// The data recovery targets defined in the policy.
  pub data_recovery: DataRecoveryTargets? = None
  /// Specifies whether cross-account sharing is enabled.
  pub sharing_enabled: Bool? = None
  /// The identifier of the organization this policy is shared with.
  pub organization_id: Str? = None
  /// The number of services associated with this policy.
  pub associated_service_count: Int? = None
  /// The timestamp when the policy was created.
  pub created_at: Time? = None
  /// The timestamp when the policy was last updated.
  pub updated_at: Time? = None
}

pub enum PolicyValueSource: Str {
  Self = "SELF"
  CrossAccount = "CROSS_ACCOUNT"
  Unknown(value: Str)
}

