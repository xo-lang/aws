fn json_of_mapping(v: Mapping) -> json.Value {
  match v {
    Framework(x) => json.Value.Object([("Framework", json_of_framework_mapping_details(x))])
    CommonControl(x) => json.Value.Object([("CommonControl", json_of_common_control_mapping_details(x))])
    RelatedControl(x) => json.Value.Object([("RelatedControl", json_of_related_control_mapping_details(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_mapping(v: json.Value) -> Mapping ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Framework" => Ok(Mapping.Framework(from_json_framework_mapping_details(fv)?))
      "CommonControl" => Ok(Mapping.CommonControl(from_json_common_control_mapping_details(fv)?))
      "RelatedControl" => Ok(Mapping.RelatedControl(from_json_related_control_mapping_details(fv)?))
      _ => Ok(Mapping.Unknown(k))
    }
  }
  Err("Mapping: no member set")
}

