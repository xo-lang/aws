  }
  if let Some(x) = input.maximum_message_rate_per_second {
    fs.push(("maximumMessageRatePerSecond", json.Value.Int(x)))
  }
  if let Some(x) = input.maximum_message_length {
    fs.push(("maximumMessageLength", json.Value.Int(x)))
  }
  if let Some(x) = input.message_review_handler {
    fs.push(("messageReviewHandler", json_of_message_review_handler(x)))
  }
  if let Some(x) = input.logging_configuration_identifiers {
    fs.push(("loggingConfigurationIdentifiers", json_of_logging_configuration_identifier_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/UpdateRoom"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
