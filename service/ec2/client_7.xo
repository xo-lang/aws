fn xml_write_vpc(var w: xmlv.Writer, v: Vpc, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.instance_tenancy {
    xmlv.elem(w, "instanceTenancy", x.value(), [])
  }
  if let Some(x) = v.ipv6_cidr_block_association_set {
    xml_write_vpc_ipv6_cidr_block_association_set(w, x, "ipv6CidrBlockAssociationSet", [])
  }
  if let Some(x) = v.cidr_block_association_set {
    xml_write_vpc_cidr_block_association_set(w, x, "cidrBlockAssociationSet", [])
  }
  if let Some(x) = v.is_default {
    xmlv.elem(w, "isDefault", "${x}", [])
  }
  if let Some(x) = v.encryption_control {
    xml_write_vpc_encryption_control(w, x, "encryptionControl", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.block_public_access_states {
    xml_write_block_public_access_states(w, x, "blockPublicAccessStates", [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "vpcId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.cidr_block {
    xmlv.elem(w, "cidrBlock", x, [])
  }
  if let Some(x) = v.dhcp_options_id {
    xmlv.elem(w, "dhcpOptionsId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpc(e: xml.Element) -> Vpc ! Str {
  var out = Vpc{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ownerId" => out.owner_id = c.text()
      "instanceTenancy" => out.instance_tenancy = Tenancy.from(c.text())
      "ipv6CidrBlockAssociationSet" => out.ipv6_cidr_block_association_set = xml_read_vpc_ipv6_cidr_block_association_set(c)?
      "cidrBlockAssociationSet" => out.cidr_block_association_set = xml_read_vpc_cidr_block_association_set(c)?
      "isDefault" => out.is_default = xmlv.read_bool(c.text())?
      "encryptionControl" => out.encryption_control = xml_read_vpc_encryption_control(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "blockPublicAccessStates" => out.block_public_access_states = xml_read_block_public_access_states(c)?
      "vpcId" => out.vpc_id = c.text()
      "state" => out.state = VpcState.from(c.text())
      "cidrBlock" => out.cidr_block = c.text()
      "dhcpOptionsId" => out.dhcp_options_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

