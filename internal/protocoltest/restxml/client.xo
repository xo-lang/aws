fn xml_write_xml_maps_xml_name_input_output_map(var w: xmlv.Writer, v: Map[Str, GreetingStruct], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "Attribute", k, [])
    xml_write_greeting_struct(w, item, "Setting", [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_xml_maps_xml_name_input_output_map(e: xml.Element) -> Map[Str, GreetingStruct] ! Str {
  var out: Map[Str, GreetingStruct] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "Attribute") ?? ""
    if let Some(vc) = entry.child("Setting") {
      out.put(k, xml_read_greeting_struct(vc)?)
    }
  }
  Ok(out)
}

