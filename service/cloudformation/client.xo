fn xml_write_hook_result_summary(var w: xmlv.Writer, v: HookResultSummary, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.hook_result_id {
    xmlv.elem(w, "HookResultId", x, [])
  }
  if let Some(x) = v.invocation_point {
    xmlv.elem(w, "InvocationPoint", x.value(), [])
  }
  if let Some(x) = v.failure_mode {
    xmlv.elem(w, "FailureMode", x.value(), [])
  }
  if let Some(x) = v.type_name {
    xmlv.elem(w, "TypeName", x, [])
  }
  if let Some(x) = v.type_version_id {
    xmlv.elem(w, "TypeVersionId", x, [])
  }
  if let Some(x) = v.type_configuration_version_id {
    xmlv.elem(w, "TypeConfigurationVersionId", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.hook_status_reason {
    xmlv.elem(w, "HookStatusReason", x, [])
  }
  if let Some(x) = v.invoked_at {
    xmlv.elem(w, "InvokedAt", rest.date_time(x), [])
  }
  if let Some(x) = v.target_type {
    xmlv.elem(w, "TargetType", x.value(), [])
  }
  if let Some(x) = v.target_id {
    xmlv.elem(w, "TargetId", x, [])
  }
  if let Some(x) = v.type_arn {
    xmlv.elem(w, "TypeArn", x, [])
  }
  if let Some(x) = v.hook_execution_target {
    xmlv.elem(w, "HookExecutionTarget", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_hook_result_summary(e: xml.Element) -> HookResultSummary ! Str {
  var out = HookResultSummary{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "HookResultId" => out.hook_result_id = c.text()
      "InvocationPoint" => out.invocation_point = HookInvocationPoint.from(c.text())
      "FailureMode" => out.failure_mode = HookFailureMode.from(c.text())
      "TypeName" => out.type_name = c.text()
      "TypeVersionId" => out.type_version_id = c.text()
      "TypeConfigurationVersionId" => out.type_configuration_version_id = c.text()
      "Status" => out.status = HookStatus.from(c.text())
      "HookStatusReason" => out.hook_status_reason = c.text()
      "InvokedAt" => out.invoked_at = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "TargetType" => out.target_type = ListHookResultsTargetType.from(c.text())
      "TargetId" => out.target_id = c.text()
      "TypeArn" => out.type_arn = c.text()
      "HookExecutionTarget" => out.hook_execution_target = c.text()
      _ => {}
    }
  }
  Ok(out)
}

