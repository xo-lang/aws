pub struct ValueRange {
  /// The start time of when to include objects. Use positive numbers to
  /// indicate that the starting point is in the past, and negative numbers to
  /// indicate it is in the future.
  pub start: Int? = None
  /// The end time of when to include objects. Use positive numbers to
  /// indicate that the starting point is in the past, and negative numbers to
  /// indicate it is in the future.
  pub end: Int? = None
}

/// Structure to hold workflow attributes.
pub struct WorkflowAttributes {
  /// Workflow attributes specific to APPFLOW_INTEGRATION workflow.
  pub appflow_integration: AppflowIntegrationWorkflowAttributes? = None
}

/// Generic object containing workflow execution metrics.
pub struct WorkflowMetrics {
  /// Workflow execution metrics for APPFLOW_INTEGRATION workflow.
  pub appflow_integration: AppflowIntegrationWorkflowMetrics? = None
}

/// List containing steps in workflow.
pub struct WorkflowStepItem {
  /// Workflow step information specific to APPFLOW_INTEGRATION workflow.
  pub appflow_integration: AppflowIntegrationWorkflowStep? = None
}

pub enum WorkflowType: Str {
  AppflowIntegration = "APPFLOW_INTEGRATION"
  Unknown(value: Str)
}

pub enum ZendeskConnectorOperator: Str {
  Projection = "PROJECTION"
  GreaterThan = "GREATER_THAN"
  Addition = "ADDITION"
  Multiplication = "MULTIPLICATION"
  Division = "DIVISION"
  Subtraction = "SUBTRACTION"
  MaskAll = "MASK_ALL"
  MaskFirstN = "MASK_FIRST_N"
  MaskLastN = "MASK_LAST_N"
  ValidateNonNull = "VALIDATE_NON_NULL"
  ValidateNonZero = "VALIDATE_NON_ZERO"
  ValidateNonNegative = "VALIDATE_NON_NEGATIVE"
  ValidateNumeric = "VALIDATE_NUMERIC"
  NoOp = "NO_OP"
  Unknown(value: Str)
}

/// The properties that are applied when using Zendesk as a flow source.
pub struct ZendeskSourceProperties {
  /// The object specified in the Zendesk flow source.
  pub object: Str? = None
}

pub enum LogicalOperator: Str {
  And = "AND"
  Or = "OR"
  Unknown(value: Str)
}
