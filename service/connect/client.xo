      "TotalPauseCount" => out.total_pause_count = jsonv.read_int(fv)?
      "TotalPauseDurationInSeconds" => out.total_pause_duration_in_seconds = jsonv.read_int(fv)?
      "ScheduledTimestamp" => out.scheduled_timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "RelatedContactId" => out.related_contact_id = jsonv.read_str(fv)?
      "WisdomInfo" => out.wisdom_info = from_json_wisdom_info(fv)?
      "CustomerId" => out.customer_id = jsonv.read_str(fv)?
      "CustomerEndpoint" => out.customer_endpoint = from_json_endpoint_info(fv)?
      "SystemEndpoint" => out.system_endpoint = from_json_endpoint_info(fv)?
