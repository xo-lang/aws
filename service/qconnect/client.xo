  }
  if let Some(x) = v.override_input_values {
    fs.push(("overrideInputValues", json_of_tool_override_input_value_list(x)))
  }
  if let Some(x) = v.output_filters {
    fs.push(("outputFilters", json_of_tool_output_filter_list(x)))
  }
  if let Some(x) = v.input_schema {
    fs.push(("inputSchema", x))
  }
  if let Some(x) = v.output_schema {
    fs.push(("outputSchema", x))
  }
  if let Some(x) = v.annotations {
    fs.push(("annotations", json_of_annotation(x)))
  }
