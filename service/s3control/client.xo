fn xml_write_replication_rule(var w: xmlv.Writer, v: ReplicationRule, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.id {
    xmlv.elem(w, "ID", x, [])
  }
  if let Some(x) = v.priority {
    xmlv.elem(w, "Priority", "${x}", [])
  }
  if let Some(x) = v.prefix {
    xmlv.elem(w, "Prefix", x, [])
  }
  if let Some(x) = v.filter {
    xml_write_replication_rule_filter(w, x, "Filter", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.source_selection_criteria {
    xml_write_source_selection_criteria(w, x, "SourceSelectionCriteria", [])
  }
  if let Some(x) = v.existing_object_replication {
    xml_write_existing_object_replication(w, x, "ExistingObjectReplication", [])
  }
  if let Some(x) = v.destination {
    xml_write_destination(w, x, "Destination", [])
  }
  if let Some(x) = v.delete_marker_replication {
    xml_write_delete_marker_replication(w, x, "DeleteMarkerReplication", [])
  }
  if let Some(x) = v.bucket {
    xmlv.elem(w, "Bucket", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_replication_rule(e: xml.Element) -> ReplicationRule ! Str {
  var out = ReplicationRule{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ID" => out.id = c.text()
      "Priority" => out.priority = xmlv.read_int(c.text())?
      "Prefix" => out.prefix = c.text()
      "Filter" => out.filter = xml_read_replication_rule_filter(c)?
      "Status" => out.status = ReplicationRuleStatus.from(c.text())
      "SourceSelectionCriteria" => out.source_selection_criteria = xml_read_source_selection_criteria(c)?
      "ExistingObjectReplication" => out.existing_object_replication = xml_read_existing_object_replication(c)?
      "Destination" => out.destination = xml_read_destination(c)?
      "DeleteMarkerReplication" => out.delete_marker_replication = xml_read_delete_marker_replication(c)?
      "Bucket" => out.bucket = c.text()
      _ => {}
    }
  }
  Ok(out)
}

