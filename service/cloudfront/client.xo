    xml_write_origins(w, x, "Origins", [])
  }
  if let Some(x) = v.origin_groups {
    xml_write_origin_groups(w, x, "OriginGroups", [])
  }
  if let Some(x) = v.default_cache_behavior {
    xml_write_default_cache_behavior(w, x, "DefaultCacheBehavior", [])
  }
  if let Some(x) = v.cache_behaviors {
    xml_write_cache_behaviors(w, x, "CacheBehaviors", [])
  }
  if let Some(x) = v.custom_error_responses {
    xml_write_custom_error_responses(w, x, "CustomErrorResponses", [])
  }
  if let Some(x) = v.comment {
    xmlv.elem(w, "Comment", x, [])
  }
  if let Some(x) = v.logging {
    xml_write_logging_config(w, x, "Logging", [])
  }
  if let Some(x) = v.price_class {
    xmlv.elem(w, "PriceClass", x.value(), [])
  }
  if let Some(x) = v.enabled {
    xmlv.elem(w, "Enabled", "${x}", [])
  }
  if let Some(x) = v.viewer_certificate {
    xml_write_viewer_certificate(w, x, "ViewerCertificate", [])
  }
  if let Some(x) = v.restrictions {
    xml_write_restrictions(w, x, "Restrictions", [])
  }
  if let Some(x) = v.web_acl_id {
    xmlv.elem(w, "WebACLId", x, [])
  }
  if let Some(x) = v.http_version {
    xmlv.elem(w, "HttpVersion", x.value(), [])
  }
  if let Some(x) = v.is_ipv6_enabled {
    xmlv.elem(w, "IsIPV6Enabled", "${x}", [])
  }
  if let Some(x) = v.continuous_deployment_policy_id {
    xmlv.elem(w, "ContinuousDeploymentPolicyId", x, [])
  }
  if let Some(x) = v.staging {
    xmlv.elem(w, "Staging", "${x}", [])
  }
  if let Some(x) = v.anycast_ip_list_id {
    xmlv.elem(w, "AnycastIpListId", x, [])
  }
  if let Some(x) = v.tenant_config {
    xml_write_tenant_config(w, x, "TenantConfig", [])
  }
  if let Some(x) = v.connection_mode {
    xmlv.elem(w, "ConnectionMode", x.value(), [])
  }
  if let Some(x) = v.viewer_mtls_config {
    xml_write_viewer_mtls_config(w, x, "ViewerMtlsConfig", [])
  }
  if let Some(x) = v.connection_function_association {
    xml_write_connection_function_association(w, x, "ConnectionFunctionAssociation", [])
  }
  if let Some(x) = v.cache_tag_config {
    xml_write_cache_tag_config(w, x, "CacheTagConfig", [])
  }
  xmlv.end(w, name)
}

fn xml_read_distribution_config(e: xml.Element) -> DistributionConfig ! Str {
  var out = DistributionConfig{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "CallerReference" => out.caller_reference = c.text()
      "Aliases" => out.aliases = xml_read_aliases(c)?
      "DefaultRootObject" => out.default_root_object = c.text()
      "Origins" => out.origins = xml_read_origins(c)?
      "OriginGroups" => out.origin_groups = xml_read_origin_groups(c)?
      "DefaultCacheBehavior" => out.default_cache_behavior = xml_read_default_cache_behavior(c)?
      "CacheBehaviors" => out.cache_behaviors = xml_read_cache_behaviors(c)?
      "CustomErrorResponses" => out.custom_error_responses = xml_read_custom_error_responses(c)?
      "Comment" => out.comment = c.text()
      "Logging" => out.logging = xml_read_logging_config(c)?
      "PriceClass" => out.price_class = PriceClass.from(c.text())
      "Enabled" => out.enabled = xmlv.read_bool(c.text())?
      "ViewerCertificate" => out.viewer_certificate = xml_read_viewer_certificate(c)?
      "Restrictions" => out.restrictions = xml_read_restrictions(c)?
      "WebACLId" => out.web_acl_id = c.text()
      "HttpVersion" => out.http_version = HttpVersion.from(c.text())
      "IsIPV6Enabled" => out.is_ipv6_enabled = xmlv.read_bool(c.text())?
      "ContinuousDeploymentPolicyId" => out.continuous_deployment_policy_id = c.text()
      "Staging" => out.staging = xmlv.read_bool(c.text())?
      "AnycastIpListId" => out.anycast_ip_list_id = c.text()
      "TenantConfig" => out.tenant_config = xml_read_tenant_config(c)?
      "ConnectionMode" => out.connection_mode = ConnectionMode.from(c.text())
      "ViewerMtlsConfig" => out.viewer_mtls_config = xml_read_viewer_mtls_config(c)?
      "ConnectionFunctionAssociation" => out.connection_function_association = xml_read_connection_function_association(c)?
      "CacheTagConfig" => out.cache_tag_config = xml_read_cache_tag_config(c)?
      _ => {}
    }
  }
  Ok(out)
}

