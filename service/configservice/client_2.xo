      continue
    }
    match k {
      "QueryArn" => out.query_arn = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

/// The errors of PutStoredQuery.
pub enum PutStoredQueryErr {
  ResourceConcurrentModificationException(e: ResourceConcurrentModificationException)
  TooManyTagsException(e: TooManyTagsException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: PutStoredQueryErr) display() -> Str {
  match e {
    ResourceConcurrentModificationException(x) => "ResourceConcurrentModificationException: ${x:?}"
    TooManyTagsException(x) => "TooManyTagsException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}