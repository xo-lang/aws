fn xml_write_bundle_task(var w: xmlv.Writer, v: BundleTask, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.bundle_id {
    xmlv.elem(w, "bundleId", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "startTime", rest.date_time(x), [])
  }
  if let Some(x) = v.update_time {
    xmlv.elem(w, "updateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.storage {
    xml_write_storage(w, x, "storage", [])
  }
  if let Some(x) = v.progress {
    xmlv.elem(w, "progress", x, [])
  }
  if let Some(x) = v.bundle_task_error {
    xml_write_bundle_task_error(w, x, "error", [])
  }
  xmlv.end(w, name)
}

fn xml_read_bundle_task(e: xml.Element) -> BundleTask ! Str {
  var out = BundleTask{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "instanceId" => out.instance_id = c.text()
      "bundleId" => out.bundle_id = c.text()
      "state" => out.state = BundleTaskState.from(c.text())
      "startTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "updateTime" => out.update_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "storage" => out.storage = xml_read_storage(c)?
      "progress" => out.progress = c.text()
      "error" => out.bundle_task_error = xml_read_bundle_task_error(c)?
      _ => {}
    }
  }
  Ok(out)
}

