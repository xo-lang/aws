      "KmsKeyId" => out.kms_key_id = c.text()
      "EnableIAMDatabaseAuthentication" => out.enable_iam_database_authentication = xmlv.read_bool(c.text())?
      "EnableCloudwatchLogsExports" => out.enable_cloudwatch_logs_exports = xml_read_log_type_list(c)?
      "DBClusterParameterGroupName" => out.db_cluster_parameter_group_name = c.text()
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "ServerlessV2ScalingConfiguration" => out.serverless_v2_scaling_configuration = xml_read_serverless_v2_scaling_configuration(c)?
      "StorageType" => out.storage_type = c.text()
      "NetworkType" => out.network_type = c.text()
      _ => {}
    }
  }
  Ok(out)
}

