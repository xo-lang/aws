  /// The specified managed scaling policy for an Amazon EMR cluster.
  pub managed_scaling_policy: ManagedScalingPolicy? = None
  /// The specified placement group configuration for an Amazon EMR cluster.
  pub placement_group_configs: List[PlacementGroupConfig]? = None
  pub auto_termination_policy: AutoTerminationPolicy? = None
  /// Specifies a particular Amazon Linux release for all nodes in a cluster
