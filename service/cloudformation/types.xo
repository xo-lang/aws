  /// is currently up to date with the StackSet.
  pub status: StackInstanceStatus? = None
  /// The explanation for the specific status code assigned to this stack
  /// instance.
  pub status_reason: Str? = None
  /// The detailed status of the stack instance.
  pub stack_instance_status: StackInstanceComprehensiveStatus? = None
  /// [Service-managed permissions] The organization root ID or organizational
  /// unit (OU) IDs that you specified for DeploymentTargets .
  pub organizational_unit_id: Str? = None
  /// Status of the stack instance's actual configuration compared to the
  /// expected template and parameter configuration of the StackSet it belongs
  /// to. DRIFTED : The stack differs from the expected template and parameter
  /// configuration of the StackSet it belongs to. A stack instance is
  /// considered to have drifted if one or more of the resources in the
