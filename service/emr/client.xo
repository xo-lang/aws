fn json_of_credentials(v: Credentials) -> json.Value {
  match v {
    UsernamePassword(x) => json.Value.Object([("UsernamePassword", json_of_username_password(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_credentials(v: json.Value) -> Credentials ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "UsernamePassword" => Ok(Credentials.UsernamePassword(from_json_username_password(fv)?))
      _ => Ok(Credentials.Unknown(k))
    }
  }
  Err("Credentials: no member set")
}

