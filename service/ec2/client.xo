fn xml_write_create_fleet_request(var w: xmlv.Writer, v: CreateFleetRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.dry_run {
    xmlv.elem(w, "DryRun", "${x}", [])
  }
  if let Some(x) = v.client_token {
    xmlv.elem(w, "ClientToken", x, [])
  }
  if let Some(x) = v.spot_options {
    xml_write_spot_options_request(w, x, "SpotOptions", [])
  }
  if let Some(x) = v.on_demand_options {
    xml_write_on_demand_options_request(w, x, "OnDemandOptions", [])
  }
  if let Some(x) = v.reserved_capacity_options {
    xml_write_reserved_capacity_options_request(w, x, "ReservedCapacityOptions", [])
  }
  if let Some(x) = v.excess_capacity_termination_policy {
    xmlv.elem(w, "ExcessCapacityTerminationPolicy", x.value(), [])
  }
  if let Some(x) = v.launch_template_configs {
    xml_write_fleet_launch_template_config_list_request(w, x, "LaunchTemplateConfigs", [])
  }
  if let Some(x) = v.target_capacity_specification {
    xml_write_target_capacity_specification_request(w, x, "TargetCapacitySpecification", [])
  }
  if let Some(x) = v.terminate_instances_with_expiration {
    xmlv.elem(w, "TerminateInstancesWithExpiration", "${x}", [])
  }
  if let Some(x) = v.type_value {
    xmlv.elem(w, "Type", x.value(), [])
  }
  if let Some(x) = v.valid_from {
    xmlv.elem(w, "ValidFrom", rest.date_time(x), [])
  }
  if let Some(x) = v.valid_until {
    xmlv.elem(w, "ValidUntil", rest.date_time(x), [])
  }
  if let Some(x) = v.replace_unhealthy_instances {
    xmlv.elem(w, "ReplaceUnhealthyInstances", "${x}", [])
  }
  if let Some(x) = v.tag_specifications {
    xml_write_tag_specification_list(w, x, "TagSpecification", [])
  }
  if let Some(x) = v.context {
    xmlv.elem(w, "Context", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_create_fleet_request(e: xml.Element) -> CreateFleetRequest ! Str {
  var out = CreateFleetRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "ClientToken" => out.client_token = c.text()
      "SpotOptions" => out.spot_options = xml_read_spot_options_request(c)?
      "OnDemandOptions" => out.on_demand_options = xml_read_on_demand_options_request(c)?
      "ReservedCapacityOptions" => out.reserved_capacity_options = xml_read_reserved_capacity_options_request(c)?
      "ExcessCapacityTerminationPolicy" => out.excess_capacity_termination_policy = FleetExcessCapacityTerminationPolicy.from(c.text())
      "LaunchTemplateConfigs" => out.launch_template_configs = xml_read_fleet_launch_template_config_list_request(c)?
      "TargetCapacitySpecification" => out.target_capacity_specification = xml_read_target_capacity_specification_request(c)?
      "TerminateInstancesWithExpiration" => out.terminate_instances_with_expiration = xmlv.read_bool(c.text())?
      "Type" => out.type_value = FleetType.from(c.text())
      "ValidFrom" => out.valid_from = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ValidUntil" => out.valid_until = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ReplaceUnhealthyInstances" => out.replace_unhealthy_instances = xmlv.read_bool(c.text())?
      "TagSpecification" => out.tag_specifications = xml_read_tag_specification_list(c)?
      "Context" => out.context = c.text()
      _ => {}
    }
  }
  Ok(out)
}

