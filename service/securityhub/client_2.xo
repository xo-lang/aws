fn json_of_configuration_options(v: ConfigurationOptions) -> json.Value {
  match v {
    Integer(x) => json.Value.Object([("Integer", json_of_integer_configuration_options(x))])
    IntegerList(x) => json.Value.Object([("IntegerList", json_of_integer_list_configuration_options(x))])
    Double(x) => json.Value.Object([("Double", json_of_double_configuration_options(x))])
    String(x) => json.Value.Object([("String", json_of_string_configuration_options(x))])
    StringList(x) => json.Value.Object([("StringList", json_of_string_list_configuration_options(x))])
    Boolean(x) => json.Value.Object([("Boolean", json_of_boolean_configuration_options(x))])
    Enum(x) => json.Value.Object([("Enum", json_of_enum_configuration_options(x))])
    EnumList(x) => json.Value.Object([("EnumList", json_of_enum_list_configuration_options(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_configuration_options(v: json.Value) -> ConfigurationOptions ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Integer" => Ok(ConfigurationOptions.Integer(from_json_integer_configuration_options(fv)?))
      "IntegerList" => Ok(ConfigurationOptions.IntegerList(from_json_integer_list_configuration_options(fv)?))
      "Double" => Ok(ConfigurationOptions.Double(from_json_double_configuration_options(fv)?))
      "String" => Ok(ConfigurationOptions.String(from_json_string_configuration_options(fv)?))
      "StringList" => Ok(ConfigurationOptions.StringList(from_json_string_list_configuration_options(fv)?))
      "Boolean" => Ok(ConfigurationOptions.Boolean(from_json_boolean_configuration_options(fv)?))
      "Enum" => Ok(ConfigurationOptions.Enum(from_json_enum_configuration_options(fv)?))
      "EnumList" => Ok(ConfigurationOptions.EnumList(from_json_enum_list_configuration_options(fv)?))
      _ => Ok(ConfigurationOptions.Unknown(k))
    }
  }
  Err("ConfigurationOptions: no member set")
}

