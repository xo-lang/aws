fn xml_write_complete_multipart_upload_request(var w: xmlv.Writer, v: CompleteMultipartUploadRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.bucket {
    xmlv.elem(w, "Bucket", x, [])
  }
  if let Some(x) = v.key {
    xmlv.elem(w, "Key", x, [])
  }
  if let Some(x) = v.multipart_upload {
    xml_write_completed_multipart_upload(w, x, "CompleteMultipartUpload", [])
  }
  if let Some(x) = v.upload_id {
    xmlv.elem(w, "UploadId", x, [])
  }
  if let Some(x) = v.checksum_crc32 {
    xmlv.elem(w, "ChecksumCRC32", x, [])
  }
  if let Some(x) = v.checksum_crc32_c {
    xmlv.elem(w, "ChecksumCRC32C", x, [])
  }
  if let Some(x) = v.checksum_crc64_nvme {
    xmlv.elem(w, "ChecksumCRC64NVME", x, [])
  }
