fn xml_write_get_insight_rule_report_input(var w: xmlv.Writer, v: GetInsightRuleReportInput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.rule_name {
    xmlv.elem(w, "RuleName", x, [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "StartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.end_time {
    xmlv.elem(w, "EndTime", rest.date_time(x), [])
  }
  if let Some(x) = v.period {
    xmlv.elem(w, "Period", "${x}", [])
  }
  if let Some(x) = v.max_contributor_count {
    xmlv.elem(w, "MaxContributorCount", "${x}", [])
  }
  if let Some(x) = v.metrics {
    xml_write_insight_rule_metric_list(w, x, "Metrics", [])
  }
  if let Some(x) = v.order_by {
    xmlv.elem(w, "OrderBy", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_get_insight_rule_report_input(e: xml.Element) -> GetInsightRuleReportInput ! Str {
  var out = GetInsightRuleReportInput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "RuleName" => out.rule_name = c.text()
      "StartTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EndTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Period" => out.period = xmlv.read_int(c.text())?
      "MaxContributorCount" => out.max_contributor_count = xmlv.read_int(c.text())?
      "Metrics" => out.metrics = xml_read_insight_rule_metric_list(c)?
      "OrderBy" => out.order_by = c.text()
      _ => {}
    }
  }
  Ok(out)
}

