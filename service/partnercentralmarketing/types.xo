  /// The catalog (AWS or Sandbox).
  pub catalog: Catalog? = None
  /// The campaign identifier.
  pub campaign_identifier: Str? = None
  /// The asset identifier.
  pub campaign_asset_identifier: Str? = None
}

/// Output for DeactivateCampaignAsset. Synchronous, so the outcome of the
/// stop is this response — there is no `lastDeactivationStatus`, and its
/// absence is not an oversight. Activation is asynchronous and its outcome
/// arrives long after the response, which is why that one has to be
/// persisted where a partner can read it later.
pub struct DeactivateCampaignAssetResponse {
  /// The asset identifier.
  pub id: Str? = None
  /// The asset's lifecycle position — INACTIVE once the stop is confirmed.
  pub state: CampaignAssetState? = None
  /// How the most recent *activation* attempt ended, which a stop does not
  /// change. Read with state, it is what separates a stopped asset (INACTIVE
  /// + SUCCEEDED) from one never activated (INACTIVE, this member absent).
  /// Omitted until a first activation has been attempted.
  pub last_activation_status: AttemptStatus? = None
  /// Why the asset sits where it does. Present when LastActivationStatus is
  /// FAILED, or on a deliberate INACTIVE.
  pub state_reason: CampaignAssetStateReason? = None
}

