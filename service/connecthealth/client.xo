/// A StartMedicalScribeListeningSession stream: `send` writes input events (signed in a chain),
/// `close_send` ends them, and `close` ends the whole stream.
pub struct StartMedicalScribeListeningSessionStream {
  pub output: StartMedicalScribeListeningSessionOutput
  writer: http.PipeWriter
  signer: sigv4.StreamSigner
  clock: Clock
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
  sent_end: Bool = false
}

/// Sends input event `e`.
pub fn (var s: StartMedicalScribeListeningSessionStream) send(e: MedicalScribeInputStream) -> () ! IoErr uses clock {
  let m = eventstream.encode(event_message_medical_scribe_input_stream(e))
  s.writer.write(eventstream.signed(s.signer, m, s.clock.now()))
}

/// Ends the input events: sends the signed empty message and closes
/// the request body.
pub fn (var s: StartMedicalScribeListeningSessionStream) close_send() -> () ! IoErr uses clock {
  if s.sent_end {
    return Ok(())
  }
  s.sent_end = true
  let r = s.writer.write(eventstream.signed(s.signer, b"", s.clock.now()))
  s.writer.close()
  r
}

/// The next event, None at the end of the stream.
pub fn (var s: StartMedicalScribeListeningSessionStream) next() -> MedicalScribeOutputStream? ! MedicalScribeOutputStreamErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(MedicalScribeOutputStreamErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              continue
            }
            return match event_medical_scribe_output_stream(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(MedicalScribeOutputStreamErr.Read(msg))
            }
          }
          "exception" => return Err(exception_medical_scribe_output_stream(m))
          _ => return Err(MedicalScribeOutputStreamErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(MedicalScribeOutputStreamErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(MedicalScribeOutputStreamErr.Read(e.display()))
          }
        }
      }
    }
  }
  Ok(None)
}

/// Ends the stream in both directions.
pub fn (var s: StartMedicalScribeListeningSessionStream) close() uses clock {
  match s.close_send() {
    Ok(_) => {}
    // closing anyway: a failed end message changes nothing here
    Err(_) => {}
  }
  if !s.done {
    s.done = true
    s.body.close()
  }
}

fn event_message_medical_scribe_input_stream(v: MedicalScribeInputStream) -> eventstream.Message {
  match v {
    AudioEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("audioEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.audio_chunk {
        fs.push(("audioChunk", jsonv.blob(y)))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    BinaryAudioEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("binaryAudioEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/octet-stream")})
      eventstream.Message{headers: hs, payload: x.audio_chunk ?? b""}
    }
    SessionControlEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("sessionControlEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.type_value {
        fs.push(("type", json.Value.Str(y.value())))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    ConfigurationEvent(x) => {
      var hs = [eventstream.Header{name: ":message-type", value: eventstream.HeaderValue.Str("event")}, eventstream.Header{name: ":event-type", value: eventstream.HeaderValue.Str("configurationEvent")}]
      hs.push(eventstream.Header{name: ":content-type", value: eventstream.HeaderValue.Str("application/json")})
      var fs: List[(Str, json.Value)] = []
      if let Some(y) = x.post_stream_action_settings {
        fs.push(("postStreamActionSettings", json_of_medical_scribe_post_stream_action_settings(y)))
      }
      if let Some(y) = x.channel_definitions {
        fs.push(("channelDefinitions", json_of_medical_scribe_channel_definitions(y)))
      }
      if let Some(y) = x.encounter_context {
        fs.push(("encounterContext", json_of_encounter_context(y)))
      }
      eventstream.Message{headers: hs, payload: json.Value.Object(fs).encode().bytes()}
    }
    Unknown(_) => eventstream.Message{}
  }
}

/// Why reading a MedicalScribeOutputStream stream stopped.
pub enum MedicalScribeOutputStreamErr {
  InternalFailureException(e: InternalServerException)
  ValidationException(e: ValidationException)
  /// An error message, or an exception the model does not list.
  Api(e: aws.ApiError)
  /// The body could not be read or is not event stream messages.
  Read(msg: Str)
}

pub fn (e: MedicalScribeOutputStreamErr) display() -> Str {
