    return match k {
      "openSearchResourceConfig" => Ok(ResourceConfig.OpenSearchResourceConfig(from_json_open_search_resource_config(fv)?))
      _ => Ok(ResourceConfig.Unknown(k))
    }
  }
  Err("ResourceConfig: no member set")
}

