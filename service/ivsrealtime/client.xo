fn read_error_access_denied_exception(resp: http.Response, body: json.Value) -> AccessDeniedException ! Str {
  let _ = (resp, body)
  var out = AccessDeniedException{}
  if let Some(hv) = resp.header("Access-Control-Allow-Origin") {
    out.access_control_allow_origin = hv
  }
  if let Some(hv) = resp.header("Access-Control-Expose-Headers") {
    out.access_control_expose_headers = hv
  }
  if let Some(hv) = resp.header("Cache-Control") {
    out.cache_control = hv
  }
  if let Some(hv) = resp.header("Content-Security-Policy") {
    out.content_security_policy = hv
  }
  if let Some(hv) = resp.header("Strict-Transport-Security") {
    out.strict_transport_security = hv
  }
  if let Some(hv) = resp.header("X-Content-Type-Options") {
    out.x_content_type_options = hv
  }
  if let Some(hv) = resp.header("X-Frame-Options") {
    out.x_frame_options = hv
  }
  if let Some(hv) = resp.header("x-amzn-ErrorType") {
    out.x_amzn_error_type = hv
  }
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "exceptionMessage" => out.exception_message = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

