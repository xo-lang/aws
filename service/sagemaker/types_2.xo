/// Provides a breakdown of the number of objects labeled.
pub struct LabelCounters {
  /// The total number of objects labeled.
  pub total_labeled: Int? = None
  /// The total number of objects labeled by a human worker.
  pub human_labeled: Int? = None
  /// The total number of objects labeled by automated data labeling.
  pub machine_labeled: Int? = None
  /// The total number of objects that could not be labeled due to an error.
  pub failed_non_retryable_error: Int? = None
  /// The total number of objects not yet labeled.
  pub unlabeled: Int? = None
}

/// Provides counts for human-labeled tasks in the labeling job.
pub struct LabelCountersForWorkteam {
  /// The total number of data objects labeled by a human worker.
  pub human_labeled: Int? = None
  /// The total number of data objects that need to be labeled by a human
  /// worker.
  pub pending_human: Int? = None
  /// The total number of tasks in the labeling job.
  pub total: Int? = None
}

/// Provides configuration information for auto-labeling of your data
/// objects. A LabelingJobAlgorithmsConfig object must be supplied in order
/// to use auto-labeling.
pub struct LabelingJobAlgorithmsConfig {
  /// Specifies the Amazon Resource Name (ARN) of the algorithm used for
  /// auto-labeling. You must select one of the following ARNs: Image
  /// classification arn:aws:sagemaker: region
  /// :027400017018:labeling-job-algorithm-specification/image-classification
  /// Text classification arn:aws:sagemaker: region
  /// :027400017018:labeling-job-algorithm-specification/text-classification
  /// Object detection arn:aws:sagemaker: region
  /// :027400017018:labeling-job-algorithm-specification/object-detection
  /// Semantic Segmentation arn:aws:sagemaker: region
  /// :027400017018:labeling-job-algorithm-specification/semantic-segmentation
  pub labeling_job_algorithm_specification_arn: Str? = None
  /// At the end of an auto-label job Ground Truth sends the Amazon Resource
  /// Name (ARN) of the final model used for auto-labeling. You can use this
  /// model as the starting point for subsequent similar jobs by providing the
  /// ARN of the model here.
  pub initial_active_learning_model_arn: Str? = None
  /// Provides configuration information for a labeling job.
  pub labeling_job_resource_config: LabelingJobResourceConfig? = None
}

/// Attributes of the data specified by the customer. Use these to describe
/// the data to be labeled.
pub struct LabelingJobDataAttributes {
  /// Declares that your content is free of personally identifiable
  /// information or adult content. SageMaker may restrict the Amazon
  /// Mechanical Turk workers that can view your task based on this
  /// information.
  pub content_classifiers: List[ContentClassifier]? = None
}

/// Provides information about the location of input data. You must specify
/// at least one of the following: S3DataSource or SnsDataSource . Use
/// SnsDataSource to specify an SNS input topic for a streaming labeling
/// job. If you do not specify and SNS input topic ARN, Ground Truth will
/// create a one-time labeling job. Use S3DataSource to specify an input
/// manifest file for both streaming and one-time labeling jobs. Adding an
/// S3DataSource is optional if you use SnsDataSource to create a streaming
/// labeling job.
pub struct LabelingJobDataSource {
  /// The Amazon S3 location of the input data objects.
  pub s3_data_source: LabelingJobS3DataSource? = None
  /// An Amazon SNS data source used for streaming labeling jobs. To learn
  /// more, see Send Data to a Streaming Labeling Job .
  pub sns_data_source: LabelingJobSnsDataSource? = None
}

/// Provides summary information for a work team.
pub struct LabelingJobForWorkteamSummary {
  /// The name of the labeling job that the work team is assigned to.
  pub labeling_job_name: Str? = None
  /// A unique identifier for a labeling job. You can use this to refer to a
  /// specific labeling job.
  pub job_reference_code: Str? = None
  /// The Amazon Web Services account ID of the account used to start the
  /// labeling job.
  pub work_requester_account_id: Str? = None
  /// The date and time that the labeling job was created.
  pub creation_time: Time? = None
  /// Provides information about the progress of a labeling job.
  pub label_counters: LabelCountersForWorkteam? = None
  /// The configured number of workers per data object.
  pub number_of_human_workers_per_data_object: Int? = None
}

/// Input configuration information for a labeling job.
pub struct LabelingJobInputConfig {
  /// The location of the input data.
  pub data_source: LabelingJobDataSource? = None
  /// Attributes of the data specified by the customer.
  pub data_attributes: LabelingJobDataAttributes? = None
}

/// Specifies the location of the output produced by the labeling job.
pub struct LabelingJobOutput {
  /// The Amazon S3 bucket location of the manifest file for labeled data.
  pub output_dataset_s3_uri: Str? = None
  /// The Amazon Resource Name (ARN) for the most recent SageMaker model
  /// trained as part of automated data labeling.
  pub final_active_learning_model_arn: Str? = None
}

/// Output configuration information for a labeling job.
pub struct LabelingJobOutputConfig {
  /// The Amazon S3 location to write output data.
  pub s3_output_path: Str? = None
  /// The Amazon Web Services Key Management Service ID of the key used to
  /// encrypt the output data, if any. If you provide your own KMS key ID, you
  /// must add the required permissions to your KMS key described in Encrypt
  /// Output Data and Storage Volume with Amazon Web Services KMS . If you
  /// don't provide a KMS key ID, Amazon SageMaker uses the default Amazon Web
  /// Services KMS key for Amazon S3 for your role's account to encrypt your
  /// output data. If you use a bucket policy with an s3:PutObject permission
  /// that only allows objects with server-side encryption, set the condition
  /// key of s3:x-amz-server-side-encryption to "aws:kms" . For more
  /// information, see KMS-Managed Encryption Keys in the Amazon Simple
  /// Storage Service Developer Guide.
  pub kms_key_id: Str? = None
  /// An Amazon Simple Notification Service (Amazon SNS) output topic ARN.
  /// Provide a SnsTopicArn if you want to do real time chaining to another
  /// streaming job and receive an Amazon SNS notifications each time a data
  /// object is submitted by a worker. If you provide an SnsTopicArn in
  /// OutputConfig , when workers complete labeling tasks, Ground Truth will
  /// send labeling task output data to the SNS output topic you specify here.
  /// To learn more, see Receive Output Data from a Streaming Labeling Job .
  pub sns_topic_arn: Str? = None
}

/// Configure encryption on the storage volume attached to the ML compute
/// instance used to run automated data labeling model training and
/// inference.
pub struct LabelingJobResourceConfig {
  /// The Amazon Web Services Key Management Service (Amazon Web Services KMS)
  /// key that Amazon SageMaker uses to encrypt data on the storage volume
  /// attached to the ML compute instance(s) that run the training and
  /// inference jobs used for automated data labeling. You can only specify a
  /// VolumeKmsKeyId when you create a labeling job with automated data
  /// labeling enabled using the API operation CreateLabelingJob . You cannot
  /// specify an Amazon Web Services KMS key to encrypt the storage volume
