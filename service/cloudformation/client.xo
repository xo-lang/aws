      "OperationType" => out.operation_type = OperationType.from(c.text())
      "OperationStatus" => out.operation_status = BeaconStackOperationStatus.from(c.text())
      "EventType" => out.event_type = EventType.from(c.text())
      "LogicalResourceId" => out.logical_resource_id = c.text()
      "PhysicalResourceId" => out.physical_resource_id = c.text()
      "ResourceType" => out.resource_type = c.text()
      "Timestamp" => out.timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "StartTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EndTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ResourceStatus" => out.resource_status = ResourceStatus.from(c.text())
      "ResourceStatusReason" => out.resource_status_reason = c.text()
      "ResourceProperties" => out.resource_properties = c.text()
      "ClientRequestToken" => out.client_request_token = c.text()
      "HookType" => out.hook_type = c.text()
