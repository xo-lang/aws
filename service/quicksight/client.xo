    fs.push(("MaximumMinimum", json_of_maximum_minimum_computation(x)))
  }
  if let Some(x) = v.metric_comparison {
    fs.push(("MetricComparison", json_of_metric_comparison_computation(x)))
  }
  if let Some(x) = v.period_over_period {
    fs.push(("PeriodOverPeriod", json_of_period_over_period_computation(x)))
  }
  if let Some(x) = v.period_to_date {
    fs.push(("PeriodToDate", json_of_period_to_date_computation(x)))
  }
  if let Some(x) = v.growth_rate {
    fs.push(("GrowthRate", json_of_growth_rate_computation(x)))
