fn json_of_investment(v: Investment) -> json.Value {
  match v {
    MilestoneBasedInvestment(x) => json.Value.Object([("milestoneBasedInvestment", json_of_milestone_based_investment(x))])
    OutcomeBasedInvestment(x) => json.Value.Object([("outcomeBasedInvestment", json_of_outcome_based_investment(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_investment(v: json.Value) -> Investment ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "milestoneBasedInvestment" => Ok(Investment.MilestoneBasedInvestment(from_json_milestone_based_investment(fv)?))
      "outcomeBasedInvestment" => Ok(Investment.OutcomeBasedInvestment(from_json_outcome_based_investment(fv)?))
      _ => Ok(Investment.Unknown(k))
    }
  }
  Err("Investment: no member set")
}

fn json_of_investment_attestation(v: InvestmentAttestation) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.attestation_id {
    fs.push(("attestationId", json.Value.Str(x)))
  }
