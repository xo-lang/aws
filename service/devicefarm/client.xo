fn json_of_instance_profile(v: InstanceProfile) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("arn", json.Value.Str(x)))
  }
  if let Some(x) = v.package_cleanup {
    fs.push(("packageCleanup", json.Value.Bool(x)))
  }
  if let Some(x) = v.exclude_app_packages_from_cleanup {
    fs.push(("excludeAppPackagesFromCleanup", json_of_package_ids(x)))
  }
  if let Some(x) = v.reboot_after_use {
