    xmlv.elem(w, "ServiceUpdateDescription", x, [])
  }
  if let Some(x) = v.service_update_type {
    xmlv.elem(w, "ServiceUpdateType", x.value(), [])
  }
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.engine_version {
    xmlv.elem(w, "EngineVersion", x, [])
  }
  if let Some(x) = v.auto_update_after_recommended_apply_by_date {
    xmlv.elem(w, "AutoUpdateAfterRecommendedApplyByDate", "${x}", [])
  }
  if let Some(x) = v.estimated_update_time {
    xmlv.elem(w, "EstimatedUpdateTime", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_service_update(e: xml.Element) -> ServiceUpdate ! Str {
  var out = ServiceUpdate{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ServiceUpdateName" => out.service_update_name = c.text()
      "ServiceUpdateReleaseDate" => out.service_update_release_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ServiceUpdateEndDate" => out.service_update_end_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ServiceUpdateSeverity" => out.service_update_severity = ServiceUpdateSeverity.from(c.text())
      "ServiceUpdateRecommendedApplyByDate" => out.service_update_recommended_apply_by_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ServiceUpdateStatus" => out.service_update_status = ServiceUpdateStatus.from(c.text())
      "ServiceUpdateDescription" => out.service_update_description = c.text()
      "ServiceUpdateType" => out.service_update_type = ServiceUpdateType.from(c.text())
      "Engine" => out.engine = c.text()
      "EngineVersion" => out.engine_version = c.text()
      "AutoUpdateAfterRecommendedApplyByDate" => out.auto_update_after_recommended_apply_by_date = xmlv.read_bool(c.text())?
      "EstimatedUpdateTime" => out.estimated_update_time = c.text()
      _ => {}
    }
  }
  Ok(out)
}

