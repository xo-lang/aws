      "MaxSpotPriceAsPercentageOfOptimalOnDemandPrice" => out.max_spot_price_as_percentage_of_optimal_on_demand_price = xmlv.read_int(c.text())?
      "OnDemandMaxPricePercentageOverLowestPrice" => out.on_demand_max_price_percentage_over_lowest_price = xmlv.read_int(c.text())?
      "BareMetal" => out.bare_metal = BareMetal.from(c.text())
      "BurstablePerformance" => out.burstable_performance = BurstablePerformance.from(c.text())
      "RequireHibernateSupport" => out.require_hibernate_support = xmlv.read_bool(c.text())?
      "NetworkInterfaceCount" => out.network_interface_count = xml_read_network_interface_count_request(c)?
      "LocalStorage" => out.local_storage = LocalStorage.from(c.text())
      "LocalStorageTypes" => out.local_storage_types = xml_read_local_storage_types(c)?
      "TotalLocalStorageGB" => out.total_local_storage_gb = xml_read_total_local_storage_gb_request(c)?
      "BaselineEbsBandwidthMbps" => out.baseline_ebs_bandwidth_mbps = xml_read_baseline_ebs_bandwidth_mbps_request(c)?
      "AcceleratorTypes" => out.accelerator_types = xml_read_accelerator_types(c)?
      "AcceleratorCount" => out.accelerator_count = xml_read_accelerator_count_request(c)?
      "AcceleratorManufacturers" => out.accelerator_manufacturers = xml_read_accelerator_manufacturers(c)?
      "AcceleratorNames" => out.accelerator_names = xml_read_accelerator_names(c)?
      "AcceleratorTotalMemoryMiB" => out.accelerator_total_memory_mi_b = xml_read_accelerator_total_memory_mi_b_request(c)?
      "NetworkBandwidthGbps" => out.network_bandwidth_gbps = xml_read_network_bandwidth_gbps_request(c)?
      "AllowedInstanceTypes" => out.allowed_instance_types = xml_read_allowed_instance_types(c)?
