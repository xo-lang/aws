fn json_of_component_property(v: ComponentProperty) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.value {
    fs.push(("value", json.Value.Str(x)))
  }
  if let Some(x) = v.binding_properties {
    fs.push(("bindingProperties", json_of_component_property_binding_properties(x)))
  }
  if let Some(x) = v.collection_binding_properties {
    fs.push(("collectionBindingProperties", json_of_component_property_binding_properties(x)))
  }
  if let Some(x) = v.default_value {
    fs.push(("defaultValue", json.Value.Str(x)))
  }
  if let Some(x) = v.model {
    fs.push(("model", json.Value.Str(x)))
  }
  if let Some(x) = v.bindings {
    fs.push(("bindings", json_of_form_bindings(x)))
  }
  if let Some(x) = v.event {
    fs.push(("event", json.Value.Str(x)))
  }
  if let Some(x) = v.user_attribute {
    fs.push(("userAttribute", json.Value.Str(x)))
  }
  if let Some(x) = v.concat {
    fs.push(("concat", json_of_component_property_list(x)))
  }
  if let Some(x) = v.condition {
    fs.push(("condition", json_of_component_condition_property(x)))
  }
  if let Some(x) = v.configured {
    fs.push(("configured", json.Value.Bool(x)))
