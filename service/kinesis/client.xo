/// The events of SubscribeToShard, read as they arrive. `output` has the
/// response's other members; close the stream when done with it.
pub struct SubscribeToShardEvents {
  pub output: SubscribeToShardOutput
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
}

/// The next event, None at the end of the stream.
pub fn (var s: SubscribeToShardEvents) next() -> SubscribeToShardEventStream? ! SubscribeToShardEventStreamErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(SubscribeToShardEventStreamErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              if !m.payload.is_empty() {
                s.output = from_json_subscribe_to_shard_output(jsonv.parse_body(m.payload) ?? e => return Err(SubscribeToShardEventStreamErr.Read(e))) ?? e => return Err(SubscribeToShardEventStreamErr.Read(e))
              }
              continue
            }
            return match event_subscribe_to_shard_event_stream(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(SubscribeToShardEventStreamErr.Read(msg))
            }
          }
          "exception" => return Err(exception_subscribe_to_shard_event_stream(m))
          _ => return Err(SubscribeToShardEventStreamErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(SubscribeToShardEventStreamErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(SubscribeToShardEventStreamErr.Read(e.display()))
          }
        }
      }
    }
  }
  Ok(None)
}

/// Stops reading the stream.
pub fn (var s: SubscribeToShardEvents) close() {
  if !s.done {
    s.done = true
    s.body.close()
  }
}

/// Why reading a SubscribeToShardEventStream stream stopped.
pub enum SubscribeToShardEventStreamErr {
  ResourceNotFoundException(e: ResourceNotFoundException)
  ResourceInUseException(e: ResourceInUseException)
  KmsDisabledException(e: KMSDisabledException)
  KmsInvalidStateException(e: KMSInvalidStateException)
  KmsAccessDeniedException(e: KMSAccessDeniedException)
  KmsNotFoundException(e: KMSNotFoundException)
  KmsOptInRequired(e: KMSOptInRequired)
  KmsThrottlingException(e: KMSThrottlingException)
  InternalFailureException(e: InternalFailureException)
  /// An error message, or an exception the model does not list.
  Api(e: aws.ApiError)
  /// The body could not be read or is not event stream messages.
  Read(msg: Str)
}

pub fn (e: SubscribeToShardEventStreamErr) display() -> Str {
  match e {
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ResourceInUseException(x) => "ResourceInUseException: ${x:?}"
    KmsDisabledException(x) => "KMSDisabledException: ${x:?}"
    KmsInvalidStateException(x) => "KMSInvalidStateException: ${x:?}"
    KmsAccessDeniedException(x) => "KMSAccessDeniedException: ${x:?}"
    KmsNotFoundException(x) => "KMSNotFoundException: ${x:?}"
    KmsOptInRequired(x) => "KMSOptInRequired: ${x:?}"
    KmsThrottlingException(x) => "KMSThrottlingException: ${x:?}"
    InternalFailureException(x) => "InternalFailureException: ${x:?}"
    Api(x) => x.display()
    Read(msg) => "event stream: ${msg}"
  }
}

fn event_subscribe_to_shard_event_stream(t: Str, m: eventstream.Message) -> SubscribeToShardEventStream ! Str {
  match t {
    "SubscribeToShardEvent" => Ok(SubscribeToShardEventStream.SubscribeToShardEvent(event_read_subscribe_to_shard_event(m)?))
