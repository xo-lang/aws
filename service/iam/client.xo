fn xml_write_user(var w: xmlv.Writer, v: User, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.path {
    xmlv.elem(w, "Path", x, [])
  }
  if let Some(x) = v.user_name {
    xmlv.elem(w, "UserName", x, [])
  }
  if let Some(x) = v.user_id {
    xmlv.elem(w, "UserId", x, [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "Arn", x, [])
  }
  if let Some(x) = v.create_date {
    xmlv.elem(w, "CreateDate", rest.date_time(x), [])
  }
  if let Some(x) = v.password_last_used {
    xmlv.elem(w, "PasswordLastUsed", rest.date_time(x), [])
  }
  if let Some(x) = v.permissions_boundary {
    xml_write_attached_permissions_boundary(w, x, "PermissionsBoundary", [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list_type(w, x, "Tags", [])
  }
  xmlv.end(w, name)
}

fn xml_read_user(e: xml.Element) -> User ! Str {
  var out = User{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Path" => out.path = c.text()
      "UserName" => out.user_name = c.text()
      "UserId" => out.user_id = c.text()
      "Arn" => out.arn = c.text()
      "CreateDate" => out.create_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PasswordLastUsed" => out.password_last_used = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PermissionsBoundary" => out.permissions_boundary = xml_read_attached_permissions_boundary(c)?
      "Tags" => out.tags = xml_read_tag_list_type(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_user_detail(var w: xmlv.Writer, v: UserDetail, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.path {
    xmlv.elem(w, "Path", x, [])
  }
