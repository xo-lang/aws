  pub message: Str? = None
}

pub enum VoiceEngine: Str {
  Standard = "standard"
  Neural = "neural"
  LongForm = "long-form"
  Generative = "generative"
  Unknown(value: Str)
}

/// Defines settings for using an Amazon Polly voice to communicate with a
/// user. Valid values include: standard neural long-form generative
pub struct VoiceSettings {
  /// Indicates the type of Amazon Polly voice that Amazon Lex should use for
  /// voice interaction with the user. For more information, see the engine
  /// parameter of the SynthesizeSpeech operation in the Amazon Polly
  /// developer guide . If you do not specify a value, the default is standard
  /// .
  pub engine: VoiceEngine? = None
  /// The identifier of the Amazon Polly voice to use.
  pub voice_id: Str? = None
}

/// Specifies the prompts that Amazon Lex uses while a bot is waiting for
/// customer input.
pub struct WaitAndContinueSpecification {
  /// The response that Amazon Lex sends to indicate that the bot is waiting
  /// for the conversation to continue. Required unless the bot locale's
  /// assistedNluMode is DialogManager .
  pub waiting_response: ResponseSpecification? = None
  /// The response that Amazon Lex sends to indicate that the bot is ready to
  /// continue the conversation. Required unless the bot locale's
  /// assistedNluMode is DialogManager .
  pub continue_response: ResponseSpecification? = None
  /// A response that Amazon Lex sends periodically to the user to indicate
  /// that the bot is still waiting for input from the user.
  pub still_waiting_response: StillWaitingResponseSpecification? = None
  /// Specifies whether the bot will wait for a user to respond. When this
  /// field is false, wait and continue responses for a slot aren't used. If
  /// the active field isn't specified, the default is true.
  pub active: Bool? = None
}
