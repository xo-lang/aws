  pub data_compression_type: OpenZFSDataCompressionType? = None
  /// A Boolean value indicating whether tags for the volume should be copied
  /// to snapshots. This value defaults to false . If this value is set to
  /// true , and you do not specify any tags, all tags for the original volume
