fn xml_read_target_group(e: xml.Element) -> TargetGroup ! Str {
  var out = TargetGroup{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TargetGroupArn" => out.target_group_arn = c.text()
      "TargetGroupName" => out.target_group_name = c.text()
      "Protocol" => out.protocol = ProtocolEnum.from(c.text())
      "Port" => out.port = xmlv.read_int(c.text())?
      "VpcId" => out.vpc_id = c.text()
      "HealthCheckProtocol" => out.health_check_protocol = ProtocolEnum.from(c.text())
      "HealthCheckPort" => out.health_check_port = c.text()
      "HealthCheckEnabled" => out.health_check_enabled = xmlv.read_bool(c.text())?
      "HealthCheckIntervalSeconds" => out.health_check_interval_seconds = xmlv.read_int(c.text())?
      "HealthCheckTimeoutSeconds" => out.health_check_timeout_seconds = xmlv.read_int(c.text())?
      "HealthyThresholdCount" => out.healthy_threshold_count = xmlv.read_int(c.text())?
      "UnhealthyThresholdCount" => out.unhealthy_threshold_count = xmlv.read_int(c.text())?
      "HealthCheckPath" => out.health_check_path = c.text()
      "Matcher" => out.matcher = xml_read_matcher(c)?
      "LoadBalancerArns" => out.load_balancer_arns = xml_read_load_balancer_arns(c)?
      "TargetType" => out.target_type = TargetTypeEnum.from(c.text())
      "ProtocolVersion" => out.protocol_version = c.text()
      "IpAddressType" => out.ip_address_type = TargetGroupIpAddressTypeEnum.from(c.text())
      "TargetControlPort" => out.target_control_port = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

