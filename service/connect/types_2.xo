/// render the view.
pub struct View {
  /// The identifier of the view.
  pub id: Str? = None
  /// The Amazon Resource Name (ARN) of the view.
  pub arn: Str? = None
  /// The name of the view.
  pub name: Str? = None
  /// Indicates the view status as either SAVED or PUBLISHED . The PUBLISHED
  /// status will initiate validation on the content.
  pub status: ViewStatus? = None
  /// The type of the view - CUSTOMER_MANAGED .
  pub type_value: ViewType? = None
  /// The description of the view.
  pub description: Str? = None
  /// Current version of the view.
  pub version: Int? = None
  /// The description of the version.
  pub version_description: Str? = None
  /// View content containing all content necessary to render a view except
  /// for runtime input data.
  pub content: ViewContent? = None
  /// The tags associated with the view resource (not specific to view
  /// version).
  pub tags: Map[Str, Str]? = None
  /// The timestamp of when the view was created.
  pub created_time: Time? = None
  /// Latest timestamp of the UpdateViewContent or CreateViewVersion
  /// operations.
  pub last_modified_time: Time? = None
  /// Indicates the checksum value of the latest published view content.
  pub view_content_sha256: Str? = None
}

/// View content containing all content necessary to render a view except
/// for runtime input data.
pub struct ViewContent {
  /// The data schema matching data that the view template must be provided to
  /// render.
  pub input_schema: Str? = None
  /// The view template representing the structure of the view.
  pub template: Str? = None
  /// A list of possible actions from the view.
  pub actions: List[Str]? = None
}

/// View content containing all content necessary to render a view except
/// for runtime input data and the runtime input schema, which is
/// auto-generated by this operation.
pub struct ViewInputContent {
  /// The view template representing the structure of the view.
  pub template: Str? = None
  /// A list of possible actions from the view.
  pub actions: List[Str]? = None
}

/// Defines the search criteria for filtering views.
pub struct ViewSearchCriteria {
  /// A list of conditions to be met, where at least one condition must be
  /// satisfied.
  pub or_conditions: List[ViewSearchCriteria]? = None
  /// A list of conditions that must all be satisfied.
  pub and_conditions: List[ViewSearchCriteria]? = None
  pub string_condition: StringCondition? = None
  /// A condition that filters views by their type.
  pub view_type_condition: ViewType? = None
  /// A condition that filters views by their status.
  pub view_status_condition: ViewStatus? = None
}

/// Defines filters to apply when searching for views, such as tag-based
/// filters.
pub struct ViewSearchFilter {
  pub attribute_filter: ControlPlaneAttributeFilter? = None
}

pub enum ViewStatus: Str {
  Published = "PUBLISHED"
  Saved = "SAVED"
  Unknown(value: Str)
}

/// A summary of a view's metadata.
pub struct ViewSummary {
  /// The identifier of the view.
  pub id: Str? = None
  /// The Amazon Resource Name (ARN) of the view.
  pub arn: Str? = None
  /// The name of the view.
  pub name: Str? = None
  /// The type of the view.
  pub type_value: ViewType? = None
  /// Indicates the view status as either SAVED or PUBLISHED . The PUBLISHED
  /// status will initiate validation on the content.
  pub status: ViewStatus? = None
  /// The description of the view.
  pub description: Str? = None
}

pub enum ViewType: Str {
  CustomerManaged = "CUSTOMER_MANAGED"
  AwsManaged = "AWS_MANAGED"
  Unknown(value: Str)
}

/// A summary of a view version's metadata.
pub struct ViewVersionSummary {
  /// The identifier of the view version.
  pub id: Str? = None
  /// The Amazon Resource Name (ARN) of the view version.
  pub arn: Str? = None
  /// The description of the view version.
  pub description: Str? = None
  /// The name of the view version.
  pub name: Str? = None
  /// The type of the view version.
  pub type_value: ViewType? = None
  /// The sequentially incremented version of the view version.
  pub version: Int? = None
  /// The description of the view version.
  pub version_description: Str? = None
}

pub enum Visibility: Str {
  All = "ALL"
  Assigned = "ASSIGNED"
  None = "NONE"
  Unknown(value: Str)
}

/// Contains information about a custom vocabulary.
pub struct Vocabulary {
  /// A unique name of the custom vocabulary.
  pub name: Str? = None
  /// The identifier of the custom vocabulary.
  pub id: Str? = None
  /// The Amazon Resource Name (ARN) of the custom vocabulary.
  pub arn: Str? = None
  /// The language code of the vocabulary entries. For a list of languages and
  /// their corresponding language codes, see What is Amazon Transcribe?
  pub language_code: VocabularyLanguageCode? = None
  /// The current state of the custom vocabulary.
  pub state: VocabularyState? = None
  /// The timestamp when the custom vocabulary was last modified.
  pub last_modified_time: Time? = None
  /// The reason why the custom vocabulary was not created.
  pub failure_reason: Str? = None
  /// The content of the custom vocabulary in plain-text format with a table
  /// of values. Each row in the table represents a word or a phrase,
  /// described with Phrase , IPA , SoundsLike , and DisplayAs fields.
  /// Separate the fields with TAB characters. For more information, see
  /// Create a custom vocabulary using a table .
  pub content: Str? = None
  /// The tags used to organize, track, or control access for this resource.
  /// For example, { "Tags": {"key1":"value1", "key2":"value2"} }.
  pub tags: Map[Str, Str]? = None
}

