fn json_of_method(v: Method) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.http_method {
    fs.push(("httpMethod", json.Value.Str(x)))
  }
  if let Some(x) = v.authorization_type {
