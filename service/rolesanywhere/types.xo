  /// specify an empty string. To keep the current alias, omit this parameter.
  /// An alias name contains 1 to 256 characters. It must begin with a letter
  /// (A-Z or a-z). It can contain only letters (A-Z and a-z), numbers (0-9),
  /// underscores (_), hyphens (-), and forward slashes (/). A forward slash
  /// can appear only between two other characters, so an alias name can't end
  /// with a forward slash or contain two in a row. Alias names that begin
  /// with aws/ , in any combination of uppercase and lowercase letters, are
  /// reserved. Alias names are case sensitive. The alias name must be unique
  /// among resources of the same type in your account and Region. If another
  /// resource of the same type already has the alias, the request fails with
  /// a ValidationException . An invalid or reserved alias name also causes a
  /// ValidationException .
  pub alias_name: Str? = None
}

pub struct UpdateProfileRequest {
  /// The profile to act on. You can specify one of the following: The profile
  /// ID. The profile ARN. The alias ARN of the profile. An ARN must be for a
  /// profile in your account and Region.
  pub profile_id: Str? = None
  /// The name of the profile.
  pub name: Str? = None
  /// A session policy that applies to the trust boundary of the vended
  /// session credentials.
  pub session_policy: Str? = None
  /// A list of IAM roles that this profile can assume in a temporary
  /// credential request.
  pub role_arns: List[Str]? = None
  /// A list of managed policy ARNs that apply to the vended session
  /// credentials.
  pub managed_policy_arns: List[Str]? = None
  /// Used to determine how long sessions vended using this profile are valid
  /// for. See the Expiration section of the CreateSession API documentation
  /// page for more details. In requests, if this value is not provided, the
  /// default value will be 3600.
  pub duration_seconds: Int? = None
  /// Used to determine if a custom role session name will be accepted in a
  /// temporary credential request.
  pub accept_role_session_name: Bool? = None
  /// The alias for the profile. You can use this parameter in the following
  /// ways: To set or change the alias, specify the new alias name. After the
  /// change, the previous alias ARN no longer identifies the resource. You
  /// can then assign the previous alias to another resource of the same type.
  /// A change can take a short time to take effect for requests that use an
  /// alias ARN. To remove the alias, specify an empty string. To keep the
  /// current alias, omit this parameter. An alias name contains 1 to 256
  /// characters. It must begin with a letter (A-Z or a-z). It can contain
  /// only letters (A-Z and a-z), numbers (0-9), underscores (_), hyphens (-),
  /// and forward slashes (/). A forward slash can appear only between two
  /// other characters, so an alias name can't end with a forward slash or
  /// contain two in a row. Alias names that begin with aws/ , in any
  /// combination of uppercase and lowercase letters, are reserved. Alias
  /// names are case sensitive. The alias name must be unique among resources
  /// of the same type in your account and Region. If another resource of the
  /// same type already has the alias, the request fails with a
  /// ValidationException . An invalid or reserved alias name also causes a
  /// ValidationException .
  pub alias_name: Str? = None
  /// The trusted identity propagation (TIP) settings for the profile. The
  /// settings that you specify replace the current settings, and a field that
  /// you omit returns to its default. If you omit this parameter, the TIP
  /// settings don't change.
  pub tip_configuration: TipConfiguration? = None
}

pub struct UpdateTrustAnchorRequest {
  /// The trust anchor to act on. You can specify one of the following: The
  /// trust anchor ID. The trust anchor ARN. The alias ARN of the trust
  /// anchor. An ARN must be for a trust anchor in your account and Region.
