  var out: List[StorageConfiguration] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_storage_configuration(fv)?)
  }
  Ok(out)
}

