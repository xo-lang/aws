fn xml_write_db_proxy(var w: xmlv.Writer, v: DBProxy, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.db_proxy_name {
    xmlv.elem(w, "DBProxyName", x, [])
  }
  if let Some(x) = v.db_proxy_arn {
    xmlv.elem(w, "DBProxyArn", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.engine_family {
    xmlv.elem(w, "EngineFamily", x, [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "VpcId", x, [])
  }
  if let Some(x) = v.vpc_security_group_ids {
    xml_write_string_list(w, x, "VpcSecurityGroupIds", [])
  }
  if let Some(x) = v.vpc_subnet_ids {
    xml_write_string_list(w, x, "VpcSubnetIds", [])
  }
  if let Some(x) = v.default_auth_scheme {
    xmlv.elem(w, "DefaultAuthScheme", x, [])
  }
  if let Some(x) = v.auth {
    xml_write_user_auth_config_info_list(w, x, "Auth", [])
  }
  if let Some(x) = v.role_arn {
    xmlv.elem(w, "RoleArn", x, [])
  }
  if let Some(x) = v.endpoint {
    xmlv.elem(w, "Endpoint", x, [])
  }
  if let Some(x) = v.require_tls {
    xmlv.elem(w, "RequireTLS", "${x}", [])
  }
  if let Some(x) = v.idle_client_timeout {
    xmlv.elem(w, "IdleClientTimeout", "${x}", [])
  }
  if let Some(x) = v.debug_logging {
    xmlv.elem(w, "DebugLogging", "${x}", [])
  }
  if let Some(x) = v.created_date {
    xmlv.elem(w, "CreatedDate", rest.date_time(x), [])
  }
  if let Some(x) = v.updated_date {
    xmlv.elem(w, "UpdatedDate", rest.date_time(x), [])
  }
  if let Some(x) = v.endpoint_network_type {
    xmlv.elem(w, "EndpointNetworkType", x.value(), [])
  }
  if let Some(x) = v.target_connection_network_type {
    xmlv.elem(w, "TargetConnectionNetworkType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_db_proxy(e: xml.Element) -> DBProxy ! Str {
  var out = DBProxy{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DBProxyName" => out.db_proxy_name = c.text()
      "DBProxyArn" => out.db_proxy_arn = c.text()
      "Status" => out.status = DBProxyStatus.from(c.text())
      "EngineFamily" => out.engine_family = c.text()
      "VpcId" => out.vpc_id = c.text()
      "VpcSecurityGroupIds" => out.vpc_security_group_ids = xml_read_string_list(c)?
      "VpcSubnetIds" => out.vpc_subnet_ids = xml_read_string_list(c)?
      "DefaultAuthScheme" => out.default_auth_scheme = c.text()
      "Auth" => out.auth = xml_read_user_auth_config_info_list(c)?
      "RoleArn" => out.role_arn = c.text()
      "Endpoint" => out.endpoint = c.text()
      "RequireTLS" => out.require_tls = xmlv.read_bool(c.text())?
      "IdleClientTimeout" => out.idle_client_timeout = xmlv.read_int(c.text())?
      "DebugLogging" => out.debug_logging = xmlv.read_bool(c.text())?
      "CreatedDate" => out.created_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UpdatedDate" => out.updated_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EndpointNetworkType" => out.endpoint_network_type = EndpointNetworkType.from(c.text())
      "TargetConnectionNetworkType" => out.target_connection_network_type = TargetConnectionNetworkType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

