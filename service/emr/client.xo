fn json_of_session(v: Session) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.cluster_id {
    fs.push(("ClusterId", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.state {
    fs.push(("State", json.Value.Str(x.value())))
  }
  if let Some(x) = v.state_change_reason {
    fs.push(("StateChangeReason", json.Value.Str(x)))
  }
  if let Some(x) = v.release_label {
    fs.push(("ReleaseLabel", json.Value.Str(x)))
  }
  if let Some(x) = v.execution_role_arn {
    fs.push(("ExecutionRoleArn", json.Value.Str(x)))
  }
  if let Some(x) = v.account_id {
    fs.push(("AccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("UpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.started_at {
    fs.push(("StartedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.ended_at {
    fs.push(("EndedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.idle_since {
    fs.push(("IdleSince", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.engine_configurations {
    fs.push(("EngineConfigurations", json_of_configuration_list(x)))
  }
  if let Some(x) = v.monitoring_configuration {
