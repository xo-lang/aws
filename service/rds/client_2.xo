fn query_put_db_engine_version_list(var f: query.Form, prefix: Str, v: List[DBEngineVersion], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.DBEngineVersion.${i + 1}" }
    query_put_db_engine_version(f, k, x)
  }
}

fn query_put_db_engine_version_message(var f: query.Form, prefix: Str, v: DBEngineVersionMessage) {
  if let Some(x) = v.marker {
    query.add(f, query.key(prefix, "Marker"), x)
  }
  if let Some(x) = v.db_engine_versions {
    query_put_db_engine_version_list(f, query.key(prefix, "DBEngineVersions"), x, false)
  }
}

