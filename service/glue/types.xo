  QueryParams = "QUERY_PARAMS"
  FilterString = "FILTER_STRING"
  Unknown(value: Str)
}

pub enum FilterOperation: Str {
  Eq = "EQ"
  Lt = "LT"
  Gt = "GT"
  Lte = "LTE"
  Gte = "GTE"
  Regex = "REGEX"
  Isnull = "ISNULL"
  Unknown(value: Str)
}

pub enum FilterOperator: Str {
  Gt = "GT"
  Ge = "GE"
  Lt = "LT"
  Le = "LE"
  Eq = "EQ"
  Ne = "NE"
  Unknown(value: Str)
}

/// Configuration that defines per-field overrides for filter behavior,
