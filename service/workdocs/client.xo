fn json_of_user(v: User) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.username {
    fs.push(("Username", json.Value.Str(x)))
  }
  if let Some(x) = v.email_address {
    fs.push(("EmailAddress", json.Value.Str(x)))
  }
  if let Some(x) = v.given_name {
    fs.push(("GivenName", json.Value.Str(x)))
  }
  if let Some(x) = v.surname {
    fs.push(("Surname", json.Value.Str(x)))
  }
  if let Some(x) = v.organization_id {
    fs.push(("OrganizationId", json.Value.Str(x)))
  }
  if let Some(x) = v.root_folder_id {
    fs.push(("RootFolderId", json.Value.Str(x)))
  }
  if let Some(x) = v.recycle_bin_folder_id {
    fs.push(("RecycleBinFolderId", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.created_timestamp {
    fs.push(("CreatedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.modified_timestamp {
    fs.push(("ModifiedTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.time_zone_id {
    fs.push(("TimeZoneId", json.Value.Str(x)))
  }
  if let Some(x) = v.locale {
    fs.push(("Locale", json.Value.Str(x.value())))
  }
  if let Some(x) = v.storage {
    fs.push(("Storage", json_of_user_storage_metadata(x)))
  }
  json.Value.Object(fs)
}

fn from_json_user(v: json.Value) -> User ! Str {
  var out = User{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Id" => out.id = jsonv.read_str(fv)?
      "Username" => out.username = jsonv.read_str(fv)?
      "EmailAddress" => out.email_address = jsonv.read_str(fv)?
      "GivenName" => out.given_name = jsonv.read_str(fv)?
      "Surname" => out.surname = jsonv.read_str(fv)?
      "OrganizationId" => out.organization_id = jsonv.read_str(fv)?
      "RootFolderId" => out.root_folder_id = jsonv.read_str(fv)?
      "RecycleBinFolderId" => out.recycle_bin_folder_id = jsonv.read_str(fv)?
      "Status" => out.status = UserStatusType.from(jsonv.read_str(fv)?)
      "Type" => out.type_value = UserType.from(jsonv.read_str(fv)?)
      "CreatedTimestamp" => out.created_timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "ModifiedTimestamp" => out.modified_timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "TimeZoneId" => out.time_zone_id = jsonv.read_str(fv)?
      "Locale" => out.locale = LocaleType.from(jsonv.read_str(fv)?)
      "Storage" => out.storage = from_json_user_storage_metadata(fv)?
      _ => {}
    }
  }
  Ok(out)
}

