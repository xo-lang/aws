    xmlv.elem(w, "DiskImageFormat", x.value(), [])
  }
  if let Some(x) = v.dry_run {
    xmlv.elem(w, "DryRun", "${x}", [])
  }
  if let Some(x) = v.image_id {
    xmlv.elem(w, "ImageId", x, [])
  }
  if let Some(x) = v.s3_export_location {
