  let _ = input
  base
}

/// The HTTP request of CreateAccessPoint.
pub fn serialize_create_access_point(ep: rest.Endpoint, input: CreateAccessPointRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.client_token {
    fs.push(("ClientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("ClientToken", json.Value.Str(idempotency_token)))
  }
  if let Some(x) = input.tags {
    fs.push(("Tags", json_of_tags(x)))
  }
  if let Some(x) = input.file_system_id {
    fs.push(("FileSystemId", json.Value.Str(x)))
  }
  if let Some(x) = input.posix_user {
    fs.push(("PosixUser", json_of_posix_user(x)))
  }
  if let Some(x) = input.root_directory {
    fs.push(("RootDirectory", json_of_root_directory(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
