/// Updates the webhook associated with an CodeBuild build project. If you
/// use Bitbucket for your repository, rotateSecret is ignored.
pub fn (c: Client) update_webhook(input: UpdateWebhookInput) -> UpdateWebhookOutput ! UpdateWebhookErr uses (net.dial, clock, rand) {
