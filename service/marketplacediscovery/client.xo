    PaymentScheduleTerm(x) => json.Value.Object([("paymentScheduleTerm", json_of_payment_schedule_term(x))])
    RecurringPaymentTerm(x) => json.Value.Object([("recurringPaymentTerm", json_of_recurring_payment_term(x))])
    RenewalTerm(x) => json.Value.Object([("renewalTerm", json_of_renewal_term(x))])
    SupportTerm(x) => json.Value.Object([("supportTerm", json_of_support_term(x))])
    UsageBasedPricingTerm(x) => json.Value.Object([("usageBasedPricingTerm", json_of_usage_based_pricing_term(x))])
