/// Edits a campaign in place. Partial update: an omitted field is left
/// unchanged, which is the standard meaning of an `Update` verb — a full
/// replacement would be a `Put`. Change-only, with no way to clear a field
/// back to empty, because the campaign's file members cannot round-trip:
/// they are written as an `s3://` reference and read back as a URL or as
/// metadata, so a replacement payload could not resend an unchanged
/// recipient list without re-uploading it. Refused while an activation task
/// runs (`CAMPAIGN_ACTIVATION_IN_PROGRESS`) and once the campaign is
/// completed (`CAMPAIGN_COMPLETED`, the UTC date is after its `EndOn`).
/// Last-writer-wins, with no concurrency token: this is low-contention
/// metadata owned by one partner.
pub fn (c: Client) update_campaign(input: UpdateCampaignRequest) -> UpdateCampaignResponse ! UpdateCampaignErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_campaign(c.params, input)) ?? e => return Err(UpdateCampaignErr.InvalidInput(e))
  var req = serialize_update_campaign(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateCampaignErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateCampaignErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_campaign_error(resp))
  }
  deserialize_update_campaign(resp) ?? e => Err(UpdateCampaignErr.Deserialize(e))
}

