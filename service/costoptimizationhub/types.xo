}

pub enum PaymentOption: Str {
  AllUpfront = "AllUpfront"
  PartialUpfront = "PartialUpfront"
  NoUpfront = "NoUpfront"
  Unknown(value: Str)
}

/// The preferred configuration for Reserved Instances and Savings Plans
/// commitment-based discounts, consisting of a payment option and a
/// commitment duration.
pub struct PreferredCommitment {
  /// The preferred length of the commitment period. If the value is null, it
  /// will default to ThreeYears (highest savings) where applicable.
  pub term: Term? = None
  /// The preferred upfront payment structure for commitments. If the value is
  /// null, it will default to AllUpfront (highest savings) where applicable.
  pub payment_option: PaymentOption? = None
}

