fn json_of_destination_target(v: DestinationTarget) -> json.Value {
  match v {
    S3(x) => json.Value.Object([("s3", json_of_s3_target(x))])
    Github(x) => json.Value.Object([("github", json_of_git_hub_target(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_destination_target(v: json.Value) -> DestinationTarget ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "s3" => Ok(DestinationTarget.S3(from_json_s3_target(fv)?))
      "github" => Ok(DestinationTarget.Github(from_json_git_hub_target(fv)?))
      _ => Ok(DestinationTarget.Unknown(k))
    }
  }
  Err("DestinationTarget: no member set")
}

