fn json_of_reference_summary(v: ReferenceSummary) -> json.Value {
  match v {
    Url(x) => json.Value.Object([("Url", json_of_url_reference(x))])
    Attachment(x) => json.Value.Object([("Attachment", json_of_attachment_reference(x))])
    EmailMessage(x) => json.Value.Object([("EmailMessage", json_of_email_message_reference(x))])
    EmailMessageRedacted(x) => json.Value.Object([("EmailMessageRedacted", json_of_email_message_reference(x))])
    EmailMessagePlainText(x) => json.Value.Object([("EmailMessagePlainText", json_of_email_message_reference(x))])
    EmailMessagePlainTextRedacted(x) => json.Value.Object([("EmailMessagePlainTextRedacted", json_of_email_message_reference(x))])
    String(x) => json.Value.Object([("String", json_of_string_reference(x))])
    Number(x) => json.Value.Object([("Number", json_of_number_reference(x))])
    Date(x) => json.Value.Object([("Date", json_of_date_reference(x))])
    Email(x) => json.Value.Object([("Email", json_of_email_reference(x))])
    ContactAnalysis(x) => json.Value.Object([("ContactAnalysis", json_of_contact_analysis_reference(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_reference_summary(v: json.Value) -> ReferenceSummary ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "Url" => Ok(ReferenceSummary.Url(from_json_url_reference(fv)?))
      "Attachment" => Ok(ReferenceSummary.Attachment(from_json_attachment_reference(fv)?))
      "EmailMessage" => Ok(ReferenceSummary.EmailMessage(from_json_email_message_reference(fv)?))
      "EmailMessageRedacted" => Ok(ReferenceSummary.EmailMessageRedacted(from_json_email_message_reference(fv)?))
      "EmailMessagePlainText" => Ok(ReferenceSummary.EmailMessagePlainText(from_json_email_message_reference(fv)?))
      "EmailMessagePlainTextRedacted" => Ok(ReferenceSummary.EmailMessagePlainTextRedacted(from_json_email_message_reference(fv)?))
      "String" => Ok(ReferenceSummary.String(from_json_string_reference(fv)?))
      "Number" => Ok(ReferenceSummary.Number(from_json_number_reference(fv)?))
      "Date" => Ok(ReferenceSummary.Date(from_json_date_reference(fv)?))
      "Email" => Ok(ReferenceSummary.Email(from_json_email_reference(fv)?))
      "ContactAnalysis" => Ok(ReferenceSummary.ContactAnalysis(from_json_contact_analysis_reference(fv)?))
      _ => Ok(ReferenceSummary.Unknown(k))
    }
  }
  Err("ReferenceSummary: no member set")
}

