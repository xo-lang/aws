  var out = PendingModifiedValues{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "NumCacheNodes" => out.num_cache_nodes = xmlv.read_int(c.text())?
      "CacheNodeIdsToRemove" => out.cache_node_ids_to_remove = xml_read_cache_node_ids_list(c)?
      "EngineVersion" => out.engine_version = c.text()
      "CacheNodeType" => out.cache_node_type = c.text()
      "AuthTokenStatus" => out.auth_token_status = AuthTokenUpdateStatus.from(c.text())
      "LogDeliveryConfigurations" => out.log_delivery_configurations = xml_read_pending_log_delivery_configuration_list(c)?
      "TransitEncryptionEnabled" => out.transit_encryption_enabled = xmlv.read_bool(c.text())?
      "TransitEncryptionMode" => out.transit_encryption_mode = TransitEncryptionMode.from(c.text())
      "ScaleConfig" => out.scale_config = xml_read_scale_config(c)?
      _ => {}
    }
  }
  Ok(out)
}

