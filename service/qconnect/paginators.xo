/// while the last page carried a new token.
pub fn (p: SearchQuickResponsesPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: SearchQuickResponsesPaginator) next_page() -> SearchQuickResponsesResponse ! SearchQuickResponsesErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.search_quick_responses(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}

/// The pages of SearchSessions. Each `next_page` sends the input with
/// the previous page's nextToken as its
/// nextToken.
pub struct SearchSessionsPaginator {
  client: Client
  input: SearchSessionsRequest
  first: Bool = true
  more: Bool = true
}

pub fn new_search_sessions_paginator(c: Client, input: SearchSessionsRequest) -> SearchSessionsPaginator {
  SearchSessionsPaginator{client: c, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: SearchSessionsPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: SearchSessionsPaginator) next_page() -> SearchSessionsResponse ! SearchSessionsErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.search_sessions(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
