  pub job_id: Str? = None
  /// The Amazon Resource Name (ARN) of the entities detection job. It is a
  /// unique, fully qualified identifier for the job. It includes the Amazon
  /// Web Services account, Amazon Web Services Region, and the job ID. The
  /// format of the ARN is as follows: arn: :comprehend: :
  /// :entities-detection-job/ The following is an example job ARN:
  /// arn:aws:comprehend:us-west-2:111122223333:entities-detection-job/1234abcd12ab34cd56ef1234567890ab
  pub job_arn: Str? = None
  /// The name that you assigned the entities detection job.
  pub job_name: Str? = None
  /// The current status of the entities detection job. If the status is
  /// FAILED , the Message field shows the reason for the failure.
  pub job_status: JobStatus? = None
  /// A description of the status of a job.
  pub message: Str? = None
  /// The time that the entities detection job was submitted for processing.
  pub submit_time: Time? = None
  /// The time that the entities detection job completed
  pub end_time: Time? = None
  /// The Amazon Resource Name (ARN) that identifies the entity recognizer.
  pub entity_recognizer_arn: Str? = None
  /// The input data configuration that you supplied when you created the
  /// entities detection job.
  pub input_data_config: InputDataConfig? = None
  /// The output data configuration that you supplied when you created the
  /// entities detection job.
  pub output_data_config: OutputDataConfig? = None
  /// The language code of the input documents.
  pub language_code: LanguageCode? = None
  /// The Amazon Resource Name (ARN) of the IAM role that grants Amazon
  /// Comprehend read access to your input data.
  pub data_access_role_arn: Str? = None
  /// ID for the Amazon Web Services Key Management Service (KMS) key that
  /// Amazon Comprehend uses to encrypt data on the storage volume attached to
  /// the ML compute instance(s) that process the analysis job. The
  /// VolumeKmsKeyId can be either of the following formats: KMS Key ID:
  /// "1234abcd-12ab-34cd-56ef-1234567890ab" Amazon Resource Name (ARN) of a
  /// KMS Key:
  /// "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
  pub volume_kms_key_id: Str? = None
  /// Configuration parameters for a private Virtual Private Cloud (VPC)
  /// containing the resources you are using for your entity detection job.
  /// For more information, see Amazon VPC .
  pub vpc_config: VpcConfig? = None
  /// The Amazon Resource Name (ARN) of the flywheel associated with this job.
  pub flywheel_arn: Str? = None
}

/// Provides information about an entity.
pub struct Entity {
  /// The level of confidence that Amazon Comprehend has in the accuracy of
  /// the detection.
  pub score: Float? = None
  /// The entity type. For entity detection using the built-in model, this
  /// field contains one of the standard entity types listed below. For custom
  /// entity detection, this field contains one of the entity types that you
  /// specified when you trained your custom model.
  pub type_value: EntityType? = None
  /// The text of the entity.
  pub text: Str? = None
  /// The zero-based offset from the beginning of the source text to the first
  /// character in the entity. This field is empty for non-text input.
  pub begin_offset: Int? = None
  /// The zero-based offset from the beginning of the source text to the last
  /// character in the entity. This field is empty for non-text input.
  pub end_offset: Int? = None
  /// A reference to each block for this entity. This field is empty for
  /// plain-text input.
  pub block_references: List[BlockReference]? = None
}

/// Specifies one of the label or labels that categorize the personally
/// identifiable information (PII) entity being analyzed.
pub struct EntityLabel {
  /// The name of the label.
  pub name: PiiEntityType? = None
  /// The level of confidence that Amazon Comprehend has in the accuracy of
  /// the detection.
  pub score: Float? = None
}

/// Configuration required for an entity recognition model.
pub struct EntityRecognitionConfig {
  /// Up to 25 entity types that the model is trained to recognize.
  pub entity_types: List[EntityTypesListItem]? = None
}

/// Describes the annotations associated with a entity recognizer.
pub struct EntityRecognizerAnnotations {
  /// Specifies the Amazon S3 location where the annotations for an entity
  /// recognizer are located. The URI must be in the same Region as the API
  /// endpoint that you are calling.
  pub s3_uri: Str? = None
  /// Specifies the Amazon S3 location where the test annotations for an
  /// entity recognizer are located. The URI must be in the same Region as the
  /// API endpoint that you are calling.
  pub test_s3_uri: Str? = None
}

pub enum EntityRecognizerDataFormat: Str {
  ComprehendCsv = "COMPREHEND_CSV"
  AugmentedManifest = "AUGMENTED_MANIFEST"
  Unknown(value: Str)
}

/// Describes the training documents submitted with an entity recognizer.
pub struct EntityRecognizerDocuments {
  /// Specifies the Amazon S3 location where the training documents for an
  /// entity recognizer are located. The URI must be in the same Region as the
  /// API endpoint that you are calling.
  pub s3_uri: Str? = None
  /// Specifies the Amazon S3 location where the test documents for an entity
  /// recognizer are located. The URI must be in the same Amazon Web Services
  /// Region as the API endpoint that you are calling.
  pub test_s3_uri: Str? = None
  /// Specifies how the text in an input file should be processed. This is
  /// optional, and the default is ONE_DOC_PER_LINE. ONE_DOC_PER_FILE - Each
  /// file is considered a separate document. Use this option when you are
  /// processing large documents, such as newspaper articles or scientific
  /// papers. ONE_DOC_PER_LINE - Each line in a file is considered a separate
  /// document. Use this option when you are processing many short documents,
  /// such as text messages.
  pub input_format: InputFormat? = None
}

/// Describes the entity list submitted with an entity recognizer.
pub struct EntityRecognizerEntityList {
  /// Specifies the Amazon S3 location where the entity list is located. The
  /// URI must be in the same Region as the API endpoint that you are calling.
  pub s3_uri: Str? = None
}

/// Detailed information about the accuracy of an entity recognizer.
pub struct EntityRecognizerEvaluationMetrics {
  /// A measure of the usefulness of the recognizer results in the test data.
  /// High precision means that the recognizer returned substantially more
  /// relevant results than irrelevant ones.
  pub precision: Float? = None
  /// A measure of how complete the recognizer results are for the test data.
  /// High recall means that the recognizer returned most of the relevant
  /// results.
  pub recall: Float? = None
  /// A measure of how accurate the recognizer results are for the test data.
  /// It is derived from the Precision and Recall values. The F1Score is the
  /// harmonic average of the two scores. For plain text entity recognizer
  /// models, the range is 0 to 100, where 100 is the best score. For PDF/Word
  /// entity recognizer models, the range is 0 to 1, where 1 is the best
  /// score.
  pub f1_score: Float? = None
}

/// Provides information for filtering a list of entity recognizers. You can
/// only specify one filtering parameter in a request. For more information,
/// see the ListEntityRecognizers operation./
pub struct EntityRecognizerFilter {
  /// The status of an entity recognizer.
  pub status: ModelStatus? = None
  /// The name that you assigned the entity recognizer.
  pub recognizer_name: Str? = None
  /// Filters the list of entities based on the time that the list was
  /// submitted for processing. Returns only jobs submitted before the
  /// specified time. Jobs are returned in descending order, newest to oldest.
  pub submit_time_before: Time? = None
  /// Filters the list of entities based on the time that the list was
  /// submitted for processing. Returns only jobs submitted after the
  /// specified time. Jobs are returned in ascending order, oldest to newest.
  pub submit_time_after: Time? = None
}

/// Specifies the format and location of the input data.
pub struct EntityRecognizerInputDataConfig {
  /// The format of your training data: COMPREHEND_CSV : A CSV file that
  /// supplements your training documents. The CSV file contains information
  /// about the custom entities that your trained model will detect. The
  /// required format of the file depends on whether you are providing
  /// annotations or an entity list. If you use this value, you must provide
  /// your CSV file by using either the Annotations or EntityList parameters.
  /// You must provide your training documents by using the Documents
  /// parameter. AUGMENTED_MANIFEST : A labeled dataset that is produced by
  /// Amazon SageMaker Ground Truth. This file is in JSON lines format. Each
  /// line is a complete JSON object that contains a training document and its
  /// labels. Each label annotates a named entity in the training document. If
  /// you use this value, you must provide the AugmentedManifests parameter in
  /// your request. If you don't specify a value, Amazon Comprehend uses
  /// COMPREHEND_CSV as the default.
  pub data_format: EntityRecognizerDataFormat? = None
  /// The entity types in the labeled training data that Amazon Comprehend
  /// uses to train the custom entity recognizer. Any entity types that you
  /// don't specify are ignored. A maximum of 25 entity types can be used at
  /// one time to train an entity recognizer. Entity types must not contain
  /// the following invalid characters: \n (line break), \\n (escaped line
  /// break), \r (carriage return), \\r (escaped carriage return), \t (tab),
  /// \\t (escaped tab), space, and , (comma).
  pub entity_types: List[EntityTypesListItem]? = None
  /// The S3 location of the folder that contains the training documents for
  /// your custom entity recognizer. This parameter is required if you set
  /// DataFormat to COMPREHEND_CSV .
  pub documents: EntityRecognizerDocuments? = None
  /// The S3 location of the CSV file that annotates your training documents.
  pub annotations: EntityRecognizerAnnotations? = None
  /// The S3 location of the CSV file that has the entity list for your custom
  /// entity recognizer.
  pub entity_list: EntityRecognizerEntityList? = None
  /// A list of augmented manifest files that provide training data for your
  /// custom model. An augmented manifest file is a labeled dataset that is
  /// produced by Amazon SageMaker Ground Truth. This parameter is required if
  /// you set DataFormat to AUGMENTED_MANIFEST .
  pub augmented_manifests: List[AugmentedManifestsListItem]? = None
}

/// Detailed information about an entity recognizer.
pub struct EntityRecognizerMetadata {
  /// The number of documents in the input data that were used to train the
  /// entity recognizer. Typically this is 80 to 90 percent of the input
  /// documents.
  pub number_of_trained_documents: Int? = None
  /// The number of documents in the input data that were used to test the
  /// entity recognizer. Typically this is 10 to 20 percent of the input
  /// documents.
  pub number_of_test_documents: Int? = None
  /// Detailed information about the accuracy of an entity recognizer.
  pub evaluation_metrics: EntityRecognizerEvaluationMetrics? = None
  /// Entity types from the metadata of an entity recognizer.
  pub entity_types: List[EntityRecognizerMetadataEntityTypesListItem]? = None
}

/// Individual item from the list of entity types in the metadata of an
/// entity recognizer.
pub struct EntityRecognizerMetadataEntityTypesListItem {
  /// Type of entity from the list of entity types in the metadata of an
  /// entity recognizer.
  pub type_value: Str? = None
  /// Detailed information about the accuracy of the entity recognizer for a
  /// specific item on the list of entity types.
  pub evaluation_metrics: EntityTypesEvaluationMetrics? = None
  /// Indicates the number of times the given entity type was seen in the
  /// training data.
  pub number_of_train_mentions: Int? = None
}

/// Output data configuration.
pub struct EntityRecognizerOutputDataConfig {
  /// The Amazon S3 prefix for the data lake location of the flywheel
  /// statistics.
  pub flywheel_stats_s3_prefix: Str? = None
}

