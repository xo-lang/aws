  pub name: Str? = None
  /// The ARN of the pipe.
  pub arn: Str? = None
  /// The state the pipe should be in.
  pub desired_state: Str? = None
  /// The state the pipe is in.
  pub current_state: Str? = None
  /// The reason the pipe is in its current state.
  pub state_reason: Str? = None
  /// The time the pipe was created.
  pub creation_time: Time? = None
  /// When the pipe was last updated, in ISO-8601 format
  /// (YYYY-MM-DDThh:mm:ss.sTZD).
  pub last_modified_time: Time? = None
  /// The ARN of the source resource.
  pub source: Str? = None
  /// The ARN of the target resource.
  pub target_value: Str? = None
  /// The ARN of the enrichment resource.
  pub enrichment: Str? = None
}

/// These are custom parameter to be used when the target is an API Gateway
/// REST APIs or EventBridge ApiDestinations. In the latter case, these are
/// merged with any InvocationParameters specified on the Connection, with
/// any values from the Connection taking precedence.
pub struct PipeEnrichmentHttpParameters {
  /// The path parameter values to be used to populate API Gateway REST API or
  /// EventBridge ApiDestination path wildcards ("*").
  pub path_parameter_values: List[Str]? = None
  /// The headers that need to be sent as part of request invoking the API
  /// Gateway REST API or EventBridge ApiDestination.
  pub header_parameters: Map[Str, Str]? = None
  /// The query string keys/values that need to be sent as part of request
  /// invoking the API Gateway REST API or EventBridge ApiDestination.
  pub query_string_parameters: Map[Str, Str]? = None
}

/// The parameters required to set up enrichment on your pipe.
pub struct PipeEnrichmentParameters {
  /// Valid JSON text passed to the enrichment. In this case, nothing from the
  /// event itself is passed to the enrichment. For more information, see The
  /// JavaScript Object Notation (JSON) Data Interchange Format . To remove an
  /// input template, specify an empty string.
  pub input_template: Str? = None
  /// Contains the HTTP parameters to use when the target is a API Gateway
  /// REST endpoint or EventBridge ApiDestination. If you specify an API
  /// Gateway REST API or EventBridge ApiDestination as a target, you can use
  /// this parameter to specify headers, path parameters, and query string
  /// keys/values as part of your target invoking request. If you're using
  /// ApiDestinations, the corresponding Connection can also have these values
  /// configured. In case of any conflicting keys, values from the Connection
  /// take precedence.
  pub http_parameters: PipeEnrichmentHttpParameters? = None
}

/// The logging configuration settings for the pipe.
pub struct PipeLogConfiguration {
  /// The Amazon S3 logging configuration settings for the pipe.
  pub s3_log_destination: S3LogDestination? = None
  /// The Amazon Data Firehose logging configuration settings for the pipe.
  pub firehose_log_destination: FirehoseLogDestination? = None
  /// The Amazon CloudWatch Logs logging configuration settings for the pipe.
  pub cloudwatch_logs_log_destination: CloudwatchLogsLogDestination? = None
  /// The level of logging detail to include. This applies to all log
  /// destinations for the pipe.
  pub level: Str? = None
  /// Whether the execution data (specifically, the payload , awsRequest , and
  /// awsResponse fields) is included in the log messages for this pipe. This
  /// applies to all log destinations for the pipe. For more information, see
  /// Including execution data in logs in the Amazon EventBridge User Guide .
  pub include_execution_data: List[Str]? = None
}

/// Specifies the logging configuration settings for the pipe. When you call
/// UpdatePipe , EventBridge updates the fields in the
/// PipeLogConfigurationParameters object atomically as one and overrides
/// existing values. This is by design. If you don't specify an optional
/// field in any of the Amazon Web Services service parameters objects (
/// CloudwatchLogsLogDestinationParameters ,
/// FirehoseLogDestinationParameters , or S3LogDestinationParameters ),
/// EventBridge sets that field to its system-default value during the
/// update. For example, suppose when you created the pipe you specified a
/// Firehose stream log destination. You then update the pipe to add an
/// Amazon S3 log destination. In addition to specifying the
/// S3LogDestinationParameters for the new log destination, you must also
/// specify the fields in the FirehoseLogDestinationParameters object in
/// order to retain the Firehose stream log destination. For more
/// information on generating pipe log records, see Log EventBridge Pipes in
/// the Amazon EventBridge User Guide .
pub struct PipeLogConfigurationParameters {
  /// The Amazon S3 logging configuration settings for the pipe.
  pub s3_log_destination: S3LogDestinationParameters? = None
  /// The Amazon Data Firehose logging configuration settings for the pipe.
  pub firehose_log_destination: FirehoseLogDestinationParameters? = None
  /// The Amazon CloudWatch Logs logging configuration settings for the pipe.
  pub cloudwatch_logs_log_destination: CloudwatchLogsLogDestinationParameters? = None
  /// The level of logging detail to include. This applies to all log
  /// destinations for the pipe. For more information, see Specifying
  /// EventBridge Pipes log level in the Amazon EventBridge User Guide .
  pub level: Str? = None
  /// Specify ALL to include the execution data (specifically, the payload ,
  /// awsRequest , and awsResponse fields) in the log messages for this pipe.
  /// This applies to all log destinations for the pipe. For more information,
  /// see Including execution data in logs in the Amazon EventBridge User
  /// Guide . By default, execution data is not included.
  pub include_execution_data: List[Str]? = None
}

/// The parameters for using an Active MQ broker as a source.
pub struct PipeSourceActiveMQBrokerParameters {
  /// The credentials needed to access the resource.
  pub credentials: MQBrokerAccessCredentials? = None
  /// The name of the destination queue to consume.
  pub queue_name: Str? = None
  /// The maximum number of records to include in each batch.
  pub batch_size: Int? = None
  /// The maximum length of a time to wait for events.
  pub maximum_batching_window_in_seconds: Int? = None
}

/// The parameters for using a DynamoDB stream as a source.
pub struct PipeSourceDynamoDBStreamParameters {
  /// The maximum number of records to include in each batch.
  pub batch_size: Int? = None
  /// Define the target queue to send dead-letter queue events to.
  pub dead_letter_config: DeadLetterConfig? = None
  /// Define how to handle item process failures. AUTOMATIC_BISECT halves each
  /// batch and retry each half until all the records are processed or there
  /// is one failed message left in the batch.
  pub on_partial_batch_item_failure: Str? = None
  /// The maximum length of a time to wait for events.
  pub maximum_batching_window_in_seconds: Int? = None
  /// Discard records older than the specified age. The default value is -1,
  /// which sets the maximum age to infinite. When the value is set to
  /// infinite, EventBridge never discards old records.
  pub maximum_record_age_in_seconds: Int? = None
  /// Discard records after the specified number of retries. The default value
  /// is -1, which sets the maximum number of retries to infinite. When
  /// MaximumRetryAttempts is infinite, EventBridge retries failed records
  /// until the record expires in the event source.
  pub maximum_retry_attempts: Int? = None
  /// The number of batches to process concurrently from each shard. The
  /// default value is 1.
  pub parallelization_factor: Int? = None
  /// The position in a stream from which to start reading.
  pub starting_position: Str? = None
}

/// The parameters for using a Kinesis stream as a source.
pub struct PipeSourceKinesisStreamParameters {
  /// The maximum number of records to include in each batch.
  pub batch_size: Int? = None
  /// Define the target queue to send dead-letter queue events to.
  pub dead_letter_config: DeadLetterConfig? = None
  /// Define how to handle item process failures. AUTOMATIC_BISECT halves each
  /// batch and retry each half until all the records are processed or there
  /// is one failed message left in the batch.
  pub on_partial_batch_item_failure: Str? = None
  /// The maximum length of a time to wait for events.
  pub maximum_batching_window_in_seconds: Int? = None
  /// Discard records older than the specified age. The default value is -1,
  /// which sets the maximum age to infinite. When the value is set to
  /// infinite, EventBridge never discards old records.
  pub maximum_record_age_in_seconds: Int? = None
  /// Discard records after the specified number of retries. The default value
  /// is -1, which sets the maximum number of retries to infinite. When
  /// MaximumRetryAttempts is infinite, EventBridge retries failed records
  /// until the record expires in the event source.
  pub maximum_retry_attempts: Int? = None
  /// The number of batches to process concurrently from each shard. The
  /// default value is 1.
  pub parallelization_factor: Int? = None
  /// The position in a stream from which to start reading.
  pub starting_position: Str? = None
  /// With StartingPosition set to AT_TIMESTAMP , the time from which to start
  /// reading, in Unix time seconds.
  pub starting_position_timestamp: Time? = None
}

/// The parameters for using an MSK stream as a source.
pub struct PipeSourceManagedStreamingKafkaParameters {
  /// The name of the topic that the pipe will read from.
  pub topic_name: Str? = None
  /// The position in a stream from which to start reading.
  pub starting_position: Str? = None
  /// The maximum number of records to include in each batch.
  pub batch_size: Int? = None
  /// The maximum length of a time to wait for events.
  pub maximum_batching_window_in_seconds: Int? = None
  /// The name of the destination queue to consume.
  pub consumer_group_id: Str? = None
  /// The credentials needed to access the resource.
  pub credentials: MSKAccessCredentials? = None
}

/// The parameters required to set up a source for your pipe.
pub struct PipeSourceParameters {
  /// The collection of event patterns used to filter events. To remove a
  /// filter, specify a FilterCriteria object with an empty array of Filter
  /// objects. For more information, see Events and Event Patterns in the
  /// Amazon EventBridge User Guide .
  pub filter_criteria: FilterCriteria? = None
  /// The parameters for using a Kinesis stream as a source.
  pub kinesis_stream_parameters: PipeSourceKinesisStreamParameters? = None
  /// The parameters for using a DynamoDB stream as a source.
  pub dynamo_db_stream_parameters: PipeSourceDynamoDBStreamParameters? = None
  /// The parameters for using a Amazon SQS stream as a source.
  pub sqs_queue_parameters: PipeSourceSqsQueueParameters? = None
  /// The parameters for using an Active MQ broker as a source.
  pub active_mq_broker_parameters: PipeSourceActiveMQBrokerParameters? = None
  /// The parameters for using a Rabbit MQ broker as a source.
  pub rabbit_mq_broker_parameters: PipeSourceRabbitMQBrokerParameters? = None
  /// The parameters for using an MSK stream as a source.
  pub managed_streaming_kafka_parameters: PipeSourceManagedStreamingKafkaParameters? = None
  /// The parameters for using a self-managed Apache Kafka stream as a source.
  /// A self managed cluster refers to any Apache Kafka cluster not hosted by
  /// Amazon Web Services. This includes both clusters you manage yourself, as
  /// well as those hosted by a third-party provider, such as Confluent Cloud
  /// , CloudKarafka , or Redpanda . For more information, see Apache Kafka
  /// streams as a source in the Amazon EventBridge User Guide .
  pub self_managed_kafka_parameters: PipeSourceSelfManagedKafkaParameters? = None
}

/// The parameters for using a Rabbit MQ broker as a source.
pub struct PipeSourceRabbitMQBrokerParameters {
  /// The credentials needed to access the resource.
  pub credentials: MQBrokerAccessCredentials? = None
  /// The name of the destination queue to consume.
  pub queue_name: Str? = None
  /// The name of the virtual host associated with the source broker.
  pub virtual_host: Str? = None
  /// The maximum number of records to include in each batch.
  pub batch_size: Int? = None
  /// The maximum length of a time to wait for events.
  pub maximum_batching_window_in_seconds: Int? = None
}

/// The parameters for using a self-managed Apache Kafka stream as a source.
/// A self managed cluster refers to any Apache Kafka cluster not hosted by
/// Amazon Web Services. This includes both clusters you manage yourself, as
/// well as those hosted by a third-party provider, such as Confluent Cloud
/// , CloudKarafka , or Redpanda . For more information, see Apache Kafka
/// streams as a source in the Amazon EventBridge User Guide .
pub struct PipeSourceSelfManagedKafkaParameters {
  /// The name of the topic that the pipe will read from.
  pub topic_name: Str? = None
  /// The position in a stream from which to start reading.
  pub starting_position: Str? = None
  /// An array of server URLs.
  pub additional_bootstrap_servers: List[Str]? = None
  /// The maximum number of records to include in each batch.
  pub batch_size: Int? = None
  /// The maximum length of a time to wait for events.
  pub maximum_batching_window_in_seconds: Int? = None
  /// The name of the destination queue to consume.
  pub consumer_group_id: Str? = None
  /// The credentials needed to access the resource.
  pub credentials: SelfManagedKafkaAccessConfigurationCredentials? = None
  /// The ARN of the Secrets Manager secret used for certification.
  pub server_root_ca_certificate: Str? = None
  /// This structure specifies the VPC subnets and security groups for the
  /// stream, and whether a public IP address is to be used.
  pub vpc: SelfManagedKafkaAccessConfigurationVpc? = None
}

/// The parameters for using a Amazon SQS stream as a source.
pub struct PipeSourceSqsQueueParameters {
  /// The maximum number of records to include in each batch.
  pub batch_size: Int? = None
  /// The maximum length of a time to wait for events.
  pub maximum_batching_window_in_seconds: Int? = None
}

/// The parameters for using an Batch job as a target.
pub struct PipeTargetBatchJobParameters {
  /// The job definition used by this job. This value can be one of name ,
  /// name:revision , or the Amazon Resource Name (ARN) for the job
  /// definition. If name is specified without a revision then the latest
  /// active revision is used.
  pub job_definition: Str? = None
  /// The name of the job. It can be up to 128 letters long. The first
  /// character must be alphanumeric, can contain uppercase and lowercase
  /// letters, numbers, hyphens (-), and underscores (_).
  pub job_name: Str? = None
  /// The array properties for the submitted job, such as the size of the
  /// array. The array size can be between 2 and 10,000. If you specify array
  /// properties for a job, it becomes an array job. This parameter is used
  /// only if the target is an Batch job.
  pub array_properties: BatchArrayProperties? = None
  /// The retry strategy to use for failed jobs. When a retry strategy is
  /// specified here, it overrides the retry strategy defined in the job
  /// definition.
  pub retry_strategy: BatchRetryStrategy? = None
  /// The overrides that are sent to a container.
  pub container_overrides: BatchContainerOverrides? = None
  /// A list of dependencies for the job. A job can depend upon a maximum of
  /// 20 jobs. You can specify a SEQUENTIAL type dependency without specifying
  /// a job ID for array jobs so that each child array job completes
  /// sequentially, starting at index 0. You can also specify an N_TO_N type
  /// dependency with a job ID for array jobs. In that case, each index child
  /// of this job must wait for the corresponding index child of each
  /// dependency to complete before it can begin.
  pub depends_on: List[BatchJobDependency]? = None
  /// Additional parameters passed to the job that replace parameter
  /// substitution placeholders that are set in the job definition. Parameters
  /// are specified as a key and value pair mapping. Parameters included here
  /// override any corresponding parameter defaults from the job definition.
  pub parameters: Map[Str, Str]? = None
}

/// The parameters for using an CloudWatch Logs log stream as a target.
pub struct PipeTargetCloudWatchLogsParameters {
  /// The name of the log stream.
  pub log_stream_name: Str? = None
  /// The time the event occurred, expressed as the number of milliseconds
  /// after Jan 1, 1970 00:00:00 UTC.
  pub timestamp: Str? = None
}

/// The parameters for using an Amazon ECS task as a target.
pub struct PipeTargetEcsTaskParameters {
  /// The ARN of the task definition to use if the event target is an Amazon
  /// ECS task.
  pub task_definition_arn: Str? = None
  /// The number of tasks to create based on TaskDefinition . The default is
  /// 1.
  pub task_count: Int? = None
  /// Specifies the launch type on which your task is running. The launch type
  /// that you specify here must match one of the launch type
  /// (compatibilities) of the target task. The FARGATE value is supported
  /// only in the Regions where Fargate with Amazon ECS is supported. For more
  /// information, see Fargate on Amazon ECS in the Amazon Elastic Container
  /// Service Developer Guide .
  pub launch_type: Str? = None
  /// Use this structure if the Amazon ECS task uses the awsvpc network mode.
  /// This structure specifies the VPC subnets and security groups associated
  /// with the task, and whether a public IP address is to be used. This
  /// structure is required if LaunchType is FARGATE because the awsvpc mode
  /// is required for Fargate tasks. If you specify NetworkConfiguration when
  /// the target ECS task does not use the awsvpc network mode, the task
  /// fails.
  pub network_configuration: NetworkConfiguration? = None
  /// Specifies the platform version for the task. Specify only the numeric
  /// portion of the platform version, such as 1.1.0 . This structure is used
  /// only if LaunchType is FARGATE . For more information about valid
  /// platform versions, see Fargate Platform Versions in the Amazon Elastic
  /// Container Service Developer Guide .
  pub platform_version: Str? = None
  /// Specifies an Amazon ECS task group for the task. The maximum length is
  /// 255 characters.
  pub group: Str? = None
  /// The capacity provider strategy to use for the task. If a
  /// capacityProviderStrategy is specified, the launchType parameter must be
  /// omitted. If no capacityProviderStrategy or launchType is specified, the
  /// defaultCapacityProviderStrategy for the cluster is used.
  pub capacity_provider_strategy: List[CapacityProviderStrategyItem]? = None
  /// Specifies whether to enable Amazon ECS managed tags for the task. For
  /// more information, see Tagging Your Amazon ECS Resources in the Amazon
  /// Elastic Container Service Developer Guide.
  pub enable_ecs_managed_tags: Bool? = None
  /// Whether or not to enable the execute command functionality for the
  /// containers in this task. If true, this enables execute command
  /// functionality on all containers in the task.
  pub enable_execute_command: Bool? = None
  /// An array of placement constraint objects to use for the task. You can
  /// specify up to 10 constraints per task (including constraints in the task
  /// definition and those specified at runtime).
  pub placement_constraints: List[PlacementConstraint]? = None
  /// The placement strategy objects to use for the task. You can specify a
  /// maximum of five strategy rules per task.
  pub placement_strategy: List[PlacementStrategy]? = None
  /// Specifies whether to propagate the tags from the task definition to the
  /// task. If no value is specified, the tags are not propagated. Tags can
  /// only be propagated to the task during task creation. To add tags to a
  /// task after task creation, use the TagResource API action.
  pub propagate_tags: Str? = None
  /// The reference ID to use for the task.
  pub reference_id: Str? = None
  /// The overrides that are associated with a task.
  pub overrides: EcsTaskOverride? = None
  /// The metadata that you apply to the task to help you categorize and
  /// organize them. Each tag consists of a key and an optional value, both of
  /// which you define. To learn more, see RunTask in the Amazon ECS API
  /// Reference.
  pub tags: List[Tag]? = None
}

/// The parameters for using an EventBridge event bus as a target.
pub struct PipeTargetEventBridgeEventBusParameters {
  /// The URL subdomain of the endpoint. For example, if the URL for Endpoint
  /// is https://abcde.veo.endpoints.event.amazonaws.com, then the EndpointId
  /// is abcde.veo .
  pub endpoint_id: Str? = None
  /// A free-form string, with a maximum of 128 characters, used to decide
  /// what fields to expect in the event detail.
  pub detail_type: Str? = None
  /// The source of the event.
  pub source: Str? = None
  /// Amazon Web Services resources, identified by Amazon Resource Name (ARN),
  /// which the event primarily concerns. Any number, including zero, may be
  /// present.
  pub resources: List[Str]? = None
  /// The time stamp of the event, per RFC3339 . If no time stamp is provided,
  /// the time stamp of the PutEvents call is used.
  pub time: Str? = None
}

/// These are custom parameter to be used when the target is an API Gateway
/// REST APIs or EventBridge ApiDestinations.
pub struct PipeTargetHttpParameters {
  /// The path parameter values to be used to populate API Gateway REST API or
  /// EventBridge ApiDestination path wildcards ("*").
  pub path_parameter_values: List[Str]? = None
  /// The headers that need to be sent as part of request invoking the API
  /// Gateway REST API or EventBridge ApiDestination.
  pub header_parameters: Map[Str, Str]? = None
  /// The query string keys/values that need to be sent as part of request
  /// invoking the API Gateway REST API or EventBridge ApiDestination.
  pub query_string_parameters: Map[Str, Str]? = None
}

/// The parameters for using a Kinesis stream as a target.
pub struct PipeTargetKinesisStreamParameters {
  /// Determines which shard in the stream the data record is assigned to.
  /// Partition keys are Unicode strings with a maximum length limit of 256
  /// characters for each key. Amazon Kinesis Data Streams uses the partition
  /// key as input to a hash function that maps the partition key and
  /// associated data to a specific shard. Specifically, an MD5 hash function
  /// is used to map partition keys to 128-bit integer values and to map
  /// associated data records to shards. As a result of this hashing
  /// mechanism, all data records with the same partition key map to the same
  /// shard within the stream.
  pub partition_key: Str? = None
}

/// The parameters for using a Lambda function as a target.
pub struct PipeTargetLambdaFunctionParameters {
  /// Specify whether to invoke the function synchronously or asynchronously.
  /// REQUEST_RESPONSE (default) - Invoke synchronously. This corresponds to
  /// the RequestResponse option in the InvocationType parameter for the
  /// Lambda Invoke API. FIRE_AND_FORGET - Invoke asynchronously. This
  /// corresponds to the Event option in the InvocationType parameter for the
  /// Lambda Invoke API. For more information, see Invocation types in the
  /// Amazon EventBridge User Guide .
  pub invocation_type: Str? = None
}

/// The parameters required to set up a target for your pipe. For more
/// information about pipe target parameters, including how to use dynamic
/// path parameters, see Target parameters in the Amazon EventBridge User
/// Guide .
pub struct PipeTargetParameters {
  /// Valid JSON text passed to the target. In this case, nothing from the
  /// event itself is passed to the target. For more information, see The
  /// JavaScript Object Notation (JSON) Data Interchange Format . To remove an
  /// input template, specify an empty string.
  pub input_template: Str? = None
  /// The parameters for using a Lambda function as a target.
  pub lambda_function_parameters: PipeTargetLambdaFunctionParameters? = None
  /// The parameters for using a Step Functions state machine as a target.
  pub step_function_state_machine_parameters: PipeTargetStateMachineParameters? = None
  /// The parameters for using a Kinesis stream as a target.
  pub kinesis_stream_parameters: PipeTargetKinesisStreamParameters? = None
  /// The parameters for using an Amazon ECS task as a target.
  pub ecs_task_parameters: PipeTargetEcsTaskParameters? = None
  /// The parameters for using an Batch job as a target.
  pub batch_job_parameters: PipeTargetBatchJobParameters? = None
  /// The parameters for using a Amazon SQS stream as a target.
  pub sqs_queue_parameters: PipeTargetSqsQueueParameters? = None
  /// These are custom parameter to be used when the target is an API Gateway
  /// REST APIs or EventBridge ApiDestinations.
  pub http_parameters: PipeTargetHttpParameters? = None
  /// These are custom parameters to be used when the target is a Amazon
  /// Redshift cluster to invoke the Amazon Redshift Data API
  /// BatchExecuteStatement.
  pub redshift_data_parameters: PipeTargetRedshiftDataParameters? = None
  /// The parameters for using a SageMaker pipeline as a target.
  pub sage_maker_pipeline_parameters: PipeTargetSageMakerPipelineParameters? = None
  /// The parameters for using an EventBridge event bus as a target.
  pub event_bridge_event_bus_parameters: PipeTargetEventBridgeEventBusParameters? = None
  /// The parameters for using an CloudWatch Logs log stream as a target.
  pub cloud_watch_logs_parameters: PipeTargetCloudWatchLogsParameters? = None
  /// The parameters for using a Timestream for LiveAnalytics table as a
