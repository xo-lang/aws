fn from_json_icon_image_input(v: json.Value) -> IconImageInput ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "blob" => Ok(IconImageInput.Blob(jsonv.read_blob(fv)?))
      "s3Uri" => Ok(IconImageInput.S3Uri(jsonv.read_str(fv)?))
      _ => Ok(IconImageInput.Unknown(k))
    }
  }
  Err("IconImageInput: no member set")
}

