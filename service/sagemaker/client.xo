fn json_of_action_summary(v: ActionSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.action_arn {
    fs.push(("ActionArn", json.Value.Str(x)))
  }
  if let Some(x) = v.action_name {
    fs.push(("ActionName", json.Value.Str(x)))
  }
  if let Some(x) = v.source {
    fs.push(("Source", json_of_action_source(x)))
  }
  if let Some(x) = v.action_type {
    fs.push(("ActionType", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.creation_time {
    fs.push(("CreationTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_modified_time {
    fs.push(("LastModifiedTime", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_action_summary(v: json.Value) -> ActionSummary ! Str {
  var out = ActionSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ActionArn" => out.action_arn = jsonv.read_str(fv)?
      "ActionName" => out.action_name = jsonv.read_str(fv)?
      "Source" => out.source = from_json_action_source(fv)?
      "ActionType" => out.action_type = jsonv.read_str(fv)?
      "Status" => out.status = ActionStatus.from(jsonv.read_str(fv)?)
      "CreationTime" => out.creation_time = jsonv.read_time(fv, "epoch-seconds")?
      "LastModifiedTime" => out.last_modified_time = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
}

