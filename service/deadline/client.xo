  }
  Ok(out)
}

fn json_of_membership_summary(v: MembershipSummary) -> json.Value {
  match v {
    Farm(x) => json.Value.Object([("farm", json_of_farm_member(x))])
    Queue(x) => json.Value.Object([("queue", json_of_queue_member(x))])
    Fleet(x) => json.Value.Object([("fleet", json_of_fleet_member(x))])
    Job(x) => json.Value.Object([("job", json_of_job_member(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_membership_summary(v: json.Value) -> MembershipSummary ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "farm" => Ok(MembershipSummary.Farm(from_json_farm_member(fv)?))
      "queue" => Ok(MembershipSummary.Queue(from_json_queue_member(fv)?))
      "fleet" => Ok(MembershipSummary.Fleet(from_json_fleet_member(fv)?))
      "job" => Ok(MembershipSummary.Job(from_json_job_member(fv)?))
      _ => Ok(MembershipSummary.Unknown(k))
    }
  }
  Err("MembershipSummary: no member set")
}

