  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_application_id = match input.application_id {
    Some(v) => v
    None => return Err("input member ApplicationId is required")
  }
  if label_application_id == "" {
    return Err("input member ApplicationId must not be empty")
  }
  let label_segment_id = match input.segment_id {
    Some(v) => v
    None => return Err("input member SegmentId is required")
  }
  if label_segment_id == "" {
    return Err("input member SegmentId must not be empty")
  }
  let label_version = match input.version {
    Some(v) => v
    None => return Err("input member Version is required")
  }
  if label_version == "" {
    return Err("input member Version must not be empty")
  }
  var body = b""
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "GET",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/v1/apps/${rest.escape(label_application_id, false)}/segments/${rest.escape(label_segment_id, false)}/versions/${rest.escape(label_version, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_get_segment_version(resp: http.Response) -> GetSegmentVersionResponse ! Str {
  var out = GetSegmentVersionResponse{}
  if !resp.body.is_empty() {
    let doc = jsonv.parse_body(resp.body)?
    out.segment_response = from_json_segment_response(doc)?
  }
  Ok(out)
}

/// The errors of GetSegmentVersion.
pub enum GetSegmentVersionErr {
  BadRequestException(e: BadRequestException)
  ForbiddenException(e: ForbiddenException)
  InternalServerErrorException(e: InternalServerErrorException)
  MethodNotAllowedException(e: MethodNotAllowedException)
  NotFoundException(e: NotFoundException)
  PayloadTooLargeException(e: PayloadTooLargeException)
  TooManyRequestsException(e: TooManyRequestsException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}