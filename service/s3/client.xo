      "DestinationIfMatch" => out.destination_if_match = c.text()
      "DestinationIfNoneMatch" => out.destination_if_none_match = c.text()
      "DestinationIfModifiedSince" => out.destination_if_modified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "DestinationIfUnmodifiedSince" => out.destination_if_unmodified_since = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SourceIfMatch" => out.source_if_match = c.text()
