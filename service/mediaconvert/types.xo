/// Required when you set Codec to the value FRAME_CAPTURE.
pub struct FrameCaptureSettings {
  /// Frame capture will encode the first frame of the output stream, then one
  /// frame every framerateDenominator/framerateNumerator seconds. For
  /// example, settings of framerateNumerator = 1 and framerateDenominator = 3
  /// (a rate of 1/3 frame per second) will capture the first frame, then 1
  /// frame every 3s. Files will be named as filename.n.jpg where n is the
  /// 0-based sequence number of each Capture.
  pub framerate_denominator: Int? = None
  /// Frame capture will encode the first frame of the output stream, then one
  /// frame every framerateDenominator/framerateNumerator seconds. For
  /// example, settings of framerateNumerator = 1 and framerateDenominator = 3
  /// (a rate of 1/3 frame per second) will capture the first frame, then 1
  /// frame every 3s. Files will be named as filename.NNNNNNN.jpg where N is
  /// the 0-based frame sequence number zero padded to 7 decimal places.
  pub framerate_numerator: Int? = None
  /// Maximum number of captures (encoded jpg output files).
  pub max_captures: Int? = None
  /// JPEG Quality - a higher value equals higher quality.
  pub quality: Int? = None
}

/// Choose how MediaConvert handles start and end times for input clipping
/// with video passthrough. Your input video codec must be H.264 or H.265 to
/// use IFRAME. To clip at the nearest IDR-frame: Choose Nearest IDR. If an
/// IDR-frame is not found at the frame that you specify, MediaConvert uses
/// the next compatible IDR-frame. Note that your output may be shorter than
/// your input clip duration. To clip at the nearest I-frame: Choose Nearest
/// I-frame. If an I-frame is not found at the frame that you specify,
/// MediaConvert uses the next compatible I-frame. Note that your output may
/// be shorter than your input clip duration. We only recommend this setting
/// for special workflows, and when you choose this setting your output may
/// not be compatible with most players.
pub enum FrameControl: Str {
  NearestIdrframe = "NEAREST_IDRFRAME"
  NearestIframe = "NEAREST_IFRAME"
  Unknown(value: Str)
}

