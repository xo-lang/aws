/// Describes a warm pool configuration.
pub struct WarmPoolConfiguration {
  /// The maximum number of instances that are allowed to be in the warm pool
  /// or in any state except Terminated for the Auto Scaling group.
  pub max_group_prepared_capacity: Int? = None
  /// The minimum number of instances to maintain in the warm pool.
  pub min_size: Int? = None
  /// The instance state to transition to after the lifecycle actions are
  /// complete.
  pub pool_state: WarmPoolState? = None
  /// The status of a warm pool that is marked for deletion.
  pub status: WarmPoolStatus? = None
  /// The instance reuse policy.
  pub instance_reuse_policy: InstanceReusePolicy? = None
}

pub enum WarmPoolState: Str {
  Stopped = "Stopped"
  Running = "Running"
  Hibernated = "Hibernated"
  Unknown(value: Str)
}

pub enum WarmPoolStatus: Str {
  PendingDelete = "PendingDelete"
  Unknown(value: Str)
}
