fn xml_read_image(e: xml.Element) -> Image ! Str {
  var out = Image{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "platformDetails" => out.platform_details = c.text()
      "usageOperation" => out.usage_operation = c.text()
      "blockDeviceMapping" => out.block_device_mappings = xml_read_block_device_mapping_list(c)?
      "description" => out.description = c.text()
      "enaSupport" => out.ena_support = xmlv.read_bool(c.text())?
      "hypervisor" => out.hypervisor = HypervisorType.from(c.text())
      "imageOwnerAlias" => out.image_owner_alias = c.text()
      "name" => out.name = c.text()
      "rootDeviceName" => out.root_device_name = c.text()
      "rootDeviceType" => out.root_device_type = DeviceType.from(c.text())
      "sriovNetSupport" => out.sriov_net_support = c.text()
      "stateReason" => out.state_reason = xml_read_state_reason(c)?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "virtualizationType" => out.virtualization_type = VirtualizationType.from(c.text())
      "bootMode" => out.boot_mode = BootModeValues.from(c.text())
      "tpmSupport" => out.tpm_support = TpmSupportValues.from(c.text())
      "deprecationTime" => out.deprecation_time = c.text()
      "imdsSupport" => out.imds_support = ImdsSupportValues.from(c.text())
      "sourceInstanceId" => out.source_instance_id = c.text()
      "deregistrationProtection" => out.deregistration_protection = c.text()
      "lastLaunchedTime" => out.last_launched_time = c.text()
      "imageAllowed" => out.image_allowed = xmlv.read_bool(c.text())?
      "sourceImageId" => out.source_image_id = c.text()
      "sourceImageRegion" => out.source_image_region = c.text()
      "freeTierEligible" => out.free_tier_eligible = xmlv.read_bool(c.text())?
      "publicSsmParameterName" => out.public_ssm_parameter_name = c.text()
      "imageWatermarkSet" => out.image_watermarks = xml_read_image_watermark_list(c)?
      "scanResults" => out.scan_results = xml_read_scan_results(c)?
      "instanceTypeSpecification" => out.instance_type_specification = xml_read_instance_type_specification(c)?
      "imageId" => out.image_id = c.text()
      "imageLocation" => out.image_location = c.text()
      "imageState" => out.state = ImageState.from(c.text())
      "imageOwnerId" => out.owner_id = c.text()
      "creationDate" => out.creation_date = c.text()
      "isPublic" => out.public = xmlv.read_bool(c.text())?
      "productCodes" => out.product_codes = xml_read_product_code_list(c)?
      "architecture" => out.architecture = ArchitectureValues.from(c.text())
      "imageType" => out.image_type = ImageTypeValues.from(c.text())
      "kernelId" => out.kernel_id = c.text()
      "ramdiskId" => out.ramdisk_id = c.text()
      "platform" => out.platform = PlatformValues.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

