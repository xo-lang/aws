      "IamRoles" => out.iam_roles = xml_read_iam_role_arn_list(c)?
      "MaintenanceTrackName" => out.maintenance_track_name = c.text()
      "SnapshotScheduleIdentifier" => out.snapshot_schedule_identifier = c.text()
      "AvailabilityZoneRelocation" => out.availability_zone_relocation = xmlv.read_bool(c.text())?
      "AquaConfigurationStatus" => out.aqua_configuration_status = AquaConfigurationStatus.from(c.text())
      "DefaultIamRoleArn" => out.default_iam_role_arn = c.text()
      "LoadSampleData" => out.load_sample_data = c.text()
