  }
  if let Some(x) = v.application_domain {
    xmlv.elem(w, "applicationDomain", x, [])
  }
  if let Some(x) = v.endpoint_type {
    xmlv.elem(w, "endpointType", x.value(), [])
  }
  if let Some(x) = v.attachment_type {
    xmlv.elem(w, "attachmentType", x.value(), [])
  }
  if let Some(x) = v.domain_certificate_arn {
    xmlv.elem(w, "domainCertificateArn", x, [])
  }
  if let Some(x) = v.endpoint_domain {
    xmlv.elem(w, "endpointDomain", x, [])
  }
  if let Some(x) = v.device_validation_domain {
    xmlv.elem(w, "deviceValidationDomain", x, [])
  }
  if let Some(x) = v.security_group_ids {
    xml_write_security_group_id_list(w, x, "securityGroupIdSet", [])
  }
  if let Some(x) = v.load_balancer_options {
    xml_write_verified_access_endpoint_load_balancer_options(w, x, "loadBalancerOptions", [])
  }
  if let Some(x) = v.network_interface_options {
    xml_write_verified_access_endpoint_eni_options(w, x, "networkInterfaceOptions", [])
  }
  if let Some(x) = v.status {
    xml_write_verified_access_endpoint_status(w, x, "status", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "description", x, [])
  }
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "creationTime", x, [])
  }
  if let Some(x) = v.last_updated_time {
    xmlv.elem(w, "lastUpdatedTime", x, [])
  }
  if let Some(x) = v.deletion_time {
    xmlv.elem(w, "deletionTime", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.sse_specification {
    xml_write_verified_access_sse_specification_response(w, x, "sseSpecification", [])
  }
  if let Some(x) = v.rds_options {
    xml_write_verified_access_endpoint_rds_options(w, x, "rdsOptions", [])
  }
  if let Some(x) = v.cidr_options {
    xml_write_verified_access_endpoint_cidr_options(w, x, "cidrOptions", [])
  }
  xmlv.end(w, name)
