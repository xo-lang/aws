/// The errors of PutObject.
pub enum PutObjectErr {
  EncryptionTypeMismatch(e: EncryptionTypeMismatch)
  InvalidRequest(e: InvalidRequest)
  InvalidWriteOffset(e: InvalidWriteOffset)
  TooManyParts(e: TooManyParts)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: PutObjectErr) display() -> Str {
  match e {
    EncryptionTypeMismatch(x) => "EncryptionTypeMismatch: ${x:?}"
    InvalidRequest(x) => "InvalidRequest: ${x:?}"
    InvalidWriteOffset(x) => "InvalidWriteOffset: ${x:?}"
    TooManyParts(x) => "TooManyParts: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_put_object_error(resp: http.Response) -> PutObjectErr {
  let body = restxml.error_element(resp.body) ?? xmlv.empty()
  match restxml.error_code(resp) {
    "EncryptionTypeMismatch" => match read_error_encryption_type_mismatch(resp, body) {
      Ok(x) => return PutObjectErr.EncryptionTypeMismatch(x)
      Err(msg) => return PutObjectErr.Deserialize(msg)
    }
    "InvalidRequest" => match read_error_invalid_request(resp, body) {
      Ok(x) => return PutObjectErr.InvalidRequest(x)
      Err(msg) => return PutObjectErr.Deserialize(msg)
    }
    "InvalidWriteOffset" => match read_error_invalid_write_offset(resp, body) {
      Ok(x) => return PutObjectErr.InvalidWriteOffset(x)
      Err(msg) => return PutObjectErr.Deserialize(msg)
    }
    "TooManyParts" => match read_error_too_many_parts(resp, body) {
      Ok(x) => return PutObjectErr.TooManyParts(x)
      Err(msg) => return PutObjectErr.Deserialize(msg)
    }
    _ => {}
  }

  PutObjectErr.Api(restxml.api_error(resp))
}

