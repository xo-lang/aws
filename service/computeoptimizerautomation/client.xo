/// Updates your account’s Compute Optimizer Automation enrollment
/// configuration.
pub fn (c: Client) update_enrollment_configuration(input: UpdateEnrollmentConfigurationRequest) -> UpdateEnrollmentConfigurationResponse ! UpdateEnrollmentConfigurationErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_enrollment_configuration(c.params, input)) ?? e => return Err(UpdateEnrollmentConfigurationErr.InvalidInput(e))
  var req = serialize_update_enrollment_configuration(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateEnrollmentConfigurationErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateEnrollmentConfigurationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_enrollment_configuration_error(resp))
  }
  deserialize_update_enrollment_configuration(resp) ?? e => Err(UpdateEnrollmentConfigurationErr.Deserialize(e))
}
