fn json_of_service_managed_input(v: ServiceManagedInput) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.host_address {
    fs.push(("hostAddress", json.Value.Str(x)))
  }
  if let Some(x) = v.vpc_id {
    fs.push(("vpcId", json.Value.Str(x)))
  }
  if let Some(x) = v.subnet_ids {
    fs.push(("subnetIds", json_of_list_of_subnet_ids(x)))
  }
  if let Some(x) = v.security_group_ids {
    fs.push(("securityGroupIds", json_of_list_of_security_group_ids(x)))
  }
  if let Some(x) = v.ip_address_type {
    fs.push(("ipAddressType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.ipv4_addresses_per_eni {
    fs.push(("ipv4AddressesPerEni", json.Value.Int(x)))
  }
  if let Some(x) = v.port_ranges {
    fs.push(("portRanges", json_of_port_ranges(x)))
  }
  if let Some(x) = v.certificate {
    fs.push(("certificate", json.Value.Str(x)))
  }
  if let Some(x) = v.dns_resolution {
    fs.push(("dnsResolution", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_service_managed_input(v: json.Value) -> ServiceManagedInput ! Str {
  var out = ServiceManagedInput{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "hostAddress" => out.host_address = jsonv.read_str(fv)?
      "vpcId" => out.vpc_id = jsonv.read_str(fv)?
      "subnetIds" => out.subnet_ids = from_json_list_of_subnet_ids(fv)?
      "securityGroupIds" => out.security_group_ids = from_json_list_of_security_group_ids(fv)?
      "ipAddressType" => out.ip_address_type = IpAddressType.from(jsonv.read_str(fv)?)
      "ipv4AddressesPerEni" => out.ipv4_addresses_per_eni = jsonv.read_int(fv)?
      "portRanges" => out.port_ranges = from_json_port_ranges(fv)?
      "certificate" => out.certificate = jsonv.read_str(fv)?
      "dnsResolution" => out.dns_resolution = ResourceConfigDnsResolution.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_service_now_authentication_scope_list(v: List[Str]) -> json.Value {
  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

fn from_json_service_now_authentication_scope_list(v: json.Value) -> List[Str] ! Str {
  var out: List[Str] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(jsonv.read_str(fv)?)
  }
  Ok(out)
}

