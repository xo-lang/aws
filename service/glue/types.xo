  /// The name of the table in the data target.
  pub connection_table: Str? = None
  /// The name of a connector that will be used.
  pub connector_name: Str? = None
  /// The type of connection, such as marketplace.jdbc or custom.jdbc,
  /// designating a connection to a JDBC data target.
  pub connection_type: Str? = None
  /// Additional connection options for the connector.
  pub additional_options: Map[Str, Str]? = None
  /// Specifies the data schema for the JDBC target.
  pub output_schemas: List[GlueSchema]? = None
}

