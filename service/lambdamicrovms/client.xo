fn json_of_logging(v: Logging) -> json.Value {
  match v {
    Disabled(x) => json.Value.Object([("disabled", json_of_logging_disabled(x))])
    CloudWatch(x) => json.Value.Object([("cloudWatch", json_of_cloud_watch_logging(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_logging(v: json.Value) -> Logging ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "disabled" => Ok(Logging.Disabled(from_json_logging_disabled(fv)?))
      "cloudWatch" => Ok(Logging.CloudWatch(from_json_cloud_watch_logging(fv)?))
      _ => Ok(Logging.Unknown(k))
    }
  }
  Err("Logging: no member set")
}

