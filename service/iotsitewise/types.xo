/// Identifies a property value used in an expression.
pub struct VariableValue {
  /// The ID of the property to use as the variable. You can use the property
  /// name if it's from the same asset model. If the property has an external
  /// ID, you can specify externalId: followed by the external ID. For more
  /// information, see Using external IDs in the IoT SiteWise User Guide .
  pub property_id: Str? = None
  /// The ID of the hierarchy to query for the property ID. You can use the
  /// hierarchy's name instead of the hierarchy's ID. If the hierarchy has an
  /// external ID, you can specify externalId: followed by the external ID.
  /// For more information, see Using external IDs in the IoT SiteWise User
  /// Guide . You use a hierarchy ID instead of a model ID because you can
  /// have several hierarchies using the same model and therefore the same
  /// propertyId . For example, you might have separately grouped assets that
  /// come from the same asset model. For more information, see Asset
  /// hierarchies in the IoT SiteWise User Guide .
  pub hierarchy_id: Str? = None
  /// The path of the property.
  pub property_path: List[AssetModelPropertyPathSegment]? = None
}

/// Contains an asset property value (of a single type only).
pub struct Variant {
  /// Asset property data of type string (sequence of characters). The allowed
  /// pattern: "^$|[^\u0000-\u001F\u007F]+". The max length is 1024.
  pub string_value: Str? = None
  /// Asset property data of type integer (whole number).
  pub integer_value: Int? = None
  /// Asset property data of type double (floating point number). The min
  /// value is -10^10. The max value is 10^10. Double.NaN is allowed.
  pub double_value: Float? = None
  /// Asset property data of type Boolean (true or false).
  pub boolean_value: Bool? = None
  /// The type of null asset property data with BAD and UNCERTAIN qualities.
  pub null_value: PropertyValueNullValue? = None
}

/// The allowed video data types.
pub enum VideoDataType: Str {
  Mp4 = "VIDEO-MP4"
  Unknown(value: Str)
}

/// Set this period to specify how long your data is stored in the warm tier
/// before it is deleted. You can set this only if cold tier is enabled.
pub struct WarmTierRetentionPeriod {
  /// The number of days the data is stored in the warm tier.
  pub number_of_days: Int? = None
  /// If set to true, the data is stored indefinitely in the warm tier.
  pub unlimited: Bool? = None
}

pub enum WarmTierState: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// Contains the encryption configuration for a workspace.
pub struct WorkspaceEncryptionConfiguration {
  /// The encryption scheme for the workspace. SITEWISE_DEFAULT_ENCRYPTION
  /// encrypts data with the IoT SiteWise default key. KMS_BASED_ENCRYPTION
  /// encrypts data with the customer managed KMS key identified by kmsKeyId .
  pub encryption_type: EncryptionType? = None
  /// The customer managed KMS key used when encryptionType is
  /// KMS_BASED_ENCRYPTION . Accepts a key ID, key ARN, or key alias. Required
  /// for KMS_BASED_ENCRYPTION ; must be omitted for
  /// SITEWISE_DEFAULT_ENCRYPTION . After a workspace's customer managed key
  /// configuration becomes active, the key can't be changed.
  pub kms_key_id: Str? = None
}

/// Contains the encryption configuration information for a workspace.
pub struct WorkspaceEncryptionConfigurationInfo {
  /// The type of encryption used for the workspace.
  pub encryption_type: EncryptionType? = None
  /// The key ARN of the KMS key used for KMS encryption if encryptionType is
  /// KMS_BASED_ENCRYPTION .
  pub kms_key_arn: Str? = None
}

/// Contains the details of an error associated with a workspace.
pub struct WorkspaceErrorDetails {
  /// The error code.
  pub code: ErrorCode? = None
  /// The error message.
  pub message: Str? = None
}

/// The current state of a workspace. The state changes as the workspace is
/// created, updated, or deleted.
pub enum WorkspaceState: Str {
  Creating = "CREATING"
  Active = "ACTIVE"
  Updating = "UPDATING"
  Deleting = "DELETING"
  Failed = "FAILED"
  Unknown(value: Str)
}

/// Contains information about the current status of a workspace.
pub struct WorkspaceStatus {
  /// The current state of the workspace.
  pub state: WorkspaceState? = None
  /// Contains associated error information, if any.
  pub error: WorkspaceErrorDetails? = None
}

/// Contains summary information about a workspace, including its name, ARN,
/// status, and creation and update timestamps.
pub struct WorkspaceSummary {
  /// The name of the workspace.
  pub name: Str? = None
  /// The ARN of the workspace.
  pub arn: Str? = None
  /// The status of the workspace.
  pub status: WorkspaceStatus? = None
  /// The date the workspace was created, in Unix epoch time.
  pub created_at: Time? = None
  /// The date the workspace was last updated, in Unix epoch time.
  pub updated_at: Time? = None
}
