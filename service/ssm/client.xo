fn json_of_inventory_aggregator(v: InventoryAggregator) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.expression {
    fs.push(("Expression", json.Value.Str(x)))
  }
  if let Some(x) = v.aggregators {
    fs.push(("Aggregators", json_of_inventory_aggregator_list(x)))
  }
  if let Some(x) = v.groups {
    fs.push(("Groups", json_of_inventory_group_list(x)))
  }
  json.Value.Object(fs)
}

fn from_json_inventory_aggregator(v: json.Value) -> InventoryAggregator ! Str {
  var out = InventoryAggregator{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Expression" => out.expression = jsonv.read_str(fv)?
      "Aggregators" => out.aggregators = from_json_inventory_aggregator_list(fv)?
      "Groups" => out.groups = from_json_inventory_group_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_inventory_aggregator_list(v: List[InventoryAggregator]) -> json.Value {
  json.Value.List(v.map(fn(x: InventoryAggregator) -> json.Value { json_of_inventory_aggregator(x) }))
}

fn from_json_inventory_aggregator_list(v: json.Value) -> List[InventoryAggregator] ! Str {
  var out: List[InventoryAggregator] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_inventory_aggregator(fv)?)
  }
  Ok(out)
}

