  }
}

fn from_json_identity_provider_configuration(v: json.Value) -> IdentityProviderConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "samlConfiguration" => Ok(IdentityProviderConfiguration.SamlConfiguration(from_json_saml_provider_configuration(fv)?))
      "openIDConnectConfiguration" => Ok(IdentityProviderConfiguration.OpenIdConnectConfiguration(from_json_open_id_connect_provider_configuration(fv)?))
      _ => Ok(IdentityProviderConfiguration.Unknown(k))
    }
  }
  Err("IdentityProviderConfiguration: no member set")
}

