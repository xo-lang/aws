fn xml_write_target_capacity_specification(var w: xmlv.Writer, v: TargetCapacitySpecification, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.total_target_capacity {
    xmlv.elem(w, "totalTargetCapacity", "${x}", [])
  }
  if let Some(x) = v.on_demand_target_capacity {
    xmlv.elem(w, "onDemandTargetCapacity", "${x}", [])
  }
  if let Some(x) = v.spot_target_capacity {
    xmlv.elem(w, "spotTargetCapacity", "${x}", [])
  }
  if let Some(x) = v.default_target_capacity_type {
    xmlv.elem(w, "defaultTargetCapacityType", x.value(), [])
  }
  if let Some(x) = v.target_capacity_unit_type {
    xmlv.elem(w, "targetCapacityUnitType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_target_capacity_specification(e: xml.Element) -> TargetCapacitySpecification ! Str {
  var out = TargetCapacitySpecification{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "totalTargetCapacity" => out.total_target_capacity = xmlv.read_int(c.text())?
      "onDemandTargetCapacity" => out.on_demand_target_capacity = xmlv.read_int(c.text())?
      "spotTargetCapacity" => out.spot_target_capacity = xmlv.read_int(c.text())?
      "defaultTargetCapacityType" => out.default_target_capacity_type = DefaultTargetCapacityType.from(c.text())
      "targetCapacityUnitType" => out.target_capacity_unit_type = TargetCapacityUnitType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_target_capacity_specification_request(var w: xmlv.Writer, v: TargetCapacitySpecificationRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.total_target_capacity {
    xmlv.elem(w, "TotalTargetCapacity", "${x}", [])
