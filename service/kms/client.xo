fn json_of_key_metadata(v: KeyMetadata) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.aws_account_id {
    fs.push(("AWSAccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.key_id {
    fs.push(("KeyId", json.Value.Str(x)))
  }
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.creation_date {
    fs.push(("CreationDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.enabled {
    fs.push(("Enabled", json.Value.Bool(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.key_usage {
    fs.push(("KeyUsage", json.Value.Str(x.value())))
  }
  if let Some(x) = v.key_state {
    fs.push(("KeyState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.deletion_date {
    fs.push(("DeletionDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.valid_to {
    fs.push(("ValidTo", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.origin {
    fs.push(("Origin", json.Value.Str(x.value())))
  }
  if let Some(x) = v.custom_key_store_id {
    fs.push(("CustomKeyStoreId", json.Value.Str(x)))
  }
  if let Some(x) = v.cloud_hsm_cluster_id {
    fs.push(("CloudHsmClusterId", json.Value.Str(x)))
  }
  if let Some(x) = v.expiration_model {
    fs.push(("ExpirationModel", json.Value.Str(x.value())))
  }
  if let Some(x) = v.key_manager {
    fs.push(("KeyManager", json.Value.Str(x.value())))
  }
  if let Some(x) = v.customer_master_key_spec {
    fs.push(("CustomerMasterKeySpec", json.Value.Str(x.value())))
  }
  if let Some(x) = v.key_spec {
    fs.push(("KeySpec", json.Value.Str(x.value())))
  }
  if let Some(x) = v.encryption_algorithms {
    fs.push(("EncryptionAlgorithms", json_of_encryption_algorithm_spec_list(x)))
  }
  if let Some(x) = v.signing_algorithms {
    fs.push(("SigningAlgorithms", json_of_signing_algorithm_spec_list(x)))
  }
  if let Some(x) = v.key_agreement_algorithms {
    fs.push(("KeyAgreementAlgorithms", json_of_key_agreement_algorithm_spec_list(x)))
  }
  if let Some(x) = v.encapsulation_algorithms {
    fs.push(("EncapsulationAlgorithms", json_of_encapsulation_algorithm_spec_list(x)))
  }
  if let Some(x) = v.multi_region {
    fs.push(("MultiRegion", json.Value.Bool(x)))
  }
  if let Some(x) = v.multi_region_configuration {
    fs.push(("MultiRegionConfiguration", json_of_multi_region_configuration(x)))
  }
  if let Some(x) = v.pending_deletion_window_in_days {
    fs.push(("PendingDeletionWindowInDays", json.Value.Int(x)))
  }
  if let Some(x) = v.mac_algorithms {
    fs.push(("MacAlgorithms", json_of_mac_algorithm_spec_list(x)))
  }
  if let Some(x) = v.xks_key_configuration {
    fs.push(("XksKeyConfiguration", json_of_xks_key_configuration_type(x)))
  }
  if let Some(x) = v.current_key_material_id {
    fs.push(("CurrentKeyMaterialId", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_key_metadata(v: json.Value) -> KeyMetadata ! Str {
  var out = KeyMetadata{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "AWSAccountId" => out.aws_account_id = jsonv.read_str(fv)?
      "KeyId" => out.key_id = jsonv.read_str(fv)?
      "Arn" => out.arn = jsonv.read_str(fv)?
      "CreationDate" => out.creation_date = jsonv.read_time(fv, "epoch-seconds")?
      "Enabled" => out.enabled = jsonv.read_bool(fv)?
      "Description" => out.description = jsonv.read_str(fv)?
      "KeyUsage" => out.key_usage = KeyUsageType.from(jsonv.read_str(fv)?)
      "KeyState" => out.key_state = KeyState.from(jsonv.read_str(fv)?)
      "DeletionDate" => out.deletion_date = jsonv.read_time(fv, "epoch-seconds")?
      "ValidTo" => out.valid_to = jsonv.read_time(fv, "epoch-seconds")?
      "Origin" => out.origin = OriginType.from(jsonv.read_str(fv)?)
      "CustomKeyStoreId" => out.custom_key_store_id = jsonv.read_str(fv)?
      "CloudHsmClusterId" => out.cloud_hsm_cluster_id = jsonv.read_str(fv)?
      "ExpirationModel" => out.expiration_model = ExpirationModelType.from(jsonv.read_str(fv)?)
      "KeyManager" => out.key_manager = KeyManagerType.from(jsonv.read_str(fv)?)
      "CustomerMasterKeySpec" => out.customer_master_key_spec = CustomerMasterKeySpec.from(jsonv.read_str(fv)?)
      "KeySpec" => out.key_spec = KeySpec.from(jsonv.read_str(fv)?)
      "EncryptionAlgorithms" => out.encryption_algorithms = from_json_encryption_algorithm_spec_list(fv)?
      "SigningAlgorithms" => out.signing_algorithms = from_json_signing_algorithm_spec_list(fv)?
      "KeyAgreementAlgorithms" => out.key_agreement_algorithms = from_json_key_agreement_algorithm_spec_list(fv)?
      "EncapsulationAlgorithms" => out.encapsulation_algorithms = from_json_encapsulation_algorithm_spec_list(fv)?
      "MultiRegion" => out.multi_region = jsonv.read_bool(fv)?
      "MultiRegionConfiguration" => out.multi_region_configuration = from_json_multi_region_configuration(fv)?
      "PendingDeletionWindowInDays" => out.pending_deletion_window_in_days = jsonv.read_int(fv)?
      "MacAlgorithms" => out.mac_algorithms = from_json_mac_algorithm_spec_list(fv)?
      "XksKeyConfiguration" => out.xks_key_configuration = from_json_xks_key_configuration_type(fv)?
      "CurrentKeyMaterialId" => out.current_key_material_id = jsonv.read_str(fv)?
      _ => {}
    }
