fn xml_write_upgrade_target(var w: xmlv.Writer, v: UpgradeTarget, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.engine_version {
    xmlv.elem(w, "EngineVersion", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.auto_upgrade {
    xmlv.elem(w, "AutoUpgrade", "${x}", [])
  }
  if let Some(x) = v.is_major_version_upgrade {
    xmlv.elem(w, "IsMajorVersionUpgrade", "${x}", [])
  }
  if let Some(x) = v.supported_engine_modes {
    xml_write_engine_mode_list(w, x, "SupportedEngineModes", [])
  }
  if let Some(x) = v.supports_parallel_query {
    xmlv.elem(w, "SupportsParallelQuery", "${x}", [])
  }
  if let Some(x) = v.supports_global_databases {
    xmlv.elem(w, "SupportsGlobalDatabases", "${x}", [])
  }
  if let Some(x) = v.supports_babelfish {
    xmlv.elem(w, "SupportsBabelfish", "${x}", [])
  }
  if let Some(x) = v.supports_limitless_database {
    xmlv.elem(w, "SupportsLimitlessDatabase", "${x}", [])
  }
  if let Some(x) = v.supports_local_write_forwarding {
    xmlv.elem(w, "SupportsLocalWriteForwarding", "${x}", [])
  }
  if let Some(x) = v.supports_integrations {
    xmlv.elem(w, "SupportsIntegrations", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_upgrade_target(e: xml.Element) -> UpgradeTarget ! Str {
  var out = UpgradeTarget{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Engine" => out.engine = c.text()
      "EngineVersion" => out.engine_version = c.text()
      "Description" => out.description = c.text()
      "AutoUpgrade" => out.auto_upgrade = xmlv.read_bool(c.text())?
      "IsMajorVersionUpgrade" => out.is_major_version_upgrade = xmlv.read_bool(c.text())?
      "SupportedEngineModes" => out.supported_engine_modes = xml_read_engine_mode_list(c)?
      "SupportsParallelQuery" => out.supports_parallel_query = xmlv.read_bool(c.text())?
      "SupportsGlobalDatabases" => out.supports_global_databases = xmlv.read_bool(c.text())?
      "SupportsBabelfish" => out.supports_babelfish = xmlv.read_bool(c.text())?
      "SupportsLimitlessDatabase" => out.supports_limitless_database = xmlv.read_bool(c.text())?
      "SupportsLocalWriteForwarding" => out.supports_local_write_forwarding = xmlv.read_bool(c.text())?
      "SupportsIntegrations" => out.supports_integrations = xmlv.read_bool(c.text())?
      _ => {}
