/// Represents a collection of cache nodes in a replication group. One node
/// in the node group is the read/write primary node. All the other nodes
/// are read-only Replica nodes.
pub struct NodeGroup {
  /// The identifier for the node group (shard). A Valkey or Redis OSS
  /// (cluster mode disabled) replication group contains only 1 node group;
  /// therefore, the node group ID is 0001. A Valkey or Redis OSS (cluster
  /// mode enabled) replication group contains 1 to 90 node groups numbered
  /// 0001 to 0090. Optionally, the user can provide the id for a node group.
  pub node_group_id: Str? = None
  /// The current state of this replication group - creating , available ,
  /// modifying , deleting .
  pub status: Str? = None
  /// The endpoint of the primary node in this node group (shard).
  pub primary_endpoint: Endpoint? = None
  /// The endpoint of the replica nodes in this node group (shard). This value
  /// is read-only.
  pub reader_endpoint: Endpoint? = None
  /// The keyspace for this node group (shard).
  pub slots: Str? = None
  /// A list containing information about individual nodes within the node
  /// group (shard).
  pub node_group_members: List[NodeGroupMember]? = None
}

/// Node group (shard) configuration options. Each node group (shard)
/// configuration has the following: Slots , PrimaryAvailabilityZone ,
/// ReplicaAvailabilityZones , ReplicaCount .
