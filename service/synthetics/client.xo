/// The errors of AssociateResource.
pub enum AssociateResourceErr {
  ConflictException(e: ConflictException)
  InternalServerException(e: InternalServerException)
  ResourceNotFoundException(e: ResourceNotFoundException)
  ServiceQuotaExceededException(e: ServiceQuotaExceededException)
  ValidationException(e: ValidationException)
