fn json_of_assistant_message_block(v: AssistantMessageBlock) -> json.Value {
  match v {
    Text(x) => json.Value.Object([("text", json.Value.Str(x))])
    ToolUse(x) => json.Value.Object([("toolUse", x)])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_assistant_message_block(v: json.Value) -> AssistantMessageBlock ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "text" => Ok(AssistantMessageBlock.Text(jsonv.read_str(fv)?))
      "toolUse" => Ok(AssistantMessageBlock.ToolUse(fv))
      _ => Ok(AssistantMessageBlock.Unknown(k))
    }
  }
  Err("AssistantMessageBlock: no member set")
}

