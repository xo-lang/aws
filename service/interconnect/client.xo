  }
  if let Some(x) = input.bandwidth {
    fs.push(("bandwidth", json.Value.Str(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("clientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("clientToken", json.Value.Str(idempotency_token)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.0"))
  headers.push(("X-Amz-Target", "Interconnect.UpdateConnection"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_update_connection(resp: http.Response) -> UpdateConnectionResponse ! Str {
  var out = UpdateConnectionResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "connection" => out.connection = from_json_connection(fv)?
      _ => {}
    }
  }
  Ok(out)
}

/// The errors of UpdateConnection.
pub enum UpdateConnectionErr {
  AccessDeniedException(e: AccessDeniedException)
  InterconnectClientException(e: InterconnectClientException)
  InterconnectServerException(e: InterconnectServerException)
  InterconnectValidationException(e: InterconnectValidationException)
  ResourceNotFoundException(e: ResourceNotFoundException)
  ServiceQuotaExceededException(e: ServiceQuotaExceededException)
  ThrottlingException(e: ThrottlingException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UpdateConnectionErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    InterconnectClientException(x) => "InterconnectClientException: ${x:?}"
    InterconnectServerException(x) => "InterconnectServerException: ${x:?}"
    InterconnectValidationException(x) => "InterconnectValidationException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ServiceQuotaExceededException(x) => "ServiceQuotaExceededException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_connection_error(resp: http.Response) -> UpdateConnectionErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return UpdateConnectionErr.AccessDeniedException(x)
      Err(msg) => return UpdateConnectionErr.Deserialize(msg)
    }
    "InterconnectClientException" => match read_error_interconnect_client_exception(resp, body) {
      Ok(x) => return UpdateConnectionErr.InterconnectClientException(x)
      Err(msg) => return UpdateConnectionErr.Deserialize(msg)
    }
    "InterconnectServerException" => match read_error_interconnect_server_exception(resp, body) {
      Ok(x) => return UpdateConnectionErr.InterconnectServerException(x)
      Err(msg) => return UpdateConnectionErr.Deserialize(msg)
    }
    "InterconnectValidationException" => match read_error_interconnect_validation_exception(resp, body) {
      Ok(x) => return UpdateConnectionErr.InterconnectValidationException(x)
      Err(msg) => return UpdateConnectionErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateConnectionErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateConnectionErr.Deserialize(msg)
    }
    "ServiceQuotaExceededException" => match read_error_service_quota_exceeded_exception(resp, body) {
      Ok(x) => return UpdateConnectionErr.ServiceQuotaExceededException(x)
      Err(msg) => return UpdateConnectionErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateConnectionErr.ThrottlingException(x)
      Err(msg) => return UpdateConnectionErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateConnectionErr.Api(restjson.api_error(resp, body))
}

/// Modifies an existing connection. Currently we support modifications to
/// the connection's description and/or bandwidth.
pub fn (c: Client) update_connection(input: UpdateConnectionRequest) -> UpdateConnectionResponse ! UpdateConnectionErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_connection(c.params, input)) ?? e => return Err(UpdateConnectionErr.InvalidInput(e))
  var req = serialize_update_connection(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateConnectionErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateConnectionErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_connection_error(resp))
  }
  deserialize_update_connection(resp) ?? e => Err(UpdateConnectionErr.Deserialize(e))
}
