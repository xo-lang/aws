test "Ec2ProtocolIdempotencyTokenAutoFill" {
  let ep = rest.parse_endpoint("https://example.com") ?? rest.Endpoint{host: "example.com"}
  let req = serialize_query_idempotency_token_auto_fill(ep, QueryIdempotencyTokenAutoFillInput{}, TOKEN, 0)?
  protocoltest.check_request(req, protocoltest.RequestWant{method: "POST", uri: "/", require_headers: ["Content-Length"], headers: [("Content-Type", "application/x-www-form-urlencoded")], body: "Action=QueryIdempotencyTokenAutoFill&Version=2020-01-08&Token=00000000-0000-4000-8000-000000000000", body_media_type: "application/x-www-form-urlencoded"})?
}

test "Ec2ProtocolIdempotencyTokenAutoFillIsSet" {
