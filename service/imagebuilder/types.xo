  /// The tags of the image recipe.
  pub tags: Map[Str, Str]? = None
  /// The working directory used during build and test workflows. If you don't
  /// specify a working directory, Image Builder uses /tmp for Linux and macOS
  /// build instances, and C:/ for Windows build instances.
  pub working_directory: Str? = None
  /// Before you create a new AMI, Image Builder launches temporary Amazon EC2
  /// instances to build and test your image configuration. Instance
  /// configuration adds a layer of control over those instances. You can
