fn json_of_template_definition(v: TemplateDefinition) -> json.Value {
  match v {
    TemplateV2(x) => json.Value.Object([("TemplateV2", json_of_template_v2(x))])
    TemplateV3(x) => json.Value.Object([("TemplateV3", json_of_template_v3(x))])
    TemplateV4(x) => json.Value.Object([("TemplateV4", json_of_template_v4(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_template_definition(v: json.Value) -> TemplateDefinition ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "TemplateV2" => Ok(TemplateDefinition.TemplateV2(from_json_template_v2(fv)?))
      "TemplateV3" => Ok(TemplateDefinition.TemplateV3(from_json_template_v3(fv)?))
      "TemplateV4" => Ok(TemplateDefinition.TemplateV4(from_json_template_v4(fv)?))
      _ => Ok(TemplateDefinition.Unknown(k))
    }
  }
  Err("TemplateDefinition: no member set")
}

fn json_of_template_list(v: List[TemplateSummary]) -> json.Value {
  json.Value.List(v.map(fn(x: TemplateSummary) -> json.Value { json_of_template_summary(x) }))
