pub enum TaskDefinitionFamilyStatus: Str {
  Active = "ACTIVE"
  Inactive = "INACTIVE"
  All = "ALL"
  Unknown(value: Str)
}

pub enum TaskDefinitionField: Str {
  Tags = "TAGS"
  Unknown(value: Str)
}

/// The constraint on task placement in the task definition. For more
/// information, see Task placement constraints in the Amazon Elastic
/// Container Service Developer Guide . Task placement constraints aren't
/// supported for tasks run on Fargate.
