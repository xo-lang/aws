fn xml_write_get_object_output(var w: xmlv.Writer, v: GetObjectOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.body {
    xmlv.elem(w, "Body", x.to_base64(), [])
