    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    ConflictException(x) => "ConflictException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_service_settings_error(resp: http.Response) -> UpdateServiceSettingsErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return UpdateServiceSettingsErr.AccessDeniedException(x)
      Err(msg) => return UpdateServiceSettingsErr.Deserialize(msg)
    }
    "ConflictException" => match read_error_conflict_exception(resp, body) {
      Ok(x) => return UpdateServiceSettingsErr.ConflictException(x)
      Err(msg) => return UpdateServiceSettingsErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return UpdateServiceSettingsErr.InternalServerException(x)
      Err(msg) => return UpdateServiceSettingsErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UpdateServiceSettingsErr.ThrottlingException(x)
      Err(msg) => return UpdateServiceSettingsErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateServiceSettingsErr.ValidationException(x)
      Err(msg) => return UpdateServiceSettingsErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateServiceSettingsErr.Api(restjson.api_error(resp, body))
}

/// Updates settings configured for Quick Setup.
pub fn (c: Client) update_service_settings(input: UpdateServiceSettingsInput) -> () ! UpdateServiceSettingsErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_service_settings(c.params, input)) ?? e => return Err(UpdateServiceSettingsErr.InvalidInput(e))
  var req = serialize_update_service_settings(ep, input, "") ?? e => return Err(UpdateServiceSettingsErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateServiceSettingsErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_service_settings_error(resp))
  }
  deserialize_update_service_settings(resp) ?? e => Err(UpdateServiceSettingsErr.Deserialize(e))
}
