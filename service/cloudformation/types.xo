  /// status of NOT_CHECKED . For more information, see Resource type support
  /// for imports and drift detection . IN_SYNC : The resource's actual
  /// configuration matches its expected configuration.
  pub stack_resource_drift_status: StackResourceDriftStatus? = None
  /// When CloudFormation last checked if the resource had drifted from its
  /// expected configuration.
  pub last_check_timestamp: Time? = None
}

/// Summarizes information about whether the resource's actual configuration
