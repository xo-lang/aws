  /// Example markup shown where the field is empty in a preview of the asset,
  /// restricted to AllowedTags. Never the asset's value: it is not set on the
  /// asset at create, does not fill a required field, and is never published.
  pub placeholder: Str? = None
}

/// The verdict of a file's malware and content-quality scan. A process with
/// an outcome, not a resource with a lifecycle — hence `Status`. A file
/// is accepted and scanned afterwards, so `PENDING` is a real, observable
/// state rather than an internal one, and it is a refusal at launch rather
/// than something a launch waits on.
pub enum ScanStatus: Str {
  Pending = "PENDING"
  Clean = "CLEAN"
  Rejected = "REJECTED"
  Unknown(value: Str)
}

/// Input for SearchCampaignTemplates.
pub struct SearchCampaignTemplatesRequest {
  /// The catalog (AWS or Sandbox). AWS and Sandbox templates may differ.
  pub catalog: Catalog? = None
  /// Free-text query matched against the template's name and description. Any
  /// word may match, and the last word matches as a prefix when it has 3 or
  /// more characters, so `nov` finds Amazon Nova. A template whose name holds
  /// the query as a phrase ranks first, then whole-word matches, then
  /// prefix-only ones. Omit to browse the whole catalog. Text analysis is
  /// derived from each template's own LanguageCode, never from the language
  /// filter.
  pub search_text: Str? = None
  /// Restrict to templates in these industries. Values within this member are
  /// OR-ed; distinct facet members are AND-ed. Exact, case-sensitive match.
  pub industry: List[Industry]? = None
  /// Restrict to templates with these campaign use cases. Values within this
  /// member are OR-ed; distinct facet members are AND-ed. Exact,
  /// case-sensitive match.
  pub use_case: List[Str]? = None
  /// Restrict to templates in these language(s), matched by each template's
  /// `LanguageCode`. Values within this member are OR-ed; distinct facet
  /// members are AND-ed. Narrows results; it does not reinterpret SearchText.
  pub language: List[AssetLanguage]? = None
  /// Restrict to templates promoting these AWS services. Values within this
  /// member are OR-ed; distinct facet members are AND-ed. Exact,
  /// case-sensitive match.
  pub aws_services: List[Str]? = None
  /// Restrict to templates for these customer segments. Values within this
  /// member are OR-ed; distinct facet members are AND-ed. A template that
  /// names no customer segment matches every value.
  pub customer_segments: List[CustomerSegment]? = None
  /// Restrict to templates with these themes. Values within this member are
  /// OR-ed; distinct facet members are AND-ed. A template that names no theme
  /// matches every value.
  pub themes: List[Theme]? = None
  /// Restrict to templates in these collections. Values within this member
  /// are OR-ed; distinct facet members are AND-ed. Omit for no restriction;
  /// there is no default.
  pub collection: List[CampaignTemplateCollection]? = None
  /// Maximum results per page.
  pub max_results: Int? = None
  /// Pagination token.
  pub next_token: Str? = None
}

