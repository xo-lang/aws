  var req = serialize_create_cluster(ep, input, "") ?? e => return Err(CreateClusterErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(CreateClusterErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_create_cluster_error(resp))
  }
  deserialize_create_cluster(resp) ?? e => Err(CreateClusterErr.Deserialize(e))
}

