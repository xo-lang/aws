  if let Some(x) = input.progress_update_stream {
    fs.push(("ProgressUpdateStream", json.Value.Str(x)))
  }
  if let Some(x) = input.migration_task_name {
    fs.push(("MigrationTaskName", json.Value.Str(x)))
  }
