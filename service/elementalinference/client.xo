fn json_of_update_output(v: UpdateOutput) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.output_config {
    fs.push(("outputConfig", json_of_output_config(x)))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
