  /// both your delivery stream and the Amazon OpenSearch Service domain, make
  /// sure the security group inbound rule allows HTTPS traffic. For more
  /// information about security group rules, see Security group rules in the
  /// Amazon VPC documentation.
  pub security_group_ids: List[Str]? = None
}

/// The details of the VPC of the Amazon OpenSearch Service destination.
pub struct VpcConfigurationDescription {
  /// The IDs of the subnets that Firehose uses to create ENIs in the VPC of
  /// the Amazon OpenSearch Service destination. Make sure that the routing
  /// tables and inbound and outbound rules allow traffic to flow from the
  /// subnets whose IDs are specified here to the subnets that have the
