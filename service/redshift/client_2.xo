fn query_put_snapshot(var f: query.Form, prefix: Str, v: Snapshot) {
  if let Some(x) = v.snapshot_identifier {
    query.add(f, query.key(prefix, "SnapshotIdentifier"), x)
  }
  if let Some(x) = v.cluster_identifier {
    query.add(f, query.key(prefix, "ClusterIdentifier"), x)
  }
  if let Some(x) = v.snapshot_create_time {
    query.add(f, query.key(prefix, "SnapshotCreateTime"), rest.date_time(x))
  }
  if let Some(x) = v.status {
    query.add(f, query.key(prefix, "Status"), x)
  }
  if let Some(x) = v.port {
    query.add(f, query.key(prefix, "Port"), "${x}")
  }
  if let Some(x) = v.availability_zone {
    query.add(f, query.key(prefix, "AvailabilityZone"), x)
  }
  if let Some(x) = v.cluster_create_time {
    query.add(f, query.key(prefix, "ClusterCreateTime"), rest.date_time(x))
  }
  if let Some(x) = v.master_username {
    query.add(f, query.key(prefix, "MasterUsername"), x)
  }
  if let Some(x) = v.cluster_version {
    query.add(f, query.key(prefix, "ClusterVersion"), x)
  }
  if let Some(x) = v.engine_full_version {
    query.add(f, query.key(prefix, "EngineFullVersion"), x)
  }
  if let Some(x) = v.snapshot_type {
    query.add(f, query.key(prefix, "SnapshotType"), x)
  }
  if let Some(x) = v.node_type {
    query.add(f, query.key(prefix, "NodeType"), x)
  }
  if let Some(x) = v.number_of_nodes {
    query.add(f, query.key(prefix, "NumberOfNodes"), "${x}")
  }
  if let Some(x) = v.db_name {
    query.add(f, query.key(prefix, "DBName"), x)
  }
  if let Some(x) = v.vpc_id {
    query.add(f, query.key(prefix, "VpcId"), x)
  }
  if let Some(x) = v.encrypted {
    query.add(f, query.key(prefix, "Encrypted"), "${x}")
  }
  if let Some(x) = v.kms_key_id {
    query.add(f, query.key(prefix, "KmsKeyId"), x)
  }
  if let Some(x) = v.encrypted_with_hsm {
    query.add(f, query.key(prefix, "EncryptedWithHSM"), "${x}")
  }
  if let Some(x) = v.accounts_with_restore_access {
    query_put_accounts_with_restore_access_list(f, query.key(prefix, "AccountsWithRestoreAccess"), x, false)
  }
  if let Some(x) = v.owner_account {
    query.add(f, query.key(prefix, "OwnerAccount"), x)
  }
  if let Some(x) = v.total_backup_size_in_mega_bytes {
    query.add(f, query.key(prefix, "TotalBackupSizeInMegaBytes"), rest.float_text(x))
  }
  if let Some(x) = v.actual_incremental_backup_size_in_mega_bytes {
    query.add(f, query.key(prefix, "ActualIncrementalBackupSizeInMegaBytes"), rest.float_text(x))
  }
  if let Some(x) = v.backup_progress_in_mega_bytes {
    query.add(f, query.key(prefix, "BackupProgressInMegaBytes"), rest.float_text(x))
  }
  if let Some(x) = v.current_backup_rate_in_mega_bytes_per_second {
    query.add(f, query.key(prefix, "CurrentBackupRateInMegaBytesPerSecond"), rest.float_text(x))
  }
  if let Some(x) = v.estimated_seconds_to_completion {
    query.add(f, query.key(prefix, "EstimatedSecondsToCompletion"), "${x}")
  }
  if let Some(x) = v.elapsed_time_in_seconds {
    query.add(f, query.key(prefix, "ElapsedTimeInSeconds"), "${x}")
  }
  if let Some(x) = v.source_region {
    query.add(f, query.key(prefix, "SourceRegion"), x)
  }
  if let Some(x) = v.tags {
    query_put_tag_list(f, query.key(prefix, "Tags"), x, false)
  }
  if let Some(x) = v.restorable_node_types {
    query_put_restorable_node_type_list(f, query.key(prefix, "RestorableNodeTypes"), x, false)
  }
  if let Some(x) = v.enhanced_vpc_routing {
    query.add(f, query.key(prefix, "EnhancedVpcRouting"), "${x}")
  }
  if let Some(x) = v.maintenance_track_name {
    query.add(f, query.key(prefix, "MaintenanceTrackName"), x)
  }
  if let Some(x) = v.manual_snapshot_retention_period {
    query.add(f, query.key(prefix, "ManualSnapshotRetentionPeriod"), "${x}")
  }
  if let Some(x) = v.manual_snapshot_remaining_days {
    query.add(f, query.key(prefix, "ManualSnapshotRemainingDays"), "${x}")
  }
  if let Some(x) = v.snapshot_retention_start_time {
    query.add(f, query.key(prefix, "SnapshotRetentionStartTime"), rest.date_time(x))
  }
  if let Some(x) = v.master_password_secret_arn {
    query.add(f, query.key(prefix, "MasterPasswordSecretArn"), x)
  }
  if let Some(x) = v.master_password_secret_kms_key_id {
    query.add(f, query.key(prefix, "MasterPasswordSecretKmsKeyId"), x)
  }
  if let Some(x) = v.snapshot_arn {
    query.add(f, query.key(prefix, "SnapshotArn"), x)
  }
}

