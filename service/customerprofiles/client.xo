    fs.push(("KeyName", json.Value.Str(x)))
  }
  if let Some(x) = input.values {
    fs.push(("Values", json_of_request_value_list(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/domains/${rest.escape(label_domain_name, false)}/profiles/keys"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
