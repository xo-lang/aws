}

fn xml_read_snapshot_schedule_list(e: xml.Element) -> List[SnapshotSchedule] ! Str {
  var out: List[SnapshotSchedule] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_snapshot_schedule(c)?)
  }
  Ok(out)
}