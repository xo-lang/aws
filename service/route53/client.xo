/// Activates a key-signing key (KSK) so that it can be used for signing by
/// DNSSEC. This operation changes the KSK status to ACTIVE .
pub fn (c: Client) activate_key_signing_key(input: ActivateKeySigningKeyRequest) -> ActivateKeySigningKeyResponse ! ActivateKeySigningKeyErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_activate_key_signing_key(c.params, input)) ?? e => return Err(ActivateKeySigningKeyErr.InvalidInput(e))
  var req = serialize_activate_key_signing_key(ep, input, "") ?? e => return Err(ActivateKeySigningKeyErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(ActivateKeySigningKeyErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_activate_key_signing_key_error(resp))
  }
  deserialize_activate_key_signing_key(resp) ?? e => Err(ActivateKeySigningKeyErr.Deserialize(e))
}

