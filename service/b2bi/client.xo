fn json_of_edi_type(v: EdiType) -> json.Value {
  match v {
    X12Details(x) => json.Value.Object([("x12Details", json_of_x12_details(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_edi_type(v: json.Value) -> EdiType ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "x12Details" => Ok(EdiType.X12Details(from_json_x12_details(fv)?))
      _ => Ok(EdiType.Unknown(k))
    }
  }
  Err("EdiType: no member set")
}

