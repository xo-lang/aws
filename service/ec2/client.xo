  if let Some(x) = v.ipv6_address_count {
    xmlv.elem(w, "Ipv6AddressCount", "${x}", [])
  }
  if let Some(x) = v.ipv6_addresses {
    xml_write_instance_ipv6_address_list(w, x, "Ipv6Address", [])
  }
  if let Some(x) = v.kernel_id {
    xmlv.elem(w, "KernelId", x, [])
  }
  if let Some(x) = v.key_name {
    xmlv.elem(w, "KeyName", x, [])
  }
  if let Some(x) = v.max_count {
    xmlv.elem(w, "MaxCount", "${x}", [])
  }
  if let Some(x) = v.min_count {
    xmlv.elem(w, "MinCount", "${x}", [])
  }
  if let Some(x) = v.monitoring {
    xml_write_run_instances_monitoring_enabled(w, x, "Monitoring", [])
  }
  if let Some(x) = v.placement {
    xml_write_placement(w, x, "Placement", [])
  }
  if let Some(x) = v.ramdisk_id {
    xmlv.elem(w, "RamdiskId", x, [])
  }
  if let Some(x) = v.security_group_ids {
    xml_write_security_group_id_string_list(w, x, "SecurityGroupId", [])
  }
  if let Some(x) = v.security_groups {
