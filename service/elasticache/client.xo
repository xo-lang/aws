fn xml_write_serverless_cache(var w: xmlv.Writer, v: ServerlessCache, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.serverless_cache_name {
    xmlv.elem(w, "ServerlessCacheName", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.create_time {
    xmlv.elem(w, "CreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.major_engine_version {
    xmlv.elem(w, "MajorEngineVersion", x, [])
  }
  if let Some(x) = v.full_engine_version {
    xmlv.elem(w, "FullEngineVersion", x, [])
  }
  if let Some(x) = v.cache_usage_limits {
    xml_write_cache_usage_limits(w, x, "CacheUsageLimits", [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KmsKeyId", x, [])
  }
  if let Some(x) = v.storage_encryption_type {
    xmlv.elem(w, "StorageEncryptionType", x.value(), [])
  }
  if let Some(x) = v.security_group_ids {
    xml_write_security_group_ids_list(w, x, "SecurityGroupIds", [])
  }
  if let Some(x) = v.endpoint {
    xml_write_endpoint(w, x, "Endpoint", [])
  }
  if let Some(x) = v.reader_endpoint {
    xml_write_endpoint(w, x, "ReaderEndpoint", [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "ARN", x, [])
  }
  if let Some(x) = v.user_group_id {
    xmlv.elem(w, "UserGroupId", x, [])
  }
  if let Some(x) = v.subnet_ids {
    xml_write_subnet_ids_list(w, x, "SubnetIds", [])
  }
  if let Some(x) = v.snapshot_retention_limit {
    xmlv.elem(w, "SnapshotRetentionLimit", "${x}", [])
  }
  if let Some(x) = v.daily_snapshot_time {
    xmlv.elem(w, "DailySnapshotTime", x, [])
  }
  if let Some(x) = v.network_type {
    xmlv.elem(w, "NetworkType", x.value(), [])
  }
  if let Some(x) = v.connection_type {
    xmlv.elem(w, "ConnectionType", x.value(), [])
  }
  if let Some(x) = v.migration {
    xml_write_migration_summary(w, x, "Migration", [])
  }
  xmlv.end(w, name)
}

fn xml_read_serverless_cache(e: xml.Element) -> ServerlessCache ! Str {
  var out = ServerlessCache{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ServerlessCacheName" => out.serverless_cache_name = c.text()
      "Description" => out.description = c.text()
      "CreateTime" => out.create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Status" => out.status = c.text()
      "Engine" => out.engine = c.text()
      "MajorEngineVersion" => out.major_engine_version = c.text()
      "FullEngineVersion" => out.full_engine_version = c.text()
      "CacheUsageLimits" => out.cache_usage_limits = xml_read_cache_usage_limits(c)?
      "KmsKeyId" => out.kms_key_id = c.text()
      "StorageEncryptionType" => out.storage_encryption_type = StorageEncryptionType.from(c.text())
      "SecurityGroupIds" => out.security_group_ids = xml_read_security_group_ids_list(c)?
      "Endpoint" => out.endpoint = xml_read_endpoint(c)?
      "ReaderEndpoint" => out.reader_endpoint = xml_read_endpoint(c)?
      "ARN" => out.arn = c.text()
      "UserGroupId" => out.user_group_id = c.text()
      "SubnetIds" => out.subnet_ids = xml_read_subnet_ids_list(c)?
      "SnapshotRetentionLimit" => out.snapshot_retention_limit = xmlv.read_int(c.text())?
      "DailySnapshotTime" => out.daily_snapshot_time = c.text()
      "NetworkType" => out.network_type = NetworkType.from(c.text())
      "ConnectionType" => out.connection_type = ConnectionType.from(c.text())
      "Migration" => out.migration = xml_read_migration_summary(c)?
      _ => {}
    }
  }
  Ok(out)
}

