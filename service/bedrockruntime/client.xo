fn json_of_guardrail_automated_reasoning_finding(v: GuardrailAutomatedReasoningFinding) -> json.Value {
  match v {
    Valid(x) => json.Value.Object([("valid", json_of_guardrail_automated_reasoning_valid_finding(x))])
    Invalid(x) => json.Value.Object([("invalid", json_of_guardrail_automated_reasoning_invalid_finding(x))])
    Satisfiable(x) => json.Value.Object([("satisfiable", json_of_guardrail_automated_reasoning_satisfiable_finding(x))])
    Impossible(x) => json.Value.Object([("impossible", json_of_guardrail_automated_reasoning_impossible_finding(x))])
    TranslationAmbiguous(x) => json.Value.Object([("translationAmbiguous", json_of_guardrail_automated_reasoning_translation_ambiguous_finding(x))])
    TooComplex(x) => json.Value.Object([("tooComplex", json_of_guardrail_automated_reasoning_too_complex_finding(x))])
    NoTranslations(x) => json.Value.Object([("noTranslations", json_of_guardrail_automated_reasoning_no_translations_finding(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_guardrail_automated_reasoning_finding(v: json.Value) -> GuardrailAutomatedReasoningFinding ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "valid" => Ok(GuardrailAutomatedReasoningFinding.Valid(from_json_guardrail_automated_reasoning_valid_finding(fv)?))
      "invalid" => Ok(GuardrailAutomatedReasoningFinding.Invalid(from_json_guardrail_automated_reasoning_invalid_finding(fv)?))
      "satisfiable" => Ok(GuardrailAutomatedReasoningFinding.Satisfiable(from_json_guardrail_automated_reasoning_satisfiable_finding(fv)?))
      "impossible" => Ok(GuardrailAutomatedReasoningFinding.Impossible(from_json_guardrail_automated_reasoning_impossible_finding(fv)?))
      "translationAmbiguous" => Ok(GuardrailAutomatedReasoningFinding.TranslationAmbiguous(from_json_guardrail_automated_reasoning_translation_ambiguous_finding(fv)?))
      "tooComplex" => Ok(GuardrailAutomatedReasoningFinding.TooComplex(from_json_guardrail_automated_reasoning_too_complex_finding(fv)?))
      "noTranslations" => Ok(GuardrailAutomatedReasoningFinding.NoTranslations(from_json_guardrail_automated_reasoning_no_translations_finding(fv)?))
      _ => Ok(GuardrailAutomatedReasoningFinding.Unknown(k))
    }
  }
  Err("GuardrailAutomatedReasoningFinding: no member set")
}

