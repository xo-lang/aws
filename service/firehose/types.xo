  /// OpenSearch Service domain, make sure the security group inbound rule
  /// allows HTTPS traffic. For more information about security group rules,
  /// see Security group rules in the Amazon VPC documentation.
  pub security_group_ids: List[Str]? = None
  /// The ID of the Amazon OpenSearch Service destination's VPC.
  pub vpc_id: Str? = None
}
