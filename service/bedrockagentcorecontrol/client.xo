fn json_of_dimension_rating_scale(v: DimensionRatingScale) -> json.Value {
  match v {
    Numerical(x) => json.Value.Object([("numerical", json_of_numerical_scale_definitions(x))])
    Categorical(x) => json.Value.Object([("categorical", json_of_categorical_scale_definitions(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_dimension_rating_scale(v: json.Value) -> DimensionRatingScale ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "numerical" => Ok(DimensionRatingScale.Numerical(from_json_numerical_scale_definitions(fv)?))
      "categorical" => Ok(DimensionRatingScale.Categorical(from_json_categorical_scale_definitions(fv)?))
      _ => Ok(DimensionRatingScale.Unknown(k))
    }
  }
  Err("DimensionRatingScale: no member set")
