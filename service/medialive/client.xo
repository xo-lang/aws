fn from_json_m2_ts_settings(v: json.Value) -> M2tsSettings ! Str {
  var out = M2tsSettings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "absentInputAudioBehavior" => out.absent_input_audio_behavior = M2tsAbsentInputAudioBehavior.from(jsonv.read_str(fv)?)
      "arib" => out.arib = M2tsArib.from(jsonv.read_str(fv)?)
      "aribCaptionsPid" => out.arib_captions_pid = jsonv.read_str(fv)?
      "aribCaptionsPidControl" => out.arib_captions_pid_control = M2tsAribCaptionsPidControl.from(jsonv.read_str(fv)?)
      "audioBufferModel" => out.audio_buffer_model = M2tsAudioBufferModel.from(jsonv.read_str(fv)?)
      "audioFramesPerPes" => out.audio_frames_per_pes = jsonv.read_int(fv)?
      "audioPids" => out.audio_pids = jsonv.read_str(fv)?
      "audioStreamType" => out.audio_stream_type = M2tsAudioStreamType.from(jsonv.read_str(fv)?)
      "bitrate" => out.bitrate = jsonv.read_int(fv)?
      "bufferModel" => out.buffer_model = M2tsBufferModel.from(jsonv.read_str(fv)?)
      "ccDescriptor" => out.cc_descriptor = M2tsCcDescriptor.from(jsonv.read_str(fv)?)
      "dvbNitSettings" => out.dvb_nit_settings = from_json_dvb_nit_settings(fv)?
      "dvbSdtSettings" => out.dvb_sdt_settings = from_json_dvb_sdt_settings(fv)?
      "dvbSubPids" => out.dvb_sub_pids = jsonv.read_str(fv)?
      "dvbTdtSettings" => out.dvb_tdt_settings = from_json_dvb_tdt_settings(fv)?
      "dvbTeletextPid" => out.dvb_teletext_pid = jsonv.read_str(fv)?
      "ebif" => out.ebif = M2tsEbifControl.from(jsonv.read_str(fv)?)
      "ebpAudioInterval" => out.ebp_audio_interval = M2tsAudioInterval.from(jsonv.read_str(fv)?)
      "ebpLookaheadMs" => out.ebp_lookahead_ms = jsonv.read_int(fv)?
      "ebpPlacement" => out.ebp_placement = M2tsEbpPlacement.from(jsonv.read_str(fv)?)
      "ecmPid" => out.ecm_pid = jsonv.read_str(fv)?
