fn xml_read_export_image_request(e: xml.Element) -> ExportImageRequest ! Str {
  var out = ExportImageRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ClientToken" => out.client_token = c.text()
      "Description" => out.description = c.text()
      "DiskImageFormat" => out.disk_image_format = DiskImageFormat.from(c.text())
      "DryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "ImageId" => out.image_id = c.text()
      "S3ExportLocation" => out.s3_export_location = xml_read_export_task_s3_location_request(c)?
      "RoleName" => out.role_name = c.text()
      "TagSpecification" => out.tag_specifications = xml_read_tag_specification_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

