  var out = ResaleAuthorizationSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Name" => out.name = jsonv.read_str(fv)?
      "ProductId" => out.product_id = jsonv.read_str(fv)?
