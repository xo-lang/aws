pub enum BandwidthReductionFilterStrength: Str {
  Low = "LOW"
  Medium = "MEDIUM"
  High = "HIGH"
  Auto = "AUTO"
  Off = "OFF"
  Unknown(value: Str)
}

/// The tag type that AWS Billing and Cost Management will use to sort your
