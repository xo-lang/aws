fn xml_write_global_replication_group(var w: xmlv.Writer, v: GlobalReplicationGroup, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.global_replication_group_id {
    xmlv.elem(w, "GlobalReplicationGroupId", x, [])
  }
  if let Some(x) = v.global_replication_group_description {
    xmlv.elem(w, "GlobalReplicationGroupDescription", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x, [])
  }
  if let Some(x) = v.cache_node_type {
    xmlv.elem(w, "CacheNodeType", x, [])
  }
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.engine_version {
    xmlv.elem(w, "EngineVersion", x, [])
  }
  if let Some(x) = v.members {
    xml_write_global_replication_group_member_list(w, x, "Members", [])
  }
  if let Some(x) = v.cluster_enabled {
    xmlv.elem(w, "ClusterEnabled", "${x}", [])
  }
  if let Some(x) = v.global_node_groups {
    xml_write_global_node_group_list(w, x, "GlobalNodeGroups", [])
  }
  if let Some(x) = v.auth_token_enabled {
    xmlv.elem(w, "AuthTokenEnabled", "${x}", [])
  }
  if let Some(x) = v.transit_encryption_enabled {
    xmlv.elem(w, "TransitEncryptionEnabled", "${x}", [])
  }
  if let Some(x) = v.at_rest_encryption_enabled {
    xmlv.elem(w, "AtRestEncryptionEnabled", "${x}", [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "ARN", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_global_replication_group(e: xml.Element) -> GlobalReplicationGroup ! Str {
  var out = GlobalReplicationGroup{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "GlobalReplicationGroupId" => out.global_replication_group_id = c.text()
      "GlobalReplicationGroupDescription" => out.global_replication_group_description = c.text()
      "Status" => out.status = c.text()
      "CacheNodeType" => out.cache_node_type = c.text()
      "Engine" => out.engine = c.text()
      "EngineVersion" => out.engine_version = c.text()
      "Members" => out.members = xml_read_global_replication_group_member_list(c)?
      "ClusterEnabled" => out.cluster_enabled = xmlv.read_bool(c.text())?
      "GlobalNodeGroups" => out.global_node_groups = xml_read_global_node_group_list(c)?
      "AuthTokenEnabled" => out.auth_token_enabled = xmlv.read_bool(c.text())?
      "TransitEncryptionEnabled" => out.transit_encryption_enabled = xmlv.read_bool(c.text())?
      "AtRestEncryptionEnabled" => out.at_rest_encryption_enabled = xmlv.read_bool(c.text())?
      "ARN" => out.arn = c.text()
      _ => {}
    }
  }
  Ok(out)
}

