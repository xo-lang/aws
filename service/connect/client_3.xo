    AttachedFileServiceQuotaExceededExceptionReason(x) => json.Value.Object([("AttachedFileServiceQuotaExceededExceptionReason", json.Value.Str(x.value()))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_service_quota_exceeded_exception_reason(v: json.Value) -> ServiceQuotaExceededExceptionReason ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "AttachedFileServiceQuotaExceededExceptionReason" => Ok(ServiceQuotaExceededExceptionReason.AttachedFileServiceQuotaExceededExceptionReason(AttachedFileServiceQuotaExceededExceptionReason.from(jsonv.read_str(fv)?)))
      _ => Ok(ServiceQuotaExceededExceptionReason.Unknown(k))
    }
  }
  Err("ServiceQuotaExceededExceptionReason: no member set")
}

