  /// Earliest time of day the trigger may fire
  pub start_after: Str? = None
  /// Latest time of day the trigger may fire
  pub start_before: Str? = None
  /// How the window recurs
  pub recurrence: Recurrence? = None
}

pub enum ToolClassification: Str {
  ReadOnly = "READ_ONLY"
  Mutative = "MUTATIVE"
  Destructive = "DESTRUCTIVE"
  Unknown(value: Str)
}

