  }
}

fn from_json_source_configuration(v: json.Value) -> SourceConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "appIntegrations" => Ok(SourceConfiguration.AppIntegrations(from_json_app_integrations_configuration(fv)?))
      _ => Ok(SourceConfiguration.Unknown(k))
    }
  }
  Err("SourceConfiguration: no member set")
}

