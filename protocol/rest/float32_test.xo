/// A vector line without the `_` it has after every 8 digits.
fn unsplit(s: Str) -> Str {
  s.replace("_", "")
}

test "Float32 text forms are Go's FormatFloat(..., 32) and smithy-go's EncodeFloat" {
  var out: List[Str] = []
  for b in F32_BITS {
    let f = Float32.from_bits(UInt32.try(b) ?? fault("bits ${b}"))
    out.push("${float32_text(f)} ${encode_float32(f)} ${encode_float(Float(f))}")
  }
  for (i, l) in out.indexed() {
    expect("${F32_BITS.get(i) ?? 0} ${l}") == "${F32_BITS.get(i) ?? 0} ${unsplit(F32_GO.get(i) ?? "")}"
  }
  expect(out.len()) == F32_GO.len()
}

test "a Float rounds to Float32 as Go's float32(v)" {
  for (i, b) in F64_BITS.indexed() {
    let got = Float32(Float.from_bits(b)).to_bits()
    expect("${b} ${got}") == "${b} ${F64_GO.get(i) ?? 0}"
  }
}

test "the special Float32 values are Smithy's names" {
  expect(float32_text(Float32(nan()))) == "NaN"
  expect(encode_float32(Float32(inf()))) == "Infinity"
  expect(encode_float32(Float32(-inf()))) == "-Infinity"
  expect(float32_text(Float32(1e39))) == "Infinity"
}
