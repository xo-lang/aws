  Graphic = "GRAPHIC"
  HarassmentOrAbuse = "HARASSMENT_OR_ABUSE"
  HateSpeech = "HATE_SPEECH"
  Insult = "INSULT"
  Profanity = "PROFANITY"
  Sexual = "SEXUAL"
  ViolenceOrThreat = "VIOLENCE_OR_THREAT"
  Unknown(value: Str)
}

/// Toxicity analysis result for one string. For more information about
/// toxicity detection, see Toxicity detection in the Amazon Comprehend
/// Developer Guide .
pub struct ToxicLabels {
  /// Array of toxic content types identified in the string.
  pub labels: List[ToxicContent]? = None
  /// Overall toxicity score for the string. Value range is zero to one, where
  /// one is the highest confidence.
  pub toxicity: Float? = None
}

/// Amazon Comprehend can't process the language of the input text. For a
/// list of supported languages, Supported languages in the Comprehend
/// Developer Guide.
pub struct UnsupportedLanguageException {
  pub message: Str? = None
}

pub struct UntagResourceRequest {
  /// The Amazon Resource Name (ARN) of the given Amazon Comprehend resource
  /// from which you want to remove the tags.
  pub resource_arn: Str? = None
  /// The initial part of a key-value pair that forms a tag being removed from
  /// a given resource. For example, a tag with "Sales" as the key might be
  /// added to a resource to indicate its use by the sales department. Keys
  /// must be unique and cannot be duplicated for a particular resource.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

/// Data security configuration.
pub struct UpdateDataSecurityConfig {
  /// ID for the KMS key that Amazon Comprehend uses to encrypt trained custom
  /// models. The ModelKmsKeyId can be either of the following formats: KMS
  /// Key ID: "1234abcd-12ab-34cd-56ef-1234567890ab" Amazon Resource Name
  /// (ARN) of a KMS Key:
  /// "arn:aws:kms:us-west-2:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
  pub model_kms_key_id: Str? = None
  /// ID for the KMS key that Amazon Comprehend uses to encrypt the volume.
  pub volume_kms_key_id: Str? = None
  pub vpc_config: VpcConfig? = None
}

pub struct UpdateEndpointRequest {
  /// The Amazon Resource Number (ARN) of the endpoint being updated.
  pub endpoint_arn: Str? = None
  /// The ARN of the new model to use when updating an existing endpoint.
  pub desired_model_arn: Str? = None
  /// The desired number of inference units to be used by the model using this
  /// endpoint. Each inference unit represents of a throughput of 100
  /// characters per second.
  pub desired_inference_units: Int? = None
  /// Data access role ARN to use in case the new model is encrypted with a
  /// customer CMK.
