fn json_of_xavc_settings(v: XavcSettings) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.adaptive_quantization {
    fs.push(("adaptiveQuantization", json.Value.Str(x.value())))
  }
  if let Some(x) = v.entropy_encoding {
    fs.push(("entropyEncoding", json.Value.Str(x.value())))
  }
  if let Some(x) = v.framerate_control {
    fs.push(("framerateControl", json.Value.Str(x.value())))
  }
  if let Some(x) = v.framerate_conversion_algorithm {
    fs.push(("framerateConversionAlgorithm", json.Value.Str(x.value())))
  }
  if let Some(x) = v.framerate_denominator {
    fs.push(("framerateDenominator", json.Value.Int(x)))
  }
  if let Some(x) = v.framerate_numerator {
    fs.push(("framerateNumerator", json.Value.Int(x)))
  }
  if let Some(x) = v.per_frame_metrics {
    fs.push(("perFrameMetrics", json_of_list_of_frame_metric_type(x)))
  }
  if let Some(x) = v.profile {
    fs.push(("profile", json.Value.Str(x.value())))
  }
  if let Some(x) = v.slow_pal {
    fs.push(("slowPal", json.Value.Str(x.value())))
  }
  if let Some(x) = v.softness {
    fs.push(("softness", json.Value.Int(x)))
  }
  if let Some(x) = v.spatial_adaptive_quantization {
    fs.push(("spatialAdaptiveQuantization", json.Value.Str(x.value())))
  }
  if let Some(x) = v.temporal_adaptive_quantization {
    fs.push(("temporalAdaptiveQuantization", json.Value.Str(x.value())))
  }
  if let Some(x) = v.xavc4_k_intra_cbg_profile_settings {
    fs.push(("xavc4kIntraCbgProfileSettings", json_of_xavc4_k_intra_cbg_profile_settings(x)))
  }
  if let Some(x) = v.xavc4_k_intra_vbr_profile_settings {
    fs.push(("xavc4kIntraVbrProfileSettings", json_of_xavc4_k_intra_vbr_profile_settings(x)))
  }
  if let Some(x) = v.xavc4_k_profile_settings {
    fs.push(("xavc4kProfileSettings", json_of_xavc4_k_profile_settings(x)))
  }
  if let Some(x) = v.xavc_hd_intra_cbg_profile_settings {
    fs.push(("xavcHdIntraCbgProfileSettings", json_of_xavc_hd_intra_cbg_profile_settings(x)))
  }
  if let Some(x) = v.xavc_hd_profile_settings {
    fs.push(("xavcHdProfileSettings", json_of_xavc_hd_profile_settings(x)))
  }
  json.Value.Object(fs)
}

fn from_json_xavc_settings(v: json.Value) -> XavcSettings ! Str {
  var out = XavcSettings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "adaptiveQuantization" => out.adaptive_quantization = XavcAdaptiveQuantization.from(jsonv.read_str(fv)?)
      "entropyEncoding" => out.entropy_encoding = XavcEntropyEncoding.from(jsonv.read_str(fv)?)
      "framerateControl" => out.framerate_control = XavcFramerateControl.from(jsonv.read_str(fv)?)
      "framerateConversionAlgorithm" => out.framerate_conversion_algorithm = XavcFramerateConversionAlgorithm.from(jsonv.read_str(fv)?)
      "framerateDenominator" => out.framerate_denominator = jsonv.read_int(fv)?
      "framerateNumerator" => out.framerate_numerator = jsonv.read_int(fv)?
      "perFrameMetrics" => out.per_frame_metrics = from_json_list_of_frame_metric_type(fv)?
      "profile" => out.profile = XavcProfile.from(jsonv.read_str(fv)?)
      "slowPal" => out.slow_pal = XavcSlowPal.from(jsonv.read_str(fv)?)
      "softness" => out.softness = jsonv.read_int(fv)?
      "spatialAdaptiveQuantization" => out.spatial_adaptive_quantization = XavcSpatialAdaptiveQuantization.from(jsonv.read_str(fv)?)
      "temporalAdaptiveQuantization" => out.temporal_adaptive_quantization = XavcTemporalAdaptiveQuantization.from(jsonv.read_str(fv)?)
      "xavc4kIntraCbgProfileSettings" => out.xavc4_k_intra_cbg_profile_settings = from_json_xavc4_k_intra_cbg_profile_settings(fv)?
      "xavc4kIntraVbrProfileSettings" => out.xavc4_k_intra_vbr_profile_settings = from_json_xavc4_k_intra_vbr_profile_settings(fv)?
      "xavc4kProfileSettings" => out.xavc4_k_profile_settings = from_json_xavc4_k_profile_settings(fv)?
      "xavcHdIntraCbgProfileSettings" => out.xavc_hd_intra_cbg_profile_settings = from_json_xavc_hd_intra_cbg_profile_settings(fv)?
      "xavcHdProfileSettings" => out.xavc_hd_profile_settings = from_json_xavc_hd_profile_settings(fv)?
      _ => {}
    }
  }
  Ok(out)
}

