    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.ClusterAssociatedToSchedule.${i + 1}" }
    query_put_cluster_associated_to_schedule(f, k, x)
  }
}

fn query_put_association(var f: query.Form, prefix: Str, v: Association) {
  if let Some(x) = v.custom_domain_certificate_arn {
    query.add(f, query.key(prefix, "CustomDomainCertificateArn"), x)
  }
  if let Some(x) = v.custom_domain_certificate_expiry_date {
    query.add(f, query.key(prefix, "CustomDomainCertificateExpiryDate"), rest.date_time(x))
  }
  if let Some(x) = v.certificate_associations {
    query_put_certificate_association_list(f, query.key(prefix, "CertificateAssociations"), x, false)
  }
}

