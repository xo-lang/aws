  var req = serialize_rollback_transaction(ep, input, "") ?? e => return Err(RollbackTransactionErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(RollbackTransactionErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_rollback_transaction_error(resp))
  }
  deserialize_rollback_transaction(resp) ?? e => Err(RollbackTransactionErr.Deserialize(e))
}
