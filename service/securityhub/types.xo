  pub compliant_medium_count: Int? = None
  /// The type of execution that was used determine compliance.
  pub execution_type: Str? = None
  /// For the patch items that are noncompliant, the number of items that have
  /// a severity of CRITICAL .
  pub non_compliant_critical_count: Int? = None
  /// For the patches that are compliant, the number that have a severity of
  /// INFORMATIONAL .
  pub compliant_informational_count: Int? = None
  /// For the patches that are noncompliant, the number that have a severity
  /// of INFORMATIONAL .
  pub non_compliant_informational_count: Int? = None
  /// For the patches that are compliant, the number that have a severity of
  /// UNSPECIFIED .
  pub compliant_unspecified_count: Int? = None
  /// For the patches that are noncompliant, the number that have a severity
  /// of LOW .
  pub non_compliant_low_count: Int? = None
  /// For the patches that are noncompliant, the number that have a severity
