fn query_put_modify_additional_storage_volumes_list(var f: query.Form, prefix: Str, v: List[ModifyAdditionalStorageVolume], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_modify_additional_storage_volume(f, k, x)
  }
}

