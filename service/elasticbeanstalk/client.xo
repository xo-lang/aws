fn query_put_abort_environment_update_message(var f: query.Form, prefix: Str, v: AbortEnvironmentUpdateMessage) {
  if let Some(x) = v.environment_id {
    query.add(f, query.key(prefix, "EnvironmentId"), x)
  }
  if let Some(x) = v.environment_name {
    query.add(f, query.key(prefix, "EnvironmentName"), x)
  }
}

fn query_put_application_description(var f: query.Form, prefix: Str, v: ApplicationDescription) {
  if let Some(x) = v.application_arn {
    query.add(f, query.key(prefix, "ApplicationArn"), x)
  }
  if let Some(x) = v.application_name {
    query.add(f, query.key(prefix, "ApplicationName"), x)
  }
  if let Some(x) = v.description {
    query.add(f, query.key(prefix, "Description"), x)
  }
  if let Some(x) = v.date_created {
    query.add(f, query.key(prefix, "DateCreated"), rest.date_time(x))
  }
  if let Some(x) = v.date_updated {
    query.add(f, query.key(prefix, "DateUpdated"), rest.date_time(x))
  }
  if let Some(x) = v.versions {
    query_put_version_labels_list(f, query.key(prefix, "Versions"), x, false)
  }
  if let Some(x) = v.configuration_templates {
    query_put_configuration_template_names_list(f, query.key(prefix, "ConfigurationTemplates"), x, false)
  }
  if let Some(x) = v.resource_lifecycle_config {
    query_put_application_resource_lifecycle_config(f, query.key(prefix, "ResourceLifecycleConfig"), x)
  }
}

fn query_put_application_description_list(var f: query.Form, prefix: Str, v: List[ApplicationDescription], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_application_description(f, k, x)
  }
}

fn query_put_application_description_message(var f: query.Form, prefix: Str, v: ApplicationDescriptionMessage) {
  if let Some(x) = v.application {
    query_put_application_description(f, query.key(prefix, "Application"), x)
  }
}

