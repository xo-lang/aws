      "SupportsCustomCalculation" => out.supports_custom_calculation = jsonv.read_bool(fv)?
      "PrimaryEventSource" => out.primary_event_source = jsonv.read_str(fv)?
      "PrimaryEventSourceEffectiveTimestampType" => out.primary_event_source_effective_timestamp_type = jsonv.read_str(fv)?
      "CreatedTime" => out.created_time = jsonv.read_time(fv, "epoch-seconds")?
      "CreatedUser" => out.created_user = from_json_created_by_info(fv)?
      "LastModifiedRegion" => out.last_modified_region = jsonv.read_str(fv)?
      "LastModifiedTime" => out.last_modified_time = jsonv.read_time(fv, "epoch-seconds")?
      "LastModifiedUser" => out.last_modified_user = from_json_created_by_info(fv)?
      "Tags" => out.tags = from_json_tag_map(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_metric_filter(v: MetricFilter) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.metric_filter_key {
    fs.push(("MetricFilterKey", json.Value.Str(x)))
  }
  if let Some(x) = v.negate {
    fs.push(("Negate", json.Value.Bool(x)))
  }
  if let Some(x) = v.number_condition {
    fs.push(("NumberCondition", json_of_metric_filter_number_condition(x)))
  }
  if let Some(x) = v.string_condition {
    fs.push(("StringCondition", json_of_metric_filter_string_condition(x)))
  }
  if let Some(x) = v.boolean_condition {
    fs.push(("BooleanCondition", json_of_metric_filter_boolean_condition(x)))
  }
  json.Value.Object(fs)
}

fn from_json_metric_filter(v: json.Value) -> MetricFilter ! Str {
  var out = MetricFilter{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "MetricFilterKey" => out.metric_filter_key = jsonv.read_str(fv)?
      "Negate" => out.negate = jsonv.read_bool(fv)?
      "NumberCondition" => out.number_condition = from_json_metric_filter_number_condition(fv)?
      "StringCondition" => out.string_condition = from_json_metric_filter_string_condition(fv)?
      "BooleanCondition" => out.boolean_condition = from_json_metric_filter_boolean_condition(fv)?
      _ => {}
    }
  }
  Ok(out)
}

