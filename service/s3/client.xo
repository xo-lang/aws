  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.prefix {
    xmlv.elem(w, "Prefix", x, [])
  }
  if let Some(x) = v.tags {
    for item in x {
      xml_write_tag(w, item, "Tag", [])
    }
  }
  if let Some(x) = v.access_point_arn {
    xmlv.elem(w, "AccessPointArn", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_metrics_and_operator(e: xml.Element) -> MetricsAndOperator ! Str {
  var out = MetricsAndOperator{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Prefix" => out.prefix = c.text()
      "Tag" => {
        var items = out.tags ?? []
        items.push(xml_read_tag(c)?)
        out.tags = items
      }
      "AccessPointArn" => out.access_point_arn = c.text()
      _ => {}
    }
  }
  Ok(out)
}

