fn read_error_access_to_cluster_denied_fault(resp: http.Response, body: xml.Element) -> AccessToClusterDeniedFault ! Str {
  let _ = (resp, body)
  var out = AccessToClusterDeniedFault{}
  for c in xmlv.elements(body) {
    match c.name.local {
      "message" => out.message = c.text()
      _ => {}
    }
  }
  Ok(out)
}

