pub enum JDBCConnectionType: Str {
  Sqlserver = "sqlserver"
  Mysql = "mysql"
  Oracle = "oracle"
  Postgresql = "postgresql"
  Redshift = "redshift"
  Unknown(value: Str)
}

/// Additional connection options for the connector.
pub struct JDBCConnectorOptions {
  /// Extra condition clause to filter data from source. For example:
  /// BillingCity='Mountain View' When using a query instead of a table name,
  /// you should validate that the query works with the specified
  /// filterPredicate .
  pub filter_predicate: Str? = None
  /// The name of an integer column that is used for partitioning. This option
  /// works only when it's included with lowerBound , upperBound , and
  /// numPartitions . This option works the same way as in the Spark SQL JDBC
  /// reader.
  pub partition_column: Str? = None
  /// The minimum value of partitionColumn that is used to decide partition
  /// stride.
  pub lower_bound: Int? = None
  /// The maximum value of partitionColumn that is used to decide partition
  /// stride.
  pub upper_bound: Int? = None
  /// The number of partitions. This value, along with lowerBound (inclusive)
  /// and upperBound (exclusive), form partition strides for generated WHERE
  /// clause expressions that are used to split the partitionColumn .
  pub num_partitions: Int? = None
  /// The name of the job bookmark keys on which to sort.
  pub job_bookmark_keys: List[Str]? = None
  /// Specifies an ascending or descending sort order.
  pub job_bookmark_keys_sort_order: Str? = None
  /// Custom data type mapping that builds a mapping from a JDBC data type to
  /// an Glue data type. For example, the option
  /// "dataTypeMapping":{"FLOAT":"STRING"} maps data fields of JDBC type FLOAT
  /// into the Java String type by calling the ResultSet.getString() method of
  /// the driver, and uses it to build the Glue record. The ResultSet object
  /// is implemented by each driver, so the behavior is specific to the driver
  /// you use. Refer to the documentation for your JDBC driver to understand
  /// how the driver performs the conversions.
  pub data_type_mapping: Map[Str, GlueRecordType]? = None
}

/// Specifies a connector to a JDBC data source.
pub struct JDBCConnectorSource {
  /// The name of the data source.
  pub name: Str? = None
  /// The name of the connection that is associated with the connector.
  pub connection_name: Str? = None
  /// The name of a connector that assists with accessing the data store in
  /// Glue Studio.
  pub connector_name: Str? = None
  /// The type of connection, such as marketplace.jdbc or custom.jdbc,
  /// designating a connection to a JDBC data store.
  pub connection_type: Str? = None
  /// Additional connection options for the connector.
  pub additional_options: JDBCConnectorOptions? = None
  /// The name of the table in the data source.
  pub connection_table: Str? = None
  /// The table or SQL query to get the data from. You can specify either
  /// ConnectionTable or query , but not both.
  pub query: Str? = None
  /// Specifies the data schema for the custom JDBC source.
  pub output_schemas: List[GlueSchema]? = None
}

/// Specifies a data target that writes to Amazon S3 in Apache Parquet
