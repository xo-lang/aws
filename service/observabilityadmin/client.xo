fn from_json_azure_subscription_scope(v: json.Value) -> AzureSubscriptionScope ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "All" => Ok(AzureSubscriptionScope.All(from_json_all_subscriptions(fv)?))
      "Ids" => Ok(AzureSubscriptionScope.Ids(from_json_azure_subscription_id_list(fv)?))
      _ => Ok(AzureSubscriptionScope.Unknown(k))
    }
  }
  Err("AzureSubscriptionScope: no member set")
}

