  /// The name that you specified for the DB capacity reservation.
  pub db_capacity_reservation_name: Str? = None
  /// The DB instance class for the reserved capacity. You specify this value
  /// when you create the reservation, and you can't change it afterward.
  pub db_instance_class: Str? = None
  /// The database engine for the reserved capacity. You specify this value
  /// when you create the reservation, and you can't change it afterward.
  pub engine: Str? = None
  /// The license model for the reserved capacity. Amazon RDS returns this
  /// value only for a reservation that reserves capacity for a specific
  /// license model. Amazon RDS doesn't return this value for a reservation
  /// whose database engine doesn't support a license model. A DB instance
  /// launches into the reservation only when the license model of the DB
  /// instance matches this value. For a reservation that holds no license
  /// model, Amazon RDS applies no license model check at launch. Valid
  /// Values: RDS for Microsoft SQL Server Enterprise Edition and Standard
  /// Edition - license-included | bring-your-own-media RDS for Microsoft SQL
  /// Server Developer Edition - bring-your-own-license RDS for Oracle -
  /// bring-your-own-license | license-included RDS for Db2 Standard Edition
  /// and Advanced Edition - bring-your-own-license | marketplace-license For
  /// RDS for Db2 Standard Edition and Advanced Edition, a reservation created
  /// without a license model holds bring-your-own-license .
  pub license_model: Str? = None
  /// The number of DB instances that Amazon RDS reserves in each Availability
  /// Zone of the reservation. This value matches the
  /// CapacityPerAvailabilityZone parameter of the request. The total reserved
  /// capacity is this value multiplied by the number of Availability Zones of
  /// the reservation.
  pub reserved_capacity_per_availability_zone: Int? = None
  /// The unused capacity of the reservation, reported for each Availability
  /// Zone of the reservation. Each entry names one Availability Zone, and it
  /// reports the number of DB instances that remain available in that
  /// Availability Zone. Amazon RDS reports available capacity only for a
  /// reservation that is in the active state and not past its end date.
  /// Otherwise, each entry reports an available capacity of 0 . A
  /// future-dated reservation that hasn't started reports 0 , and a
  /// reservation that Amazon RDS is modifying reports 0 . A reservation
  /// reports the pending state while Amazon RDS modifies it. Therefore, a
  /// reservation in the active state that reports no available capacity has
  /// no unused capacity.
  pub available_capacity_per_availability_zone_list: List[AvailableCapacityPerAvailabilityZone]? = None
  /// The date and time when the reservation expires, in Universal Coordinated
  /// Time (UTC). Amazon RDS doesn't return this value if the reservation
  /// doesn't expire. A DB instance that uses the reservation keeps running
  /// after the reservation expires. It continues on unreserved capacity, and
  /// Amazon RDS doesn't stop it or modify it. However, Amazon RDS no longer
  /// reserves capacity for the DB instance. Amazon RDS might later move the
  /// DB instance to different hardware, for example during hardware
  /// maintenance. That move can fail when the Amazon Web Services Region has
  /// insufficient capacity for the DB instance class.
  pub end_date: Time? = None
  /// The date and time when the reservation was created, in Universal
  /// Coordinated Time (UTC).
  pub create_date: Time? = None
  /// The date and time when a future-dated reservation starts, in Universal
  /// Coordinated Time (UTC). Amazon RDS doesn't return this value for a
  /// reservation that started immediately.
  pub start_date: Time? = None
  /// The capacity commitment of the reservation. Amazon RDS returns this
  /// object only for a future-dated reservation.
  pub commitment_info: DBCapacityReservationCommitmentInfo? = None
  /// The current state of the DB capacity reservation. A DB instance can use
  /// the reservation in the active state only. Valid Values: active - Amazon
  /// RDS holds the reserved capacity, and a DB instance can use it. pending -
  /// The reservation isn't ready to use yet. Amazon RDS is creating the
  /// reserved capacity, or it is applying a requested modification. assessing
  /// - Amazon RDS is evaluating the request for a future-dated reservation.
  /// scheduled - Amazon RDS accepted a future-dated reservation, and the
  /// reservation is waiting for its start date. delayed - Amazon RDS couldn't
  /// provide the reserved capacity of a future-dated reservation by its start
  /// date. unsupported - Amazon RDS can't fulfill the future-dated
  /// reservation as requested. expired - The reservation passed its end date.
  /// Amazon RDS releases the reserved capacity. cancelled - You cancelled the
  /// reservation, and Amazon RDS released the reserved capacity. failed -
  /// Amazon RDS couldn't reserve the capacity. The values assessing ,
  /// scheduled , delayed , and unsupported apply to a future-dated
  /// reservation only.
  pub state: DBCapacityReservationState? = None
  /// The Amazon Resource Name (ARN) of the DB capacity reservation.
  pub db_capacity_reservation_arn: Str? = None
  /// The unique identifier of the DB capacity reservation. The identifier has
  /// the prefix dbcr- . Every other DB capacity reservation operation takes
  /// this identifier.
  pub db_capacity_reservation_identifier: Str? = None
  /// The tags associated with the DB capacity reservation.
  pub tag_list: List[Tag]? = None
}

