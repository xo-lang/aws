fn json_of_experimental_capabilities(v: ExperimentalCapabilities) -> json.Value {
  match v {
    Enabled(x) => json.Value.Object([("enabled", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_experimental_capabilities(v: json.Value) -> ExperimentalCapabilities ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "enabled" => Ok(ExperimentalCapabilities.Enabled(jsonv.read_str(fv)?))
      _ => Ok(ExperimentalCapabilities.Unknown(k))
    }
  }
  Err("ExperimentalCapabilities: no member set")
}

