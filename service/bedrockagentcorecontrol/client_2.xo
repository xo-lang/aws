fn json_of_validation(v: Validation) -> json.Value {
  match v {
    StringValidation(x) => json.Value.Object([("stringValidation", json_of_string_validation(x))])
    StringListValidation(x) => json.Value.Object([("stringListValidation", json_of_string_list_validation(x))])
    NumberValidation(x) => json.Value.Object([("numberValidation", json_of_number_validation(x))])
    Unknown(_) => json.Value.Object([])
  }
}