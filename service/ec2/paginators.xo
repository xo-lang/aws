/// while the last page carried a new token.
pub fn (p: SearchTransitGatewayRoutesPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: SearchTransitGatewayRoutesPaginator) next_page() -> SearchTransitGatewayRoutesResult ! SearchTransitGatewayRoutesErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.search_transit_gateway_routes(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
