fn json_of_matching_workflow_summary(v: MatchingWorkflowSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.workflow_name {
    fs.push(("workflowName", json.Value.Str(x)))
  }
  if let Some(x) = v.workflow_arn {
    fs.push(("workflowArn", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
