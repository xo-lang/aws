fn from_json_session(v: json.Value) -> Session ! Str {
  var out = Session{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Id" => out.id = jsonv.read_str(fv)?
      "ClusterId" => out.cluster_id = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "Arn" => out.arn = jsonv.read_str(fv)?
      "State" => out.state = SessionState.from(jsonv.read_str(fv)?)
      "StateChangeReason" => out.state_change_reason = jsonv.read_str(fv)?
      "ReleaseLabel" => out.release_label = jsonv.read_str(fv)?
      "ExecutionRoleArn" => out.execution_role_arn = jsonv.read_str(fv)?
      "AccountId" => out.account_id = jsonv.read_str(fv)?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "UpdatedAt" => out.updated_at = jsonv.read_time(fv, "epoch-seconds")?
      "StartedAt" => out.started_at = jsonv.read_time(fv, "epoch-seconds")?
      "EndedAt" => out.ended_at = jsonv.read_time(fv, "epoch-seconds")?
      "IdleSince" => out.idle_since = jsonv.read_time(fv, "epoch-seconds")?
      "EngineConfigurations" => out.engine_configurations = from_json_configuration_list(fv)?
      "MonitoringConfiguration" => out.monitoring_configuration = from_json_session_monitoring_configuration(fv)?
      "SessionIdleTimeoutInMinutes" => out.session_idle_timeout_in_minutes = jsonv.read_int(fv)?
      "ServerUrl" => out.server_url = jsonv.read_str(fv)?
      "Tags" => out.tags = from_json_tag_list(fv)?
      _ => {}
    }
  }
  Ok(out)
}

