// S3 against MinIO (decision 0005, emulator tests): run by
// scripts/integration-minio.sh, which starts MinIO on 127.0.0.1 with
// invented credentials and sets the XO_AWS_TEST_* variables. The client
// gets a Net that reaches only the loopback host.

use std/http
use std/multipart
use github.com/xo-lang/aws
use github.com/xo-lang/aws/credentials
use github.com/xo-lang/aws/service/s3

test "s3 round trip against MinIO" uses net, env, clock {
  let endpoint = os.env.get("XO_AWS_TEST_S3_ENDPOINT") ?? "http://127.0.0.1:19000"
  let id = os.env.get("XO_AWS_TEST_KEY_ID") ?? "AKIDTEST0000000000"
  let secret = os.env.get("XO_AWS_TEST_SECRET") ?? ""
  let c = s3.new(os.net.only(["127.0.0.1", "localhost"]), os.clock, os.rand, s3.Options{
    endpoint: endpoint,
    credentials: credentials.static_provider(id, secret),
    force_path_style: true,
  })?
  let bucket = "xo-lang-aws-it"
  c.create_bucket(s3.CreateBucketRequest{bucket: bucket})?
  s3.wait_until_bucket_exists(c, s3.HeadBucketRequest{bucket: bucket}, 30s, min_delay: 1s, max_delay: 2s)?
  c.put_object(s3.PutObjectRequest{bucket: bucket, key: "dir/hello world.txt", body: b"hello from xo"})?
  let got = c.get_object(s3.GetObjectRequest{bucket: bucket, key: "dir/hello world.txt"})?
  expect(got.body) == Some(b"hello from xo")
  let list = c.list_objects_v2(s3.ListObjectsV2Request{bucket: bucket})?
  let keys = (list.contents ?? []).map(fn(o: s3.Object) -> Str { o.key ?? "" })
  expect(keys) == ["dir/hello world.txt"]
  // a streamed body, three aws-chunked chunks with a CRC32 trailer
  // (decision 0009), written by a task as the client sends it
  var big = b""
  while big.len() < 150000 {
    big = big + "streamed body ${big.len()}\n".bytes()
  }
  let (w, r) = http.pipe()
  os.tasks.spawn_background(fn() {
    if w.write(big).is_ok() {
      w.close()
    }
  })
  c.put_object(s3.PutObjectRequest{bucket: bucket, key: "streamed.bin", body_stream: Some(aws.upload_reader(r, Some(big.len())))})?
  let back = c.get_object(s3.GetObjectRequest{bucket: bucket, key: "streamed.bin"})?
  expect(back.body == Some(big)) == true
  c.delete_object(s3.DeleteObjectRequest{bucket: bucket, key: "streamed.bin"})?
  let head = c.head_object(s3.HeadObjectRequest{bucket: bucket, key: "dir/hello world.txt"})?
  expect(head.content_length) == Some(13)
  match c.get_object(s3.GetObjectRequest{bucket: bucket, key: "missing"}) {
    Err(s3.GetObjectErr.NoSuchKey(_)) => {}
    other => expect("${other:?}") == "NoSuchKey"
  }
  match c.head_object(s3.HeadObjectRequest{bucket: bucket, key: "missing"}) {
    Err(s3.HeadObjectErr.NotFound(_)) => {}
    other => expect("${other:?}") == "NotFound"
  }
  // presigned PUT and GET, sent with no credentials by a plain client
  let plain = http.client(os.net.only(["127.0.0.1", "localhost"]))
  let put = c.presign_put_object(s3.PutObjectRequest{bucket: bucket, key: "presigned.txt"}, expires: 5m)?
  var put_req = http.new_request(put.method, put.url, {}, b"sent by URL")
  for (k, v) in put.headers {
    put_req = put_req.with_header(k, v)
  }
  expect(plain.send(put_req)?.status) == 200
  let get = c.presign_get_object(s3.GetObjectRequest{bucket: bucket, key: "presigned.txt"})?
  let fetched = plain.send(http.new_request(get.method, get.url, {}, b""))?
  expect(fetched.status) == 200
  expect(fetched.body) == b"sent by URL"
  // a tampered signature is refused (MinIO checks signatures; LocalStack
  // does not by default, so its script leaves this unset)
  if os.env.get("XO_AWS_TEST_CHECKS_SIGNATURES") == Some("1") {
    let bad = plain.send(http.new_request("GET", get.url.replace("X-Amz-Signature=", "X-Amz-Signature=0"), {}, b""))?
    expect(bad.status) == 403
  }
  c.delete_object(s3.DeleteObjectRequest{bucket: bucket, key: "presigned.txt"})?
  // a presigned POST: the form fields, then the file, posted by a plain client
  let post = c.presign_post_object(s3.PutObjectRequest{bucket: bucket, key: "posted.txt"}, expires: 5m)?
  var parts: List[multipart.Part] = []
  for (k, v) in post.fields {
    parts.push(multipart.Part{name: k, filename: None, headers: {}, data: v.bytes()})
  }
  parts.push(multipart.Part{name: "file", filename: "posted.txt", headers: {"Content-Type": "text/plain"}, data: b"sent by form"})
  let boundary = multipart.random_boundary(os.rand)
  let form = http.new_request("POST", post.url, {"Content-Type": multipart.form_data_content_type(boundary)}, multipart.write(parts, boundary))
  let posted = plain.send(form)?
  expect(posted.status >= 200 && posted.status < 300) == true
  expect(c.get_object(s3.GetObjectRequest{bucket: bucket, key: "posted.txt"})?.body) == Some(b"sent by form")
  c.delete_object(s3.DeleteObjectRequest{bucket: bucket, key: "posted.txt"})?
  // three more objects, listed one per page
  for k in ["p/1", "p/2", "p/3"] {
    c.put_object(s3.PutObjectRequest{bucket: bucket, key: k, body: b"x"})?
  }
  var pages = s3.new_list_objects_v2_paginator(c, s3.ListObjectsV2Request{bucket: bucket, prefix: "p/", max_keys: 1})
  var seen: List[Str] = []
  var n = 0
  while pages.has_more_pages() {
    let page = pages.next_page()?
    n += 1
    for o in page.contents ?? [] {
      seen.push(o.key ?? "")
    }
  }
  expect(seen) == ["p/1", "p/2", "p/3"]
  expect(n) == 3
  for k in ["p/1", "p/2", "p/3"] {
    c.delete_object(s3.DeleteObjectRequest{bucket: bucket, key: k})?
  }
  c.delete_object(s3.DeleteObjectRequest{bucket: bucket, key: "dir/hello world.txt"})?
  c.delete_bucket(s3.DeleteBucketRequest{bucket: bucket})?
  s3.wait_until_bucket_not_exists(c, s3.HeadBucketRequest{bucket: bucket}, 30s, min_delay: 1s, max_delay: 2s)?
}
