    match k {
      "type" => out.type_value = IntegrationType.from(jsonv.read_str(fv)?)
      "httpMethod" => out.http_method = jsonv.read_str(fv)?
      "uri" => out.uri = jsonv.read_str(fv)?
      "connectionType" => out.connection_type = ConnectionType.from(jsonv.read_str(fv)?)
      "connectionId" => out.connection_id = jsonv.read_str(fv)?
      "credentials" => out.credentials = jsonv.read_str(fv)?
      "requestParameters" => out.request_parameters = from_json_map_of_string_to_string(fv)?
      "requestTemplates" => out.request_templates = from_json_map_of_string_to_string(fv)?
      "passthroughBehavior" => out.passthrough_behavior = jsonv.read_str(fv)?
      "contentHandling" => out.content_handling = ContentHandlingStrategy.from(jsonv.read_str(fv)?)
      "timeoutInMillis" => out.timeout_in_millis = jsonv.read_int(fv)?
      "cacheNamespace" => out.cache_namespace = jsonv.read_str(fv)?
      "cacheKeyParameters" => out.cache_key_parameters = from_json_list_of_string(fv)?
      "integrationResponses" => out.integration_responses = from_json_map_of_integration_response(fv)?
      "tlsConfig" => out.tls_config = from_json_tls_config(fv)?
      "responseTransferMode" => out.response_transfer_mode = ResponseTransferMode.from(jsonv.read_str(fv)?)
      "integrationTarget" => out.integration_target = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

