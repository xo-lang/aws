  pub s3_uri: Str? = None
}

/// Override configuration
pub struct OverrideConfiguration {
  pub document: DocumentOverrideConfiguration? = None
  pub image: ImageOverrideConfiguration? = None
  pub video: VideoOverrideConfiguration? = None
  pub audio: AudioOverrideConfiguration? = None
  pub modality_routing: ModalityRoutingConfiguration? = None
}

/// Configuration for PII entities detection and redaction
pub struct PIIEntitiesConfiguration {
  /// Types of PII entities to detect
  pub pii_entity_types: List[PIIEntityType]? = None
  /// Mode for redacting detected PII
  pub redaction_mask_mode: PIIRedactionMaskMode? = None
}

/// Types of PII entities that can be detected, we will support every types
/// that Guardrails can support
pub enum PIIEntityType: Str {
  All = "ALL"
  Address = "ADDRESS"
  Age = "AGE"
  Name = "NAME"
  Email = "EMAIL"
  Phone = "PHONE"
  Username = "USERNAME"
  Password = "PASSWORD"
  DriverId = "DRIVER_ID"
  LicensePlate = "LICENSE_PLATE"
  VehicleIdentificationNumber = "VEHICLE_IDENTIFICATION_NUMBER"
  CreditDebitCardCvv = "CREDIT_DEBIT_CARD_CVV"
  CreditDebitCardExpiry = "CREDIT_DEBIT_CARD_EXPIRY"
  CreditDebitCardNumber = "CREDIT_DEBIT_CARD_NUMBER"
  Pin = "PIN"
  InternationalBankAccountNumber = "INTERNATIONAL_BANK_ACCOUNT_NUMBER"
  SwiftCode = "SWIFT_CODE"
  IpAddress = "IP_ADDRESS"
  MacAddress = "MAC_ADDRESS"
  Url = "URL"
  AwsAccessKey = "AWS_ACCESS_KEY"
  AwsSecretKey = "AWS_SECRET_KEY"
  UsBankAccountNumber = "US_BANK_ACCOUNT_NUMBER"
  UsBankRoutingNumber = "US_BANK_ROUTING_NUMBER"
  UsIndividualTaxIdentificationNumber = "US_INDIVIDUAL_TAX_IDENTIFICATION_NUMBER"
  UsPassportNumber = "US_PASSPORT_NUMBER"
  UsSocialSecurityNumber = "US_SOCIAL_SECURITY_NUMBER"
  CaHealthNumber = "CA_HEALTH_NUMBER"
  CaSocialInsuranceNumber = "CA_SOCIAL_INSURANCE_NUMBER"
  UkNationalHealthServiceNumber = "UK_NATIONAL_HEALTH_SERVICE_NUMBER"
  UkNationalInsuranceNumber = "UK_NATIONAL_INSURANCE_NUMBER"
  UkUniqueTaxpayerReferenceNumber = "UK_UNIQUE_TAXPAYER_REFERENCE_NUMBER"
  Unknown(value: Str)
}

/// Mode for redacting detected PII
pub enum PIIRedactionMaskMode: Str {
  Pii = "PII"
  EntityType = "ENTITY_TYPE"
  Unknown(value: Str)
}

/// Phrase structure for vocabulary
pub struct Phrase {
  pub text: Str? = None
  pub display_as_text: Str? = None
}

/// This exception is thrown when a resource referenced by the operation
/// does not exist
pub struct ResourceNotFoundException {
  pub message: Str? = None
}

/// Resource Owner
pub enum ResourceOwner: Str {
  Service = "SERVICE"
  Account = "ACCOUNT"
  Unknown(value: Str)
}

/// S3 object
pub struct S3Object {
  /// S3 uri.
  pub s3_uri: Str? = None
  /// S3 object version.
  pub version: Str? = None
}

/// Configuration for sensitive data detection and redaction
pub struct SensitiveDataConfiguration {
  /// Mode for sensitive data detection
  pub detection_mode: SensitiveDataDetectionMode? = None
  /// Scope of detection - what types of sensitive data to detect
  pub detection_scope: List[SensitiveDataDetectionScopeType]? = None
  /// Configuration for PII entities detection and redaction
  pub pii_entities_configuration: PIIEntitiesConfiguration? = None
}

/// Mode for sensitive data detection
pub enum SensitiveDataDetectionMode: Str {
  Detection = "DETECTION"
  DetectionAndRedaction = "DETECTION_AND_REDACTION"
  Unknown(value: Str)
}

/// Types of sensitive data detection scope
pub enum SensitiveDataDetectionScopeType: Str {
  Standard = "STANDARD"
  Custom = "CUSTOM"
  Unknown(value: Str)
}

/// This exception is thrown when a request is made beyond the service quota
pub struct ServiceQuotaExceededException {
  pub message: Str? = None
}

/// Speaker labeling configuration
pub struct SpeakerLabelingConfiguration {
  pub state: State? = None
}

/// Configuration of Splitter
pub struct SplitterConfiguration {
  pub state: State? = None
}

/// Standard output configuration
pub struct StandardOutputConfiguration {
  pub document: DocumentStandardOutputConfiguration? = None
  pub image: ImageStandardOutputConfiguration? = None
  pub video: VideoStandardOutputConfiguration? = None
  pub audio: AudioStandardOutputConfiguration? = None
}

/// State
pub enum State: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Unknown(value: Str)
}

/// Key value pair of a tag
pub struct Tag {
  pub key: Str? = None
  pub value: Str? = None
}

pub struct TagResourceRequest {
  pub resource_arn: Str? = None
  pub tags: List[Tag]? = None
}

pub struct TagResourceResponse {
}

/// This exception is thrown when the number of requests exceeds the limit
pub struct ThrottlingException {
  pub message: Str? = None
}

/// Configuration for transcript related features
pub struct TranscriptConfiguration {
  pub speaker_labeling: SpeakerLabelingConfiguration? = None
  pub channel_labeling: ChannelLabelingConfiguration? = None
}

/// Type
pub enum Type: Str {
  Document = "DOCUMENT"
  Image = "IMAGE"
  Audio = "AUDIO"
  Video = "VIDEO"
  Unknown(value: Str)
}

pub struct UntagResourceRequest {
  pub resource_arn: Str? = None
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

/// Update Blueprint Request
pub struct UpdateBlueprintRequest {
  /// ARN generated at the server side when a Blueprint is created
  pub blueprint_arn: Str? = None
  pub schema: Str? = None
  pub blueprint_stage: BlueprintStage? = None
  pub encryption_configuration: EncryptionConfiguration? = None
}

/// Update Blueprint Response
pub struct UpdateBlueprintResponse {
  pub blueprint: Blueprint? = None
}

/// Update DataAutomationLibrary Request
pub struct UpdateDataAutomationLibraryRequest {
  /// ARN generated at the server side when a DataAutomationLibrary is created
  pub library_arn: Str? = None
  pub library_description: Str? = None
  pub client_token: Str? = None
}

/// Update DataAutomationLibrary Response
pub struct UpdateDataAutomationLibraryResponse {
  pub library_arn: Str? = None
  pub status: DataAutomationLibraryStatus? = None
}

/// Update DataAutomationProject Request
pub struct UpdateDataAutomationProjectRequest {
  /// ARN generated at the server side when a DataAutomationProject is created
  pub project_arn: Str? = None
  pub project_stage: DataAutomationProjectStage? = None
  pub project_description: Str? = None
  pub standard_output_configuration: StandardOutputConfiguration? = None
  pub custom_output_configuration: CustomOutputConfiguration? = None
  pub override_configuration: OverrideConfiguration? = None
  pub data_automation_library_configuration: DataAutomationLibraryConfiguration? = None
  pub encryption_configuration: EncryptionConfiguration? = None
}

/// Update DataAutomationProject Response
pub struct UpdateDataAutomationProjectResponse {
  pub project_arn: Str? = None
  pub project_stage: DataAutomationProjectStage? = None
  pub status: DataAutomationProjectStatus? = None
}

/// Input configuration for upserting data in a
/// DataAutomationLibraryIngestionJob
pub enum UpsertEntityInfo {
  Vocabulary(value: VocabularyEntityInfo)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// This exception is thrown when the request's input validation fails
pub struct ValidationException {
  pub message: Str? = None
  pub field_list: List[ValidationExceptionField]? = None
}

/// Stores information about a field passed inside a request that resulted
/// in an exception
pub struct ValidationExceptionField {
  pub name: Str? = None
  pub message: Str? = None
}

/// Bounding Box Configuration of Video Extraction
pub struct VideoBoundingBox {
  pub state: State? = None
}

/// Category of Video Extraction
pub struct VideoExtractionCategory {
  pub state: State? = None
  pub types: List[VideoExtractionCategoryType]? = None
}

pub enum VideoExtractionCategoryType: Str {
  ContentModeration = "CONTENT_MODERATION"
  TextDetection = "TEXT_DETECTION"
  Transcript = "TRANSCRIPT"
  Logos = "LOGOS"
  Unknown(value: Str)
}

/// Override Configuration of Video
pub struct VideoOverrideConfiguration {
  pub modality_processing: ModalityProcessingConfiguration? = None
  pub sensitive_data_configuration: SensitiveDataConfiguration? = None
}

/// Standard Extraction Configuration of Video
pub struct VideoStandardExtraction {
  pub category: VideoExtractionCategory? = None
  pub bounding_box: VideoBoundingBox? = None
}

/// Standard Generative Field Configuration of Video
pub struct VideoStandardGenerativeField {
  pub state: State? = None
  pub types: List[VideoStandardGenerativeFieldType]? = None
}

pub enum VideoStandardGenerativeFieldType: Str {
  VideoSummary = "VIDEO_SUMMARY"
  Iab = "IAB"
  ChapterSummary = "CHAPTER_SUMMARY"
  Unknown(value: Str)
}

/// Standard Output Configuration of Video
pub struct VideoStandardOutputConfiguration {
  pub extraction: VideoStandardExtraction? = None
  pub generative_field: VideoStandardGenerativeField? = None
}

/// Vocabulary entity with detailed information
pub struct VocabularyEntity {
  pub entity_id: Str? = None
  pub description: Str? = None
  pub language: Language? = None
  pub phrases: List[Phrase]? = None
  pub last_modified_time: Time? = None
}

/// Vocabulary entity info with detailed information
pub struct VocabularyEntityInfo {
  pub entity_id: Str? = None
  pub description: Str? = None
  pub language: Language? = None
  pub phrases: List[Phrase]? = None
}

/// Summary of a Vocabulary entity
pub struct VocabularyEntitySummary {
  pub entity_id: Str? = None
  pub description: Str? = None
  pub language: Language? = None
  /// num of phrases in the entity
  pub num_of_phrases: Int? = None
  pub last_modified_time: Time? = None
}
