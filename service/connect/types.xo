/// Contains information about a contact.
pub struct Contact {
  /// The Amazon Resource Name (ARN) for the contact.
  pub arn: Str? = None
  /// The identifier for the contact.
  pub id: Str? = None
  /// If this contact is related to other contacts, this is the ID of the
  /// initial contact.
  pub initial_contact_id: Str? = None
  /// If this contact is not the first contact, this is the ID of the previous
  /// contact.
  pub previous_contact_id: Str? = None
  /// This is the root contactId which is used as a unique identifier for all
  /// subsequent contacts in a contact tree.
  pub contact_association_id: Str? = None
  /// Indicates how the contact was initiated.
  pub initiation_method: ContactInitiationMethod? = None
  /// The name of the contact.
  pub name: Str? = None
  /// The description of the contact.
  pub description: Str? = None
  /// How the contact reached your contact center.
  pub channel: Channel? = None
  /// If this contact was queued, this contains information about the queue.
  pub queue_info: QueueInfo? = None
  /// Information about the agent who accepted the contact.
  pub agent_info: AgentInfo? = None
  /// The date and time this contact was initiated, in UTC time. For INBOUND ,
  /// this is when the contact arrived. For OUTBOUND , this is when the agent
  /// began dialing. For CALLBACK , this is when the callback contact was
  /// created. For TRANSFER and QUEUE_TRANSFER , this is when the transfer was
  /// initiated. For API , this is when the request arrived. For
  /// EXTERNAL_OUTBOUND , this is when the agent started dialing the external
  /// participant. For MONITOR , this is when the supervisor started listening
  /// to a contact.
  pub initiation_timestamp: Time? = None
  /// The date and time that the customer endpoint disconnected from the
  /// current contact, in UTC time. In transfer scenarios, the
  /// DisconnectTimestamp of the previous contact indicates the date and time
  /// when that contact ended.
  pub disconnect_timestamp: Time? = None
  /// The timestamp when contact was last updated.
  pub last_update_timestamp: Time? = None
  /// The timestamp when the contact was last paused.
  pub last_paused_timestamp: Time? = None
  /// The timestamp when the contact was last resumed.
  pub last_resumed_timestamp: Time? = None
  /// The timestamp when ringing started for a campaign call.
  pub ring_start_timestamp: Time? = None
  /// Total pause count for a contact.
  pub total_pause_count: Int? = None
  /// Total pause duration for a contact in seconds.
  pub total_pause_duration_in_seconds: Int? = None
  /// The timestamp, in Unix epoch time format, at which to start running the
  /// inbound flow.
  pub scheduled_timestamp: Time? = None
  /// The contactId that is related to this contact.
  pub related_contact_id: Str? = None
  /// Information about Connect Customer Wisdom.
  pub wisdom_info: WisdomInfo? = None
  /// The customer's identification number. For example, the CustomerId may be
  /// a customer number from your CRM. You can create a Lambda function to
  /// pull the unique customer ID of the caller from your CRM system. If you
  /// enable Connect Customer Voice ID capability, this attribute is populated
  /// with the CustomerSpeakerId of the caller.
  pub customer_id: Str? = None
  /// The customer or external third party participant endpoint.
  pub customer_endpoint: EndpointInfo? = None
  /// The system endpoint. For INBOUND , this is the phone number or email
  /// address that the customer dialed. For OUTBOUND and EXTERNAL_OUTBOUND ,
  /// this is the outbound caller ID number assigned to the outbound queue
  /// that is used to dial the customer. For callback, this shows up as
  /// Softphone for calls handled by agents with softphone.
  pub system_endpoint: EndpointInfo? = None
  /// An integer that represents the queue time adjust to be applied to the
  /// contact, in seconds (longer / larger queue time are routed
  /// preferentially). Cannot be specified if the QueuePriority is specified.
  /// Must be statically defined and a valid integer value.
  pub queue_time_adjustment_seconds: Int? = None
  /// An integer that represents the queue priority to be applied to the
  /// contact (lower priorities are routed preferentially). Cannot be
  /// specified if the QueueTimeAdjustmentSeconds is specified. Must be
  /// statically defined, must be larger than zero, and a valid integer value.
  /// Default Value is 5.
  pub queue_priority: Int? = None
  /// Tags associated with the contact. This contains both Amazon Web Services
  /// generated and user-defined tags.
  pub tags: Map[Str, Str]? = None
  /// The timestamp when customer endpoint connected to Connect Customer.
  pub connected_to_system_timestamp: Time? = None
  /// Latest routing criteria on the contact.
  pub routing_criteria: RoutingCriteria? = None
  /// Information about the Customer on the contact.
  pub customer: Customer? = None
  pub campaign: Campaign? = None
  /// Indicates how an outbound campaign call is actually disposed if the
  /// contact is connected to Connect Customer.
  pub answering_machine_detection_status: AnsweringMachineDetectionStatus? = None
  /// Information about customer’s voice activity.
  pub customer_voice_activity: CustomerVoiceActivity? = None
  /// Information about the quality of the participant's media connection.
  pub quality_metrics: QualityMetrics? = None
  /// Information about how agent, bot, and customer interact in a chat
  /// contact.
  pub chat_metrics: ChatMetrics? = None
  /// Information about the call disconnect experience.
  pub disconnect_details: DisconnectDetails? = None
  /// List of additional email addresses for an email contact.
  pub additional_email_recipients: AdditionalEmailRecipients? = None
  /// A set of system defined key-value pairs stored on individual contact
  /// segments using an attribute map. The attributes are standard Connect
  /// Customer attributes and can be accessed in flows. Attribute keys can
  /// include only alphanumeric, -, and _ characters. This field can be used
  /// to show channel subtype. For example, connect:Guide or connect:SMS .
  pub segment_attributes: Map[Str, SegmentAttributeValue]? = None
  /// If recording was enabled, this is information about the recordings.
  pub recordings: List[RecordingInfo]? = None
  /// The disconnect reason for the contact. For a list and description of all
  /// the possible disconnect reasons by channel, see DisconnectReason under
  /// ContactTraceRecord in the Connect Customer Administrator Guide .
  pub disconnect_reason: Str? = None
  /// Information about the contact evaluations where the key is the FormId,
  /// which is a unique identifier for the form.
  pub contact_evaluations: Map[Str, ContactEvaluation]? = None
  /// If this contact was created using a task template, this contains
  /// information about the task template.
  pub task_template_info: TaskTemplateInfoV2? = None
  /// A map of string key/value pairs that contain user-defined attributes
  /// which are lightly typed within the contact. This object is used only for
  /// task contacts.
  pub contact_details: ContactDetails? = None
  /// Information about the outbound strategy.
  pub outbound_strategy: OutboundStrategy? = None
  /// The attributes of the contact.
  pub attributes: Map[Str, Str]? = None
  /// List of next contact entries for the contact.
  pub next_contacts: List[NextContactEntry]? = None
  /// Information about the global resiliency configuration for the contact,
  /// including traffic distribution details.
  pub global_resiliency_metadata: GlobalResiliencyMetadata? = None
}

