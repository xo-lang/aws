  /// fr_FR , id_ID , it_IT , ja_JP , ko_KR , pt_BR , zh_CN , zh_TW
  pub language: Str? = None
  /// The source configuration summary of the message template.
  pub source_configuration_summary: MessageTemplateSourceConfigurationSummary? = None
  pub grouping_configuration: GroupingConfiguration? = None
  /// An object that specifies the default values to use for variables in the
  /// message template. This object contains different categories of key-value
  /// pairs. Each key defines a variable or placeholder in the message
  /// template. The corresponding value defines the default value for that
  /// variable.
  pub default_attributes: MessageTemplateAttributes? = None
  /// The types of attributes contain the message template.
  pub attribute_types: List[Str]? = None
  /// The message template attachments.
  pub attachments: List[MessageTemplateAttachment]? = None
  /// Whether the version of the message template is activated.
  pub is_active: Bool? = None
  /// The version number of the message template version.
  pub version_number: Int? = None
  /// The checksum value of the message template content that is referenced by
  /// the $LATEST qualifier. It can be returned in MessageTemplateData or
  /// ExtendedMessageTemplateData . It’s calculated by content, language,
  /// defaultAttributes and Attachments of the message template.
  pub message_template_content_sha256: Str? = None
