fn json_of_resource_details(v: ResourceDetails) -> json.Value {
  match v {
    LambdaFunction(x) => json.Value.Object([("lambdaFunction", json_of_lambda_function(x))])
    EcsService(x) => json.Value.Object([("ecsService", json_of_ecs_service(x))])
    Ec2Instance(x) => json.Value.Object([("ec2Instance", json_of_ec2_instance(x))])
    EbsVolume(x) => json.Value.Object([("ebsVolume", json_of_ebs_volume(x))])
    Ec2AutoScalingGroup(x) => json.Value.Object([("ec2AutoScalingGroup", json_of_ec2_auto_scaling_group(x))])
    Ec2ReservedInstances(x) => json.Value.Object([("ec2ReservedInstances", json_of_ec2_reserved_instances(x))])
    RdsReservedInstances(x) => json.Value.Object([("rdsReservedInstances", json_of_rds_reserved_instances(x))])
    ElastiCacheReservedInstances(x) => json.Value.Object([("elastiCacheReservedInstances", json_of_elasti_cache_reserved_instances(x))])
    OpenSearchReservedInstances(x) => json.Value.Object([("openSearchReservedInstances", json_of_open_search_reserved_instances(x))])
    RedshiftReservedInstances(x) => json.Value.Object([("redshiftReservedInstances", json_of_redshift_reserved_instances(x))])
    Ec2InstanceSavingsPlans(x) => json.Value.Object([("ec2InstanceSavingsPlans", json_of_ec2_instance_savings_plans(x))])
    ComputeSavingsPlans(x) => json.Value.Object([("computeSavingsPlans", json_of_compute_savings_plans(x))])
    SageMakerSavingsPlans(x) => json.Value.Object([("sageMakerSavingsPlans", json_of_sage_maker_savings_plans(x))])
    RdsDbInstance(x) => json.Value.Object([("rdsDbInstance", json_of_rds_db_instance(x))])
    RdsDbInstanceStorage(x) => json.Value.Object([("rdsDbInstanceStorage", json_of_rds_db_instance_storage(x))])
    AuroraDbClusterStorage(x) => json.Value.Object([("auroraDbClusterStorage", json_of_aurora_db_cluster_storage(x))])
    DynamoDbReservedCapacity(x) => json.Value.Object([("dynamoDbReservedCapacity", json_of_dynamo_db_reserved_capacity(x))])
    MemoryDbReservedInstances(x) => json.Value.Object([("memoryDbReservedInstances", json_of_memory_db_reserved_instances(x))])
    NatGateway(x) => json.Value.Object([("natGateway", json_of_nat_gateway(x))])
    DynamoDbTable(x) => json.Value.Object([("dynamoDbTable", json_of_dynamo_db_table(x))])
    ElastiCacheCluster(x) => json.Value.Object([("elastiCacheCluster", json_of_elasti_cache_cluster(x))])
    MemoryDbCluster(x) => json.Value.Object([("memoryDbCluster", json_of_memory_db_cluster(x))])
    DocumentDbCluster(x) => json.Value.Object([("documentDbCluster", json_of_document_db_cluster(x))])
    WorkSpaces(x) => json.Value.Object([("workSpaces", json_of_work_spaces(x))])
    SageMakerEndpoint(x) => json.Value.Object([("sageMakerEndpoint", json_of_sage_maker_endpoint(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_resource_details(v: json.Value) -> ResourceDetails ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "lambdaFunction" => Ok(ResourceDetails.LambdaFunction(from_json_lambda_function(fv)?))
      "ecsService" => Ok(ResourceDetails.EcsService(from_json_ecs_service(fv)?))
      "ec2Instance" => Ok(ResourceDetails.Ec2Instance(from_json_ec2_instance(fv)?))
      "ebsVolume" => Ok(ResourceDetails.EbsVolume(from_json_ebs_volume(fv)?))
      "ec2AutoScalingGroup" => Ok(ResourceDetails.Ec2AutoScalingGroup(from_json_ec2_auto_scaling_group(fv)?))
      "ec2ReservedInstances" => Ok(ResourceDetails.Ec2ReservedInstances(from_json_ec2_reserved_instances(fv)?))
      "rdsReservedInstances" => Ok(ResourceDetails.RdsReservedInstances(from_json_rds_reserved_instances(fv)?))
      "elastiCacheReservedInstances" => Ok(ResourceDetails.ElastiCacheReservedInstances(from_json_elasti_cache_reserved_instances(fv)?))
      "openSearchReservedInstances" => Ok(ResourceDetails.OpenSearchReservedInstances(from_json_open_search_reserved_instances(fv)?))
      "redshiftReservedInstances" => Ok(ResourceDetails.RedshiftReservedInstances(from_json_redshift_reserved_instances(fv)?))
      "ec2InstanceSavingsPlans" => Ok(ResourceDetails.Ec2InstanceSavingsPlans(from_json_ec2_instance_savings_plans(fv)?))
      "computeSavingsPlans" => Ok(ResourceDetails.ComputeSavingsPlans(from_json_compute_savings_plans(fv)?))
      "sageMakerSavingsPlans" => Ok(ResourceDetails.SageMakerSavingsPlans(from_json_sage_maker_savings_plans(fv)?))
      "rdsDbInstance" => Ok(ResourceDetails.RdsDbInstance(from_json_rds_db_instance(fv)?))
      "rdsDbInstanceStorage" => Ok(ResourceDetails.RdsDbInstanceStorage(from_json_rds_db_instance_storage(fv)?))
      "auroraDbClusterStorage" => Ok(ResourceDetails.AuroraDbClusterStorage(from_json_aurora_db_cluster_storage(fv)?))
      "dynamoDbReservedCapacity" => Ok(ResourceDetails.DynamoDbReservedCapacity(from_json_dynamo_db_reserved_capacity(fv)?))
      "memoryDbReservedInstances" => Ok(ResourceDetails.MemoryDbReservedInstances(from_json_memory_db_reserved_instances(fv)?))
      "natGateway" => Ok(ResourceDetails.NatGateway(from_json_nat_gateway(fv)?))
      "dynamoDbTable" => Ok(ResourceDetails.DynamoDbTable(from_json_dynamo_db_table(fv)?))
      "elastiCacheCluster" => Ok(ResourceDetails.ElastiCacheCluster(from_json_elasti_cache_cluster(fv)?))
      "memoryDbCluster" => Ok(ResourceDetails.MemoryDbCluster(from_json_memory_db_cluster(fv)?))
      "documentDbCluster" => Ok(ResourceDetails.DocumentDbCluster(from_json_document_db_cluster(fv)?))
      "workSpaces" => Ok(ResourceDetails.WorkSpaces(from_json_work_spaces(fv)?))
      "sageMakerEndpoint" => Ok(ResourceDetails.SageMakerEndpoint(from_json_sage_maker_endpoint(fv)?))
      _ => Ok(ResourceDetails.Unknown(k))
    }
  }
  Err("ResourceDetails: no member set")
}

