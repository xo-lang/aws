fn xml_write_db_instance(var w: xmlv.Writer, v: DBInstance, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.db_instance_identifier {
    xmlv.elem(w, "DBInstanceIdentifier", x, [])
  }
  if let Some(x) = v.db_instance_class {
    xmlv.elem(w, "DBInstanceClass", x, [])
  }
  if let Some(x) = v.engine {
    xmlv.elem(w, "Engine", x, [])
  }
  if let Some(x) = v.db_instance_status {
    xmlv.elem(w, "DBInstanceStatus", x, [])
  }
  if let Some(x) = v.endpoint {
    xml_write_endpoint(w, x, "Endpoint", [])
  }
  if let Some(x) = v.instance_create_time {
    xmlv.elem(w, "InstanceCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.preferred_backup_window {
    xmlv.elem(w, "PreferredBackupWindow", x, [])
  }
  if let Some(x) = v.backup_retention_period {
    xmlv.elem(w, "BackupRetentionPeriod", "${x}", [])
  }
  if let Some(x) = v.vpc_security_groups {
    xml_write_vpc_security_group_membership_list(w, x, "VpcSecurityGroups", [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "AvailabilityZone", x, [])
  }
  if let Some(x) = v.db_subnet_group {
    xml_write_db_subnet_group(w, x, "DBSubnetGroup", [])
  }
  if let Some(x) = v.preferred_maintenance_window {
    xmlv.elem(w, "PreferredMaintenanceWindow", x, [])
  }
  if let Some(x) = v.pending_modified_values {
    xml_write_pending_modified_values(w, x, "PendingModifiedValues", [])
  }
  if let Some(x) = v.latest_restorable_time {
    xmlv.elem(w, "LatestRestorableTime", rest.date_time(x), [])
  }
  if let Some(x) = v.engine_version {
    xmlv.elem(w, "EngineVersion", x, [])
  }
  if let Some(x) = v.auto_minor_version_upgrade {
    xmlv.elem(w, "AutoMinorVersionUpgrade", "${x}", [])
  }
  if let Some(x) = v.publicly_accessible {
    xmlv.elem(w, "PubliclyAccessible", "${x}", [])
  }
  if let Some(x) = v.status_infos {
    xml_write_db_instance_status_info_list(w, x, "StatusInfos", [])
  }
  if let Some(x) = v.db_cluster_identifier {
    xmlv.elem(w, "DBClusterIdentifier", x, [])
  }
  if let Some(x) = v.storage_encrypted {
    xmlv.elem(w, "StorageEncrypted", "${x}", [])
  }
  if let Some(x) = v.kms_key_id {
    xmlv.elem(w, "KmsKeyId", x, [])
  }
  if let Some(x) = v.dbi_resource_id {
    xmlv.elem(w, "DbiResourceId", x, [])
  }
  if let Some(x) = v.ca_certificate_identifier {
    xmlv.elem(w, "CACertificateIdentifier", x, [])
  }
  if let Some(x) = v.copy_tags_to_snapshot {
    xmlv.elem(w, "CopyTagsToSnapshot", "${x}", [])
  }
  if let Some(x) = v.promotion_tier {
    xmlv.elem(w, "PromotionTier", "${x}", [])
  }
  if let Some(x) = v.db_instance_arn {
    xmlv.elem(w, "DBInstanceArn", x, [])
  }
  if let Some(x) = v.enabled_cloudwatch_logs_exports {
    xml_write_log_type_list(w, x, "EnabledCloudwatchLogsExports", [])
  }
  if let Some(x) = v.certificate_details {
    xml_write_certificate_details(w, x, "CertificateDetails", [])
  }
  if let Some(x) = v.performance_insights_enabled {
    xmlv.elem(w, "PerformanceInsightsEnabled", "${x}", [])
  }
  if let Some(x) = v.performance_insights_kms_key_id {
    xmlv.elem(w, "PerformanceInsightsKMSKeyId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_db_instance(e: xml.Element) -> DBInstance ! Str {
  var out = DBInstance{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DBInstanceIdentifier" => out.db_instance_identifier = c.text()
      "DBInstanceClass" => out.db_instance_class = c.text()
      "Engine" => out.engine = c.text()
      "DBInstanceStatus" => out.db_instance_status = c.text()
      "Endpoint" => out.endpoint = xml_read_endpoint(c)?
      "InstanceCreateTime" => out.instance_create_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PreferredBackupWindow" => out.preferred_backup_window = c.text()
      "BackupRetentionPeriod" => out.backup_retention_period = xmlv.read_int(c.text())?
      "VpcSecurityGroups" => out.vpc_security_groups = xml_read_vpc_security_group_membership_list(c)?
      "AvailabilityZone" => out.availability_zone = c.text()
      "DBSubnetGroup" => out.db_subnet_group = xml_read_db_subnet_group(c)?
      "PreferredMaintenanceWindow" => out.preferred_maintenance_window = c.text()
      "PendingModifiedValues" => out.pending_modified_values = xml_read_pending_modified_values(c)?
      "LatestRestorableTime" => out.latest_restorable_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EngineVersion" => out.engine_version = c.text()
      "AutoMinorVersionUpgrade" => out.auto_minor_version_upgrade = xmlv.read_bool(c.text())?
      "PubliclyAccessible" => out.publicly_accessible = xmlv.read_bool(c.text())?
      "StatusInfos" => out.status_infos = xml_read_db_instance_status_info_list(c)?
      "DBClusterIdentifier" => out.db_cluster_identifier = c.text()
      "StorageEncrypted" => out.storage_encrypted = xmlv.read_bool(c.text())?
      "KmsKeyId" => out.kms_key_id = c.text()
      "DbiResourceId" => out.dbi_resource_id = c.text()
      "CACertificateIdentifier" => out.ca_certificate_identifier = c.text()
      "CopyTagsToSnapshot" => out.copy_tags_to_snapshot = xmlv.read_bool(c.text())?
      "PromotionTier" => out.promotion_tier = xmlv.read_int(c.text())?
      "DBInstanceArn" => out.db_instance_arn = c.text()
      "EnabledCloudwatchLogsExports" => out.enabled_cloudwatch_logs_exports = xml_read_log_type_list(c)?
      "CertificateDetails" => out.certificate_details = xml_read_certificate_details(c)?
      "PerformanceInsightsEnabled" => out.performance_insights_enabled = xmlv.read_bool(c.text())?
      "PerformanceInsightsKMSKeyId" => out.performance_insights_kms_key_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

