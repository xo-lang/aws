fn json_of_participant(v: Participant) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.participant_id {
    fs.push(("participantId", json.Value.Str(x)))
  }
  if let Some(x) = v.user_id {
    fs.push(("userId", json.Value.Str(x)))
  }
  if let Some(x) = v.state {
    fs.push(("state", json.Value.Str(x)))
  }
  if let Some(x) = v.first_join_time {
    fs.push(("firstJoinTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.attributes {
    fs.push(("attributes", json_of_participant_attributes(x)))
  }
  if let Some(x) = v.published {
    fs.push(("published", json.Value.Bool(x)))
  }
  if let Some(x) = v.isp_name {
    fs.push(("ispName", json.Value.Str(x)))
  }
  if let Some(x) = v.os_name {
    fs.push(("osName", json.Value.Str(x)))
  }
  if let Some(x) = v.os_version {
    fs.push(("osVersion", json.Value.Str(x)))
  }
  if let Some(x) = v.browser_name {
    fs.push(("browserName", json.Value.Str(x)))
  }
