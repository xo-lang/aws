/// Attaches one or more EC2 instances to the specified Auto Scaling group.
/// When you attach instances, Amazon EC2 Auto Scaling increases the desired
/// capacity of the group by the number of instances being attached. If the
/// number of instances being attached plus the desired capacity of the
/// group exceeds the maximum size of the group, the operation fails. If
/// there is a Classic Load Balancer attached to your Auto Scaling group,
/// the instances are also registered with the load balancer. If there are
/// target groups attached to your Auto Scaling group, the instances are
/// also registered with the target groups. For more information, see Detach
/// or attach instances in the Amazon EC2 Auto Scaling User Guide .
pub fn (c: Client) attach_instances(input: AttachInstancesQuery) -> () ! AttachInstancesErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_attach_instances(c.params, input)) ?? e => return Err(AttachInstancesErr.InvalidInput(e))
  var req = serialize_attach_instances(ep, input, "") ?? e => return Err(AttachInstancesErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(AttachInstancesErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_attach_instances_error(resp))
  }
  deserialize_attach_instances(resp) ?? e => Err(AttachInstancesErr.Deserialize(e))
}

