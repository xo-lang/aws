    fs.push(("invitationId", json.Value.Str(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/detector/${rest.escape(label_detector_id, false)}/administrator"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
