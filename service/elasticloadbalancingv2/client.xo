  }
  if let Some(x) = v.port {
    xmlv.elem(w, "Port", "${x}", [])
  }
  if let Some(x) = v.vpc_id {
    xmlv.elem(w, "VpcId", x, [])
  }
  if let Some(x) = v.health_check_protocol {
    xmlv.elem(w, "HealthCheckProtocol", x.value(), [])
  }
  if let Some(x) = v.health_check_port {
    xmlv.elem(w, "HealthCheckPort", x, [])
  }
  if let Some(x) = v.health_check_enabled {
    xmlv.elem(w, "HealthCheckEnabled", "${x}", [])
  }
  if let Some(x) = v.health_check_interval_seconds {
    xmlv.elem(w, "HealthCheckIntervalSeconds", "${x}", [])
  }
  if let Some(x) = v.health_check_timeout_seconds {
    xmlv.elem(w, "HealthCheckTimeoutSeconds", "${x}", [])
  }
  if let Some(x) = v.healthy_threshold_count {
    xmlv.elem(w, "HealthyThresholdCount", "${x}", [])
  }
  if let Some(x) = v.unhealthy_threshold_count {
    xmlv.elem(w, "UnhealthyThresholdCount", "${x}", [])
  }
  if let Some(x) = v.health_check_path {
    xmlv.elem(w, "HealthCheckPath", x, [])
  }
  if let Some(x) = v.matcher {
    xml_write_matcher(w, x, "Matcher", [])
  }
  if let Some(x) = v.load_balancer_arns {
    xml_write_load_balancer_arns(w, x, "LoadBalancerArns", [])
  }
  if let Some(x) = v.target_type {
    xmlv.elem(w, "TargetType", x.value(), [])
  }
  if let Some(x) = v.protocol_version {
    xmlv.elem(w, "ProtocolVersion", x, [])
  }
  if let Some(x) = v.ip_address_type {
    xmlv.elem(w, "IpAddressType", x.value(), [])
  }
  if let Some(x) = v.target_control_port {
    xmlv.elem(w, "TargetControlPort", "${x}", [])
  }
  xmlv.end(w, name)
