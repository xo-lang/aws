/// Represents a request to the update device pool operation.
pub struct UpdateDevicePoolRequest {
  /// The Amazon Resource Name (ARN) of the Device Farm device pool to update.
  pub arn: Str? = None
  /// A string that represents the name of the device pool to update.
  pub name: Str? = None
  /// A description of the device pool to update.
  pub description: Str? = None
  /// Represents the rules to modify for the device pool. Updating rules is
  /// optional. If you update rules for your request, the update replaces the
  /// existing rules.
  pub rules: List[Rule]? = None
  /// The number of devices that Device Farm can add to your device pool.
  /// Device Farm adds devices that are available and that meet the criteria
  /// that you assign for the rules parameter. Depending on how many devices
  /// meet these constraints, your device pool might contain fewer devices
  /// than the value for this parameter. By specifying the maximum number of
  /// devices, you can control the costs that you incur by running tests. If
  /// you use this parameter in your request, you cannot use the
  /// clearMaxDevices parameter in the same request.
  pub max_devices: Int? = None
  /// Sets whether the maxDevices parameter applies to your device pool. If
  /// you set this parameter to true , the maxDevices parameter does not
  /// apply, and Device Farm does not limit the number of devices that it adds
  /// to your device pool. In this case, Device Farm adds all available
  /// devices that meet the criteria specified in the rules parameter. If you
  /// use this parameter in your request, you cannot use the maxDevices
  /// parameter in the same request.
  pub clear_max_devices: Bool? = None
}

/// Represents the result of an update device pool request.
pub struct UpdateDevicePoolResult {
  /// The device pool you just updated.
  pub device_pool: DevicePool? = None
}

pub struct UpdateInstanceProfileRequest {
  /// The Amazon Resource Name (ARN) of the instance profile.
  pub arn: Str? = None
  /// The updated name for your instance profile.
  pub name: Str? = None
  /// The updated description for your instance profile.
  pub description: Str? = None
  /// The updated choice for whether you want to specify package cleanup. The
  /// default value is false for private devices.
  pub package_cleanup: Bool? = None
  /// An array of strings that specifies the list of app packages that should
  /// not be cleaned up from the device after a test run is over. The list of
  /// packages is only considered if you set packageCleanup to true .
  pub exclude_app_packages_from_cleanup: List[Str]? = None
  /// The updated choice for whether you want to reboot the device after use.
  /// The default value is true .
  pub reboot_after_use: Bool? = None
}

pub struct UpdateInstanceProfileResult {
  /// An object that contains information about your instance profile.
  pub instance_profile: InstanceProfile? = None
}

pub struct UpdateNetworkProfileRequest {
  /// The Amazon Resource Name (ARN) of the project for which you want to
  /// update network profile settings.
  pub arn: Str? = None
  /// The name of the network profile about which you are returning
  /// information.
  pub name: Str? = None
  /// The description of the network profile about which you are returning
  /// information.
  pub description: Str? = None
  /// The type of network profile to return information about. Valid values
  /// are listed here.
  pub type_value: NetworkProfileType? = None
  /// The data throughput rate in bits per second, as an integer from 0 to
  /// 104857600.
  pub uplink_bandwidth_bits: Int? = None
  /// The data throughput rate in bits per second, as an integer from 0 to
  /// 104857600.
  pub downlink_bandwidth_bits: Int? = None
  /// Delay time for all packets to destination in milliseconds as an integer
  /// from 0 to 2000.
  pub uplink_delay_ms: Int? = None
  /// Delay time for all packets to destination in milliseconds as an integer
  /// from 0 to 2000.
  pub downlink_delay_ms: Int? = None
  /// Time variation in the delay of received packets in milliseconds as an
  /// integer from 0 to 2000.
  pub uplink_jitter_ms: Int? = None
  /// Time variation in the delay of received packets in milliseconds as an
  /// integer from 0 to 2000.
  pub downlink_jitter_ms: Int? = None
  /// Proportion of transmitted packets that fail to arrive from 0 to 100
  /// percent.
  pub uplink_loss_percent: Int? = None
  /// Proportion of received packets that fail to arrive from 0 to 100
  /// percent.
  pub downlink_loss_percent: Int? = None
}

pub struct UpdateNetworkProfileResult {
  /// A list of the available network profiles.
  pub network_profile: NetworkProfile? = None
}

/// Represents a request to the update project operation.
