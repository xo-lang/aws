  var out = S3CopyObjectOperation{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TargetResource" => out.target_resource = c.text()
      "CannedAccessControlList" => out.canned_access_control_list = S3CannedAccessControlList.from(c.text())
      "AccessControlGrants" => out.access_control_grants = xml_read_s3_grant_list(c)?
      "MetadataDirective" => out.metadata_directive = S3MetadataDirective.from(c.text())
      "AnnotationDirective" => out.annotation_directive = S3AnnotationDirective.from(c.text())
      "ModifiedSinceConstraint" => out.modified_since_constraint = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "NewObjectMetadata" => out.new_object_metadata = xml_read_s3_object_metadata(c)?
      "NewObjectTagging" => out.new_object_tagging = xml_read_s3_tag_set(c)?
      "RedirectLocation" => out.redirect_location = c.text()
