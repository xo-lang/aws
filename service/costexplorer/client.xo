fn json_of_expression(v: Expression) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.or {
    fs.push(("Or", json_of_expressions(x)))
  }
  if let Some(x) = v.and {
    fs.push(("And", json_of_expressions(x)))
  }
  if let Some(x) = v.not {
    fs.push(("Not", json_of_expression(x)))
  }
  if let Some(x) = v.dimensions {
    fs.push(("Dimensions", json_of_dimension_values(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_values(x)))
  }
  if let Some(x) = v.cost_categories {
    fs.push(("CostCategories", json_of_cost_category_values(x)))
  }
  if let Some(x) = v.product_attributes {
    fs.push(("ProductAttributes", json_of_product_attribute_values(x)))
  }
  json.Value.Object(fs)
}

fn from_json_expression(v: json.Value) -> Expression ! Str {
  var out = Expression{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Or" => out.or = from_json_expressions(fv)?
      "And" => out.and = from_json_expressions(fv)?
      "Not" => out.not = from_json_expression(fv)?
      "Dimensions" => out.dimensions = from_json_dimension_values(fv)?
      "Tags" => out.tags = from_json_tag_values(fv)?
      "CostCategories" => out.cost_categories = from_json_cost_category_values(fv)?
      "ProductAttributes" => out.product_attributes = from_json_product_attribute_values(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_expressions(v: List[Expression]) -> json.Value {
  json.Value.List(v.map(fn(x: Expression) -> json.Value { json_of_expression(x) }))
}

fn from_json_expressions(v: json.Value) -> List[Expression] ! Str {
  var out: List[Expression] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_expression(fv)?)
  }
  Ok(out)
}

