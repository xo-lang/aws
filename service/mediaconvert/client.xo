fn from_json_job(v: json.Value) -> Job ! Str {
  var out = Job{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "accelerationSettings" => out.acceleration_settings = from_json_acceleration_settings(fv)?
      "accelerationStatus" => out.acceleration_status = AccelerationStatus.from(jsonv.read_str(fv)?)
      "arn" => out.arn = jsonv.read_str(fv)?
      "billingTagsSource" => out.billing_tags_source = BillingTagsSource.from(jsonv.read_str(fv)?)
      "clientRequestToken" => out.client_request_token = jsonv.read_str(fv)?
      "createdAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "currentPhase" => out.current_phase = JobPhase.from(jsonv.read_str(fv)?)
      "elementalInferenceConfiguration" => out.elemental_inference_configuration = from_json_elemental_inference_configuration(fv)?
      "errorCode" => out.error_code = jsonv.read_int(fv)?
      "errorMessage" => out.error_message = jsonv.read_str(fv)?
      "hopDestinations" => out.hop_destinations = from_json_list_of_hop_destination(fv)?
      "id" => out.id = jsonv.read_str(fv)?
      "jobEngineVersionRequested" => out.job_engine_version_requested = jsonv.read_str(fv)?
      "jobEngineVersionUsed" => out.job_engine_version_used = jsonv.read_str(fv)?
      "jobPercentComplete" => out.job_percent_complete = jsonv.read_int(fv)?
      "jobTemplate" => out.job_template = jsonv.read_str(fv)?
      "lastShareDetails" => out.last_share_details = jsonv.read_str(fv)?
      "messages" => out.messages = from_json_job_messages(fv)?
      "outputGroupDetails" => out.output_group_details = from_json_list_of_output_group_detail(fv)?
      "priority" => out.priority = jsonv.read_int(fv)?
      "queue" => out.queue = jsonv.read_str(fv)?
      "queueTransitions" => out.queue_transitions = from_json_list_of_queue_transition(fv)?
      "retryCount" => out.retry_count = jsonv.read_int(fv)?
      "role" => out.role = jsonv.read_str(fv)?
      "settings" => out.settings = from_json_job_settings(fv)?
      "shareStatus" => out.share_status = ShareStatus.from(jsonv.read_str(fv)?)
      "simulateReservedQueue" => out.simulate_reserved_queue = SimulateReservedQueue.from(jsonv.read_str(fv)?)
      "status" => out.status = JobStatus.from(jsonv.read_str(fv)?)
      "statusUpdateInterval" => out.status_update_interval = StatusUpdateInterval.from(jsonv.read_str(fv)?)
      "timing" => out.timing = from_json_timing(fv)?
      "userMetadata" => out.user_metadata = from_json_map_of_string(fv)?
      "warnings" => out.warnings = from_json_list_of_warning_group(fv)?
      _ => {}
    }
  }
  Ok(out)
}

