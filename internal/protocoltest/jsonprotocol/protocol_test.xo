  let want = KitchenSink{list_of_structs: [SimpleStruct{value: "value-1"}, SimpleStruct{value: "value-2"}]}
  expect("${got:?}") == "${want:?}"
}

test "parses_list_of_recursive_structure_shapes" {
  let resp = http.Response{status: 200, headers: {"Content-Type": "application/x-amz-json-1.1"}, body: "{\"RecursiveList\":[{\"RecursiveList\":[{\"RecursiveList\":[{\"String\":\"value\"}]}]}]}".bytes()}
  let got = deserialize_kitchen_sink_operation(resp)?
  let want = KitchenSink{recursive_list: [KitchenSink{recursive_list: [KitchenSink{recursive_list: [KitchenSink{string: "value"}]}]}]}
  expect("${got:?}") == "${want:?}"
}

test "parses_map_shapes" {
  let resp = http.Response{status: 200, headers: {"Content-Type": "application/x-amz-json-1.1"}, body: "{\"MapOfStrings\":{\"size\":\"large\",\"color\":\"red\"}}".bytes()}
  let got = deserialize_kitchen_sink_operation(resp)?
  let want = KitchenSink{map_of_strings: {"size": "large", "color": "red"}}
  expect("${got:?}") == "${want:?}"
}

test "parses_map_of_list_shapes" {
  let resp = http.Response{status: 200, headers: {"Content-Type": "application/x-amz-json-1.1"}, body: "{\"MapOfListsOfStrings\":{\"sizes\":[\"large\",\"small\"],\"colors\":[\"red\",\"green\"]}}".bytes()}
  let got = deserialize_kitchen_sink_operation(resp)?
  let want = KitchenSink{map_of_lists_of_strings: {"sizes": ["large", "small"], "colors": ["red", "green"]}}
  expect("${got:?}") == "${want:?}"
}

test "parses_map_of_map_shapes" {
  let resp = http.Response{status: 200, headers: {"Content-Type": "application/x-amz-json-1.1"}, body: "{\"MapOfMaps\":{\"sizes\":{\"large\":\"L\",\"medium\":\"M\"},\"colors\":{\"red\":\"R\",\"blue\":\"B\"}}}".bytes()}
  let got = deserialize_kitchen_sink_operation(resp)?
  let want = KitchenSink{map_of_maps: {"sizes": {"large": "L", "medium": "M"}, "colors": {"red": "R", "blue": "B"}}}
  expect("${got:?}") == "${want:?}"
}

test "parses_map_of_structure_shapes" {
  let resp = http.Response{status: 200, headers: {"Content-Type": "application/x-amz-json-1.1"}, body: "{\"MapOfStructs\":{\"size\":{\"Value\":\"small\"},\"color\":{\"Value\":\"red\"}}}".bytes()}
  let got = deserialize_kitchen_sink_operation(resp)?
  let want = KitchenSink{map_of_structs: {"size": SimpleStruct{value: "small"}, "color": SimpleStruct{value: "red"}}}
