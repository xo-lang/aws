/// An amount of money in a named currency. The amount is a decimal string,
/// not a float: a budget is exact, and binary floating point cannot
/// represent every two-decimal value. Mirrors the Partner Central Selling
/// API's `ExpectedCustomerSpend.Amount`.
pub struct MonetaryValue {
  /// The amount, as a decimal string with at most two decimal places.
  pub amount: Str? = None
  /// The ISO 4217 currency the amount is denominated in.
  pub currency_code: Str? = None
}

/// The campaign's partner badge, as read.
pub struct PartnerBadgeDetail {
  /// A presigned GET of the badge, which expires one hour after the read:
  /// fetch it again with `GetCampaign` when it returns 403.
  pub url: Str? = None
  /// When the badge was set.
  pub attached_at: Time? = None
}

/// A partner's branding, read from their AWS Partner Central profile. The
/// profile is the only source: a campaign carries no branding of its own,
/// so every campaign of a partner shows the same identity, vetted by
/// Partner Central. Edit it in Partner Central.
pub struct PartnerProfileBranding {
  /// The profile's display name.
  pub display_name: Str? = None
  /// The profile's website.
  pub website_url: Str? = None
  /// The profile's logo URL, as AWS Partner Central serves it — the image
  /// every asset of the campaign shows. Absent when the profile names none.
  /// Partner Central Marketing keeps no copy: the same URL is written into a
  /// published landing page and email, and fetched when a document is
  /// composed, so what a client renders from it is what is sent. Only a
  /// document fetches the image: one it cannot fetch and draw fails that
  /// asset with `INTERNAL_ERROR`, which a retry can clear. A landing page or
  /// email links the URL as given, so a logo that does not load shows as a
  /// broken image.
  pub logo_url: Str? = None
  /// When this branding was last read from Partner Central. Earlier than the
  /// request when Partner Central could not be reached and Partner Central
  /// Marketing answered from its last copy.
  pub refreshed_at: Time? = None
}

/// A value of the partner's AWS Partner Central profile that an asset field
/// shows, or that an asset needs before it can activate
/// (`ActivationIssue$PartnerProfileField`). Each names a member of
/// `PartnerProfileBranding`.
pub enum PartnerProfileField: Str {
  DisplayName = "DISPLAY_NAME"
  WebsiteUrl = "WEBSITE_URL"
  Logo = "LOGO"
  WebsiteDomain = "WEBSITE_DOMAIN"
  CopyrightLine = "COPYRIGHT_LINE"
  PartnerDetails = "PARTNER_DETAILS"
  CopyrightAndDetails = "COPYRIGHT_AND_DETAILS"
  CopyrightYearLine = "COPYRIGHT_YEAR_LINE"
  Unknown(value: Str)
}

