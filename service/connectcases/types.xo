/// Represents an SLA configuration.
pub struct SlaConfiguration {
  /// Name of an SLA.
  pub name: Str? = None
  /// Type of SLA.
  pub type_value: Str? = None
  /// Status of an SLA.
  pub status: Str? = None
  /// Unique identifier of a field.
  pub field_id: Str? = None
  /// Represents a list of target field values for the fieldId specified in
  /// SlaConfiguration.
  pub target_field_values: List[FieldValueUnion]? = None
  /// Target time by which an SLA should be completed.
  pub target_time: Time? = None
  /// Time at which an SLA was completed.
  pub completion_time: Time? = None
}

/// Represents the content of an SLA to be returned to agents.
pub struct SlaContent {
  /// Represents an SLA configuration.
  pub sla_configuration: SlaConfiguration? = None
}

/// A filter for related items of type SLA .
pub struct SlaFilter {
  /// Name of an SLA.
  pub name: Str? = None
  /// Status of an SLA.
  pub status: Str? = None
}

/// Represents the input configuration of an SLA being created.
pub struct SlaInputConfiguration {
  /// Name of an SLA.
  pub name: Str? = None
  /// Type of SLA.
  pub type_value: Str? = None
  /// Unique identifier of a field.
  pub field_id: Str? = None
  /// Represents a list of target field values for the fieldId specified in
  /// SlaInputConfiguration. The SLA is considered met if any one of these
  /// target field values matches the actual field value.
  pub target_field_values: List[FieldValueUnion]? = None
  /// Target duration in minutes within which an SLA should be completed.
  pub target_sla_minutes: Int? = None
}

/// Represents the content of an SLA.
pub enum SlaInputContent {
  SlaInputConfiguration(value: SlaInputConfiguration)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// A structured set of sort terms.
pub struct Sort {
  /// Unique identifier of a field.
  pub field_id: Str? = None
  /// Whether results should be sorted in ascending or descending order.
  pub sort_order: Str? = None
}

/// A filter for tags. Only one value can be provided.
pub enum TagFilter {
  EqualTo(value: TagValue)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// Defines tag propagation configuration for resources created within a
/// domain. Tags specified here will be automatically applied to resources
/// being created for the specified resource type.
pub struct TagPropagationConfiguration {
  /// Supported resource types for tag propagation. Determines which resources
  /// will receive automatically propagated tags.
  pub resource_type: Str? = None
  /// The tags that will be applied to the created resource.
  pub tag_map: Map[Str, Str]? = None
}

pub struct TagResourceRequest {
  /// The Amazon Resource Name (ARN)
  pub arn: Str? = None
  /// A map of key-value pairs that represent tags on a resource. Tags are
  /// used to organize, track, or control access for this resource.
  pub tags: Map[Str, Str?]? = None
}

/// Object for case tag filter values.
pub struct TagValue {
  /// The tag key in the tag filter value.
  pub key: Str? = None
  /// The tag value in the tag filter value.
  pub value: Str? = None
}

/// An association representing a case rule acting upon a field. In the
