    xmlv.elem(w, "ownerId", x, [])
  }
  if let Some(x) = v.options {
    xml_write_transit_gateway_multicast_domain_options(w, x, "options", [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "creationTime", rest.date_time(x), [])
  }
  if let Some(x) = v.tags {
