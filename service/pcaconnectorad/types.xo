  /// General flags describe whether the template is used for computers or
  /// users and if the template can be used with autoenrollment.
  pub general_flags: GeneralFlagsV3? = None
  /// Specifies the hash algorithm used to hash the private key.
  pub hash_algorithm: HashAlgorithm? = None
  /// Extensions describe the key usage extensions and application policies
  /// for a template.
  pub extensions: ExtensionsV3? = None
}

/// v4 template schema that can use either Legacy Cryptographic Providers or
/// Key Storage Providers.
pub struct TemplateV4 {
  /// Certificate validity describes the validity and renewal periods of a
  /// certificate.
  pub certificate_validity: CertificateValidity? = None
  /// List of templates in Active Directory that are superseded by this
  /// template.
  pub superseded_templates: List[Str]? = None
  /// Private key attributes allow you to specify the minimal key length, key
  /// spec, key usage, and cryptographic providers for the private key of a
  /// certificate for v4 templates. V4 templates allow you to use either Key
  /// Storage Providers or Legacy Cryptographic Service Providers. You specify
  /// the cryptography provider category in private key flags.
  pub private_key_attributes: PrivateKeyAttributesV4? = None
  /// Private key flags for v4 templates specify the client compatibility, if
  /// the private key can be exported, if user input is required when using a
  /// private key, if an alternate signature algorithm should be used, and if
  /// certificates are renewed using the same private key.
  pub private_key_flags: PrivateKeyFlagsV4? = None
  /// Enrollment flags describe the enrollment settings for certificates using
  /// the existing private key and deleting expired or revoked certificates.
  pub enrollment_flags: EnrollmentFlagsV4? = None
  /// Subject name flags describe the subject name and subject alternate name
  /// that is included in a certificate.
  pub subject_name_flags: SubjectNameFlagsV4? = None
  /// General flags describe whether the template is used for computers or
  /// users and if the template can be used with autoenrollment.
  pub general_flags: GeneralFlagsV4? = None
  /// Specifies the hash algorithm used to hash the private key. Hash
  /// algorithm can only be specified when using Key Storage Providers.
  pub hash_algorithm: HashAlgorithm? = None
  /// Extensions describe the key usage extensions and application policies
  /// for a template.
  pub extensions: ExtensionsV4? = None
}

/// The limit on the number of requests per second was exceeded.
pub struct ThrottlingException {
  pub message: Str? = None
  /// Identifies the originating service.
  pub service_code: Str? = None
  /// The code associated with the quota.
  pub quota_code: Str? = None
}

pub struct UntagResourceRequest {
  /// The Amazon Resource Name (ARN) that was returned when you created the
  /// resource.
  pub resource_arn: Str? = None
  /// Specifies a list of tag keys that you want to remove from the specified
  /// resources.
  pub tag_keys: List[Str]? = None
}

pub struct UpdateTemplateGroupAccessControlEntryRequest {
  /// The Amazon Resource Name (ARN) that was returned when you called
  /// CreateTemplate .
  pub template_arn: Str? = None
  /// Security identifier (SID) of the group object from Active Directory. The
  /// SID starts with "S-".
  pub group_security_identifier: Str? = None
  /// Name of the Active Directory group. This name does not need to match the
  /// group name in Active Directory.
  pub group_display_name: Str? = None
  /// Allow or deny permissions for an Active Directory group to enroll or
  /// autoenroll certificates for a template.
  pub access_rights: AccessRights? = None
}

pub struct UpdateTemplateRequest {
  /// The Amazon Resource Name (ARN) that was returned when you called
  /// CreateTemplate .
  pub template_arn: Str? = None
  /// Template configuration to define the information included in
  /// certificates. Define certificate validity and renewal periods,
  /// certificate request handling and enrollment options, key usage
  /// extensions, application policies, and cryptography settings.
  pub definition: TemplateDefinition? = None
  /// This setting allows the major version of a template to be increased
  /// automatically. All members of Active Directory groups that are allowed
  /// to enroll with a template will receive a new certificate issued using
  /// that template.
  pub reenroll_all_certificate_holders: Bool? = None
}

/// An input validation error occurred. For example, invalid characters in a
/// template name, or if a pagination token is invalid.
pub struct ValidationException {
  pub message: Str? = None
  /// The reason for the validation error. This won't be return for every
  /// validation exception.
  pub reason: ValidationExceptionReason? = None
}

pub enum ValidationExceptionReason: Str {
  FieldValidationFailed = "FIELD_VALIDATION_FAILED"
  InvalidCaSubject = "INVALID_CA_SUBJECT"
  InvalidPermission = "INVALID_PERMISSION"
  InvalidState = "INVALID_STATE"
  MismatchedConnector = "MISMATCHED_CONNECTOR"
  MismatchedVpc = "MISMATCHED_VPC"
  NoClientToken = "NO_CLIENT_TOKEN"
  UnknownOperation = "UNKNOWN_OPERATION"
  Other = "OTHER"
  Unknown(value: Str)
}

/// Information describing the end of the validity period of the
/// certificate. This parameter sets the “Not After” date for the
/// certificate. Certificate validity is the period of time during which a
/// certificate is valid. Validity can be expressed as an explicit date and
/// time when the certificate expires, or as a span of time after issuance,
/// stated in hours, days, months, or years. For more information, see
/// Validity in RFC 5280. This value is unaffected when ValidityNotBefore is
/// also specified. For example, if Validity is set to 20 days in the
/// future, the certificate will expire 20 days from issuance time
/// regardless of the ValidityNotBefore value.
pub struct ValidityPeriod {
  /// The unit of time. You can select hours, days, weeks, months, and years.
  pub period_type: ValidityPeriodType? = None
  /// The numeric value for the validity period.
  pub period: Int? = None
}

pub enum ValidityPeriodType: Str {
  Hours = "HOURS"
  Days = "DAYS"
  Weeks = "WEEKS"
  Months = "MONTHS"
  Years = "YEARS"
  Unknown(value: Str)
}

/// Information about your VPC and security groups used with the connector.
pub struct VpcInformation {
  /// The VPC IP address type.
  pub ip_address_type: IpAddressType? = None
  /// The security groups used with the connector. You can use a maximum of 4
  /// security groups with a connector.
  pub security_group_ids: List[Str]? = None
}
