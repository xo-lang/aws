fn json_of_logical_table_map(v: Map[Str, LogicalTable]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, LogicalTable)) -> (Str, json.Value) { (e.0, json_of_logical_table(e.1)) }))
}

fn from_json_logical_table_map(v: json.Value) -> Map[Str, LogicalTable] ! Str {
  var out: Map[Str, LogicalTable] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_logical_table(fv)?)
  }
  Ok(out)
}