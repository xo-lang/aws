  if let Some(x) = v.error {
    xml_write_error_details(w, x, "Error", [])
  }
  if let Some(x) = v.table_name {
    xmlv.elem(w, "TableName", x, [])
  }
  if let Some(x) = v.table_arn {
    xmlv.elem(w, "TableArn", x, [])
  }
  if let Some(x) = v.record_expiration {
    xml_write_record_expiration(w, x, "RecordExpiration", [])
  }
  xmlv.end(w, name)
}

fn xml_read_journal_table_configuration_result(e: xml.Element) -> JournalTableConfigurationResult ! Str {
  var out = JournalTableConfigurationResult{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TableStatus" => out.table_status = c.text()
      "Error" => out.error = xml_read_error_details(c)?
      "TableName" => out.table_name = c.text()
      "TableArn" => out.table_arn = c.text()
      "RecordExpiration" => out.record_expiration = xml_read_record_expiration(c)?
