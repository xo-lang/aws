  }
  if let Some(x) = v.investment_id {
    fs.push(("investmentId", json.Value.Str(x)))
  }
  if let Some(x) = v.attested_at {
    fs.push(("attestedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.updated_at {
    fs.push(("updatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.attestation_status {
    fs.push(("attestationStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.investment_disbursed_at {
    fs.push(("investmentDisbursedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.attested_value {
    fs.push(("attestedValue", json_of_amount(x)))
  }
  if let Some(x) = v.investment_distributions {
    fs.push(("investmentDistributions", json_of_investment_distributions(x)))
  }
  if let Some(x) = v.rejection_reasons {
    fs.push(("rejectionReasons", json_of_rejection_reasons(x)))
  }
  if let Some(x) = v.is_cancellable {
    fs.push(("isCancellable", json.Value.Bool(x)))
  }
  json.Value.Object(fs)
}

fn from_json_investment_attestation(v: json.Value) -> InvestmentAttestation ! Str {
  var out = InvestmentAttestation{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "attestationId" => out.attestation_id = jsonv.read_str(fv)?
      "investmentName" => out.investment_name = jsonv.read_str(fv)?
      "outcomeDescription" => out.outcome_description = jsonv.read_str(fv)?
      "investmentSummaryId" => out.investment_summary_id = jsonv.read_str(fv)?
      "investmentId" => out.investment_id = jsonv.read_str(fv)?
      "attestedAt" => out.attested_at = jsonv.read_time(fv, "epoch-seconds")?
      "updatedAt" => out.updated_at = jsonv.read_time(fv, "epoch-seconds")?
      "attestationStatus" => out.attestation_status = InvestmentAttestationStatus.from(jsonv.read_str(fv)?)
      "investmentDisbursedAt" => out.investment_disbursed_at = jsonv.read_time(fv, "epoch-seconds")?
      "attestedValue" => out.attested_value = from_json_amount(fv)?
      "investmentDistributions" => out.investment_distributions = from_json_investment_distributions(fv)?
      "rejectionReasons" => out.rejection_reasons = from_json_rejection_reasons(fv)?
      "isCancellable" => out.is_cancellable = jsonv.read_bool(fv)?
      _ => {}
    }
  }
  Ok(out)
}

