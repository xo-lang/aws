use github.com/xo-lang/aws

struct Counting {
  calls: Atomic[Int]
  clock: Clock
  life: Duration
}

fn (p: Counting) retrieve() -> aws.Credentials ! aws.CredentialsErr uses (net.dial, clock, rand) {
  let n = p.calls.add(1)
  Ok(aws.Credentials{
    access_key_id: "AKIDTEST000000000${n}",
    secret_access_key: Secret.new("invented-secret"),
    expires: Time.from_unix_millis(p.clock.now().unix_millis() + p.life.millis()),
  })
}

fn missing(msg: Str) -> FixedResult { FixedResult{result: Err(aws.CredentialsErr.NotFound(msg))} }

test "chain skips NotFound and stops on Invalid" {
  let good = static_provider("AKIDTEST0000000000", "invented-secret")
  let c = Chain{providers: [missing("a"), good]}
  expect(c.retrieve()?.access_key_id) == "AKIDTEST0000000000"
  let bad = FixedResult{result: Err(aws.CredentialsErr.Invalid("broken profile"))}
  let c2 = Chain{providers: [bad, good]}
  expect(c2.retrieve() is Err(aws.CredentialsErr.Invalid(_))) == true
  let c3 = Chain{providers: [missing("a"), missing("b")]}
  match c3.retrieve() {
    Err(aws.CredentialsErr.NotFound(msg)) => expect(msg.contains("a; b")) == true
    _ => expect(false)
  }
}

test "cache refreshes inside the window" {
  let inner = Counting{calls: Atomic.new(0), clock: os.clock, life: 15m}
  let c = cache(inner, os.clock, 5m)
  expect(c.retrieve()?.access_key_id) == "AKIDTEST0000000001"
  os.clock.advance(9m)
  expect(c.retrieve()?.access_key_id) == "AKIDTEST0000000001"
  os.clock.advance(2m)
  expect(c.retrieve()?.access_key_id) == "AKIDTEST0000000002"
  invalidate(c)
  expect(c.retrieve()?.access_key_id) == "AKIDTEST0000000003"
}

test "cache keeps long term keys" {
  let c = cache(static_provider("AKIDTEST0000000000", "invented-secret"), os.clock)
  c.retrieve()?
  os.clock.advance(1000h)
  expect(c.retrieve()?.access_key_id) == "AKIDTEST0000000000"
}
