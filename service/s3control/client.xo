      "StorageClass" => out.storage_class = S3StorageClass.from(c.text())
      "UnModifiedSinceConstraint" => out.un_modified_since_constraint = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SSEAwsKmsKeyId" => out.sse_aws_kms_key_id = c.text()
      "TargetKeyPrefix" => out.target_key_prefix = c.text()
      "ObjectLockLegalHoldStatus" => out.object_lock_legal_hold_status = S3ObjectLockLegalHoldStatus.from(c.text())
      "ObjectLockMode" => out.object_lock_mode = S3ObjectLockMode.from(c.text())
      "ObjectLockRetainUntilDate" => out.object_lock_retain_until_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "BucketKeyEnabled" => out.bucket_key_enabled = xmlv.read_bool(c.text())?
      "ChecksumAlgorithm" => out.checksum_algorithm = S3ChecksumAlgorithm.from(c.text())
      "ObjectLockEventHold" => out.object_lock_event_hold = S3ObjectLockEventHold.from(c.text())
      "ObjectLockEventHoldDuration" => out.object_lock_event_hold_duration = xml_read_s3_object_lock_event_hold_duration(c)?
      _ => {}
    }
  }
  Ok(out)
}

