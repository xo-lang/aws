  pub description: Str? = None
  /// The step action name.
  pub action: Str? = None
  /// Runtime status for the workflow step.
  pub status: WorkflowStepExecutionStatus? = None
  /// Reports on the rollback status of the step, if applicable.
  pub rollback_status: WorkflowStepExecutionRollbackStatus? = None
  /// Detailed output message that the workflow step provides at runtime.
  pub message: Str? = None
  /// Input parameters that Image Builder provides for the workflow step, as a
  /// JSON-encoded string.
  pub inputs: Str? = None
  /// The output values that the workflow step produced for this runtime
  /// instance of the workflow, as a JSON-encoded string. For example, a step
  /// that launches an instance outputs the instance ID. If the step failed,
  /// this field contains the error message.
  pub outputs: Str? = None
  /// The timestamp when the workflow step started.
  pub start_time: Str? = None
  /// The timestamp when the workflow step finished.
  pub end_time: Str? = None
  /// The current attempt number for the workflow step. The first run is
  /// attempt one. The number increases by one for each retry.
  pub attempt_number: Int? = None
  /// The maximum number of attempts allowed for the workflow step, based on
  /// the retry configuration in the workflow document. If the step doesn't
  /// configure retries, the maximum is one attempt.
  pub max_attempts: Int? = None
}

/// Contains metadata about the workflow resource.
pub struct WorkflowSummary {
  /// The Amazon Resource Name (ARN) of the workflow resource.
  pub arn: Str? = None
  /// The name of the workflow.
  pub name: Str? = None
  /// The version of the workflow.
  pub version: Str? = None
  /// Describes the workflow.
  pub description: Str? = None
  /// The change description for the current version of the workflow resource.
  pub change_description: Str? = None
  /// The image creation stage that this workflow applies to.
  pub type_value: WorkflowType? = None
  /// The owner of the workflow resource.
  pub owner: Str? = None
  /// Describes the current state of the workflow resource.
  pub state: WorkflowState? = None
  /// The original creation date of the workflow resource.
  pub date_created: Str? = None
  /// Contains a list of tags that are defined for the workflow.
  pub tags: Map[Str, Str]? = None
}

pub enum WorkflowType: Str {
  Build = "BUILD"
  Test = "TEST"
  Distribution = "DISTRIBUTION"
  Unknown(value: Str)
}

/// Contains details about this version of the workflow.
pub struct WorkflowVersion {
  /// The Amazon Resource Name (ARN) of the workflow resource.
  pub arn: Str? = None
  /// The name of the workflow.
  pub name: Str? = None
  /// The semantic version of the workflow resource. The format includes three
  /// nodes: . . .
  pub version: Str? = None
  /// Describes the workflow.
  pub description: Str? = None
  /// The image creation stage that this workflow applies to.
  pub type_value: WorkflowType? = None
  /// The owner of the workflow resource.
  pub owner: Str? = None
  /// The timestamp when Image Builder created the workflow version.
  pub date_created: Str? = None
}
