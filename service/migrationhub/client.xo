  var req = serialize_put_resource_attributes(ep, input, "") ?? e => return Err(PutResourceAttributesErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(PutResourceAttributesErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_put_resource_attributes_error(resp))
  }
  deserialize_put_resource_attributes(resp) ?? e => Err(PutResourceAttributesErr.Deserialize(e))
}
