  /// package. pypi : A Python Package Index (PyPI) package. maven : A Maven
  /// package that contains compiled code in a distributable format, such as a
  /// JAR file. nuget : A NuGet package. generic : A generic package. ruby : A
  /// Ruby package. swift : A Swift package. cargo : A Cargo package.
  pub package_format: PackageFormat? = None
  /// The status of the external connection of a repository. There is one
  /// valid value, Available .
  pub status: ExternalConnectionStatus? = None
}

