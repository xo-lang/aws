}

pub enum SecurityControlsProvider: Str {
  Aws = "AWS"
  Azure = "Azure"
  Unknown(value: Str)
}

pub enum SecurityHubFeature: Str {
  SecurityHub = "SecurityHub"
  SecurityHubV2 = "SecurityHubV2"
