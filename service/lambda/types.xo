  pub message: Str? = None
}

/// Details about a function's configuration.
pub struct FunctionConfiguration {
  /// The name of the function.
  pub function_name: Str? = None
  /// The function's Amazon Resource Name (ARN).
  pub function_arn: Str? = None
  /// The identifier of the function's runtime . Runtime is required if the
  /// deployment package is a .zip file archive. Specifying a runtime results
  /// in an error if you're deploying a function using a container image. The
  /// following list includes deprecated runtimes. Lambda blocks creating new
  /// functions and updating existing functions shortly after each runtime is
  /// deprecated. For more information, see Runtime use after deprecation .
  /// For a list of all currently supported runtimes, see Supported runtimes .
  pub runtime: Runtime? = None
  /// The function's execution role.
  pub role: Str? = None
  /// The function that Lambda calls to begin running your function.
  pub handler: Str? = None
  /// The size of the function's deployment package, in bytes.
  pub code_size: Int? = None
  /// The function's description.
  pub description: Str? = None
  /// The amount of time in seconds that Lambda allows a function to run
  /// before stopping it.
  pub timeout: Int? = None
  /// The amount of memory available to the function at runtime.
  pub memory_size: Int? = None
  /// The date and time that the function was last updated, in ISO-8601 format
  /// (YYYY-MM-DDThh:mm:ss.sTZD).
  pub last_modified: Str? = None
  /// The SHA256 hash of the function's deployment package.
  pub code_sha256: Str? = None
  /// The version of the Lambda function.
  pub version: Str? = None
  /// The function's networking configuration.
  pub vpc_config: VpcConfigResponse? = None
  /// The function's dead letter queue.
  pub dead_letter_config: DeadLetterConfig? = None
  /// The function's environment variables . Omitted from CloudTrail logs.
  pub environment: EnvironmentResponse? = None
  /// The ARN of the Key Management Service (KMS) customer managed key that's
  /// used to encrypt the following resources: The function's environment
  /// variables . The function's Lambda SnapStart snapshots. When used with
  /// SourceKMSKeyArn , the unzipped version of the .zip deployment package
  /// that's used for function invocations. For more information, see
  /// Specifying a customer managed key for Lambda . The optimized version of
  /// the container image that's used for function invocations. Note that this
  /// is not the same key that's used to protect your container image in the
  /// Amazon Elastic Container Registry (Amazon ECR). For more information,
  /// see Function lifecycle . If you don't provide a customer managed key,
  /// Lambda uses an Amazon Web Services owned key or an Amazon Web Services
  /// managed key .
  pub kms_key_arn: Str? = None
  /// The function's X-Ray tracing configuration.
  pub tracing_config: TracingConfigResponse? = None
  /// For Lambda@Edge functions, the ARN of the main function.
  pub master_arn: Str? = None
  /// The latest updated revision of the function or alias.
  pub revision_id: Str? = None
  /// The function's layers .
  pub layers: List[Layer]? = None
  /// The current state of the function. When the state is Inactive , you can
  /// reactivate the function by invoking it.
  pub state: State? = None
  /// The reason for the function's current state.
  pub state_reason: Str? = None
  /// The reason code for the function's current state. When the code is
  /// Creating , you can't invoke or modify the function.
  pub state_reason_code: StateReasonCode? = None
  /// The status of the last update that was performed on the function. This
  /// is first set to Successful after function creation completes.
  pub last_update_status: LastUpdateStatus? = None
  /// The reason for the last update that was performed on the function.
  pub last_update_status_reason: Str? = None
  /// The reason code for the last update that was performed on the function.
  pub last_update_status_reason_code: LastUpdateStatusReasonCode? = None
  /// Connection settings for an Amazon EFS file system or an Amazon S3 file
  /// system .
  pub file_system_configs: List[FileSystemConfig]? = None
  /// The ARN of the signing profile version.
  pub signing_profile_version_arn: Str? = None
  /// The ARN of the signing job.
  pub signing_job_arn: Str? = None
  /// The type of deployment package. Set to Image for container image and set
  /// Zip for .zip file archive.
  pub package_type: PackageType? = None
  /// The function's image configuration values.
  pub image_config_response: ImageConfigResponse? = None
  /// The instruction set architecture that the function supports.
  /// Architecture is a string array with one of the valid values. The default
  /// architecture value is x86_64 .
  pub architectures: List[Architecture]? = None
  /// The size of the function's /tmp directory in MB. The default value is
  /// 512, but can be any whole number between 512 and 10,240 MB. For more
  /// information, see Configuring ephemeral storage (console) .
  pub ephemeral_storage: EphemeralStorage? = None
  /// Set ApplyOn to PublishedVersions to create a snapshot of the initialized
  /// execution environment when you publish a function version. For more
  /// information, see Improving startup performance with Lambda SnapStart .
  pub snap_start: SnapStartResponse? = None
  /// The ARN of the runtime and any errors that occured.
  pub runtime_version_config: RuntimeVersionConfig? = None
  /// The function's Amazon CloudWatch Logs configuration settings.
  pub logging_config: LoggingConfig? = None
  /// The function's tenant isolation configuration settings. Determines
  /// whether the Lambda function runs on a shared or dedicated infrastructure
  /// per unique tenant.
  pub tenancy_config: TenancyConfig? = None
  /// Configuration for the capacity provider that manages compute resources
  /// for Lambda functions.
  pub capacity_provider_config: CapacityProviderConfig? = None
  /// The SHA256 hash of the function configuration.
  pub config_sha256: Str? = None
  /// The function's durable execution configuration settings, if the function
  /// is configured for durability.
  pub durable_config: DurableConfig? = None
}

pub struct FunctionEventInvokeConfig {
  /// The date and time that the configuration was last updated.
  pub last_modified: Time? = None
  /// The Amazon Resource Name (ARN) of the function.
  pub function_arn: Str? = None
  /// The maximum number of times to retry when the function returns an error.
  pub maximum_retry_attempts: Int? = None
  /// The maximum age of a request that Lambda sends to a function for
  /// processing.
  pub maximum_event_age_in_seconds: Int? = None
  /// A destination for events after they have been sent to a function for
  /// processing. Destinations Function - The Amazon Resource Name (ARN) of a
  /// Lambda function. Queue - The ARN of a standard SQS queue. Bucket - The
  /// ARN of an Amazon S3 bucket. Topic - The ARN of a standard SNS topic.
  /// Event Bus - The ARN of an Amazon EventBridge event bus. S3 buckets are
  /// supported only for on-failure destinations. To retain records of
  /// successful invocations, use another destination type.
  pub destination_config: DestinationConfig? = None
}

