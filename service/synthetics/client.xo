/// The HTTP request of AssociateResource.
pub fn serialize_associate_resource(ep: rest.Endpoint, input: AssociateResourceRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_group_identifier = match input.group_identifier {
    Some(v) => v
    None => return Err("input member GroupIdentifier is required")
  }
  if label_group_identifier == "" {
    return Err("input member GroupIdentifier must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.resource_arn {
    fs.push(("ResourceArn", json.Value.Str(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PATCH",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/group/${rest.escape(label_group_identifier, false)}/associate"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

