  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.create_time {
    fs.push(("CreateTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.delete_time {
    fs.push(("DeleteTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.update_time {
    fs.push(("UpdateTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.failure_code {
    fs.push(("FailureCode", json.Value.Str(x)))
  }
  if let Some(x) = v.failure_message {
    fs.push(("FailureMessage", json.Value.Str(x)))
  }
  if let Some(x) = v.proxy_state {
    fs.push(("ProxyState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.proxy_modify_state {
    fs.push(("ProxyModifyState", json.Value.Str(x.value())))
  }
  if let Some(x) = v.nat_gateway_id {
    fs.push(("NatGatewayId", json.Value.Str(x)))
  }
  if let Some(x) = v.proxy_configuration_name {
    fs.push(("ProxyConfigurationName", json.Value.Str(x)))
  }
  if let Some(x) = v.proxy_configuration_arn {
    fs.push(("ProxyConfigurationArn", json.Value.Str(x)))
  }
  if let Some(x) = v.proxy_name {
    fs.push(("ProxyName", json.Value.Str(x)))
  }
  if let Some(x) = v.proxy_arn {
    fs.push(("ProxyArn", json.Value.Str(x)))
  }
  if let Some(x) = v.listener_properties {
    fs.push(("ListenerProperties", json_of_listener_properties(x)))
  }
  if let Some(x) = v.tls_intercept_properties {
    fs.push(("TlsInterceptProperties", json_of_tls_intercept_properties(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_list(x)))
  }
  json.Value.Object(fs)
}

