pub fn endpoint_params_put_object(base: EndpointParameters, input: PutObjectRequest) -> EndpointParameters {
  let _ = input
  base
}

/// The HTTP request of PutObject.
pub fn serialize_put_object(ep: rest.Endpoint, input: PutObjectRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_path = match input.path {
    Some(v) => v
    None => return Err("input member Path is required")
  }
  if label_path == "" {
    return Err("input member Path must not be empty")
  }
  if let Some(v) = input.content_type {
    headers.push(("Content-Type", v))
  }
  if let Some(v) = input.cache_control {
    headers.push(("Cache-Control", v))
  }
  if let Some(v) = input.storage_class {
    headers.push(("x-amz-storage-class", v.value()))
  }
  if let Some(v) = input.upload_availability {
    headers.push(("x-amz-upload-availability", v.value()))
  }
  var body = b""
  var upload: aws.Upload? = None
  var trailer: Str? = None
  if let Some(u) = input.body_stream {
    upload = Some(u)
  }
  if let Some(v) = input.body {
    body = v
  }
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PUT",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/${rest.escape(label_path, true)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
    upload: upload,
    trailer_checksum: trailer,
  })
}

pub fn deserialize_put_object(resp: http.Response) -> PutObjectResponse ! Str {
  var out = PutObjectResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ContentSHA256" => out.content_sha256 = jsonv.read_str(fv)?
      "ETag" => out.e_tag = jsonv.read_str(fv)?
      "StorageClass" => out.storage_class = StorageClass.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

