          "exception" => return Err(exception_response_stream_event(m))
          _ => return Err(ResponseStreamEventErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(ResponseStreamEventErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(ResponseStreamEventErr.Read(e.display()))
