/// The errors of UpdateRoom.
pub enum UpdateRoomErr {
  AccessDeniedException(e: AccessDeniedException)
  PendingVerification(e: PendingVerification)
  ResourceNotFoundException(e: ResourceNotFoundException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UpdateRoomErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    PendingVerification(x) => "PendingVerification: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_update_room_error(resp: http.Response) -> UpdateRoomErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return UpdateRoomErr.AccessDeniedException(x)
      Err(msg) => return UpdateRoomErr.Deserialize(msg)
    }
    "PendingVerification" => match read_error_pending_verification(resp, body) {
      Ok(x) => return UpdateRoomErr.PendingVerification(x)
      Err(msg) => return UpdateRoomErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UpdateRoomErr.ResourceNotFoundException(x)
      Err(msg) => return UpdateRoomErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UpdateRoomErr.ValidationException(x)
      Err(msg) => return UpdateRoomErr.Deserialize(msg)
    }
    _ => {}
  }
  UpdateRoomErr.Api(restjson.api_error(resp, body))
}

/// Updates a room’s configuration.
pub fn (c: Client) update_room(input: UpdateRoomRequest) -> UpdateRoomResponse ! UpdateRoomErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_room(c.params, input)) ?? e => return Err(UpdateRoomErr.InvalidInput(e))
  var req = serialize_update_room(ep, input, "") ?? e => return Err(UpdateRoomErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateRoomErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_room_error(resp))
  }
  deserialize_update_room(resp) ?? e => Err(UpdateRoomErr.Deserialize(e))
}
