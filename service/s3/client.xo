fn xml_write_lifecycle_expiration(var w: xmlv.Writer, v: LifecycleExpiration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.date {
    xmlv.elem(w, "Date", rest.date_time(x), [])
  }
  if let Some(x) = v.days {
    xmlv.elem(w, "Days", "${x}", [])
  }
  if let Some(x) = v.expired_object_delete_marker {
    xmlv.elem(w, "ExpiredObjectDeleteMarker", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_lifecycle_expiration(e: xml.Element) -> LifecycleExpiration ! Str {
  var out = LifecycleExpiration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Date" => out.date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Days" => out.days = xmlv.read_int(c.text())?
      "ExpiredObjectDeleteMarker" => out.expired_object_delete_marker = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_lifecycle_rule(var w: xmlv.Writer, v: LifecycleRule, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.expiration {
    xml_write_lifecycle_expiration(w, x, "Expiration", [])
  }
  if let Some(x) = v.id {
    xmlv.elem(w, "ID", x, [])
  }
  if let Some(x) = v.prefix {
    xmlv.elem(w, "Prefix", x, [])
  }
  if let Some(x) = v.filter {
    xml_write_lifecycle_rule_filter(w, x, "Filter", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.transitions {
    for item in x {
      xml_write_transition(w, item, "Transition", [])
    }
  }
  if let Some(x) = v.noncurrent_version_transitions {
    for item in x {
      xml_write_noncurrent_version_transition(w, item, "NoncurrentVersionTransition", [])
    }
  }
  if let Some(x) = v.noncurrent_version_expiration {
    xml_write_noncurrent_version_expiration(w, x, "NoncurrentVersionExpiration", [])
  }
  if let Some(x) = v.abort_incomplete_multipart_upload {
    xml_write_abort_incomplete_multipart_upload(w, x, "AbortIncompleteMultipartUpload", [])
  }
  xmlv.end(w, name)
}

fn xml_read_lifecycle_rule(e: xml.Element) -> LifecycleRule ! Str {
  var out = LifecycleRule{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Expiration" => out.expiration = xml_read_lifecycle_expiration(c)?
      "ID" => out.id = c.text()
      "Prefix" => out.prefix = c.text()
      "Filter" => out.filter = xml_read_lifecycle_rule_filter(c)?
      "Status" => out.status = ExpirationStatus.from(c.text())
      "Transition" => {
        var items = out.transitions ?? []
        items.push(xml_read_transition(c)?)
        out.transitions = items
      }
      "NoncurrentVersionTransition" => {
        var items = out.noncurrent_version_transitions ?? []
        items.push(xml_read_noncurrent_version_transition(c)?)
        out.noncurrent_version_transitions = items
      }
      "NoncurrentVersionExpiration" => out.noncurrent_version_expiration = xml_read_noncurrent_version_expiration(c)?
      "AbortIncompleteMultipartUpload" => out.abort_incomplete_multipart_upload = xml_read_abort_incomplete_multipart_upload(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_lifecycle_rule_and_operator(var w: xmlv.Writer, v: LifecycleRuleAndOperator, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.prefix {
    xmlv.elem(w, "Prefix", x, [])
  }
  if let Some(x) = v.tags {
    for item in x {
      xml_write_tag(w, item, "Tag", [])
    }
  }
  if let Some(x) = v.object_size_greater_than {
    xmlv.elem(w, "ObjectSizeGreaterThan", "${x}", [])
  }
  if let Some(x) = v.object_size_less_than {
    xmlv.elem(w, "ObjectSizeLessThan", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_lifecycle_rule_and_operator(e: xml.Element) -> LifecycleRuleAndOperator ! Str {
  var out = LifecycleRuleAndOperator{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Prefix" => out.prefix = c.text()
      "Tag" => {
        var items = out.tags ?? []
        items.push(xml_read_tag(c)?)
        out.tags = items
      }
      "ObjectSizeGreaterThan" => out.object_size_greater_than = xmlv.read_int(c.text())?
      "ObjectSizeLessThan" => out.object_size_less_than = xmlv.read_int(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_lifecycle_rule_filter(var w: xmlv.Writer, v: LifecycleRuleFilter, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
