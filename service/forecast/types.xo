}

/// The time boundary Forecast uses to align and aggregate your data to
/// match your forecast frequency. Provide the unit of time and the time
/// boundary as a key value pair. If you don't provide a time boundary,
/// Forecast uses a set of Default Time Boundaries . For more information
/// about aggregation, see Data Aggregation for Different Forecast
/// Frequencies . For more information setting a custom time boundary, see
/// Specifying a Time Boundary .
pub struct TimeAlignmentBoundary {
  /// The month to use for time alignment during aggregation. The month must
  /// be in uppercase.
  pub month: Month? = None
  /// The day of the month to use for time alignment during aggregation.
  pub day_of_month: Int? = None
  /// The day of week to use for time alignment during aggregation. The day
  /// must be in uppercase.
  pub day_of_week: DayOfWeek? = None
  /// The hour of day to use for time alignment during aggregation.
  pub hour: Int? = None
}

pub enum TimePointGranularity: Str {
  All = "ALL"
  Specific = "SPECIFIC"
  Unknown(value: Str)
}

/// Creates a subset of items within an attribute that are modified. For
/// example, you can use this operation to create a subset of items that
/// cost $5 or less. To do this, you specify "AttributeName": "price" ,
/// "AttributeValue": "5" , and "Condition": "LESS_THAN" . Pair this
/// operation with the Action operation within the
/// CreateWhatIfForecastRequest$TimeSeriesTransformations operation to
/// define how the attribute is modified.
pub struct TimeSeriesCondition {
  /// The item_id, dimension name, IM name, or timestamp that you are
  /// modifying.
  pub attribute_name: Str? = None
  /// The value that is applied for the chosen Condition .
  pub attribute_value: Str? = None
  /// The condition to apply. Valid values are EQUALS , NOT_EQUALS , LESS_THAN
  /// and GREATER_THAN .
  pub condition: Condition? = None
}

pub enum TimeSeriesGranularity: Str {
  All = "ALL"
  Specific = "SPECIFIC"
  Unknown(value: Str)
}

/// Details about the import file that contains the time series for which
/// you want to create forecasts.
