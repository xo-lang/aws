  Deserialize(msg: Str)
}

pub fn (e: CreateProfileErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_create_profile_error(resp: http.Response) -> CreateProfileErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return CreateProfileErr.AccessDeniedException(x)
      Err(msg) => return CreateProfileErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return CreateProfileErr.ValidationException(x)
      Err(msg) => return CreateProfileErr.Deserialize(msg)
    }
    _ => {}
  }
  CreateProfileErr.Api(restjson.api_error(resp, body))
}

/// Creates a profile , a list of the roles that Roles Anywhere service is
/// trusted to assume. You use profiles to intersect permissions with IAM
/// managed policies. Required permissions: rolesanywhere:CreateProfile .
pub fn (c: Client) create_profile(input: CreateProfileRequest) -> ProfileDetailResponse ! CreateProfileErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_create_profile(c.params, input)) ?? e => return Err(CreateProfileErr.InvalidInput(e))
  var req = serialize_create_profile(ep, input, "") ?? e => return Err(CreateProfileErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(CreateProfileErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_create_profile_error(resp))
  }
  deserialize_create_profile(resp) ?? e => Err(CreateProfileErr.Deserialize(e))
}

