fn json_of_subscribe_to_shard_event_stream(v: SubscribeToShardEventStream) -> json.Value {
  match v {
    SubscribeToShardEvent(x) => json.Value.Object([("SubscribeToShardEvent", json_of_subscribe_to_shard_event(x))])
    ResourceNotFoundException(x) => json.Value.Object([("ResourceNotFoundException", json_of_resource_not_found_exception(x))])
    ResourceInUseException(x) => json.Value.Object([("ResourceInUseException", json_of_resource_in_use_exception(x))])
    KmsDisabledException(x) => json.Value.Object([("KMSDisabledException", json_of_kms_disabled_exception(x))])
    KmsInvalidStateException(x) => json.Value.Object([("KMSInvalidStateException", json_of_kms_invalid_state_exception(x))])
    KmsAccessDeniedException(x) => json.Value.Object([("KMSAccessDeniedException", json_of_kms_access_denied_exception(x))])
    KmsNotFoundException(x) => json.Value.Object([("KMSNotFoundException", json_of_kms_not_found_exception(x))])
    KmsOptInRequired(x) => json.Value.Object([("KMSOptInRequired", json_of_kms_opt_in_required(x))])
    KmsThrottlingException(x) => json.Value.Object([("KMSThrottlingException", json_of_kms_throttling_exception(x))])
    InternalFailureException(x) => json.Value.Object([("InternalFailureException", json_of_internal_failure_exception(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_subscribe_to_shard_event_stream(v: json.Value) -> SubscribeToShardEventStream ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "SubscribeToShardEvent" => Ok(SubscribeToShardEventStream.SubscribeToShardEvent(from_json_subscribe_to_shard_event(fv)?))
      "ResourceNotFoundException" => Ok(SubscribeToShardEventStream.ResourceNotFoundException(from_json_resource_not_found_exception(fv)?))
      "ResourceInUseException" => Ok(SubscribeToShardEventStream.ResourceInUseException(from_json_resource_in_use_exception(fv)?))
      "KMSDisabledException" => Ok(SubscribeToShardEventStream.KmsDisabledException(from_json_kms_disabled_exception(fv)?))
      "KMSInvalidStateException" => Ok(SubscribeToShardEventStream.KmsInvalidStateException(from_json_kms_invalid_state_exception(fv)?))
      "KMSAccessDeniedException" => Ok(SubscribeToShardEventStream.KmsAccessDeniedException(from_json_kms_access_denied_exception(fv)?))
      "KMSNotFoundException" => Ok(SubscribeToShardEventStream.KmsNotFoundException(from_json_kms_not_found_exception(fv)?))
      "KMSOptInRequired" => Ok(SubscribeToShardEventStream.KmsOptInRequired(from_json_kms_opt_in_required(fv)?))
      "KMSThrottlingException" => Ok(SubscribeToShardEventStream.KmsThrottlingException(from_json_kms_throttling_exception(fv)?))
      "InternalFailureException" => Ok(SubscribeToShardEventStream.InternalFailureException(from_json_internal_failure_exception(fv)?))
      _ => Ok(SubscribeToShardEventStream.Unknown(k))
    }
  }
  Err("SubscribeToShardEventStream: no member set")
}

