  /// using test spec files, please see Custom test environments in AWS Device
  /// Farm.
  pub environment_variables: List[EnvironmentVariable]? = None
  /// An IAM role to be assumed by the test host for all runs in the project.
  pub execution_role_arn: Str? = None
}

