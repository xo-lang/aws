/// Basic information about a package.
pub struct PackageDetails {
  /// The unique identifier of the package.
  pub package_id: Str? = None
  /// The user-specified name of the package.
  pub package_name: Str? = None
  /// The type of package.
  pub package_type: PackageType? = None
  /// User-specified description of the package.
  pub package_description: Str? = None
  /// The current status of the package. The available options are AVAILABLE ,
  /// COPYING , COPY_FAILED , VALIDATNG , VALIDATION_FAILED , DELETING , and
  /// DELETE_FAILED .
  pub package_status: PackageStatus? = None
  /// The timestamp when the package was created.
  pub created_at: Time? = None
  /// Date and time when the package was last updated.
  pub last_updated_at: Time? = None
  /// The package version.
  pub available_package_version: Str? = None
  /// Additional information if the package is in an error state. Null
  /// otherwise.
  pub error_details: ErrorDetails? = None
  /// Version of OpenSearch or Elasticsearch, in the format Elasticsearch_X.Y
  /// or OpenSearch_X.Y. Defaults to the latest version of OpenSearch.
  pub engine_version: Str? = None
  /// If the package is a ZIP-PLUGIN package, additional information about
  /// plugin properties.
  pub available_plugin_properties: PluginProperties? = None
  /// This represents the available configuration parameters for the package.
  pub available_package_configuration: PackageConfiguration? = None
  /// A list of users who are allowed to view and associate the package. This
  /// field is only visible to the owner of a package.
  pub allow_listed_user_list: List[Str]? = None
  /// The owner of the package who is allowed to create and update a package
  /// and add users to the package scope.
  pub package_owner: Str? = None
  /// Package Vending Options for a package.
  pub package_vending_options: PackageVendingOptions? = None
  /// Encryption options for a package.
  pub package_encryption_options: PackageEncryptionOptions? = None
}

