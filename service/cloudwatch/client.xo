  var out = Datapoint{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Timestamp" => out.timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "SampleCount" => out.sample_count = xmlv.read_float(c.text())?
      "Average" => out.average = xmlv.read_float(c.text())?
      "Sum" => out.sum = xmlv.read_float(c.text())?
      "Minimum" => out.minimum = xmlv.read_float(c.text())?
      "Maximum" => out.maximum = xmlv.read_float(c.text())?
      "Unit" => out.unit = StandardUnit.from(c.text())
      "ExtendedStatistics" => out.extended_statistics = xml_read_datapoint_value_map(c)?
      _ => {}
    }
  }
  Ok(out)
}

