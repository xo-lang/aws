/// returning ResourceNotFoundException. Use after DeleteEventBus. Fails
/// fast on the terminal DELETE_FAILED state, surfacing StateReason; retry
/// DeleteEventBus after removing subscribers.
///
/// Calls DescribeEventBus until the EventBusDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (2s) to `max_delay` (120s).
pub fn wait_until_event_bus_deleted(c: Client, input: DescribeEventBusRequest, max_wait: Duration, min_delay: Duration = 2s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeEventBusErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_event_bus(input) {
      Ok(out) => {
        let o = jmes_of_describe_event_bus_response(out)
        if state == "" && waiter.path_matches(o, "State", "stringEquals", "DELETE_FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_event_bus(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("EventBusDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Waits until an Amazon MSK subscriber's connectivity reports ACTIVE. Use
/// after CreateSubscriber or UpdateSubscriber on a subscriber that targets
/// an MSK cluster. Fails fast on PROVISION_FAILED, surfacing
/// MskDetails.StateReason. PROVISIONING falls through to the implicit
/// retry. Applies only to MSK subscribers; other subscribers return no
/// MskDetails, so the waiter times out.
///
/// Calls DescribeSubscriber until the MskSubscriberActive acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (2s) to `max_delay` (300s).
pub fn wait_until_msk_subscriber_active(c: Client, input: DescribeSubscriberRequest, max_wait: Duration, min_delay: Duration = 2s, max_delay: Duration = 300s) -> () ! waiter.WaitErr[DescribeSubscriberErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_subscriber(input) {
      Ok(out) => {
        let o = jmes_of_describe_subscriber_response(out)
        if state == "" && waiter.path_matches(o, "SubscriberDetails.MskDetails.ConnectivityState", "stringEquals", "PROVISION_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "SubscriberDetails.MskDetails.ConnectivityState", "stringEquals", "ACTIVE") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("MskSubscriberActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}
