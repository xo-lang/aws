fn json_of_field_position(v: FieldPosition) -> json.Value {
  match v {
    Fixed(x) => json.Value.Object([("fixed", json.Value.Str(x.value()))])
    RightOf(x) => json.Value.Object([("rightOf", json.Value.Str(x))])
    Below(x) => json.Value.Object([("below", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_field_position(v: json.Value) -> FieldPosition ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "fixed" => Ok(FieldPosition.Fixed(FixedPosition.from(jsonv.read_str(fv)?)))
      "rightOf" => Ok(FieldPosition.RightOf(jsonv.read_str(fv)?))
      "below" => Ok(FieldPosition.Below(jsonv.read_str(fv)?))
      _ => Ok(FieldPosition.Unknown(k))
    }
  }
  Err("FieldPosition: no member set")
}

