  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(AcceptAdministratorInvitationErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_accept_administrator_invitation_error(resp))
  }
  deserialize_accept_administrator_invitation(resp) ?? e => Err(AcceptAdministratorInvitationErr.Deserialize(e))
