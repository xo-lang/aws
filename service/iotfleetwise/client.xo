fn json_of_data_destination_config(v: DataDestinationConfig) -> json.Value {
  match v {
    S3Config(x) => json.Value.Object([("s3Config", json_of_s3_config(x))])
    TimestreamConfig(x) => json.Value.Object([("timestreamConfig", json_of_timestream_config(x))])
    MqttTopicConfig(x) => json.Value.Object([("mqttTopicConfig", json_of_mqtt_topic_config(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_data_destination_config(v: json.Value) -> DataDestinationConfig ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "s3Config" => Ok(DataDestinationConfig.S3Config(from_json_s3_config(fv)?))
      "timestreamConfig" => Ok(DataDestinationConfig.TimestreamConfig(from_json_timestream_config(fv)?))
      "mqttTopicConfig" => Ok(DataDestinationConfig.MqttTopicConfig(from_json_mqtt_topic_config(fv)?))
      _ => Ok(DataDestinationConfig.Unknown(k))
    }
  }
  Err("DataDestinationConfig: no member set")
}

fn json_of_data_destination_configs(v: List[DataDestinationConfig]) -> json.Value {
  json.Value.List(v.map(fn(x: DataDestinationConfig) -> json.Value { json_of_data_destination_config(x) }))
}

fn from_json_data_destination_configs(v: json.Value) -> List[DataDestinationConfig] ! Str {
  var out: List[DataDestinationConfig] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_data_destination_config(fv)?)
  }
  Ok(out)
}

