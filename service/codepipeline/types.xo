  pub status: ConditionExecutionStatus? = None
  /// The summary of information about a run for a condition.
  pub summary: Str? = None
  /// The last status change of the condition.
  pub last_status_change: Time? = None
}

pub enum ConditionExecutionStatus: Str {
  InProgress = "InProgress"
  Failed = "Failed"
  Errored = "Errored"
  Succeeded = "Succeeded"
  Cancelled = "Cancelled"
  Abandoned = "Abandoned"
  Overridden = "Overridden"
  Unknown(value: Str)
}

/// Unable to override because the condition does not allow overrides.
pub struct ConditionNotOverridableException {
  pub message: Str? = None
}

/// Information about the state of the condition.
pub struct ConditionState {
  /// The state of the latest run of the rule.
  pub latest_execution: ConditionExecution? = None
  /// The state of the rules for the condition.
  pub rule_states: List[RuleState]? = None
}

pub enum ConditionType: Str {
  BeforeEntry = "BEFORE_ENTRY"
  OnSuccess = "ON_SUCCESS"
  Unknown(value: Str)
}

