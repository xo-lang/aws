pub enum QueryStatus: Str {
  Running = "Running"
  Failed = "Failed"
  Complete = "Complete"
  Cancelled = "Cancelled"
  Unknown(value: Str)
}

/// The specified resource does not exist.
pub struct ResourceNotFoundException {
  pub message: Str? = None
  /// The type of the resource that could not be found. Not always present.
  pub resource_type: Str? = None
  /// The identifier of the resource that could not be found. Not always
  /// present.
  pub resource_id: Str? = None
  /// The error code associated with the failure.
  pub error_code: Str? = None
}

/// A single resource scope entry within an AccessGrant. Associates a
/// resource type with optional ARN patterns, tag conditions, and row-level
/// filters.
pub struct ResourceScope {
  /// Resource type name (e.g., "DataSet", "OmniDashboard").
  pub resource_type: Str? = None
  /// Specific resource ARNs or ARN patterns. When set, actions are limited to
  /// these resources. When absent, defaults to "*".
  pub resource_arns: List[Str]? = None
  /// Tag-based conditions for dynamic resource scoping. Access applies only
  /// to resources carrying all of the specified tag key/value pairs.
  pub tags: Map[Str, Str]? = None
  /// Signal types this scope's row filtering applies to. Required when
  /// rowScopeGroups is set.
  pub signal_types: List[SignalType]? = None
  /// Row-level filters for this scope, as an OR of AND-groups: a row is
  /// visible when it matches every filter in any one group. Requires
  /// signalTypes. Row filters are additive across a principal's matching
  /// grants. A signal type with no matching group is unrestricted, and when
  /// rowScopeGroups is omitted all rows are visible for all signal types.
  pub row_scope_groups: List[List[RowScope]]? = None
}

/// A single additive row-level filter on an AccessGrant. A row is visible
/// when its value for the given field matches the filter's values. Row
/// filters are additive: the visible rows are the union of all row filters
/// across a principal's matching grants.
pub struct RowScope {
  /// The field (column) the allowlist applies to (e.g., "serviceName",
  /// "accountId").
  pub field: Str? = None
  /// Match operator applied to this filter's values.
  pub operator: RowScopeOperator? = None
  /// The values the field is matched against.
  pub values: List[Str]? = None
}

/// Match operator for a row-scope filter. Only IN is supported.
pub enum RowScopeOperator: Str {
  In = "IN"
  Unknown(value: Str)
}

/// Top-level rule definition. {@code telemetryRule} members are optional at
/// the Smithy level to support PATCH semantics on UpdateAlert (send only
/// the sub-blocks you want to change). On CreateAlert, presence is enforced
/// by the service-side validator.
pub enum Rule {
  TelemetryRule(value: TelemetryRule)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// Whether an integration is account-scoped (customer-created) or
/// organization-scoped (created by an org-enablement rule on behalf of the
/// destination account). Mirrors the {@code Scope} discriminator used by
/// CloudWatch Centralization / Observability Admin.
pub enum Scope: Str {
  Account = "ACCOUNT"
  Organization = "ORGANIZATION"
  Unknown(value: Str)
}

/// A group of actions within an access grant, together with the resource
/// scopes and context conditions that apply to exactly those actions.
pub struct ScopedActions {
  /// The actions this group applies to.
  pub actions: List[Str]? = None
  /// Optional resource scopes constraining these actions to specific
  /// resources.
  pub resources: List[ResourceScope]? = None
  /// Optional context conditions for fine-grained access control on these
  /// actions.
  pub context_conditions: Map[Str, List[Str]]? = None
}

pub struct SearchPrincipalsInput {
  /// The ID of the domain to search within.
  pub domain_id: Str? = None
  /// A search term to match against user names, display names, and IDs. Pass
  /// * to list all principals. Maximum 128 characters.
  pub search_query: Str? = None
  /// The maximum number of results to return. Defaults to 100.
  pub max_results: Int? = None
  /// A token to retrieve the next page of results. Supply the same
  /// searchQuery used on the request that returned it. Tokens expire after 24
  /// hours.
  pub next_token: Str? = None
}

pub struct SearchPrincipalsOutput {
  /// The list of matching principals.
  pub results: List[PrincipalSearchResult]? = None
  /// A token to retrieve the next page of results, or null if there are no
  /// more results.
  pub next_token: Str? = None
}

/// A service quota was exceeded.
pub struct ServiceQuotaExceededException {
