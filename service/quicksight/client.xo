  }
  if let Some(x) = v.print_reports {
    fs.push(("PrintReports", json.Value.Str(x.value())))
  }
  if let Some(x) = v.create_and_update_themes {
    fs.push(("CreateAndUpdateThemes", json.Value.Str(x.value())))
  }
  if let Some(x) = v.add_or_run_anomaly_detection_for_analyses {
    fs.push(("AddOrRunAnomalyDetectionForAnalyses", json.Value.Str(x.value())))
  }
  if let Some(x) = v.share_analyses {
    fs.push(("ShareAnalyses", json.Value.Str(x.value())))
  }
  if let Some(x) = v.create_and_update_datasets {
    fs.push(("CreateAndUpdateDatasets", json.Value.Str(x.value())))
  }
  if let Some(x) = v.share_datasets {
    fs.push(("ShareDatasets", json.Value.Str(x.value())))
  }
