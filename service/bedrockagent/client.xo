fn json_of_content_block(v: ContentBlock) -> json.Value {
  match v {
    Text(x) => json.Value.Object([("text", json.Value.Str(x))])
    CachePoint(x) => json.Value.Object([("cachePoint", json_of_cache_point_block(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_content_block(v: json.Value) -> ContentBlock ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "text" => Ok(ContentBlock.Text(jsonv.read_str(fv)?))
      "cachePoint" => Ok(ContentBlock.CachePoint(from_json_cache_point_block(fv)?))
      _ => Ok(ContentBlock.Unknown(k))
    }
  }
  Err("ContentBlock: no member set")
}

fn json_of_content_blocks(v: List[ContentBlock]) -> json.Value {
  json.Value.List(v.map(fn(x: ContentBlock) -> json.Value { json_of_content_block(x) }))
}

fn from_json_content_blocks(v: json.Value) -> List[ContentBlock] ! Str {
  var out: List[ContentBlock] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_content_block(fv)?)
  }
  Ok(out)
}

