  /// The image used for the container.
  pub image: Str? = None
  /// The container image manifest digest.
  pub image_digest: Str? = None
  /// The ID of the Docker container.
  pub runtime_id: Str? = None
  /// The last known status of the container.
  pub last_status: Str? = None
  /// The exit code returned from the container.
  pub exit_code: Int? = None
  /// A short (1024 max characters) human-readable string to provide
  /// additional details about a running or stopped container.
  pub reason: Str? = None
  /// The network bindings associated with the container.
  pub network_bindings: List[NetworkBinding]? = None
  /// The network interfaces associated with the container.
  pub network_interfaces: List[NetworkInterface]? = None
  /// The health status of the container. If health checks aren't configured
  /// for this container in its task definition, then it reports the health
  /// status as UNKNOWN .
  pub health_status: HealthStatus? = None
  /// The details of any Amazon ECS managed agents associated with the
  /// container.
  pub managed_agents: List[ManagedAgent]? = None
  /// The number of CPU units set for the container. The value is 0 if no
  /// value was specified in the container definition when the task definition
  /// was registered.
  pub cpu: Str? = None
  /// The hard limit (in MiB) of memory set for the container.
  pub memory: Str? = None
  /// The soft limit (in MiB) of memory set for the container.
  pub memory_reservation: Str? = None
  /// The IDs of each GPU assigned to the container.
  pub gpu_ids: List[Str]? = None
  /// The IDs of each Neuron device assigned to the container.
  pub neuron_device_ids: List[Str]? = None
  /// The GPU sharing strategy that the task definition specifies for the
  /// container. This field is present only for containers whose resource
  /// requirements include sharingStrategy .
  pub gpu_sharing_strategy: SharingStrategy? = None
}

