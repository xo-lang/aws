fn xml_write_nested_xml_maps_request(var w: xmlv.Writer, v: NestedXmlMapsRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.nested_map {
    xml_write_nested_map(w, x, "nestedMap", [])
  }
  if let Some(x) = v.flat_nested_map {
    for (k, item) in x.entries() {
      xmlv.start(w, "flatNestedMap", [])
      xmlv.elem(w, "key", k, [])
      xml_write_foo_enum_map(w, item, "value", [])
      xmlv.end(w, "flatNestedMap")
    }
  }
  xmlv.end(w, name)
}

