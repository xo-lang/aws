fn query_put_access_policies_status(var f: query.Form, prefix: Str, v: AccessPoliciesStatus) {
  if let Some(x) = v.options {
    query.add(f, query.key(prefix, "Options"), x)
  }
  if let Some(x) = v.status {
    query_put_option_status(f, query.key(prefix, "Status"), x)
  }
}

fn query_put_analysis_options(var f: query.Form, prefix: Str, v: AnalysisOptions) {
  if let Some(x) = v.synonyms {
    query.add(f, query.key(prefix, "Synonyms"), x)
  }
  if let Some(x) = v.stopwords {
    query.add(f, query.key(prefix, "Stopwords"), x)
  }
  if let Some(x) = v.stemming_dictionary {
    query.add(f, query.key(prefix, "StemmingDictionary"), x)
  }
