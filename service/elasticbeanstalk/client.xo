    xmlv.elem(w, "EndpointURL", x, [])
  }
  if let Some(x) = v.cname {
    xmlv.elem(w, "CNAME", x, [])
  }
  if let Some(x) = v.date_created {
    xmlv.elem(w, "DateCreated", rest.date_time(x), [])
  }
  if let Some(x) = v.date_updated {
    xmlv.elem(w, "DateUpdated", rest.date_time(x), [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.abortable_operation_in_progress {
    xmlv.elem(w, "AbortableOperationInProgress", "${x}", [])
  }
  if let Some(x) = v.health {
    xmlv.elem(w, "Health", x.value(), [])
  }
  if let Some(x) = v.health_status {
    xmlv.elem(w, "HealthStatus", x.value(), [])
  }
  if let Some(x) = v.resources {
    xml_write_environment_resources_description(w, x, "Resources", [])
  }
  if let Some(x) = v.tier {
    xml_write_environment_tier(w, x, "Tier", [])
  }
  if let Some(x) = v.environment_links {
    xml_write_environment_links(w, x, "EnvironmentLinks", [])
  }
  if let Some(x) = v.environment_arn {
    xmlv.elem(w, "EnvironmentArn", x, [])
  }
  if let Some(x) = v.operations_role {
    xmlv.elem(w, "OperationsRole", x, [])
  }
  xmlv.end(w, name)
