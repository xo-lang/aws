      "TwoWayMediaS3BucketName" => out.two_way_media_s3_bucket_name = jsonv.read_str(fv)?
      "TwoWayMediaS3KeyPrefix" => out.two_way_media_s3_key_prefix = jsonv.read_str(fv)?
      "TwoWayMediaS3Role" => out.two_way_media_s3_role = jsonv.read_str(fv)?
      "TwoWayRcsEventsEnabled" => out.two_way_rcs_events_enabled = from_json_rcs_event_type_list(fv)?
      "TestingAgent" => out.testing_agent = from_json_testing_agent_information(fv)?
      "MessagingLimits" => out.messaging_limits = from_json_messaging_limits(fv)?
      _ => {}
    }
