fn xml_read_client_vpn_connection(e: xml.Element) -> ClientVpnConnection ! Str {
  var out = ClientVpnConnection{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "clientVpnEndpointId" => out.client_vpn_endpoint_id = c.text()
      "timestamp" => out.timestamp = c.text()
      "connectionId" => out.connection_id = c.text()
      "username" => out.username = c.text()
      "connectionEstablishedTime" => out.connection_established_time = c.text()
      "ingressBytes" => out.ingress_bytes = c.text()
      "egressBytes" => out.egress_bytes = c.text()
      "ingressPackets" => out.ingress_packets = c.text()
      "egressPackets" => out.egress_packets = c.text()
      "clientIp" => out.client_ip = c.text()
      "clientIpv6Address" => out.client_ipv6_address = c.text()
      "commonName" => out.common_name = c.text()
      "status" => out.status = xml_read_client_vpn_connection_status(c)?
      "connectionEndTime" => out.connection_end_time = c.text()
      "postureComplianceStatusSet" => out.posture_compliance_statuses = xml_read_value_string_list(c)?
      "authorizationPolicyLastEvaluatedTime" => out.authorization_policy_last_evaluated_time = c.text()
      _ => {}
    }
  }
  Ok(out)
}

