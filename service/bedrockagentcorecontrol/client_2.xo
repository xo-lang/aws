fn json_of_schema_definition(v: SchemaDefinition) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.type_value {
    fs.push(("type", json.Value.Str(x.value())))
  }
  if let Some(x) = v.properties {
    fs.push(("properties", json_of_schema_properties(x)))
  }
  if let Some(x) = v.required {
    fs.push(("required", json_of_required_properties(x)))
  }
  if let Some(x) = v.items {
    fs.push(("items", json_of_schema_definition(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_schema_definition(v: json.Value) -> SchemaDefinition ! Str {
  var out = SchemaDefinition{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "type" => out.type_value = SchemaType.from(jsonv.read_str(fv)?)
      "properties" => out.properties = from_json_schema_properties(fv)?
      "required" => out.required = from_json_required_properties(fv)?
      "items" => out.items = from_json_schema_definition(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_schema_properties(v: Map[Str, SchemaDefinition]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, SchemaDefinition)) -> (Str, json.Value) { (e.0, json_of_schema_definition(e.1)) }))
}

fn from_json_schema_properties(v: json.Value) -> Map[Str, SchemaDefinition] ! Str {
  var out: Map[Str, SchemaDefinition] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_schema_definition(fv)?)
  }
  Ok(out)
}

