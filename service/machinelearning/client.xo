  }
  if let Some(x) = v.created_by_iam_user {
    fs.push(("CreatedByIamUser", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_updated_at {
    fs.push(("LastUpdatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.data_size_in_bytes {
    fs.push(("DataSizeInBytes", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_files {
    fs.push(("NumberOfFiles", json.Value.Int(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.message {
    fs.push(("Message", json.Value.Str(x)))
  }
  if let Some(x) = v.redshift_metadata {
    fs.push(("RedshiftMetadata", json_of_redshift_metadata(x)))
  }
  if let Some(x) = v.rds_metadata {
    fs.push(("RDSMetadata", json_of_rds_metadata(x)))
  }
  if let Some(x) = v.role_arn {
    fs.push(("RoleARN", json.Value.Str(x)))
  }
  if let Some(x) = v.compute_statistics {
    fs.push(("ComputeStatistics", json.Value.Bool(x)))
  }
  if let Some(x) = v.compute_time {
    fs.push(("ComputeTime", json.Value.Int(x)))
  }
  if let Some(x) = v.finished_at {
    fs.push(("FinishedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.started_at {
    fs.push(("StartedAt", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_data_source(v: json.Value) -> DataSource ! Str {
  var out = DataSource{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "DataSourceId" => out.data_source_id = jsonv.read_str(fv)?
      "DataLocationS3" => out.data_location_s3 = jsonv.read_str(fv)?
      "DataRearrangement" => out.data_rearrangement = jsonv.read_str(fv)?
      "CreatedByIamUser" => out.created_by_iam_user = jsonv.read_str(fv)?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "LastUpdatedAt" => out.last_updated_at = jsonv.read_time(fv, "epoch-seconds")?
      "DataSizeInBytes" => out.data_size_in_bytes = jsonv.read_int(fv)?
      "NumberOfFiles" => out.number_of_files = jsonv.read_int(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "Status" => out.status = EntityStatus.from(jsonv.read_str(fv)?)
      "Message" => out.message = jsonv.read_str(fv)?
      "RedshiftMetadata" => out.redshift_metadata = from_json_redshift_metadata(fv)?
      "RDSMetadata" => out.rds_metadata = from_json_rds_metadata(fv)?
      "RoleARN" => out.role_arn = jsonv.read_str(fv)?
      "ComputeStatistics" => out.compute_statistics = jsonv.read_bool(fv)?
      "ComputeTime" => out.compute_time = jsonv.read_int(fv)?
      "FinishedAt" => out.finished_at = jsonv.read_time(fv, "epoch-seconds")?
      "StartedAt" => out.started_at = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_data_sources(v: List[DataSource]) -> json.Value {
  json.Value.List(v.map(fn(x: DataSource) -> json.Value { json_of_data_source(x) }))
}

fn from_json_data_sources(v: json.Value) -> List[DataSource] ! Str {
  var out: List[DataSource] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_data_source(fv)?)
  }
  Ok(out)
}

