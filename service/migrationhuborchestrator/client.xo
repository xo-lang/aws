    StringValue(x) => json.Value.Object([("stringValue", json.Value.Str(x))])
    ListOfStringsValue(x) => json.Value.Object([("listOfStringsValue", json_of_string_list(x))])
    MapOfStringValue(x) => json.Value.Object([("mapOfStringValue", json_of_string_map(x))])
