fn query_put_upgrade_target(var f: query.Form, prefix: Str, v: UpgradeTarget) {
  if let Some(x) = v.engine {
    query.add(f, query.key(prefix, "Engine"), x)
  }
  if let Some(x) = v.engine_version {
    query.add(f, query.key(prefix, "EngineVersion"), x)
  }
  if let Some(x) = v.description {
    query.add(f, query.key(prefix, "Description"), x)
  }
  if let Some(x) = v.auto_upgrade {
    query.add(f, query.key(prefix, "AutoUpgrade"), "${x}")
  }
  if let Some(x) = v.is_major_version_upgrade {
    query.add(f, query.key(prefix, "IsMajorVersionUpgrade"), "${x}")
  }
  if let Some(x) = v.supported_engine_modes {
    query_put_engine_mode_list(f, query.key(prefix, "SupportedEngineModes"), x, false)
  }
  if let Some(x) = v.supports_parallel_query {
    query.add(f, query.key(prefix, "SupportsParallelQuery"), "${x}")
  }
  if let Some(x) = v.supports_global_databases {
    query.add(f, query.key(prefix, "SupportsGlobalDatabases"), "${x}")
  }
  if let Some(x) = v.supports_babelfish {
    query.add(f, query.key(prefix, "SupportsBabelfish"), "${x}")
  }
  if let Some(x) = v.supports_limitless_database {
    query.add(f, query.key(prefix, "SupportsLimitlessDatabase"), "${x}")
  }
  if let Some(x) = v.supports_local_write_forwarding {
    query.add(f, query.key(prefix, "SupportsLocalWriteForwarding"), "${x}")
  }
  if let Some(x) = v.supports_integrations {
    query.add(f, query.key(prefix, "SupportsIntegrations"), "${x}")
  }
}

