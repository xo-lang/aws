fn xml_read_managed_prefix_list(e: xml.Element) -> ManagedPrefixList ! Str {
  var out = ManagedPrefixList{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "prefixListId" => out.prefix_list_id = c.text()
      "addressFamily" => out.address_family = c.text()
      "state" => out.state = PrefixListState.from(c.text())
      "stateMessage" => out.state_message = c.text()
      "prefixListArn" => out.prefix_list_arn = c.text()
      "prefixListName" => out.prefix_list_name = c.text()
      "maxEntries" => out.max_entries = xmlv.read_int(c.text())?
