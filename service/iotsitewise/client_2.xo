fn json_of_response_stream(v: ResponseStream) -> json.Value {
  match v {
    Trace(x) => json.Value.Object([("trace", json_of_trace(x))])
    Output(x) => json.Value.Object([("output", json_of_invocation_output(x))])
    AccessDeniedException(x) => json.Value.Object([("accessDeniedException", json_of_access_denied_exception(x))])
    ConflictingOperationException(x) => json.Value.Object([("conflictingOperationException", json_of_conflicting_operation_exception(x))])
    InternalFailureException(x) => json.Value.Object([("internalFailureException", json_of_internal_failure_exception(x))])
    InvalidRequestException(x) => json.Value.Object([("invalidRequestException", json_of_invalid_request_exception(x))])
    LimitExceededException(x) => json.Value.Object([("limitExceededException", json_of_limit_exceeded_exception(x))])
    ResourceNotFoundException(x) => json.Value.Object([("resourceNotFoundException", json_of_resource_not_found_exception(x))])
    ThrottlingException(x) => json.Value.Object([("throttlingException", json_of_throttling_exception(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_response_stream(v: json.Value) -> ResponseStream ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "trace" => Ok(ResponseStream.Trace(from_json_trace(fv)?))
      "output" => Ok(ResponseStream.Output(from_json_invocation_output(fv)?))
      "accessDeniedException" => Ok(ResponseStream.AccessDeniedException(from_json_access_denied_exception(fv)?))
      "conflictingOperationException" => Ok(ResponseStream.ConflictingOperationException(from_json_conflicting_operation_exception(fv)?))
      "internalFailureException" => Ok(ResponseStream.InternalFailureException(from_json_internal_failure_exception(fv)?))
      "invalidRequestException" => Ok(ResponseStream.InvalidRequestException(from_json_invalid_request_exception(fv)?))
      "limitExceededException" => Ok(ResponseStream.LimitExceededException(from_json_limit_exceeded_exception(fv)?))
      "resourceNotFoundException" => Ok(ResponseStream.ResourceNotFoundException(from_json_resource_not_found_exception(fv)?))
      "throttlingException" => Ok(ResponseStream.ThrottlingException(from_json_throttling_exception(fv)?))
      _ => Ok(ResponseStream.Unknown(k))
    }
  }
  Err("ResponseStream: no member set")
}

