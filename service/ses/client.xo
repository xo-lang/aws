fn xml_write_dkim_attributes(var w: xmlv.Writer, v: Map[Str, IdentityDkimAttributes], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xml_write_identity_dkim_attributes(w, item, "value", [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_dkim_attributes(e: xml.Element) -> Map[Str, IdentityDkimAttributes] ! Str {
  var out: Map[Str, IdentityDkimAttributes] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, xml_read_identity_dkim_attributes(vc)?)
    }
  }
  Ok(out)
}

fn xml_write_event_destination(var w: xmlv.Writer, v: EventDestination, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.enabled {
    xmlv.elem(w, "Enabled", "${x}", [])
  }
  if let Some(x) = v.matching_event_types {
    xml_write_event_types(w, x, "MatchingEventTypes", [])
  }
  if let Some(x) = v.kinesis_firehose_destination {
    xml_write_kinesis_firehose_destination(w, x, "KinesisFirehoseDestination", [])
  }
  if let Some(x) = v.cloud_watch_destination {
    xml_write_cloud_watch_destination(w, x, "CloudWatchDestination", [])
  }
  if let Some(x) = v.sns_destination {
    xml_write_sns_destination(w, x, "SNSDestination", [])
  }
  xmlv.end(w, name)
}

fn xml_read_event_destination(e: xml.Element) -> EventDestination ! Str {
  var out = EventDestination{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Name" => out.name = c.text()
      "Enabled" => out.enabled = xmlv.read_bool(c.text())?
      "MatchingEventTypes" => out.matching_event_types = xml_read_event_types(c)?
      "KinesisFirehoseDestination" => out.kinesis_firehose_destination = xml_read_kinesis_firehose_destination(c)?
      "CloudWatchDestination" => out.cloud_watch_destination = xml_read_cloud_watch_destination(c)?
      "SNSDestination" => out.sns_destination = xml_read_sns_destination(c)?
      _ => {}
    }
  }
  Ok(out)
}

