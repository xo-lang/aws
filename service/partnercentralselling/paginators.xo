pub fn (var p: SearchOpportunitiesPaginator) next_page() -> SearchOpportunitiesResponse ! SearchOpportunitiesErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.search_opportunities(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
