pub struct SearchAssetsInput {
  /// The text to search for. At least one of searchText or filterClause must
  /// be provided.
  pub search_text: Str? = None
  /// The maximum number of results to return in the response.
  pub max_results: Int? = None
  /// A continuation token, if this is a continuation call.
  pub next_token: Str? = None
  /// The sort criteria for the search results.
  pub sort: SearchSort? = None
  /// The filter clause to apply to the search. Supports nested AND/OR logic
  /// with attribute-level and map-level filters.
  pub filter_clause: SearchFilterClause? = None
}

/// The search results returned by the SearchAssets operation.
pub struct SearchAssetsOutput {
  /// The list of assets matching the search criteria.
  pub items: List[SearchResultItem]? = None
  /// A continuation token, present if the current segment is not the last.
  pub next_token: Str? = None
}

/// A filter that compares an attribute value using an operator.
pub struct SearchAttributeFilter {
  /// The attribute name to filter on.
  pub attribute: Str? = None
  /// The comparison operator. Valid values are equals , greaterThan ,
  /// greaterThanOrEquals , lessThan , lessThanOrEquals , and notExists .
  pub operator: SearchFilterOperator? = None
  /// The value to compare against.
  pub value: SearchFilterValue? = None
}

/// A filter clause that supports nested boolean logic. Exactly one of
/// andAllFilters , orAnyFilters , attributeFilter , or mapFilter must be
/// specified.
pub enum SearchFilterClause {
  AndAllFilters(value: List[SearchFilterClause])
  OrAnyFilters(value: List[SearchFilterClause])
  AttributeFilter(value: SearchAttributeFilter)
  MapFilter(value: SearchMapFilter)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

pub enum SearchFilterOperator: Str {
  Equals = "equals"
  GreaterThan = "greaterThan"
  GreaterThanOrEquals = "greaterThanOrEquals"
  LessThan = "lessThan"
  LessThanOrEquals = "lessThanOrEquals"
  NotExists = "notExists"
  Unknown(value: Str)
}

/// A filter value. Exactly one of stringValue or longValue must be
/// specified.
pub enum SearchFilterValue {
  StringValue(value: Str)
  LongValue(value: Int)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// A filter on a map attribute's key-value pair.
pub struct SearchMapFilter {
  /// The map attribute name to filter on.
  pub attribute: Str? = None
  /// The key within the map attribute to filter on.
  pub key: Str? = None
  /// The value to compare against.
  pub value: SearchMapFilterValue? = None
}

/// A map filter value. Currently supports string comparison only.
pub enum SearchMapFilterValue {
  StringValue(value: Str)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// A single search result item representing a matched asset.
pub struct SearchResultItem {
  /// The unique identifier of the matched asset.
  pub id: Str? = None
  /// The name of the matched asset.
  pub asset_name: Str? = None
  /// The description of the matched asset.
  pub asset_description: Str? = None
  /// The timestamp at which the matched asset was last updated.
  pub updated_at: Time? = None
  /// The identifier of the asset type for the matched asset.
  pub asset_type_id: Str? = None
}

/// The sort criteria for search results.
pub struct SearchSort {
  /// The attribute to sort by.
  pub attribute: Str? = None
  /// The sort order. Valid values are ASCENDING and DESCENDING .
  pub order: SearchSortOrder? = None
}

pub enum SearchSortOrder: Str {
  Ascending = "ASCENDING"
  Descending = "DESCENDING"
  Unknown(value: Str)
}

pub struct SearchTablesRequest {
  /// A unique identifier, consisting of account_id .
  pub catalog_id: Str? = None
  /// A continuation token, included if this is a continuation call.
  pub next_token: Str? = None
  /// A list of key-value pairs, and a comparator used to filter the search
  /// results. Returns all entities matching the predicate. The Comparator
  /// member of the PropertyPredicate struct is used only for time fields, and
  /// can be omitted for other field types. Also, when comparing string
  /// values, such as when Key=Name , a fuzzy match algorithm is used. The Key
  /// field (for example, the value of the Name field) is split on certain
  /// punctuation characters, for example, -, :, #, etc. into tokens. Then
  /// each token is exact-match compared with the Value member of
  /// PropertyPredicate . For example, if Key=Name and Value=link , tables
  /// named customer-link and xx-link-yy are returned, but xxlinkyy is not
  /// returned.
  pub filters: List[PropertyPredicate]? = None
  /// A string used for a text search. Specifying a value in quotes filters
  /// based on an exact match to the value.
  pub search_text: Str? = None
  /// A list of criteria for sorting the results by a field name, in an
  /// ascending or descending order.
  pub sort_criteria: List[SortCriterion]? = None
  /// The maximum number of tables to return in a single response.
  pub max_results: Int? = None
  /// Allows you to specify that you want to search the tables shared with
  /// your account. The allowable values are FOREIGN or ALL . If set to
  /// FOREIGN , will search the tables shared with your account. If set to ALL
  /// , will search the tables shared with your account, as well as the tables
  /// in yor local account.
  pub resource_share_type: ResourceShareType? = None
  /// Specifies whether to include status details related to a request to
  /// create or update an Glue Data Catalog view.
  pub include_status_details: Bool? = None
}

pub struct SearchTablesResponse {
  /// A continuation token, present if the current list segment is not the
  /// last.
  pub next_token: Str? = None
  /// A list of the requested Table objects. The SearchTables response returns
  /// only the tables that you have access to.
  pub table_list: List[Table]? = None
}

