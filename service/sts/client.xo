fn xml_write_tag_key_list_type(var w: xmlv.Writer, v: List[Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xmlv.elem(w, "member", item, [])
  }
  xmlv.end(w, name)
}

fn xml_read_tag_key_list_type(e: xml.Element) -> List[Str] ! Str {
  var out: List[Str] = []
  for c in xmlv.elements(e) {
    out.push(c.text())
  }
  Ok(out)
}

fn xml_write_tag_list_type(var w: xmlv.Writer, v: List[Tag], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_tag(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_tag_list_type(e: xml.Element) -> List[Tag] ! Str {
  var out: List[Tag] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_tag(c)?)
  }
  Ok(out)
}

fn xml_write_web_identity_token_audience_list_type(var w: xmlv.Writer, v: List[Str], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xmlv.elem(w, "member", item, [])
  }
  xmlv.end(w, name)
}

fn xml_read_web_identity_token_audience_list_type(e: xml.Element) -> List[Str] ! Str {
  var out: List[Str] = []
  for c in xmlv.elements(e) {
    out.push(c.text())
  }
  Ok(out)
}

