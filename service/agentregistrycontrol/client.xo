  }
  if let Some(x) = input.discovery_configuration {
    fs.push(("discoveryConfiguration", json_of_discovery_configuration(x)))
  }
  if let Some(x) = input.client_token {
    fs.push(("clientToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("clientToken", json.Value.Str(idempotency_token)))
  }
