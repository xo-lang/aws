/// Represents a service in Resilience Hub. A service is the primary unit of
/// resilience assessment.
pub struct Service {
  pub service_arn: Str? = None
  pub name: Str? = None
  pub description: Str? = None
  /// The systems associated with the service.
  pub associated_systems: List[AssociatedSystem]? = None
  pub policy_arn: Str? = None
  /// The Regions where the service operates.
  pub regions: List[Str]? = None
  /// The permission model for the service.
  pub permission_model: PermissionModel? = None
  /// The dependency discovery configuration for the service.
  pub dependency_discovery: DependencyDiscoveryConfig? = None
  /// The effective policy values for the service.
  pub effective_policy_values: EffectivePolicyValues? = None
  /// The achievability status of the service's resilience targets.
  pub achievability: Achievability? = None
  pub report_configuration: ServiceReportConfiguration? = None
  pub kms_key_id: Str? = None
  pub tags: Map[Str, Str]? = None
  /// The estimated cost of running an assessment on the service.
  pub estimated_assessment_cost: AssessmentCost? = None
  /// The resource discovery status for the service.
  pub resource_discovery: ResourceDiscoveryStatus? = None
  /// The current assessment status of the service.
  pub assessment_status: AssessmentStatus? = None
  /// Indicates whether the assessment should be rerun.
  pub rerun_assessment: Bool? = None
  /// The number of open findings for the service.
  pub open_findings_count: Int? = None
  /// The number of resolved findings for the service.
  pub resolved_findings_count: Int? = None
  /// The AWS Organizations identifier for the service.
  pub organization_id: Str? = None
  /// The organizational unit (OU) identifier for the service.
  pub ou_id: Str? = None
  /// The AWS account ID that owns the service.
  pub account_id: Str? = None
  /// The current DevOps Agent integration state for the service.
  pub dev_ops_agent_configuration: DevOpsAgentConfigurationView? = None
  /// The timestamp when the service was created.
  pub created_at: Time? = None
  /// The timestamp when the service was last updated.
  pub updated_at: Time? = None
}

