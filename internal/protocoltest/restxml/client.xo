fn xml_write_nested_map(var w: xmlv.Writer, v: Map[Str, Map[Str, FooEnum]], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for (k, item) in v.entries() {
    xmlv.start(w, "entry")
    xmlv.elem(w, "key", k, [])
    xml_write_foo_enum_map(w, item, "value", [])
    xmlv.end(w, "entry")
  }
  xmlv.end(w, name)
}

fn xml_read_nested_map(e: xml.Element) -> Map[Str, Map[Str, FooEnum]] ! Str {
  var out: Map[Str, Map[Str, FooEnum]] = {}
  for entry in xmlv.elements(e) {
    let k = xmlv.child_text(entry, "key") ?? ""
    if let Some(vc) = entry.child("value") {
      out.put(k, xml_read_foo_enum_map(vc)?)
    }
  }
  Ok(out)
}

