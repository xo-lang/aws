/// Contains code coverage report information. Line coverage measures how
/// many statements your tests cover. A statement is a single instruction,
/// not including comments, conditionals, etc. Branch coverage determines if
/// your tests cover every possible branch of a control structure, such as
/// an if or case statement.
pub struct CodeCoverage {
  /// The identifier of the code coverage report.
  pub id: Str? = None
  /// The ARN of the report.
  pub report_arn: Str? = None
  /// The path of the test report file.
  pub file_path: Str? = None
  /// The percentage of lines that are covered by your tests.
  pub line_coverage_percentage: Float? = None
  /// The number of lines that are covered by your tests.
  pub lines_covered: Int? = None
  /// The number of lines that are not covered by your tests.
  pub lines_missed: Int? = None
  /// The percentage of branches that are covered by your tests.
  pub branch_coverage_percentage: Float? = None
  /// The number of conditional branches that are covered by your tests.
  pub branches_covered: Int? = None
  /// The number of conditional branches that are not covered by your tests.
  pub branches_missed: Int? = None
  /// The date and time that the tests were run.
  pub expired: Time? = None
}

/// Contains a summary of a code coverage report. Line coverage measures how
/// many statements your tests cover. A statement is a single instruction,
/// not including comments, conditionals, etc. Branch coverage determines if
/// your tests cover every possible branch of a control structure, such as
/// an if or case statement.
pub struct CodeCoverageReportSummary {
  /// The percentage of lines that are covered by your tests.
  pub line_coverage_percentage: Float? = None
  /// The number of lines that are covered by your tests.
  pub lines_covered: Int? = None
  /// The number of lines that are not covered by your tests.
  pub lines_missed: Int? = None
  /// The percentage of branches that are covered by your tests.
  pub branch_coverage_percentage: Float? = None
  /// The number of conditional branches that are covered by your tests.
  pub branches_covered: Int? = None
  /// The number of conditional branches that are not covered by your tests.
  pub branches_missed: Int? = None
}

/// Contains command execution information.
pub struct CommandExecution {
  /// The ID of the command execution.
  pub id: Str? = None
  /// A sandboxId .
  pub sandbox_id: Str? = None
  /// When the command execution process was initially submitted, expressed in
  /// Unix time format.
  pub submit_time: Time? = None
  /// When the command execution process started, expressed in Unix time
  /// format.
  pub start_time: Time? = None
  /// When the command execution process ended, expressed in Unix time format.
  pub end_time: Time? = None
  /// The status of the command execution.
  pub status: Str? = None
  /// The command that needs to be executed.
  pub command: Str? = None
  /// The command type.
  pub type_value: CommandType? = None
  /// The exit code to return upon completion.
  pub exit_code: Str? = None
  /// The text written by the command to stdout.
  pub standard_output_content: Str? = None
  /// The text written by the command to stderr.
  pub standard_err_content: Str? = None
  pub logs: LogsLocation? = None
  /// A sandboxArn .
  pub sandbox_arn: Str? = None
}

pub enum CommandType: Str {
  Shell = "SHELL"
  Unknown(value: Str)
}

