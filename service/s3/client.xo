fn xml_write_delete(var w: xmlv.Writer, v: Delete, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.objects {
    for item in x {
      xml_write_object_identifier(w, item, "Object", [])
    }
  }
  if let Some(x) = v.quiet {
    xmlv.elem(w, "Quiet", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_delete(e: xml.Element) -> Delete ! Str {
  var out = Delete{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Object" => {
        var items = out.objects ?? []
        items.push(xml_read_object_identifier(c)?)
        out.objects = items
      }
      "Quiet" => out.quiet = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

