  /// A cluster query language expression to apply to the constraint. For more
  /// information, see Cluster query language in the Amazon Elastic Container
  /// Service Developer Guide .
  pub expression: Str? = None
}

pub enum TaskDefinitionPlacementConstraintType: Str {
  MemberOf = "memberOf"
  Unknown(value: Str)
}

pub enum TaskDefinitionStatus: Str {
  Active = "ACTIVE"
  Inactive = "INACTIVE"
  DeleteInProgress = "DELETE_IN_PROGRESS"
  Unknown(value: Str)
}

/// The amount of ephemeral storage to allocate for the task.
