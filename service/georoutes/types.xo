  /// Resting time before the driver can continue driving. Unit : seconds
  pub rest_duration: Int? = None
}

/// Type of the emission. Valid values : Euro1, Euro2, Euro3, Euro4, Euro5,
/// Euro6, EuroEev
pub struct RouteEmissionType {
  /// The CO 2 emission classes.
  pub co2_emission_class: Str? = None
  /// Type of the emission. Valid values : Euro1, Euro2, Euro3, Euro4, Euro5,
  /// Euro6, EuroEev
  pub type_value: Str? = None
}

pub enum RouteEngineType: Str {
  Electric = "Electric"
  InternalCombustion = "InternalCombustion"
  PluginHybrid = "PluginHybrid"
  Unknown(value: Str)
}

/// Details related to the enter highway step.
pub struct RouteEnterHighwayStepDetails {
  /// Name of the intersection, if applicable to the step.
