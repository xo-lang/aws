fn json_of_section(v: Section) -> json.Value {
  match v {
    FieldGroup(x) => json.Value.Object([("fieldGroup", json_of_field_group(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_section(v: json.Value) -> Section ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "fieldGroup" => Ok(Section.FieldGroup(from_json_field_group(fv)?))
      _ => Ok(Section.Unknown(k))
    }
  }
  Err("Section: no member set")
}

fn json_of_sections_list(v: List[Section]) -> json.Value {
  json.Value.List(v.map(fn(x: Section) -> json.Value { json_of_section(x) }))
}

fn from_json_sections_list(v: json.Value) -> List[Section] ! Str {
  var out: List[Section] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_section(fv)?)
  }
  Ok(out)
}

