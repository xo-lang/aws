      "AvailabilityZoneId" => out.availability_zone_id = c.text()
      "LifecycleState" => out.lifecycle_state = LifecycleState.from(c.text())
      "HealthStatus" => out.health_status = c.text()
      "LaunchConfigurationName" => out.launch_configuration_name = c.text()
      "LaunchTemplate" => out.launch_template = xml_read_launch_template_specification(c)?
      "ImageId" => out.image_id = c.text()
      "ProtectedFromScaleIn" => out.protected_from_scale_in = xmlv.read_bool(c.text())?
      "WeightedCapacity" => out.weighted_capacity = c.text()
      _ => {}
    }
  }
  Ok(out)
}

