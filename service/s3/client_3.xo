  if let Some(hv) = resp.header("x-amz-checksum-crc32c") {
    out.checksum_crc32_c = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-crc64nvme") {
    out.checksum_crc64_nvme = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-sha1") {
    out.checksum_sha1 = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-sha256") {
    out.checksum_sha256 = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-sha512") {
    out.checksum_sha512 = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-md5") {
    out.checksum_md5 = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-xxhash64") {
    out.checksum_xxhash64 = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-xxhash3") {
    out.checksum_xxhash3 = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-xxhash128") {
    out.checksum_xxhash128 = hv
  }
  if let Some(hv) = resp.header("x-amz-checksum-type") {
    out.checksum_type = ChecksumType.from(hv)
  }
  if let Some(hv) = resp.header("x-amz-server-side-encryption") {
    out.server_side_encryption = ServerSideEncryption.from(hv)
  }
  if let Some(hv) = resp.header("x-amz-version-id") {
    out.version_id = hv
  }
  if let Some(hv) = resp.header("x-amz-server-side-encryption-customer-algorithm") {
    out.sse_customer_algorithm = hv
  }
  if let Some(hv) = resp.header("x-amz-server-side-encryption-customer-key-MD5") {
    out.sse_customer_key_md5 = hv
  }
  if let Some(hv) = resp.header("x-amz-server-side-encryption-aws-kms-key-id") {
    out.sse_kms_key_id = hv
  }
  if let Some(hv) = resp.header("x-amz-server-side-encryption-context") {
    out.sse_kms_encryption_context = hv
  }
  if let Some(hv) = resp.header("x-amz-server-side-encryption-bucket-key-enabled") {
