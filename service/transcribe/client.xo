      "LastModifiedTime" => out.last_modified_time = jsonv.read_time(fv, "epoch-seconds")?
      "LanguageCode" => out.language_code = CLMLanguageCode.from(jsonv.read_str(fv)?)
      "BaseModelName" => out.base_model_name = BaseModelName.from(jsonv.read_str(fv)?)
      "ModelStatus" => out.model_status = ModelStatus.from(jsonv.read_str(fv)?)
      "UpgradeAvailability" => out.upgrade_availability = jsonv.read_bool(fv)?
      "FailureReason" => out.failure_reason = jsonv.read_str(fv)?
      "InputDataConfig" => out.input_data_config = from_json_input_data_config(fv)?
      "EncryptionConfiguration" => out.encryption_configuration = from_json_encryption_configuration(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_language_options(v: List[LanguageCode]) -> json.Value {
  json.Value.List(v.map(fn(x: LanguageCode) -> json.Value { json.Value.Str(x.value()) }))
