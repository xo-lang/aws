}

/// Details on the criteria used to define the filter.
pub struct FilterCriteria {
  /// Details on the finding ARNs used to filter findings.
  pub finding_arn: List[StringFilter]? = None
  /// Details of the Amazon Web Services account IDs used to filter findings.
  pub aws_account_id: List[StringFilter]? = None
  /// Details on the finding types used to filter findings.
  pub finding_type: List[StringFilter]? = None
  /// Details on the severity used to filter findings.
  pub severity: List[StringFilter]? = None
  /// Details on the date and time a finding was first seen used to filter
  /// findings.
  pub first_observed_at: List[DateFilter]? = None
  /// Details on the date and time a finding was last seen used to filter
  /// findings.
  pub last_observed_at: List[DateFilter]? = None
  /// Details on the date and time a finding was last updated at used to
  /// filter findings.
  pub updated_at: List[DateFilter]? = None
  /// Details on the finding status types used to filter findings.
  pub finding_status: List[StringFilter]? = None
  /// Details on the finding title used to filter findings.
  pub title: List[StringFilter]? = None
  /// The Amazon Inspector score to filter on.
  pub inspector_score: List[NumberFilter]? = None
  /// Details on the resource types used to filter findings.
  pub resource_type: List[StringFilter]? = None
  /// Details on the resource IDs used to filter findings.
  pub resource_id: List[StringFilter]? = None
  /// Details on the resource tags used to filter findings.
  pub resource_tags: List[MapFilter]? = None
  /// Details of the Amazon EC2 instance image IDs used to filter findings.
  pub ec2_instance_image_id: List[StringFilter]? = None
  /// Details of the Amazon EC2 instance VPC IDs used to filter findings.
  pub ec2_instance_vpc_id: List[StringFilter]? = None
  /// Details of the Amazon EC2 instance subnet IDs used to filter findings.
  pub ec2_instance_subnet_id: List[StringFilter]? = None
  /// Details on the Amazon ECR image push date and time used to filter
  /// findings.
  pub ecr_image_pushed_at: List[DateFilter]? = None
  /// Details of the Amazon ECR image architecture types used to filter
  /// findings.
  pub ecr_image_architecture: List[StringFilter]? = None
  /// Details on the Amazon ECR registry used to filter findings.
  pub ecr_image_registry: List[StringFilter]? = None
  /// Details on the name of the Amazon ECR repository used to filter
  /// findings.
  pub ecr_image_repository_name: List[StringFilter]? = None
  /// The tags attached to the Amazon ECR container image.
  pub ecr_image_tags: List[StringFilter]? = None
  /// Details of the Amazon ECR image hashes used to filter findings.
  pub ecr_image_hash: List[StringFilter]? = None
  /// Filter criteria indicating when an Amazon ECR image was last used in an
  /// Amazon ECS cluster task or Amazon EKS cluster pod.
  pub ecr_image_last_in_use_at: List[DateFilter]? = None
  /// Filter criteria indicating when details for an Amazon ECR image include
  /// when an Amazon ECR image is in use.
  pub ecr_image_in_use_count: List[NumberFilter]? = None
  /// Details on the port ranges used to filter findings.
  pub port_range: List[PortRangeFilter]? = None
  /// Details on network protocol used to filter findings.
  pub network_protocol: List[StringFilter]? = None
  /// Details of the component IDs used to filter findings.
  pub component_id: List[StringFilter]? = None
  /// Details of the component types used to filter findings.
  pub component_type: List[StringFilter]? = None
  /// Details on the vulnerability ID used to filter findings.
  pub vulnerability_id: List[StringFilter]? = None
  /// Details on the vulnerability type used to filter findings.
  pub vulnerability_source: List[StringFilter]? = None
  /// Details on the vendor severity used to filter findings.
  pub vendor_severity: List[StringFilter]? = None
  /// Details on the vulnerable packages used to filter findings.
  pub vulnerable_packages: List[PackageFilter]? = None
  /// Details on the related vulnerabilities used to filter findings.
  pub related_vulnerabilities: List[StringFilter]? = None
  /// Details on whether a fix is available through a version update. This
  /// value can be YES , NO , or PARTIAL . A PARTIAL fix means that some, but
  /// not all, of the packages identified in the finding have fixes available
  /// through updated versions.
  pub fix_available: List[StringFilter]? = None
  /// Filters the list of Amazon Web Services Lambda functions by the name of
  /// the function.
  pub lambda_function_name: List[StringFilter]? = None
  /// Filters the list of Amazon Web Services Lambda functions by the
  /// function's layers . A Lambda function can have up to five layers.
  pub lambda_function_layers: List[StringFilter]? = None
  /// Filters the list of Amazon Web Services Lambda functions by the runtime
  /// environment for the Lambda function.
  pub lambda_function_runtime: List[StringFilter]? = None
  /// Filters the list of Amazon Web Services Lambda functions by the date and
  /// time that a user last updated the configuration, in ISO 8601 format
  pub lambda_function_last_modified_at: List[DateFilter]? = None
  /// Filters the list of Amazon Web Services Lambda functions by execution
  /// role.
  pub lambda_function_execution_role_arn: List[StringFilter]? = None
  /// Filters the list of Amazon Web Services Lambda findings by the
  /// availability of exploits.
  pub exploit_available: List[StringFilter]? = None
  /// The name of the detector used to identify a code vulnerability in a
  /// Lambda function used to filter findings.
  pub code_vulnerability_detector_name: List[StringFilter]? = None
  /// The detector type tag associated with the vulnerability used to filter
  /// findings. Detector tags group related vulnerabilities by common themes
  /// or tactics. For a list of available tags by programming language, see
  /// Java tags , or Python tags .
  pub code_vulnerability_detector_tags: List[StringFilter]? = None
  /// The file path to the file in a Lambda function that contains a code
  /// vulnerability used to filter findings.
  pub code_vulnerability_file_path: List[StringFilter]? = None
  /// The EPSS score used to filter findings.
  pub epss_score: List[NumberFilter]? = None
  /// Filter criteria for findings based on the project name in a code
  /// repository.
  pub code_repository_project_name: List[StringFilter]? = None
  /// Filter criteria for findings based on the repository provider type (such
  /// as GitHub, GitLab, etc.).
  pub code_repository_provider_type: List[StringFilter]? = None
  /// The ID of the Amazon Machine Image (AMI) used to filter findings.
  pub machine_image_id: List[StringFilter]? = None
  /// The name of the Amazon Machine Image (AMI) used to filter findings.
  pub machine_image_name: List[StringFilter]? = None
  /// The ID of the Amazon Web Services account that owns the Amazon Machine
  /// Image (AMI) used to filter findings.
  pub machine_image_owner_account_id: List[StringFilter]? = None
  /// The platform of the Amazon Machine Image (AMI) used to filter findings.
  pub machine_image_platform: List[StringFilter]? = None
  /// Filter criteria for the cloud provider.
  pub cloud_provider: List[StringFilter]? = None
  /// Filter criteria for the cloud provider region.
  pub cloud_provider_region: List[StringFilter]? = None
  /// Filter criteria for the cloud provider account ID.
  pub cloud_provider_account_id: List[StringFilter]? = None
  /// Filter criteria for the cloud provider organization ID.
  pub cloud_provider_org_id: List[StringFilter]? = None
  /// Filter criteria for the image reference of a VM instance.
  pub cloud_vm_image_reference: List[StringFilter]? = None
  /// Filter criteria for the network ID of a VM instance.
  pub cloud_vm_network_id: List[StringFilter]? = None
  /// Filter criteria for the subnet IDs of a VM instance.
  pub cloud_vm_subnet_ids: List[StringFilter]? = None
  /// Filter criteria for the repository name of a container image.
  pub cloud_image_repository_name: List[StringFilter]? = None
  /// Filter criteria for the registry of a container image.
  pub cloud_image_registry: List[StringFilter]? = None
  /// Filter criteria for the digest of a container image.
  pub cloud_image_digest: List[StringFilter]? = None
  /// Filter criteria for the tags of a container image.
  pub cloud_image_tags: List[StringFilter]? = None
  /// Filter criteria for when a container image was pushed.
  pub cloud_image_pushed_at: List[DateFilter]? = None
  /// Filter criteria for the architecture of a container image.
  pub cloud_image_architecture: List[StringFilter]? = None
  /// Filter criteria for the last time a container image was in use.
  pub cloud_image_last_in_use_at: List[DateFilter]? = None
  /// Filter criteria for the in-use count of a container image.
  pub cloud_image_in_use_count: List[NumberFilter]? = None
  /// Filter criteria for the name of a serverless function.
  pub cloud_serverless_function_name: List[StringFilter]? = None
  /// Filter criteria for the runtime of a serverless function.
  pub cloud_serverless_function_runtime: List[StringFilter]? = None
  /// Filter criteria for when a serverless function was last modified.
  pub cloud_serverless_function_last_modified_at: List[DateFilter]? = None
  /// Filter criteria for the execution role of a serverless function.
  pub cloud_serverless_function_execution_role: List[StringFilter]? = None
}

/// Details about an Amazon Inspector finding.
pub struct Finding {
  /// The Amazon Resource Number (ARN) of the finding.
  pub finding_arn: Str? = None
  /// The Amazon Web Services account ID associated with the finding.
  pub aws_account_id: Str? = None
  /// The type of the finding. The type value determines the valid values for
  /// resource in your request. For more information, see Finding types in the
  /// Amazon Inspector user guide.
  pub type_value: Str? = None
  /// The description of the finding.
  pub description: Str? = None
  /// The title of the finding.
  pub title: Str? = None
  /// An object that contains the details about how to remediate a finding.
  pub remediation: Remediation? = None
  /// The severity of the finding. UNTRIAGED applies to PACKAGE_VULNERABILITY
  /// type findings that the vendor has not assigned a severity yet. For more
  /// information, see Severity levels for findings in the Amazon Inspector
  /// user guide.
  pub severity: Str? = None
  /// The date and time that the finding was first observed.
  pub first_observed_at: Time? = None
  /// The date and time the finding was last observed. This timestamp for this
  /// field remains unchanged until a finding is updated.
  pub last_observed_at: Time? = None
  /// The date and time the finding was last updated at.
  pub updated_at: Time? = None
  /// The status of the finding.
  pub status: Str? = None
  /// Contains information on the resources involved in a finding. The
  /// resource value determines the valid values for type in your request. For
  /// more information, see Finding types in the Amazon Inspector user guide.
  pub resources: List[Resource]? = None
  /// The Amazon Inspector score given to the finding.
  pub inspector_score: Float? = None
  /// An object that contains details of the Amazon Inspector score.
  pub inspector_score_details: InspectorScoreDetails? = None
  /// An object that contains the details of a network reachability finding.
  pub network_reachability_details: NetworkReachabilityDetails? = None
  /// An object that contains the details of a package vulnerability finding.
  pub package_vulnerability_details: PackageVulnerabilityDetails? = None
  /// Details on whether a fix is available through a version update. This
  /// value can be YES , NO , or PARTIAL . A PARTIAL fix means that some, but
  /// not all, of the packages identified in the finding have fixes available
  /// through updated versions.
  pub fix_available: Str? = None
  /// If a finding discovered in your environment has an exploit available.
  pub exploit_available: Str? = None
  /// The details of an exploit available for a finding discovered in your
  /// environment.
  pub exploitability_details: ExploitabilityDetails? = None
  /// Details about the code vulnerability identified in a Lambda function
  /// used to filter findings.
  pub code_vulnerability_details: CodeVulnerabilityDetails? = None
  /// The finding's EPSS score.
  pub epss: EpssDetails? = None
}

/// Details of the vulnerability identified in a finding.
pub struct FindingDetail {
  /// The finding ARN that the vulnerability details are associated with.
  pub finding_arn: Str? = None
  /// The Cybersecurity and Infrastructure Security Agency (CISA) details for
  /// a specific vulnerability.
  pub cisa_data: CisaData? = None
  /// The risk score of the vulnerability.
  pub risk_score: Int? = None
  /// Information on the evidence of the vulnerability.
  pub evidences: List[Evidence]? = None
  /// The MITRE adversary tactics, techniques, or procedures (TTPs) associated
  /// with the vulnerability.
  pub ttps: List[Str]? = None
  /// The known malware tools or kits that can exploit the vulnerability.
  pub tools: List[Str]? = None
  /// Contains information on when this exploit was observed.
  pub exploit_observed: ExploitObserved? = None
  /// The reference URLs for the vulnerability data.
  pub reference_urls: List[Str]? = None
  /// The Common Weakness Enumerations (CWEs) associated with the
  /// vulnerability.
  pub cwes: List[Str]? = None
  /// The Exploit Prediction Scoring System (EPSS) score of the vulnerability.
  pub epss_score: Float? = None
}

/// Details about an error encountered when trying to return vulnerability
/// data for a finding.
pub struct FindingDetailsError {
  /// The finding ARN that returned an error.
  pub finding_arn: Str? = None
  /// The error code.
  pub error_code: Str? = None
  /// The error message.
  pub error_message: Str? = None
}

/// The details that define an aggregation based on finding type.
pub struct FindingTypeAggregation {
  /// The finding type to aggregate.
  pub finding_type: Str? = None
  /// The resource type to aggregate.
  pub resource_type: Str? = None
  /// The order to sort results by.
  pub sort_order: Str? = None
  /// The value to sort results by.
  pub sort_by: Str? = None
}

/// A response that contains the results of a finding type aggregation.
pub struct FindingTypeAggregationResponse {
  /// The ID of the Amazon Web Services account associated with the findings.
  pub account_id: Str? = None
  /// The value to sort results by.
  pub severity_counts: SeverityCounts? = None
  /// The number of findings that have an exploit available.
  pub exploit_available_count: Int? = None
  /// Details about the number of fixes.
  pub fix_available_count: Int? = None
  /// The cloud service provider associated with this finding type
  /// aggregation. Valid values: AWS – Findings from Amazon Web Services
  /// resources. AZURE – Findings from Microsoft Azure resources.
  pub cloud_provider: Str? = None
  /// The cloud account ID for the finding type aggregation.
  pub cloud_account_id: Str? = None
  /// The cloud organization ID for the finding type aggregation.
  pub cloud_org_id: Str? = None
  /// The cloud Region associated with this finding type aggregation. The
  /// value format depends on the cloud provider: An Amazon Web Services
  /// Region, such as us-east-1 . An Azure region, such as eastus .
  pub cloud_region: Str? = None
  /// The cloud infrastructure partition associated with this finding type
  /// aggregation. Valid values: aws – Amazon Web Services commercial
  /// Regions. aws-cn – Amazon Web Services China Regions. aws-us-gov –
  /// Amazon Web Services GovCloud (US) Regions. AzureCloud – Azure
  /// commercial Regions.
  pub cloud_partition: Str? = None
}

