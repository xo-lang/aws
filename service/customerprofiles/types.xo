  /// (interpret Target as an absolute count).
  pub cap_type: DiversityCapType? = None
  /// The diversity cap target. Either an integer literal (for example, "25" )
  /// or a placeholder expression of the form $name whose value is supplied at
  /// inference time through GetProfileRecommendations .
  pub target_value: Str? = None
}

/// Configuration that controls diversity of recommendation results by
/// capping the representation of specified item columns.
pub struct DiversityConfig {
  /// A list of up to two diversity columns. Each column defines a cap on the
  /// number or percentage of recommended items that share the same value for
  /// that column.
  pub diversity_columns: List[DiversityColumn]? = None
}

