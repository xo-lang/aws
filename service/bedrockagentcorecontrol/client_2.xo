fn json_of_match_principal_entry(v: MatchPrincipalEntry) -> json.Value {
  match v {
    IamPrincipal(x) => json.Value.Object([("iamPrincipal", json_of_iam_principal(x))])
    Unknown(_) => json.Value.Object([])
  }
