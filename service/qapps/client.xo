  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

fn from_json_document_attribute_string_list_value(v: json.Value) -> List[Str] ! Str {
  var out: List[Str] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(jsonv.read_str(fv)?)
  }
  Ok(out)
}

fn json_of_document_attribute_value(v: DocumentAttributeValue) -> json.Value {
  match v {
    StringValue(x) => json.Value.Object([("stringValue", json.Value.Str(x))])
    StringListValue(x) => json.Value.Object([("stringListValue", json_of_document_attribute_string_list_value(x))])
    LongValue(x) => json.Value.Object([("longValue", json.Value.Int(x))])
    DateValue(x) => json.Value.Object([("dateValue", jsonv.time(x, "epoch-seconds"))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_document_attribute_value(v: json.Value) -> DocumentAttributeValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "stringValue" => Ok(DocumentAttributeValue.StringValue(jsonv.read_str(fv)?))
      "stringListValue" => Ok(DocumentAttributeValue.StringListValue(from_json_document_attribute_string_list_value(fv)?))
      "longValue" => Ok(DocumentAttributeValue.LongValue(jsonv.read_int(fv)?))
      "dateValue" => Ok(DocumentAttributeValue.DateValue(jsonv.read_time(fv, "epoch-seconds")?))
      _ => Ok(DocumentAttributeValue.Unknown(k))
    }
  }
  Err("DocumentAttributeValue: no member set")
}

