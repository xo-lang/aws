/// Updates the DRAFT version of the specified question set.
/// UpdateQuestionSet doesn't create a version and doesn't change published
/// versions. To publish the updated DRAFT as a new version, use
/// CreateQuestionSetVersion. UpdateQuestionSet replaces questions one type
/// at a time. For each of yesNo, yesNoPerOption, and chooseOne: if you omit
/// the array, DRAFT keeps its questions of that type. If you include the
/// array, it replaces all the questions of that type in DRAFT. If you
/// include an empty array, DRAFT no longer has questions of that type. The
/// updated DRAFT must follow the same rules as in CreateQuestionSet, and
/// Elemental Inference applies those rules to the questions that DRAFT
/// keeps as well as to the questions in the request. Feeds that reference
/// the DRAFT version use the updated questions. To make sure that the
/// questions for a feed don't change, reference a published version
/// instead.
pub fn (c: Client) update_question_set(input: UpdateQuestionSetRequest) -> UpdateQuestionSetResponse ! UpdateQuestionSetErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_question_set(c.params, input)) ?? e => return Err(UpdateQuestionSetErr.InvalidInput(e))
  var req = serialize_update_question_set(ep, input, "") ?? e => return Err(UpdateQuestionSetErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateQuestionSetErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_question_set_error(resp))
  }
  deserialize_update_question_set(resp) ?? e => Err(UpdateQuestionSetErr.Deserialize(e))
}
