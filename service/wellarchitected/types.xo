}

pub enum WorkloadIssueManagementStatus: Str {
  Enabled = "ENABLED"
  Disabled = "DISABLED"
  Inherit = "INHERIT"
  Unknown(value: Str)
}

/// Workload-level: Input for the Jira configuration.
pub struct WorkloadJiraConfigurationInput {
  /// Workload-level: Jira issue management status.
  pub issue_management_status: WorkloadIssueManagementStatus? = None
  /// Workload-level: Jira issue management type.
  pub issue_management_type: IssueManagementType? = None
  /// Workload-level: Jira project key to sync workloads to.
  pub jira_project_key: Str? = None
}

/// Workload-level: Output configuration of the Jira integration.
pub struct WorkloadJiraConfigurationOutput {
  /// Workload-level: Jira issue management status.
  pub issue_management_status: WorkloadIssueManagementStatus? = None
  /// Workload-level: Jira issue management type.
  pub issue_management_type: IssueManagementType? = None
  /// Workload-level: Jira project key to sync workloads to.
  pub jira_project_key: Str? = None
  /// Workload-level: Status message on configuration of the Jira integration.
  pub status_message: Str? = None
}

/// The profile associated with a workload.
pub struct WorkloadProfile {
  /// The profile ARN.
  pub profile_arn: Str? = None
  /// The profile version.
  pub profile_version: Str? = None
}

/// A workload share return object.
pub struct WorkloadShare {
  pub share_id: Str? = None
  pub shared_by: Str? = None
  pub shared_with: Str? = None
  pub permission_type: PermissionType? = None
  pub status: ShareStatus? = None
  pub workload_name: Str? = None
  pub workload_id: Str? = None
}

/// A workload share summary return object.
pub struct WorkloadShareSummary {
  pub share_id: Str? = None
  pub shared_with: Str? = None
  pub permission_type: PermissionType? = None
  pub status: ShareStatus? = None
  /// Optional message to compliment the Status field.
  pub status_message: Str? = None
}

/// A workload summary return object.
pub struct WorkloadSummary {
  pub workload_id: Str? = None
  pub workload_arn: Str? = None
  pub workload_name: Str? = None
  pub owner: Str? = None
  /// The date and time when the workload was last updated.
  pub updated_at: Time? = None
  pub lenses: List[Str]? = None
  pub risk_counts: Map[Str, Int]? = None
  pub improvement_status: WorkloadImprovementStatus? = None
  /// Profile associated with a workload.
  pub profiles: List[WorkloadProfile]? = None
  pub prioritized_risk_counts: Map[Str, Int]? = None
}
