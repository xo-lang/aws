fn xml_write_declarative_policies_report(var w: xmlv.Writer, v: DeclarativePoliciesReport, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.report_id {
    xmlv.elem(w, "reportId", x, [])
  }
  if let Some(x) = v.s3_bucket {
    xmlv.elem(w, "s3Bucket", x, [])
  }
  if let Some(x) = v.s3_prefix {
    xmlv.elem(w, "s3Prefix", x, [])
  }
  if let Some(x) = v.target_id {
    xmlv.elem(w, "targetId", x, [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "startTime", rest.date_time(x), [])
  }
  if let Some(x) = v.end_time {
    xmlv.elem(w, "endTime", rest.date_time(x), [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_declarative_policies_report(e: xml.Element) -> DeclarativePoliciesReport ! Str {
  var out = DeclarativePoliciesReport{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "reportId" => out.report_id = c.text()
      "s3Bucket" => out.s3_bucket = c.text()
      "s3Prefix" => out.s3_prefix = c.text()
      "targetId" => out.target_id = c.text()
      "startTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "endTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "status" => out.status = ReportState.from(c.text())
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

