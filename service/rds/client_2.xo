      "ScalingConfiguration" => out.scaling_configuration = xml_read_scaling_configuration(c)?
      "EngineMode" => out.engine_mode = c.text()
      "RdsCustomClusterConfiguration" => out.rds_custom_cluster_configuration = xml_read_rds_custom_cluster_configuration(c)?
      "MonitoringInterval" => out.monitoring_interval = xmlv.read_int(c.text())?
      "MonitoringRoleArn" => out.monitoring_role_arn = c.text()
      "EnablePerformanceInsights" => out.enable_performance_insights = xmlv.read_bool(c.text())?
      "PerformanceInsightsKMSKeyId" => out.performance_insights_kms_key_id = c.text()
