fn xml_write_instance_image_metadata(var w: xmlv.Writer, v: InstanceImageMetadata, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.instance_type {
    xmlv.elem(w, "instanceType", x.value(), [])
  }
  if let Some(x) = v.launch_time {
    xmlv.elem(w, "launchTime", rest.date_time(x), [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.zone_id {
    xmlv.elem(w, "zoneId", x, [])
  }
  if let Some(x) = v.state {
    xml_write_instance_state(w, x, "instanceState", [])
  }
  if let Some(x) = v.owner_id {
    xmlv.elem(w, "instanceOwnerId", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.image_metadata {
    xml_write_image_metadata(w, x, "imageMetadata", [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_response(w, x, "operator", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_image_metadata(e: xml.Element) -> InstanceImageMetadata ! Str {
  var out = InstanceImageMetadata{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "instanceId" => out.instance_id = c.text()
      "instanceType" => out.instance_type = InstanceType.from(c.text())
      "launchTime" => out.launch_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "availabilityZone" => out.availability_zone = c.text()
      "zoneId" => out.zone_id = c.text()
      "instanceState" => out.state = xml_read_instance_state(c)?
      "instanceOwnerId" => out.owner_id = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "imageMetadata" => out.image_metadata = xml_read_image_metadata(c)?
      "operator" => out.operator = xml_read_operator_response(c)?
      _ => {}
    }
  }
  Ok(out)
}

