      Err(msg) => SubscribeToShardEventStreamErr.Read(msg)
    }
    "KMSInvalidStateException" => match exception_read_kms_invalid_state_exception(m.payload) {
      Ok(x) => SubscribeToShardEventStreamErr.KmsInvalidStateException(x)
      Err(msg) => SubscribeToShardEventStreamErr.Read(msg)
    }
    "KMSAccessDeniedException" => match exception_read_kms_access_denied_exception(m.payload) {
      Ok(x) => SubscribeToShardEventStreamErr.KmsAccessDeniedException(x)
      Err(msg) => SubscribeToShardEventStreamErr.Read(msg)
    }
    "KMSNotFoundException" => match exception_read_kms_not_found_exception(m.payload) {
      Ok(x) => SubscribeToShardEventStreamErr.KmsNotFoundException(x)
      Err(msg) => SubscribeToShardEventStreamErr.Read(msg)
    }
    "KMSOptInRequired" => match exception_read_kms_opt_in_required(m.payload) {
      Ok(x) => SubscribeToShardEventStreamErr.KmsOptInRequired(x)
      Err(msg) => SubscribeToShardEventStreamErr.Read(msg)
