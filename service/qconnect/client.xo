fn json_of_source_configuration(v: SourceConfiguration) -> json.Value {
  match v {
    AppIntegrations(x) => json.Value.Object([("appIntegrations", json_of_app_integrations_configuration(x))])
    ManagedSourceConfiguration(x) => json.Value.Object([("managedSourceConfiguration", json_of_managed_source_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_source_configuration(v: json.Value) -> SourceConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "appIntegrations" => Ok(SourceConfiguration.AppIntegrations(from_json_app_integrations_configuration(fv)?))
      "managedSourceConfiguration" => Ok(SourceConfiguration.ManagedSourceConfiguration(from_json_managed_source_configuration(fv)?))
      _ => Ok(SourceConfiguration.Unknown(k))
    }
  }
  Err("SourceConfiguration: no member set")
}

