fn xml_write_notification_configuration(var w: xmlv.Writer, v: NotificationConfiguration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.topic_configurations {
    for item in x {
      xml_write_topic_configuration(w, item, "TopicConfiguration", [])
    }
  }
  if let Some(x) = v.queue_configurations {
    for item in x {
      xml_write_queue_configuration(w, item, "QueueConfiguration", [])
    }
  }
  if let Some(x) = v.lambda_function_configurations {
    for item in x {
      xml_write_lambda_function_configuration(w, item, "CloudFunctionConfiguration", [])
    }
  }
  if let Some(x) = v.event_bridge_configuration {
    xml_write_event_bridge_configuration(w, x, "EventBridgeConfiguration", [])
  }
  xmlv.end(w, name)
}

fn xml_read_notification_configuration(e: xml.Element) -> NotificationConfiguration ! Str {
  var out = NotificationConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "TopicConfiguration" => {
        var items = out.topic_configurations ?? []
        items.push(xml_read_topic_configuration(c)?)
        out.topic_configurations = items
      }
      "QueueConfiguration" => {
        var items = out.queue_configurations ?? []
        items.push(xml_read_queue_configuration(c)?)
        out.queue_configurations = items
      }
      "CloudFunctionConfiguration" => {
        var items = out.lambda_function_configurations ?? []
        items.push(xml_read_lambda_function_configuration(c)?)
        out.lambda_function_configurations = items
      }
      "EventBridgeConfiguration" => out.event_bridge_configuration = xml_read_event_bridge_configuration(c)?
      _ => {}
    }
  }
  Ok(out)
}

