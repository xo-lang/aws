fn xml_write_service_configuration(var w: xmlv.Writer, v: ServiceConfiguration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.service_type {
    xml_write_service_type_detail_set(w, x, "serviceType", [])
  }
  if let Some(x) = v.service_id {
    xmlv.elem(w, "serviceId", x, [])
  }
