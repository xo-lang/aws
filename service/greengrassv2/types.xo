  /// per minute, when the job starts. This parameter defines the initial
  /// rollout rate of the job.
  pub base_rate_per_minute: Int? = None
  /// The exponential factor to increase the rollout rate for the job. This
  /// parameter supports up to one digit after the decimal (for example, you
  /// can specify 1.5 , but not 1.55 ).
  pub increment_factor: Float? = None
  /// The criteria to increase the rollout rate for the job.
  pub rate_increase_criteria: IoTJobRateIncreaseCriteria? = None
}

/// Contains information about criteria to meet before a job increases its
/// rollout rate. Specify either numberOfNotifiedThings or
/// numberOfSucceededThings .
pub struct IoTJobRateIncreaseCriteria {
  /// The number of devices to receive the job notification before the rollout
  /// rate increases.
  pub number_of_notified_things: Int? = None
  /// The number of devices to successfully run the configuration job before
  /// the rollout rate increases.
  pub number_of_succeeded_things: Int? = None
}

/// Contains information about the timeout configuration for a job.
pub struct IoTJobTimeoutConfig {
  /// The amount of time, in minutes, that devices have to complete the job.
