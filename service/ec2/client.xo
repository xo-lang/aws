fn xml_write_vpn_connection_options(var w: xmlv.Writer, v: VpnConnectionOptions, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.enable_acceleration {
    xmlv.elem(w, "enableAcceleration", "${x}", [])
  }
  if let Some(x) = v.static_routes_only {
    xmlv.elem(w, "staticRoutesOnly", "${x}", [])
  }
  if let Some(x) = v.local_ipv4_network_cidr {
    xmlv.elem(w, "localIpv4NetworkCidr", x, [])
  }
  if let Some(x) = v.remote_ipv4_network_cidr {
    xmlv.elem(w, "remoteIpv4NetworkCidr", x, [])
  }
  if let Some(x) = v.local_ipv6_network_cidr {
    xmlv.elem(w, "localIpv6NetworkCidr", x, [])
  }
  if let Some(x) = v.remote_ipv6_network_cidr {
    xmlv.elem(w, "remoteIpv6NetworkCidr", x, [])
  }
  if let Some(x) = v.outside_ip_address_type {
    xmlv.elem(w, "outsideIpAddressType", x, [])
  }
  if let Some(x) = v.transport_transit_gateway_attachment_id {
    xmlv.elem(w, "transportTransitGatewayAttachmentId", x, [])
  }
  if let Some(x) = v.tunnel_inside_ip_version {
    xmlv.elem(w, "tunnelInsideIpVersion", x.value(), [])
  }
  if let Some(x) = v.tunnel_options {
    xml_write_tunnel_options_list(w, x, "tunnelOptionSet", [])
  }
  if let Some(x) = v.tunnel_bandwidth {
    xmlv.elem(w, "tunnelBandwidth", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpn_connection_options(e: xml.Element) -> VpnConnectionOptions ! Str {
  var out = VpnConnectionOptions{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "enableAcceleration" => out.enable_acceleration = xmlv.read_bool(c.text())?
      "staticRoutesOnly" => out.static_routes_only = xmlv.read_bool(c.text())?
      "localIpv4NetworkCidr" => out.local_ipv4_network_cidr = c.text()
      "remoteIpv4NetworkCidr" => out.remote_ipv4_network_cidr = c.text()
      "localIpv6NetworkCidr" => out.local_ipv6_network_cidr = c.text()
      "remoteIpv6NetworkCidr" => out.remote_ipv6_network_cidr = c.text()
      "outsideIpAddressType" => out.outside_ip_address_type = c.text()
      "transportTransitGatewayAttachmentId" => out.transport_transit_gateway_attachment_id = c.text()
      "tunnelInsideIpVersion" => out.tunnel_inside_ip_version = TunnelInsideIpVersion.from(c.text())
      "tunnelOptionSet" => out.tunnel_options = xml_read_tunnel_options_list(c)?
      "tunnelBandwidth" => out.tunnel_bandwidth = VpnTunnelBandwidth.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_vpn_connection_options_specification(var w: xmlv.Writer, v: VpnConnectionOptionsSpecification, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.enable_acceleration {
    xmlv.elem(w, "EnableAcceleration", "${x}", [])
  }
  if let Some(x) = v.tunnel_inside_ip_version {
    xmlv.elem(w, "TunnelInsideIpVersion", x.value(), [])
  }
  if let Some(x) = v.tunnel_options {
    xml_write_vpn_tunnel_options_specifications_list(w, x, "TunnelOptions", [])
  }
  if let Some(x) = v.local_ipv4_network_cidr {
    xmlv.elem(w, "LocalIpv4NetworkCidr", x, [])
  }
  if let Some(x) = v.remote_ipv4_network_cidr {
    xmlv.elem(w, "RemoteIpv4NetworkCidr", x, [])
  }
  if let Some(x) = v.local_ipv6_network_cidr {
    xmlv.elem(w, "LocalIpv6NetworkCidr", x, [])
  }
  if let Some(x) = v.remote_ipv6_network_cidr {
    xmlv.elem(w, "RemoteIpv6NetworkCidr", x, [])
  }
  if let Some(x) = v.outside_ip_address_type {
    xmlv.elem(w, "OutsideIpAddressType", x, [])
  }
  if let Some(x) = v.transport_transit_gateway_attachment_id {
    xmlv.elem(w, "TransportTransitGatewayAttachmentId", x, [])
  }
  if let Some(x) = v.tunnel_bandwidth {
    xmlv.elem(w, "TunnelBandwidth", x.value(), [])
  }
  if let Some(x) = v.static_routes_only {
    xmlv.elem(w, "staticRoutesOnly", "${x}", [])
  }
  xmlv.end(w, name)
}

fn xml_read_vpn_connection_options_specification(e: xml.Element) -> VpnConnectionOptionsSpecification ! Str {
  var out = VpnConnectionOptionsSpecification{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "EnableAcceleration" => out.enable_acceleration = xmlv.read_bool(c.text())?
      "TunnelInsideIpVersion" => out.tunnel_inside_ip_version = TunnelInsideIpVersion.from(c.text())
      "TunnelOptions" => out.tunnel_options = xml_read_vpn_tunnel_options_specifications_list(c)?
      "LocalIpv4NetworkCidr" => out.local_ipv4_network_cidr = c.text()
      "RemoteIpv4NetworkCidr" => out.remote_ipv4_network_cidr = c.text()
      "LocalIpv6NetworkCidr" => out.local_ipv6_network_cidr = c.text()
      "RemoteIpv6NetworkCidr" => out.remote_ipv6_network_cidr = c.text()
      "OutsideIpAddressType" => out.outside_ip_address_type = c.text()
      "TransportTransitGatewayAttachmentId" => out.transport_transit_gateway_attachment_id = c.text()
      "TunnelBandwidth" => out.tunnel_bandwidth = VpnTunnelBandwidth.from(c.text())
      "staticRoutesOnly" => out.static_routes_only = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

