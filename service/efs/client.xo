      "AvailabilityZoneId" => out.availability_zone_id = jsonv.read_str(fv)?
      "Tags" => out.tags = from_json_tags(fv)?
      "FileSystemProtection" => out.file_system_protection = from_json_file_system_protection_description(fv)?
      _ => {}
