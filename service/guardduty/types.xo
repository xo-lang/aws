pub struct TriggerDetails {
  /// The ID of the GuardDuty finding that triggered the malware scan.
  pub guard_duty_finding_id: Str? = None
  /// The description of the scan trigger.
  pub description: Str? = None
  /// Specifies the trigger type that started the malware scan.
  pub trigger_type: TriggerType? = None
}

pub enum TriggerType: Str {
  Backup = "BACKUP"
  Guardduty = "GUARDDUTY"
  Unknown(value: Str)
}

pub enum TrustedEntitySetFormat: Str {
  Txt = "TXT"
  Stix = "STIX"
  OtxCsv = "OTX_CSV"
  AlienVault = "ALIEN_VAULT"
  ProofPoint = "PROOF_POINT"
  FireEye = "FIRE_EYE"
  Unknown(value: Str)
}

pub enum TrustedEntitySetStatus: Str {
  Inactive = "INACTIVE"
  Activating = "ACTIVATING"
  Active = "ACTIVE"
  Deactivating = "DEACTIVATING"
  Error = "ERROR"
  DeletePending = "DELETE_PENDING"
  Deleted = "DELETED"
  Unknown(value: Str)
}

pub struct UnarchiveFindingsRequest {
  /// The ID of the detector associated with the findings to unarchive. To
  /// find the detectorId in the current Region, see the Settings page in the
  /// GuardDuty console, or run the ListDetectors API.
  pub detector_id: Str? = None
  /// The IDs of the findings to unarchive.
  pub finding_ids: List[Str]? = None
}

pub struct UnarchiveFindingsResponse {
}

/// Contains information about the accounts that weren't processed.
pub struct UnprocessedAccount {
  /// The Amazon Web Services account ID.
  pub account_id: Str? = None
  /// A reason why the account hasn't been processed.
  pub result: Str? = None
}

/// Specifies the names of the data sources that couldn't be enabled.
pub struct UnprocessedDataSourcesResult {
  pub malware_protection: MalwareProtectionConfigurationResult? = None
}

pub struct UntagResourceRequest {
  /// The Amazon Resource Name (ARN) for the resource to remove tags from.
  pub resource_arn: Str? = None
  /// The tag keys to remove from the resource.
  pub tag_keys: List[Str]? = None
}

pub struct UntagResourceResponse {
}

pub struct UpdateCustomDetectionRuleAssociationRequest {
  /// The unique identifier for the custom detection rule.
  pub rule_id: Str? = None
  /// The unique identifier for the association to update.
  pub association_id: Str? = None
  /// The rule execution mode. Valid values: LIVE | DRY_RUN .
  pub mode: AssociationMode? = None
}

pub struct UpdateCustomDetectionRuleAssociationResponse {
}

pub struct UpdateCustomDetectionRuleOrgConfigurationRequest {
  /// The unique identifier for the custom detection rule.
  pub rule_id: Str? = None
  /// The execution mode of the organization configuration. Valid values: LIVE
  /// | DRY_RUN .
  pub mode: AssociationMode? = None
  /// The account IDs to include in the organization configuration. Mutually
  /// exclusive with ExcludeAccountIds .
  pub include_account_ids: List[Str]? = None
  /// The account IDs to exclude from the organization configuration. Mutually
  /// exclusive with IncludeAccountIds .
  pub exclude_account_ids: List[Str]? = None
}

pub struct UpdateCustomDetectionRuleOrgConfigurationResponse {
}

pub struct UpdateDetectorRequest {
  /// The unique ID of the detector to update. To find the detectorId in the
  /// current Region, see the Settings page in the GuardDuty console, or run
  /// the ListDetectors API.
  pub detector_id: Str? = None
  /// Specifies whether the detector is enabled or not enabled.
  pub enable: Bool? = None
  /// An enum value that specifies how frequently findings are exported, such
  /// as to CloudWatch Events.
  pub finding_publishing_frequency: FindingPublishingFrequency? = None
  /// Describes which data sources will be updated. There might be regional
  /// differences because some data sources might not be available in all the
  /// Amazon Web Services Regions where GuardDuty is presently supported. For
  /// more information, see Regions and endpoints .
  pub data_sources: DataSourceConfigurations? = None
  /// Provides the features that will be updated for the detector.
  pub features: List[DetectorFeatureConfiguration]? = None
}

pub struct UpdateDetectorResponse {
}

