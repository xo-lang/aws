  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.configuration_arn {
    fs.push(("ConfigurationArn", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.game_session_queue_arns {
    fs.push(("GameSessionQueueArns", json_of_queue_arns_list(x)))
  }
  if let Some(x) = v.request_timeout_seconds {
    fs.push(("RequestTimeoutSeconds", json.Value.Int(x)))
  }
  if let Some(x) = v.acceptance_timeout_seconds {
    fs.push(("AcceptanceTimeoutSeconds", json.Value.Int(x)))
  }
  if let Some(x) = v.acceptance_required {
    fs.push(("AcceptanceRequired", json.Value.Bool(x)))
  }
  if let Some(x) = v.rule_set_name {
    fs.push(("RuleSetName", json.Value.Str(x)))
  }
  if let Some(x) = v.rule_set_arn {
    fs.push(("RuleSetArn", json.Value.Str(x)))
  }
  if let Some(x) = v.notification_target {
    fs.push(("NotificationTarget", json.Value.Str(x)))
  }
  if let Some(x) = v.additional_player_count {
    fs.push(("AdditionalPlayerCount", json.Value.Int(x)))
  }
  if let Some(x) = v.custom_event_data {
    fs.push(("CustomEventData", json.Value.Str(x)))
