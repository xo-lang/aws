  if let Some(x) = v.workteam_arn {
    fs.push(("WorkteamArn", json.Value.Str(x)))
  }
  if let Some(x) = v.pre_human_task_lambda_arn {
    fs.push(("PreHumanTaskLambdaArn", json.Value.Str(x)))
  }
  if let Some(x) = v.annotation_consolidation_lambda_arn {
    fs.push(("AnnotationConsolidationLambdaArn", json.Value.Str(x)))
  }
  if let Some(x) = v.failure_reason {
    fs.push(("FailureReason", json.Value.Str(x)))
  }
  if let Some(x) = v.labeling_job_output {
    fs.push(("LabelingJobOutput", json_of_labeling_job_output(x)))
