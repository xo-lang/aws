pub fn (c: Client) update_workteam(input: UpdateWorkteamRequest) -> UpdateWorkteamResponse ! UpdateWorkteamErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_workteam(c.params, input)) ?? e => return Err(UpdateWorkteamErr.InvalidInput(e))
  var req = serialize_update_workteam(ep, input, "") ?? e => return Err(UpdateWorkteamErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateWorkteamErr.Send(e))
  if resp.status >= 300 {
