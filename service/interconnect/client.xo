fn json_of_provider(v: Provider) -> json.Value {
  match v {
    CloudServiceProvider(x) => json.Value.Object([("cloudServiceProvider", json.Value.Str(x))])
    LastMileProvider(x) => json.Value.Object([("lastMileProvider", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_provider(v: json.Value) -> Provider ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "cloudServiceProvider" => Ok(Provider.CloudServiceProvider(jsonv.read_str(fv)?))
      "lastMileProvider" => Ok(Provider.LastMileProvider(jsonv.read_str(fv)?))
      _ => Ok(Provider.Unknown(k))
    }
  }
  Err("Provider: no member set")
}

fn json_of_remote_account_identifier(v: RemoteAccountIdentifier) -> json.Value {
  match v {
    Identifier(x) => json.Value.Object([("identifier", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_remote_account_identifier(v: json.Value) -> RemoteAccountIdentifier ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "identifier" => Ok(RemoteAccountIdentifier.Identifier(jsonv.read_str(fv)?))
      _ => Ok(RemoteAccountIdentifier.Unknown(k))
    }
  }
  Err("RemoteAccountIdentifier: no member set")
}

