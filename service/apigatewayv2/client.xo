fn json_of_deployment(v: Deployment) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.auto_deployed {
    fs.push(("autoDeployed", json.Value.Bool(x)))
  }
  if let Some(x) = v.created_date {
    fs.push(("createdDate", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.deployment_id {
    fs.push(("deploymentId", json.Value.Str(x)))
  }
  if let Some(x) = v.deployment_status {
    fs.push(("deploymentStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.deployment_status_message {
    fs.push(("deploymentStatusMessage", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_deployment(v: json.Value) -> Deployment ! Str {
  var out = Deployment{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "autoDeployed" => out.auto_deployed = jsonv.read_bool(fv)?
      "createdDate" => out.created_date = jsonv.read_time(fv, "date-time")?
      "deploymentId" => out.deployment_id = jsonv.read_str(fv)?
      "deploymentStatus" => out.deployment_status = DeploymentStatus.from(jsonv.read_str(fv)?)
      "deploymentStatusMessage" => out.deployment_status_message = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

