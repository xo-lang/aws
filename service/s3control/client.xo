  for c in xmlv.elements(e) {
    match c.name.local {
      "Name" => out.name = c.text()
      "Bucket" => out.bucket = c.text()
      "NetworkOrigin" => out.network_origin = NetworkOrigin.from(c.text())
      "VpcConfiguration" => out.vpc_configuration = xml_read_vpc_configuration(c)?
      "PublicAccessBlockConfiguration" => out.public_access_block_configuration = xml_read_public_access_block_configuration(c)?
      "CreationDate" => out.creation_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Alias" => out.alias = c.text()
      "AccessPointArn" => out.access_point_arn = c.text()
