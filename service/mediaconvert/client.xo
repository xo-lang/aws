fn from_json_cmaf_group_settings(v: json.Value) -> CmafGroupSettings ! Str {
  var out = CmafGroupSettings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "additionalManifests" => out.additional_manifests = from_json_list_of_cmaf_additional_manifest(fv)?
      "baseUrl" => out.base_url = jsonv.read_str(fv)?
      "clientCache" => out.client_cache = CmafClientCache.from(jsonv.read_str(fv)?)
      "codecSpecification" => out.codec_specification = CmafCodecSpecification.from(jsonv.read_str(fv)?)
      "dashAdaptationSetGrouping" => out.dash_adaptation_set_grouping = from_json_list_of_dash_adaptation_set_grouping(fv)?
      "dashIFrameTrickPlayNameModifier" => out.dash_i_frame_trick_play_name_modifier = jsonv.read_str(fv)?
      "dashManifestStyle" => out.dash_manifest_style = DashManifestStyle.from(jsonv.read_str(fv)?)
      "destination" => out.destination = jsonv.read_str(fv)?
      "destinationSettings" => out.destination_settings = from_json_destination_settings(fv)?
      "encryption" => out.encryption = from_json_cmaf_encryption_settings(fv)?
      "fragmentLength" => out.fragment_length = jsonv.read_int(fv)?
      "imageBasedTrickPlay" => out.image_based_trick_play = CmafImageBasedTrickPlay.from(jsonv.read_str(fv)?)
      "imageBasedTrickPlaySettings" => out.image_based_trick_play_settings = from_json_cmaf_image_based_trick_play_settings(fv)?
      "imageBasedTrickPlayVariants" => out.image_based_trick_play_variants = from_json_list_of_cmaf_image_based_trick_play_variant(fv)?
      "manifestCompression" => out.manifest_compression = CmafManifestCompression.from(jsonv.read_str(fv)?)
      "manifestDurationFormat" => out.manifest_duration_format = CmafManifestDurationFormat.from(jsonv.read_str(fv)?)
      "minBufferTime" => out.min_buffer_time = jsonv.read_int(fv)?
      "minFinalSegmentLength" => out.min_final_segment_length = jsonv.read_float(fv)?
      "mpdManifestBandwidthType" => out.mpd_manifest_bandwidth_type = CmafMpdManifestBandwidthType.from(jsonv.read_str(fv)?)
      "mpdProfile" => out.mpd_profile = CmafMpdProfile.from(jsonv.read_str(fv)?)
      "ptsOffsetHandlingForBFrames" => out.pts_offset_handling_for_b_frames = CmafPtsOffsetHandlingForBFrames.from(jsonv.read_str(fv)?)
      "segmentControl" => out.segment_control = CmafSegmentControl.from(jsonv.read_str(fv)?)
      "segmentLength" => out.segment_length = jsonv.read_int(fv)?
      "segmentLengthControl" => out.segment_length_control = CmafSegmentLengthControl.from(jsonv.read_str(fv)?)
      "streamInfResolution" => out.stream_inf_resolution = CmafStreamInfResolution.from(jsonv.read_str(fv)?)
      "targetDurationCompatibilityMode" => out.target_duration_compatibility_mode = CmafTargetDurationCompatibilityMode.from(jsonv.read_str(fv)?)
      "videoCompositionOffsets" => out.video_composition_offsets = CmafVideoCompositionOffsets.from(jsonv.read_str(fv)?)
      "writeDashManifest" => out.write_dash_manifest = CmafWriteDASHManifest.from(jsonv.read_str(fv)?)
      "writeHlsManifest" => out.write_hls_manifest = CmafWriteHLSManifest.from(jsonv.read_str(fv)?)
      "writeSegmentTimelineInRepresentation" => out.write_segment_timeline_in_representation = CmafWriteSegmentTimelineInRepresentation.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

