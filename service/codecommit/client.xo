fn json_of_pull_request(v: PullRequest) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.pull_request_id {
    fs.push(("pullRequestId", json.Value.Str(x)))
  }
  if let Some(x) = v.title {
    fs.push(("title", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.last_activity_date {
    fs.push(("lastActivityDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.creation_date {
    fs.push(("creationDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.pull_request_status {
    fs.push(("pullRequestStatus", json.Value.Str(x.value())))
  }
  if let Some(x) = v.author_arn {
    fs.push(("authorArn", json.Value.Str(x)))
  }
  if let Some(x) = v.pull_request_targets {
    fs.push(("pullRequestTargets", json_of_pull_request_target_list(x)))
  }
  if let Some(x) = v.client_request_token {
    fs.push(("clientRequestToken", json.Value.Str(x)))
  }
  if let Some(x) = v.revision_id {
    fs.push(("revisionId", json.Value.Str(x)))
  }
  if let Some(x) = v.approval_rules {
    fs.push(("approvalRules", json_of_approval_rules_list(x)))
  }
  json.Value.Object(fs)
}

fn from_json_pull_request(v: json.Value) -> PullRequest ! Str {
  var out = PullRequest{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "pullRequestId" => out.pull_request_id = jsonv.read_str(fv)?
      "title" => out.title = jsonv.read_str(fv)?
      "description" => out.description = jsonv.read_str(fv)?
      "lastActivityDate" => out.last_activity_date = jsonv.read_time(fv, "epoch-seconds")?
      "creationDate" => out.creation_date = jsonv.read_time(fv, "epoch-seconds")?
