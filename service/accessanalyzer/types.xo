  /// organization for any access that hasn't been used in 90 or more days
  /// since the analyzer's last scan. You can choose a value between 1 and 365
  /// days.
  pub unused_access_age: Int? = None
  pub analysis_rule: AnalysisRule? = None
}

/// Provides aggregate statistics about the findings for the specified
/// unused access analyzer.
