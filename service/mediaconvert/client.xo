fn from_json_h264_settings(v: json.Value) -> H264Settings ! Str {
  var out = H264Settings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "adaptiveQuantization" => out.adaptive_quantization = H264AdaptiveQuantization.from(jsonv.read_str(fv)?)
      "bandwidthReductionFilter" => out.bandwidth_reduction_filter = from_json_bandwidth_reduction_filter(fv)?
      "bitrate" => out.bitrate = jsonv.read_int(fv)?
      "codecLevel" => out.codec_level = H264CodecLevel.from(jsonv.read_str(fv)?)
      "codecProfile" => out.codec_profile = H264CodecProfile.from(jsonv.read_str(fv)?)
      "dynamicSubGop" => out.dynamic_sub_gop = H264DynamicSubGop.from(jsonv.read_str(fv)?)
      "endOfStreamMarkers" => out.end_of_stream_markers = H264EndOfStreamMarkers.from(jsonv.read_str(fv)?)
      "entropyEncoding" => out.entropy_encoding = H264EntropyEncoding.from(jsonv.read_str(fv)?)
      "explicitWeightedPrediction" => out.explicit_weighted_prediction = H264ExplicitWeightedPrediction.from(jsonv.read_str(fv)?)
      "fieldEncoding" => out.field_encoding = H264FieldEncoding.from(jsonv.read_str(fv)?)
      "flickerAdaptiveQuantization" => out.flicker_adaptive_quantization = H264FlickerAdaptiveQuantization.from(jsonv.read_str(fv)?)
      "framerateControl" => out.framerate_control = H264FramerateControl.from(jsonv.read_str(fv)?)
      "framerateConversionAlgorithm" => out.framerate_conversion_algorithm = H264FramerateConversionAlgorithm.from(jsonv.read_str(fv)?)
      "framerateDenominator" => out.framerate_denominator = jsonv.read_int(fv)?
      "framerateNumerator" => out.framerate_numerator = jsonv.read_int(fv)?
      "gopBReference" => out.gop_b_reference = H264GopBReference.from(jsonv.read_str(fv)?)
      "gopClosedCadence" => out.gop_closed_cadence = jsonv.read_int(fv)?
      "gopSize" => out.gop_size = jsonv.read_float(fv)?
      "gopSizeUnits" => out.gop_size_units = H264GopSizeUnits.from(jsonv.read_str(fv)?)
      "hrdBufferFinalFillPercentage" => out.hrd_buffer_final_fill_percentage = jsonv.read_int(fv)?
      "hrdBufferInitialFillPercentage" => out.hrd_buffer_initial_fill_percentage = jsonv.read_int(fv)?
      "hrdBufferSize" => out.hrd_buffer_size = jsonv.read_int(fv)?
      "interlaceMode" => out.interlace_mode = H264InterlaceMode.from(jsonv.read_str(fv)?)
      "maxBitrate" => out.max_bitrate = jsonv.read_int(fv)?
      "minIInterval" => out.min_i_interval = jsonv.read_int(fv)?
      "numberBFramesBetweenReferenceFrames" => out.number_b_frames_between_reference_frames = jsonv.read_int(fv)?
      "numberReferenceFrames" => out.number_reference_frames = jsonv.read_int(fv)?
      "parControl" => out.par_control = H264ParControl.from(jsonv.read_str(fv)?)
      "parDenominator" => out.par_denominator = jsonv.read_int(fv)?
      "parNumerator" => out.par_numerator = jsonv.read_int(fv)?
      "perFrameMetrics" => out.per_frame_metrics = from_json_list_of_frame_metric_type(fv)?
      "qualityTuningLevel" => out.quality_tuning_level = H264QualityTuningLevel.from(jsonv.read_str(fv)?)
      "qvbrSettings" => out.qvbr_settings = from_json_h264_qvbr_settings(fv)?
      "rateControlMode" => out.rate_control_mode = H264RateControlMode.from(jsonv.read_str(fv)?)
      "repeatPps" => out.repeat_pps = H264RepeatPps.from(jsonv.read_str(fv)?)
      "saliencyAwareEncoding" => out.saliency_aware_encoding = H264SaliencyAwareEncoding.from(jsonv.read_str(fv)?)
      "scanTypeConversionMode" => out.scan_type_conversion_mode = H264ScanTypeConversionMode.from(jsonv.read_str(fv)?)
      "sceneChangeDetect" => out.scene_change_detect = H264SceneChangeDetect.from(jsonv.read_str(fv)?)
      "slices" => out.slices = jsonv.read_int(fv)?
      "slidingWindowMs" => out.sliding_window_ms = jsonv.read_int(fv)?
      "slidingWindowPeakBitrate" => out.sliding_window_peak_bitrate = jsonv.read_int(fv)?
      "slowPal" => out.slow_pal = H264SlowPal.from(jsonv.read_str(fv)?)
      "softness" => out.softness = jsonv.read_int(fv)?
      "spatialAdaptiveQuantization" => out.spatial_adaptive_quantization = H264SpatialAdaptiveQuantization.from(jsonv.read_str(fv)?)
      "syntax" => out.syntax = H264Syntax.from(jsonv.read_str(fv)?)
      "telecine" => out.telecine = H264Telecine.from(jsonv.read_str(fv)?)
      "temporalAdaptiveQuantization" => out.temporal_adaptive_quantization = H264TemporalAdaptiveQuantization.from(jsonv.read_str(fv)?)
      "unregisteredSeiTimecode" => out.unregistered_sei_timecode = H264UnregisteredSeiTimecode.from(jsonv.read_str(fv)?)
      "writeMp4PackagingType" => out.write_mp4_packaging_type = H264WriteMp4PackagingType.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

