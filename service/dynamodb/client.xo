  var req = serialize_describe_global_table(ep, input, "") ?? e => return Err(DescribeGlobalTableErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(DescribeGlobalTableErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_describe_global_table_error(resp))
  }
  if let Some(want) = resp.header("X-Amz-Crc32") {
    let got = crc32.checksum(resp.body)
    if Int.parse(want) != Some(got) {
      return Err(DescribeGlobalTableErr.Deserialize("response CRC32 ${got} does not match X-Amz-Crc32 ${want}"))
    }
