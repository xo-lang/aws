  /// country. Please refer to country specific information in API document.
  pub sector: Sector? = None
  /// The metadata for your tax document.
  pub tax_document_metadatas: List[TaxDocumentMetadata]? = None
  /// The email address to receive VAT invoices.
  pub certified_email_id: Str? = None
  /// Additional tax information associated with your TRN.
  pub additional_tax_information: AdditionalInfoResponse? = None
  /// The legal address associated with your TRN registration.
  pub legal_address: Address? = None
}

