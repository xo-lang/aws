// aws-sdk-go-v2's TestStreamSigner_GetSignature (aws/signer/v4,
// Apache-2.0): four messages signed in a chain from the seed
// "foobarbazqux".

test "stream signer chain" {
  var s = StreamSigner{
    creds: Credentials{access_key_id: "AKID", secret_access_key: Secret.new("SECRET")},
    region: "us-east-1",
    service: "transcribestreaming",
    prev: b"foobarbazqux",
  }
  expect(s.sign(b"foo", b"foo", Time.from_unix_millis(10000)).to_hex()) == "e3a136405ec1152f62136742efd41f8639cd647a1cf21fab12aedb22cccd8999"
  expect(s.sign(b"bar", b"bar", Time.from_unix_millis(20000)).to_hex()) == "92a6ad677e839d3003672cb2cefc71ef80d42e8cb300fefce0807e8398c74068"
  expect(s.sign(b"baz", b"baz", Time.from_unix_millis(30000)).to_hex()) == "46d6660bd40f2ff5d6246a347895cabe7f4e89d9e1f4c6dad6dabdc801923be1"
  expect(s.sign(b"", b"", Time.from_unix_millis(30000)).to_hex()) == "492bcb3e21de447c85f8a9bef6c0eb833e992e405b9b3584be84edaccc5aad18"
}
