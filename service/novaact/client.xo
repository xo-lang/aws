fn read_error_internal_server_exception(resp: http.Response, body: json.Value) -> InternalServerException ! Str {
  let _ = (resp, body)
  var out = InternalServerException{}
  if let Some(hv) = resp.header("Retry-After") {
    out.retry_after_seconds = (Int.parse(hv) ?? return Err("bad integer header ${hv}"))
  }
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "message" => out.message = jsonv.read_str(fv)?
      "reason" => out.reason = InternalServerExceptionReason.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

