  /// Fresh single-use URL the partner visits to grant authorization.
  pub authorization_url: Str? = None
}

/// The customer segment a campaign template is written for. Clients must
/// tolerate values added later.
pub enum CustomerSegment: Str {
  Enterprise = "ENTERPRISE"
  Smb = "SMB"
  PublicSector = "PUBLIC_SECTOR"
  Isv = "ISV"
  Unknown(value: Str)
}

