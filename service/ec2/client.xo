      "imdsSupport" => out.imds_support = xml_read_attribute_value(c)?
      "deregistrationProtection" => out.deregistration_protection = xml_read_attribute_value(c)?
      "imageId" => out.image_id = c.text()
      "launchPermission" => out.launch_permissions = xml_read_launch_permission_list(c)?
      "productCodes" => out.product_codes = xml_read_product_code_list(c)?
      "blockDeviceMapping" => out.block_device_mappings = xml_read_block_device_mapping_list(c)?
      _ => {}
