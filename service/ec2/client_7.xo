  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.enable_acceleration {
    xmlv.elem(w, "enableAcceleration", "${x}", [])
  }
  if let Some(x) = v.static_routes_only {
    xmlv.elem(w, "staticRoutesOnly", "${x}", [])
  }
  if let Some(x) = v.local_ipv4_network_cidr {
    xmlv.elem(w, "localIpv4NetworkCidr", x, [])
