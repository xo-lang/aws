  /// The name of the S3 Excel data source.
  pub name: Str? = None
  /// The S3 paths where the Excel files are located.
  pub paths: List[Str]? = None
  /// The compression format used for the Excel files.
  pub compression_type: ParquetCompressionType? = None
  /// Patterns to exclude specific files or paths from processing.
  pub exclusions: List[Str]? = None
  /// Defines the size of file groups for batch processing.
  pub group_size: Str? = None
  /// Specifies how files should be grouped for processing.
  pub group_files: Str? = None
  /// Indicates whether to recursively process subdirectories.
  pub recurse: Bool? = None
  /// The maximum number of processing bands to use.
  pub max_band: Int? = None
  /// The maximum number of files to process in each band.
  pub max_files_in_band: Int? = None
  /// Additional configuration options for S3 direct source processing.
  pub additional_options: S3DirectSourceAdditionalOptions? = None
  /// The number of rows to process from each Excel file.
  pub number_rows: Int? = None
  /// The number of rows to skip at the end of each Excel file.
  pub skip_footer: Int? = None
  /// The Glue schemas to apply to the processed data.
  pub output_schemas: List[GlueSchema]? = None
}

/// Specifies a data target that writes to Amazon S3 in Apache Parquet
/// columnar storage.
pub struct S3GlueParquetTarget {
  /// The name of the data target.
  pub name: Str? = None
  /// The nodes that are inputs to the data target.
  pub inputs: List[Str]? = None
  /// Specifies native partitioning using a sequence of keys.
  pub partition_keys: List[List[Str]]? = None
  /// A single Amazon S3 path to write to.
  pub path: Str? = None
  /// Specifies how the data is compressed. This is generally not necessary if
  /// the data has a standard file extension. Possible values are "gzip" and
  /// "bzip" ).
  pub compression: ParquetCompressionType? = None
  /// Specifies the number of target partitions for Parquet files when writing
  /// to Amazon S3 using Glue.
  pub number_target_partitions: Str? = None
  /// A policy that specifies update behavior for the crawler.
  pub schema_change_policy: DirectSchemaChangePolicy? = None
  /// Specifies whether to automatically enable data quality evaluation for
  /// the S3 Glue Parquet target. When set to true , data quality checks are
  /// performed automatically during the write operation.
  pub auto_data_quality: AutoDataQuality? = None
}

