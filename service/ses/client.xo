  }
  xmlv.end(w, name)
}

fn xml_read_send_data_point_list(e: xml.Element) -> List[SendDataPoint] ! Str {
  var out: List[SendDataPoint] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_send_data_point(c)?)
  }
  Ok(out)
}

