fn json_of_volume(v: Volume) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.creation_time {
    fs.push(("CreationTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.file_system_id {
    fs.push(("FileSystemId", json.Value.Str(x)))
  }
  if let Some(x) = v.lifecycle {
    fs.push(("Lifecycle", json.Value.Str(x.value())))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.ontap_configuration {
    fs.push(("OntapConfiguration", json_of_ontap_volume_configuration(x)))
  }
  if let Some(x) = v.resource_arn {
    fs.push(("ResourceARN", json.Value.Str(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tags(x)))
  }
  if let Some(x) = v.volume_id {
    fs.push(("VolumeId", json.Value.Str(x)))
  }
  if let Some(x) = v.volume_type {
    fs.push(("VolumeType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.lifecycle_transition_reason {
    fs.push(("LifecycleTransitionReason", json_of_lifecycle_transition_reason(x)))
  }
  if let Some(x) = v.administrative_actions {
    fs.push(("AdministrativeActions", json_of_administrative_actions(x)))
  }
  if let Some(x) = v.open_zfs_configuration {
    fs.push(("OpenZFSConfiguration", json_of_open_zfs_volume_configuration(x)))
  }
  json.Value.Object(fs)
}

