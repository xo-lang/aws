fn xml_write_custom_origin_config(var w: xmlv.Writer, v: CustomOriginConfig, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.http_port {
    xmlv.elem(w, "HTTPPort", "${x}", [])
  }
  if let Some(x) = v.https_port {
    xmlv.elem(w, "HTTPSPort", "${x}", [])
  }
  if let Some(x) = v.origin_protocol_policy {
    xmlv.elem(w, "OriginProtocolPolicy", x.value(), [])
  }
  if let Some(x) = v.origin_ssl_protocols {
    xml_write_origin_ssl_protocols(w, x, "OriginSslProtocols", [])
  }
  if let Some(x) = v.origin_read_timeout {
    xmlv.elem(w, "OriginReadTimeout", "${x}", [])
  }
  if let Some(x) = v.origin_keepalive_timeout {
    xmlv.elem(w, "OriginKeepaliveTimeout", "${x}", [])
  }
  if let Some(x) = v.ip_address_type {
    xmlv.elem(w, "IpAddressType", x.value(), [])
  }
  if let Some(x) = v.origin_mtls_config {
    xml_write_origin_mtls_config(w, x, "OriginMtlsConfig", [])
  }
  xmlv.end(w, name)
}

fn xml_read_custom_origin_config(e: xml.Element) -> CustomOriginConfig ! Str {
  var out = CustomOriginConfig{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "HTTPPort" => out.http_port = xmlv.read_int(c.text())?
      "HTTPSPort" => out.https_port = xmlv.read_int(c.text())?
      "OriginProtocolPolicy" => out.origin_protocol_policy = OriginProtocolPolicy.from(c.text())
      "OriginSslProtocols" => out.origin_ssl_protocols = xml_read_origin_ssl_protocols(c)?
      "OriginReadTimeout" => out.origin_read_timeout = xmlv.read_int(c.text())?
      "OriginKeepaliveTimeout" => out.origin_keepalive_timeout = xmlv.read_int(c.text())?
      "IpAddressType" => out.ip_address_type = IpAddressType.from(c.text())
      "OriginMtlsConfig" => out.origin_mtls_config = xml_read_origin_mtls_config(c)?
      _ => {}
    }
  }
  Ok(out)
}

