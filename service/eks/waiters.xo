/// Calls DescribeAddon until the AddonActive acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (10s) to `max_delay` (120s).
pub fn wait_until_addon_active(c: Client, input: DescribeAddonRequest, max_wait: Duration, min_delay: Duration = 10s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeAddonErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_addon(input) {
      Ok(out) => {
        let o = jmes_of_describe_addon_response(out)
        if state == "" && waiter.path_matches(o, "addon.status", "stringEquals", "CREATE_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "addon.status", "stringEquals", "DEGRADED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "addon.status", "stringEquals", "ACTIVE") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("AddonActive: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls DescribeAddon until the AddonDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (10s) to `max_delay` (120s).
pub fn wait_until_addon_deleted(c: Client, input: DescribeAddonRequest, max_wait: Duration, min_delay: Duration = 10s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeAddonErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_addon(input) {
      Ok(out) => {
