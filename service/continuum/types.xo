}

/// What an attacker gains from exploitation, strongest capability first.
pub enum SignalAttackerGains: Str {
  Execute = "EXECUTE"
  ModifyPrivileged = "MODIFY_PRIVILEGED"
  ModifyData = "MODIFY_DATA"
  ModifyCosmetic = "MODIFY_COSMETIC"
  Read = "READ"
  Neither = "NEITHER"
  Unknown(value: Str)
}

/// The assessed attacker-gains dimension with the basis behind it.
pub struct SignalAttackerGainsDimension {
  /// The capability exploitation grants. Absent when the producer reported a
  /// value with no mapping yet.
  pub value: SignalAttackerGains? = None
  /// Where the producer's determination came from.
  pub basis: SignalBasis? = None
  /// The producer's explanation.
  pub reason: Str? = None
  /// What the producer could not determine, when anything was missing.
  pub missing_info: Str? = None
}

/// A likelihood or impact band on prioritization's shared four-value scale.
pub enum SignalBand: Str {
  VeryLow = "VERY_LOW"
  Low = "LOW"
  Moderate = "MODERATE"
  High = "HIGH"
  Unknown(value: Str)
}

/// Where an assessed value came from, strongest evidence first. A customer
/// weighing an assessment reads this to tell a fact read out of their own
/// code from the producer's inference. The first three values name a source
/// that states the value directly. The last two do not: INFERRED means the
/// producer reasoned its way to the value, and NO_EVIDENCE_DEFAULT means it
/// had nothing to reason from and used a default.
pub enum SignalBasis: Str {
  Code = "CODE"
  Graph = "GRAPH"
  Finding = "FINDING"
  Inferred = "INFERRED"
  NoEvidenceDefault = "NO_EVIDENCE_DEFAULT"
  Unknown(value: Str)
}

/// How far the consequences of exploitation reach, widest first.
pub enum SignalBlastRadius: Str {
  CrossTenant = "CROSS_TENANT"
  OtherUsersInTenant = "OTHER_USERS_IN_TENANT"
  OwnScope = "OWN_SCOPE"
  Unknown(value: Str)
}

/// The assessed blast-radius dimension with the basis behind it.
pub struct SignalBlastRadiusDimension {
  /// How far the consequences reach. Absent when the producer reported a
  /// value with no mapping yet.
  pub value: SignalBlastRadius? = None
  /// Where the producer's determination came from.
  pub basis: SignalBasis? = None
  /// The producer's explanation.
  pub reason: Str? = None
  /// What the producer could not determine, when anything was missing.
  pub missing_info: Str? = None
}

/// Deterministic values the producer computed from its assessment, as
/// distinct from the assessment itself.
pub struct SignalComputation {
  /// Computed likelihood band, on a likelihood signal.
  pub likelihood_band: SignalBand? = None
  /// Computed impact band, on an impact signal.
  pub impact_band: SignalBand? = None
  /// How many of the four exploit preconditions act as barriers (0-4).
  pub barriers: Int? = None
}

/// A producer's structured rationale for a signal's confidence.
pub struct SignalConfidenceReasoning {
  /// One-line rationale.
  pub summary: Str? = None
  /// The individual factors behind it.
  pub factors: List[Str]? = None
}

/// The scoring axis a signal speaks to.
pub enum SignalDimension: Str {
  Exploitability = "EXPLOITABILITY"
  BlastRadius = "BLAST_RADIUS"
  NetworkExposure = "NETWORK_EXPOSURE"
  Precondition = "PRECONDITION"
  CodeContext = "CODE_CONTEXT"
  LikelihoodAssessment = "LIKELIHOOD_ASSESSMENT"
  ImpactAssessment = "IMPACT_ASSESSMENT"
  Unknown(value: Str)
}

/// What validation established about exploitability, as summarized onto the
/// scoring signal derived from it.
pub struct SignalExploitability {
  /// Validation's verdict. `UNCERTAIN` covers a run that was inconclusive —
  /// out of budget, an ambiguous failure, or no decisive layer reached —
  /// and is never a refutation.
  pub verdict: ExploitabilityVerdict? = None
  /// Whether validation reached the high-value sink the attack path posited.
  /// A Boolean rather than an enum: the sink was either reached or it was
  /// not, and how far the walk got when it was not is already carried, with
  /// more precision, by `highestLayerReached`. An unknown is the absent
  /// member.
  pub reached_crown_jewels: Bool? = None
  /// The highest impact layer validation reached, 1-5, as a measure of how
  /// far the attack path was walked.
  pub highest_layer_reached: Int? = None
  /// How strong the evidence behind the verdict is.
  pub confidence_tier: ValidationConfidenceTier? = None
  /// Whether the proven exploit is automatable rather than one-off. A Boolean
  /// for the same reason as `SignalPrecondition.value`: validation records a
  /// bool, and an unknown is the absent member.
  pub scriptable: Bool? = None
  /// The VALIDATION_EVIDENCE artifact on this same issue holding the proof
  /// this verdict summarizes. Fetch it with GetCodeIssueArtifact for the full
  /// reasoning chain and exploit artifact.
  pub source_validation_artifact_id: Str? = None
}

/// The three impact dimensions an impact signal assessed. The computed
/// impact band is derived from attackerGains and blastRadius, then shifted
/// by targetValue.
pub struct SignalImpactDimensions {
  /// What the attacker gains from exploitation.
  pub attacker_gains: SignalAttackerGainsDimension? = None
  /// How far the consequences reach.
  pub blast_radius: SignalBlastRadiusDimension? = None
  /// How valuable the target is, which can shift the band off its base value.
  pub target_value: SignalTargetValueDimension? = None
}

/// One assessed precondition with the basis behind it.
pub struct SignalPrecondition {
  /// The producer's determination. A Boolean rather than an enum, against the
  /// Common Terms preference for enums on extensibility grounds. The question
  /// each precondition answers is closed — is the code reachable, is
  /// configuration required, must a user other than the attacker interact —
  /// and the only third state, "not determined", is already expressed by
  /// omitting this member, which the projection does whenever the stored
  /// value is not a bool. An enum would give two ways to say the same thing,
  /// while `basis` and `missingInfo` already qualify how firm the answer is.
  pub value: Bool? = None
  /// Where the producer's determination came from.
  pub basis: SignalBasis? = None
  /// The producer's explanation.
  pub reason: Str? = None
  /// What the producer could not determine, when anything was missing.
  pub missing_info: Str? = None
}

/// The four preconditions a likelihood signal assessed.
pub struct SignalPreconditions {
  /// Whether the vulnerable code path is reachable by an attacker.
  pub reachable_from_attacker: SignalPrecondition? = None
  /// Whether exploitation depends on a non-default configuration.
  pub configuration_needed: SignalPrecondition? = None
  /// What level of access exploitation requires.
  pub access_level: SignalAccessPrecondition? = None
  /// Whether exploitation requires a user other than the attacker to take
  /// part, for example by opening a link or a file (CVSS User Interaction).
  pub user_interaction_required: SignalPrecondition? = None
}

/// A signal's own rating, an input to scoring rather than a finding
/// severity.
pub enum SignalStrength: Str {
  None = "NONE"
  Weak = "WEAK"
  Moderate = "MODERATE"
  Strong = "STRONG"
  Unknown(value: Str)
}

/// How valuable the exploited target is.
pub enum SignalTargetValue: Str {
  High = "HIGH"
  Medium = "MEDIUM"
  Low = "LOW"
  Unknown(value: Str)
}

/// The assessed target-value dimension with the basis behind it.
pub struct SignalTargetValueDimension {
  /// How valuable the target is. Absent when the producer reported a value
  /// with no mapping yet.
  pub value: SignalTargetValue? = None
  /// Where the producer's determination came from.
  pub basis: SignalBasis? = None
  /// The producer's explanation.
  pub reason: Str? = None
  /// What the producer could not determine, when anything was missing.
  pub missing_info: Str? = None
}

/// Specifies the provider to authorize and, optionally, the name the new
/// integration will use.
pub struct StartIntegrationAuthorizationInput {
  /// The provider to authorize. Only GITHUB is supported.
  pub provider_type: IntegrationAuthorizationProviderType? = None
  /// The name the integration will be created with. When specified, the
  /// request fails with ConflictException if an integration with this name
  /// already exists in the account, before the caller leaves for the
  /// provider. The name is only checked: it is not reserved, stored, or
  /// authorized. CreateIntegration requires its own name, checks it again,
  /// and may use a different one.
  pub name: Str? = None
}

/// Contains the values to send to the provider's authorization endpoint.
pub struct StartIntegrationAuthorizationOutput {
  /// An opaque value to send as the OAuth `state` parameter. Pass the value
  /// the provider returns in its callback to CreateIntegration as
  /// `authorization.state`.
  pub state: Str? = None
  /// The PKCE code challenge to send as the OAuth `code_challenge` parameter.
  pub code_challenge: Str? = None
  /// The PKCE challenge method to send as the OAuth `code_challenge_method`
  /// parameter.
  pub code_challenge_method: OAuthCodeChallengeMethod? = None
  /// The time after which CreateIntegration no longer accepts this
  /// authorization.
  pub expires_at: Time? = None
}

/// The request was denied due to request throttling.
pub struct ThrottlingException {
  /// Description of the throttling error.
  pub message: Str? = None
}

/// Mutable source and operating-policy settings for a code environment.
pub struct UpdateCodeConfiguration {
  /// Source changes. s3Sources replaces the environment's S3 source, and
  /// repositorySources replaces its repository selections.
  pub source_configuration: EnvironmentSourceConfiguration? = None
  /// Operating-policy changes. network replaces the environment's network
  /// policy; a network without allowedDomains allows no domains. Builds
  /// accepted before the change keep the domains they were accepted with.
  /// patchCreationPolicy replaces the patch creation policy. scanFrequency
  /// updates scan cadence. Omitted members preserve their stored values.
  pub environment_configuration: EnvironmentConfiguration? = None
}

/// Specifies the mutable Collector properties. At least one property must
/// be supplied. k8ClusterRole models an atomic set-or-remove mutation, so
/// roleArn and externalId are replaced or removed together.
pub struct UpdateCollectorInput {
  /// The unique identifier of the Collector to update.
  pub collector_id: Str? = None
  /// The new customer-visible name.
  pub name: Str? = None
  /// Atomic update to the IAM role configuration used to collect Kubernetes
  /// cluster metadata. The set variant requires a complete configuration; the
  /// authenticated caller must be allowed to pass its exact roleArn to
  /// Continuum. The remove variant clears both the role and external ID.
  pub kubernetes_cluster_role: KubernetesClusterRoleUpdate? = None
}

/// Contains the current state of the updated Collector.
pub struct UpdateCollectorOutput {
  /// The unique identifier of the updated Collector.
  pub collector_id: Str? = None
  /// The ARN of the updated Collector.
  pub collector_arn: Str? = None
  /// The source collected by this Collector.
  pub type_value: CollectorType? = None
  /// The current lifecycle status.
  pub status: CollectorStatus? = None
  /// The ARN of the provisioned AWS Config Recorder.
  pub config_recorder_arn: Str? = None
  /// IAM role used to collect Kubernetes cluster metadata.
  pub kubernetes_cluster_role_arn: Str? = None
  /// The timestamp when the Collector was created.
  pub created_at: Time? = None
  /// The time of the last successful UpdateCollector call, returned at
  /// whole-second precision in the same date-time format as createdAt.
  pub updated_at: Time? = None
}

/// Type-specific changes to an environment. Omitted members preserve stored
/// values.
pub struct UpdateEnvironmentConfiguration {
  /// Changes to a code-scanning environment.
  pub code_configuration: UpdateCodeConfiguration? = None
}

/// Specifies the mutable environment properties. Supply a name or a change
/// under configuration.codeConfiguration. Its sourceConfiguration.s3Sources
/// and sourceConfiguration.repositorySources replace the S3 source and
/// repository selections. Its environmentConfiguration has patch semantics:
/// omitted members preserve stored values, scanFrequency updates scan
/// cadence, and network and patchCreationPolicy replace the corresponding
/// policies.
pub struct UpdateEnvironmentInput {
  /// The unique identifier of the environment to update.
  pub environment_id: Str? = None
  /// The new customer-visible name.
  pub name: Str? = None
  /// Type-specific configuration changes. Omission preserves the
  /// configuration.
  pub configuration: UpdateEnvironmentConfiguration? = None
}

/// Contains the current state of the updated environment. Use
/// GetEnvironment to read its source and environment configuration.
pub struct UpdateEnvironmentOutput {
  /// The unique identifier of the updated environment.
  pub environment_id: Str? = None
  /// The ARN of the updated environment.
  pub environment_arn: Str? = None
  /// The current customer-visible name of the environment.
  pub name: Str? = None
  /// The current operational status of the environment.
  pub status: EnvironmentStatus? = None
  /// Human-readable details about the current status.
  pub status_message: Str? = None
  /// The timestamp when the status last transitioned. Uses the existing
  /// GetEnvironment/ListEnvironments ISO-8601 wire format for this field.
  pub status_updated_at: Time? = None
  /// The timestamp when the environment was created. Uses the existing
  /// GetEnvironment/ListEnvironments ISO-8601 wire format for this field.
  pub created_at: Time? = None
  /// Type-specific state, including Collector details and the latest scan.
  /// Read source and operating-policy settings through GetEnvironment.
  pub configuration: EnvironmentConfigurationDetails? = None
}

/// Specifies the S3 integration and the credentials to validate and save.
pub struct UpdateIntegrationInput {
  /// The unique identifier of the S3 integration to update.
  pub integration_id: Str? = None
  /// The provider-specific changes to apply. The member must match the
  /// integration's provider type, and only S3 integrations can be updated.
  pub provider_configuration: UpdateProviderConfiguration? = None
}

/// Contains the current state of the updated S3 integration. The sensitive
/// external ID is omitted.
pub struct UpdateIntegrationOutput {
  pub integration_id: Str? = None
  pub integration_arn: Str? = None
  pub name: Str? = None
  pub integration_type: IntegrationType? = None
  pub provider_details: ProviderDetails? = None
  /// When the integration was created.
  pub created_at: Time? = None
  /// When the integration was last updated.
  pub updated_at: Time? = None
}

/// Provider-specific changes for updating an integration. Only S3
/// integrations can be updated, so S3 is the only member.
pub enum UpdateProviderConfiguration {
  S3(value: UpdateS3Configuration)
  /// A member this client does not know (a newer service's).
  Unknown(tag: Str)
}

/// Replacement credentials for a customer-managed S3 integration. The
/// bucket cannot be changed.
pub struct UpdateS3Configuration {
  /// The role to use. Supply the current role when rotating only the external
  /// ID. The caller must be allowed to pass this exact role to Continuum.
  pub role_arn: Str? = None
  /// The replacement external ID used when assuming the supplied role. If
  /// omitted, the existing external ID is preserved. This value is sensitive
  /// and is never included in the public integration response.
  pub external_id: Str? = None
}

/// How strong the evidence behind an exploitability verdict is, weakest
/// first. Modeled as named tiers rather than the producer's 1-4 ordinal:
/// the number alone carries no meaning outside Continuum's own table, and a
/// customer branching on "was this actually run" needs the distinction by
/// name. The declaration order is the ordering.
pub enum ValidationConfidenceTier: Str {
  SourceRead = "SOURCE_READ"
  StaticProven = "STATIC_PROVEN"
  BuildProven = "BUILD_PROVEN"
  RuntimeProven = "RUNTIME_PROVEN"
  Unknown(value: Str)
}

/// Projected content for a VALIDATION_EVIDENCE artifact: the validation
/// agent's durable proof of exploitability.
pub struct ValidationEvidenceBody {
  /// Exploitability verdict. Explicit UNCERTAIN replaces the producer's
  /// tri-state `exploitable: true | false | null`, so an absent verdict is
  /// never confused with a negative one.
  pub exploitable: ExploitabilityVerdict? = None
  /// How the validation run ended. Absent when the producer reported a status
  /// with no mapping yet: the rest of the body still projects, so one
  /// unmapped enum never costs a customer the whole artifact.
  pub terminal_status: ValidationTerminalStatus? = None
  /// One verdict per attack flow assessed in the bundle.
  pub flow_verdicts: List[FlowVerdict]? = None
  /// Identifiers of attack flows upgraded to Confirmed provenance.
  pub attack_flows_confirmed: List[Str]? = None
  /// Concrete payload and its observed effect, when validation produced one
  /// by sending an HTTP request. Only an HTTP proof projects here. A
  /// validation agent that proves exploitability by RUNNING code against the
  /// repository projects `executedProof`, and one that proves it by reading
  /// the source projects `sourceAnalysis`. All three are mutually exclusive:
  /// at most one is present.
  pub exploit_artifact: ValidationExploitArtifact? = None
  /// Proof the agent produced by executing code against the repository under
  /// test, with the output that execution produced.
  pub executed_proof: ValidationExecutedProof? = None
  /// Proof the agent produced by reading the repository's source, with
  /// nothing built or run.
  pub source_analysis: ValidationSourceAnalysis? = None
  /// Per-finding breakdown for a multi-finding bundle. Absent for a
  /// single-finding bundle.
  pub per_finding_results: List[PerFindingResult]? = None
}

pub struct ValidationException {
  pub message: Str? = None
  pub field_list: List[ValidationExceptionField]? = None
}

pub struct ValidationExceptionField {
  pub path: Str? = None
  pub message: Str? = None
}

/// Proof of exploitability the validation agent produced by executing code
/// against the repository under test, with the output that execution
/// produced.
pub struct ValidationExecutedProof {
  /// The code that was run. Not a request payload: it imports the
  /// repository's own modules and drives the vulnerable code path directly.
  pub code: ValidationProofCode? = None
  /// What the execution printed, including the agent's own PASS/FAIL
  /// assertions. Absent when the run printed nothing retained.
  pub output: ValidationProofOutput? = None
  /// Effect the execution actually produced. `observedEffect` rather than
  /// `effect`: this one was witnessed, and the name has to stay
  /// distinguishable from `ValidationSourceAnalysis.inferredEffect`, which
  /// was not.
  pub observed_effect: ExploitEffect? = None
}

/// A concrete exploit payload and the effect validation observed from it.
pub struct ValidationExploitArtifact {
  /// The exact payload sent.
  pub payload: Str? = None
  /// Target the payload was sent to.
  pub target_url: Str? = None
  /// HTTP method the payload was sent with.
  pub http_method: ArtifactHttpMethod? = None
  /// Headers sent with the payload.
  pub headers: Map[Str, Str]? = None
  /// HTTP status observed in the response.
  pub response_status: Int? = None
  /// Leading portion of the response body, bounded by the producer.
  pub response_snippet: Str? = None
  /// Effect observed from sending the payload.
  pub effect: ExploitEffect? = None
}

/// The executed proof's program. Further members, such as command,
/// workingDirectory and supportingInputs, can be added later as optional
/// details.
pub struct ValidationProofCode {
  /// Proof program files, main file first, in their retained order.
  pub proof_code: List[ValidationProofMaterial]? = None
}

/// One proof program file. Further members, such as path and purpose, can
/// be added later as optional details.
pub struct ValidationProofMaterial {
  /// The file's non-blank text, exactly as retained.
  pub content: Str? = None
}

/// Retained run output. Further members, such as completion and
/// outputCompleteness, can be added later as optional details.
pub struct ValidationProofOutput {
  /// What the run printed: standard output and standard error merged, as
  /// retained. The text may be empty.
  pub console_output: Str? = None
}

/// Proof of exploitability the validation agent produced by reading the
/// repository's source, with nothing built or run. Further members, such as
/// diagram and references, can be added later as optional details.
pub struct ValidationSourceAnalysis {
  /// The non-blank analysis as Markdown: the annotated entry-to-sink walk,
  /// its citations, and why the checked guards are absent or bypassed.
  pub summary: Str? = None
  /// Effect the agent concluded WOULD occur. Deliberately not `effect`:
  /// nothing was executed, so this is reasoned from the source and must not
  /// be read as an observation. See `ValidationExecutedProof.observedEffect`.
  pub inferred_effect: ExploitEffect? = None
}

/// How a validation run ended. Producer statuses map onto these; an
/// unmapped status omits `terminalStatus` while the rest of the body still
/// projects.
pub enum ValidationTerminalStatus: Str {
  Completed = "COMPLETED"
  Failed = "FAILED"
  NoSourceAvailable = "NO_SOURCE_AVAILABLE"
  Partial = "PARTIAL"
  Unknown(value: Str)
}
