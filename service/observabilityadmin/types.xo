  /// The Amazon Resource Name (ARN) of the telemetry rule resource to tag.
  pub resource_arn: Str? = None
  /// The key-value pairs to add or update for the telemetry rule resource.
  pub tags: Map[Str, Str]? = None
}

/// A model representing the state of a resource within an account according
/// to telemetry config.
pub struct TelemetryConfiguration {
  /// The account ID which contains the resource managed in telemetry
  /// configuration. An example of a valid account ID is 012345678901 .
  pub account_identifier: Str? = None
  /// The configuration state for the resource, for example { Logs:
  /// NotApplicable; Metrics: Enabled; Traces: NotApplicable; } .
  pub telemetry_configuration_state: Map[Str, TelemetryState]? = None
  /// The type of resource, for example Amazon Web Services::EC2::Instance ,
  /// or Amazon Web Services::EKS::Cluster , etc.
  pub resource_type: ResourceType? = None
  /// The identifier of the resource, for example for Amazon VPC, it would be
  /// vpc-1a2b3c4d5e6f1a2b3 .
  pub resource_identifier: Str? = None
  /// Tags associated with the resource, for example { Name:
  /// "ExampleInstance", Environment: "Development" } .
  pub resource_tags: Map[Str, Str]? = None
  /// The timestamp of the last change to the telemetry configuration for the
  /// resource. For example, 1728679196318 .
  pub last_update_time_stamp: Int? = None
  pub telemetry_source_type: TelemetrySourceType? = None
}

/// Configuration specifying where and how telemetry data should be
/// delivered for Amazon Web Services resources.
pub struct TelemetryDestinationConfiguration {
  /// The type of destination for the telemetry data (e.g., "Amazon CloudWatch
  /// Logs", "S3").
  pub destination_type: DestinationType? = None
  /// The pattern used to generate the destination path or name, supporting
  /// macros like &lt;resourceId&gt; and &lt;accountId&gt;.
  pub destination_pattern: Str? = None
  /// The number of days to retain the telemetry data in the destination.
  pub retention_in_days: Int? = None
  /// Configuration parameters specific to VPC Flow Logs when VPC is the
  /// resource type.
  pub vpc_flow_log_parameters: VPCFlowLogParameters? = None
  /// Configuration parameters specific to Amazon Web Services CloudTrail when
  /// CloudTrail is the source type.
  pub cloudtrail_parameters: CloudtrailParameters? = None
  /// Configuration parameters specific to ELB load balancer logging when ELB
  /// is the resource type.
  pub elb_load_balancer_logging_parameters: ELBLoadBalancerLoggingParameters? = None
  /// Configuration parameters specific to WAF logging when WAF is the
  /// resource type.
  pub waf_logging_parameters: WAFLoggingParameters? = None
  /// The configuration parameters for log delivery when the resource type
  /// supports configurable log types, such as Amazon Bedrock Knowledge Bases,
  /// Amazon Bedrock AgentCore payment managers, or Elastic Load Balancing
  /// Application Load Balancers.
  pub log_delivery_parameters: LogDeliveryParameters? = None
  /// Configuration parameters specific to MSK monitoring when MSK is the
  /// resource type.
  pub msk_monitoring_parameters: MskMonitoringParameters? = None
  /// The Amazon Resource Name (ARN) of the customer-managed Amazon Web
  /// Services KMS key used to encrypt the log groups created during telemetry
  /// rule remediation.
  pub kms_key_arn: Str? = None
}

pub enum TelemetryEnrichmentStatus: Str {
  Running = "Running"
  Stopped = "Stopped"
  Impaired = "Impaired"
  Unknown(value: Str)
}

/// Represents a complete telemetry pipeline resource with configuration,
/// status, and metadata for data processing and transformation.
pub struct TelemetryPipeline {
  /// The timestamp when the telemetry pipeline was created.
  pub created_time_stamp: Int? = None
  /// The timestamp when the telemetry pipeline was last updated.
  pub last_update_time_stamp: Int? = None
  /// The Amazon Resource Name (ARN) of the telemetry pipeline.
  pub arn: Str? = None
  /// The name of the telemetry pipeline.
  pub name: Str? = None
  /// The configuration that defines how the telemetry pipeline processes
  /// data.
  pub configuration: TelemetryPipelineConfiguration? = None
  /// The current status of the telemetry pipeline.
  pub status: TelemetryPipelineStatus? = None
  /// Additional information about the pipeline status, including reasons for
  /// failure states.
  pub status_reason: TelemetryPipelineStatusReason? = None
  /// The key-value pairs associated with the telemetry pipeline resource.
  pub tags: Map[Str, Str]? = None
}

/// Defines the configuration for a pipeline, including how data flows from
/// sources through processors to destinations. The configuration is
/// specified in YAML format and must include a valid pipeline definition
/// with required source and sink components. This pipeline enables
/// end-to-end telemetry data collection, transformation, and delivery while
/// supporting optional processing steps and extensions for enhanced
/// functionality. The primary pipeline configuration section are: Source:
/// Defines where log data originates from (S3 buckets, CloudWatch Logs,
/// third-party APIs). Each pipeline must have exactly one source.
/// Processors (optional): Transform, parse, and enrich log data as it flows
/// through the pipeline. Processors are applied sequentially in the order
/// they are defined. Sink: Defines the destination where processed log data
/// is sent. Each pipeline must have exactly one sink. Extensions
/// (optional): Provide additional functionality such as Amazon Web Services
/// Secrets Manager integration for credential management. For more details
/// on each configuration section see CloudWatch pipelines User Guide .
/// Additional comprehensive configuration examples can be found in the
/// CreateTelemetryPipeline API docs .
pub struct TelemetryPipelineConfiguration {
  /// The pipeline configuration body that defines the data processing rules
  /// and transformations.
  pub body: Str? = None
}

pub enum TelemetryPipelineStatus: Str {
  Creating = "CREATING"
  Active = "ACTIVE"
  Updating = "UPDATING"
  Deleting = "DELETING"
  CreateFailed = "CREATE_FAILED"
  UpdateFailed = "UPDATE_FAILED"
  Unknown(value: Str)
}

/// Provides detailed information about the status of a telemetry pipeline,
/// including reasons for specific states.
pub struct TelemetryPipelineStatusReason {
  /// A description of the pipeline status reason, providing additional
  /// context about the current state.
  pub description: Str? = None
}

/// Contains summary information about a telemetry pipeline for listing
/// operations.
pub struct TelemetryPipelineSummary {
  /// The timestamp when the telemetry pipeline was created.
  pub created_time_stamp: Int? = None
  /// The timestamp when the telemetry pipeline was last updated.
  pub last_update_time_stamp: Int? = None
  /// The Amazon Resource Name (ARN) of the telemetry pipeline.
  pub arn: Str? = None
  /// The name of the telemetry pipeline.
  pub name: Str? = None
  /// The current status of the telemetry pipeline.
  pub status: TelemetryPipelineStatus? = None
  /// The key-value pairs associated with the telemetry pipeline resource.
  pub tags: Map[Str, Str]? = None
  /// A summary of the pipeline configuration components.
  pub configuration_summary: ConfigurationSummary? = None
}

/// Defines how telemetry should be configured for specific Amazon Web
/// Services resources.
pub struct TelemetryRule {
  /// The type of Amazon Web Services resource to configure telemetry for (for
  /// example, AWS::EC2::VPC , AWS::EKS::Cluster ,
  /// AWS::ElasticLoadBalancingV2::LoadBalancer , AWS::Bedrock::KnowledgeBase
  /// , AWS::BedrockAgentCore::PaymentManager , or
  /// AWS::XRay::TransactionSearchConfig ).
  pub resource_type: ResourceType? = None
  /// The type of telemetry to collect (Logs, Metrics, or Traces).
  pub telemetry_type: TelemetryType? = None
  /// The specific telemetry source types to configure for the resource, such
  /// as VPC_FLOW_LOGS or EKS_AUDIT_LOGS. TelemetrySourceTypes must be
  /// correlated with the specific resource type.
  pub telemetry_source_types: List[TelemetrySourceType]? = None
  /// Configuration specifying where and how the telemetry data should be
  /// delivered.
  pub destination_configuration: TelemetryDestinationConfiguration? = None
  /// The organizational scope to which the rule applies, specified using
  /// accounts or organizational units.
  pub scope: Str? = None
  /// Criteria for selecting which resources the rule applies to, such as
  /// resource tags.
  pub selection_criteria: Str? = None
  /// If set to true , Amazon CloudWatch Observability Admin detects and
  /// remediates configuration drift in telemetry resources that it manages.
  /// For example, if a VPC flow log's format, traffic type, or aggregation
  /// interval no longer matches the rule's destination configuration, the
  /// flow log is replaced with one that matches. Only Observability
  /// Admin-managed resources are updated; customer-created resources are
  /// never modified. Currently supported for AWS::EC2::VPC resources (VPC
  /// flow logs).
  pub allow_field_updates: Bool? = None
  /// An optional list of Amazon Web Services Regions where this telemetry
  /// rule should be replicated. When specified, the rule is created in the
  /// home region and automatically replicated to all listed regions. Mutually
  /// exclusive with AllRegions .
  pub regions: List[Str]? = None
  /// If set to true , the telemetry rule is replicated to all Amazon Web
  /// Services Regions where Amazon CloudWatch Observability Admin is
  /// available in the current partition. When new regions become available,
  /// the rule automatically replicates to them. Mutually exclusive with
  /// Regions .
  pub all_regions: Bool? = None
}

/// A summary of a telemetry rule's key properties.
pub struct TelemetryRuleSummary {
  /// The name of the telemetry rule.
  pub rule_name: Str? = None
  /// The Amazon Resource Name (ARN) of the telemetry rule.
  pub rule_arn: Str? = None
  /// The timestamp when the telemetry rule was created.
  pub created_time_stamp: Int? = None
  /// The timestamp when the telemetry rule was last modified.
  pub last_update_time_stamp: Int? = None
  /// The type of Amazon Web Services resource the rule applies to.
  pub resource_type: ResourceType? = None
  /// The type of telemetry (Logs, Metrics, or Traces) the rule configures.
  pub telemetry_type: TelemetryType? = None
  /// The types of telemetry sources configured for this rule, such as VPC
  /// Flow Logs or EKS audit logs. TelemetrySourceTypes must be correlated
  /// with the specific resource type.
  pub telemetry_source_types: List[TelemetrySourceType]? = None
}

/// Specifies the type of telemetry source for a resource, such as EKS
/// cluster logs.
pub enum TelemetrySourceType: Str {
  VpcFlowLogs = "VPC_FLOW_LOGS"
  Route53ResolverQueryLogs = "ROUTE53_RESOLVER_QUERY_LOGS"
  EksAuditLogs = "EKS_AUDIT_LOGS"
  EksAuthenticatorLogs = "EKS_AUTHENTICATOR_LOGS"
  EksControllerManagerLogs = "EKS_CONTROLLER_MANAGER_LOGS"
  EksSchedulerLogs = "EKS_SCHEDULER_LOGS"
  EksApiLogs = "EKS_API_LOGS"
  Unknown(value: Str)
}

pub enum TelemetryState: Str {
  Enabled = "Enabled"
  Disabled = "Disabled"
  NotApplicable = "NotApplicable"
  Unknown(value: Str)
}

pub enum TelemetryType: Str {
  Logs = "Logs"
  Metrics = "Metrics"
  Traces = "Traces"
  Insights = "Insights"
  Unknown(value: Str)
}

