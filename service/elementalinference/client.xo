fn json_of_trigger(v: Trigger) -> json.Value {
  match v {
    FixedInterval(x) => json.Value.Object([("fixedInterval", json_of_fixed_interval_trigger(x))])
    PerShot(x) => json.Value.Object([("perShot", json_of_shot_trigger(x))])
    PerScene(x) => json.Value.Object([("perScene", json_of_scene_trigger(x))])
    PerClip(x) => json.Value.Object([("perClip", json_of_clip_trigger(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_trigger(v: json.Value) -> Trigger ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "fixedInterval" => Ok(Trigger.FixedInterval(from_json_fixed_interval_trigger(fv)?))
      "perShot" => Ok(Trigger.PerShot(from_json_shot_trigger(fv)?))
      "perScene" => Ok(Trigger.PerScene(from_json_scene_trigger(fv)?))
      "perClip" => Ok(Trigger.PerClip(from_json_clip_trigger(fv)?))
      _ => Ok(Trigger.Unknown(k))
    }
  }
  Err("Trigger: no member set")
}

