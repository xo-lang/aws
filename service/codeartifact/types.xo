}

pub enum PackageVersionOriginType: Str {
  Internal = "INTERNAL"
  External = "EXTERNAL"
  Unknown = "UNKNOWN"
  UnknownValue(value: Str)
}

pub enum PackageVersionSortType: Str {
  PublishedTime = "PUBLISHED_TIME"
  Unknown(value: Str)
}

pub enum PackageVersionStatus: Str {
