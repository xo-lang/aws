    }
    match k {
      "Action" => out.action = jsonv.read_str(fv)?
      "AutoAppliedAfterDate" => out.auto_applied_after_date = jsonv.read_time(fv, "epoch-seconds")?
      "ForcedApplyDate" => out.forced_apply_date = jsonv.read_time(fv, "epoch-seconds")?
      "OptInStatus" => out.opt_in_status = jsonv.read_str(fv)?
      "CurrentApplyDate" => out.current_apply_date = jsonv.read_time(fv, "epoch-seconds")?
      "Description" => out.description = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_pending_maintenance_action_details(v: List[PendingMaintenanceAction]) -> json.Value {
