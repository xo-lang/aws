fn json_of_job_summary(v: JobSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.job_arn {
    fs.push(("jobArn", json.Value.Str(x)))
  }
  if let Some(x) = v.job_id {
    fs.push(("jobId", json.Value.Str(x)))
  }
  if let Some(x) = v.commit_id {
    fs.push(("commitId", json.Value.Str(x)))
  }
  if let Some(x) = v.commit_message {
    fs.push(("commitMessage", json.Value.Str(x)))
  }
  if let Some(x) = v.commit_time {
    fs.push(("commitTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.start_time {
    fs.push(("startTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.end_time {
    fs.push(("endTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.job_type {
    fs.push(("jobType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.source_url {
    fs.push(("sourceUrl", json.Value.Str(x)))
  }
  if let Some(x) = v.source_url_type {
    fs.push(("sourceUrlType", json.Value.Str(x.value())))
  }
  json.Value.Object(fs)
}

fn from_json_job_summary(v: json.Value) -> JobSummary ! Str {
  var out = JobSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "jobArn" => out.job_arn = jsonv.read_str(fv)?
      "jobId" => out.job_id = jsonv.read_str(fv)?
      "commitId" => out.commit_id = jsonv.read_str(fv)?
      "commitMessage" => out.commit_message = jsonv.read_str(fv)?
      "commitTime" => out.commit_time = jsonv.read_time(fv, "epoch-seconds")?
      "startTime" => out.start_time = jsonv.read_time(fv, "epoch-seconds")?
      "status" => out.status = JobStatus.from(jsonv.read_str(fv)?)
      "endTime" => out.end_time = jsonv.read_time(fv, "epoch-seconds")?
      "jobType" => out.job_type = JobType.from(jsonv.read_str(fv)?)
      "sourceUrl" => out.source_url = jsonv.read_str(fv)?
      "sourceUrlType" => out.source_url_type = SourceUrlType.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

