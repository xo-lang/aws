fn json_of_value(v: Value) -> json.Value {
  match v {
    IsNull(x) => json.Value.Object([("isNull", json.Value.Bool(x))])
    BitValue(x) => json.Value.Object([("bitValue", json.Value.Bool(x))])
    BigIntValue(x) => json.Value.Object([("bigIntValue", json.Value.Int(x))])
    IntValue(x) => json.Value.Object([("intValue", json.Value.Int(x))])
    DoubleValue(x) => json.Value.Object([("doubleValue", jsonv.float(x))])
    RealValue(x) => json.Value.Object([("realValue", jsonv.float32(x))])
    StringValue(x) => json.Value.Object([("stringValue", json.Value.Str(x))])
    BlobValue(x) => json.Value.Object([("blobValue", jsonv.blob(x))])
    ArrayValues(x) => json.Value.Object([("arrayValues", json_of_array_value_list(x))])
    StructValue(x) => json.Value.Object([("structValue", json_of_struct_value(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_value(v: json.Value) -> Value ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "isNull" => Ok(Value.IsNull(jsonv.read_bool(fv)?))
      "bitValue" => Ok(Value.BitValue(jsonv.read_bool(fv)?))
      "bigIntValue" => Ok(Value.BigIntValue(jsonv.read_int(fv)?))
      "intValue" => Ok(Value.IntValue(jsonv.read_int(fv)?))
      "doubleValue" => Ok(Value.DoubleValue(jsonv.read_float(fv)?))
      "realValue" => Ok(Value.RealValue(jsonv.read_float32(fv)?))
      "stringValue" => Ok(Value.StringValue(jsonv.read_str(fv)?))
      "blobValue" => Ok(Value.BlobValue(jsonv.read_blob(fv)?))
      "arrayValues" => Ok(Value.ArrayValues(from_json_array_value_list(fv)?))
      "structValue" => Ok(Value.StructValue(from_json_struct_value(fv)?))
      _ => Ok(Value.Unknown(k))
    }
  }
  Err("Value: no member set")
}

