fn json_of_log_type_values_list(v: List[Str]) -> json.Value {
  json.Value.List(v.map(fn(x: Str) -> json.Value { json.Value.Str(x) }))
}

fn from_json_log_type_values_list(v: json.Value) -> List[Str] ! Str {
  var out: List[Str] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(jsonv.read_str(fv)?)
  }
  Ok(out)
}

fn json_of_log_types_map(v: Map[Str, List[Str]]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, List[Str])) -> (Str, json.Value) { (e.0, json_of_log_type_values_list(e.1)) }))
}

fn from_json_log_types_map(v: json.Value) -> Map[Str, List[Str]] ! Str {
  var out: Map[Str, List[Str]] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_log_type_values_list(fv)?)
  }
  Ok(out)
}

