  pub endpoint: Str? = None
  /// If true , the graph has a public endpoint, otherwise not.
  pub public_connectivity: Bool? = None
  pub vector_search_configuration: VectorSearchConfiguration? = None
  /// The number of replicas for the graph.
  pub replica_count: Int? = None
  /// The ID of the KMS key used to encrypt and decrypt graph data.
  pub kms_key_identifier: Str? = None
  /// The ID of the snapshot from which the graph was created, if it was
  /// created from a snapshot.
  pub source_snapshot_id: Str? = None
  /// If true , deletion protection is enabled for the graph.
  pub deletion_protection: Bool? = None
  /// The build number of the graph.
  pub build_number: Str? = None
}

pub struct StartImportTaskInput {
  pub import_options: ImportOptions? = None
  /// If set to true, the task halts when an import error is encountered. If
  /// set to false, the task skips the data that caused the error and
  /// continues if possible.
  pub fail_on_error: Bool? = None
  /// A URL identifying the location of the data to be imported. This can be
  /// an Amazon S3 path, or can point to a Neptune database endpoint or
  /// snapshot.
  pub source: Str? = None
  /// Specifies the format of Amazon S3 data to be imported. Valid values are
  /// CSV, which identifies the Gremlin CSV format or OPENCYPHER, which
  /// identifies the openCypher load format.
  pub format: Format? = None
  /// The parquet type of the import task.
  pub parquet_type: ParquetType? = None
  /// The method to handle blank nodes in the dataset. Currently, only
  /// convertToIri is supported, meaning blank nodes are converted to unique
  /// IRIs at load time. Must be provided when format is ntriples . For more
  /// information, see Handling RDF values .
  pub blank_node_handling: BlankNodeHandling? = None
  /// The unique identifier of the Neptune Analytics graph.
  pub graph_identifier: Str? = None
  /// The ARN of the IAM role that will allow access to the data that is to be
  /// imported.
  pub role_arn: Str? = None
}

pub struct StartImportTaskOutput {
  /// The unique identifier of the Neptune Analytics graph.
  pub graph_id: Str? = None
  /// The unique identifier of the import task.
  pub task_id: Str? = None
  /// A URL identifying the location of the data to be imported. This can be
