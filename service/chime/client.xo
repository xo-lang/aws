/// The HTTP request of AssociatePhoneNumberWithUser.
pub fn serialize_associate_phone_number_with_user(ep: rest.Endpoint, input: AssociatePhoneNumberWithUserRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = [("operation", "associate-phone-number")]
  let label_account_id = match input.account_id {
    Some(v) => v
    None => return Err("input member AccountId is required")
  }
  if label_account_id == "" {
    return Err("input member AccountId must not be empty")
  }
  let label_user_id = match input.user_id {
    Some(v) => v
    None => return Err("input member UserId is required")
  }
  if label_user_id == "" {
    return Err("input member UserId must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.e164_phone_number {
    fs.push(("E164PhoneNumber", json.Value.Str(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
