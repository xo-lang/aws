/// A notebook execution. An execution is a specific instance that an Amazon
/// EMR Notebook is run using the StartNotebookExecution action.
pub struct NotebookExecution {
  /// The unique identifier of a notebook execution.
  pub notebook_execution_id: Str? = None
  /// The unique identifier of the Amazon EMR Notebook that is used for the
  /// notebook execution.
  pub editor_id: Str? = None
  /// The execution engine, such as an Amazon EMR cluster, used to run the
  /// Amazon EMR notebook and perform the notebook execution.
  pub execution_engine: ExecutionEngineConfig? = None
  /// A name for the notebook execution.
  pub notebook_execution_name: Str? = None
  /// Input parameters in JSON format passed to the Amazon EMR Notebook at
  /// runtime for execution.
  pub notebook_params: Str? = None
  /// The status of the notebook execution. START_PENDING indicates that the
  /// cluster has received the execution request but execution has not begun.
  /// STARTING indicates that the execution is starting on the cluster.
  /// RUNNING indicates that the execution is being processed by the cluster.
  /// FINISHING indicates that execution processing is in the final stages.
  /// FINISHED indicates that the execution has completed without error.
  /// FAILING indicates that the execution is failing and will not finish
  /// successfully. FAILED indicates that the execution failed. STOP_PENDING
  /// indicates that the cluster has received a StopNotebookExecution request
  /// and the stop is pending. STOPPING indicates that the cluster is in the
  /// process of stopping the execution as a result of a StopNotebookExecution
  /// request. STOPPED indicates that the execution stopped because of a
  /// StopNotebookExecution request.
  pub status: NotebookExecutionStatus? = None
  /// The timestamp when notebook execution started.
  pub start_time: Time? = None
  /// The timestamp when notebook execution ended.
  pub end_time: Time? = None
  /// The Amazon Resource Name (ARN) of the notebook execution.
  pub arn: Str? = None
  /// The location of the notebook execution's output file in Amazon S3.
  pub output_notebook_uri: Str? = None
  /// The reason for the latest status change of the notebook execution.
  pub last_state_change_reason: Str? = None
  /// The unique identifier of the Amazon EC2 security group associated with
  /// the Amazon EMR Notebook instance. For more information see Specifying
  /// Amazon EC2 Security Groups for Amazon EMR Notebooks in the Amazon EMR
  /// Management Guide .
  pub notebook_instance_security_group_id: Str? = None
  /// A list of tags associated with a notebook execution. Tags are
  /// user-defined key-value pairs that consist of a required key string with
  /// a maximum of 128 characters and an optional value string with a maximum
  /// of 256 characters.
  pub tags: List[Tag]? = None
  /// The Amazon S3 location that stores the notebook execution input.
  pub notebook_s3_location: NotebookS3LocationForOutput? = None
  /// The Amazon S3 location for the notebook execution output.
  pub output_notebook_s3_location: OutputNotebookS3LocationForOutput? = None
  /// The output format for the notebook execution.
  pub output_notebook_format: OutputNotebookFormat? = None
  /// The environment variables associated with the notebook execution.
  pub environment_variables: Map[Str, Str]? = None
}

pub enum NotebookExecutionStatus: Str {
  StartPending = "START_PENDING"
