fn xml_write_endpoint_access(var w: xmlv.Writer, v: EndpointAccess, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.cluster_identifier {
    xmlv.elem(w, "ClusterIdentifier", x, [])
  }
  if let Some(x) = v.resource_owner {
    xmlv.elem(w, "ResourceOwner", x, [])
  }
  if let Some(x) = v.subnet_group_name {
    xmlv.elem(w, "SubnetGroupName", x, [])
  }
  if let Some(x) = v.endpoint_status {
    xmlv.elem(w, "EndpointStatus", x, [])
  }
  if let Some(x) = v.endpoint_name {
    xmlv.elem(w, "EndpointName", x, [])
  }
  if let Some(x) = v.endpoint_create_time {
    xmlv.elem(w, "EndpointCreateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.port {
    xmlv.elem(w, "Port", "${x}", [])
  }
  if let Some(x) = v.address {
    xmlv.elem(w, "Address", x, [])
  }
  if let Some(x) = v.vpc_security_groups {
    xml_write_vpc_security_group_membership_list(w, x, "VpcSecurityGroups", [])
