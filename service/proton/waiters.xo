    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).get_service(input) {
      Ok(out) => {
        let o = jmes_of_get_service_output(out)
        if state == "" && waiter.path_matches(o, "service.status", "stringEquals", "ACTIVE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "service.status", "stringEquals", "CREATE_FAILED_CLEANUP_COMPLETE") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "service.status", "stringEquals", "CREATE_FAILED_CLEANUP_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "service.status", "stringEquals", "CREATE_FAILED") {
