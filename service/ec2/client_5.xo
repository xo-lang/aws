      "createdBy" => out.created_by = c.text()
      "defaultVersionNumber" => out.default_version_number = xmlv.read_int(c.text())?
      "latestVersionNumber" => out.latest_version_number = xmlv.read_int(c.text())?
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "operator" => out.operator = xml_read_operator_response(c)?
      _ => {}
    }
  }
  Ok(out)
}

