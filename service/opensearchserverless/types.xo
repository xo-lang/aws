/// Details about an updated OpenSearch Serverless collection.
pub struct UpdateCollectionDetail {
  /// The unique identifier of the collection.
  pub id: Str? = None
  /// The name of the collection.
  pub name: Str? = None
  /// The current status of the collection.
  pub status: Str? = None
  /// The collection type.
