pub fn (e: ActivateKeySigningKeyErr) display() -> Str {
  match e {
    ConcurrentModification(x) => "ConcurrentModification: ${x:?}"
    InvalidInputError(x) => "InvalidInput: ${x:?}"
    InvalidKeySigningKeyStatus(x) => "InvalidKeySigningKeyStatus: ${x:?}"
    InvalidKMSArn(x) => "InvalidKMSArn: ${x:?}"
    InvalidSigningStatus(x) => "InvalidSigningStatus: ${x:?}"
    NoSuchKeySigningKey(x) => "NoSuchKeySigningKey: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

