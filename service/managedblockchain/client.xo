/// The HTTP request of CreateAccessor.
pub fn serialize_create_accessor(ep: rest.Endpoint, input: CreateAccessorInput, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.client_request_token {
    fs.push(("ClientRequestToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("ClientRequestToken", json.Value.Str(idempotency_token)))
  }
  if let Some(x) = input.accessor_type {
    fs.push(("AccessorType", json.Value.Str(x.value())))
  }
  if let Some(x) = input.tags {
    fs.push(("Tags", json_of_input_tag_map(x)))
  }
  if let Some(x) = input.network_type {
    fs.push(("NetworkType", json.Value.Str(x.value())))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/accessors"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
