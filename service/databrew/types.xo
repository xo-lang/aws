}

pub enum SampleMode: Str {
  FullDataset = "FULL_DATASET"
  CustomRows = "CUSTOM_ROWS"
  Unknown(value: Str)
}

pub enum SampleType: Str {
  FirstN = "FIRST_N"
  LastN = "LAST_N"
  Random = "RANDOM"
  Unknown(value: Str)
}

/// Represents one or more dates and times when a job is to run.
pub struct Schedule {
