  let (ep, signing, extra) = c.route(endpoint_params_create_investigation_group(c.params, input)) ?? e => return Err(CreateInvestigationGroupErr.InvalidInput(e))
  var req = serialize_create_investigation_group(ep, input, "") ?? e => return Err(CreateInvestigationGroupErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(CreateInvestigationGroupErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_create_investigation_group_error(resp))
  }
  deserialize_create_investigation_group(resp) ?? e => Err(CreateInvestigationGroupErr.Deserialize(e))
}

