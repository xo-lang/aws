  let (ep, signing, extra) = c.route(endpoint_params_list_keys(c.params, input)) ?? e => return Err(ListKeysErr.InvalidInput(e))
  var req = serialize_list_keys(ep, input, "") ?? e => return Err(ListKeysErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(ListKeysErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_list_keys_error(resp))
  }
  deserialize_list_keys(resp) ?? e => Err(ListKeysErr.Deserialize(e))
}

pub fn endpoint_params_put_key(base: EndpointParameters, input: PutKeyRequest) -> EndpointParameters {
  var p = base
  if let Some(x) = input.kvs_arn {
    p.kvs_arn = x
  }
  p
}

/// The HTTP request of PutKey.
pub fn serialize_put_key(ep: rest.Endpoint, input: PutKeyRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  let label_key = match input.key {
    Some(v) => v
    None => return Err("input member Key is required")
  }
  if label_key == "" {
    return Err("input member Key must not be empty")
  }
  let label_kvs_arn = match input.kvs_arn {
    Some(v) => v
    None => return Err("input member KvsARN is required")
  }
  if label_kvs_arn == "" {
    return Err("input member KvsARN must not be empty")
  }
  if let Some(v) = input.if_match {
    headers.push(("If-Match", v))
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.value {
    fs.push(("Value", json.Value.Str(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "PUT",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/key-value-stores/${rest.escape(label_kvs_arn, false)}/keys/${rest.escape(label_key, false)}"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_put_key(resp: http.Response) -> PutKeyResponse ! Str {
  var out = PutKeyResponse{}
  let body = jsonv.parse_body(resp.body)?
  if let Some(hv) = rest.first_header(resp, "ETag") {
    out.e_tag = hv
  }
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "ItemCount" => out.item_count = jsonv.read_int(fv)?
      "TotalSizeInBytes" => out.total_size_in_bytes = jsonv.read_int(fv)?
      _ => {}
    }
  }
  Ok(out)
}

