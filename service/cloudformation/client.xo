fn xml_write_resource_change(var w: xmlv.Writer, v: ResourceChange, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.policy_action {
    xmlv.elem(w, "PolicyAction", x.value(), [])
  }
  if let Some(x) = v.action {
    xmlv.elem(w, "Action", x.value(), [])
  }
  if let Some(x) = v.logical_resource_id {
    xmlv.elem(w, "LogicalResourceId", x, [])
  }
  if let Some(x) = v.physical_resource_id {
    xmlv.elem(w, "PhysicalResourceId", x, [])
  }
  if let Some(x) = v.resource_type {
    xmlv.elem(w, "ResourceType", x, [])
  }
  if let Some(x) = v.replacement {
    xmlv.elem(w, "Replacement", x.value(), [])
  }
  if let Some(x) = v.scope {
    xml_write_scope(w, x, "Scope", [])
  }
  if let Some(x) = v.resource_drift_status {
    xmlv.elem(w, "ResourceDriftStatus", x.value(), [])
  }
  if let Some(x) = v.resource_drift_ignored_attributes {
    xml_write_resource_drift_ignored_attributes(w, x, "ResourceDriftIgnoredAttributes", [])
  }
  if let Some(x) = v.details {
    xml_write_resource_change_details(w, x, "Details", [])
  }
  if let Some(x) = v.change_set_id {
    xmlv.elem(w, "ChangeSetId", x, [])
  }
  if let Some(x) = v.module_info {
    xml_write_module_info(w, x, "ModuleInfo", [])
  }
  if let Some(x) = v.before_context {
    xmlv.elem(w, "BeforeContext", x, [])
  }
  if let Some(x) = v.after_context {
    xmlv.elem(w, "AfterContext", x, [])
  }
  if let Some(x) = v.previous_deployment_context {
    xmlv.elem(w, "PreviousDeploymentContext", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_resource_change(e: xml.Element) -> ResourceChange ! Str {
  var out = ResourceChange{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "PolicyAction" => out.policy_action = PolicyAction.from(c.text())
      "Action" => out.action = ChangeAction.from(c.text())
      "LogicalResourceId" => out.logical_resource_id = c.text()
      "PhysicalResourceId" => out.physical_resource_id = c.text()
      "ResourceType" => out.resource_type = c.text()
      "Replacement" => out.replacement = Replacement.from(c.text())
      "Scope" => out.scope = xml_read_scope(c)?
      "ResourceDriftStatus" => out.resource_drift_status = StackResourceDriftStatus.from(c.text())
      "ResourceDriftIgnoredAttributes" => out.resource_drift_ignored_attributes = xml_read_resource_drift_ignored_attributes(c)?
      "Details" => out.details = xml_read_resource_change_details(c)?
      "ChangeSetId" => out.change_set_id = c.text()
      "ModuleInfo" => out.module_info = xml_read_module_info(c)?
      "BeforeContext" => out.before_context = c.text()
      "AfterContext" => out.after_context = c.text()
      "PreviousDeploymentContext" => out.previous_deployment_context = c.text()
      _ => {}
    }
  }
  Ok(out)
}

