  var out = GetAlarmMuteRuleInput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "AlarmMuteRuleName" => out.alarm_mute_rule_name = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_get_alarm_mute_rule_output(var w: xmlv.Writer, v: GetAlarmMuteRuleOutput, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.alarm_mute_rule_arn {
    xmlv.elem(w, "AlarmMuteRuleArn", x, [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "Description", x, [])
  }
  if let Some(x) = v.rule {
    xml_write_rule(w, x, "Rule", [])
  }
  if let Some(x) = v.mute_targets {
    xml_write_mute_targets(w, x, "MuteTargets", [])
  }
  if let Some(x) = v.start_date {
    xmlv.elem(w, "StartDate", rest.date_time(x), [])
  }
  if let Some(x) = v.expire_date {
    xmlv.elem(w, "ExpireDate", rest.date_time(x), [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.last_updated_timestamp {
    xmlv.elem(w, "LastUpdatedTimestamp", rest.date_time(x), [])
  }
  if let Some(x) = v.mute_type {
    xmlv.elem(w, "MuteType", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_get_alarm_mute_rule_output(e: xml.Element) -> GetAlarmMuteRuleOutput ! Str {
  var out = GetAlarmMuteRuleOutput{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Name" => out.name = c.text()
      "AlarmMuteRuleArn" => out.alarm_mute_rule_arn = c.text()
      "Description" => out.description = c.text()
      "Rule" => out.rule = xml_read_rule(c)?
      "MuteTargets" => out.mute_targets = xml_read_mute_targets(c)?
      "StartDate" => out.start_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ExpireDate" => out.expire_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "Status" => out.status = AlarmMuteRuleStatus.from(c.text())
      "LastUpdatedTimestamp" => out.last_updated_timestamp = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "MuteType" => out.mute_type = c.text()
      _ => {}
    }
  }
  Ok(out)
}

