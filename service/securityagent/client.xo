fn json_of_ca_certificate_source(v: CaCertificateSource) -> json.Value {
  match v {
    InlinePem(x) => json.Value.Object([("inlinePem", json.Value.Str(x))])
    ArtifactId(x) => json.Value.Object([("artifactId", json.Value.Str(x))])
    S3Location(x) => json.Value.Object([("s3Location", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_ca_certificate_source(v: json.Value) -> CaCertificateSource ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "inlinePem" => Ok(CaCertificateSource.InlinePem(jsonv.read_str(fv)?))
      "artifactId" => Ok(CaCertificateSource.ArtifactId(jsonv.read_str(fv)?))
      "s3Location" => Ok(CaCertificateSource.S3Location(jsonv.read_str(fv)?))
      _ => Ok(CaCertificateSource.Unknown(k))
    }
  }
  Err("CaCertificateSource: no member set")
}

