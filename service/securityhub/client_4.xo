fn json_of_vulnerability(v: Vulnerability) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.vulnerable_packages {
    fs.push(("VulnerablePackages", json_of_software_package_list(x)))
  }
  if let Some(x) = v.cvss {
    fs.push(("Cvss", json_of_cvss_list(x)))
  }
  if let Some(x) = v.related_vulnerabilities {
    fs.push(("RelatedVulnerabilities", json_of_string_list(x)))
  }
  if let Some(x) = v.vendor {
    fs.push(("Vendor", json_of_vulnerability_vendor(x)))
  }
  if let Some(x) = v.reference_urls {
    fs.push(("ReferenceUrls", json_of_string_list(x)))
  }
  if let Some(x) = v.fix_available {
    fs.push(("FixAvailable", json.Value.Str(x.value())))
  }
  if let Some(x) = v.epss_score {
    fs.push(("EpssScore", jsonv.float(x)))
  }
  if let Some(x) = v.exploit_available {
    fs.push(("ExploitAvailable", json.Value.Str(x.value())))
  }
  if let Some(x) = v.last_known_exploit_at {
    fs.push(("LastKnownExploitAt", json.Value.Str(x)))
  }
  if let Some(x) = v.code_vulnerabilities {
    fs.push(("CodeVulnerabilities", json_of_vulnerability_code_vulnerabilities_list(x)))
  }
  json.Value.Object(fs)
}

