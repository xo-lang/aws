fn from_json_h264_settings(v: json.Value) -> H264Settings ! Str {
  var out = H264Settings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "adaptiveQuantization" => out.adaptive_quantization = H264AdaptiveQuantization.from(jsonv.read_str(fv)?)
      "afdSignaling" => out.afd_signaling = AfdSignaling.from(jsonv.read_str(fv)?)
      "bitrate" => out.bitrate = jsonv.read_int(fv)?
      "bufFillPct" => out.buf_fill_pct = jsonv.read_int(fv)?
      "bufSize" => out.buf_size = jsonv.read_int(fv)?
      "colorMetadata" => out.color_metadata = H264ColorMetadata.from(jsonv.read_str(fv)?)
      "colorSpaceSettings" => out.color_space_settings = from_json_h264_color_space_settings(fv)?
      "entropyEncoding" => out.entropy_encoding = H264EntropyEncoding.from(jsonv.read_str(fv)?)
      "filterSettings" => out.filter_settings = from_json_h264_filter_settings(fv)?
      "fixedAfd" => out.fixed_afd = FixedAfd.from(jsonv.read_str(fv)?)
      "flickerAq" => out.flicker_aq = H264FlickerAq.from(jsonv.read_str(fv)?)
      "forceFieldPictures" => out.force_field_pictures = H264ForceFieldPictures.from(jsonv.read_str(fv)?)
      "framerateControl" => out.framerate_control = H264FramerateControl.from(jsonv.read_str(fv)?)
      "framerateDenominator" => out.framerate_denominator = jsonv.read_int(fv)?
      "framerateNumerator" => out.framerate_numerator = jsonv.read_int(fv)?
      "gopBReference" => out.gop_b_reference = H264GopBReference.from(jsonv.read_str(fv)?)
      "gopClosedCadence" => out.gop_closed_cadence = jsonv.read_int(fv)?
      "gopNumBFrames" => out.gop_num_b_frames = jsonv.read_int(fv)?
      "gopSize" => out.gop_size = jsonv.read_float(fv)?
      "gopSizeUnits" => out.gop_size_units = H264GopSizeUnits.from(jsonv.read_str(fv)?)
      "level" => out.level = H264Level.from(jsonv.read_str(fv)?)
      "lookAheadRateControl" => out.look_ahead_rate_control = H264LookAheadRateControl.from(jsonv.read_str(fv)?)
      "maxBitrate" => out.max_bitrate = jsonv.read_int(fv)?
      "minIInterval" => out.min_i_interval = jsonv.read_int(fv)?
      "numRefFrames" => out.num_ref_frames = jsonv.read_int(fv)?
      "parControl" => out.par_control = H264ParControl.from(jsonv.read_str(fv)?)
      "parDenominator" => out.par_denominator = jsonv.read_int(fv)?
      "parNumerator" => out.par_numerator = jsonv.read_int(fv)?
      "profile" => out.profile = H264Profile.from(jsonv.read_str(fv)?)
      "qualityLevel" => out.quality_level = H264QualityLevel.from(jsonv.read_str(fv)?)
      "qvbrQualityLevel" => out.qvbr_quality_level = jsonv.read_int(fv)?
      "rateControlMode" => out.rate_control_mode = H264RateControlMode.from(jsonv.read_str(fv)?)
      "scanType" => out.scan_type = H264ScanType.from(jsonv.read_str(fv)?)
      "sceneChangeDetect" => out.scene_change_detect = H264SceneChangeDetect.from(jsonv.read_str(fv)?)
      "slices" => out.slices = jsonv.read_int(fv)?
      "softness" => out.softness = jsonv.read_int(fv)?
      "spatialAq" => out.spatial_aq = H264SpatialAq.from(jsonv.read_str(fv)?)
      "subgopLength" => out.subgop_length = H264SubGopLength.from(jsonv.read_str(fv)?)
      "syntax" => out.syntax = H264Syntax.from(jsonv.read_str(fv)?)
      "temporalAq" => out.temporal_aq = H264TemporalAq.from(jsonv.read_str(fv)?)
      "timecodeInsertion" => out.timecode_insertion = H264TimecodeInsertionBehavior.from(jsonv.read_str(fv)?)
      "timecodeBurninSettings" => out.timecode_burnin_settings = from_json_timecode_burnin_settings(fv)?
      "minQp" => out.min_qp = jsonv.read_int(fv)?
      "minBitrate" => out.min_bitrate = jsonv.read_int(fv)?
      "allowExplicitWeightedPrediction" => out.allow_explicit_weighted_prediction = H264AllowExplicitWeightedPrediction.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

