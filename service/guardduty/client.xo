fn json_of_condition(v: Condition) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.eq {
    fs.push(("eq", json_of_eq(x)))
  }
  if let Some(x) = v.neq {
    fs.push(("neq", json_of_neq(x)))
  }
  if let Some(x) = v.gt {
    fs.push(("gt", json.Value.Int(x)))
  }
  if let Some(x) = v.gte {
    fs.push(("gte", json.Value.Int(x)))
  }
  if let Some(x) = v.lt {
    fs.push(("lt", json.Value.Int(x)))
  }
  if let Some(x) = v.lte {
    fs.push(("lte", json.Value.Int(x)))
  }
  if let Some(x) = v.equals {
    fs.push(("equals", json_of_equals(x)))
  }
  if let Some(x) = v.not_equals {
    fs.push(("notEquals", json_of_not_equals(x)))
  }
  if let Some(x) = v.greater_than {
    fs.push(("greaterThan", json.Value.Int(x)))
  }
  if let Some(x) = v.greater_than_or_equal {
    fs.push(("greaterThanOrEqual", json.Value.Int(x)))
  }
  if let Some(x) = v.less_than {
    fs.push(("lessThan", json.Value.Int(x)))
  }
  if let Some(x) = v.less_than_or_equal {
    fs.push(("lessThanOrEqual", json.Value.Int(x)))
  }
  if let Some(x) = v.matches {
    fs.push(("matches", json_of_matches(x)))
  }
  if let Some(x) = v.not_matches {
    fs.push(("notMatches", json_of_not_matches(x)))
  }
  json.Value.Object(fs)
}

fn from_json_condition(v: json.Value) -> Condition ! Str {
  var out = Condition{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "eq" => out.eq = from_json_eq(fv)?
      "neq" => out.neq = from_json_neq(fv)?
      "gt" => out.gt = jsonv.read_int(fv)?
      "gte" => out.gte = jsonv.read_int(fv)?
      "lt" => out.lt = jsonv.read_int(fv)?
      "lte" => out.lte = jsonv.read_int(fv)?
      "equals" => out.equals = from_json_equals(fv)?
      "notEquals" => out.not_equals = from_json_not_equals(fv)?
      "greaterThan" => out.greater_than = jsonv.read_int(fv)?
      "greaterThanOrEqual" => out.greater_than_or_equal = jsonv.read_int(fv)?
      "lessThan" => out.less_than = jsonv.read_int(fv)?
      "lessThanOrEqual" => out.less_than_or_equal = jsonv.read_int(fv)?
      "matches" => out.matches = from_json_matches(fv)?
      "notMatches" => out.not_matches = from_json_not_matches(fv)?
      _ => {}
    }
  }
  Ok(out)
}

