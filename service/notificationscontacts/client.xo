  ThrottlingException(e: ThrottlingException)
  ValidationException(e: ValidationException)
  /// A service error the model does not list for this operation.
  Api(e: aws.ApiError)
  /// The request was not sent or no response came (after retries).
  Send(e: transport.SendErr)
  /// The input cannot be serialized (a required label is missing).
  InvalidInput(msg: Str)
  /// The response is not what the protocol says.
  Deserialize(msg: Str)
}

pub fn (e: UntagResourceErr) display() -> Str {
  match e {
    AccessDeniedException(x) => "AccessDeniedException: ${x:?}"
    InternalServerException(x) => "InternalServerException: ${x:?}"
    ResourceNotFoundException(x) => "ResourceNotFoundException: ${x:?}"
    ThrottlingException(x) => "ThrottlingException: ${x:?}"
    ValidationException(x) => "ValidationException: ${x:?}"
    Api(x) => x.display()
    Send(x) => x.display()
    InvalidInput(msg) => "invalid input: ${msg}"
    Deserialize(msg) => "cannot read the response: ${msg}"
  }
}

pub fn deserialize_untag_resource_error(resp: http.Response) -> UntagResourceErr {
  let body = jsonv.parse_body(resp.body).ok() ?? json.Value.Object([])
  match restjson.error_code(resp, body) {
    "AccessDeniedException" => match read_error_access_denied_exception(resp, body) {
      Ok(x) => return UntagResourceErr.AccessDeniedException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    "InternalServerException" => match read_error_internal_server_exception(resp, body) {
      Ok(x) => return UntagResourceErr.InternalServerException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    "ResourceNotFoundException" => match read_error_resource_not_found_exception(resp, body) {
      Ok(x) => return UntagResourceErr.ResourceNotFoundException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    "ThrottlingException" => match read_error_throttling_exception(resp, body) {
      Ok(x) => return UntagResourceErr.ThrottlingException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    "ValidationException" => match read_error_validation_exception(resp, body) {
      Ok(x) => return UntagResourceErr.ValidationException(x)
      Err(msg) => return UntagResourceErr.Deserialize(msg)
    }
    _ => {}
  }
  UntagResourceErr.Api(restjson.api_error(resp, body))
}

/// Detaches a key-value pair from a resource, as identified by its Amazon
/// Resource Name (ARN). Taggable resources in AWS User Notifications
/// Contacts include email contacts..
pub fn (c: Client) untag_resource(input: UntagResourceRequest) -> UntagResourceResponse ! UntagResourceErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_untag_resource(c.params, input)) ?? e => return Err(UntagResourceErr.InvalidInput(e))
  var req = serialize_untag_resource(ep, input, "") ?? e => return Err(UntagResourceErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UntagResourceErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_untag_resource_error(resp))
  }
  deserialize_untag_resource(resp) ?? e => Err(UntagResourceErr.Deserialize(e))
}
