fn from_json_h265_settings(v: json.Value) -> H265Settings ! Str {
  var out = H265Settings{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "adaptiveQuantization" => out.adaptive_quantization = H265AdaptiveQuantization.from(jsonv.read_str(fv)?)
      "alternateTransferFunctionSei" => out.alternate_transfer_function_sei = H265AlternateTransferFunctionSei.from(jsonv.read_str(fv)?)
      "bandwidthReductionFilter" => out.bandwidth_reduction_filter = from_json_bandwidth_reduction_filter(fv)?
      "bitrate" => out.bitrate = jsonv.read_int(fv)?
      "codecLevel" => out.codec_level = H265CodecLevel.from(jsonv.read_str(fv)?)
      "codecProfile" => out.codec_profile = H265CodecProfile.from(jsonv.read_str(fv)?)
      "deblocking" => out.deblocking = H265Deblocking.from(jsonv.read_str(fv)?)
      "dynamicSubGop" => out.dynamic_sub_gop = H265DynamicSubGop.from(jsonv.read_str(fv)?)
