fn json_of_resource_snapshot_summary(v: ResourceSnapshotSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.revision {
