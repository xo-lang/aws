// Emits a service's types: structures, unions, enums (decision 0004).

use std/json
use github.com/xo-lang/aws/codegen/model

/// The generator's view of one service.
pub struct G {
  pub m: model.Model
  pub names: Names
  /// Shapes the service reaches, sorted.
  pub ids: List[Str]
}

pub fn new_g(m: model.Model) -> G {
  let ids = model.closure(m)
  G{m: m, names: plan_names(m, ids), ids: ids}
}

pub fn shape_of(g: G, id: Str) -> model.Shape {
  model.shape(g.m, id) ?? model.Shape{id: id, kind: model.Kind.String}
}

pub fn has(traits: List[(Str, json.Value)], name: Str) -> Bool {
  model.has_trait(traits, name)
}

/// The Xo type of a value of shape `id`.
pub fn xo_type(g: G, id: Str) -> Str {
  let s = shape_of(g, id)
  match s.kind {
    Blob => "Bytes"
    Boolean => "Bool"
    String => "Str"
    Enum | IntEnum | Structure | Union => type_name(g.names, id)
    Timestamp => "Time"
    Byte | Short | Integer | Long => "Int"
    Float | Double => "Float"
    BigInteger | BigDecimal => "Str"
    Document => "json.Value"
    List => {
      let e = xo_type(g, s.members[0].target)
      if has(s.traits, "sparse") { "List[${e}?]" } else { "List[${e}]" }
    }
    Map => {
      let v = xo_type(g, s.members[1].target)
      if has(s.traits, "sparse") { "Map[Str, ${v}?]" } else { "Map[Str, ${v}]" }
    }
    _ => "()"
  }
}

/// A Xo string literal for `s`.
pub fn lit_str(s: Str) -> Str {
  var b = StrBuilder.new()
  b.write("\"")
  for r in s.runes() {
    match r {
      '"' => b.write("\\\"")
      '\\' => b.write("\\\\")
      '$' => b.write("\\$")
      '\n' => b.write("\\n")
      '\r' => b.write("\\r")
      '\t' => b.write("\\t")
      _ => {
        let c = Int(r)
        if c < 32 || c == 127 {
          b.write("\\u{${c.to_str_base(16)}}")
        } else {
          b.write("${r}")
        }
      }
    }
  }
  b.write("\"")
  b.freeze()
}

fn doc_lines(var out: List[Str], traits: List[(Str, json.Value)], indent: Str) {
  if let Some(d) = model.trait_str(traits, "documentation") {
    let text = strip_html(d).trim()
    if text != "" {
      for line in wrap(text, 72) {
        out.push("${indent}/// ${line}")
      }
    }
  }
}

/// AWS documentation is HTML; generated docs keep its text.
fn strip_html(s: Str) -> Str {
  var b = StrBuilder.new()
  var tag = false
  for r in s.runes() {
    if r == '<' {
      tag = true
    } else if r == '>' {
      tag = false
      b.write(" ")
    } else if !tag {
      b.write("${r}")
    }
  }
  b.freeze().fields().join(" ")
}

fn wrap(text: Str, width: Int) -> List[Str] {
  var lines: List[Str] = []
  var cur = ""
  for w in text.fields() {
    if cur == "" {
      cur = w
    } else if cur.len() + 1 + w.len() > width {
      lines.push(cur)
      cur = w
    } else {
      cur = "${cur} ${w}"
    }
  }
  if cur != "" {
    lines.push(cur)
  }
  lines
}

/// Variant names of an enum's members, unique, with the catch-all's.
pub fn enum_variants(s: model.Shape) -> (List[Str], Str) {
  var names: List[Str] = []
  for m in s.members {
    var v = variant_name(m.name)
    var k = 2
    while names.contains(v) {
      v = "${variant_name(m.name)}${k}"
      k += 1
    }
    names.push(v)
  }
  let catch_all = if names.contains("Unknown") { "UnknownValue" } else { "Unknown" }
  (names, catch_all)
}

/// Union variant names, unique, with the catch-all's.
pub fn union_variants(s: model.Shape) -> (List[Str], Str) {
  enum_variants(s)
}

pub fn emit_types(g: G) -> Str {
  var out: List[Str] = []
  for id in g.ids {
    let s = shape_of(g, id)
    if id.starts_with(model.PRELUDE) || !named_kind(s.kind) {
      continue
    }
    let name = type_name(g.names, id)
    doc_lines(out, s.traits, "")
    match s.kind {
      Structure => {
        out.push("pub struct ${name} {")
        for m in s.members {
          doc_lines(out, m.traits, "  ")
          out.push("  pub ${field_name(m.name)}: ${xo_type(g, m.target)}? = None")
        }
        out.push("}")
      }
      Union => {
        let (vs, catch_all) = union_variants(s)
        out.push("pub enum ${name} {")
        for (i, m) in s.members.indexed() {
          if m.target == "smithy.api#Unit" {
            out.push("  ${vs[i]}")
          } else {
            out.push("  ${vs[i]}(value: ${xo_type(g, m.target)})")
          }
        }
        out.push("  /// A member this client does not know (a newer service's).")
        out.push("  ${catch_all}(tag: Str)")
        out.push("}")
      }
      Enum | IntEnum => {
        let int_enum = s.kind is model.Kind.IntEnum
        let (vs, catch_all) = enum_variants(s)
        out.push("pub enum ${name}: ${if int_enum { "Int" } else { "Str" }} {")
        for (i, m) in s.members.indexed() {
          let v = match model.trait_of(m.traits, "enumValue") {
            Some(json.Value.Str(t)) => lit_str(t)
            Some(json.Value.Int(n)) => "${n}"
            _ => lit_str(m.name)
          }
          out.push("  ${vs[i]} = ${v}")
        }
        out.push("  ${catch_all}(value: ${if int_enum { "Int" } else { "Str" }})")
        out.push("}")
      }
      _ => {}
    }
    out.push("")
  }
  out.join("\n")
}
