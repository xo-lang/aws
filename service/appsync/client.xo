      "logConfig" => out.log_config = from_json_log_config(fv)?
      "userPoolConfig" => out.user_pool_config = from_json_user_pool_config(fv)?
      "openIDConnectConfig" => out.open_id_connect_config = from_json_open_id_connect_config(fv)?
      "arn" => out.arn = jsonv.read_str(fv)?
      "uris" => out.uris = from_json_map_of_string_to_string(fv)?
      "tags" => out.tags = from_json_tag_map(fv)?
      "additionalAuthenticationProviders" => out.additional_authentication_providers = from_json_additional_authentication_providers(fv)?
      "xrayEnabled" => out.xray_enabled = jsonv.read_bool(fv)?
      "wafWebAclArn" => out.waf_web_acl_arn = jsonv.read_str(fv)?
      "lambdaAuthorizerConfig" => out.lambda_authorizer_config = from_json_lambda_authorizer_config(fv)?
      "dns" => out.dns = from_json_map_of_string_to_string(fv)?
      "visibility" => out.visibility = GraphQLApiVisibility.from(jsonv.read_str(fv)?)
      "apiType" => out.api_type = GraphQLApiType.from(jsonv.read_str(fv)?)
      "mergedApiExecutionRoleArn" => out.merged_api_execution_role_arn = jsonv.read_str(fv)?
      "owner" => out.owner = jsonv.read_str(fv)?
      "ownerContact" => out.owner_contact = jsonv.read_str(fv)?
      "introspectionConfig" => out.introspection_config = GraphQLApiIntrospectionConfig.from(jsonv.read_str(fv)?)
      "queryDepthLimit" => out.query_depth_limit = jsonv.read_int(fv)?
      "resolverCountLimit" => out.resolver_count_limit = jsonv.read_int(fv)?
      "enhancedMetricsConfig" => out.enhanced_metrics_config = from_json_enhanced_metrics_config(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_graphql_apis(v: List[GraphqlApi]) -> json.Value {
  json.Value.List(v.map(fn(x: GraphqlApi) -> json.Value { json_of_graphql_api(x) }))
}

fn from_json_graphql_apis(v: json.Value) -> List[GraphqlApi] ! Str {
  var out: List[GraphqlApi] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_graphql_api(fv)?)
  }
  Ok(out)
}

