fn from_json_event(v: json.Value) -> Event ! Str {
  var out = Event{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "EventType" => out.event_type = EventType.from(jsonv.read_str(fv)?)
      "SubType" => out.sub_type = jsonv.read_str(fv)?
      "EventId" => out.event_id = jsonv.read_int(fv)?
      "Id" => out.id = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "EventTimestamp" => out.event_timestamp = jsonv.read_time(fv, "epoch-seconds")?
      "ParentId" => out.parent_id = jsonv.read_str(fv)?
      "ExecutionStartedDetails" => out.execution_started_details = from_json_execution_started_details(fv)?
      "ExecutionSucceededDetails" => out.execution_succeeded_details = from_json_execution_succeeded_details(fv)?
      "ExecutionFailedDetails" => out.execution_failed_details = from_json_execution_failed_details(fv)?
      "ExecutionTimedOutDetails" => out.execution_timed_out_details = from_json_execution_timed_out_details(fv)?
      "ExecutionStoppedDetails" => out.execution_stopped_details = from_json_execution_stopped_details(fv)?
      "ContextStartedDetails" => out.context_started_details = from_json_context_started_details(fv)?
      "ContextSucceededDetails" => out.context_succeeded_details = from_json_context_succeeded_details(fv)?
      "ContextFailedDetails" => out.context_failed_details = from_json_context_failed_details(fv)?
      "WaitStartedDetails" => out.wait_started_details = from_json_wait_started_details(fv)?
      "WaitSucceededDetails" => out.wait_succeeded_details = from_json_wait_succeeded_details(fv)?
      "WaitCancelledDetails" => out.wait_cancelled_details = from_json_wait_cancelled_details(fv)?
      "StepStartedDetails" => out.step_started_details = from_json_step_started_details(fv)?
      "StepSucceededDetails" => out.step_succeeded_details = from_json_step_succeeded_details(fv)?
