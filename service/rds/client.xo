fn xml_read_db_cluster_associated_role(e: xml.Element) -> DBClusterAssociatedRole ! Str {
  var out = DBClusterAssociatedRole{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "RoleArn" => out.role_arn = c.text()
      "FeatureName" => out.feature_name = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_db_cluster_associated_roles(var w: xmlv.Writer, v: List[DBClusterAssociatedRole], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_db_cluster_associated_role(w, item, "DBClusterAssociatedRole", [])
  }
  xmlv.end(w, name)
}

fn xml_read_db_cluster_associated_roles(e: xml.Element) -> List[DBClusterAssociatedRole] ! Str {
  var out: List[DBClusterAssociatedRole] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_db_cluster_associated_role(c)?)
  }
  Ok(out)
}

