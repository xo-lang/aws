  match v {
    StringList(x) => json.Value.Object([("StringList", json_of_predefined_attribute_string_values_list(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_predefined_attribute_values(v: json.Value) -> PredefinedAttributeValues ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "StringList" => Ok(PredefinedAttributeValues.StringList(from_json_predefined_attribute_string_values_list(fv)?))
      _ => Ok(PredefinedAttributeValues.Unknown(k))
    }
  }
  Err("PredefinedAttributeValues: no member set")
}

