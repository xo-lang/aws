  }
  if let Some(x) = v.has_fault {
    fs.push(("HasFault", json.Value.Bool(x)))
  }
  if let Some(x) = v.has_error {
    fs.push(("HasError", json.Value.Bool(x)))
  }
  if let Some(x) = v.has_throttle {
    fs.push(("HasThrottle", json.Value.Bool(x)))
  }
