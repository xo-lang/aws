/// Settings that control the range in the number of instances that the
/// endpoint provisions as it scales up or down to accommodate traffic.
pub struct ProductionVariantManagedInstanceScaling {
  /// Indicates whether managed instance scaling is enabled.
  pub status: ManagedInstanceScalingStatus? = None
  /// The minimum number of instances that the endpoint must retain when it
  /// scales down to accommodate a decrease in traffic.
  pub min_instance_count: Int? = None
  /// The maximum number of instances that the endpoint can provision when it
  /// scales up to accommodate an increase in traffic.
  pub max_instance_count: Int? = None
  /// Configures the scale-in behavior for managed instance scaling.
  pub scale_in_policy: ProductionVariantManagedInstanceScalingScaleInPolicy? = None
}

/// Configures the scale-in behavior for managed instance scaling.
pub struct ProductionVariantManagedInstanceScalingScaleInPolicy {
  /// The strategy for scaling in instances. IDLE_RELEASE Releases instances
  /// that have no hosted inference component copies. CONSOLIDATION
  /// Consolidates inference component copies onto fewer instances to release
  /// more instances. Consolidation honors the scheduling configuration of
  /// each inference component. For example, if an inference component
  /// specifies Availability Zone balance, consolidation only proceeds when
  /// the resulting distribution does not increase the imbalance.
  pub strategy: ManagedInstanceScalingScaleInStrategy? = None
  /// The maximum number of instances that the endpoint can terminate at a
  /// time during a consolidation scale-in operation. Default value: 1 .
  pub maximum_step_size: Int? = None
  /// The cooldown period, in minutes, after the last endpoint operation
  /// before the endpoint evaluates consolidation scale-in opportunities.
  /// Default value: 20 .
  pub cooldown_in_minutes: Int? = None
}

/// Settings that control how the endpoint routes incoming traffic to the
/// instances that the endpoint hosts.
pub struct ProductionVariantRoutingConfig {
  /// Sets how the endpoint routes incoming traffic:
  /// LEAST_OUTSTANDING_REQUESTS : The endpoint routes requests to the
  /// specific instances that have more capacity to process them. RANDOM : The
  /// endpoint routes each request to a randomly chosen instance. PREFIX_AWARE
  /// : The endpoint routes requests that share the same prompt prefix to the
  /// same instance and, when that instance hosts more than one copy of the
  /// invoked inference component, to the same copy. When the number of
  /// in-flight requests on the selected instance or copy reaches the
  /// ConcurrencyThreshold value, the endpoint routes the request to another
  /// copy on that instance or to another instance. The endpoint applies
  /// prefix-aware routing only when two or more instances can serve the
  /// request.
  pub routing_strategy: RoutingStrategy? = None
  /// The configuration for prefix-aware routing. Specify this parameter only
  /// when you set RoutingStrategy to PREFIX_AWARE .
  pub prefix_aware_routing_config: PrefixAwareRoutingConfig? = None
}

/// Specifies the serverless configuration for an endpoint variant.
pub struct ProductionVariantServerlessConfig {
  /// The memory size of your serverless endpoint. Valid values are in 1 GB
  /// increments: 1024 MB, 2048 MB, 3072 MB, 4096 MB, 5120 MB, or 6144 MB.
  pub memory_size_in_mb: Int? = None
  /// The maximum number of concurrent invocations your serverless endpoint
  /// can process.
  pub max_concurrency: Int? = None
  /// The amount of provisioned concurrency to allocate for the serverless
  /// endpoint. Should be less than or equal to MaxConcurrency . This field is
  /// not supported for serverless endpoint recommendations for Inference
  /// Recommender jobs. For more information about creating an Inference
  /// Recommender job, see CreateInferenceRecommendationsJobs .
  pub provisioned_concurrency: Int? = None
}

/// Specifies the serverless update concurrency configuration for an
/// endpoint variant.
pub struct ProductionVariantServerlessUpdateConfig {
  /// The updated maximum number of concurrent invocations your serverless
  /// endpoint can process.
  pub max_concurrency: Int? = None
  /// The updated amount of provisioned concurrency to allocate for the
  /// serverless endpoint. Should be less than or equal to MaxConcurrency .
  pub provisioned_concurrency: Int? = None
}

/// Describes the status of the production variant.
pub struct ProductionVariantStatus {
  /// The endpoint variant status which describes the current deployment stage
  /// status or operational status. Creating : Creating inference resources
  /// for the production variant. Deleting : Terminating inference resources
  /// for the production variant. Updating : Updating capacity for the
  /// production variant. ActivatingTraffic : Turning on traffic for the
  /// production variant. Baking : Waiting period to monitor the CloudWatch
  /// alarms in the automatic rollback configuration.
  pub status: VariantStatus? = None
  /// A message that describes the status of the production variant.
  pub status_message: Str? = None
  /// The start time of the current status change.
  pub start_time: Time? = None
}

/// Describes weight and capacities for a production variant associated with
/// an endpoint. If you sent a request to the
/// UpdateEndpointWeightsAndCapacities API and the endpoint status is
/// Updating , you get different desired and current values.
pub struct ProductionVariantSummary {
  /// The name of the variant.
  pub variant_name: Str? = None
  /// An array of DeployedImage objects that specify the Amazon EC2 Container
  /// Registry paths of the inference images deployed on instances of this
  /// ProductionVariant .
  pub deployed_images: List[DeployedImage]? = None
  /// The weight associated with the variant.
  pub current_weight: Float32? = None
  /// The requested weight, as specified in the
  /// UpdateEndpointWeightsAndCapacities request.
  pub desired_weight: Float32? = None
  /// The number of instances associated with the variant.
  pub current_instance_count: Int? = None
  /// The number of instances requested in the
  /// UpdateEndpointWeightsAndCapacities request.
  pub desired_instance_count: Int? = None
  /// A list of instance pools for the production variant. Each pool indicates
  /// the instance type and the current number of instances of that type.
  pub instance_pools: List[InstancePoolSummary]? = None
  /// The endpoint variant status which describes the current deployment stage
  /// status or operational status.
  pub variant_status: List[ProductionVariantStatus]? = None
  /// The serverless configuration for the endpoint.
  pub current_serverless_config: ProductionVariantServerlessConfig? = None
  /// The serverless configuration requested for the endpoint update.
  pub desired_serverless_config: ProductionVariantServerlessConfig? = None
  /// Settings that control the range in the number of instances that the
  /// endpoint provisions as it scales up or down to accommodate traffic.
  pub managed_instance_scaling: ProductionVariantManagedInstanceScaling? = None
  /// Settings that control how the endpoint routes incoming traffic to the
  /// instances that the endpoint hosts.
  pub routing_config: ProductionVariantRoutingConfig? = None
  /// Settings for the capacity reservation for the compute instances that
  /// SageMaker AI reserves for an endpoint.
  pub capacity_reservation_config: ProductionVariantCapacityReservationSummary? = None
  /// The accelerator partition layout that SageMaker applies to this
  /// production variant. On NVIDIA GPUs, the profiles are Multi-Instance GPU
  /// (MIG) profiles. SageMaker returns the accelerator partition layout as
  /// you provided it when you created the variant, without normalization.
  pub accelerator_partition_layouts: List[AcceleratorPartitionLayout]? = None
}

/// Configuration information for Amazon SageMaker Debugger system
/// monitoring, framework profiling, and storage paths.
pub struct ProfilerConfig {
  /// Path to Amazon S3 storage location for system and framework metrics.
  pub s3_output_path: Str? = None
  /// A time interval for capturing system metrics in milliseconds. Available
  /// values are 100, 200, 500, 1000 (1 second), 5000 (5 seconds), and 60000
  /// (1 minute) milliseconds. The default value is 500 milliseconds.
  pub profiling_interval_in_milliseconds: Int? = None
  /// Configuration information for capturing framework metrics. Available key
  /// strings for different profiling options are DetailedProfilingConfig ,
  /// PythonProfilingConfig , and DataLoaderProfilingConfig . The following
  /// codes are configuration structures for the ProfilingParameters
  /// parameter. To learn more about how to configure the ProfilingParameters
  /// parameter, see Use the SageMaker and Debugger Configuration API
  /// Operations to Create, Update, and Debug Your Training Job .
  pub profiling_parameters: Map[Str, Str]? = None
  /// Configuration to turn off Amazon SageMaker Debugger's system monitoring
  /// and profiling functionality. To turn it off, set to True .
  pub disable_profiler: Bool? = None
}

/// Configuration information for updating the Amazon SageMaker Debugger
/// profile parameters, system and framework metrics configurations, and
/// storage paths.
pub struct ProfilerConfigForUpdate {
  /// Path to Amazon S3 storage location for system and framework metrics.
  pub s3_output_path: Str? = None
  /// A time interval for capturing system metrics in milliseconds. Available
  /// values are 100, 200, 500, 1000 (1 second), 5000 (5 seconds), and 60000
  /// (1 minute) milliseconds. The default value is 500 milliseconds.
  pub profiling_interval_in_milliseconds: Int? = None
  /// Configuration information for capturing framework metrics. Available key
  /// strings for different profiling options are DetailedProfilingConfig ,
  /// PythonProfilingConfig , and DataLoaderProfilingConfig . The following
  /// codes are configuration structures for the ProfilingParameters
  /// parameter. To learn more about how to configure the ProfilingParameters
  /// parameter, see Use the SageMaker and Debugger Configuration API
  /// Operations to Create, Update, and Debug Your Training Job .
  pub profiling_parameters: Map[Str, Str]? = None
  /// To turn off Amazon SageMaker Debugger monitoring and profiling while a
  /// training job is in progress, set to True .
  pub disable_profiler: Bool? = None
}

/// Configuration information for profiling rules.
pub struct ProfilerRuleConfiguration {
  /// The name of the rule configuration. It must be unique relative to other
  /// rule configuration names.
  pub rule_configuration_name: Str? = None
  /// Path to local storage location for output of rules. Defaults to
  /// /opt/ml/processing/output/rule/ .
  pub local_path: Str? = None
  /// Path to Amazon S3 storage location for rules.
  pub s3_output_path: Str? = None
  /// The Amazon Elastic Container Registry Image for the managed rule
  /// evaluation.
  pub rule_evaluator_image: Str? = None
  /// The instance type to deploy a custom rule for profiling a training job.
  pub instance_type: ProcessingInstanceType? = None
  /// The size, in GB, of the ML storage volume attached to the processing
  /// instance.
  pub volume_size_in_gb: Int? = None
  /// Runtime configuration for rule container.
  pub rule_parameters: Map[Str, Str]? = None
}

/// Information about the status of the rule evaluation.
pub struct ProfilerRuleEvaluationStatus {
  /// The name of the rule configuration.
  pub rule_configuration_name: Str? = None
  /// The Amazon Resource Name (ARN) of the rule evaluation job.
  pub rule_evaluation_job_arn: Str? = None
  /// Status of the rule evaluation.
  pub rule_evaluation_status: RuleEvaluationStatus? = None
  /// Details from the rule evaluation.
  pub status_details: Str? = None
  /// Timestamp when the rule evaluation status was last modified.
  pub last_modified_time: Time? = None
}

pub enum ProfilingStatus: Str {
  Enabled = "Enabled"
  Disabled = "Disabled"
  Unknown(value: Str)
}

