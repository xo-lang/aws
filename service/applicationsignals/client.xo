fn json_of_interval(v: Interval) -> json.Value {
  match v {
    RollingInterval(x) => json.Value.Object([("RollingInterval", json_of_rolling_interval(x))])
    CalendarInterval(x) => json.Value.Object([("CalendarInterval", json_of_calendar_interval(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_interval(v: json.Value) -> Interval ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "RollingInterval" => Ok(Interval.RollingInterval(from_json_rolling_interval(fv)?))
      "CalendarInterval" => Ok(Interval.CalendarInterval(from_json_calendar_interval(fv)?))
      _ => Ok(Interval.Unknown(k))
    }
  }
  Err("Interval: no member set")
}

