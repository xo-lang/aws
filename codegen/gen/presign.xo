// Presigned requests: `presign_<op>` for the operations aws-sdk-go-v2's
// presign clients cover (S3's object and bucket calls, STS
// GetCallerIdentity). The request is built and routed as the operation's
// own, then signed in its query instead of sent.

use github.com/xo-lang/aws/codegen/model

/// (service shape id, operation name) pairs that get a presign method.
const PRESIGNED: List[(Str, Str)] = [
  ("com.amazonaws.s3#AmazonS3", "GetObject"),
  ("com.amazonaws.s3#AmazonS3", "PutObject"),
  ("com.amazonaws.s3#AmazonS3", "HeadObject"),
  ("com.amazonaws.s3#AmazonS3", "DeleteObject"),
  ("com.amazonaws.s3#AmazonS3", "UploadPart"),
  ("com.amazonaws.s3#AmazonS3", "HeadBucket"),
  ("com.amazonaws.s3#AmazonS3", "DeleteBucket"),
  ("com.amazonaws.sts#AWSSecurityTokenServiceV20110615", "GetCallerIdentity"),
]

pub fn presigned(g: G, op: Str) -> Bool {
  PRESIGNED.contains((g.m.service, model.name_of(op)))
}

pub fn emit_presign(g: G, op: Str, route: Str, token: Str, in_t: Str, var out: List[Str]) {
  let name = op_name(op)
  let en = op_err(op)
  out.push("/// ${model.name_of(op)} as a presigned request: a URL (and the headers")
  out.push("/// to send with it) that works without credentials until `expires`")
  out.push("/// passes (at most 7 days).")
  if g.query {
    out.push("/// The form parameters are sent as the query of a GET, as aws-sdk-go-v2")
    out.push("/// presigns query protocol calls.")
  }
  out.push("pub fn (c: Client) presign_${name}(input: ${in_t}, expires: Duration = 15m) -> transport.Presigned ! ${en} uses (net.dial, clock, rand) {")
  out.push("  let (ep, signing, extra) = ${route} ?? e => return Err(${en}.InvalidInput(e))")
  out.push("  var req = serialize_${name}(ep, input, ${token}) ?? e => return Err(${en}.InvalidInput(e))")
  out.push("  for h in extra {")
  out.push("    req.headers.push(h)")
  out.push("  }")
  if g.query {
    out.push("  req = req with {")
    out.push("    method: \"GET\",")
    out.push("    query: req.body.to_str() ?? \"\",")
    out.push("    body: b\"\",")
    out.push("    headers: req.headers.filter(fn(h: (Str, Str)) -> Bool { h.0.to_lower() != \"content-type\" }),")
    out.push("  }")
  }
  out.push("  transport.presign(c.transport, req, signing, expires) ?? e => Err(${en}.Send(e))")
  out.push("}")
  out.push("")
}
