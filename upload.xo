// A request body sent as it is read, for an operation whose payload is a
// streaming blob (S3 PutObject and UploadPart, and others): a large file
// is uploaded without holding it in memory (decision 0009).
//
// An attempt reads the body from its start, so a body that can be read
// again (`upload_opener`, and `fileio.upload_file` built on it) is
// retried like any other; one that cannot (`upload_reader`) gets one
// attempt. The root reaches no files (decision 0011): a file is read by
// the `fileio` module, or by the caller's own opener.

use std/http

enum Source {
  /// A reader that can be sent once.
  Once(reader: http.BodyReader, used: Atomic[Bool])
  /// A fresh reader of the whole body for each attempt, and what ends
  /// it when the operation returns.
  Reopen(open: fn() -> http.BodyReader ! Str, done: fn())
}

/// A streamed request body; copies share it.
pub struct Upload {
  /// The body's length in bytes, when known. S3 needs it (its
  /// `requiresLength` operations); without it the body is sent chunked.
  pub length: Int?
  source: Source
}

/// The bytes of `reader`, sent once (no retries). `length`, when given,
/// must be the number of bytes the reader gives.
pub fn upload_reader(reader: http.BodyReader, length: Int? = None) -> Upload {
  Upload{length: length, source: Source.Once(reader: reader, used: Atomic.new(false))}
}

/// A body that `open` gives afresh for each attempt, so it is retried
/// like any other; `done` runs when the operation that sends it returns
/// (to stop a task that feeds the readers). `length`, when given, must
/// be the number of bytes each reader gives. `fileio.upload_file` is
/// this for a file.
pub fn upload_opener(open: fn() -> http.BodyReader ! Str, length: Int? = None, done: fn() = fn() {}) -> Upload {
  Upload{length: length, source: Source.Reopen(open: open, done: done)}
}

/// The reader for the next attempt, or Err when the body cannot be read
/// again.
pub fn (u: Upload) open() -> http.BodyReader ! Str {
  match u.source {
    Once(reader, used) => if used.swap(true) { Err("the body cannot be read again (upload_reader); use upload_opener or fileio.upload_file to retry") } else { Ok(reader) }
    Reopen(open, _) => open()
  }
}

/// Whether every attempt can send the body.
pub fn (u: Upload) reopenable() -> Bool {
  u.source is Source.Reopen(..)
}

/// Runs the opener's `done` (a file's task ends); the upload cannot be
/// opened afterwards.
pub fn (u: Upload) done() {
  if let Source.Reopen(_, done) = u.source {
    done()
  }
}
