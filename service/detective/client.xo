  }
  if let Some(x) = v.email_address {
    fs.push(("EmailAddress", json.Value.Str(x)))
  }
  if let Some(x) = v.graph_arn {
    fs.push(("GraphArn", json.Value.Str(x)))
  }
  if let Some(x) = v.master_id {
    fs.push(("MasterId", json.Value.Str(x)))
  }
  if let Some(x) = v.administrator_id {
    fs.push(("AdministratorId", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("Status", json.Value.Str(x.value())))
  }
  if let Some(x) = v.disabled_reason {
    fs.push(("DisabledReason", json.Value.Str(x.value())))
  }
  if let Some(x) = v.invited_time {
    fs.push(("InvitedTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.updated_time {
    fs.push(("UpdatedTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.volume_usage_in_bytes {
    fs.push(("VolumeUsageInBytes", json.Value.Int(x)))
  }
  if let Some(x) = v.volume_usage_updated_time {
    fs.push(("VolumeUsageUpdatedTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.percent_of_graph_utilization {
    fs.push(("PercentOfGraphUtilization", jsonv.float(x)))
  }
  if let Some(x) = v.percent_of_graph_utilization_updated_time {
    fs.push(("PercentOfGraphUtilizationUpdatedTime", jsonv.time(x, "date-time")))
  }
  if let Some(x) = v.invitation_type {
    fs.push(("InvitationType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.volume_usage_by_datasource_package {
    fs.push(("VolumeUsageByDatasourcePackage", json_of_volume_usage_by_datasource_package(x)))
  }
  if let Some(x) = v.datasource_package_ingest_states {
    fs.push(("DatasourcePackageIngestStates", json_of_datasource_package_ingest_states(x)))
  }
  json.Value.Object(fs)
}

fn from_json_member_detail(v: json.Value) -> MemberDetail ! Str {
  var out = MemberDetail{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "AccountId" => out.account_id = jsonv.read_str(fv)?
      "EmailAddress" => out.email_address = jsonv.read_str(fv)?
      "GraphArn" => out.graph_arn = jsonv.read_str(fv)?
      "MasterId" => out.master_id = jsonv.read_str(fv)?
      "AdministratorId" => out.administrator_id = jsonv.read_str(fv)?
      "Status" => out.status = MemberStatus.from(jsonv.read_str(fv)?)
      "DisabledReason" => out.disabled_reason = MemberDisabledReason.from(jsonv.read_str(fv)?)
      "InvitedTime" => out.invited_time = jsonv.read_time(fv, "date-time")?
      "UpdatedTime" => out.updated_time = jsonv.read_time(fv, "date-time")?
      "VolumeUsageInBytes" => out.volume_usage_in_bytes = jsonv.read_int(fv)?
      "VolumeUsageUpdatedTime" => out.volume_usage_updated_time = jsonv.read_time(fv, "date-time")?
      "PercentOfGraphUtilization" => out.percent_of_graph_utilization = jsonv.read_float(fv)?
      "PercentOfGraphUtilizationUpdatedTime" => out.percent_of_graph_utilization_updated_time = jsonv.read_time(fv, "date-time")?
      "InvitationType" => out.invitation_type = InvitationType.from(jsonv.read_str(fv)?)
      "VolumeUsageByDatasourcePackage" => out.volume_usage_by_datasource_package = from_json_volume_usage_by_datasource_package(fv)?
      "DatasourcePackageIngestStates" => out.datasource_package_ingest_states = from_json_datasource_package_ingest_states(fv)?
      _ => {}
    }
  }
  Ok(out)
}

