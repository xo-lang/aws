/// A StartConversation stream: `send` writes input events (signed in a chain),
/// `close_send` ends them, and `close` ends the whole stream.
pub struct StartConversationStream {
  pub output: StartConversationResponse
  writer: http.PipeWriter
  signer: sigv4.StreamSigner
  clock: Clock
  body: http.ClientStream
  dec: eventstream.Decoder = eventstream.decoder()
  done: Bool = false
  sent_end: Bool = false
}

/// Sends input event `e`.
pub fn (var s: StartConversationStream) send(e: StartConversationRequestEventStream) -> () ! IoErr uses clock {
  let m = eventstream.encode(event_message_start_conversation_request_event_stream(e))
  s.writer.write(eventstream.signed(s.signer, m, s.clock.now()))
}

/// Ends the input events: sends the signed empty message and closes
/// the request body.
pub fn (var s: StartConversationStream) close_send() -> () ! IoErr uses clock {
  if s.sent_end {
    return Ok(())
  }
  s.sent_end = true
  let r = s.writer.write(eventstream.signed(s.signer, b"", s.clock.now()))
  s.writer.close()
  r
}

/// The next event, None at the end of the stream.
pub fn (var s: StartConversationStream) next() -> StartConversationResponseEventStream? ! StartConversationResponseEventStreamErr uses net.dial {
  while !s.done {
    match s.dec.next() {
      Err(e) => return Err(StartConversationResponseEventStreamErr.Read(e.display()))
      Ok(Some(m)) => {
        match m.header_str(":message-type") {
          "event" => {
            let t = m.header_str(":event-type")
            if t == "initial-response" {
              continue
            }
            return match event_start_conversation_response_event_stream(t, m) {
              Ok(v) => Ok(Some(v))
              Err(msg) => Err(StartConversationResponseEventStreamErr.Read(msg))
            }
          }
          "exception" => return Err(exception_start_conversation_response_event_stream(m))
          _ => return Err(StartConversationResponseEventStreamErr.Api(aws.ApiError{code: m.header_str(":error-code"), message: m.header_str(":error-message")}))
        }
      }
      Ok(None) => {
        match s.body.read() {
          Ok(Some(piece)) => s.dec.feed(piece)
          Ok(None) => {
            s.done = true
            s.body.close()
            if s.dec.pending() > 0 {
              return Err(StartConversationResponseEventStreamErr.Read("the stream ended inside a message"))
            }
          }
          Err(e) => {
            s.done = true
            s.body.close()
            return Err(StartConversationResponseEventStreamErr.Read(e.display()))
          }
        }
      }
    }
  }
  Ok(None)
}

/// Ends the stream in both directions.
pub fn (var s: StartConversationStream) close() uses clock {
  match s.close_send() {
    Ok(_) => {}
    // closing anyway: a failed end message changes nothing here
    Err(_) => {}
  }
  if !s.done {
    s.done = true
    s.body.close()
  }
}

