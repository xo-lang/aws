fn xml_write_rule_condition(var w: xmlv.Writer, v: RuleCondition, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.field {
    xmlv.elem(w, "Field", x, [])
  }
  if let Some(x) = v.values {
    xml_write_list_of_string(w, x, "Values", [])
  }
  if let Some(x) = v.host_header_config {
    xml_write_host_header_condition_config(w, x, "HostHeaderConfig", [])
  }
  if let Some(x) = v.path_pattern_config {
    xml_write_path_pattern_condition_config(w, x, "PathPatternConfig", [])
  }
  if let Some(x) = v.http_header_config {
    xml_write_http_header_condition_config(w, x, "HttpHeaderConfig", [])
  }
  if let Some(x) = v.query_string_config {
    xml_write_query_string_condition_config(w, x, "QueryStringConfig", [])
  }
  if let Some(x) = v.http_request_method_config {
    xml_write_http_request_method_condition_config(w, x, "HttpRequestMethodConfig", [])
  }
  if let Some(x) = v.source_ip_config {
    xml_write_source_ip_condition_config(w, x, "SourceIpConfig", [])
  }
  if let Some(x) = v.regex_values {
    xml_write_list_of_string(w, x, "RegexValues", [])
  }
  xmlv.end(w, name)
}

fn xml_read_rule_condition(e: xml.Element) -> RuleCondition ! Str {
  var out = RuleCondition{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Field" => out.field = c.text()
      "Values" => out.values = xml_read_list_of_string(c)?
      "HostHeaderConfig" => out.host_header_config = xml_read_host_header_condition_config(c)?
      "PathPatternConfig" => out.path_pattern_config = xml_read_path_pattern_condition_config(c)?
      "HttpHeaderConfig" => out.http_header_config = xml_read_http_header_condition_config(c)?
      "QueryStringConfig" => out.query_string_config = xml_read_query_string_condition_config(c)?
      "HttpRequestMethodConfig" => out.http_request_method_config = xml_read_http_request_method_condition_config(c)?
      "SourceIpConfig" => out.source_ip_config = xml_read_source_ip_condition_config(c)?
      "RegexValues" => out.regex_values = xml_read_list_of_string(c)?
      _ => {}
    }
  }
  Ok(out)
}

