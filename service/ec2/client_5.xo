fn xml_read_ipam_pool(e: xml.Element) -> IpamPool ! Str {
  var out = IpamPool{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ownerId" => out.owner_id = c.text()
      "ipamPoolId" => out.ipam_pool_id = c.text()
      "sourceIpamPoolId" => out.source_ipam_pool_id = c.text()
      "ipamPoolArn" => out.ipam_pool_arn = c.text()
      "ipamScopeArn" => out.ipam_scope_arn = c.text()
      "ipamScopeType" => out.ipam_scope_type = IpamScopeType.from(c.text())
      "ipamArn" => out.ipam_arn = c.text()
      "ipamRegion" => out.ipam_region = c.text()
      "locale" => out.locale = c.text()
      "poolDepth" => out.pool_depth = xmlv.read_int(c.text())?
      "state" => out.state = IpamPoolState.from(c.text())
      "stateMessage" => out.state_message = c.text()
      "description" => out.description = c.text()
      "autoImport" => out.auto_import = xmlv.read_bool(c.text())?
      "publiclyAdvertisable" => out.publicly_advertisable = xmlv.read_bool(c.text())?
      "addressFamily" => out.address_family = AddressFamily.from(c.text())
      "allocationMinNetmaskLength" => out.allocation_min_netmask_length = xmlv.read_int(c.text())?
      "allocationMaxNetmaskLength" => out.allocation_max_netmask_length = xmlv.read_int(c.text())?
      "allocationDefaultNetmaskLength" => out.allocation_default_netmask_length = xmlv.read_int(c.text())?
