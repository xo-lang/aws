fn xml_write_verified_access_endpoint(var w: xmlv.Writer, v: VerifiedAccessEndpoint, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.verified_access_instance_id {
    xmlv.elem(w, "verifiedAccessInstanceId", x, [])
  }
  if let Some(x) = v.verified_access_group_id {
    xmlv.elem(w, "verifiedAccessGroupId", x, [])
  }
  if let Some(x) = v.verified_access_endpoint_id {
    xmlv.elem(w, "verifiedAccessEndpointId", x, [])
  }
  if let Some(x) = v.application_domain {
    xmlv.elem(w, "applicationDomain", x, [])
  }
  if let Some(x) = v.endpoint_type {
    xmlv.elem(w, "endpointType", x.value(), [])
  }
  if let Some(x) = v.attachment_type {
    xmlv.elem(w, "attachmentType", x.value(), [])
  }
  if let Some(x) = v.domain_certificate_arn {
    xmlv.elem(w, "domainCertificateArn", x, [])
  }
  if let Some(x) = v.endpoint_domain {
    xmlv.elem(w, "endpointDomain", x, [])
  }
  if let Some(x) = v.device_validation_domain {
    xmlv.elem(w, "deviceValidationDomain", x, [])
  }
  if let Some(x) = v.security_group_ids {
    xml_write_security_group_id_list(w, x, "securityGroupIdSet", [])
  }
  if let Some(x) = v.load_balancer_options {
    xml_write_verified_access_endpoint_load_balancer_options(w, x, "loadBalancerOptions", [])
  }
  if let Some(x) = v.network_interface_options {
    xml_write_verified_access_endpoint_eni_options(w, x, "networkInterfaceOptions", [])
  }
  if let Some(x) = v.status {
    xml_write_verified_access_endpoint_status(w, x, "status", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "description", x, [])
  }
  if let Some(x) = v.creation_time {
    xmlv.elem(w, "creationTime", x, [])
  }
  if let Some(x) = v.last_updated_time {
    xmlv.elem(w, "lastUpdatedTime", x, [])
  }
  if let Some(x) = v.deletion_time {
    xmlv.elem(w, "deletionTime", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.sse_specification {
    xml_write_verified_access_sse_specification_response(w, x, "sseSpecification", [])
  }
  if let Some(x) = v.rds_options {
    xml_write_verified_access_endpoint_rds_options(w, x, "rdsOptions", [])
  }
  if let Some(x) = v.cidr_options {
    xml_write_verified_access_endpoint_cidr_options(w, x, "cidrOptions", [])
  }
  xmlv.end(w, name)
}

fn xml_read_verified_access_endpoint(e: xml.Element) -> VerifiedAccessEndpoint ! Str {
  var out = VerifiedAccessEndpoint{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "verifiedAccessInstanceId" => out.verified_access_instance_id = c.text()
      "verifiedAccessGroupId" => out.verified_access_group_id = c.text()
      "verifiedAccessEndpointId" => out.verified_access_endpoint_id = c.text()
      "applicationDomain" => out.application_domain = c.text()
      "endpointType" => out.endpoint_type = VerifiedAccessEndpointType.from(c.text())
      "attachmentType" => out.attachment_type = VerifiedAccessEndpointAttachmentType.from(c.text())
      "domainCertificateArn" => out.domain_certificate_arn = c.text()
      "endpointDomain" => out.endpoint_domain = c.text()
      "deviceValidationDomain" => out.device_validation_domain = c.text()
      "securityGroupIdSet" => out.security_group_ids = xml_read_security_group_id_list(c)?
      "loadBalancerOptions" => out.load_balancer_options = xml_read_verified_access_endpoint_load_balancer_options(c)?
      "networkInterfaceOptions" => out.network_interface_options = xml_read_verified_access_endpoint_eni_options(c)?
      "status" => out.status = xml_read_verified_access_endpoint_status(c)?
      "description" => out.description = c.text()
      "creationTime" => out.creation_time = c.text()
      "lastUpdatedTime" => out.last_updated_time = c.text()
      "deletionTime" => out.deletion_time = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "sseSpecification" => out.sse_specification = xml_read_verified_access_sse_specification_response(c)?
      "rdsOptions" => out.rds_options = xml_read_verified_access_endpoint_rds_options(c)?
      "cidrOptions" => out.cidr_options = xml_read_verified_access_endpoint_cidr_options(c)?
      _ => {}
    }
  }
  Ok(out)
}

