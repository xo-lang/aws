fn xml_write_instance_status(var w: xmlv.Writer, v: InstanceStatus, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.availability_zone_id {
    xmlv.elem(w, "availabilityZoneId", x, [])
  }
  if let Some(x) = v.outpost_arn {
    xmlv.elem(w, "outpostArn", x, [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_response(w, x, "operator", [])
  }
  if let Some(x) = v.events {
    xml_write_instance_status_event_list(w, x, "eventsSet", [])
  }
  if let Some(x) = v.instance_id {
    xmlv.elem(w, "instanceId", x, [])
  }
  if let Some(x) = v.instance_state {
    xml_write_instance_state(w, x, "instanceState", [])
  }
  if let Some(x) = v.instance_status {
    xml_write_instance_status_summary(w, x, "instanceStatus", [])
  }
  if let Some(x) = v.system_status {
    xml_write_instance_status_summary(w, x, "systemStatus", [])
  }
  if let Some(x) = v.attached_ebs_status {
    xml_write_ebs_status_summary(w, x, "attachedEbsStatus", [])
  }
  if let Some(x) = v.application_status {
    xml_write_application_status_summary(w, x, "applicationStatus", [])
  }
  if let Some(x) = v.performance_status {
    xml_write_performance_status_summary(w, x, "performanceStatus", [])
  }
  xmlv.end(w, name)
}

fn xml_read_instance_status(e: xml.Element) -> InstanceStatus ! Str {
  var out = InstanceStatus{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "availabilityZone" => out.availability_zone = c.text()
      "availabilityZoneId" => out.availability_zone_id = c.text()
      "outpostArn" => out.outpost_arn = c.text()
      "operator" => out.operator = xml_read_operator_response(c)?
      "eventsSet" => out.events = xml_read_instance_status_event_list(c)?
      "instanceId" => out.instance_id = c.text()
      "instanceState" => out.instance_state = xml_read_instance_state(c)?
      "instanceStatus" => out.instance_status = xml_read_instance_status_summary(c)?
      "systemStatus" => out.system_status = xml_read_instance_status_summary(c)?
      "attachedEbsStatus" => out.attached_ebs_status = xml_read_ebs_status_summary(c)?
      "applicationStatus" => out.application_status = xml_read_application_status_summary(c)?
      "performanceStatus" => out.performance_status = xml_read_performance_status_summary(c)?
      _ => {}
    }
  }
  Ok(out)
}

