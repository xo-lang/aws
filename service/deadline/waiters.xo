/// Wait until a LicenseEndpoint is Deleted. Use this after invoking
/// DeleteLicenseEndpoint.
///
/// Calls GetLicenseEndpoint until the LicenseEndpointDeleted acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (10s) to `max_delay` (2340s).
pub fn wait_until_license_endpoint_deleted(c: Client, input: GetLicenseEndpointRequest, max_wait: Duration, min_delay: Duration = 10s, max_delay: Duration = 2340s) -> () ! waiter.WaitErr[GetLicenseEndpointErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_license_endpoint(input) {
      Ok(out) => {
        let o = jmes_of_get_license_endpoint_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "NOT_READY") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_get_license_endpoint(e)
        if state == "" && waiter.error_is(names, "ResourceNotFoundException") {
          state = "success"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("LicenseEndpointDeleted: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Wait until a LicenseEndpoint is Ready. Use this after invoking
/// CreateLicenseEndpoint.
///
/// Calls GetLicenseEndpoint until the LicenseEndpointValid acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (10s) to `max_delay` (1140s).
pub fn wait_until_license_endpoint_valid(c: Client, input: GetLicenseEndpointRequest, max_wait: Duration, min_delay: Duration = 10s, max_delay: Duration = 1140s) -> () ! waiter.WaitErr[GetLicenseEndpointErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_license_endpoint(input) {
      Ok(out) => {
        let o = jmes_of_get_license_endpoint_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "READY") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "NOT_READY") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("LicenseEndpointValid: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

/// Calls GetQueue until the QueueScheduling acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (10s) to `max_delay` (700s).
pub fn wait_until_queue_scheduling(c: Client, input: GetQueueRequest, max_wait: Duration, min_delay: Duration = 10s, max_delay: Duration = 700s) -> () ! waiter.WaitErr[GetQueueErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.get_queue(input) {
      Ok(out) => {
        let o = jmes_of_get_queue_response(out)
        if state == "" && waiter.path_matches(o, "status", "stringEquals", "SCHEDULING") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("QueueScheduling: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

