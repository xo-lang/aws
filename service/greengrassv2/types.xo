  /// configuration deployment.
  pub criteria_list: List[IoTJobAbortCriteria]? = None
}

/// Contains criteria that define when and how to cancel a job. The
/// deployment stops if the following conditions are true: The number of
/// things that receive the deployment exceeds the minNumberOfExecutedThings
/// . The percentage of failures with type failureType exceeds the
/// thresholdPercentage .
pub struct IoTJobAbortCriteria {
  /// The type of job deployment failure that can cancel a job.
