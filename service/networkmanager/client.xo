fn json_of_device(v: Device) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.device_id {
    fs.push(("DeviceId", json.Value.Str(x)))
  }
  if let Some(x) = v.device_arn {
    fs.push(("DeviceArn", json.Value.Str(x)))
  }
  if let Some(x) = v.global_network_id {
    fs.push(("GlobalNetworkId", json.Value.Str(x)))
  }
  if let Some(x) = v.aws_location {
    fs.push(("AWSLocation", json_of_aws_location(x)))
  }
  if let Some(x) = v.description {
    fs.push(("Description", json.Value.Str(x)))
  }
  if let Some(x) = v.type_value {
    fs.push(("Type", json.Value.Str(x)))
  }
  if let Some(x) = v.vendor {
    fs.push(("Vendor", json.Value.Str(x)))
  }
  if let Some(x) = v.model {
    fs.push(("Model", json.Value.Str(x)))
  }
  if let Some(x) = v.serial_number {
    fs.push(("SerialNumber", json.Value.Str(x)))
  }
  if let Some(x) = v.location {
    fs.push(("Location", json_of_location(x)))
  }
  if let Some(x) = v.site_id {
    fs.push(("SiteId", json.Value.Str(x)))
  }
  if let Some(x) = v.created_at {
    fs.push(("CreatedAt", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.state {
    fs.push(("State", json.Value.Str(x.value())))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_list(x)))
  }
  json.Value.Object(fs)
}

fn from_json_device(v: json.Value) -> Device ! Str {
  var out = Device{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "DeviceId" => out.device_id = jsonv.read_str(fv)?
      "DeviceArn" => out.device_arn = jsonv.read_str(fv)?
      "GlobalNetworkId" => out.global_network_id = jsonv.read_str(fv)?
      "AWSLocation" => out.aws_location = from_json_aws_location(fv)?
      "Description" => out.description = jsonv.read_str(fv)?
      "Type" => out.type_value = jsonv.read_str(fv)?
      "Vendor" => out.vendor = jsonv.read_str(fv)?
      "Model" => out.model = jsonv.read_str(fv)?
      "SerialNumber" => out.serial_number = jsonv.read_str(fv)?
      "Location" => out.location = from_json_location(fv)?
      "SiteId" => out.site_id = jsonv.read_str(fv)?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "State" => out.state = DeviceState.from(jsonv.read_str(fv)?)
      "Tags" => out.tags = from_json_tag_list(fv)?
      _ => {}
    }
  }
