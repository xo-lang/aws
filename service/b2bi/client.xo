  var out = TransformerSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "transformerId" => out.transformer_id = jsonv.read_str(fv)?
      "name" => out.name = jsonv.read_str(fv)?
      "status" => out.status = TransformerStatus.from(jsonv.read_str(fv)?)
      "createdAt" => out.created_at = jsonv.read_time(fv, "date-time")?
      "modifiedAt" => out.modified_at = jsonv.read_time(fv, "date-time")?
      "fileFormat" => out.file_format = FileFormat.from(jsonv.read_str(fv)?)
