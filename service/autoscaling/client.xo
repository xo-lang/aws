fn query_put_account_setting(var f: query.Form, prefix: Str, v: AccountSetting) {
  if let Some(x) = v.name {
    query.add(f, query.key(prefix, "Name"), x)
  }
  if let Some(x) = v.value {
    query.add(f, query.key(prefix, "Value"), x)
  }
  if let Some(x) = v.enforcement_type {
    query.add(f, query.key(prefix, "EnforcementType"), x)
  }
  if let Some(x) = v.enforcement_date {
    query.add(f, query.key(prefix, "EnforcementDate"), rest.date_time(x))
  }
  if let Some(x) = v.default_value {
    query.add(f, query.key(prefix, "DefaultValue"), x)
  }
  if let Some(x) = v.enforced_value {
    query.add(f, query.key(prefix, "EnforcedValue"), x)
  }
}

fn query_put_account_settings(var f: query.Form, prefix: Str, v: List[AccountSetting], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_account_setting(f, k, x)
  }
}

