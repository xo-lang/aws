    RetentionAction(x) => json.Value.Object([("RetentionAction", json.Value.Str(x.value()))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_retention_options(v: json.Value) -> RetentionOptions ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "RetentionInHours" => Ok(RetentionOptions.RetentionInHours(jsonv.read_int(fv)?))
      "RetentionAction" => Ok(RetentionOptions.RetentionAction(RetentionAction.from(jsonv.read_str(fv)?)))
      _ => Ok(RetentionOptions.Unknown(k))
    }
  }
  Err("RetentionOptions: no member set")
}

