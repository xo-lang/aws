  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "flowInputEvent" => Ok(FlowExecutionEvent.FlowInputEvent(from_json_flow_execution_input_event(fv)?))
      "flowOutputEvent" => Ok(FlowExecutionEvent.FlowOutputEvent(from_json_flow_execution_output_event(fv)?))
      "nodeInputEvent" => Ok(FlowExecutionEvent.NodeInputEvent(from_json_node_input_event(fv)?))
      "nodeOutputEvent" => Ok(FlowExecutionEvent.NodeOutputEvent(from_json_node_output_event(fv)?))
      "conditionResultEvent" => Ok(FlowExecutionEvent.ConditionResultEvent(from_json_condition_result_event(fv)?))
