  if let Some(x) = v.resource_type {
    query.add(f, query.key(prefix, "ResourceType"), x)
  }
  if let Some(x) = v.resource_identifier {
    query_put_jazz_resource_identifier_properties(f, query.key(prefix, "ResourceIdentifier"), x, false)
  }
  if let Some(x) = v.managed_by_stack {
    query.add(f, query.key(prefix, "ManagedByStack"), "${x}")
  }
}

fn query_put_scanned_resource_identifier(var f: query.Form, prefix: Str, v: ScannedResourceIdentifier) {
  if let Some(x) = v.resource_type {
    query.add(f, query.key(prefix, "ResourceType"), x)
  }
  if let Some(x) = v.resource_identifier {
    query_put_jazz_resource_identifier_properties(f, query.key(prefix, "ResourceIdentifier"), x, false)
  }
}

fn query_put_scanned_resource_identifiers(var f: query.Form, prefix: Str, v: List[ScannedResourceIdentifier], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_scanned_resource_identifier(f, k, x)
  }
}

fn query_put_scanned_resources(var f: query.Form, prefix: Str, v: List[ScannedResource], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query_put_scanned_resource(f, k, x)
  }
}

fn query_put_scope(var f: query.Form, prefix: Str, v: List[ResourceAttribute], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query.add(f, k, x.value())
  }
}

fn query_put_set_stack_policy_input(var f: query.Form, prefix: Str, v: SetStackPolicyInput) {
  if let Some(x) = v.stack_name {
    query.add(f, query.key(prefix, "StackName"), x)
  }
  if let Some(x) = v.stack_policy_body {
    query.add(f, query.key(prefix, "StackPolicyBody"), x)
  }
  if let Some(x) = v.stack_policy_url {
    query.add(f, query.key(prefix, "StackPolicyURL"), x)
  }
}

fn query_put_set_type_configuration_input(var f: query.Form, prefix: Str, v: SetTypeConfigurationInput) {
  if let Some(x) = v.type_arn {
    query.add(f, query.key(prefix, "TypeArn"), x)
  }
  if let Some(x) = v.configuration {
    query.add(f, query.key(prefix, "Configuration"), x)
  }
  if let Some(x) = v.configuration_alias {
    query.add(f, query.key(prefix, "ConfigurationAlias"), x)
  }
  if let Some(x) = v.type_name {
    query.add(f, query.key(prefix, "TypeName"), x)
  }
  if let Some(x) = v.type_value {
    query.add(f, query.key(prefix, "Type"), x.value())
  }
}

fn query_put_set_type_configuration_output(var f: query.Form, prefix: Str, v: SetTypeConfigurationOutput) {
  if let Some(x) = v.configuration_arn {
    query.add(f, query.key(prefix, "ConfigurationArn"), x)
  }
}

fn query_put_set_type_default_version_input(var f: query.Form, prefix: Str, v: SetTypeDefaultVersionInput) {
  if let Some(x) = v.arn {
    query.add(f, query.key(prefix, "Arn"), x)
  }
  if let Some(x) = v.type_value {
    query.add(f, query.key(prefix, "Type"), x.value())
  }
  if let Some(x) = v.type_name {
    query.add(f, query.key(prefix, "TypeName"), x)
  }
  if let Some(x) = v.version_id {
    query.add(f, query.key(prefix, "VersionId"), x)
  }
}

fn query_put_set_type_default_version_output(var f: query.Form, prefix: Str, v: SetTypeDefaultVersionOutput) {
  let _ = (f, prefix, v)
}

fn query_put_signal_resource_input(var f: query.Form, prefix: Str, v: SignalResourceInput) {
  if let Some(x) = v.stack_name {
    query.add(f, query.key(prefix, "StackName"), x)
  }
  if let Some(x) = v.logical_resource_id {
    query.add(f, query.key(prefix, "LogicalResourceId"), x)
  }
  if let Some(x) = v.unique_id {
    query.add(f, query.key(prefix, "UniqueId"), x)
  }
  if let Some(x) = v.status {
    query.add(f, query.key(prefix, "Status"), x.value())
  }
}

fn query_put_stack(var f: query.Form, prefix: Str, v: Stack) {
  if let Some(x) = v.stack_id {
    query.add(f, query.key(prefix, "StackId"), x)
  }
  if let Some(x) = v.stack_name {
    query.add(f, query.key(prefix, "StackName"), x)
  }
  if let Some(x) = v.change_set_id {
    query.add(f, query.key(prefix, "ChangeSetId"), x)
  }
  if let Some(x) = v.description {
    query.add(f, query.key(prefix, "Description"), x)
  }
  if let Some(x) = v.parameters {
    query_put_parameters(f, query.key(prefix, "Parameters"), x, false)
  }
  if let Some(x) = v.creation_time {
    query.add(f, query.key(prefix, "CreationTime"), rest.date_time(x))
  }
  if let Some(x) = v.deletion_time {
    query.add(f, query.key(prefix, "DeletionTime"), rest.date_time(x))
  }
  if let Some(x) = v.last_updated_time {
    query.add(f, query.key(prefix, "LastUpdatedTime"), rest.date_time(x))
  }
  if let Some(x) = v.rollback_configuration {
    query_put_rollback_configuration(f, query.key(prefix, "RollbackConfiguration"), x)
  }
  if let Some(x) = v.stack_status {
    query.add(f, query.key(prefix, "StackStatus"), x.value())
  }
  if let Some(x) = v.stack_status_reason {
    query.add(f, query.key(prefix, "StackStatusReason"), x)
  }
  if let Some(x) = v.disable_rollback {
    query.add(f, query.key(prefix, "DisableRollback"), "${x}")
  }
  if let Some(x) = v.deployment_config {
    query_put_deployment_config(f, query.key(prefix, "DeploymentConfig"), x)
  }
  if let Some(x) = v.notification_arns {
    query_put_notification_arns(f, query.key(prefix, "NotificationARNs"), x, false)
  }
  if let Some(x) = v.timeout_in_minutes {
    query.add(f, query.key(prefix, "TimeoutInMinutes"), "${x}")
  }
  if let Some(x) = v.capabilities {
    query_put_capabilities(f, query.key(prefix, "Capabilities"), x, false)
  }
  if let Some(x) = v.outputs {
    query_put_outputs(f, query.key(prefix, "Outputs"), x, false)
  }
  if let Some(x) = v.role_arn {
    query.add(f, query.key(prefix, "RoleARN"), x)
  }
  if let Some(x) = v.tags {
    query_put_tags(f, query.key(prefix, "Tags"), x, false)
  }
  if let Some(x) = v.enable_termination_protection {
    query.add(f, query.key(prefix, "EnableTerminationProtection"), "${x}")
  }
  if let Some(x) = v.parent_id {
    query.add(f, query.key(prefix, "ParentId"), x)
  }
  if let Some(x) = v.root_id {
    query.add(f, query.key(prefix, "RootId"), x)
  }
  if let Some(x) = v.drift_information {
    query_put_stack_drift_information(f, query.key(prefix, "DriftInformation"), x)
  }
  if let Some(x) = v.retain_except_on_create {
    query.add(f, query.key(prefix, "RetainExceptOnCreate"), "${x}")
  }
  if let Some(x) = v.deletion_mode {
    query.add(f, query.key(prefix, "DeletionMode"), x.value())
  }
  if let Some(x) = v.detailed_status {
    query.add(f, query.key(prefix, "DetailedStatus"), x.value())
  }
  if let Some(x) = v.last_operations {
    query_put_last_operations(f, query.key(prefix, "LastOperations"), x, false)
  }
}