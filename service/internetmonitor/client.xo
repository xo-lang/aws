pub fn (c: Client) update_monitor(input: UpdateMonitorInput) -> UpdateMonitorOutput ! UpdateMonitorErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_update_monitor(c.params, input)) ?? e => return Err(UpdateMonitorErr.InvalidInput(e))
  var req = serialize_update_monitor(ep, input, rest.uuid(c.rand)) ?? e => return Err(UpdateMonitorErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(UpdateMonitorErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_update_monitor_error(resp))
  }
  deserialize_update_monitor(resp) ?? e => Err(UpdateMonitorErr.Deserialize(e))
}
