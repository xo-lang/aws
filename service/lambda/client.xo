fn json_of_event(v: Event) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.event_type {
    fs.push(("EventType", json.Value.Str(x.value())))
  }
  if let Some(x) = v.sub_type {
    fs.push(("SubType", json.Value.Str(x)))
  }
  if let Some(x) = v.event_id {
    fs.push(("EventId", json.Value.Int(x)))
  }
  if let Some(x) = v.id {
    fs.push(("Id", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.event_timestamp {
    fs.push(("EventTimestamp", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.parent_id {
    fs.push(("ParentId", json.Value.Str(x)))
  }
  if let Some(x) = v.execution_started_details {
