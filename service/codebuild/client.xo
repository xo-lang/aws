      "environment" => out.environment = from_json_project_environment(fv)?
      "serviceRole" => out.service_role = jsonv.read_str(fv)?
      "timeoutInMinutes" => out.timeout_in_minutes = jsonv.read_int(fv)?
      "queuedTimeoutInMinutes" => out.queued_timeout_in_minutes = jsonv.read_int(fv)?
      "encryptionKey" => out.encryption_key = jsonv.read_str(fv)?
      "tags" => out.tags = from_json_tag_list(fv)?
      "created" => out.created = jsonv.read_time(fv, "epoch-seconds")?
      "lastModified" => out.last_modified = jsonv.read_time(fv, "epoch-seconds")?
      "webhook" => out.webhook = from_json_webhook(fv)?
      "vpcConfig" => out.vpc_config = from_json_vpc_config(fv)?
      "badge" => out.badge = from_json_project_badge(fv)?
      "logsConfig" => out.logs_config = from_json_logs_config(fv)?
