/// A reference input containing ground truth data for evaluation, scoped to
/// a specific context level (session or trace) through its span context.
pub struct EvaluationReferenceInput {
  /// The span context that identifies which session or trace this reference
  /// input applies to, used for correlating ground truth with agent output.
  pub context: Context? = None
  /// The expected response for trace-level evaluation. Built-in evaluators
  /// that support this field compare the agent's actual response against this
  /// value for assessment. Custom evaluators can access it through the
  /// {expected_response} placeholder in their instructions.
  pub expected_response: EvaluationContent? = None
  /// A list of assertion statements for session-level evaluation. Each
  /// assertion describes an expected behavior or outcome the agent should
  /// demonstrate during the session.
  pub assertions: List[EvaluationContent]? = None
  /// The expected tool call sequence for session-level trajectory evaluation.
  /// Contains a list of tool names representing the tools the agent is
  /// expected to invoke.
  pub expected_trajectory: EvaluationExpectedTrajectory? = None
}

/// The comprehensive result of an evaluation containing the score,
/// explanation, evaluator metadata, and execution details. Provides both
/// quantitative ratings and qualitative insights about agent performance.
pub struct EvaluationResultContent {
  /// The Amazon Resource Name (ARN) of the evaluator used to generate this
  /// result. For custom evaluators, this is the full ARN; for built-in
  /// evaluators, this follows the pattern Builtin.{EvaluatorName} .
  pub evaluator_arn: Str? = None
  /// The unique identifier of the evaluator that produced this result. This
  /// matches the evaluatorId provided in the evaluation request and can be
  /// used to identify which evaluator generated specific results.
  pub evaluator_id: Str? = None
  /// The human-readable name of the evaluator used for this evaluation. For
  /// built-in evaluators, this is the descriptive name (e.g., "Helpfulness",
  /// "Correctness"); for custom evaluators, this is the user-defined name.
  pub evaluator_name: Str? = None
  /// The name of the dimension that this result scores. This field is set
  /// only on results produced by an evaluator that uses a multi-dimensional
  /// rating scale, where each dimension is scored independently. For
  /// evaluators with a single rating scale, this field is absent.
  pub evaluation_dimension_name: Str? = None
  /// The detailed explanation provided by the evaluator describing the
  /// reasoning behind the assigned score. This qualitative feedback helps
  /// understand why specific ratings were given and provides actionable
  /// insights for improvement.
  pub explanation: Str? = None
  /// The contextual information associated with this evaluation result,
  /// including span context details that identify the specific traces and
  /// sessions that were evaluated.
  pub context: Context? = None
  /// The numerical score assigned by the evaluator according to its
  /// configured rating scale. For numerical scales, this is a decimal value
  /// within the defined range. This field is not allowed for categorical
  /// scales.
  pub value: Float? = None
  /// The categorical label assigned by the evaluator when using a categorical
  /// rating scale. This provides a human-readable description of the
  /// evaluation result (e.g., "Excellent", "Good", "Poor") corresponding to
  /// the numerical value. For numerical scales, this field is optional and
  /// provides a natural language explanation of what the value means (e.g.,
  /// value 0.5 = "Somewhat Helpful").
  pub label: Str? = None
  /// The token consumption statistics for this evaluation, including input
  /// tokens, output tokens, and total tokens used by the underlying language
  /// model during the evaluation process.
  pub token_usage: TokenUsage? = None
  /// The error message describing what went wrong if the evaluation failed.
  /// Provides detailed information about evaluation failures to help diagnose
  /// and resolve issues with evaluator configuration or input data.
  pub error_message: Str? = None
  /// The error code indicating the type of failure that occurred during
  /// evaluation. Used to programmatically identify and handle different
  /// categories of evaluation errors.
  pub error_code: Str? = None
  /// The list of reference input field names that were provided but not used
  /// by the evaluator. Helps identify which ground truth data was not
  /// consumed during evaluation.
  pub ignored_reference_input_fields: List[Str]? = None
}

