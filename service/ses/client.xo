  for c in xmlv.elements(e) {
    match c.name.local {
      "FinalRecipient" => out.final_recipient = c.text()
      "Action" => out.action = DsnAction.from(c.text())
      "RemoteMta" => out.remote_mta = c.text()
      "Status" => out.status = c.text()
      "DiagnosticCode" => out.diagnostic_code = c.text()
      "LastAttemptDate" => out.last_attempt_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "ExtensionFields" => out.extension_fields = xml_read_extension_field_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

