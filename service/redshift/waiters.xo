  if let Some(x) = v.elapsed_time_in_seconds {
    fs.push(("ElapsedTimeInSeconds", json.Value.Int(x)))
  }
  if let Some(x) = v.estimated_time_to_completion_in_seconds {
    fs.push(("EstimatedTimeToCompletionInSeconds", json.Value.Int(x)))
  }
  json.Value.Object(fs)
}

