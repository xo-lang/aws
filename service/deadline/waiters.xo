    match c.get_job(input) {
      Ok(out) => {
        let o = jmes_of_get_job_response(out)
        if state == "" && waiter.path_matches(o, "lifecycleStatus", "stringEquals", "CREATE_COMPLETE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "lifecycleStatus", "stringEquals", "UPDATE_IN_PROGRESS") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "lifecycleStatus", "stringEquals", "UPDATE_FAILED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "lifecycleStatus", "stringEquals", "UPDATE_SUCCEEDED") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "lifecycleStatus", "stringEquals", "UPLOAD_FAILED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "lifecycleStatus", "stringEquals", "CREATE_FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("JobCreateComplete: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

