fn json_of_evidence(v: Evidence) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.data_source {
    fs.push(("dataSource", json.Value.Str(x)))
  }
  if let Some(x) = v.evidence_aws_account_id {
    fs.push(("evidenceAwsAccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.time {
    fs.push(("time", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.event_source {
    fs.push(("eventSource", json.Value.Str(x)))
  }
  if let Some(x) = v.event_name {
    fs.push(("eventName", json.Value.Str(x)))
  }
  if let Some(x) = v.evidence_by_type {
    fs.push(("evidenceByType", json.Value.Str(x)))
  }
  if let Some(x) = v.resources_included {
    fs.push(("resourcesIncluded", json_of_resources(x)))
  }
  if let Some(x) = v.attributes {
    fs.push(("attributes", json_of_evidence_attributes(x)))
  }
  if let Some(x) = v.iam_id {
    fs.push(("iamId", json.Value.Str(x)))
  }
  if let Some(x) = v.compliance_check {
    fs.push(("complianceCheck", json.Value.Str(x)))
  }
  if let Some(x) = v.aws_organization {
    fs.push(("awsOrganization", json.Value.Str(x)))
  }
  if let Some(x) = v.aws_account_id {
    fs.push(("awsAccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.evidence_folder_id {
    fs.push(("evidenceFolderId", json.Value.Str(x)))
  }
  if let Some(x) = v.id {
    fs.push(("id", json.Value.Str(x)))
  }
  if let Some(x) = v.assessment_report_selection {
    fs.push(("assessmentReportSelection", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_evidence(v: json.Value) -> Evidence ! Str {
  var out = Evidence{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "dataSource" => out.data_source = jsonv.read_str(fv)?
      "evidenceAwsAccountId" => out.evidence_aws_account_id = jsonv.read_str(fv)?
      "time" => out.time = jsonv.read_time(fv, "epoch-seconds")?
      "eventSource" => out.event_source = jsonv.read_str(fv)?
      "eventName" => out.event_name = jsonv.read_str(fv)?
      "evidenceByType" => out.evidence_by_type = jsonv.read_str(fv)?
