/// Calls DescribeAlarms until the AlarmExists acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (5s) to `max_delay` (120s).
pub fn wait_until_alarm_exists(c: Client, input: DescribeAlarmsInput, max_wait: Duration, min_delay: Duration = 5s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeAlarmsErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match (c with {transport: transport.with_feature(c.transport, "B")}).describe_alarms(input) {
      Ok(out) => {
        let o = jmes_of_describe_alarms_output(out)
        if state == "" && waiter.path_matches(o, "length(MetricAlarms[]) > `0`", "booleanEquals", "true") {
          state = "success"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("AlarmExists: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

