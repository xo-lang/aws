    StatementProperties(x) => json.Value.Object([("StatementProperties", json_of_statement_properties(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_metadata_model_properties(v: json.Value) -> MetadataModelProperties ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "StatementProperties" => Ok(MetadataModelProperties.StatementProperties(from_json_statement_properties(fv)?))
      _ => Ok(MetadataModelProperties.Unknown(k))
    }
  }
  Err("MetadataModelProperties: no member set")
}

