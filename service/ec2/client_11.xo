    query_put_service_type_detail_set(f, query.key(prefix, "ServiceType"), x, false)
  }
  if let Some(x) = v.service_id {
    query.add(f, query.key(prefix, "ServiceId"), x)
  }
  if let Some(x) = v.service_name {
    query.add(f, query.key(prefix, "ServiceName"), x)
  }
  if let Some(x) = v.service_state {
    query.add(f, query.key(prefix, "ServiceState"), x.value())
  }
  if let Some(x) = v.availability_zone_ids {
    query_put_value_string_list(f, query.key(prefix, "AvailabilityZoneIdSet"), x, false)
  }
  if let Some(x) = v.availability_zones {
    query_put_value_string_list(f, query.key(prefix, "AvailabilityZoneSet"), x, false)
  }
  if let Some(x) = v.acceptance_required {
    query.add(f, query.key(prefix, "AcceptanceRequired"), "${x}")
  }
  if let Some(x) = v.manages_vpc_endpoints {
    query.add(f, query.key(prefix, "ManagesVpcEndpoints"), "${x}")
  }
  if let Some(x) = v.network_load_balancer_arns {
    query_put_value_string_list(f, query.key(prefix, "NetworkLoadBalancerArnSet"), x, false)
  }
  if let Some(x) = v.gateway_load_balancer_arns {
    query_put_value_string_list(f, query.key(prefix, "GatewayLoadBalancerArnSet"), x, false)
  }
  if let Some(x) = v.supported_ip_address_types {
    query_put_supported_ip_address_types(f, query.key(prefix, "SupportedIpAddressTypeSet"), x, false)
  }
  if let Some(x) = v.base_endpoint_dns_names {
    query_put_value_string_list(f, query.key(prefix, "BaseEndpointDnsNameSet"), x, false)
  }
  if let Some(x) = v.private_dns_name {
    query.add(f, query.key(prefix, "PrivateDnsName"), x)
  }
  if let Some(x) = v.private_dns_name_configuration {
    query_put_private_dns_name_configuration(f, query.key(prefix, "PrivateDnsNameConfiguration"), x)
  }
  if let Some(x) = v.payer_responsibility {
    query.add(f, query.key(prefix, "PayerResponsibility"), x.value())
  }
  if let Some(x) = v.tags {
    query_put_tag_list(f, query.key(prefix, "TagSet"), x, false)
  }
  if let Some(x) = v.supported_regions {
    query_put_supported_region_set(f, query.key(prefix, "SupportedRegionSet"), x, false)
  }
  if let Some(x) = v.remote_access_enabled {
    query.add(f, query.key(prefix, "RemoteAccessEnabled"), "${x}")
  }
}

fn query_put_service_configuration_set(var f: query.Form, prefix: Str, v: List[ServiceConfiguration], flat: Bool) {
  let _ = flat
  for (i, x) in v.indexed() {
    let k = "${prefix}.${i + 1}"
    query_put_service_configuration(f, k, x)
  }
}

