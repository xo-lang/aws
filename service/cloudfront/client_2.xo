fn xml_write_trust_store(var w: xmlv.Writer, v: TrustStore, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.id {
    xmlv.elem(w, "Id", x, [])
  }
  if let Some(x) = v.arn {
    xmlv.elem(w, "Arn", x, [])
  }
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.number_of_ca_certificates {
    xmlv.elem(w, "NumberOfCaCertificates", "${x}", [])
  }
  if let Some(x) = v.last_modified_time {
    xmlv.elem(w, "LastModifiedTime", rest.date_time(x), [])
  }
  if let Some(x) = v.reason {
    xmlv.elem(w, "Reason", x, [])
  }
  if let Some(x) = v.use_client_certificate_ocsp_endpoint {
    xmlv.elem(w, "UseClientCertificateOCSPEndpoint", "${x}", [])
  }
  xmlv.end(w, name)
}

