  var req = serialize_search_public_records(ep, input, "") ?? e => return Err(SearchPublicRecordsErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(SearchPublicRecordsErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_search_public_records_error(resp))
  }
  deserialize_search_public_records(resp) ?? e => Err(SearchPublicRecordsErr.Deserialize(e))
}
