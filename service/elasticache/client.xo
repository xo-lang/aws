fn xml_write_node_group_member_update_status(var w: xmlv.Writer, v: NodeGroupMemberUpdateStatus, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.cache_cluster_id {
