fn json_of_issue_artifact_body(v: IssueArtifactBody) -> json.Value {
  match v {
    ValidationEvidence(x) => json.Value.Object([("validationEvidence", json_of_validation_evidence_body(x))])
    PrevalidationSignals(x) => json.Value.Object([("prevalidationSignals", json_of_prevalidation_signals_body(x))])
    RemediationProposal(x) => json.Value.Object([("remediationProposal", json_of_remediation_proposal_body(x))])
    Patch(x) => json.Value.Object([("patch", json_of_patch_body(x))])
    Raw(x) => json.Value.Object([("raw", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_issue_artifact_body(v: json.Value) -> IssueArtifactBody ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "validationEvidence" => Ok(IssueArtifactBody.ValidationEvidence(from_json_validation_evidence_body(fv)?))
      "prevalidationSignals" => Ok(IssueArtifactBody.PrevalidationSignals(from_json_prevalidation_signals_body(fv)?))
      "remediationProposal" => Ok(IssueArtifactBody.RemediationProposal(from_json_remediation_proposal_body(fv)?))
      "patch" => Ok(IssueArtifactBody.Patch(from_json_patch_body(fv)?))
      "raw" => Ok(IssueArtifactBody.Raw(jsonv.read_str(fv)?))
      _ => Ok(IssueArtifactBody.Unknown(k))
    }
  }
  Err("IssueArtifactBody: no member set")
}

