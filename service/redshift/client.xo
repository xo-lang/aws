  }
  if let Some(x) = v.deferred_maintenance_windows {
    xml_write_deferred_maintenance_windows_list(w, x, "DeferredMaintenanceWindows", [])
  }
  if let Some(x) = v.snapshot_schedule_identifier {
    xmlv.elem(w, "SnapshotScheduleIdentifier", x, [])
  }
  if let Some(x) = v.snapshot_schedule_state {
    xmlv.elem(w, "SnapshotScheduleState", x.value(), [])
  }
  if let Some(x) = v.expected_next_snapshot_schedule_time {
    xmlv.elem(w, "ExpectedNextSnapshotScheduleTime", rest.date_time(x), [])
  }
  if let Some(x) = v.expected_next_snapshot_schedule_time_status {
    xmlv.elem(w, "ExpectedNextSnapshotScheduleTimeStatus", x, [])
  }
  if let Some(x) = v.next_maintenance_window_start_time {
    xmlv.elem(w, "NextMaintenanceWindowStartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.resize_info {
    xml_write_resize_info(w, x, "ResizeInfo", [])
  }
  if let Some(x) = v.availability_zone_relocation_status {
    xmlv.elem(w, "AvailabilityZoneRelocationStatus", x, [])
  }
  if let Some(x) = v.cluster_namespace_arn {
    xmlv.elem(w, "ClusterNamespaceArn", x, [])
  }
  if let Some(x) = v.total_storage_capacity_in_mega_bytes {
    xmlv.elem(w, "TotalStorageCapacityInMegaBytes", "${x}", [])
  }
  if let Some(x) = v.aqua_configuration {
    xml_write_aqua_configuration(w, x, "AquaConfiguration", [])
  }
  if let Some(x) = v.default_iam_role_arn {
    xmlv.elem(w, "DefaultIamRoleArn", x, [])
  }
  if let Some(x) = v.reserved_node_exchange_status {
    xml_write_reserved_node_exchange_status(w, x, "ReservedNodeExchangeStatus", [])
  }
