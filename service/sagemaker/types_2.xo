/// value you specify for the Type parameter. If you want to define a custom
/// objective metric, see Define metrics and environment variables .
pub struct HyperParameterTuningJobObjective {
  /// Whether to minimize or maximize the objective metric.
  pub type_value: HyperParameterTuningJobObjectiveType? = None
  /// The name of the metric to use for the objective metric.
  pub metric_name: Str? = None
}

pub enum HyperParameterTuningJobObjectiveType: Str {
