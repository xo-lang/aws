}

/// The scheduler configuration for a virtual cluster on Amazon EMR on EKS.
/// It controls how many job runs can run concurrently and how many can wait
/// in the queue. When not set, no concurrency or queue limits are applied.
pub struct SchedulerConfiguration {
  /// The maximum number of job runs that can be in the PENDING or SUBMITTED
  /// state at any time for the virtual cluster. When the queue is full, the
  /// service rejects StartJobRun requests with a ValidationException . If you
  /// omit this field, the service applies no queue-depth limit.
  pub max_in_queue_job_runs: Int? = None
  /// The maximum number of job runs that can be in the RUNNING state at any
  /// time for the virtual cluster. As running slots free up, queued job runs
  /// start automatically. If you omit this field, the service applies no
  /// concurrency limit.
  pub max_concurrent_job_runs: Int? = None
}

/// The current job-run counts for a virtual cluster, reflecting how much of
/// the configured scheduler capacity is in use.
pub struct SchedulerStatus {
  /// The number of job runs currently waiting in the queue ( PENDING or
  /// SUBMITTED ) for the virtual cluster.
  pub current_in_queue_job_runs: Int? = None
  /// The number of job runs currently in the RUNNING state for the virtual
  /// cluster.
  pub current_concurrent_job_runs: Int? = None
}

