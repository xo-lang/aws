      "scope" => out.scope = Scope.from(c.text())
      "availabilityZoneId" => out.availability_zone_id = c.text()
      "reservedInstancesOfferingId" => out.reserved_instances_offering_id = c.text()
      "instanceType" => out.instance_type = InstanceType.from(c.text())
      "availabilityZone" => out.availability_zone = c.text()
      "duration" => out.duration = xmlv.read_int(c.text())?
      "usagePrice" => out.usage_price = xmlv.read_float(c.text())?
      "fixedPrice" => out.fixed_price = xmlv.read_float(c.text())?
      "productDescription" => out.product_description = RIProductDescription.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

