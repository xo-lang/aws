  match v {
    ColumnConfiguration(x) => json.Value.Object([("columnConfiguration", json_of_column_filter_configuration(x))])
    RowConfiguration(x) => json.Value.Object([("rowConfiguration", json_of_row_filter_configuration(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_asset_filter_configuration(v: json.Value) -> AssetFilterConfiguration ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "columnConfiguration" => Ok(AssetFilterConfiguration.ColumnConfiguration(from_json_column_filter_configuration(fv)?))
      "rowConfiguration" => Ok(AssetFilterConfiguration.RowConfiguration(from_json_row_filter_configuration(fv)?))
      _ => Ok(AssetFilterConfiguration.Unknown(k))
    }
  }
  Err("AssetFilterConfiguration: no member set")
}

