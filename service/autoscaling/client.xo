fn xml_write_launch_configuration(var w: xmlv.Writer, v: LaunchConfiguration, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.launch_configuration_name {
    xmlv.elem(w, "LaunchConfigurationName", x, [])
  }
  if let Some(x) = v.launch_configuration_arn {
    xmlv.elem(w, "LaunchConfigurationARN", x, [])
  }
  if let Some(x) = v.image_id {
    xmlv.elem(w, "ImageId", x, [])
  }
  if let Some(x) = v.key_name {
    xmlv.elem(w, "KeyName", x, [])
  }
  if let Some(x) = v.security_groups {
    xml_write_security_groups(w, x, "SecurityGroups", [])
  }
  if let Some(x) = v.classic_link_vpc_id {
    xmlv.elem(w, "ClassicLinkVPCId", x, [])
  }
  if let Some(x) = v.classic_link_vpc_security_groups {
    xml_write_classic_link_vpc_security_groups(w, x, "ClassicLinkVPCSecurityGroups", [])
  }
  if let Some(x) = v.user_data {
    xmlv.elem(w, "UserData", x, [])
  }
  if let Some(x) = v.instance_type {
    xmlv.elem(w, "InstanceType", x, [])
  }
  if let Some(x) = v.kernel_id {
    xmlv.elem(w, "KernelId", x, [])
  }
  if let Some(x) = v.ramdisk_id {
    xmlv.elem(w, "RamdiskId", x, [])
  }
  if let Some(x) = v.block_device_mappings {
    xml_write_block_device_mappings(w, x, "BlockDeviceMappings", [])
  }
  if let Some(x) = v.instance_monitoring {
    xml_write_instance_monitoring(w, x, "InstanceMonitoring", [])
  }
  if let Some(x) = v.spot_price {
    xmlv.elem(w, "SpotPrice", x, [])
  }
  if let Some(x) = v.iam_instance_profile {
    xmlv.elem(w, "IamInstanceProfile", x, [])
  }
  if let Some(x) = v.created_time {
    xmlv.elem(w, "CreatedTime", rest.date_time(x), [])
  }
  if let Some(x) = v.ebs_optimized {
    xmlv.elem(w, "EbsOptimized", "${x}", [])
  }
  if let Some(x) = v.associate_public_ip_address {
    xmlv.elem(w, "AssociatePublicIpAddress", "${x}", [])
  }
  if let Some(x) = v.placement_tenancy {
    xmlv.elem(w, "PlacementTenancy", x, [])
  }
  if let Some(x) = v.metadata_options {
    xml_write_instance_metadata_options(w, x, "MetadataOptions", [])
  }
  xmlv.end(w, name)
}

fn xml_read_launch_configuration(e: xml.Element) -> LaunchConfiguration ! Str {
  var out = LaunchConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "LaunchConfigurationName" => out.launch_configuration_name = c.text()
      "LaunchConfigurationARN" => out.launch_configuration_arn = c.text()
      "ImageId" => out.image_id = c.text()
      "KeyName" => out.key_name = c.text()
      "SecurityGroups" => out.security_groups = xml_read_security_groups(c)?
      "ClassicLinkVPCId" => out.classic_link_vpc_id = c.text()
      "ClassicLinkVPCSecurityGroups" => out.classic_link_vpc_security_groups = xml_read_classic_link_vpc_security_groups(c)?
      "UserData" => out.user_data = c.text()
      "InstanceType" => out.instance_type = c.text()
      "KernelId" => out.kernel_id = c.text()
      "RamdiskId" => out.ramdisk_id = c.text()
      "BlockDeviceMappings" => out.block_device_mappings = xml_read_block_device_mappings(c)?
      "InstanceMonitoring" => out.instance_monitoring = xml_read_instance_monitoring(c)?
      "SpotPrice" => out.spot_price = c.text()
      "IamInstanceProfile" => out.iam_instance_profile = c.text()
      "CreatedTime" => out.created_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EbsOptimized" => out.ebs_optimized = xmlv.read_bool(c.text())?
      "AssociatePublicIpAddress" => out.associate_public_ip_address = xmlv.read_bool(c.text())?
      "PlacementTenancy" => out.placement_tenancy = c.text()
      "MetadataOptions" => out.metadata_options = xml_read_instance_metadata_options(c)?
      _ => {}
    }
  }
  Ok(out)
}

