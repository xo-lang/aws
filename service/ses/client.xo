fn read_error_account_sending_paused_exception(resp: http.Response, body: xml.Element) -> AccountSendingPausedException ! Str {
  let _ = (resp, body)
  var out = AccountSendingPausedException{}
  for c in xmlv.elements(body) {
    match c.name.local.to_lower() {
      "message" => out.message = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn read_error_already_exists_exception(resp: http.Response, body: xml.Element) -> AlreadyExistsException ! Str {
  let _ = (resp, body)
  var out = AlreadyExistsException{}
  for c in xmlv.elements(body) {
    match c.name.local.to_lower() {
      "name" => out.name = c.text()
