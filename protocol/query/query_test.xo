use std/http
use github.com/xo-lang/aws
use github.com/xo-lang/aws/retry

test "form encoding" {
  var f = form("AssumeRole", "2011-06-15")
  add(f, "RoleArn", "arn:aws:iam::123456789012:role/Demo")
  add(f, "RoleSessionName", "a b+c/d")
  expect(encode(f)) == "Action=AssumeRole&Version=2011-06-15&RoleArn=arn%3Aaws%3Aiam%3A%3A123456789012%3Arole%2FDemo&RoleSessionName=a%20b%2Bc%2Fd"
}

const ERROR_BODY: Str = r"""<ErrorResponse xmlns="https://sts.amazonaws.com/doc/2011-06-15/">
  <Error>
    <Type>Sender</Type>
    <Code>AccessDenied</Code>
    <Message>Not authorized</Message>
  </Error>
  <RequestId>example-request-id-0</RequestId>
</ErrorResponse>"""

test "error responses" {
  let e = read_error(http.text(403, ERROR_BODY))
  expect(e.code) == "AccessDenied"
  expect(e.message) == "Not authorized"
  expect(e.fault) == aws.Fault.Client
  expect(e.request_id) == "example-request-id-0"
  expect(e.status) == 403
  let throttled = http.text(400, ERROR_BODY.replace("AccessDenied", "Throttling"))
  expect(classify(throttled)) == retry.Failure.Throttle
  expect(classify(http.text(403, ERROR_BODY))) == retry.Failure.Permanent
  expect(read_error(http.text(502, "<html>bad gateway</html>")).code) == "UnknownError"
}

test "result element" {
  let body = "<GetCallerIdentityResponse><GetCallerIdentityResult><Account>123456789012</Account></GetCallerIdentityResult></GetCallerIdentityResponse>"
  let r = read_result(http.text(200, body), "GetCallerIdentity")?
  expect(child_text(r, "Account")) == "123456789012"
  expect(read_result(http.text(403, ERROR_BODY), "GetCallerIdentity") is Err(ReadErr.Api(_))) == true
}

test "key" {
  expect(key("", "Foo")) == "Foo"
  expect(key("Foo.member.1", "Bar")) == "Foo.member.1.Bar"
}

test "result_of" {
  let r = result_of(b"<FooResponse><FooResult><A>x</A></FooResult></FooResponse>", "Foo")?
  expect(child_text(r, "A")) == "x"
  let e = result_of(b"", "Foo")?
  expect(e.children.len()) == 0
}

test "a repeated request ID header is its first field, as Go's Header.Get" {
  let e = read_error(http.text(500, "not xml").add_header("X-Amzn-RequestId", "rid-1").add_header("X-Amzn-RequestId", "rid-2"))
  expect(e.request_id) == "rid-1"
}
