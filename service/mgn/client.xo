fn json_of_ssm_external_parameter(v: SsmExternalParameter) -> json.Value {
  match v {
    DynamicPath(x) => json.Value.Object([("dynamicPath", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_ssm_external_parameter(v: json.Value) -> SsmExternalParameter ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "dynamicPath" => Ok(SsmExternalParameter.DynamicPath(jsonv.read_str(fv)?))
      _ => Ok(SsmExternalParameter.Unknown(k))
    }
  }
  Err("SsmExternalParameter: no member set")
}

