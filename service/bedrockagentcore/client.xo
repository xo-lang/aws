fn json_of_filter_value(v: FilterValue) -> json.Value {
  match v {
    StringValue(x) => json.Value.Object([("stringValue", json.Value.Str(x))])
    DoubleValue(x) => json.Value.Object([("doubleValue", jsonv.float(x))])
    BooleanValue(x) => json.Value.Object([("booleanValue", json.Value.Bool(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_filter_value(v: json.Value) -> FilterValue ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "stringValue" => Ok(FilterValue.StringValue(jsonv.read_str(fv)?))
      "doubleValue" => Ok(FilterValue.DoubleValue(jsonv.read_float(fv)?))
      "booleanValue" => Ok(FilterValue.BooleanValue(jsonv.read_bool(fv)?))
      _ => Ok(FilterValue.Unknown(k))
    }
  }
  Err("FilterValue: no member set")
}

