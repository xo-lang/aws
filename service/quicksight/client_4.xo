fn json_of_physical_table(v: PhysicalTable) -> json.Value {
  match v {
    RelationalTable(x) => json.Value.Object([("RelationalTable", json_of_relational_table(x))])
    CustomSql(x) => json.Value.Object([("CustomSql", json_of_custom_sql(x))])
    S3Source(x) => json.Value.Object([("S3Source", json_of_s3_source(x))])
    SaaSTable(x) => json.Value.Object([("SaaSTable", json_of_saa_s_table(x))])
    FileSource(x) => json.Value.Object([("FileSource", json_of_file_source(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_physical_table(v: json.Value) -> PhysicalTable ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "RelationalTable" => Ok(PhysicalTable.RelationalTable(from_json_relational_table(fv)?))
      "CustomSql" => Ok(PhysicalTable.CustomSql(from_json_custom_sql(fv)?))
      "S3Source" => Ok(PhysicalTable.S3Source(from_json_s3_source(fv)?))
      "SaaSTable" => Ok(PhysicalTable.SaaSTable(from_json_saa_s_table(fv)?))
      "FileSource" => Ok(PhysicalTable.FileSource(from_json_file_source(fv)?))
      _ => Ok(PhysicalTable.Unknown(k))
    }
  }
  Err("PhysicalTable: no member set")
}

fn json_of_physical_table_map(v: Map[Str, PhysicalTable]) -> json.Value {
  json.Value.Object(v.entries().map(fn(e: (Str, PhysicalTable)) -> (Str, json.Value) { (e.0, json_of_physical_table(e.1)) }))
}

fn from_json_physical_table_map(v: json.Value) -> Map[Str, PhysicalTable] ! Str {
  var out: Map[Str, PhysicalTable] = {}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      // a dense map skips nulls
      continue
    }
    out.put(k, from_json_physical_table(fv)?)
  }
  Ok(out)
}

