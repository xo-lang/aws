      "MinSize" => out.min_size = xmlv.read_int(c.text())?
      "MaxSize" => out.max_size = xmlv.read_int(c.text())?
      "DesiredCapacity" => out.desired_capacity = xmlv.read_int(c.text())?
      "DefaultCooldown" => out.default_cooldown = xmlv.read_int(c.text())?
      "AvailabilityZones" => out.availability_zones = xml_read_availability_zones(c)?
      "AvailabilityZoneIds" => out.availability_zone_ids = xml_read_availability_zone_ids(c)?
      "HealthCheckType" => out.health_check_type = c.text()
      "HealthCheckGracePeriod" => out.health_check_grace_period = xmlv.read_int(c.text())?
      "PlacementGroup" => out.placement_group = c.text()
      "VPCZoneIdentifier" => out.vpc_zone_identifier = c.text()
      "TerminationPolicies" => out.termination_policies = xml_read_termination_policies(c)?
      "NewInstancesProtectedFromScaleIn" => out.new_instances_protected_from_scale_in = xmlv.read_bool(c.text())?
      "ServiceLinkedRoleARN" => out.service_linked_role_arn = c.text()
      "MaxInstanceLifetime" => out.max_instance_lifetime = xmlv.read_int(c.text())?
      "CapacityRebalance" => out.capacity_rebalance = xmlv.read_bool(c.text())?
      "Context" => out.context = c.text()
      "DesiredCapacityType" => out.desired_capacity_type = c.text()
      "DefaultInstanceWarmup" => out.default_instance_warmup = xmlv.read_int(c.text())?
      "InstanceMaintenancePolicy" => out.instance_maintenance_policy = xml_read_instance_maintenance_policy(c)?
      "AvailabilityZoneDistribution" => out.availability_zone_distribution = xml_read_availability_zone_distribution(c)?
      "AvailabilityZoneImpairmentPolicy" => out.availability_zone_impairment_policy = xml_read_availability_zone_impairment_policy(c)?
      "SkipZonalShiftValidation" => out.skip_zonal_shift_validation = xmlv.read_bool(c.text())?
      "CapacityReservationSpecification" => out.capacity_reservation_specification = xml_read_capacity_reservation_specification(c)?
      "InstanceLifecyclePolicy" => out.instance_lifecycle_policy = xml_read_instance_lifecycle_policy(c)?
      "DeletionProtection" => out.deletion_protection = DeletionProtection.from(c.text())
      _ => {}
