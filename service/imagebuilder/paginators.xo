pub struct ListWorkflowsPaginator {
  client: Client
  input: ListWorkflowsRequest
  first: Bool = true
  more: Bool = true
}

pub fn new_list_workflows_paginator(c: Client, input: ListWorkflowsRequest) -> ListWorkflowsPaginator {
  ListWorkflowsPaginator{client: c with {transport: transport.with_feature(c.transport, "C")}, input: input}
}

/// Whether `next_page` has a page to fetch: before the first page, or
/// while the last page carried a new token.
pub fn (p: ListWorkflowsPaginator) has_more_pages() -> Bool {
  p.first || p.more
}

pub fn (var p: ListWorkflowsPaginator) next_page() -> ListWorkflowsResponse ! ListWorkflowsErr uses (net.dial, clock, rand) {
  let prev = p.input.next_token
  let out = p.client.list_workflows(p.input)?
  p.first = false
  var next: Str? = None
  next = out.next_token
  p.more = match next {
    Some(t) => t != "" && Some(t) != prev
    None => false
  }
  p.input.next_token = next
  Ok(out)
}
