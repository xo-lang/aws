  if let Some(x) = v.arn {
    fs.push(("Arn", json.Value.Str(x)))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.theme_id {
    fs.push(("ThemeId", json.Value.Str(x)))
  }
  if let Some(x) = v.latest_version_number {
    fs.push(("LatestVersionNumber", json.Value.Int(x)))
  }
  if let Some(x) = v.created_time {
    fs.push(("CreatedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_updated_time {
    fs.push(("LastUpdatedTime", jsonv.time(x, "epoch-seconds")))
  }
  json.Value.Object(fs)
}

fn from_json_theme_summary(v: json.Value) -> ThemeSummary ! Str {
  var out = ThemeSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "Arn" => out.arn = jsonv.read_str(fv)?
      "Name" => out.name = jsonv.read_str(fv)?
      "ThemeId" => out.theme_id = jsonv.read_str(fv)?
      "LatestVersionNumber" => out.latest_version_number = jsonv.read_int(fv)?
      "CreatedTime" => out.created_time = jsonv.read_time(fv, "epoch-seconds")?
      "LastUpdatedTime" => out.last_updated_time = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_theme_summary_list(v: List[ThemeSummary]) -> json.Value {
  json.Value.List(v.map(fn(x: ThemeSummary) -> json.Value { json_of_theme_summary(x) }))
}

fn from_json_theme_summary_list(v: json.Value) -> List[ThemeSummary] ! Str {
  var out: List[ThemeSummary] = []
  for fv in jsonv.items(v)? {
    if fv == json.Value.Null {
      // a dense list skips nulls
      continue
    }
    out.push(from_json_theme_summary(fv)?)
  }
  Ok(out)
}

