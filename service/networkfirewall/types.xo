  /// protocols. If you want non-matching fragmented UDP packets to be
  /// forwarded for stateful inspection, specify aws:forward_to_sfe . You must
  /// specify one of the standard actions: aws:pass , aws:drop , or
  /// aws:forward_to_sfe . In addition, you can specify custom actions that
  /// are compatible with your standard section choice. For example, you could
  /// specify ["aws:pass"] or you could specify ["aws:pass",
  /// “customActionName”] . For information about compatibility, see the
  /// custom action descriptions under CustomAction .
  pub stateless_fragment_default_actions: List[Str]? = None
  /// The custom action definitions that are available for use in the firewall
  /// policy's StatelessDefaultActions setting. You name each custom action
  /// that you define, and then you can use it by name in your default actions
  /// specifications.
  pub stateless_custom_actions: List[CustomAction]? = None
  /// References to the stateful rule groups that are used in the policy.
  /// These define the inspection criteria in stateful rules.
  pub stateful_rule_group_references: List[StatefulRuleGroupReference]? = None
  /// The default actions to take on a packet that doesn't match any stateful
  /// rules. The stateful default action is optional, and is only valid when
  /// using the strict rule order. Valid values of the stateful default
  /// action: aws:drop_strict aws:drop_established aws:alert_strict
  /// aws:alert_established aws:drop_established_app_layer
  /// aws:alert_established_app_layer aws:drop_established_app_layer_to_server
  /// aws:alert_established_app_layer_to_server For more information, see
  /// Strict evaluation order in the Network Firewall Developer Guide .
  pub stateful_default_actions: List[Str]? = None
  /// Additional options governing how Network Firewall handles stateful
  /// rules. The stateful rule groups that you use in your policy must have
  /// stateful rule options settings that are compatible with these settings.
  pub stateful_engine_options: StatefulEngineOptions? = None
  /// The Amazon Resource Name (ARN) of the TLS inspection configuration.
  pub tls_inspection_configuration_arn: Str? = None
  /// Contains variables that you can use to override default Suricata
  /// settings in your firewall policy.
  pub policy_variables: PolicyVariables? = None
  /// When true, prevents TCP and TLS packets from reaching destination
  /// servers until TLS Inspection has evaluated Server Name Indication (SNI)
  /// rules. Requires an associated TLS Inspection configuration.
  pub enable_tls_session_holding: Bool? = None
  /// The settings that enable resolved IP validation for the policy. Resolved
  /// IP validation verifies that a connection's destination IP address is one
  /// that the Amazon Route 53 Resolver returned in a DNS response for a
  /// domain. A VPC that's associated with the Route 53 Resolver DNS Firewall
  /// rule group that you specify must send the response. This checks how the
  /// destination IP address was obtained, instead of relying only on the
  /// domain that the client asserts in its TLS Server Name Indication (SNI)
  /// or HTTP Host header. For more information, see
  /// Route53ResolvedIPValidation .
  pub route53_resolved_ip_validation: Route53ResolvedIPValidation? = None
}

/// A configuration error that Network Firewall detected for a firewall
/// policy.
pub struct FirewallPolicyError {
  /// The error code identifies the type of error. Valid values are the
  /// following: DNS_FIREWALL_RULE_GROUP_UNAVAILABLE – The Amazon Route 53
  /// Resolver DNS Firewall rule group that resolved IP validation references
  /// is unavailable, for example, because it was deleted or is no longer
  /// accessible from your account. Update the rule group ID or remove the
  /// resolved IP validation configuration.
  /// ROUTE53_RESOLVED_IP_VALIDATION_MISSING – An associated stateful rule
  /// group uses the aws_route_53_resolved_domain keyword, but the policy
  /// doesn't have resolved IP validation configured. The affected rules are
  /// inactive until you add resolved IP validation to the policy or remove
  /// the keyword rules.
  pub code: FirewallPolicyErrorCode? = None
  /// A description of the error and how to resolve it.
  pub message: Str? = None
  /// The ID of the resource that the error relates to, when applicable. For
  /// example, for DNS_FIREWALL_RULE_GROUP_UNAVAILABLE this is the Amazon
  /// Route 53 Resolver DNS Firewall rule group ID.
  pub resource_id: Str? = None
}

pub enum FirewallPolicyErrorCode: Str {
  DnsFirewallRuleGroupUnavailable = "DNS_FIREWALL_RULE_GROUP_UNAVAILABLE"
  Route53ResolvedIpValidationMissing = "ROUTE53_RESOLVED_IP_VALIDATION_MISSING"
  Unknown(value: Str)
}

/// High-level information about a firewall policy, returned by operations
