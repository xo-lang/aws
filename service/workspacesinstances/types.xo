/// The volume has a previous modification that is still in progress, or has
/// reached the limit of four modifications in a rolling 24-hour period.
/// Wait for the current modification to finish, or wait until the time
/// indicated in the error message, and then retry the request.
pub struct VolumeModificationRateExceededException {
  /// Specifies the reason that the modification request was rejected.
  pub message: Str? = None
  /// Specifies the identifier of the volume for which the modification
  /// request was rejected.
  pub resource_id: Str? = None
  /// Specifies the type of the resource for which the modification request
  /// was rejected.
  pub resource_type: Str? = None
}

