pub struct ModelPackageValidationProfile {
  /// The name of the profile for the model package.
  pub profile_name: Str? = None
  /// The TransformJobDefinition object that describes the transform job used
  /// for the validation of the model package.
  pub transform_job_definition: TransformJobDefinition? = None
}

/// Specifies batch transform jobs that SageMaker runs to validate your
