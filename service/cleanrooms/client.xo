fn json_of_change_specification(v: ChangeSpecification) -> json.Value {
  match v {
    Member(x) => json.Value.Object([("member", json_of_member_change_specification(x))])
    Collaboration(x) => json.Value.Object([("collaboration", json_of_collaboration_change_specification(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_change_specification(v: json.Value) -> ChangeSpecification ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "member" => Ok(ChangeSpecification.Member(from_json_member_change_specification(fv)?))
      "collaboration" => Ok(ChangeSpecification.Collaboration(from_json_collaboration_change_specification(fv)?))
      _ => Ok(ChangeSpecification.Unknown(k))
    }
  }
  Err("ChangeSpecification: no member set")
}

