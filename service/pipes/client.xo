fn json_of_self_managed_kafka_access_configuration_credentials(v: SelfManagedKafkaAccessConfigurationCredentials) -> json.Value {
  match v {
    BasicAuth(x) => json.Value.Object([("BasicAuth", json.Value.Str(x))])
    SaslScram512Auth(x) => json.Value.Object([("SaslScram512Auth", json.Value.Str(x))])
    SaslScram256Auth(x) => json.Value.Object([("SaslScram256Auth", json.Value.Str(x))])
    ClientCertificateTlsAuth(x) => json.Value.Object([("ClientCertificateTlsAuth", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_self_managed_kafka_access_configuration_credentials(v: json.Value) -> SelfManagedKafkaAccessConfigurationCredentials ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "BasicAuth" => Ok(SelfManagedKafkaAccessConfigurationCredentials.BasicAuth(jsonv.read_str(fv)?))
      "SaslScram512Auth" => Ok(SelfManagedKafkaAccessConfigurationCredentials.SaslScram512Auth(jsonv.read_str(fv)?))
      "SaslScram256Auth" => Ok(SelfManagedKafkaAccessConfigurationCredentials.SaslScram256Auth(jsonv.read_str(fv)?))
      "ClientCertificateTlsAuth" => Ok(SelfManagedKafkaAccessConfigurationCredentials.ClientCertificateTlsAuth(jsonv.read_str(fv)?))
      _ => Ok(SelfManagedKafkaAccessConfigurationCredentials.Unknown(k))
    }
  }
  Err("SelfManagedKafkaAccessConfigurationCredentials: no member set")
}

