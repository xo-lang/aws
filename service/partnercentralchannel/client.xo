fn json_of_support_plan(v: SupportPlan) -> json.Value {
  match v {
    ResoldEnterprise(x) => json.Value.Object([("resoldEnterprise", json_of_resold_enterprise(x))])
    PartnerLedSupport(x) => json.Value.Object([("partnerLedSupport", json_of_partner_led_support(x))])
    ResoldUnifiedOperations(x) => json.Value.Object([("resoldUnifiedOperations", json_of_resold_unified_operations(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_support_plan(v: json.Value) -> SupportPlan ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "resoldEnterprise" => Ok(SupportPlan.ResoldEnterprise(from_json_resold_enterprise(fv)?))
      "partnerLedSupport" => Ok(SupportPlan.PartnerLedSupport(from_json_partner_led_support(fv)?))
      "resoldUnifiedOperations" => Ok(SupportPlan.ResoldUnifiedOperations(from_json_resold_unified_operations(fv)?))
      _ => Ok(SupportPlan.Unknown(k))
    }
  }
  Err("SupportPlan: no member set")
}

