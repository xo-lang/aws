/// Contains the details of a snapshot or cluster export to Amazon S3. This
/// data type is used as a response element in the DescribeExportTasks
/// operation.
pub struct ExportTask {
  /// A unique identifier for the snapshot or cluster export task. This ID
  /// isn't an identifier for the Amazon S3 bucket where the data is exported.
  pub export_task_identifier: Str? = None
  /// The Amazon Resource Name (ARN) of the snapshot or cluster exported to
  /// Amazon S3.
  pub source_arn: Str? = None
  /// The data exported from the snapshot or cluster. Valid Values: database -
  /// Export all the data from a specified database. database.table table-name
  /// - Export a table of the snapshot or cluster. This format is valid only
  /// for RDS for MySQL, RDS for MariaDB, and Aurora MySQL. database.schema
  /// schema-name - Export a database schema of the snapshot or cluster. This
  /// format is valid only for RDS for PostgreSQL and Aurora PostgreSQL.
  /// database.schema.table table-name - Export a table of the database
  /// schema. This format is valid only for RDS for PostgreSQL and Aurora
  /// PostgreSQL.
  pub export_only: List[Str]? = None
  /// The time when the snapshot was created.
  pub snapshot_time: Time? = None
  /// The time when the snapshot or cluster export task started.
  pub task_start_time: Time? = None
  /// The time when the snapshot or cluster export task ended.
  pub task_end_time: Time? = None
  /// The Amazon S3 bucket where the snapshot or cluster is exported to.
  pub s3_bucket: Str? = None
  /// The Amazon S3 bucket prefix that is the file name and path of the
  /// exported data.
  pub s3_prefix: Str? = None
  /// The name of the IAM role that is used to write to Amazon S3 when
  /// exporting a snapshot or cluster.
  pub iam_role_arn: Str? = None
  /// The key identifier of the Amazon Web Services KMS key that is used to
  /// encrypt the data when it's exported to Amazon S3. The KMS key identifier
  /// is its key ARN, key ID, alias ARN, or alias name. The IAM role used for
  /// the export must have encryption and decryption permissions to use this
  /// KMS key.
  pub kms_key_id: Str? = None
  /// The progress status of the export task. The status can be one of the
  /// following: CANCELED CANCELING COMPLETE FAILED IN_PROGRESS STARTING
  pub status: Str? = None
  /// The progress of the snapshot or cluster export task as a percentage.
  pub percent_progress: Int? = None
  /// The total amount of data exported, in gigabytes.
  pub total_extracted_data_in_gb: Int? = None
  /// The reason the export failed, if it failed.
  pub failure_cause: Str? = None
  /// A warning about the snapshot or cluster export task.
  pub warning_message: Str? = None
  /// The type of source for the export.
  pub source_type: ExportSourceType? = None
}

/// You can't start an export task that's already running.
pub struct ExportTaskAlreadyExistsFault {
  pub message: Str? = None
}

/// The export task doesn't exist.
pub struct ExportTaskNotFoundFault {
  pub message: Str? = None
}

