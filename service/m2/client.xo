fn json_of_get_application_response(v: GetApplicationResponse) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.name {
    fs.push(("name", json.Value.Str(x)))
  }
  if let Some(x) = v.description {
    fs.push(("description", json.Value.Str(x)))
  }
  if let Some(x) = v.application_id {
    fs.push(("applicationId", json.Value.Str(x)))
  }
  if let Some(x) = v.application_arn {
    fs.push(("applicationArn", json.Value.Str(x)))
  }
  if let Some(x) = v.status {
    fs.push(("status", json.Value.Str(x)))
  }
  if let Some(x) = v.latest_version {
    fs.push(("latestVersion", json_of_application_version_summary(x)))
  }
  if let Some(x) = v.deployed_version {
    fs.push(("deployedVersion", json_of_deployed_version_summary(x)))
  }
  if let Some(x) = v.engine_type {
    fs.push(("engineType", json.Value.Str(x)))
  }
  if let Some(x) = v.log_groups {
    fs.push(("logGroups", json_of_log_group_summaries(x)))
  }
  if let Some(x) = v.creation_time {
    fs.push(("creationTime", jsonv.time(x, "epoch-seconds")))
