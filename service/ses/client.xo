fn xml_write_receipt_action(var w: xmlv.Writer, v: ReceiptAction, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.s3_action {
    xml_write_s3_action(w, x, "S3Action", [])
  }
  if let Some(x) = v.bounce_action {
    xml_write_bounce_action(w, x, "BounceAction", [])
  }
  if let Some(x) = v.workmail_action {
    xml_write_workmail_action(w, x, "WorkmailAction", [])
  }
  if let Some(x) = v.lambda_action {
    xml_write_lambda_action(w, x, "LambdaAction", [])
  }
  if let Some(x) = v.stop_action {
    xml_write_stop_action(w, x, "StopAction", [])
  }
  if let Some(x) = v.add_header_action {
    xml_write_add_header_action(w, x, "AddHeaderAction", [])
  }
  if let Some(x) = v.sns_action {
    xml_write_sns_action(w, x, "SNSAction", [])
  }
  if let Some(x) = v.connect_action {
    xml_write_connect_action(w, x, "ConnectAction", [])
  }
  xmlv.end(w, name)
}

fn xml_read_receipt_action(e: xml.Element) -> ReceiptAction ! Str {
  var out = ReceiptAction{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "S3Action" => out.s3_action = xml_read_s3_action(c)?
      "BounceAction" => out.bounce_action = xml_read_bounce_action(c)?
      "WorkmailAction" => out.workmail_action = xml_read_workmail_action(c)?
      "LambdaAction" => out.lambda_action = xml_read_lambda_action(c)?
      "StopAction" => out.stop_action = xml_read_stop_action(c)?
      "AddHeaderAction" => out.add_header_action = xml_read_add_header_action(c)?
      "SNSAction" => out.sns_action = xml_read_sns_action(c)?
      "ConnectAction" => out.connect_action = xml_read_connect_action(c)?
      _ => {}
    }
  }
  Ok(out)
}

