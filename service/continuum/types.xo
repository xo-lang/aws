/// Write-only OAuth credentials used to authorize a GitHub.com integration.
/// Not stored or returned after creation.
pub struct GitHubAuthorizationConfiguration {
  /// The OAuth authorization code returned by GitHub after the user
  /// authorizes the application.
  pub authorization_code: Str? = None
  /// The `state` returned by GitHub in the OAuth callback. It must be the
  /// state that StartIntegrationAuthorization returned to the same AWS
  /// account, and the authorization request must have sent that call's
  /// codeChallenge. The state can be redeemed once. A stage that enforces
  /// authorization sessions rejects a missing, expired, already used, or
  /// other-account state with ValidationException; restart the authorization
  /// with StartIntegrationAuthorization.
  pub state: Str? = None
  /// The redirect URL used to obtain the authorization code. Must match one
  /// of the redirect URLs registered on the GitHub App. If omitted, the App's
  /// default redirect URL is used. Not stored or returned after creation.
  pub redirect_url: Str? = None
}

/// Configuration for a GitHub.com integration using the OAuth authorization
/// code flow.
pub struct GitHubConfiguration {
  /// OAuth authorization used to establish the integration. Required on
  /// create; not returned on read operations.
  pub authorization: GitHubAuthorizationConfiguration? = None
  /// The name of the GitHub organization to associate with the integration.
  /// If not specified, the integration is associated with the authenticated
  /// user's personal account.
  pub organization_name: Str? = None
}

/// Details for a GitHub.com integration.
pub struct GitHubDetails {
  /// The name of the GitHub organization associated with the integration.
  pub organization_name: Str? = None
}

/// The GitHub repository a patch is delivered to, and the pull request that
/// carries it once opened.
pub struct GitHubTarget {
  /// The GitHub user or organization that owns the repository.
  pub owner: Str? = None
  /// The repository name.
  pub repository: Str? = None
  /// Repository-scoped pull request number assigned by GitHub.
  pub pull_request_number: Int? = None
  /// The head commit SHA of the pull request. Absent until the pull request
  /// is opened.
  pub head_sha: Str? = None
}

/// Configuration for a GitLab integration using a pasted access token.
pub struct GitLabConfiguration {
  /// The HTTPS base URL of the GitLab instance (gitlab.com or self-managed).
  pub instance_url: Str? = None
  /// Whether the integration targets a group or a single project.
  pub target_type: GitLabTargetType? = None
  /// The group or project path the integration targets.
  pub target_path: Str? = None
  /// The GitLab access token (personal, group or project). Write-only; not
  /// stored or returned after creation. If the token carries the self-rotate
  /// scope, rotation is opted in and Continuum manages the token thereafter.
  pub access_token: Str? = None
}

/// Details for a GitLab integration.
pub struct GitLabDetails {
  /// The HTTPS base URL of the GitLab instance.
  pub instance_url: Str? = None
  /// Whether the integration targets a group or a single project.
  pub target_type: GitLabTargetType? = None
  /// The group or project path the integration targets.
  pub target_path: Str? = None
  /// How the integration's access token is rotated. AUTOMATIC only when the
  /// pasted token had the self-rotate scope and rotation was opted in at
  /// installation time.
  pub token_rotation: GitLabTokenRotation? = None
  /// The expiry of the stored access token, for non-rotating tokens only. A
  /// rotated token's original expiry is stale, so this is omitted when
  /// tokenRotation is AUTOMATIC.
  pub expires_at: Time? = None
}

/// Whether the GitLab integration targets an entire group or a single
/// project.
pub enum GitLabTargetType: Str {
  Group = "GROUP"
  Project = "PROJECT"
  Unknown(value: Str)
}

