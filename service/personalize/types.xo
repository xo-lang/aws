  /// The last update date and time (in Unix time) of the dataset.
  pub last_updated_date_time: Time? = None
}

/// Provides the name and default range of a categorical hyperparameter and
/// whether the hyperparameter is tunable. A tunable hyperparameter can have
/// its value determined during hyperparameter optimization (HPO).
pub struct DefaultCategoricalHyperParameterRange {
  /// The name of the hyperparameter.
  pub name: Str? = None
  /// A list of the categories for the hyperparameter.
  pub values: List[Str]? = None
  /// Whether the hyperparameter is tunable.
  pub is_tunable: Bool? = None
}

/// Provides the name and default range of a continuous hyperparameter and
/// whether the hyperparameter is tunable. A tunable hyperparameter can have
/// its value determined during hyperparameter optimization (HPO).
pub struct DefaultContinuousHyperParameterRange {
  /// The name of the hyperparameter.
  pub name: Str? = None
  /// The minimum allowable value for the hyperparameter.
  pub min_value: Float? = None
  /// The maximum allowable value for the hyperparameter.
  pub max_value: Float? = None
  /// Whether the hyperparameter is tunable.
  pub is_tunable: Bool? = None
}

/// Specifies the hyperparameters and their default ranges. Hyperparameters
/// can be categorical, continuous, or integer-valued.
pub struct DefaultHyperParameterRanges {
  /// The integer-valued hyperparameters and their default ranges.
  pub integer_hyper_parameter_ranges: List[DefaultIntegerHyperParameterRange]? = None
  /// The continuous hyperparameters and their default ranges.
  pub continuous_hyper_parameter_ranges: List[DefaultContinuousHyperParameterRange]? = None
  /// The categorical hyperparameters and their default ranges.
  pub categorical_hyper_parameter_ranges: List[DefaultCategoricalHyperParameterRange]? = None
}

/// Provides the name and default range of a integer-valued hyperparameter
/// and whether the hyperparameter is tunable. A tunable hyperparameter can
/// have its value determined during hyperparameter optimization (HPO).
pub struct DefaultIntegerHyperParameterRange {
  /// The name of the hyperparameter.
  pub name: Str? = None
  /// The minimum allowable value for the hyperparameter.
  pub min_value: Int? = None
  /// The maximum allowable value for the hyperparameter.
  pub max_value: Int? = None
  /// Indicates whether the hyperparameter is tunable.
  pub is_tunable: Bool? = None
}

