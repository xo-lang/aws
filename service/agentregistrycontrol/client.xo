fn json_of_identifier(v: Identifier) -> json.Value {
  match v {
    Domain(x) => json.Value.Object([("domain", json.Value.Str(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_identifier(v: json.Value) -> Identifier ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "domain" => Ok(Identifier.Domain(jsonv.read_str(fv)?))
      _ => Ok(Identifier.Unknown(k))
    }
  }
  Err("Identifier: no member set")
}

