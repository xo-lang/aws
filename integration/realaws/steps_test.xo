  let r = fn() -> () ! Error {
    expect(c.publish(sns.PublishInput{topic_arn: arn, message: "hello from xo"})?.message_id.is_some()) == true
    Ok(())
  }()
  var p = Problems{}
  note(p, "delete topic", c.delete_topic(sns.DeleteTopicInput{topic_arn: arn}))
  r?
  p.check(t.account)?
}

test "aws step 07 secrets manager: create, read, force delete" uses net, env, clock, fs {
  let t = begin(os.env, os.fs, os.net, os.clock, os.rand)? ?? return Ok(())
  if !selected(os.env, 7, false) {
    return Ok(())
  }
  let c = secretsmanager.from_config(t.net, os.clock, os.rand, t.cfg)?
  let name = t.name("secret")
  let r = fn() -> () ! Error {
    c.create_secret(secretsmanager.CreateSecretRequest{name: name, secret_string: "invented value"})?
    expect(c.get_secret_value(secretsmanager.GetSecretValueRequest{secret_id: name})?.secret_string) == Some("invented value")
    Ok(())
  }()
  var p = Problems{}
  note(p, "delete secret", c.delete_secret(secretsmanager.DeleteSecretRequest{secret_id: name, force_delete_without_recovery: true}), ok_codes: ["ResourceNotFoundException"])
  r?
  p.check(t.account)?
}

test "aws step 08 ec2: regions and zones (ec2Query, nothing created)" uses net, env, clock, fs {
  let t = begin(os.env, os.fs, os.net, os.clock, os.rand)? ?? return Ok(())
  if !selected(os.env, 8, false) {
    return Ok(())
  }
  let c = ec2.from_config(t.net, os.clock, os.rand, t.cfg)?
  let regions = c.describe_regions(ec2.DescribeRegionsRequest{})?.regions ?? []
  expect(regions.any(fn(r: ec2.Region) -> Bool { r.region_name == Some(t.region) })) == true
  expect((c.describe_availability_zones(ec2.DescribeAvailabilityZonesRequest{})?.availability_zones ?? []).is_empty()) == false
  c.describe_instances(ec2.DescribeInstancesRequest{max_results: 5})?
}

test "aws step 09 kinesis: SubscribeToShard event stream" uses net, env, clock, fs {
  let t = begin(os.env, os.fs, os.net, os.clock, os.rand)? ?? return Ok(())
  if !selected(os.env, 9, false) {
    return Ok(())
  }
  let c = kinesis.from_config(t.net, os.clock, os.rand, t.cfg)?
  let stream = t.name("kinesis")
  let r = fn() -> () ! Error {
    c.create_stream(kinesis.CreateStreamInput{stream_name: stream, shard_count: 1})?
    kinesis.wait_until_stream_exists(c, kinesis.DescribeStreamInput{stream_name: stream}, 5m, min_delay: 2s, max_delay: 10s)?
    for (i, text) in ["one", "two", "three"].indexed() {
      c.put_record(kinesis.PutRecordInput{stream_name: stream, data: text.bytes(), partition_key: "k${i}"})?
    }
    let arn = match c.describe_stream_summary(kinesis.DescribeStreamSummaryInput{stream_name: stream})?.stream_description_summary {
      Some(d) => d.stream_arn ?? ""
      None => ""
    }
    let shards = c.list_shards(kinesis.ListShardsInput{stream_name: stream})?.shards ?? []
    let consumer_arn = match c.register_stream_consumer(kinesis.RegisterStreamConsumerInput{stream_arn: arn, consumer_name: t.name("consumer")})?.consumer {
      Some(x) => x.consumer_arn ?? ""
      None => ""
    }
    var tries = 0
    while tries < 60 {
      tries += 1
      let d = c.describe_stream_consumer(kinesis.DescribeStreamConsumerInput{consumer_arn: consumer_arn})?
      let active = match d.consumer_description {
        Some(x) => x.consumer_status == kinesis.ConsumerStatus.Active
        None => false
      }
      if active {
        break
      }
      os.clock.sleep(2s)
    }
    var events = c.subscribe_to_shard(kinesis.SubscribeToShardInput{
      consumer_arn: consumer_arn,
      shard_id: shards[0].shard_id ?? "",
      starting_position: kinesis.StartingPosition{type_value: kinesis.ShardIteratorType.TrimHorizon},
    })?
    var got: List[Str] = []
    var n = 0
    while got.len() < 3 && n < 30 {
      n += 1
      match events.next()? {
        Some(SubscribeToShardEvent(e)) => {
          for rec in e.records ?? [] {
            got.push((rec.data ?? b"").to_str() ?? "")
          }
        }
        Some(_) => {}
        None => break
      }
    }
    events.close()
    expect(got) == ["one", "two", "three"]
    Ok(())
  }()
  var p = Problems{}
  // enforce_consumer_deletion removes the consumer with the stream
  note(p, "delete stream", c.delete_stream(kinesis.DeleteStreamInput{stream_name: stream, enforce_consumer_deletion: true}), ok_codes: ["ResourceNotFoundException"])
  r?
  p.check(t.account)?
}

test "aws step 10 and 11 polly and transcribe streaming (real only): speech in, the sentence back" uses net, env, clock, fs {
  let t = begin(os.env, os.fs, os.net, os.clock, os.rand)? ?? return Ok(())
  if !t.real || !(selected(os.env, 10, false) || selected(os.env, 11, false)) {
    return Ok(())
  }
  let speech = polly.from_config(t.net, os.clock, os.rand, t.cfg)?.synthesize_speech(polly.SynthesizeSpeechInput{
    engine: polly.Engine.Standard,
    output_format: polly.OutputFormat.Pcm,
    sample_rate: "16000",
    text: "Hello from the Xo language.",
    voice_id: polly.VoiceId.Joanna,
  })?
  let audio = speech.audio_stream ?? b""
  expect(audio.len() > 16000) == true
  let c = ts.from_config(t.net, os.clock, os.rand, t.cfg)?
  // 100 ms chunks (3200 bytes of 16 bit mono at 16 kHz), then a second of
  // silence so the last words are final
  var chunks: List[Bytes] = []
  var i = 0
  while i < audio.len() {
    let end = if i + 3200 > audio.len() { audio.len() } else { i + 3200 }
    chunks.push(audio[i..end])
    i = end
  }
  var silence = BytesBuilder.new()
  for _ in 0..3200 {
    silence.write_byte(UInt8(0))
  }
  for _ in 0..10 {
    chunks.push(silence.freeze())
  }
  var st = c.start_stream_transcription(
    ts.StartStreamTranscriptionRequest{language_code: ts.LanguageCode.EnUs, media_sample_rate_hertz: 16000, media_encoding: ts.MediaEncoding.Pcm},
    first: [ts.AudioStream.AudioEvent(ts.AudioEvent{audio_chunk: chunks[0]})],
  )?
  for ch in chunks[1..] {
    st.send(ts.AudioStream.AudioEvent(ts.AudioEvent{audio_chunk: ch}))?
    os.clock.sleep(50ms)
  }
  st.close_send()?
  var finals: List[Str] = []
  while let Some(e) = st.next()? {
    match e {
      TranscriptEvent(x) => {
        let results = match x.transcript {
          Some(tr) => tr.results ?? []
          None => []
        }
        for res in results {
          if res.is_partial == Some(false) {
            for alt in res.alternatives ?? [] {
              finals.push(alt.transcript ?? "")
            }
          }
        }
      }
      _ => {}
    }
  }
  st.close()
  let text = finals.join(" ").to_lower()
  expect(text.contains("hello")) == true
}

/// The function's code: a Node.js handler that streams its response in
/// two writes.
const HANDLER: Str = "export const handler = awslambda.streamifyResponse(async (event, stream) => {\n  stream.write(\"hello \");\n  stream.write(\"from xo\");\n  stream.end();\n});\n"

/// The role's trust policy: only Lambda may assume it.
const TRUST: Str = "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"lambda.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"

const BASIC_EXECUTION: Str = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"

/// Removes the step 12 role: its one managed policy, then the role.
fn remove_role(c: iam.Client, role: Str, var p: Problems) uses (net.dial, clock, rand) {
  note(p, "detach role policy", c.detach_role_policy(iam.DetachRolePolicyRequest{role_name: role, policy_arn: BASIC_EXECUTION}), ok_codes: ["NoSuchEntity"])
  note(p, "delete role", c.delete_role(iam.DeleteRoleRequest{role_name: role}), ok_codes: ["NoSuchEntity"])
}

test "aws step 12 lambda (optional, real only): InvokeWithResponseStream event stream" uses net, env, clock, fs {
  let t = begin(os.env, os.fs, os.net, os.clock, os.rand)? ?? return Ok(())
  if !t.real || !selected(os.env, 12, true) {
    return Ok(())
  }
  let roles = iam.from_config(t.net, os.clock, os.rand, t.cfg)?
  let fns = lambda.from_config(t.net, os.clock, os.rand, t.cfg)?
  let logs = cloudwatchlogs.from_config(t.net, os.clock, os.rand, t.cfg)?
  let name = t.name("lambda")
  let r = fn() -> () ! Error {
    // the one IAM change: a role only Lambda can assume, with only the
    // basic execution policy
    let role = roles.create_role(iam.CreateRoleRequest{role_name: name, assume_role_policy_document: TRUST, description: "xo-lang/aws integration test, deleted by the test"})?.role
    let role_arn = match role {
      Some(x) => x.arn ?? ""
      None => ""
    }
    roles.attach_role_policy(iam.AttachRolePolicyRequest{role_name: name, policy_arn: BASIC_EXECUTION})?
    let zip = archive.zip([archive.file("index.mjs", HANDLER.bytes())])?
    // a new role takes a few seconds to become assumable by Lambda
    var tries = 0
    var created = false
    while !created {
      tries += 1
      match fns.create_function(lambda.CreateFunctionRequest{
        function_name: name,
        runtime: lambda.Runtime.Nodejs20X,
        role: role_arn,
        handler: "index.handler",
        code: lambda.FunctionCode{zip_file: zip},
        timeout: 10,
        memory_size: 128,
      }) {
        Ok(_) => created = true
        Err(lambda.CreateFunctionErr.InvalidParameterValueException(e)) => {
          if tries >= 12 {
            return Err(lambda.CreateFunctionErr.InvalidParameterValueException(e))
          }
          os.clock.sleep(5s)
        }
        Err(e) => return Err(e)
      }
    }
    lambda.wait_until_function_active_v2(fns, lambda.GetFunctionRequest{function_name: name}, 5m)?
    var events = fns.invoke_with_response_stream(lambda.InvokeWithResponseStreamRequest{function_name: name, payload: b"{}"})?
    var body = BytesBuilder.new()
    var completed = false
    while let Some(e) = events.next()? {
      match e {
        PayloadChunk(x) => body.write(x.payload ?? b"")
        InvokeComplete(x) => {
          expect(x.error_code) == None
          completed = true
        }
        _ => {}
      }
    }
    expect(body.freeze()) == b"hello from xo"
    expect(completed) == true
    Ok(())
  }()
  var p = Problems{}
  note(p, "delete function", fns.delete_function(lambda.DeleteFunctionRequest{function_name: name}), ok_codes: ["ResourceNotFoundException"])
  note(p, "delete log group", logs.delete_log_group(cloudwatchlogs.DeleteLogGroupRequest{log_group_name: "/aws/lambda/${name}"}), ok_codes: ["ResourceNotFoundException"])
  remove_role(roles, name, p)
  r?
  p.check(t.account)?
}

test "aws step 13 sigv4a (optional, real only): a Multi-Region Access Point over two buckets" uses net, env, clock, fs {
  let t = begin(os.env, os.fs, os.net, os.clock, os.rand)? ?? return Ok(())
  if !t.real || !selected(os.env, 13, true) {
    return Ok(())
  }
  let east = s3.new(t.net, os.clock, os.rand, s3.options_from_config(t.cfg)?)?
  let west = s3.new(t.net, os.clock, os.rand, s3.options_from_config(t.in_region(t.region2))?)?
  // the control plane for Multi-Region Access Points is in us-west-2;
  // nothing is created there
  let ctl = s3control.from_config(t.net, os.clock, os.rand, t.in_region("us-west-2"))?
  let b1 = t.name("mrap-1")
  let b2 = t.name("mrap-2")
  let mrap = t.name("mrap")
  let r = fn() -> () ! Error {
    make_bucket(east, b1, t.region)?
    make_bucket(west, b2, t.region2)?
    ctl.create_multi_region_access_point(s3control.CreateMultiRegionAccessPointRequest{
      account_id: t.account,
      details: s3control.CreateMultiRegionAccessPointInput{name: mrap, regions: [s3control.Region{bucket: b1}, s3control.Region{bucket: b2}]},
    })?
    // creation is asynchronous; the wait is capped at 60 minutes
    var alias = ""
    var tries = 0
    while alias == "" && tries < 120 {
      tries += 1
      os.clock.sleep(30s)
      let ap = ctl.get_multi_region_access_point(s3control.GetMultiRegionAccessPointRequest{account_id: t.account, name: mrap})?.access_point
      if let Some(x) = ap {
        if x.status == Some(s3control.MultiRegionAccessPointStatus.Ready) {
          alias = x.alias ?? ""
        }
      }
    }
    if alias == "" {
      report(os.env, os.fs, 13, "timed out: the access point was not READY after 60 minutes; what existed was deleted")
      return Err("the access point was not READY after 60 minutes")
    }
    let arn = "arn:aws:s3::${t.account}:accesspoint/${alias}"
    // SigV4a: the endpoint rules choose it for a Multi-Region Access Point
    east.put_object(s3.PutObjectRequest{bucket: arn, key: "through-mrap.txt", body: b"sigv4a"})?
    expect(east.get_object(s3.GetObjectRequest{bucket: arn, key: "through-mrap.txt"})?.body) == Some(b"sigv4a")
    let get = east.presign_get_object(s3.GetObjectRequest{bucket: arn, key: "through-mrap.txt"})?
    expect(get.url.contains("X-Amz-Algorithm=AWS4-ECDSA-P256-SHA256")) == true
    let fetched = http.client(t.net).send(http.new_request(get.method, get.url, {}, b""))?
    expect(fetched.status) == 200
    Ok(())
  }()
  var p = Problems{}
  let deleting = ctl.delete_multi_region_access_point(s3control.DeleteMultiRegionAccessPointRequest{
    account_id: t.account,
    details: s3control.DeleteMultiRegionAccessPointInput{name: mrap},
  })
  if deleting.is_ok() {
    // the buckets can go once the access point is deleted
    var tries = 0
    while tries < 120 {
      tries += 1
      match ctl.get_multi_region_access_point(s3control.GetMultiRegionAccessPointRequest{account_id: t.account, name: mrap}) {
        Err(_) => break
        Ok(_) => os.clock.sleep(30s)
      }
    }
  }
  note(p, "delete access point", deleting, ok_codes: ["NoSuchMultiRegionAccessPoint"])
  remove_bucket(east, b1, p)
  remove_bucket(west, b2, p)
  r?
  p.check(t.account)?
}

test "aws step 98 leftovers (emulator only): left for the sweep to remove" uses net, env, clock, fs {
  let t = begin(os.env, os.fs, os.net, os.clock, os.rand)? ?? return Ok(())
  if t.real {
    return Ok(())
  }
  let b = s3.new(t.net, os.clock, os.rand, s3.options_from_config(t.cfg)? with {force_path_style: true})?
  b.create_bucket(s3.CreateBucketRequest{bucket: t.name("left")})?
  b.put_object(s3.PutObjectRequest{bucket: t.name("left"), key: "a", body: b"x"})?
  sqs.from_config(t.net, os.clock, os.rand, t.cfg)?.create_queue(sqs.CreateQueueRequest{queue_name: t.name("left")})?
  dynamodb.from_config(t.net, os.clock, os.rand, t.cfg)?.create_table(dynamodb.CreateTableInput{
    table_name: t.name("left"),
    attribute_definitions: [dynamodb.AttributeDefinition{attribute_name: "pk", attribute_type: dynamodb.ScalarAttributeType.S}],
    key_schema: [dynamodb.KeySchemaElement{attribute_name: "pk", key_type: dynamodb.KeyType.Hash}],
    billing_mode: dynamodb.BillingMode.PayPerRequest,
  })?
}
