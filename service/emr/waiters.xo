/// Calls DescribeCluster until the ClusterRunning acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (120s).
pub fn wait_until_cluster_running(c: Client, input: DescribeClusterInput, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeClusterErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_cluster(input) {
      Ok(out) => {
        let o = jmes_of_describe_cluster_output(out)
        if state == "" && waiter.path_matches(o, "Cluster.Status.State", "stringEquals", "RUNNING") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Cluster.Status.State", "stringEquals", "WAITING") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Cluster.Status.State", "stringEquals", "TERMINATING") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "Cluster.Status.State", "stringEquals", "TERMINATED") {
          state = "failure"
        }
        if state == "" && waiter.path_matches(o, "Cluster.Status.State", "stringEquals", "TERMINATED_WITH_ERRORS") {
          state = "failure"
        }
      }
      Err(e) => {
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ClusterRunning: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

