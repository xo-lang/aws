fn json_of_instance(v: Instance) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.instance_id {
    fs.push(("instanceId", json.Value.Str(x)))
  }
  if let Some(x) = v.aws_account_id {
    fs.push(("awsAccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.state {
    fs.push(("state", json.Value.Str(x.value())))
  }
  if let Some(x) = v.error_message {
    fs.push(("errorMessage", json.Value.Str(x)))
  }
  if let Some(x) = v.web_app_dns_domain {
    fs.push(("webAppDnsDomain", json.Value.Str(x)))
  }
  if let Some(x) = v.created_time {
    fs.push(("createdTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_modified_time {
    fs.push(("lastModifiedTime", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.instance_name {
    fs.push(("instanceName", json.Value.Str(x)))
  }
  if let Some(x) = v.instance_description {
    fs.push(("instanceDescription", json.Value.Str(x)))
  }
  if let Some(x) = v.kms_key_arn {
    fs.push(("kmsKeyArn", json.Value.Str(x)))
  }
  if let Some(x) = v.version_number {
    fs.push(("versionNumber", jsonv.float(x)))
  }
  json.Value.Object(fs)
}

fn from_json_instance(v: json.Value) -> Instance ! Str {
  var out = Instance{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "instanceId" => out.instance_id = jsonv.read_str(fv)?
      "awsAccountId" => out.aws_account_id = jsonv.read_str(fv)?
      "state" => out.state = InstanceState.from(jsonv.read_str(fv)?)
      "errorMessage" => out.error_message = jsonv.read_str(fv)?
      "webAppDnsDomain" => out.web_app_dns_domain = jsonv.read_str(fv)?
      "createdTime" => out.created_time = jsonv.read_time(fv, "epoch-seconds")?
      "lastModifiedTime" => out.last_modified_time = jsonv.read_time(fv, "epoch-seconds")?
      "instanceName" => out.instance_name = jsonv.read_str(fv)?
      "instanceDescription" => out.instance_description = jsonv.read_str(fv)?
      "kmsKeyArn" => out.kms_key_arn = jsonv.read_str(fv)?
      "versionNumber" => out.version_number = jsonv.read_float(fv)?
      _ => {}
    }
  }
  Ok(out)
}

fn json_of_instance_list(v: List[Instance]) -> json.Value {
  json.Value.List(v.map(fn(x: Instance) -> json.Value { json_of_instance(x) }))
}

fn from_json_instance_list(v: json.Value) -> List[Instance] ! Str {
  var out: List[Instance] = []
  for fv in jsonv.items(v)? {
