    None => return Err("input member AwsAccountId is required")
  }
  if label_aws_account_id == "" {
    return Err("input member AwsAccountId must not be empty")
  }
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.asset_bundle_import_job_id {
    fs.push(("AssetBundleImportJobId", json.Value.Str(x)))
  }
  if let Some(x) = input.asset_bundle_import_source {
    fs.push(("AssetBundleImportSource", json_of_asset_bundle_import_source(x)))
  }
  if let Some(x) = input.override_parameters {
    fs.push(("OverrideParameters", json_of_asset_bundle_import_job_override_parameters(x)))
  }
  if let Some(x) = input.failure_action {
    fs.push(("FailureAction", json.Value.Str(x.value())))
  }
  if let Some(x) = input.override_permissions {
    fs.push(("OverridePermissions", json_of_asset_bundle_import_job_override_permissions(x)))
  }
  if let Some(x) = input.override_tags {
    fs.push(("OverrideTags", json_of_asset_bundle_import_job_override_tags(x)))
  }
  if let Some(x) = input.override_validation_strategy {
    fs.push(("OverrideValidationStrategy", json_of_asset_bundle_import_job_override_validation_strategy(x)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/json"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.join_path(ep.path, "/accounts/${rest.escape(label_aws_account_id, false)}/asset-bundle-import-jobs/import"),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}