  EnGb = "en-GB"
  EnIe = "en-IE"
  EnIn = "en-IN"
  EnUs = "en-US"
  EnWl = "en-WL"
  EsEs = "es-ES"
  EsUs = "es-US"
  FrCa = "fr-CA"
  FrFr = "fr-FR"
  HiIn = "hi-IN"
  ItIt = "it-IT"
  JaJp = "ja-JP"
  KoKr = "ko-KR"
  PtBr = "pt-BR"
  PtPt = "pt-PT"
  ZhCn = "zh-CN"
  EnNz = "en-NZ"
  EnZa = "en-ZA"
  CaEs = "ca-ES"
  DaDk = "da-DK"
  FiFi = "fi-FI"
  IdId = "id-ID"
  MsMy = "ms-MY"
  NlNl = "nl-NL"
  NoNo = "no-NO"
  PlPl = "pl-PL"
  SvSe = "sv-SE"
  TlPh = "tl-PH"
