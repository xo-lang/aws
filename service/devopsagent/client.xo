fn json_of_mcp_server_authorization_config(v: MCPServerAuthorizationConfig) -> json.Value {
  match v {
    OAuthClientCredentials(x) => json.Value.Object([("oAuthClientCredentials", json_of_mcp_server_o_auth_client_credentials_config(x))])
    OAuth3Lo(x) => json.Value.Object([("oAuth3LO", json_of_mcp_server_o_auth3_lo_config(x))])
    ApiKey(x) => json.Value.Object([("apiKey", json_of_mcp_server_api_key_config(x))])
    BearerToken(x) => json.Value.Object([("bearerToken", json_of_mcp_server_bearer_token_config(x))])
    CustomHeaders(x) => json.Value.Object([("customHeaders", json_of_mcp_server_custom_headers_config(x))])
    AuthorizationDiscovery(x) => json.Value.Object([("authorizationDiscovery", json_of_mcp_server_authorization_discovery_config(x))])
    Unknown(_) => json.Value.Object([])
  }
}

fn from_json_mcp_server_authorization_config(v: json.Value) -> MCPServerAuthorizationConfig ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "oAuthClientCredentials" => Ok(MCPServerAuthorizationConfig.OAuthClientCredentials(from_json_mcp_server_o_auth_client_credentials_config(fv)?))
      "oAuth3LO" => Ok(MCPServerAuthorizationConfig.OAuth3Lo(from_json_mcp_server_o_auth3_lo_config(fv)?))
      "apiKey" => Ok(MCPServerAuthorizationConfig.ApiKey(from_json_mcp_server_api_key_config(fv)?))
      "bearerToken" => Ok(MCPServerAuthorizationConfig.BearerToken(from_json_mcp_server_bearer_token_config(fv)?))
      "customHeaders" => Ok(MCPServerAuthorizationConfig.CustomHeaders(from_json_mcp_server_custom_headers_config(fv)?))
      "authorizationDiscovery" => Ok(MCPServerAuthorizationConfig.AuthorizationDiscovery(from_json_mcp_server_authorization_discovery_config(fv)?))
      _ => Ok(MCPServerAuthorizationConfig.Unknown(k))
    }
  }
  Err("MCPServerAuthorizationConfig: no member set")
}

