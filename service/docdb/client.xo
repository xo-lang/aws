fn query_put_add_source_identifier_to_subscription_message(var f: query.Form, prefix: Str, v: AddSourceIdentifierToSubscriptionMessage) {
  if let Some(x) = v.subscription_name {
    query.add(f, query.key(prefix, "SubscriptionName"), x)
  }
  if let Some(x) = v.source_identifier {
    query.add(f, query.key(prefix, "SourceIdentifier"), x)
  }
}

fn query_put_add_source_identifier_to_subscription_result(var f: query.Form, prefix: Str, v: AddSourceIdentifierToSubscriptionResult) {
  if let Some(x) = v.event_subscription {
    query_put_event_subscription(f, query.key(prefix, "EventSubscription"), x)
  }
}

fn query_put_add_tags_to_resource_message(var f: query.Form, prefix: Str, v: AddTagsToResourceMessage) {
  if let Some(x) = v.resource_name {
    query.add(f, query.key(prefix, "ResourceName"), x)
  }
  if let Some(x) = v.tags {
    query_put_tag_list(f, query.key(prefix, "Tags"), x, false)
  }
}

fn query_put_apply_pending_maintenance_action_message(var f: query.Form, prefix: Str, v: ApplyPendingMaintenanceActionMessage) {
  if let Some(x) = v.resource_identifier {
    query.add(f, query.key(prefix, "ResourceIdentifier"), x)
  }
  if let Some(x) = v.apply_action {
    query.add(f, query.key(prefix, "ApplyAction"), x)
  }
  if let Some(x) = v.opt_in_type {
    query.add(f, query.key(prefix, "OptInType"), x)
  }
}

fn query_put_apply_pending_maintenance_action_result(var f: query.Form, prefix: Str, v: ApplyPendingMaintenanceActionResult) {
  if let Some(x) = v.resource_pending_maintenance_actions {
    query_put_resource_pending_maintenance_actions(f, query.key(prefix, "ResourcePendingMaintenanceActions"), x)
  }
}

fn query_put_attribute_value_list(var f: query.Form, prefix: Str, v: List[Str], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.AttributeValue.${i + 1}" }
    query.add(f, k, x)
  }
}

fn query_put_authorization_not_found_fault(var f: query.Form, prefix: Str, v: AuthorizationNotFoundFault) {
  if let Some(x) = v.message {
    query.add(f, query.key(prefix, "message"), x)
  }
}

fn query_put_availability_zone(var f: query.Form, prefix: Str, v: AvailabilityZone) {
  if let Some(x) = v.name {
    query.add(f, query.key(prefix, "Name"), x)
  }
}

fn query_put_availability_zone_list(var f: query.Form, prefix: Str, v: List[AvailabilityZone], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.AvailabilityZone.${i + 1}" }
    query_put_availability_zone(f, k, x)
  }
}

fn query_put_availability_zones(var f: query.Form, prefix: Str, v: List[Str], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.AvailabilityZone.${i + 1}" }
    query.add(f, k, x)
  }
}

fn query_put_ca_certificate_identifiers_list(var f: query.Form, prefix: Str, v: List[Str], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.member.${i + 1}" }
    query.add(f, k, x)
  }
}

fn query_put_certificate(var f: query.Form, prefix: Str, v: Certificate) {
  if let Some(x) = v.certificate_identifier {
    query.add(f, query.key(prefix, "CertificateIdentifier"), x)
  }
  if let Some(x) = v.certificate_type {
    query.add(f, query.key(prefix, "CertificateType"), x)
  }
  if let Some(x) = v.thumbprint {
    query.add(f, query.key(prefix, "Thumbprint"), x)
  }
  if let Some(x) = v.valid_from {
    query.add(f, query.key(prefix, "ValidFrom"), rest.date_time(x))
  }
  if let Some(x) = v.valid_till {
    query.add(f, query.key(prefix, "ValidTill"), rest.date_time(x))
  }
  if let Some(x) = v.certificate_arn {
    query.add(f, query.key(prefix, "CertificateArn"), x)
  }
}

fn query_put_certificate_details(var f: query.Form, prefix: Str, v: CertificateDetails) {
  if let Some(x) = v.ca_identifier {
    query.add(f, query.key(prefix, "CAIdentifier"), x)
  }
  if let Some(x) = v.valid_till {
    query.add(f, query.key(prefix, "ValidTill"), rest.date_time(x))
  }
}

fn query_put_certificate_list(var f: query.Form, prefix: Str, v: List[Certificate], flat: Bool) {
  if v.is_empty() {
    query.add(f, prefix, "")
    return
  }
  for (i, x) in v.indexed() {
    let k = if flat { "${prefix}.${i + 1}" } else { "${prefix}.Certificate.${i + 1}" }
    query_put_certificate(f, k, x)
  }
}

fn query_put_certificate_message(var f: query.Form, prefix: Str, v: CertificateMessage) {
  if let Some(x) = v.certificates {
    query_put_certificate_list(f, query.key(prefix, "Certificates"), x, false)
  }
  if let Some(x) = v.marker {
    query.add(f, query.key(prefix, "Marker"), x)
  }
}

