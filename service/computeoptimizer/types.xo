/// Describes an Amazon Aurora and RDS database recommendation.
pub struct RDSDBRecommendation {
  /// The ARN of the current Amazon Aurora or RDS database. The following is
  /// the format of the ARN:
  /// arn:aws:rds:{region}:{accountId}:db:{resourceName}
  pub resource_arn: Str? = None
  /// The Amazon Web Services account ID of the Amazon Aurora or RDS database.
  pub account_id: Str? = None
  /// The engine of the DB instance.
  pub engine: Str? = None
  /// The database engine version.
  pub engine_version: Str? = None
  /// The promotion tier for the Aurora instance.
  pub promotion_tier: Int? = None
  /// The DB instance class of the current Aurora or RDS DB instance.
  pub current_db_instance_class: Str? = None
  /// The configuration of the current DB storage.
  pub current_storage_configuration: DBStorageConfiguration? = None
  /// The identifier for DB cluster.
  pub db_cluster_identifier: Str? = None
  /// This indicates if the DB instance is idle or not.
  pub idle: Idle? = None
  /// The finding classification of an Amazon Aurora and RDS DB instance. For
  /// more information about finding classifications, see Finding
  /// classifications for Aurora and RDS databases in the Compute Optimizer
  /// User Guide .
  pub instance_finding: RDSInstanceFinding? = None
  /// The finding classification of Amazon RDS DB instance storage. For more
  /// information about finding classifications, see Finding classifications
  /// for Aurora and RDS databases in the Compute Optimizer User Guide .
  pub storage_finding: RDSStorageFinding? = None
  /// The reason for the finding classification of a DB instance.
  pub instance_finding_reason_codes: List[RDSInstanceFindingReasonCode]? = None
  /// The performance risk for the current DB instance.
  pub current_instance_performance_risk: RDSCurrentInstancePerformanceRisk? = None
  /// The level of variation in monthly I/O costs for the current DB storage
  /// configuration.
  pub current_storage_estimated_monthly_volume_iops_cost_variation: RDSEstimatedMonthlyVolumeIOPsCostVariation? = None
  /// The reason for the finding classification of RDS DB instance storage.
  pub storage_finding_reason_codes: List[RDSStorageFindingReasonCode]? = None
  /// An array of objects that describe the recommendation options for the RDS
  /// DB instance.
  pub instance_recommendation_options: List[RDSDBInstanceRecommendationOption]? = None
  /// An array of objects that describe the recommendation options for DB
  /// instance storage.
  pub storage_recommendation_options: List[RDSDBStorageRecommendationOption]? = None
  /// An array of objects that describe the utilization metrics of the DB
  /// instance.
  pub utilization_metrics: List[RDSDBUtilizationMetric]? = None
  /// Describes the effective recommendation preferences for DB instances.
  pub effective_recommendation_preferences: RDSEffectiveRecommendationPreferences? = None
  /// The number of days the DB instance utilization metrics were analyzed.
  pub lookback_period_in_days: Float? = None
  /// The timestamp of when the DB instance recommendation was last generated.
  pub last_refresh_timestamp: Time? = None
  /// A list of tags assigned to your DB instance recommendations.
  pub tags: List[Tag]? = None
}

/// Describes a filter that returns a more specific list of DB instance
/// recommendations. Use this filter with the GetECSServiceRecommendations
/// action.
pub struct RDSDBRecommendationFilter {
  /// The name of the filter. Specify Finding to return recommendations with a
  /// specific finding classification. You can filter your DB instance
  /// recommendations by tag:key and tag-key tags. A tag:key is a key and
  /// value combination of a tag assigned to your DB instance recommendations.
  /// Use the tag key in the filter name and the tag value as the filter
  /// value. For example, to find all DB instance recommendations that have a
  /// tag with the key of Owner and the value of TeamA , specify tag:Owner for
  /// the filter name and TeamA for the filter value. A tag-key is the key of
  /// a tag assigned to your DB instance recommendations. Use this filter to
  /// find all of your DB instance recommendations that have a tag with a
  /// specific key. This doesn’t consider the tag value. For example, you
  /// can find your DB instance recommendations with a tag key value of Owner
  /// or without any tag keys assigned.
  pub name: RDSDBRecommendationFilterName? = None
  /// The value of the filter.
  pub values: List[Str]? = None
}

pub enum RDSDBRecommendationFilterName: Str {
  InstanceFinding = "InstanceFinding"
  InstanceFindingReasonCode = "InstanceFindingReasonCode"
  StorageFinding = "StorageFinding"
