  if let Some(x) = v.network_insights_access_scope_id {
    xmlv.elem(w, "networkInsightsAccessScopeId", x, [])
  }
  if let Some(x) = v.network_insights_access_scope_arn {
    xmlv.elem(w, "networkInsightsAccessScopeArn", x, [])
  }
  if let Some(x) = v.created_date {
    xmlv.elem(w, "createdDate", rest.date_time(x), [])
  }
  if let Some(x) = v.updated_date {
    xmlv.elem(w, "updatedDate", rest.date_time(x), [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  xmlv.end(w, name)
}

fn xml_read_network_insights_access_scope(e: xml.Element) -> NetworkInsightsAccessScope ! Str {
  var out = NetworkInsightsAccessScope{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "networkInsightsAccessScopeId" => out.network_insights_access_scope_id = c.text()
      "networkInsightsAccessScopeArn" => out.network_insights_access_scope_arn = c.text()
      "createdDate" => out.created_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "updatedDate" => out.updated_date = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "tagSet" => out.tags = xml_read_tag_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_network_insights_access_scope_analysis(var w: xmlv.Writer, v: NetworkInsightsAccessScopeAnalysis, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.network_insights_access_scope_analysis_id {
    xmlv.elem(w, "networkInsightsAccessScopeAnalysisId", x, [])
  }
  if let Some(x) = v.network_insights_access_scope_analysis_arn {
    xmlv.elem(w, "networkInsightsAccessScopeAnalysisArn", x, [])
  }
  if let Some(x) = v.network_insights_access_scope_id {
    xmlv.elem(w, "networkInsightsAccessScopeId", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
