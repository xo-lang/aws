pub fn endpoint_params_associate_faces(base: EndpointParameters, input: AssociateFacesRequest) -> EndpointParameters {
  let _ = input
  base
}

/// The HTTP request of AssociateFaces.
pub fn serialize_associate_faces(ep: rest.Endpoint, input: AssociateFacesRequest, idempotency_token: Str = "", min_compress: Int = 10240) -> transport.Request ! Str {
  let _ = (idempotency_token, min_compress)
  var headers: List[(Str, Str)] = []
  var qs: List[(Str, Str)] = []
  var body = b""
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = input.collection_id {
    fs.push(("CollectionId", json.Value.Str(x)))
  }
  if let Some(x) = input.user_id {
    fs.push(("UserId", json.Value.Str(x)))
  }
  if let Some(x) = input.face_ids {
    fs.push(("FaceIds", json_of_user_face_id_list(x)))
  }
  if let Some(x) = input.user_match_threshold {
    fs.push(("UserMatchThreshold", jsonv.float(x)))
  }
  if let Some(x) = input.client_request_token {
    fs.push(("ClientRequestToken", json.Value.Str(x)))
  } else if idempotency_token != "" {
    fs.push(("ClientRequestToken", json.Value.Str(idempotency_token)))
  }
  body = json.Value.Object(fs).encode().bytes()
  headers.push(("Content-Type", "application/x-amz-json-1.1"))
  headers.push(("X-Amz-Target", "RekognitionService.AssociateFaces"))
  if !body.is_empty() {
    headers.push(("Content-Length", "${body.len()}"))
  }
  Ok(transport.Request{
    method: "POST",
    scheme: ep.scheme,
    host: ep.host,
    port: ep.port,
    path: rest.rpc_path(ep.path),
    query: rest.query(qs),
    headers: headers,
    body: body,
  })
}

pub fn deserialize_associate_faces(resp: http.Response) -> AssociateFacesResponse ! Str {
  var out = AssociateFacesResponse{}
  let body = jsonv.parse_body(resp.body)?
  for (k, fv) in jsonv.fields(body)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "AssociatedFaces" => out.associated_faces = from_json_associated_faces_list(fv)?
      "UnsuccessfulFaceAssociations" => out.unsuccessful_face_associations = from_json_unsuccessful_face_association_list(fv)?
      "UserStatus" => out.user_status = UserStatus.from(jsonv.read_str(fv)?)
      _ => {}
    }
  }
  Ok(out)
}

