/// Represents a REST API.
pub struct RestApi {
  /// The API's identifier. This identifier is unique across all of your APIs
  /// in API Gateway.
  pub id: Str? = None
  /// The API's name.
  pub name: Str? = None
  /// The API's description.
  pub description: Str? = None
  /// The timestamp when the API was created.
  pub created_date: Time? = None
  /// A version identifier for the API.
  pub version: Str? = None
  /// The warning messages reported when failonwarnings is turned on during
  /// API import.
  pub warnings: List[Str]? = None
  /// The list of binary media types supported by the RestApi. By default, the
  /// RestApi supports only UTF-8-encoded text payloads.
  pub binary_media_types: List[Str]? = None
  /// A nullable integer that is used to enable compression (with non-negative
  /// between 0 and 10485760 (10M) bytes, inclusive) or disable compression
  /// (with a null value) on an API. When compression is enabled, compression
  /// or decompression is not applied on the payload if the payload size is
  /// smaller than this value. Setting it to zero allows compression for any
  /// payload size.
  pub minimum_compression_size: Int? = None
  /// The source of the API key for metering requests according to a usage
  /// plan. Valid values are: HEADER to read the API key from the X-API-Key
  /// header of a request. AUTHORIZER to read the API key from the
  /// UsageIdentifierKey from a custom authorizer.
  pub api_key_source: ApiKeySourceType? = None
  /// The endpoint configuration of this RestApi showing the endpoint types
  /// and IP address types of the API.
  pub endpoint_configuration: EndpointConfiguration? = None
  /// A stringified JSON policy document that applies to this RestApi
  /// regardless of the caller and Method configuration.
  pub policy: Str? = None
  /// The collection of tags. Each tag element is associated with a given
  /// resource.
  pub tags: Map[Str, Str]? = None
  /// Specifies whether clients can invoke your API by using the default
  /// execute-api endpoint. By default, clients can invoke your API with the
  /// default https://{api_id}.execute-api.{region}.amazonaws.com endpoint. To
  /// require that clients use a custom domain name to invoke your API,
  /// disable the default endpoint.
  pub disable_execute_api_endpoint: Bool? = None
  /// The API's root resource ID.
  pub root_resource_id: Str? = None
  /// The Transport Layer Security (TLS) version + cipher suite for this
  /// RestApi.
  pub security_policy: SecurityPolicy? = None
  /// The endpoint access mode of the RestApi.
  pub endpoint_access_mode: EndpointAccessMode? = None
  /// The ApiStatus of the RestApi.
  pub api_status: ApiStatus? = None
  /// The status message of the RestApi. When the status message is UPDATING
  /// you can still invoke it.
  pub api_status_message: Str? = None
}

