      "ConfigurationState" => out.configuration_state = AnnotationConfigurationState.from(c.text())
      "TableStatus" => out.table_status = c.text()
      "Error" => out.error = xml_read_error_details(c)?
      "TableName" => out.table_name = c.text()
      "TableArn" => out.table_arn = c.text()
      "Role" => out.role = c.text()
      _ => {}
    }
  }
  Ok(out)
}

