fn xml_write_placement(var w: xmlv.Writer, v: Placement, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.availability_zone_id {
    xmlv.elem(w, "availabilityZoneId", x, [])
  }
  if let Some(x) = v.affinity {
    xmlv.elem(w, "affinity", x, [])
  }
  if let Some(x) = v.group_name {
    xmlv.elem(w, "groupName", x, [])
  }
  if let Some(x) = v.partition_number {
    xmlv.elem(w, "partitionNumber", "${x}", [])
  }
  if let Some(x) = v.host_id {
    xmlv.elem(w, "hostId", x, [])
  }
  if let Some(x) = v.tenancy {
    xmlv.elem(w, "tenancy", x.value(), [])
  }
  if let Some(x) = v.spread_domain {
    xmlv.elem(w, "spreadDomain", x, [])
  }
  if let Some(x) = v.host_resource_group_arn {
    xmlv.elem(w, "hostResourceGroupArn", x, [])
  }
  if let Some(x) = v.group_id {
    xmlv.elem(w, "groupId", x, [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_placement(e: xml.Element) -> Placement ! Str {
  var out = Placement{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "availabilityZoneId" => out.availability_zone_id = c.text()
      "affinity" => out.affinity = c.text()
      "groupName" => out.group_name = c.text()
      "partitionNumber" => out.partition_number = xmlv.read_int(c.text())?
      "hostId" => out.host_id = c.text()
      "tenancy" => out.tenancy = Tenancy.from(c.text())
      "spreadDomain" => out.spread_domain = c.text()
      "hostResourceGroupArn" => out.host_resource_group_arn = c.text()
      "groupId" => out.group_id = c.text()
      "availabilityZone" => out.availability_zone = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_placement_group(var w: xmlv.Writer, v: PlacementGroup, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.group_name {
    xmlv.elem(w, "groupName", x, [])
  }
  if let Some(x) = v.state {
    xmlv.elem(w, "state", x.value(), [])
  }
  if let Some(x) = v.strategy {
    xmlv.elem(w, "strategy", x.value(), [])
  }
  if let Some(x) = v.partition_count {
    xmlv.elem(w, "partitionCount", "${x}", [])
  }
  if let Some(x) = v.group_id {
    xmlv.elem(w, "groupId", x, [])
  }
  if let Some(x) = v.tags {
    xml_write_tag_list(w, x, "tagSet", [])
  }
  if let Some(x) = v.group_arn {
    xmlv.elem(w, "groupArn", x, [])
  }
  if let Some(x) = v.spread_level {
    xmlv.elem(w, "spreadLevel", x.value(), [])
  }
  if let Some(x) = v.linked_group_id {
    xmlv.elem(w, "linkedGroupId", x, [])
  }
  if let Some(x) = v.operator {
    xml_write_operator_response(w, x, "operator", [])
  }
  if let Some(x) = v.parent_group_id {
    xmlv.elem(w, "parentGroupId", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_placement_group(e: xml.Element) -> PlacementGroup ! Str {
  var out = PlacementGroup{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "groupName" => out.group_name = c.text()
      "state" => out.state = PlacementGroupState.from(c.text())
      "strategy" => out.strategy = PlacementStrategy.from(c.text())
      "partitionCount" => out.partition_count = xmlv.read_int(c.text())?
      "groupId" => out.group_id = c.text()
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "groupArn" => out.group_arn = c.text()
      "spreadLevel" => out.spread_level = SpreadLevel.from(c.text())
      "linkedGroupId" => out.linked_group_id = c.text()
      "operator" => out.operator = xml_read_operator_response(c)?
      "parentGroupId" => out.parent_group_id = c.text()
      _ => {}
    }
  }
  Ok(out)
}

