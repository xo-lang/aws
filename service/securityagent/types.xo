  pub report_destination: ReportDestination? = None
  /// The report-generation filters applied when the report is exported.
  pub report_filters: ReportFilters? = None
  /// The CI/CD pentesting configuration for this pentest. Present when the
  /// pentest is set up to run from a CI/CD pipeline.
  pub cicd_configuration: CiCdConfiguration? = None
  pub test_scope: TestScope? = None
  /// The date and time the pentest was created, in UTC format.
  pub created_at: Time? = None
  /// The date and time the pentest was last updated, in UTC format.
  pub updated_at: Time? = None
}

/// Represents a pentest job, which is an execution instance of a pentest. A
/// pentest job progresses through preflight, static analysis, pentest, and
/// finalizing steps.
pub struct PentestJob {
  /// The unique identifier of the pentest job.
  pub pentest_job_id: Str? = None
  /// The unique identifier of the pentest associated with the job.
  pub pentest_id: Str? = None
  /// The title of the pentest job.
  pub title: Str? = None
  /// An overview of the pentest job results.
  pub overview: Str? = None
  /// The current status of the pentest job.
  pub status: JobStatus? = None
  /// The list of endpoints being tested in the pentest job.
  pub endpoints: List[Endpoint]? = None
  /// The list of actors used during the pentest job.
  pub actors: List[Actor]? = None
  /// The list of documents providing context for the pentest job.
  pub documents: List[DocumentInfo]? = None
  /// The list of source code repositories analyzed during the pentest job.
  pub source_code: List[SourceCodeRepository]? = None
  /// The list of paths excluded from the pentest job.
  pub exclude_paths: List[Endpoint]? = None
  /// The list of domains allowed during the pentest job.
  pub allowed_domains: List[Endpoint]? = None
  /// The list of risk types excluded from the pentest job.
  pub exclude_risk_types: List[RiskType]? = None
  /// The list of steps in the pentest job execution.
  pub steps: List[Step]? = None
  /// The execution context messages for the pentest job.
  pub execution_context: List[ExecutionContext]? = None
  /// The IAM service role used for the pentest job.
  pub service_role: Str? = None
  /// The CloudWatch Logs configuration for the pentest job.
  pub log_config: CloudWatchLog? = None
  /// The VPC configuration for the pentest job.
  pub vpc_config: VpcConfig? = None
  /// The network traffic configuration for the pentest job.
  pub network_traffic_config: NetworkTrafficConfig? = None
  /// Error information if the pentest job encountered an error.
  pub error_information: ErrorInformation? = None
  /// The list of integrated repositories associated with the pentest job.
  pub integrated_repositories: List[IntegratedRepository]? = None
  /// The trust anchors used to validate target endpoint TLS certificates
  /// during the pentest job.
  pub trusted_ca_certificates: List[TrustedCaCertificate]? = None
  /// The client certificates for mutual TLS (mTLS) authentication to target
  /// hosts during the pentest job.
  pub client_certificates: List[ClientCertificate]? = None
  /// The code remediation strategy for the pentest job.
  pub code_remediation_strategy: CodeRemediationStrategy? = None
  /// Strategy for cleaning up resources after pentest job completion.
  pub clean_up_strategy: CleanUpStrategy? = None
  /// A list of managed skills disabled for this pentest job. Valid values
  /// include FINDING_PERSONALIZATION and LOGIN_OPTIMIZATION.
  pub disable_managed_skills: List[SkillType]? = None
  /// The maximum number of billable task hours allowed for this pentest job.
  /// If the cumulative task hours reach this limit, the job is gracefully
  /// stopped.
  pub max_task_hours: Float? = None
  /// The type of the pentest job. Valid values are FULL, REVALIDATION, and
  /// CICD.
  pub job_type: JobType? = None
  /// The list of finding identifiers selected for revalidation. Present only
  /// when jobType is REVALIDATION.
  pub selected_finding_ids: List[Str]? = None
  /// The destination for publishing scan reports to an integrated document
  /// provider.
  pub report_destination: ReportDestination? = None
  /// The URL to view this pentest job's findings report in the console.
  pub report_url: Str? = None
  /// The scoping outcome for this CI/CD pentest job. Present only for jobs of
  /// type CICD.
  pub scope_result: ScopeResult? = None
  /// The code changes that defined the scope of this CI/CD pentest job.
  /// Present only for jobs of type CICD.
  pub scope_changes: List[ScopeChange]? = None
  pub cicd_configuration: CiCdConfiguration? = None
  pub test_scope: TestScope? = None
  /// The date and time the pentest job was created, in UTC format.
  pub created_at: Time? = None
  /// The date and time the pentest job was last updated, in UTC format.
  pub updated_at: Time? = None
}

