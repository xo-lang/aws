/// Wait until change set status is CREATE_COMPLETE.
///
/// Calls DescribeChangeSet until the ChangeSetCreateComplete acceptors reach success
/// or failure, or `max_wait` passes. The delay between calls is
/// Smithy's, from `min_delay` (30s) to `max_delay` (120s).
pub fn wait_until_change_set_create_complete(c: Client, input: DescribeChangeSetInput, max_wait: Duration, min_delay: Duration = 30s, max_delay: Duration = 120s) -> () ! waiter.WaitErr[DescribeChangeSetErr] uses (net.dial, clock, rand) {
  let start = c.transport.clock.now()
  var attempt = 0
  while true {
    attempt += 1
    var state = ""
    match c.describe_change_set(input) {
      Ok(out) => {
        let o = jmes_of_describe_change_set_output(out)
        if state == "" && waiter.path_matches(o, "Status", "stringEquals", "CREATE_COMPLETE") {
          state = "success"
        }
        if state == "" && waiter.path_matches(o, "Status", "stringEquals", "FAILED") {
          state = "failure"
        }
      }
      Err(e) => {
        let names = waiter_error_names_describe_change_set(e)
        if state == "" && waiter.error_is(names, "ValidationError") {
          state = "failure"
        }
        if state == "" {
          return Err(waiter.WaitErr.Failed(e))
        }
      }
    }
    if state == "success" {
      return Ok(())
    }
    if state == "failure" {
      return Err(waiter.WaitErr.Failure("ChangeSetCreateComplete: an acceptor matched the failure state"))
    }
    let left = max_wait - c.transport.clock.since(start)
    if left <= min_delay {
      return Err(waiter.WaitErr.TimedOut(attempt))
    }
    c.transport.clock.sleep(waiter.delay(attempt + 1, min_delay, max_delay, left, c.transport.rand.float()))
  }
  Err(waiter.WaitErr.TimedOut(attempt))
}

