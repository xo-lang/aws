fn xml_write_network_interface(var w: xmlv.Writer, v: NetworkInterface, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.association {
    xml_write_network_interface_association(w, x, "association", [])
  }
  if let Some(x) = v.attachment {
    xml_write_network_interface_attachment(w, x, "attachment", [])
  }
  if let Some(x) = v.availability_zone {
    xmlv.elem(w, "availabilityZone", x, [])
  }
  if let Some(x) = v.connection_tracking_configuration {
    xml_write_connection_tracking_configuration(w, x, "connectionTrackingConfiguration", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "description", x, [])
  }
