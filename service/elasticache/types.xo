  pub cache_security_group_names: List[Str]? = None
  /// One or more VPC security groups associated with the cluster. Use this
  /// parameter only when you are creating a cluster in an Amazon Virtual
  /// Private Cloud (Amazon VPC).
  pub security_group_ids: List[Str]? = None
  /// A list of tags to be added to this resource.
  pub tags: List[Tag]? = None
  /// A single-element string list containing an Amazon Resource Name (ARN)
  /// that uniquely identifies a Valkey or Redis OSS RDB snapshot file stored
  /// in Amazon S3. The snapshot file is used to populate the node group
  /// (shard). The Amazon S3 object name in the ARN cannot contain any commas.
  /// This parameter is only valid if the Engine parameter is redis . Example
  /// of an Amazon S3 ARN: arn:aws:s3:::my_bucket/snapshot1.rdb
  pub snapshot_arns: List[Str]? = None
  /// The name of a Valkey or Redis OSS snapshot from which to restore data
  /// into the new node group (shard). The snapshot status changes to
  /// restoring while the new node group (shard) is being created. This
  /// parameter is only valid if the Engine parameter is redis .
  pub snapshot_name: Str? = None
  /// Specifies the weekly time range during which maintenance on the cluster
  /// is performed. It is specified as a range in the format
  /// ddd:hh24:mi-ddd:hh24:mi (24H Clock UTC). The minimum maintenance window
  /// is a 60 minute period.
  pub preferred_maintenance_window: Str? = None
  /// The port number on which each of the cache nodes accepts connections.
  pub port: Int? = None
  /// The Amazon Resource Name (ARN) of the Amazon Simple Notification Service
