fn xml_read_service_configuration(e: xml.Element) -> ServiceConfiguration ! Str {
  var out = ServiceConfiguration{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "serviceType" => out.service_type = xml_read_service_type_detail_set(c)?
      "serviceId" => out.service_id = c.text()
      "serviceName" => out.service_name = c.text()
      "serviceState" => out.service_state = ServiceState.from(c.text())
      "availabilityZoneIdSet" => out.availability_zone_ids = xml_read_value_string_list(c)?
      "availabilityZoneSet" => out.availability_zones = xml_read_value_string_list(c)?
      "acceptanceRequired" => out.acceptance_required = xmlv.read_bool(c.text())?
      "managesVpcEndpoints" => out.manages_vpc_endpoints = xmlv.read_bool(c.text())?
      "networkLoadBalancerArnSet" => out.network_load_balancer_arns = xml_read_value_string_list(c)?
      "gatewayLoadBalancerArnSet" => out.gateway_load_balancer_arns = xml_read_value_string_list(c)?
      "supportedIpAddressTypeSet" => out.supported_ip_address_types = xml_read_supported_ip_address_types(c)?
      "baseEndpointDnsNameSet" => out.base_endpoint_dns_names = xml_read_value_string_list(c)?
      "privateDnsName" => out.private_dns_name = c.text()
      "privateDnsNameConfiguration" => out.private_dns_name_configuration = xml_read_private_dns_name_configuration(c)?
      "payerResponsibility" => out.payer_responsibility = PayerResponsibility.from(c.text())
      "tagSet" => out.tags = xml_read_tag_list(c)?
      "supportedRegionSet" => out.supported_regions = xml_read_supported_region_set(c)?
      "remoteAccessEnabled" => out.remote_access_enabled = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

