  /// Alias ARN –
  /// arn:aws:lambda:us-west-2:123456789012:function:MyFunction:PROD . Partial
  /// ARN – 123456789012:function:MyFunction . The length constraint applies
  /// only to the full ARN. If you specify only the function name, it's
  /// limited to 64 characters in length.
  pub function_name: Str? = None
  /// When true, the event source mapping is active. When false, Lambda pauses
  /// polling and invocation. Default: True
  pub enabled: Bool? = None
  /// The maximum number of records in each batch that Lambda pulls from your
  /// stream or queue and sends to your function. Lambda passes all of the
  /// records in the batch to the function in a single call, up to the payload
  /// limit for synchronous invocation (6 MB). Amazon Kinesis – Default 100.
  /// Max 10,000. Amazon DynamoDB Streams – Default 100. Max 10,000. Amazon
  /// Simple Queue Service – Default 10. For standard queues the max is
  /// 10,000. For FIFO queues the max is 10. Amazon Managed Streaming for
  /// Apache Kafka – Default 100. Max 10,000. Self-managed Apache Kafka –
  /// Default 100. Max 10,000. Amazon MQ (ActiveMQ and RabbitMQ) – Default
  /// 100. Max 10,000. DocumentDB – Default 100. Max 10,000.
  pub batch_size: Int? = None
  /// An object that defines the filter criteria that determine whether Lambda
  /// should process an event. For more information, see Lambda event
  /// filtering .
  pub filter_criteria: FilterCriteria? = None
  /// The ARN of the Key Management Service (KMS) customer managed key that
  /// Lambda uses to encrypt your function's filter criteria . By default,
  /// Lambda does not encrypt your filter criteria object. Specify this
  /// property to encrypt data using your own customer managed key.
  pub kms_key_arn: Str? = None
  /// The metrics configuration for your event source. For more information,
  /// see Event source mapping metrics .
  pub metrics_config: EventSourceMappingMetricsConfig? = None
  pub logging_config: EventSourceMappingLoggingConfig? = None
  /// (Amazon SQS only) The scaling configuration for the event source. For
  /// more information, see Configuring maximum concurrency for Amazon SQS
  /// event sources .
  pub scaling_config: ScalingConfig? = None
  /// The maximum amount of time, in seconds, that Lambda spends gathering
  /// records before invoking the function. You can configure
  /// MaximumBatchingWindowInSeconds to any value from 0 seconds to 300
  /// seconds in increments of seconds. For Kinesis, DynamoDB, and Amazon SQS
  /// event sources, the default batching window is 0 seconds. For Amazon MSK,
  /// Self-managed Apache Kafka, Amazon MQ, and DocumentDB event sources, the
  /// default batching window is 500 ms. Note that because you can only change
  /// MaximumBatchingWindowInSeconds in increments of seconds, you cannot
  /// revert back to the 500 ms default batching window after you have changed
  /// it. To restore the default batching window, you must create a new event
  /// source mapping. Related setting: For Kinesis, DynamoDB, and Amazon SQS
  /// event sources, when you set BatchSize to a value greater than 10, you
  /// must set MaximumBatchingWindowInSeconds to at least 1. Not supported for
  /// Kafka event source mappings when ConsumptionMode is Queue .
  pub maximum_batching_window_in_seconds: Int? = None
  /// (Kinesis and DynamoDB Streams only) The number of batches to process
  /// from each shard concurrently.
  pub parallelization_factor: Int? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka) A
  /// configuration object that specifies the destination of an event after
  /// Lambda processes it.
  pub destination_config: DestinationConfig? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// Discard records older than the specified age. The default value is
  /// infinite (-1).
  pub maximum_record_age_in_seconds: Int? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// If the function returns an error, split the batch in two and retry.
  pub bisect_batch_on_function_error: Bool? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, and self-managed Apache Kafka)
  /// Discard records after the specified number of retries. The default value
  /// is infinite (-1). When set to infinite (-1), failed records are retried
  /// until the record expires. For Kafka Stream consumption mode, the default
  /// is -1 (infinite retries; capped at 10 when an on-failure destination is
  /// configured). For Kafka Queue consumption mode, the default is 0 , and if
  /// no on-failure destination is configured the Kafka broker performs
  /// retries.
  pub maximum_retry_attempts: Int? = None
  /// (Kinesis and DynamoDB Streams only) The duration in seconds of a
  /// processing window for DynamoDB and Kinesis Streams event sources. A
  /// value of 0 seconds indicates no tumbling window.
  pub tumbling_window_in_seconds: Int? = None
  /// An array of authentication protocols or VPC components required to
  /// secure your event source.
  pub source_access_configurations: List[SourceAccessConfiguration]? = None
  /// (Kinesis, DynamoDB Streams, Amazon MSK, self-managed Apache Kafka, and
  /// Amazon SQS) A list of current response type enums applied to the event
  /// source mapping.
  pub function_response_types: List[FunctionResponseType]? = None
  pub amazon_managed_kafka_event_source_config: AmazonManagedKafkaEventSourceConfig? = None
  pub self_managed_kafka_event_source_config: SelfManagedKafkaEventSourceConfig? = None
  /// Specific configuration settings for a DocumentDB event source.
  pub document_db_event_source_config: DocumentDBEventSourceConfig? = None
  /// (Amazon SQS, Amazon MSK, and self-managed Apache Kafka only) The
  /// provisioned mode configuration for the event source. For more
  /// information, see provisioned mode .
  pub provisioned_poller_config: ProvisionedPollerConfig? = None
}

