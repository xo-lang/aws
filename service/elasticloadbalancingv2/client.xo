  }
  if let Some(x) = v.scheme {
    query.add(f, query.key(prefix, "Scheme"), x.value())
  }
  if let Some(x) = v.vpc_id {
    query.add(f, query.key(prefix, "VpcId"), x)
  }
  if let Some(x) = v.state {
    query_put_load_balancer_state(f, query.key(prefix, "State"), x)
  }
  if let Some(x) = v.type_value {
    query.add(f, query.key(prefix, "Type"), x.value())
  }
  if let Some(x) = v.availability_zones {
    query_put_availability_zones(f, query.key(prefix, "AvailabilityZones"), x, false)
  }
  if let Some(x) = v.security_groups {
