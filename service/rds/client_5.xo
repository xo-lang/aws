  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restxml.classify) ?? e => return Err(RestoreDBInstanceFromS3Err.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_restore_db_instance_from_s3_error(resp))
  }
  deserialize_restore_db_instance_from_s3(resp) ?? e => Err(RestoreDBInstanceFromS3Err.Deserialize(e))
}

