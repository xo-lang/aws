  /// The Amazon Resource Name (ARN) of the domain that was compared from.
  pub source_domain_arn: Str? = None
  /// The Amazon Resource Name (ARN) of the domain that was compared against.
  pub target_domain_arn: Str? = None
  /// The comparison result for each category you requested, keyed by category
  /// name.
