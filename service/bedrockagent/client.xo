fn json_of_ingestion_job_statistics(v: IngestionJobStatistics) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.number_of_documents_scanned {
    fs.push(("numberOfDocumentsScanned", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_metadata_documents_scanned {
    fs.push(("numberOfMetadataDocumentsScanned", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_new_documents_indexed {
    fs.push(("numberOfNewDocumentsIndexed", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_modified_documents_indexed {
    fs.push(("numberOfModifiedDocumentsIndexed", json.Value.Int(x)))
  }
  if let Some(x) = v.number_of_metadata_documents_modified {
    fs.push(("numberOfMetadataDocumentsModified", json.Value.Int(x)))
