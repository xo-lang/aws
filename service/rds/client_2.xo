    xmlv.elem(w, "Permanent", "${x}", [])
  }
  if let Some(x) = v.requires_auto_minor_engine_version_upgrade {
    xmlv.elem(w, "RequiresAutoMinorEngineVersionUpgrade", "${x}", [])
  }
  if let Some(x) = v.vpc_only {
    xmlv.elem(w, "VpcOnly", "${x}", [])
  }
  if let Some(x) = v.supports_option_version_downgrade {
    xmlv.elem(w, "SupportsOptionVersionDowngrade", "${x}", [])
  }
  if let Some(x) = v.option_group_option_settings {
