fn xml_read_restore_db_cluster_to_point_in_time_message(e: xml.Element) -> RestoreDBClusterToPointInTimeMessage ! Str {
  var out = RestoreDBClusterToPointInTimeMessage{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "DBClusterIdentifier" => out.db_cluster_identifier = c.text()
      "RestoreType" => out.restore_type = c.text()
      "SourceDBClusterIdentifier" => out.source_db_cluster_identifier = c.text()
      "RestoreToTime" => out.restore_to_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UseLatestRestorableTime" => out.use_latest_restorable_time = xmlv.read_bool(c.text())?
      "Port" => out.port = xmlv.read_int(c.text())?
      "DBSubnetGroupName" => out.db_subnet_group_name = c.text()
      "VpcSecurityGroupIds" => out.vpc_security_group_ids = xml_read_vpc_security_group_id_list(c)?
      "Tags" => out.tags = xml_read_tag_list(c)?
      "KmsKeyId" => out.kms_key_id = c.text()
      "EnableCloudwatchLogsExports" => out.enable_cloudwatch_logs_exports = xml_read_log_type_list(c)?
      "DeletionProtection" => out.deletion_protection = xmlv.read_bool(c.text())?
      "ServerlessV2ScalingConfiguration" => out.serverless_v2_scaling_configuration = xml_read_serverless_v2_scaling_configuration(c)?
      "StorageType" => out.storage_type = c.text()
      "NetworkType" => out.network_type = c.text()
      "CopyTagsToSnapshot" => out.copy_tags_to_snapshot = xmlv.read_bool(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

