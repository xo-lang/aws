  for item in v {
    xml_write_metrics_configuration(w, item, "member", [])
  }
  xmlv.end(w, name)
}

fn xml_read_metrics_configuration_list(e: xml.Element) -> List[MetricsConfiguration] ! Str {
  var out: List[MetricsConfiguration] = []
