fn from_json_evaluator_user_union(v: json.Value) -> EvaluatorUserUnion ! Str {
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null || k == "__type" {
      continue
    }
    return match k {
      "ConnectUserArn" => Ok(EvaluatorUserUnion.ConnectUserArn(jsonv.read_str(fv)?))
      _ => Ok(EvaluatorUserUnion.Unknown(k))
    }
  }
  Err("EvaluatorUserUnion: no member set")
}

