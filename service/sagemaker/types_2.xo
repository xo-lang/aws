  /// Minimum instance count of the instance group.
  pub min_count: Int? = None
  /// An error message describing why the scaling operation failed, if
  /// applicable.
  pub failure_message: Str? = None
}

pub enum InstanceGroupStatus: Str {
  Inservice = "InService"
  Creating = "Creating"
  Updating = "Updating"
  Failed = "Failed"
  Degraded = "Degraded"
  Systemupdating = "SystemUpdating"
  Deleting = "Deleting"
