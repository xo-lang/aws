      "Description" => out.description = jsonv.read_str(fv)?
      "Status" => out.status = ParallelDataStatus.from(jsonv.read_str(fv)?)
      "SourceLanguageCode" => out.source_language_code = jsonv.read_str(fv)?
      "TargetLanguageCodes" => out.target_language_codes = from_json_language_code_string_list(fv)?
      "ParallelDataConfig" => out.parallel_data_config = from_json_parallel_data_config(fv)?
      "Message" => out.message = jsonv.read_str(fv)?
      "ImportedDataSize" => out.imported_data_size = jsonv.read_int(fv)?
      "ImportedRecordCount" => out.imported_record_count = jsonv.read_int(fv)?
      "FailedRecordCount" => out.failed_record_count = jsonv.read_int(fv)?
      "SkippedRecordCount" => out.skipped_record_count = jsonv.read_int(fv)?
      "EncryptionKey" => out.encryption_key = from_json_encryption_key(fv)?
      "CreatedAt" => out.created_at = jsonv.read_time(fv, "epoch-seconds")?
      "LastUpdatedAt" => out.last_updated_at = jsonv.read_time(fv, "epoch-seconds")?
      "LatestUpdateAttemptStatus" => out.latest_update_attempt_status = ParallelDataStatus.from(jsonv.read_str(fv)?)
      "LatestUpdateAttemptAt" => out.latest_update_attempt_at = jsonv.read_time(fv, "epoch-seconds")?
      _ => {}
    }
  }
  Ok(out)
