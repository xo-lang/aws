fn xml_write_resource_scan_summary(var w: xmlv.Writer, v: ResourceScanSummary, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.resource_scan_id {
    xmlv.elem(w, "ResourceScanId", x, [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "Status", x.value(), [])
  }
  if let Some(x) = v.status_reason {
    xmlv.elem(w, "StatusReason", x, [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "StartTime", rest.date_time(x), [])
  }
  if let Some(x) = v.end_time {
    xmlv.elem(w, "EndTime", rest.date_time(x), [])
  }
  if let Some(x) = v.percentage_completed {
    xmlv.elem(w, "PercentageCompleted", rest.float_text(x), [])
  }
  if let Some(x) = v.scan_type {
    xmlv.elem(w, "ScanType", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_resource_scan_summary(e: xml.Element) -> ResourceScanSummary ! Str {
  var out = ResourceScanSummary{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "ResourceScanId" => out.resource_scan_id = c.text()
      "Status" => out.status = ResourceScanStatus.from(c.text())
      "StatusReason" => out.status_reason = c.text()
      "StartTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "EndTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "PercentageCompleted" => out.percentage_completed = xmlv.read_float(c.text())?
      "ScanType" => out.scan_type = ScanType.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_resource_target_definition(var w: xmlv.Writer, v: ResourceTargetDefinition, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.attribute {
    xmlv.elem(w, "Attribute", x.value(), [])
  }
  if let Some(x) = v.name {
    xmlv.elem(w, "Name", x, [])
  }
  if let Some(x) = v.requires_recreation {
    xmlv.elem(w, "RequiresRecreation", x.value(), [])
  }
  if let Some(x) = v.path {
    xmlv.elem(w, "Path", x, [])
  }
  if let Some(x) = v.before_value {
    xmlv.elem(w, "BeforeValue", x, [])
  }
  if let Some(x) = v.after_value {
    xmlv.elem(w, "AfterValue", x, [])
  }
  if let Some(x) = v.before_value_from {
    xmlv.elem(w, "BeforeValueFrom", x.value(), [])
  }
  if let Some(x) = v.after_value_from {
    xmlv.elem(w, "AfterValueFrom", x.value(), [])
  }
  if let Some(x) = v.drift {
    xml_write_live_resource_drift(w, x, "Drift", [])
