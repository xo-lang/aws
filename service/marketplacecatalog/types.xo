  pub value_list: List[Str]? = None
}

/// An object that contains summary information about a subsidiary
/// authorization, including its name, status, authorized resource,
/// subsidiary account, and creation date. A subsidiary authorization lets a
/// seller authorize one of its subsidiary accounts to create offers for one
/// of its products.
pub struct SubsidiaryAuthorizationSummary {
  /// The name of the subsidiary authorization.
  pub name: Str? = None
  /// The status of the subsidiary authorization. Valid values are: Draft -
  /// The subsidiary authorization was created but not yet released. The
  /// subsidiary account can't see it. Active - The subsidiary account can use
  /// the subsidiary authorization to create offers for the authorized
  /// product. Restricted - The subsidiary authorization was discarded while
  /// in Draft or revoked while Active . It can't be used to create new
  /// offers. This status is final.
  pub status: Str? = None
  /// The ID of the resource that the subsidiary authorization applies to.
  /// Currently, this is always a product ID, such as prod-example123 .
  pub resource_id: Str? = None
  /// The name of the resource that the subsidiary authorization applies to.
  /// Currently, this is always a product name.
  pub resource_name: Str? = None
  /// The 12-digit AWS account ID of the subsidiary account.
  pub subsidiary_account_id: Str? = None
  /// The date the subsidiary authorization was created.
  pub created_date: Str? = None
}

