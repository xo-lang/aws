      "RestoreToTime" => out.restore_to_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "UseLatestRestorableTime" => out.use_latest_restorable_time = xmlv.read_bool(c.text())?
      "Port" => out.port = xmlv.read_int(c.text())?
      "DBSubnetGroupName" => out.db_subnet_group_name = c.text()
