fn read_error_code_build_not_in_service_region_exception(resp: http.Response, body: xml.Element) -> CodeBuildNotInServiceRegionException ! Str {
  let _ = (resp, body)
  var out = CodeBuildNotInServiceRegionException{}
  for c in xmlv.elements(body) {
    match c.name.local.to_lower() {
      "message" => out.message = c.text()
      _ => {}
    }
  }
  Ok(out)
}

