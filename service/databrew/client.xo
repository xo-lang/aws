fn json_of_dataset(v: Dataset) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.account_id {
    fs.push(("AccountId", json.Value.Str(x)))
  }
  if let Some(x) = v.created_by {
    fs.push(("CreatedBy", json.Value.Str(x)))
  }
  if let Some(x) = v.create_date {
    fs.push(("CreateDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.name {
    fs.push(("Name", json.Value.Str(x)))
  }
  if let Some(x) = v.format {
    fs.push(("Format", json.Value.Str(x.value())))
  }
  if let Some(x) = v.format_options {
    fs.push(("FormatOptions", json_of_format_options(x)))
  }
  if let Some(x) = v.input {
    fs.push(("Input", json_of_input(x)))
  }
  if let Some(x) = v.last_modified_date {
    fs.push(("LastModifiedDate", jsonv.time(x, "epoch-seconds")))
  }
  if let Some(x) = v.last_modified_by {
    fs.push(("LastModifiedBy", json.Value.Str(x)))
  }
  if let Some(x) = v.source {
    fs.push(("Source", json.Value.Str(x.value())))
  }
  if let Some(x) = v.path_options {
    fs.push(("PathOptions", json_of_path_options(x)))
  }
  if let Some(x) = v.tags {
    fs.push(("Tags", json_of_tag_map(x)))
  }
  if let Some(x) = v.resource_arn {
    fs.push(("ResourceArn", json.Value.Str(x)))
  }
  json.Value.Object(fs)
}

fn from_json_dataset(v: json.Value) -> Dataset ! Str {
  var out = Dataset{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "AccountId" => out.account_id = jsonv.read_str(fv)?
      "CreatedBy" => out.created_by = jsonv.read_str(fv)?
      "CreateDate" => out.create_date = jsonv.read_time(fv, "epoch-seconds")?
      "Name" => out.name = jsonv.read_str(fv)?
      "Format" => out.format = InputFormat.from(jsonv.read_str(fv)?)
      "FormatOptions" => out.format_options = from_json_format_options(fv)?
      "Input" => out.input = from_json_input(fv)?
      "LastModifiedDate" => out.last_modified_date = jsonv.read_time(fv, "epoch-seconds")?
      "LastModifiedBy" => out.last_modified_by = jsonv.read_str(fv)?
      "Source" => out.source = Source.from(jsonv.read_str(fv)?)
      "PathOptions" => out.path_options = from_json_path_options(fv)?
      "Tags" => out.tags = from_json_tag_map(fv)?
      "ResourceArn" => out.resource_arn = jsonv.read_str(fv)?
      _ => {}
    }
  }
  Ok(out)
}

