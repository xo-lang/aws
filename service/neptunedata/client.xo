fn json_of_propertygraph_summary(v: PropertygraphSummary) -> json.Value {
  var fs: List[(Str, json.Value)] = []
  if let Some(x) = v.num_nodes {
    fs.push(("numNodes", json.Value.Int(x)))
  }
  if let Some(x) = v.num_edges {
    fs.push(("numEdges", json.Value.Int(x)))
  }
  if let Some(x) = v.num_node_labels {
    fs.push(("numNodeLabels", json.Value.Int(x)))
  }
  if let Some(x) = v.num_edge_labels {
    fs.push(("numEdgeLabels", json.Value.Int(x)))
  }
  if let Some(x) = v.node_labels {
    fs.push(("nodeLabels", json_of_node_labels(x)))
  }
  if let Some(x) = v.edge_labels {
    fs.push(("edgeLabels", json_of_edge_labels(x)))
  }
  if let Some(x) = v.num_node_properties {
    fs.push(("numNodeProperties", json.Value.Int(x)))
  }
  if let Some(x) = v.num_edge_properties {
    fs.push(("numEdgeProperties", json.Value.Int(x)))
  }
  if let Some(x) = v.node_properties {
    fs.push(("nodeProperties", json_of_long_valued_map_list(x)))
  }
  if let Some(x) = v.edge_properties {
    fs.push(("edgeProperties", json_of_long_valued_map_list(x)))
  }
  if let Some(x) = v.total_node_property_values {
    fs.push(("totalNodePropertyValues", json.Value.Int(x)))
  }
  if let Some(x) = v.total_edge_property_values {
    fs.push(("totalEdgePropertyValues", json.Value.Int(x)))
  }
  if let Some(x) = v.node_structures {
    fs.push(("nodeStructures", json_of_node_structures(x)))
  }
  if let Some(x) = v.edge_structures {
    fs.push(("edgeStructures", json_of_edge_structures(x)))
  }
  json.Value.Object(fs)
}

fn from_json_propertygraph_summary(v: json.Value) -> PropertygraphSummary ! Str {
  var out = PropertygraphSummary{}
  for (k, fv) in jsonv.fields(v)? {
    if fv == json.Value.Null {
      continue
    }
    match k {
      "numNodes" => out.num_nodes = jsonv.read_int(fv)?
      "numEdges" => out.num_edges = jsonv.read_int(fv)?
      "numNodeLabels" => out.num_node_labels = jsonv.read_int(fv)?
      "numEdgeLabels" => out.num_edge_labels = jsonv.read_int(fv)?
      "nodeLabels" => out.node_labels = from_json_node_labels(fv)?
      "edgeLabels" => out.edge_labels = from_json_edge_labels(fv)?
      "numNodeProperties" => out.num_node_properties = jsonv.read_int(fv)?
      "numEdgeProperties" => out.num_edge_properties = jsonv.read_int(fv)?
      "nodeProperties" => out.node_properties = from_json_long_valued_map_list(fv)?
      "edgeProperties" => out.edge_properties = from_json_long_valued_map_list(fv)?
      "totalNodePropertyValues" => out.total_node_property_values = jsonv.read_int(fv)?
      "totalEdgePropertyValues" => out.total_edge_property_values = jsonv.read_int(fv)?
      "nodeStructures" => out.node_structures = from_json_node_structures(fv)?
      "edgeStructures" => out.edge_structures = from_json_edge_structures(fv)?
      _ => {}
    }
  }
  Ok(out)
}

