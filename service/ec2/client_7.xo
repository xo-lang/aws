fn xml_read_spot_fleet_request_config_data(e: xml.Element) -> SpotFleetRequestConfigData ! Str {
  var out = SpotFleetRequestConfigData{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "allocationStrategy" => out.allocation_strategy = AllocationStrategy.from(c.text())
      "onDemandAllocationStrategy" => out.on_demand_allocation_strategy = OnDemandAllocationStrategy.from(c.text())
      "spotMaintenanceStrategies" => out.spot_maintenance_strategies = xml_read_spot_maintenance_strategies(c)?
      "clientToken" => out.client_token = c.text()
      "excessCapacityTerminationPolicy" => out.excess_capacity_termination_policy = ExcessCapacityTerminationPolicy.from(c.text())
      "fulfilledCapacity" => out.fulfilled_capacity = xmlv.read_float(c.text())?
      "onDemandFulfilledCapacity" => out.on_demand_fulfilled_capacity = xmlv.read_float(c.text())?
      "iamFleetRole" => out.iam_fleet_role = c.text()
      "launchSpecifications" => out.launch_specifications = xml_read_launch_specs_list(c)?
      "launchTemplateConfigs" => out.launch_template_configs = xml_read_launch_template_config_list(c)?
      "spotPrice" => out.spot_price = c.text()
      "targetCapacity" => out.target_capacity = xmlv.read_int(c.text())?
      "onDemandTargetCapacity" => out.on_demand_target_capacity = xmlv.read_int(c.text())?
      "onDemandMaxTotalPrice" => out.on_demand_max_total_price = c.text()
      "spotMaxTotalPrice" => out.spot_max_total_price = c.text()
      "terminateInstancesWithExpiration" => out.terminate_instances_with_expiration = xmlv.read_bool(c.text())?
      "type" => out.type_value = FleetType.from(c.text())
      "validFrom" => out.valid_from = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "validUntil" => out.valid_until = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "replaceUnhealthyInstances" => out.replace_unhealthy_instances = xmlv.read_bool(c.text())?
      "instanceInterruptionBehavior" => out.instance_interruption_behavior = InstanceInterruptionBehavior.from(c.text())
      "loadBalancersConfig" => out.load_balancers_config = xml_read_load_balancers_config(c)?
      "instancePoolsToUseCount" => out.instance_pools_to_use_count = xmlv.read_int(c.text())?
      "context" => out.context = c.text()
      "targetCapacityUnitType" => out.target_capacity_unit_type = TargetCapacityUnitType.from(c.text())
      "TagSpecification" => out.tag_specifications = xml_read_tag_specification_list(c)?
      _ => {}
    }
  }
  Ok(out)
}

