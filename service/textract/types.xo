}

pub struct UntagResourceResponse {
}

pub struct UpdateAdapterRequest {
  /// A string containing a unique ID for the adapter that will be updated.
  pub adapter_id: Str? = None
  /// The new description to be applied to the adapter.
  pub description: Str? = None
  /// The new name to be applied to the adapter.
  pub adapter_name: Str? = None
  /// The new auto-update status to be applied to the adapter.
  pub auto_update: AutoUpdate? = None
}

pub struct UpdateAdapterResponse {
  /// A string containing a unique ID for the adapter that has been updated.
  pub adapter_id: Str? = None
  /// A string containing the name of the adapter that has been updated.
  pub adapter_name: Str? = None
  /// An object specifying the creation time of the the adapter that has been
  /// updated.
  pub creation_time: Time? = None
  /// A string containing the description of the adapter that has been
  /// updated.
  pub description: Str? = None
  /// List of the targeted feature types for the updated adapter.
  pub feature_types: List[FeatureType]? = None
  /// The auto-update status of the adapter that has been updated.
  pub auto_update: AutoUpdate? = None
}

/// Indicates that a request was not valid. Check request for proper
/// formatting.
pub struct ValidationException {
  pub message: Str? = None
  pub code: Str? = None
}

pub enum ValueType: Str {
  Date = "DATE"
  Unknown(value: Str)
}

/// A warning about an issue that occurred during asynchronous text analysis
/// ( StartDocumentAnalysis ) or asynchronous document text detection (
/// StartDocumentTextDetection ).
pub struct Warning {
  /// The error code for the warning.
  pub error_code: Str? = None
  /// A list of the pages that the warning applies to.
  pub pages: List[Int]? = None
}
