fn xml_write_xml_nested_union_struct(var w: xmlv.Writer, v: XmlNestedUnionStruct, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.string_value {
    xmlv.elem(w, "stringValue", x, [])
  }
  if let Some(x) = v.boolean_value {
    xmlv.elem(w, "booleanValue", "${x}", [])
  }
  if let Some(x) = v.byte_value {
    xmlv.elem(w, "byteValue", "${x}", [])
  }
  if let Some(x) = v.short_value {
    xmlv.elem(w, "shortValue", "${x}", [])
  }
  if let Some(x) = v.integer_value {
    xmlv.elem(w, "integerValue", "${x}", [])
  }
  if let Some(x) = v.long_value {
    xmlv.elem(w, "longValue", "${x}", [])
  }
  if let Some(x) = v.float_value {
    xmlv.elem(w, "floatValue", rest.float_text(x), [])
  }
  if let Some(x) = v.double_value {
    xmlv.elem(w, "doubleValue", rest.float_text(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_xml_nested_union_struct(e: xml.Element) -> XmlNestedUnionStruct ! Str {
  var out = XmlNestedUnionStruct{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "stringValue" => out.string_value = c.text()
      "booleanValue" => out.boolean_value = xmlv.read_bool(c.text())?
      "byteValue" => out.byte_value = xmlv.read_int(c.text())?
      "shortValue" => out.short_value = xmlv.read_int(c.text())?
      "integerValue" => out.integer_value = xmlv.read_int(c.text())?
      "longValue" => out.long_value = xmlv.read_int(c.text())?
      "floatValue" => out.float_value = xmlv.read_float(c.text())?
      "doubleValue" => out.double_value = xmlv.read_float(c.text())?
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_xml_timestamps_request(var w: xmlv.Writer, v: XmlTimestampsRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.normal {
    xmlv.elem(w, "normal", rest.date_time(x), [])
  }
  if let Some(x) = v.date_time {
    xmlv.elem(w, "dateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.date_time_on_target {
    xmlv.elem(w, "dateTimeOnTarget", rest.date_time(x), [])
  }
  if let Some(x) = v.epoch_seconds {
    xmlv.elem(w, "epochSeconds", rest.epoch_seconds(x), [])
  }
  if let Some(x) = v.epoch_seconds_on_target {
    xmlv.elem(w, "epochSecondsOnTarget", rest.epoch_seconds(x), [])
  }
  if let Some(x) = v.http_date {
    xmlv.elem(w, "httpDate", rest.http_date(x), [])
  }
  if let Some(x) = v.http_date_on_target {
    xmlv.elem(w, "httpDateOnTarget", rest.http_date(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_xml_timestamps_request(e: xml.Element) -> XmlTimestampsRequest ! Str {
  var out = XmlTimestampsRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "normal" => out.normal = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "dateTime" => out.date_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "dateTimeOnTarget" => out.date_time_on_target = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "epochSeconds" => out.epoch_seconds = (rest.parse_epoch_seconds(c.text().trim()) ?? return Err("bad timestamp"))
      "epochSecondsOnTarget" => out.epoch_seconds_on_target = (rest.parse_epoch_seconds(c.text().trim()) ?? return Err("bad timestamp"))
      "httpDate" => out.http_date = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      "httpDateOnTarget" => out.http_date_on_target = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_xml_timestamps_response(var w: xmlv.Writer, v: XmlTimestampsResponse, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.normal {
    xmlv.elem(w, "normal", rest.date_time(x), [])
  }
  if let Some(x) = v.date_time {
    xmlv.elem(w, "dateTime", rest.date_time(x), [])
  }
  if let Some(x) = v.date_time_on_target {
    xmlv.elem(w, "dateTimeOnTarget", rest.date_time(x), [])
  }
  if let Some(x) = v.epoch_seconds {
    xmlv.elem(w, "epochSeconds", rest.epoch_seconds(x), [])
  }
  if let Some(x) = v.epoch_seconds_on_target {
    xmlv.elem(w, "epochSecondsOnTarget", rest.epoch_seconds(x), [])
  }
  if let Some(x) = v.http_date {
    xmlv.elem(w, "httpDate", rest.http_date(x), [])
  }
  if let Some(x) = v.http_date_on_target {
    xmlv.elem(w, "httpDateOnTarget", rest.http_date(x), [])
  }
  xmlv.end(w, name)
}

fn xml_read_xml_timestamps_response(e: xml.Element) -> XmlTimestampsResponse ! Str {
  var out = XmlTimestampsResponse{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "normal" => out.normal = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "dateTime" => out.date_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "dateTimeOnTarget" => out.date_time_on_target = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "epochSeconds" => out.epoch_seconds = (rest.parse_epoch_seconds(c.text().trim()) ?? return Err("bad timestamp"))
      "epochSecondsOnTarget" => out.epoch_seconds_on_target = (rest.parse_epoch_seconds(c.text().trim()) ?? return Err("bad timestamp"))
      "httpDate" => out.http_date = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      "httpDateOnTarget" => out.http_date_on_target = (rest.parse_http_date(c.text().trim()) ?? return Err("bad timestamp"))
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_xml_union_shape(var w: xmlv.Writer, v: XmlUnionShape, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  match v {
    StringValue(x) => {
      xmlv.elem(w, "stringValue", x, [])
    }
    BooleanValue(x) => {
      xmlv.elem(w, "booleanValue", "${x}", [])
    }
    ByteValue(x) => {
      xmlv.elem(w, "byteValue", "${x}", [])
    }
    ShortValue(x) => {
      xmlv.elem(w, "shortValue", "${x}", [])
    }
    IntegerValue(x) => {
      xmlv.elem(w, "integerValue", "${x}", [])
    }
    LongValue(x) => {
      xmlv.elem(w, "longValue", "${x}", [])
    }
    FloatValue(x) => {
      xmlv.elem(w, "floatValue", rest.float_text(x), [])
    }
    DoubleValue(x) => {
      xmlv.elem(w, "doubleValue", rest.float_text(x), [])
    }
    UnionValue(x) => {
      xml_write_xml_union_shape(w, x, "unionValue", [])
    }
    StructValue(x) => {
      xml_write_xml_nested_union_struct(w, x, "structValue", [])
    }
    Unknown(_) => {}
  }
  xmlv.end(w, name)
}

fn xml_read_xml_union_shape(e: xml.Element) -> XmlUnionShape ! Str {
  for c in xmlv.elements(e) {
    return match c.name.local {
      "stringValue" => Ok(XmlUnionShape.StringValue(c.text()))
      "booleanValue" => Ok(XmlUnionShape.BooleanValue(xmlv.read_bool(c.text())?))
      "byteValue" => Ok(XmlUnionShape.ByteValue(xmlv.read_int(c.text())?))
      "shortValue" => Ok(XmlUnionShape.ShortValue(xmlv.read_int(c.text())?))
      "integerValue" => Ok(XmlUnionShape.IntegerValue(xmlv.read_int(c.text())?))
      "longValue" => Ok(XmlUnionShape.LongValue(xmlv.read_int(c.text())?))
      "floatValue" => Ok(XmlUnionShape.FloatValue(xmlv.read_float(c.text())?))
      "doubleValue" => Ok(XmlUnionShape.DoubleValue(xmlv.read_float(c.text())?))
      "unionValue" => Ok(XmlUnionShape.UnionValue(xml_read_xml_union_shape(c)?))
      "structValue" => Ok(XmlUnionShape.StructValue(xml_read_xml_nested_union_struct(c)?))
      _ => Ok(XmlUnionShape.Unknown(c.name.local))
    }
  }
  Err("XmlUnionShape: no member set")
}

fn xml_write_xml_unions_request(var w: xmlv.Writer, v: XmlUnionsRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.union_value {
    xml_write_xml_union_shape(w, x, "unionValue", [])
  }
  xmlv.end(w, name)
