/// Cancels or stops a contact with a specified contact ID based on its
/// position in the contact lifecycle . For contacts that: Have yet to
/// start, the contact will be cancelled. Have started but have yet to
/// finish, the contact will be stopped.
pub fn (c: Client) cancel_contact(input: CancelContactRequest) -> ContactIdResponse ! CancelContactErr uses (net.dial, clock, rand) {
  let (ep, signing, extra) = c.route(endpoint_params_cancel_contact(c.params, input)) ?? e => return Err(CancelContactErr.InvalidInput(e))
  var req = serialize_cancel_contact(ep, input, "") ?? e => return Err(CancelContactErr.InvalidInput(e))
  for h in extra {
    req.headers.push(h)
  }
  let resp = transport.send(c.transport, req, signing, restjson.classify) ?? e => return Err(CancelContactErr.Send(e))
  if resp.status >= 300 {
    return Err(deserialize_cancel_contact_error(resp))
  }
  deserialize_cancel_contact(resp) ?? e => Err(CancelContactErr.Deserialize(e))
}

