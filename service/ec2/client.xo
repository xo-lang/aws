fn xml_write_report_instance_status_request(var w: xmlv.Writer, v: ReportInstanceStatusRequest, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.dry_run {
    xmlv.elem(w, "dryRun", "${x}", [])
  }
  if let Some(x) = v.instances {
    xml_write_instance_id_string_list(w, x, "instanceId", [])
  }
  if let Some(x) = v.status {
    xmlv.elem(w, "status", x.value(), [])
  }
  if let Some(x) = v.start_time {
    xmlv.elem(w, "startTime", rest.date_time(x), [])
  }
  if let Some(x) = v.end_time {
    xmlv.elem(w, "endTime", rest.date_time(x), [])
  }
  if let Some(x) = v.reason_codes {
    xml_write_reason_codes_list(w, x, "reasonCode", [])
  }
  if let Some(x) = v.description {
    xmlv.elem(w, "description", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_report_instance_status_request(e: xml.Element) -> ReportInstanceStatusRequest ! Str {
  var out = ReportInstanceStatusRequest{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "dryRun" => out.dry_run = xmlv.read_bool(c.text())?
      "instanceId" => out.instances = xml_read_instance_id_string_list(c)?
      "status" => out.status = ReportStatusType.from(c.text())
      "startTime" => out.start_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "endTime" => out.end_time = (rest.parse_date_time(c.text().trim()) ?? return Err("bad timestamp"))
      "reasonCode" => out.reason_codes = xml_read_reason_codes_list(c)?
      "description" => out.description = c.text()
      _ => {}
    }
  }
  Ok(out)
}

