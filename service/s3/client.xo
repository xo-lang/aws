fn xml_write_grant(var w: xmlv.Writer, v: Grant, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  if let Some(x) = v.grantee {
    xml_write_grantee(w, x, "Grantee", [("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance")])
  }
  if let Some(x) = v.permission {
    xmlv.elem(w, "Permission", x.value(), [])
  }
  xmlv.end(w, name)
}

fn xml_read_grant(e: xml.Element) -> Grant ! Str {
  var out = Grant{}
  for c in xmlv.elements(e) {
    match c.name.local {
      "Grantee" => out.grantee = xml_read_grantee(c)?
      "Permission" => out.permission = Permission.from(c.text())
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_grantee(var w: xmlv.Writer, v: Grantee, name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  if let Some(x) = v.type_value {
    attrs.push(("xsi:type", x.value()))
  }
  xmlv.start(w, name, attrs)
  if let Some(x) = v.display_name {
    xmlv.elem(w, "DisplayName", x, [])
  }
  if let Some(x) = v.email_address {
    xmlv.elem(w, "EmailAddress", x, [])
  }
  if let Some(x) = v.id {
    xmlv.elem(w, "ID", x, [])
  }
  if let Some(x) = v.uri {
    xmlv.elem(w, "URI", x, [])
  }
  xmlv.end(w, name)
}

fn xml_read_grantee(e: xml.Element) -> Grantee ! Str {
  var out = Grantee{}
  if let Some(a) = e.attr("type") {
    out.type_value = Type.from(a)
  }
  for c in xmlv.elements(e) {
    match c.name.local {
      "DisplayName" => out.display_name = c.text()
      "EmailAddress" => out.email_address = c.text()
      "ID" => out.id = c.text()
      "URI" => out.uri = c.text()
      _ => {}
    }
  }
  Ok(out)
}

fn xml_write_grants(var w: xmlv.Writer, v: List[Grant], name: Str, ns: List[(Str, Str)]) {
  var attrs = ns
  xmlv.start(w, name, attrs)
  for item in v {
    xml_write_grant(w, item, "Grant", [])
  }
  xmlv.end(w, name)
}

fn xml_read_grants(e: xml.Element) -> List[Grant] ! Str {
  var out: List[Grant] = []
  for c in xmlv.elements(e) {
    out.push(xml_read_grant(c)?)
  }
  Ok(out)
}

